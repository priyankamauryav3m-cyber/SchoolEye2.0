<div class="custom-modal" style="display:@(IsVisible ? "flex" : "none");">
    <div class="modal-content clearfix main-popup alert-popup">
        <div class="head-btn">
            <h5 class="modal-title">@Title</h5>
            <button @onclick="OnClose" type="button" class="close"><span aria-hidden="true">×</span></button>
        </div>
        <div class="modal-body alert-body">
            <div class="d-flex align-items-center justify-content-center flex-column gap-2">
                <img src="images/alert-img.png" />
             <p class="m-0 alert-message">@Message</p>
            </div>
            
        </div>
        <div class="modal-footer">
            <div class="alert-btn">
                @if (showConfirmationButtons)
                {
                    <button class="btn-txt btn-blue" @onclick="() => Confirm(true)">Yes</button>
                    <button class="btn-txt btn-cancle" @onclick="() => Confirm(false)">No</button>
                }
                else
                {
                    <button class="btn-txt btn-blue" @onclick="OnClose">OK</button>
                }
            </div>
        </div>
    </div>
</div>
<style>
    .alert-message {
    max-width: 560px;
    width: 100%;
    text-align: center;
    word-wrap: break-word;
    overflow-wrap: break-word;
    word-break: break-word;
    white-space: normal;
    line-height: 1.6;
}
</style>
@code {
    [Parameter] public string Title { get; set; } = "Alert";
    [Parameter] public string Message { get; set; } = "This is an alert message.";
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public bool showConfirmationButtons { get; set; }

    // Optional: raised when the alert is dismissed via OK / ×, so a host popup
    // that hid itself while the alert was shown can show itself again.
    [Parameter] public EventCallback OnAlertClosed { get; set; }

    private TaskCompletionSource<bool> confirmationTcs;

    public async Task<bool> ShowConfirmationAlert(string message)
    {
        confirmationTcs = new TaskCompletionSource<bool>();
        await ShowCustomAlert(message, true); // Show confirmation buttons (Yes/No)
        return await confirmationTcs.Task;
    }

    public async Task ShowCustomAlert(string message, bool showConfirmation)
    {
        Message = message;
        IsVisible = true;
        showConfirmationButtons = showConfirmation;
        await InvokeAsync(StateHasChanged); // Ensure UI updates
    }

    private async Task HandleConfirmation(bool confirmed)
    {
        IsVisible = false;
        confirmationTcs.TrySetResult(confirmed); // Return the confirmation result
        await InvokeAsync(StateHasChanged); // Update UI
    }

    private async Task OnClose()
    {
        IsVisible = false;
        // × on a confirmation alert counts as "No" so the awaiting caller is not left hanging.
        confirmationTcs?.TrySetResult(false);
        await InvokeAsync(StateHasChanged); // Close the alert and update UI
        await OnAlertClosed.InvokeAsync();
    }

    private async Task Confirm(bool confirmed)
    {
        await HandleConfirmation(confirmed); // Reuse logic for handling confirmation
    }
}
