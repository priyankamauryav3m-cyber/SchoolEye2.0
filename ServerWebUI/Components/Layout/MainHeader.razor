<div class="main-overlay"></div>


<CustomAlert @ref="customAlert" Title="Alert" />

@code {
    private CustomAlert customAlert;    
    public string hospitalName = "";
    private string Username = "";
    private string RoleName = "";
    private string DashboardName = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initBodyLoad");
            // var vc_hospitalName = await sessionStorage.GetAsync<string>("Vc_HospitalName");
            // hospitalName = vc_hospitalName.Value;
            var username = await sessionStorage.GetAsync<string>("UserName");
            Username = username.Value;
            var rolename = await sessionStorage.GetAsync<string>("RoleName");
            RoleName = rolename.Value;
            var dashboard = await sessionStorage.GetAsync<string>("RoleName");
            DashboardName = dashboard.Value;
            StateHasChanged();
        }
    }
    private async Task GetBookMark()
    {
        //await BookmarkState.LoadAsync();
        BookmarkState.OnChange += StateHasChanged;
    }
    public void Dispose()
    {
        BookmarkState.OnChange -= StateHasChanged;
    }

    private async Task Logout()
    {
        //var isConfirmed = await customAlert.ShowConfirmationAlert($"Are you sure want to logout ?");
        var submit = await Alert.ShowConfirm("Are you sure want to logout ?");
        if (!submit)
        {
            StateHasChanged();
            return;
        }
        if (submit)
        {
            await sessionStorage.DeleteAsync("userId");
            await sessionStorage.DeleteAsync("GroupId");
            await sessionStorage.DeleteAsync("GroupCode");
            await sessionStorage.DeleteAsync("HospitalId");
            await sessionStorage.DeleteAsync("HospitalCode");
            await sessionStorage.DeleteAsync("VCId");
            await sessionStorage.DeleteAsync("VCCode");
            await sessionStorage.DeleteAsync("LoginId");
            await sessionStorage.DeleteAsync("UserName");
            await sessionStorage.DeleteAsync("UserType");
            await sessionStorage.DeleteAsync("authToken");
            //await sessionStorage.DeleteAsync("Vc_HospitalName");
            await sessionStorage.DeleteAsync("RoleId");
            await sessionStorage.DeleteAsync("RoleName");
          
            nav.NavigateTo("/logout", true);
            // nav.NavigateTo("/");
        }
    }
}
