@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager nav
@inject SecureUrlService SecureUrl
@rendermode   InteractiveServer

<div class="page">
    <div>
        <MainHeader />
    </div>
    <div class="sidebar">
        <NavMenu />
    </div>

    <main id="main" class="main">
        <article class="content">
            @Body
        </article>
    </main>
</div>


@code{
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        if (nav.Uri.Contains("verifyotppage", StringComparison.OrdinalIgnoreCase))
            return;

        if (!await UserIsAuthenticated())
        {
            nav.NavigateTo("/", true);   // Login Page
            return;
        }

        // logged in: show page names encrypted in the address bar
        locationChangingRegistration = nav.RegisterLocationChangingHandler(EncryptPageUrl);
        var current = "/" + nav.ToBaseRelativePath(nav.Uri);
        if (SecureUrl.IsSecurablePage(current))
        {
            // url typed / refreshed in plain text
            nav.NavigateTo(SecureUrl.ToSecure(current).TrimStart('/'), replace: true);
        }
    }

    private IDisposable? locationChangingRegistration;

    // every in-app navigation (menu, links, bookmarks, NavigateTo) to a plain page url
    // is swapped for its encrypted url before it happens
    private ValueTask EncryptPageUrl(LocationChangingContext context)
    {
        var target = "/" + nav.ToBaseRelativePath(nav.ToAbsoluteUri(context.TargetLocation).ToString());
        if (SecureUrl.IsSecurablePage(target))
        {
            var secureUrl = SecureUrl.ToSecure(target).TrimStart('/');   // relative to base href
            context.PreventNavigation();
            _ = InvokeAsync(async () =>
            {
                await Task.Yield();
                nav.NavigateTo(secureUrl);
            });
        }
        return ValueTask.CompletedTask;
    }

    public void Dispose() => locationChangingRegistration?.Dispose();
    // private async Task<bool> UserIsAuthenticated()
    // {
    //     var token = await GetSessionToken();
    //     return !string.IsNullOrWhiteSpace(token);
    // }

    private async Task<string?> GetSessionToken()
    {
        var loginName = await sessionStorage.GetAsync<string>("UserName");
        string LoginName = loginName.Value;
        if (!loginName.Success || string.IsNullOrWhiteSpace(loginName.Value))
            return null;

        return loginName.Value;
      //  return string.IsNullOrEmpty(LoginName) ? null : LoginName;
    }
    private async Task<bool> UserIsAuthenticated()
    {
        var token = await sessionStorage.GetAsync<string>("authToken");

        return token.Success &&
               !string.IsNullOrWhiteSpace(token.Value);
    }
}
