@page "/enquiry"
@using DomainModel.Admin
@using DomainModel.FinanceMNGT
@using Microsoft.AspNetCore.Authorization
@inject IHttpClientFactory ClientFactory
@using DomainModel.SchoolMaster
@using Microsoft.AspNetCore.Components.QuickGrid
@using System.Net
@using System.Text.Json
@inject IStringLocalizer<Resource> Localizer
@using MyApp.Common
@using ServerWebUI.Components.Pages.AdmissionDetailsPages
@using ServerWebUI.Components.Pages.CommonPages
@inject IJSRuntime JS
@inject Shared.IHttpService httpService
@inject HttpClient Http
@inject SweetAlertService Alert
@rendermode InteractiveServer
<style>
    .quickgrid thead th:nth-last-child(2) {
        min-width: 75px;
    }

    .quickgrid tbody tr.selectRow td {
        background-color: #cce5ff !important;
    }
</style>
<section class="main-container">
    <div class="row m-0 main-row">
        <div class="col-12 p-1" id="main-header">
            <div class="page-heading d-flex align-items-center justify-content-between">
                <p class="m-0 page-name px-1">Enquiry
                    @* <NavigationPage /> *@
                </p>
                <div class="d-flex align-items-center gap-2">
                    <div class="form-box">
                        <InputSelect @bind-Value="@CurrentSession" class="form-input">
                            <option value="0">-- Select Session --</option>
                            @foreach (var data in sessionlist.Where(x => x.IsValid == true))
                            {
                                <option value="@data.SessionId">@data.SessionName </option>
                            }
                        </InputSelect>
                    </div>

                    <div class="form-box">
                        <div class="d-flex gap-2">
                            <button class="icon-btn icon-btn-white open-popup " @onclick="OpenSearch" data-id="popup" tabindex="0">
                                <i class="bi bi-sliders"></i>
                            </button>
                        </div>
                    </div>
                    <div class="form-box">
                        <button class="ui fade op-1 animated button form-btn" tabindex="0" @onclick="SearchStudent">
                            <div class="visible content">Search</div>
                            <div class="hidden content">
                                <i class="bi bi-search"></i>
                            </div>
                        </button>
                    </div>
                    <div class="form-box">
                        <ActionButtonGroup CurrentUrl="@currentUrl" Add="AddEnquiry" />
           
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 p-1">
            <div class="card">
                <div class="card-body table-card p-0">
                    <div class="quick-main">
                        <div class="grid-box-with-btn">
                            <QuickGrid Items="@moduleQuery" Pagination="@pagination" Class="table">
                                <TemplateColumn Title="" Align="Align.Center">
                                    <ChildContent>
                                        <div class="d-flex align-items-center justify-content-center">
                                            <input @bind="context.IsSelected" @onclick:stopPropagation="true" type="checkbox" />
                                        </div>
                                    </ChildContent>
                                </TemplateColumn>
                                <PropertyColumn Property="@(x => x.EnquiryNo)" Sortable="true" Title="Enq No." Class="text-center">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" @bind="nameFilter" @bind:event="oninput" placeholder="EnquiryNo...." />
                                        </div>
                                    </ColumnOptions>
                                    </PropertyColumn>
                                <PropertyColumn Sortable="true" Property="@(x => x.StudentFirstName)" Title="Student Name">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" @bind="nameFilter" @bind:event="oninput" placeholder="Studentname...." />
                                        </div>
                                    </ColumnOptions>
                                </PropertyColumn>
                                <TemplateColumn Title="Father Name" Sortable="true" SortBy="GridSort<EnquiryListResponse>.ByAscending(x => x.FatherName)" Align="Align.Left">
                                    <ChildContent>
                                        @(string.IsNullOrWhiteSpace(context.FatherName) ? " " : context.FatherName)
                                    </ChildContent>
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" @bind="nameFilter" @bind:event="oninput" placeholder="Fathername..." />
                                        </div>
                                    </ColumnOptions>
                                </TemplateColumn>
                                <TemplateColumn Title="Contact No." Sortable="true" SortBy="GridSort<EnquiryListResponse>.ByAscending(x => x.MobileNo)" Align="Align.Center">
                                    <ChildContent>
                                        @(string.IsNullOrWhiteSpace(context.MobileNo) ? " " : context.MobileNo)
                                    </ChildContent> 
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" @bind="nameFilter" @bind:event="oninput" placeholder="ContactNo..." />
                                        </div>
                                    </ColumnOptions>
                                </TemplateColumn>
                                <PropertyColumn Property="@(x => x.Gender)" Sortable="true" Title="Gender" Align="Align.Center" Class="text-center" />
                                <TemplateColumn Title="Class Name" Sortable="true" SortBy="GridSort<EnquiryListResponse>.ByAscending(x => x.ClassName)" Align="Align.Center" Class="text-center">
                                    <ChildContent>
                                        @(string.IsNullOrWhiteSpace(context.ClassName) ? " " : context.ClassName)
                                    </ChildContent>
                                </TemplateColumn>
                                <PropertyColumn Format="dd-MM-yyyy" Property="@(x => x.DateOfBirth)" Class="text-center" Align="Align.Center" Title="Date Of Birth" />
                                <PropertyColumn Format="dd-MM-yyyy" Align="Align.Center" Class="text-center" Property="@(x => x.EnquiryDate)" Title="Applied Date" />
                                <TemplateColumn Title="Followup Date" Sortable="true" SortBy="GridSort<EnquiryListResponse>.ByAscending(x => x.NextFollowupDate)" Class="text-center" Align="Align.Center">
                                    <ChildContent>
                                        @(string.IsNullOrWhiteSpace(context.NextFollowupDate) ? " " : context.NextFollowupDate)
                                    </ChildContent>
                                </TemplateColumn>
                                     <TemplateColumn Align="Align.Center" Title="Action">
                                    @* <ActionButtonGroup  CurrentUrl="@currentUrl" OnEditClick="() => EditEnqiry(context)"  /> *@
                                         <div class="action-btn-group">
                                        <button class="btn-icon edit-btn custom-tooltip " data-tooltip="Edit"  @onclick="() => EditEnqiry(context)">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>

                                        <button class="btn-icon inactive-btn custom-tooltip " data-tooltip="Followup" @onclick="() => AddFollowup(context)">
                                            <i class="bi bi-hand-index-thumb"></i>
                                    </button>
                                    </div>
                                </TemplateColumn>
                            </QuickGrid>
                        </div>
                        <div class="footer-pagination">
                            <div class="d-flex align-items-center">
                                <div class="welcome-text w-100">
                                    <Paginator State="@pagination" />
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <div class="col-12 p-1">
            <div class="page-heading d-flex align-items-center justify-content-end">

                <div class="d-flex align-items-center gap-2">
                    <div class="form-box">
                        <button class="table-btn" @onclick="NewRegistrations">
                            New Registration
                        </button>
                    </div>
                    <AdmitChildButton CurrentUrl="@currentUrl" ButtonText=" Export To Excel" Export="ExpotToExcel" />
                    <AdmitChildButton CurrentUrl="@currentUrl" ButtonText="Print Summary" Export="PrintExcelSummary" />

                    @* <div class="form-box">
                        <button class="table-btn" @onclick="ExpotToExcel">
                            Export To Excel
                        </button>
                    </div>
                    <div class="form-box">
                        <button class="table-btn" @onclick="PrintExcelSummary">
                            Print Summary
                        </button>
                    </div> *@
                </div>
            </div>
        </div>


    </div>
</section>
@if (ShowPopupEnquery)
{
    <div class="custom-modal row m-0 align-items-center">
        <div class="col-sm-12 col-md-8">
            <div class="modal-content clearfix main-popup">
                <div class="head-btn">
                    <h5 class="modal-title">@((enquiryModel.EnquiryId == 0) ? "Add New Enquiry" : "Edit Enquiry")</h5>
                    <button data-access="Close" type="button" @onclick="ClosePopup" class="close"><span aria-hidden="true">×</span></button>
                </div>
                <EditForm Model="@enquiryModel" OnValidSubmit="OnSaveEnquiry">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="row gap-22-0">

                            <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                                <div class="form-box-group static-label">
                                    <InputSelect class="floating-input" placeholder=" " @bind-Value="@CurrentSession">
                                    <option  value="" selected >--Select--</option>
                                    @foreach (var data in sessionlist.Where(x => x.IsValid == true))
                                    {
                                    <option value="@data.SessionId">@data.SessionName </option>
                                    }
                                    </InputSelect>
                                    <label class="floating-label">Session</label>
                                </div>
                            </div>

                            <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                                <div class="form-box-group">
                                    <InputDate class="floating-input" placeholder=" " @bind-Value="enquiryModel.EnquiryDate" />
                                    <label class="floating-label">Enq. Date <span class="required">*</span></label>
                                    <ValidationMessage For="@(() => enquiryModel.EnquiryDate)" />
                                </div>
                            </div>

                            <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                                <div class="form-box-group static-label">
                                    <InputSelect class="floating-input" placeholder=" " @bind-Value="enquiryModel.ClassCode" autocomplete="off">
                                    <option  value="" selected >--Select--</option>
                                    @foreach (var cs in classlist.Where(x => x.IsValid == true))
                                    {
                                    <option Value="@cs.ClassCode">@cs.ClassName</option>
                                    }
                                    </InputSelect>
                                    <label class="floating-label">Class Name <span class="required">*</span></label>
                                    <ValidationMessage For="@(() => enquiryModel.ClassCode)" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                                <div class="form-box-group static-label">
                                    <InputSelect class="floating-input" placeholder=" " autocomplete="off" @bind-Value="enquiryModel.Gender" maxlength="10">
                                    <option  value="" selected >--Select--</option>
                                    @foreach (var cs in genderModallist.Where(x => x.IsValid == true))
                                    {
                                    <option Value="@cs.GenderName">@cs.GenderName</option>
                                    }
                                    </InputSelect>
                                    <label class="floating-label">Gender <span class="required">*</span></label>
                                    <ValidationMessage For="@(() => enquiryModel.Gender)" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                                <div class="form-box-group">
                                    <InputText class="floating-input" placeholder=" " @bind-Value="enquiryModel.StudentFirstName" autocomplete="off" maxlength="100" onkeypress="return /^[a-zA-Z]$/.test(event.key)" />
                                    <label class="floating-label">Student First Name <span class="required">*</span></label>
                                    <ValidationMessage For="@(() => enquiryModel.StudentFirstName)" />
                                </div>
                            </div>


                            <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                                <div class="form-box-group">
                                    <InputText class="floating-input" placeholder=" " @bind-Value="enquiryModel.StudentMiddleName" autocomplete="off" maxlength="100" onkeypress="return /^[a-zA-Z]$/.test(event.key)" />
                                    <label class="floating-label">Student Middle Name</label>
                                </div>
                            </div>


                            <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                                <div class="form-box-group">
                                    <InputText class="floating-input" placeholder=" " @bind-Value="enquiryModel.StudentLastName" autocomplete="off" maxlength="100" onkeypress="return /^[a-zA-Z]$/.test(event.key)" />
                                    <label class="floating-label">Student Last Name</label>
                                </div>
                            </div>



                            <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                                <div class="form-box-group">
                                    <InputDate class="floating-input" placeholder=" " @bind-Value="enquiryModel.DateOfBirth" max="@DateTime.Today.ToString("dd-MM-yyyy")" autocomplete="off" />
                                    <label class="floating-label">Date Of Birth</label>
                                </div>
                            </div>

                            <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                                <div class="form-box-group">
                                    <InputText class="floating-input" placeholder=" " @bind-Value="enquiryModel.MobileNo" autocomplete="off" onkeypress="return /^[0-9]$/.test(event.key)" MaxLength="10" />
                                    <label class="floating-label">Mobile No. <span class="required">*</span></label>
                                    <ValidationMessage For="@(() => enquiryModel.MobileNo)" />
                                </div>
                            </div>

                            <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                                <div class="form-box-group">
                                    <InputText class="floating-input" placeholder=" " @bind-Value="enquiryModel.FatherName" autocomplete="off" maxlength="100" onkeypress="return /^[a-zA-Z ]$/.test(event.key)" />
                                    <label class="floating-label">Father's Name <span class="required">*</span></label>
                                    <ValidationMessage For="@(() => enquiryModel.FatherName)" />
                                </div>
                            </div>

                            <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                                <div class="form-box-group">
                                    <InputText class="floating-input" placeholder=" " @bind-Value="enquiryModel.MotherName" autocomplete="off" maxlength="100" onkeypress="return /^[a-zA-Z ]$/.test(event.key)" />
                                    <label class="floating-label">Mother's Name</label>
                                </div>
                            </div>

                            <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                                <div class="form-box-group">
                                    <InputText class="floating-input" placeholder=" " @bind-Value="enquiryModel.AlternateContactNo" autocomplete="off" onkeypress="return /^[0-9]$/.test(event.key)" MaxLength="10" />
                                    <label class="floating-label">Alternate No.</label>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                                <div class="form-box-group">
                                    <InputText class="floating-input" placeholder=" " @bind-Value="enquiryModel.Email" autocomplete="off" />
                                    <label class="floating-label">E-Mail Id</label>
                                    <ValidationMessage For="@(() => enquiryModel.Email)" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-4 col-lg-8">
                                <div class="form-box-group">
                                    <InputText class="floating-input"  @bind-Value="enquiryModel.Address" autocomplete="off"></InputText>
                                    <label class="floating-label">Address <span class="required">*</span></label>
                                    <ValidationMessage For="@(() => enquiryModel.Address)" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                                <div class="form-box-group">
                                    <InputText class="floating-input" placeholder=" " @bind-Value="enquiryModel.SourceOfEnquiry" autocomplete="off" maxlength="100" />
                                    <label class="floating-label">Source of Enquiry</label>
                                </div>
                            </div>  

                              
                            <div class="col-12 col-sm-6 col-md-4 col-lg-8">
                                <div class="form-box-group">
                                    <InputText class="floating-input"  @bind-Value="enquiryModel.Remarks" autocomplete="off"></InputText>
                                    <label class="floating-label">Remark</label>
                                </div>
                            </div>

                        </div>
                    </div>

                    <div class="modal-footer">
                        <div class="form-group btn-gr">
                            <SaveUpdateButton Id="enquiryModel.EnquiryId" OnClickCancel="ClosePopup" />
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}


@if (ShowPopupFollowup)
{
    <div class="custom-modal row m-0 align-items-center">
        <div class="col-sm-12 col-md-9">
            <div class="modal-content clearfix main-popup">
                <div class="head-btn">
                    <h5 class="modal-title">Follow-up</h5>
                    <button data-access="Close" type="button" @onclick="ClosePopup" class="close"><span aria-hidden="true">×</span></button>
                </div>
                @if (ShowSuccess)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        ✅ &nbsp; &nbsp; <strong> Followup submit successfully !</strong>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                <div class="modal-body">
                    <div class="row gap-10-0">

                        <div class="col-12 col-sm-6 col-md-6">
                            <div class="form-box">
                                <div class="border-box d-flex justify-content-between align-items-center p-2">
                                    <label class="d-flex align-items-center form-label">Enquiry No : </label>
                                    <label class="d-flex align-items-center form-label">@enquiryModel.EnquiryNo</label>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6 col-md-6">
                            <div class="form-box">
                                <div class="border-box d-flex justify-content-between align-items-center p-2">
                                    <label class="d-flex align-items-center form-label">Student Name : </label>
                                    <label class="d-flex align-items-center form-label">@enquiryModel.StudentFirstName</label>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6 col-md-6">
                            <div class="form-box">
                                <div class="border-box d-flex justify-content-between align-items-center p-2">
                                    <label class="d-flex align-items-center form-label">Contact No : </label>
                                    <label class="d-flex align-items-center form-label">@enquiryModel.MobileNo</label>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6 col-md-6">
                            <div class="form-box">
                                <div class="border-box d-flex justify-content-between align-items-center p-2">
                                    <label class="d-flex align-items-center form-label">Followup date : </label>
                                    <label class="d-flex align-items-center form-label">@addFollowup.FollowupDate?.ToString("dd-MM-yyyy")</label>
                                </div>
                            </div>
                        </div>


                        <div class="col-12">
                            <hr class="my-1" />
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-box">
                                <label for="" class="form-label">Interaction Mode</label>
                                <div class="border-box d-flex justify-content-center align-items-center gap-3">
                                    <InputRadioGroup @bind-Value="@addFollowup.InteractionVia">
                                        <div class="d-flex align-items-center gap-1">
                                            <InputRadio Value="@("0")" />
                                            <label class="form-label">
                                                By Call
                                            </label>
                                        </div>

                                        <div class="d-flex align-items-center gap-1">
                                            <InputRadio Value="@("1")" />
                                            <label class="form-label">
                                                By SMS
                                            </label>
                                        </div>
                                        <div class="d-flex align-items-center gap-1">
                                            <InputRadio Value="@("2")" />
                                            <label class="form-label">
                                                By Email
                                            </label>
                                        </div>
                                    </InputRadioGroup>
                                </div>

                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-box">
                                <label for="" class="form-label">Interest Status</label>
                                <div class="border-box d-flex justify-content-center align-items-center gap-3">
                                    <InputRadioGroup @bind-Value="@addFollowup.FollowupStatus">
                                        <div class="d-flex align-items-center gap-1">
                                            <InputRadio Value="@("1")" />
                                            <label class="form-label">
                                                Interested
                                            </label>
                                        </div>

                                        <div class="d-flex align-items-center gap-1">
                                            <InputRadio Value="@("2")" />
                                            <label class="form-label">
                                                Most Interested
                                            </label>
                                        </div>
                                        <div class="d-flex align-items-center gap-1">
                                            <InputRadio Value="@("0")" />
                                            <label class="form-label">
                                                Not Interested
                                            </label>
                                        </div>
                                    </InputRadioGroup>
                                </div>

                            </div>
                        </div>

                       

                        <div class="col-12 col-sm-6">
                            <div class="form-box-group">
                                <InputDate class="floating-input" placeholder=" " @bind-Value="addFollowup.NextFollowupDate" />
                                <label class="floating-label">Next Followup Date</label>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6">
                            <div class="form-box-group">
                                <InputText class="floating-input" placeholder=" " @bind-Value="addFollowup.Remarks" autocomplete="off" />
                                <label class="floating-label">Followup Remark <span class="required">*</span></label>
                            </div>
                        </div>

                        <div class="col-12 mt-3">
                            <hr class="my-1" />
                        </div>
                        <div class="col-12">
                            <div class="table-card m-1 p-0 scrollbar-thin" style="max-height: 250px; min-height:100px;">
                                <QuickGrid Items="@followupQueryable" Pagination="@pagination" Class="table">
                                    @{
                                        int srNo = 1;
                                    }
                                    <TemplateColumn Title="Sr No." Class="text-center" Align="Align.Center">
                                        <ChildContent>
                                            @(srNo++)
                                        </ChildContent>
                                    </TemplateColumn>

                                    <PropertyColumn Align="Align.Center" Class="text-center" Property="@(x => x.FollowUpDate)" Sortable="true" Title="Followup Date">
                                    </PropertyColumn>
                                    <TemplateColumn Title="Remarks" Align="Align.Left">
                                        <ChildContent>
                                            @(string.IsNullOrWhiteSpace(context.FollowUpRemark) ? " " : context.FollowUpRemark)
                                        </ChildContent>
                                    </TemplateColumn>
                                    <PropertyColumn Align="Align.Center" Class="text-center" Property="@(x => string.IsNullOrWhiteSpace(x.NextDate)? " " : x.NextDate)" Sortable="true" Title="Next Followup Date">
                                    </PropertyColumn>
                                    <PropertyColumn Property="@(x => x.InteractionVia)" Class="text-center" Align="Align.Center" Title="Interaction Mode" />
                                    <PropertyColumn Property="@(x => x.FollowupStatusName)" Class="text-center" Align="Align.Center" Title="Interest" />

                                </QuickGrid>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <div class="form-group btn-gr">
                        <button type="submit" class="ui fade op-1 animated button form-btn" @onclick="OnSaveFolloup">
                            <div class="visible content">Submit</div>
                            <div class="hidden content">
                                <i class="fa fa-save"></i>
                            </div>
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>

}


@if (ShowPopup)
{
    <div class="custom-modal row m-0">
        <div class="col-12 col-sm-7 col-md-5 col-lg-4 col-xl-9">
            <div class="modal-content clearfix main-popup ">
                <div class="head-btn">
                    <h5 class="modal-title">Search New Registration</h5>
                    <button data-access="Close" type="button" @onclick="ClosePopup" class="close"><span aria-hidden="true">×</span></button>
                </div>
                <div class="modal-body">
                    <div class="row gap-10-0">
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                            <div class="form-box-group">
                                <InputText class="floating-input" placeholder=" " @bind-Value="requestlist.StudentName" oninput="this.value=this.value.replace(/[^a-zA-Z0-9]/g,'')" />
                                <label class="floating-label">Student First Name</label>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                            <div class="form-box-group">
                                <InputDate class="floating-input" placeholder=" " @bind-Value="requestlist.FromDate" />
                                <label class="floating-label">Date From</label>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                            <div class="form-box-group">
                                <InputDate class="floating-input" placeholder=" " @bind-Value="requestlist.ToDate" />
                                <label class="floating-label">Date To</label>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                            <div class="form-box-group">
                                <InputText class="floating-input" placeholder=" " @bind-Value="requestlist.MobileNo" oninput="this.value=this.value.replace(/[^0-9]/g,'')" />
                                <label class="floating-label">Mobile No.</label>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                            <div class="form-box-group static-label">
                                <InputSelect class="floating-input" placeholder=" " @bind-Value="requestlist.AppliedFrom">
                                <option value="-1" selected>Online/Offline</option>
                                <option value="1=">Online</option>
                                <option value="0">Offline</option>
                                </InputSelect>
                                <label class="floating-label">Applied From</label>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                            <div class="form-box-group">
                                <label for="sibling" class="floating-label">Followup Status</label>
                                <select class="floating-input">
                                    <option value="-1" selected>All</option>
                                    <option value="2">Most Interested</option>
                                    <option value="1">Interested</option>
                                    <option value="0">Not Interested</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                            <div class="form-box-group static-label">
                                <label for="applied" class="floating-label">Date Apply As</label>
                                <div class="border-box d-flex justify-content-center align-items-center gap-3">
                                    <InputRadioGroup @bind-Value="requestlist.DateWorkAs">
                                        <div class="d-flex align-items-center gap-1">
                                            <InputRadio Value="@("0")" />
                                            <label class="form-label">
                                                Enquiry
                                            </label>
                                        </div>

                                        <div class="d-flex align-items-center gap-1">
                                            <InputRadio Value="@("1")" />
                                            <label class="form-label">
                                                Followup
                                            </label>
                                        </div>

                                    </InputRadioGroup>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
                <div class="modal-footer">
                    <button class="ui fade op-1 animated button form-btn" tabindex="0" @onclick="SearchStudent">
                        <div class="visible content">Search</div>
                        <div class="hidden content">
                            <i class="bi bi-search"></i>
                        </div>
                    </button>
                </div>

            </div>
        </div>
    </div>
}


