    private async Task OnSaveEnquiry()
    {
        try
        {
            ShowPopupEnquery = false;

            if (enquiryModel.EnquiryId > 0)
            {

                ShowPopupEnquery = false;
                var isConfirmed = await JS.InvokeAsync<bool>("showUpdateConfirm");
                if (!isConfirmed)
                {
                    ShowPopupEnquery = true;
                    return;
                }
                bool isSame = CommonMethod.IsEdited(enquiryModel, olddesignation);
                if (!isSame)
                {
                    await Alert.ShowWarning("No changes detected.");
                    ShowPopupEnquery = true;
                    return;
                }
            }
            if (enquiryModel.EnquiryId == 0)
            {
                var submit = await Alert.ShowConfirm("Are you sure, you want to submit records?");
                if (!submit)
                    return;
            }
            ShowPopupEnquery = false;
            enquiryModel.CreatedBy = UserName;
            enquiryModel.GroupCode = groupcode;
            enquiryModel.BranchCode = branchcode;
            enquiryModel.SessionId = CurrentSession;
            enquiryModel.IsOnline = 1;
            string apiUrl = "Enquiry/AddOrUpdateEnquiry";
            var apiResponse = await httpService.Post<ApiResponse<object>>(apiUrl, enquiryModel);
            if (apiResponse.Success && apiResponse.Code == 1)
            {
                await Alert.ShowMessage($"Enquiry submit successfully! <br/>" + $"<b>Enquiry No:</b> {apiResponse.Data}");
            }
            else if (apiResponse.Code == 2)
            {
                await Alert.ShowSuccess("Enquiry" + @Localizer["Updated"]);
            }
            else if (apiResponse.Code == -2)
            {
                await Alert.ShowSuccess("Enquiry" + @Localizer["Admin"]);
            }
            else
            {
                await Alert.ShowCustomAlert(@Localizer["Admin"]);
            }
            enquiryModel=new();
            await LoadData();

        }
        catch (Exception ex)
        {
            await Alert.ShowError($"{@Localizer["Error"]}: {ex.Message}");
        }
        finally
        {

            StateHasChanged();
        }
    }

