    {
        ShowPopup = false;
    }
    private void OpenSearch()
    {
        ShowPopup = true;
    }
    private async Task LoadData()
    {
        var branchResult = await sessionStorage.GetAsync<string>("BranchCode");
        branchcode = branchResult.Value;
        var groupResult = await sessionStorage.GetAsync<string>("GroupCode");
        groupcode = groupResult.Value;
        string ApiUri1 = "gender/GetGender";
        genderModallist = await httpService.Get<List<GenderModal>>(ApiUri1) ?? new();
        string ApiUri = "BranchClass/GetClassCode";
        classlist = await httpService.Get<List<BranchClassModel>>(ApiUri) ?? new();
        string ApiUri2 = "Session/GetSession";
        sessionlist = await httpService.Get<List<SessionModel>>(ApiUri2) ?? new();
        PeriodTypeList = await httpService.Get<List<PeriodMaster>>("FeeCollectionPeriodConfig/GetPeriodTypeName") ?? new();

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
           

           
            //sessionvalue = await _commonmethod.SetCurrentSession();
            CurrentSession = await _commonmethod.SetCurrentSessionData();
            await LoadData();
            foreach (var item in classlist)
            {
                item.IsSelected = true;
            }
            StateHasChanged();
        }
    }
    private IEnumerable<StudentModel> FilteredStudents =>
       string.IsNullOrWhiteSpace(searchText)
           ? Students
           : Students.Where(x =>
               (x.StudentName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
               (x.StudentNo?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
               (x.AdmissionNo?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
               (x.ClassName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false));

    
    private void SelectStudent(StudentModel student)
    {
        selectedStudentId = student.StudentId;
        selectedStudentName = student.StudentName;
    }
    private string SelectedTextData
    {
        get
        {
            var selected = Students.Where(x => x.IsSelected).ToList();

            if (!selected.Any())
                return "Select Student";

            if (selected.Count <= 4)
                return string.Join(", ", selected.Select(x => x.StudentNo));

            return string.Join(", ", selected.Take(4).Select(x => x.StudentNo))
                   + $" +{selected.Count - 4} More";
        }
    }
    private async Task OpenDateFrom(string value)
    {
        if (value == "DateFrom")
        {
            await JS.InvokeVoidAsync("openDatePicker", dateFromInput);
        }
        else
        {
            await JS.InvokeVoidAsync("openDatePicker", dateToInput);

        }
    }
    private string SelectedText => SelectAll ? "All Class Selected" :
     string.Join(", ", classlist.Where(x => x.IsSelected).Select(x => x.ClassName));
