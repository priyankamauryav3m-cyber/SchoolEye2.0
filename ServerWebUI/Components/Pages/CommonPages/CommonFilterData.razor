@page "/CheckFilterData"
@using DomainModel.Admin
@using DomainModel.SchoolMaster
@using System.Net
@using System.Text.Json
@using Microsoft.AspNetCore.Mvc
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyApp.Common
@inject Shared.IHttpService httpService

@inject HttpClient Http
@inject IStringLocalizer<Resource> Localizer
@inject SweetAlertService Alert
@rendermode InteractiveServer
@using ServerWebUI.Components.Common
@using ServerWebUI.Components.Pages.CommonPages
@inject IJSRuntime JS
@inject ICommonMethod _commonmethod
@inject PermissionState PermissionState
@inject NavigationManager Nav

<div class="main-container">
    <div class="row m-0 main-row">
        <div class="col-12 p-1" id="main-header">
            <div class="page-heading d-flex align-items-center justify-content-between">
                <p class="m-0 page-name px-1">Search Student</p>
                <div class="form-box">
                    <div class="d-flex gap-2">
                        <button class="icon-btn icon-btn-white open-popup " @onclick="OpenSearch" data-id="popup" tabindex="0">
                            <i class="bi bi-sliders"></i>
                        </button>
                    </div>
                </div>

            </div>
        </div>
     
    </div>
</div>
@if (ShowPopup)
{
    <div class="custom-modal row m-0">
        <div class="col-12 col-sm-7 col-md-5 col-lg-4 col-xl-10">
            <div class="modal-content clearfix main-popup overflow-visible">
                <div class="head-btn">
                    <h5 class="modal-title">Search Student</h5>
                    <button data-access="Close" type="button" @onclick="ClosePopup" class="close"><span aria-hidden="true">×</span></button>
                </div>
                <div class="modal-body">
                    <div class="row gap-10-0">

                        <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                            <div class="form-box">
                                <label for="date from" class="form-label">Admission No</label>
                                <input type="text" placeholder="Search admission no....." class="form-input" />
                            </div>
                        </div>

                        <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                            <div class="form-box">
                                <label for="student-name" class="form-label">Student No.</label>
                                <input type="text" placeholder="Search student no....." class="form-input" />
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                            <div class="form-box">
                                <label for="first-name" class="form-label">Student  Name</label>
                                <input type="text" placeholder="Search student name....." class="form-input">
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                            <div class="form-box">
                                <label for="student-name" class="form-label">Class</label>
                                <div class="position-relative">
                                    <button class="form-input w-webkit" type="button" data-bs-toggle="dropdown">
                                        @SelectedText
                                    </button>
                                    <div class="dropdown-menu cu-dropdown" style="max-height:350px; overflow-y:auto; align-items:center; align-content:center; scrollbar-width: thin;">
                                        <div class="form-check">
                                            <input class="form-check-input map-checkbox" type="checkbox" @bind="SelectAll" @bind:after="ToggleSelectAll" />
                                            <span> All</span>
                                        </div>
                                        @foreach (var item in classlist.Where(x => x.IsValid == true))
                                        {
                                            <div class="form-check">
                                                <input class="form-check-input map-checkbox" type="checkbox" @bind="item.IsSelected" />
                                                <span>@item.ClassName</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                            <div class="form-box">
                                <label for="first-name" class="form-label">Common Phone No.</label>
                                <input type="text" placeholder="Search phone no....." class="form-input">
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                            <div class="form-box">
                                <label for="first-name" class="form-label">Current Addres</label>
                                <input type="text" placeholder="Search current address....." class="form-input">
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                            <div class="form-box">
                                <label for="date from" class="form-label">Date From</label>
                                <input type="date" @ref="dateFromInput" class="form-input" @onclick='() => OpenDateFrom("DateFrom")' />

                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                            <div class="form-box">
                                <label for="date to" class="form-label">Date To</label>
                                <input type="date" @ref="dateToInput" class="form-input" @onclick='() => OpenDateFrom("DateTo")' />

                            </div>
                        </div>

                        <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                            <div class="form-box">
                                <label for="student-name" class="form-label">Gender</label>
                                <select class="form-input">
                                    <option value="0">Select</option>
                                    @foreach (var data in genderModallist)
                                    {
                                        <option value="@data.GenderName">@data.GenderName</option>

                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                            <div class="form-box">
                                <label for="first-name" class="form-label">Period Type</label>
                                <InputSelect @bind-Value="searchAny.BranchCode" class="form-input">
                                    <option value="" selected>--Select--</option>
                                    @foreach (var data in PeriodTypeList)
                                    {
                                        <option value="@data.PeriodTypeName">@data.PeriodTypeName</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>

                       
                     
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="ui fade op-1 animated button form-btn" tabindex="0">
                        <div class="visible content">Search</div>
                        <div class="hidden content">
                            <i class="bi bi-search"></i>
                        </div>
                    </button>
                </div>

            </div>
        </div>
    </div>
}


