@page "/generationidconfiguration"
@using DomainModel.Admin
@using Microsoft.AspNetCore.Authorization
@using ServerWebUI.Components.Pages.CommonPages
@inject IHttpClientFactory ClientFactory
@using DomainModel.SchoolMaster
@using Microsoft.AspNetCore.Components.QuickGrid
@using System.Net
@using System.Text.Json
@inject ICommonMethod CommonMethod
@inject IStringLocalizer<Resource> Localizer
@using MyApp.Common
@inject IJSRuntime JS
@inject Shared.IHttpService httpService
@inject HttpClient Http
@inject SweetAlertService Alert
@rendermode InteractiveServer

<style>
    .grid-box .gic-input {
        width: 100%;
        border: none;
        border-bottom: 1px solid #d9dce3;
        background: transparent;
        padding: 4px 2px;
        font-size: inherit;
        font-family: inherit;
        color: inherit;
        outline: none;
        border-radius: 0;
    }

        .grid-box .gic-input:focus {
            border-bottom: 1px solid #4a6cf7;
            background: #f7f9ff;
        }

    .grid-box .gic-checkbox {
        width: 16px;
        height: 16px;
        cursor: pointer;
    }

    .quickgrid thead th:nth-last-child(2) {
        min-width: 75px;
    }

    .quickgrid thead th:last-child {
        min-width: 75px;
    }

    .quickgrid thead th:first-child {
        min-width: 200px;
    }

    .quickgrid thead th:nth-child(2) {
        min-width: 100px;
    }
</style>

<div class="main-container">
    <div class="row m-0 main-row">
        <div class="col-12 p-1" id="main-header">
            <div class="page-heading d-flex align-items-center justify-content-between">
                <p class="m-0 page-name px-1">Generation Id Configuration</p>
                <div class="d-flex align-items-center gap-2">
                    <div class="form-box">
                        <InputSelect @bind-Value="schoolbranchcode" @bind-Value:after="OnBranchChanged" class="form-input" autocomplete="off">
                            <option value="" selected>--Select--</option>
                            @foreach (var cs in branchlist)
                            {
                                <option Value="@cs.BranchCode">@cs.BranchName</option>
                            }

                        </InputSelect>
                    </div>
                    <div class="form-box">
                        <InputSelect @bind-Value="@CurrentSession" @bind-Value:after="OnSessionChanged" name="session" class="form-input">
                            <option value="0">-- Select Session --</option>
                            @foreach (var data in sessionlist.Where(x => x.IsValid == true))
                            {
                                <option value="@data.SessionId">@data.SessionName </option>
                            }
                        </InputSelect>
                    </div>
                    <div class="form-box">
                        <button class="ui fade op-1 animated button form-btn" @onclick="SearchIdCinfigration" tabindex="0">
                            <div class="visible content">Search</div>
                            <div class="hidden content">
                                <i class="bi bi-search"></i>
                            </div>
                        </button>
                    </div>
                    <div class="form-box">
                        <button type="button" class="table-btn" @onclick="AddRow">
                            Add Row
                        </button>
                    </div>
                  
                </div>
            </div>
        </div>

        <div class="col-12 p-1">
            <div class="card">
                <div class="card-body table-card p-0 scrollbar-thin">
                    <div class="quick-main">
                        <div class="grid-box">
                          
                            <QuickGrid Items="@moduleQuery" Pagination="@pagination" Class="table">
                                <TemplateColumn Title="Keyword" Sortable="true" SortBy="GridSort<ConfigRowVm>.ByAscending(x=>x.Data.KeyWord)" Align="Align.Left">
                                    <ChildContent>
                                        @if (context.IsEditing)
                                        {
                                            <div class="form-box">
                                                <select class="gic-input" @bind="context.Data.KeyWord" @bind:event="oninput">
                                                    <option value="" selected> Select </option>
                                                    @foreach (var data in keyWordlist)
                                                    {
                                                        <option value="@data.KeyWord">@data.KeyWord</option>
                                                    }
                                                </select>
                                            </div>
                                        }
                                        else
                                        {
                                            @(string.IsNullOrWhiteSpace(context.Data.KeyWord) ? " " : context.Data.KeyWord)
                                        }
                                    </ChildContent>
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" @bind="nameFilter" @bind:event="oninput" placeholder="Keyword..." />
                                        </div>
                                    </ColumnOptions>
                                </TemplateColumn>
                                <TemplateColumn Sortable="true" SortBy="GridSort<ConfigRowVm>.ByAscending(x => x.Data.PreFix)" Title="Prefix" Align="Align.Left">
                                    <ChildContent>
                                        @if (context.IsEditing)
                                        {
                                            <input class="gic-input" placeholder=" " @bind="context.Data.PreFix" @bind:event="oninput" />
                                        }
                                        else
                                        {
                                            @(string.IsNullOrWhiteSpace(context.Data.PreFix) ? " " : context.Data.PreFix)
                                        }
                                    </ChildContent>
                                </TemplateColumn>
                                <TemplateColumn Title="Class Group" Sortable="true" SortBy="GridSort<ConfigRowVm>.ByAscending(x => x.Data.ClassGroup)" Align="Align.Left">
                                    <ChildContent>
                                        @if (context.IsEditing)
                                        {
                                            <div class="form-box">
                                                <select class="gic-input" @bind="context.Data.ClassGroup" @bind:event="oninput">
                                                    <option value="" selected> Select </option>
                                                    @foreach (var data in classlist)
                                                    {
                                                        <option value="@data.ClassCode">@data.ClassName</option>
                                                    }
                                                </select>
                                            </div>

                                        }
                                        else
                                        {
                                            @(string.IsNullOrWhiteSpace(context.Data.ClassGroup) ? " " : context.Data.ClassGroup)
                                        }
                                    </ChildContent>
                                </TemplateColumn>

                                <TemplateColumn Title="Key Val" Sortable="true" SortBy="GridSort<ConfigRowVm>.ByAscending(x => x.Data.KeyValue)" Align="Align.Left">
                                    <ChildContent>
                                        @if (context.IsEditing)
                                        {
                                            <input type="number" class="gic-input" placeholder=" " @bind="context.Data.KeyValue" @bind:event="oninput" />
                                        }
                                        else
                                        {
                                            @context.Data.KeyValue
                                        }
                                    </ChildContent>
                                </TemplateColumn>

                                <TemplateColumn Title="Key Val Len" Align="Align.Left">
                                    <ChildContent>
                                        @if (context.IsEditing)
                                        {
                                            <input type="number" class="gic-input" placeholder=" " @bind="context.Data.KeyValueLength" @bind:event="oninput" />
                                        }
                                        else
                                        {
                                            @context.Data.KeyValueLength
                                        }
                                    </ChildContent>
                                </TemplateColumn>

                               @*  <TemplateColumn Title="Pattern For" Align="Align.Left">
                                    <ChildContent>
                                        @if (context.IsEditing)
                                        {
                                            <input class="gic-input" placeholder=" " @bind="context.Data.PatternFor" @bind:event="oninput" />
                                        }
                                        else
                                        {
                                            @(string.IsNullOrWhiteSpace(context.Data.PatternFor) ? " " : context.Data.PatternFor)
                                        }
                                    </ChildContent>
                                </TemplateColumn>

                                <TemplateColumn Title="BTC" Align="Align.Left">
                                    <ChildContent>
                                        @if (context.IsEditing)
                                        {
                                            <input type="number" class="gic-input" placeholder=" " @bind="context.Data.BTCID" @bind:event="oninput" />
                                        }
                                        else
                                        {
                                            @(context.Data.BTCID?.ToString() ?? " ")
                                        }
                                    </ChildContent>
                                </TemplateColumn>
                                <TemplateColumn Class="text-center" Title="BTC Req." Align="Align.Center">
                                    <ChildContent>
                                        @if (context.IsEditing)
                                        {
                                            <input type="checkbox" class="gic-checkbox" @bind="context.Data.BTCRequired" />
                                        }
                                        else
                                        {
                                            @(context.Data.BTCRequired ? "Yes" : "No")
                                        }
                                    </ChildContent>
                                </TemplateColumn> *@
                                <TemplateColumn Class="text-center" Title="Reset Flag" Align="Align.Center">
                                    <ChildContent>
                                        @if (context.IsEditing)
                                        {
                                            <input type="checkbox" class="gic-checkbox" @bind="context.Data.ResetFlag" />
                                        }
                                        else
                                        {
                                            @(context.Data.ResetFlag ? "Yes" : "No")
                                        }
                                    </ChildContent>
                                </TemplateColumn>
                                <TemplateColumn Class="text-center" Title="Branch Req." Align="Align.Center">
                                    <ChildContent>
                                        @(context.Data.BranchCodeRequired ? "Yes" : "No")
                                    </ChildContent>
                                </TemplateColumn>

                               

                                <TemplateColumn Class="text-center" Title="Session Req." Align="Align.Center">
                                    <ChildContent>
                                        @(context.Data.SessionRequired ? "Yes" : "No")
                                    </ChildContent>
                                </TemplateColumn>



                                <TemplateColumn Class="text-center" Title="Status" Align="Align.Center">
                                    <ChildContent>
                                        <span class="@GetStatusClass(context.Data.IsValid == true)">
                                            @(context.Data.IsValid == true ? "Active" : "Inactive")
                                        </span>
                                    </ChildContent>
                                </TemplateColumn>
                                <TemplateColumn Class="text-center" Title="Action" Align="Align.Center">
                                    <ChildContent>
                                        @if (context.IsEditing)
                                        {

                                            <button class="btn btn-sm btn-success me-1" title="Save" @onclick="() => SubmitIdGeneration(context)">
                                                <i class="bi bi-check-lg"></i>
                                            </button>

                                            <button class="btn btn-sm btn-secondary" title="Cancel" @onclick="() => CancelEdit(context)">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-primary" title="Edit" @onclick="() => context.IsEditing = true">
                                                <i class="bi bi-pencil-fill"></i>
                                            </button>
                                        }
                                    </ChildContent>
                                </TemplateColumn>

                            </QuickGrid>
                        </div>
                        <div class="footer-pagination">
                            <div class="d-flex align-items-center">
                                <div class="welcome-text w-100">
                                    <Paginator State="@pagination" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @if (ShowPopup)
        {
            <div class="custom-modal row m-0 align-items-center">
                <div class="col-12 col-sm-7 col-md-5 col-lg-4 col-xl-4">
                    <div class="modal-content clearfix main-popup">
                        <div class="head-btn">
                            <h5 class="modal-title">Admin Password</h5>
                            <button data-access="Close" type="button" @onclick="ClosePopup" class="close"><span aria-hidden="true">×</span></button>
                        </div>

                        <div class="modal-body">
                            <div class="row m-0 form-row">

                                <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                    <div class="form-box-group">
                                        <input type="password" class="floating-input" @bind="SetPassword" placeholder="  " maxlength="6" autocomplete="new-password" />                                        <label class="floating-label">
                                        Password <span class="required">*</span>
                                    </label>
                                </div>
                            </div>

                                

                        </div>
                    </div>
                    <div class="modal-footer">
                        <div class="form-group btn-gr">
                            <button type="button" class="table-btn" @onclick="ValidatePassword">
                                Submit
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    }

</div>

</div>
@if (IsLoading)
{
    <div class="grid-loader-overlay">
        <img src="images/loading.gif" alt="Loading..." />
    </div>
}
else
{
    
}


@code {
    private bool IsLoading = true;
    private bool ShowPopup = false;
    private List<ConfigRowVm> gridRows = new();
    private List<SessionModel> sessionlist = new();
    private List<KeyWordModel> keyWordlist = new();
    private long CurrentSession = 0;
    private string? username = "";
    private string? schoolbranchcode;
    private string? branchcode;
    private string? groupcode;
    private string? currentUrl;
    private List<BranchClassModel> classlist = new();
    private List<BranchNameMst> branchlist = new();
    PaginationState pagination = new() { ItemsPerPage = 15 };
    private string? SetPassword;
    private string PasswordError = "";
    private string nameFilter = "";
   
    private void CancelEdit(ConfigRowVm row)
    {
        row.IsEditing = false;
        if (row.Data.Sid == 0)
        {
            gridRows.Remove(row);
        }
    }
    
    private async Task SubmitPassword()
    {
        SetPassword = "";
        PasswordError = "";
        if (CurrentSession == 0)
        {
            await Alert.ShowWarning("Please select session");
            StateHasChanged();
            return;
        }
        if (string.IsNullOrEmpty(schoolbranchcode))
        {
            await Alert.ShowWarning("Please select branch");
            StateHasChanged();
            return;
        }
        ShowPopup = true;
    }
    private async Task OnBranchChanged()
    {
        foreach (var item in moduleQuery)
        {
            item.Data.BranchCodeRequired = !string.IsNullOrWhiteSpace(schoolbranchcode);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnSessionChanged()
    {

        await SearchIdCinfigration();
        foreach (var item in moduleQuery)
        {
            item.Data.SessionRequired = CurrentSession > 0;
        }
        await InvokeAsync(StateHasChanged);
    }
    private async Task ValidatePassword()
    {
        PasswordError = "";
        if (string.IsNullOrWhiteSpace(SetPassword))
        {
            PasswordError = "Password is required.";
            return;
        }
        if (SetPassword.Trim() != "123456")
        {
            PasswordError = "Wrong password.";
            return;
        }
        ShowPopup = false;
        SetPassword = "";
      //  await SubmitIdGeneration();
    }
    private void ClosePopup()
    {
        ShowPopup = false;
        SetPassword = "";
        PasswordError = "";
    }
    //protected IQueryable<ConfigRowVm> moduleQuery => gridRows.AsQueryable();
    protected IQueryable<ConfigRowVm> moduleQuery
    {
        get
        {
            var result = gridRows.AsQueryable();
            if (!string.IsNullOrEmpty(nameFilter))
            {
                result = result.Where(x => (x.Data.KeyWord != null && x.Data.KeyWord.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)));

            }
            return result;
        }
    }
    public class ConfigRowVm
    {
        public GenerationIdConfigurationModel Data { get; set; } = new();
        public bool IsEditing { get; set; } = false;

    }

    protected override void OnInitialized()
    {
        PermissionState.OnChange += StateHasChanged;
        currentUrl = Nav.Uri;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var userResult = await sessionStorage.GetAsync<string>("UserName");
            username = userResult.Value;

            var branchResult = await sessionStorage.GetAsync<string>("BranchCode");
            branchcode = branchResult.Value;
            var groupResult = await sessionStorage.GetAsync<string>("GroupCode");
            groupcode = groupResult.Value;
            CurrentSession = await CommonMethod.SetCurrentSessionData();
            await OnBranchChanged();
            await OnSessionChanged();
            await LoadData();
            StateHasChanged();
        }
    }



    private async Task SearchIdCinfigration()
    {
        IsLoading = true;
        string ApiUri = $"GenerationIdConfiguration/GetGenerationIdConfiguration/{CurrentSession}";
        var data = await httpService.Get<List<GenerationIdConfigurationModel>>(ApiUri) ?? new();
        gridRows = data.Select(x => new ConfigRowVm { Data = x, IsEditing = false }).ToList();
        schoolbranchcode= gridRows[0].Data.BranchCode;
        StateHasChanged();
        IsLoading = false;
    }

    private async Task LoadData()
    {
        IsLoading = true;
        string ApiUri2 = "Session/GetSession";
        sessionlist = await httpService.Get<List<SessionModel>>(ApiUri2) ?? new();
        string ApiUri1 = "BranchClass/GetClassCode";
        classlist = await httpService.Get<List<BranchClassModel>>(ApiUri1) ?? new();
        branchlist = await httpService.Get<List<BranchNameMst>>("ClassSection/GetBranchName") ?? new();
        var apiResponse = await httpService.Get<ApiResponse<List<KeyWordModel>>>("GenerationIdConfiguration/GetGenerationIdKeyword") ?? new();
        if (apiResponse.Success == true)
        {
            keyWordlist = apiResponse.Data ??new();
        }
        IsLoading = false;
    }

    private string GetStatusClass(bool isActive)
    {
        return isActive ? "activeClr" : "inactiveClr";
    }

    private async Task AddRow()
    {
        
        gridRows.Add(new ConfigRowVm
        {
            Data = new GenerationIdConfigurationModel
            {
                Sid = 0,
                IsValid = true,
                KeyValue = 1,
                KeyValueLength = 1,
                BranchCodeRequired = !string.IsNullOrWhiteSpace(schoolbranchcode),
                SessionRequired = CurrentSession > 0
            },
            IsEditing = true
        });

        StateHasChanged();
    }

    private async Task ChangeRowStatus(ConfigRowVm row)
    {
        try
        {
            bool isActivate = !row.Data.IsValid;

            if (row.Data.Sid == 0)
            {
                // Unsaved row - just remove it from the grid, nothing to toggle on server.
                gridRows.Remove(row);
                StateHasChanged();
                return;
            }

            bool isConfirmed = await JS.InvokeAsync<bool>(isActivate ? "showActiveConfirm" : "showDeleteConfirm");
            if (!isConfirmed)
                return;

            string apiUrl = "GenerationIdConfiguration/DeleteGenerationIdConfiguration";
            var apiResponse = await httpService.Post<ApiResponse<object>>(apiUrl, row.Data.Sid);

            if (apiResponse.Success)
            {
                if (isActivate)
                    await Alert.ShowActive(Localizer["Activated"]);
                else
                    await Alert.ShowDeactive(Localizer["Deleted"]);

                await LoadData();
                StateHasChanged();
            }
            else
            {
                await Alert.ShowCustomAlert(@Localizer["Admin"]);
            }
        }
        catch (Exception ex)
        {
            await Alert.ShowError($"{Localizer["Error"]}: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
        }
    }
    private async Task SubmitIdGeneration(ConfigRowVm row)
    {
        try
        {
            if (CurrentSession == 0)
            {
                await Alert.ShowWarning("Please select a Session.");
                return;
            }

            if (string.IsNullOrWhiteSpace(row.Data.KeyWord))
            {
                await Alert.ShowWarning("Keyword is required.");
                return;
            }
            else if (string.IsNullOrWhiteSpace(row.Data.PreFix))
            {
                await Alert.ShowWarning("Prefix is required.");
                return;
            }
            else if (row.Data.KeyValue <= 0)
            {
                await Alert.ShowWarning("Key Value must be greater than 0.");
                return;
            }
            else if (row.Data.KeyValueLength <= 0)
            {
                await Alert.ShowWarning("Key Value Length must be greater than 0.");
                return;
            }

            row.Data.SessionId = CurrentSession;
            row.Data.GroupCode = groupcode ?? string.Empty;
            row.Data.BranchCode = schoolbranchcode ?? string.Empty;
            row.Data.IsValid = true;
            row.Data.CreatedBy = username;
            row.Data.CreatedDate = DateTime.Now;

            bool isConfirmed = await JS.InvokeAsync<bool>("showUpdateConfirm");
            if (!isConfirmed)
                return;

            string apiUrl = "GenerationIdConfiguration/AddOrUpdateGenerationIdConfiguration";

            // Sirf ek object jayega, list nahi
            var apiResponse = await httpService.Post<ApiResponse<object>>(apiUrl, row.Data);

            if (apiResponse.Code == 0)
            {
                await Alert.ShowWarning("Keyword" + @Localizer["Already"]);
                return;
            }
            else if (apiResponse.Code == 1)
            {
                await Alert.ShowSuccess("Generation Id Configuration" + @Localizer["Inserted"]);
            }
            else if (apiResponse.Code == 2)
            {
                await Alert.ShowSuccess("Generation Id Configuration" + @Localizer["Updated"]);
            }
            else
            {
                return;
            }

            row.IsEditing = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            await Alert.ShowCustomAlert(@Localizer["Admin"]);
        }
        finally
        {
            StateHasChanged();
        }
    }


