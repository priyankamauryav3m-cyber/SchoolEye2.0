                                        <div class="col-12 px-1 mt-3">
                                            <div class="form-box-group">
                                                <InputText class="floating-input" placeholder=" " @bind-Value="studentVisitordetails.Visitor4Email" autocomplete="off" maxlength="30" />
                                                <label class="floating-label">Visitor Email</label>
                                                <ValidationMessage For="@(() => studentVisitordetails.Visitor4Email)" />
                                            </div>
                                        </div>

                                        <div class="col-12 px-1 mt-4">
                                            <div class="form-box-group">
                                                <InputText class="floating-input" placeholder=" " @bind-Value="studentVisitordetails.Visitor4ContactNo" maxlength="10" onkeypress="return /^[0-9]$/.test(event.key)" autocomplete="off" />
                                                <label class="floating-label">Visitor Contact No</label>
                                            </div>
                                        </div>

                                        <div class="col-12 px-1 mt-3">
                                            <div class="form-box-group">
                                                <InputText class="floating-input" placeholder=" " @bind-Value="studentVisitordetails.Visitor4Remarks" autocomplete="off" maxlength="100" />
                                                <label class="floating-label">Visitor Remarks</label>
                                            </div>
                                        </div>

                                        <div class="col-12 px-1 mt-3">
                                            <div class="form-box flex-row align-items-center gap-1">
                                                <InputCheckbox @bind-Value="studentVisitordetails.IsVisitor4Allowed" class="form-input" />
                                                <label for="first-name" class="form-label">Allow To Meet</label>
                                            </div>
                                        </div>

                                    </div>
                                </div>

                            </div>

                        </div>
                    </div>
                    <div class="modal-footer gap-3">
                        <button type="submit" class="ui fade op-1 animated button form-btn" tabindex="0">
                            <div class="visible content">Submit</div>
                            <div class="hidden content">
                                <i class="fa fa-save"></i>
                            </div>
                        </button>
                        <SaveUpdateButton ShowSaveButton="false" OnClickCancel="@ClosePopup"></SaveUpdateButton>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}
