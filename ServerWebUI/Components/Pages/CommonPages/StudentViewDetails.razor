    private void OnDOBChanged()
    {
        try
        {
            if (!viewchildDetails.DateOfBirth.HasValue)
                return;
            if (viewchildDetails.DateOfBirth <= DateTime.Today)
            {
                if (viewchildDetails.DateOfBirth == null)
                {
                    datecalulate = "";
                    return;
                }
                var dateOfBirth = Convert.ToDateTime(viewchildDetails.DateOfBirth);
                datecalulate = _commonmethod.CalculateAge(dateOfBirth);
            }
            else
            {
                customAlert.ShowCustomAlert("Please choose the correct Date of Birth.", false);
                viewchildDetails.DateOfBirth = null;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {

        }
        finally
        {
            StateHasChanged();
        }
    }
