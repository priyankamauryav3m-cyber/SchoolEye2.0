            if (apiResponse.Success == true && apiResponse.Data != null)
            {
                return apiResponse.Data;
            }

            return new StudentAddressDetailsModel();
        }
        catch (Exception ex)
        {
            return null;
        }
        finally
        {
            searchAnyRequest.RequestName = "";
            StateHasChanged();
        }


