    private async Task TabnextPreviuos()
    {
        try
        {
            switch (ActiveTab)
            {
                case "personal-details":
                    viewchildDetails = await httpService.Post<StudentViewDetailsModel>("ViewStudent/GetStudentPersonalDetails", searchAnyRequest) ?? new();
                    ImagePreview = string.IsNullOrEmpty(viewchildDetails.ImagePath) ? "https://demo.schooleye.in/Images/NoPhoto.gif" : viewchildDetails.ImagePath;
                    break;
                case "parents-details":
                    parentsDetails = await httpService.Post<StudentParentDetailsModel>("ViewStudent/GetStudentParentDetails", searchAnyRequest) ?? new();
                    MotherImagePreview = string.IsNullOrEmpty(parentsDetails.MotherImagePath)? "https://demo.schooleye.in/Images/NoPhoto.gif": parentsDetails.MotherImagePath;
                    FatherImagePreview = string.IsNullOrEmpty(parentsDetails.FatherImagePath) ? "https://demo.schooleye.in/Images/NoPhoto.gif" : parentsDetails.FatherImagePath;
                    break;
                case "address-details":
                    addressDetails = await GetAddressAsync("C");
                    addressPermanent = await GetAddressAsync("P");
                    addressPermanent.AddressType = addressPermanent != null ? "C" : null;
                    IsSameAsCurrent = CreateSnapshot(addressDetails) == CreateSnapshot(addressPermanent) ? true : false;
                    if (IsSameAsCurrent)
                    {
                        addressDetails.PermanentLine1 = addressPermanent.Line1;
                    }
                    addressPermanent.AddressType = addressPermanent != null ? "P" : null;
                    break;
                case "sibling-details":
                    searchAnyRequest.BranchCode = branchcode;
                    siblingDetails = await httpService.Post<SiblingDetailsModel>("ViewStudent/GetSiblingDetails", searchAnyRequest) ?? new();
                    break;
                case "other-details":
                    studentpassportdetails = await httpService.Post<StudentPassportVisaModel>("ViewStudent/GetStudentOtherDetail", searchAnyRequest) ?? new();
                    if (viewchildDetails != null)
                    {
                        studentpassportdetails.SpecialComments = viewchildDetails.SpecialComments;
                        studentpassportdetails.RecommendationBy = viewchildDetails.RecommendationBy;
                        studentpassportdetails.EmployeeApproched = viewchildDetails.EmployeeApproched;
                        RecommendationPreview = viewchildDetails.RecommendationDocFile;
                    }
                    break;

            }
            childDisEnableform(true);
            parentsDisEnableform(true);
            addressDisEnableform(true);
            SiblingDisEnableform(true);
            OtherDisEnableform(true);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            StateHasChanged();
        }
    }
