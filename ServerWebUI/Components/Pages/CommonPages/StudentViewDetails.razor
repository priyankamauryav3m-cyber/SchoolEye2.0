    private async Task Addressdetails()
    {
        try
        {
            if ((IsEdited(addressDetails, _originaladdress)) || (IsEdited(addressPermanent, _originaladdress)))
            {
                addressDetails.StudentId = StudentId;
                addressDetails.CreatedBy = username;
                addressDetails.GroupCode = groupcode;
                addressDetails.BranchCode = branchcode;
                addressDetails.SessionId = SessionId;
                var list = new List<StudentAddressDetailsModel>();
                if (addressDetails != null)
                {
                    addressDetails.AddressType = "C";
                    list.Add(addressDetails);
                    if (IsSameAsCurrent)
                    {

                        list.Add(new StudentAddressDetailsModel
                        {

                            AddressType = "P",
                            AddressTo = addressDetails.AddressTo,
                            ContactNo = addressDetails.ContactNo,
                            PinCode = addressDetails.PinCode,
                            Line1 = addressDetails.Line1,
                            Line2 = addressDetails.Line2,
                            CreatedBy = username,
                            GroupCode = groupcode,
                            StudentId = StudentId,
                            SessionId = SessionId,
                            BranchCode = branchcode,
                            PermanentLine1 = addressDetails.Line1,
                            EmergencyPersonAddress = addressDetails.EmergencyPersonAddress,
                            EmergencyPersonName = addressDetails.EmergencyPersonName,
                            EmergencyPersonContactNo = addressDetails.EmergencyPersonContactNo,
                            EmergencyPersonRelationShip = addressDetails.EmergencyPersonRelationShip

                        });
                    }
                    else
                    {
                        if (addressPermanent != null)
                        {
                            addressPermanent.AddressType = "P";
                            list.Add(addressPermanent);
                        }

                    }
                }
                bool isSaved = false;
                string apiUrl = "ViewStudent/SaveStudentAddress";
                foreach (var item in list)
                {
                    var apiResponse = await httpService.Post<ApiResponse<object>>(apiUrl, item);
                    if (apiResponse != null && apiResponse.Success && apiResponse.Code == 1)
                    {
                        isSaved = true;
                    }
                    else
                    {
                        isSaved = false;
                        break;
                    }

                }
                if (isSaved)
                {
                    ShowSuccess = true;
                    StateHasChanged();
                    await Task.Delay(3000);
                    ShowSuccess = false;
                }
                else
                {
                    return;
                }

              
            }
            addressDisEnableform(true);
            await SaveByActiveTab();
            StateHasChanged();

        }
        catch (Exception ex)
        {
            return;
        }
        finally
        {
            StateHasChanged();
        }

    }
    private async Task<StudentAddressDetailsModel> GetAddressAsync(string addressType)
    {
        try
        {
            searchAnyRequest.RequestName = addressType;
