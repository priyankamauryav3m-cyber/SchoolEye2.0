<CustomAlert @ref="customAlert" Title="Alert" />

@code {
    public class ImageSize
    {
        public int Width { get; set; }
        public int Height { get; set; }
    }
    private IBrowserFile? StudentSelectedFile;
    private IBrowserFile? FatherSelectedFile;
    private IBrowserFile? MotherSelectedFile;
    private IBrowserFile? RecoSelectedFile;
    private string RecommendationPreview = "";
    private string ImagePreview = "https://demo.schooleye.in/Images/NoPhoto.gif";
    private string MotherImagePreview = "https://demo.schooleye.in/Images/NoPhoto.gif";
    private string FatherImagePreview = "https://demo.schooleye.in/Images/NoPhoto.gif";
    private ProfileImageModal profileImageremove = new();
    private async Task RecommendationFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        const long maxFileSize = 200 * 1024;

        if (file.Size > maxFileSize)
        {
            await customAlert.ShowCustomAlert("File size can not be greater than 200 KB", false);
            StateHasChanged();
            RecoSelectedFile = null;
            return;
        }
        RecoSelectedFile = file;
        using var ms = new MemoryStream();
        await file.OpenReadStream(maxFileSize).CopyToAsync(ms);
        RecommendationPreview = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
        StateHasChanged();


    }
    private async Task OnFileStudentSelected(InputFileChangeEventArgs e)
    {
        StudentSelectedFile = e.File;
        using var stream = StudentSelectedFile.OpenReadStream(5 * 1024 * 1024);
        using var ms = new MemoryStream();

        await stream.CopyToAsync(ms);

        ImagePreview = $"data:{StudentSelectedFile.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
        StateHasChanged();


    }
    private async Task OnFileMotherSelected(InputFileChangeEventArgs e)
    {
        MotherSelectedFile = e.File;
        using var stream = MotherSelectedFile.OpenReadStream(5 * 1024 * 1024);
        using var ms = new MemoryStream();

        await stream.CopyToAsync(ms);

        MotherImagePreview = $"data:{MotherSelectedFile.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
        StateHasChanged();


    }
    private async Task OnFileFatherSelected(InputFileChangeEventArgs e)
    {
        FatherSelectedFile = e.File;
        using var stream = FatherSelectedFile.OpenReadStream(5 * 1024 * 1024);
        using var ms = new MemoryStream();

        await stream.CopyToAsync(ms);

        FatherImagePreview = $"data:{FatherSelectedFile.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
        StateHasChanged();

    }
    private async Task OpenFilePicker(string fileId)
    {
        await JS.InvokeVoidAsync("openFilePicker", fileId);
    }
    private async Task DeleteImage(string imagefor)
    {
        IsVisible = false;
        var submit = await Alert.ShowConfirm("Are you sure, you want to remove this image?");
        if (!submit)
        {
            IsVisible = true;
            StateHasChanged();
            return;
        }
        try
        {
            IsLoading = true;
            profileImageremove.GroupCode = groupcode;
            profileImageremove.BranchCode = branchcode;
            profileImageremove.SessionId = SessionId;
            profileImageremove.StudentId = StudentId;
            profileImageremove.ImageFor = imagefor;
            profileImageremove.UpdatedBy = username;
            var apiresponse = await httpService.Post<ApiResponse<string>>("ViewStudent/RemoveProfileImage", profileImageremove);
            if (apiresponse.Success && apiresponse.Code == 1)
            {
                await Alert.ShowSuccess("Image removed successfully.");
                profileImageremove = new();
                IsLoading = false;
                await LoadData();
                IsVisible = true;
                StateHasChanged();
            }
            else
            {
                await Alert.ShowCustomAlert(@Localizer["Admin"]);
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("showErrorAlert", ex.Message);
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }

    }
