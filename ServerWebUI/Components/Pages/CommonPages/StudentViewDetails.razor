                return;

            CurrentTabIndex = index;
            await TabnextPreviuos();
            StateHasChanged();

        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }
    private async Task SaveByActiveTab()
    {
        try
        {

            if (CurrentTabIndex < Tabs.Count - 1)
            {
                CurrentTabIndex++;
                await TabnextPreviuos();
                StateHasChanged();
            }


        }
        catch (Exception ex)
