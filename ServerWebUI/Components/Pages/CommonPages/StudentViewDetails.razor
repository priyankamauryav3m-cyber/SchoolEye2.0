    private async Task AddSiblingData()
    {
        try
        {
            addSibling.GroupCode = groupcode;
            addSibling.BranchCode = branchcode;
            addSibling.ParentStudentId = StudentId;
            addSibling.ChildStudentId = siblingDetails.StudentId;
            if (string.IsNullOrEmpty(schoolbranchcode))
            {
                await customAlert.ShowCustomAlert("Please select school branch !", false);
                StateHasChanged();
                return;
            }
            else if (string.IsNullOrEmpty(searchAnyRequest.RequestName))
            {
                await customAlert.ShowCustomAlert("Please enter sibling id !", false);
                StateHasChanged();
                return;
            }
            else if (addSibling.ChildStudentId == 0)
            {
                await customAlert.ShowCustomAlert("Please search a record first .", false);
                StateHasChanged();
                return;
            }
            IsVisible = false;
            var submit = await Alert.ShowConfirm("Are you sure, you want to add sibling?");
            if (!submit)
            {
                IsVisible = true;
                StateHasChanged();
                return;
            }
            string apiurl = "ViewStudent/AddUpdateSibling";
            var apiResponse = await httpService.Post<ApiResponse<object>>(apiurl, addSibling);
            if (apiResponse.Success)
            {

                if (apiResponse.Code == 1)
                {
                    await Alert.ShowSuccess("sibling saved successfully !");
                    addSibling = new();
                    StateHasChanged();
                    await LoadData();
                    IsVisible = true;

                }
            }
            else
            {
                await Alert.ShowCustomAlert(@Localizer["Admin"]);
            }

        }
        catch (Exception ex)
        {
            return;
        }
        finally
        {

            StateHasChanged();
        }
    }

