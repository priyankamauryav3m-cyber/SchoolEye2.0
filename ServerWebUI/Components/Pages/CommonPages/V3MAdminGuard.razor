@using MyApp.Common
@inject Shared.IHttpService httpService
@inject SweetAlertService Alert
@inject NavigationManager Nav
@inject MenuState MenuState

@* Wrap a page's markup with this. The role is checked on the server (SuperAdminModule/IsV3MAdmin,
   read from the logged-in user's JWT), so typing the URL directly does not bypass it.
   The API endpoints of these pages are protected separately with [V3MAdminOnly]. *@

<style>
    .access-wrap {
        min-height: calc(100vh - 160px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px 16px;
    }

    .access-card {
        max-width: 460px;
        width: 100%;
        text-align: center;
        background: #fff;
        border: 1px solid #f1d4d4;
        border-radius: 16px;
        padding: 36px 28px 28px;
        box-shadow: 0 20px 45px rgba(220, 38, 38, 0.12);
        animation: access-pop .45s cubic-bezier(.2, .9, .3, 1.2) both;
    }

    .access-icon {
        position: relative;
        width: 92px;
        height: 92px;
        margin: 0 auto 18px;
    }

        .access-icon .ring {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background: rgba(220, 38, 38, 0.18);
            animation: access-pulse 1.8s ease-out infinite;
        }

            .access-icon .ring.delay {
                animation-delay: .9s;
            }

        .access-icon .core {
            position: absolute;
            inset: 10px;
            border-radius: 50%;
            background: linear-gradient(145deg, #ef4444, #b91c1c);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            animation: access-shake .6s ease .45s 2;
        }

    .access-card h4 {
        font-weight: 700;
        color: #991b1b;
        margin-bottom: 8px;
    }

    .access-card p {
        color: #6b7280;
        font-size: 14px;
        margin-bottom: 4px;
    }

    .access-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin: 10px 0 22px;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        color: #1d4ed8;
        background: #dbeafe;
    }

    .access-checking {
        color: #6b7280;
        font-size: 14px;
    }

    @@keyframes access-pop {
        from {
            opacity: 0;
            transform: translateY(18px) scale(.94);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @@keyframes access-pulse {
        0% {
            transform: scale(.85);
            opacity: .9;
        }

        100% {
            transform: scale(1.45);
            opacity: 0;
        }
    }

    @@keyframes access-shake {
        0%, 100% { transform: rotate(0); }
        20% { transform: rotate(-14deg); }
        40% { transform: rotate(12deg); }
        60% { transform: rotate(-8deg); }
        80% { transform: rotate(5deg); }
    }
</style>

@switch (state)
{
    case AccessState.Checking:
        <div class="access-wrap">
            <div class="access-checking">
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>Checking access...
            </div>
        </div>
        break;

    case AccessState.Allowed:
        @ChildContent
        break;

    default:
        <div class="access-wrap">
            <div class="access-card" role="alert">
                <div class="access-icon">
                    <span class="ring"></span>
                    <span class="ring delay"></span>
                    <span class="core"><i class="bi bi-shield-lock-fill"></i></span>
                </div>
                <h4>Access Denied</h4>
                <p>You are not allowed to open <strong>@PageName</strong>.</p>
                <p>This page is available only to the administrator role.</p>
                <div class="access-badge"><i class="bi bi-person-badge"></i>Allowed role: V3M Admin</div>
                <div class="d-flex justify-content-center">
                    <button type="button" class="ui fade op-1 animated button form-btn" @onclick="GoToDashboard">
                        <div class="visible content">Go to Dashboard</div>
                        <div class="hidden content"><i class="bi bi-house"></i></div>
                    </button>
                </div>
            </div>
        </div>
        break;
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string PageName { get; set; } = "this page";
    // called once, after the allowed page content is on screen (load the page's data here)
    [Parameter] public EventCallback OnAllowed { get; set; }

    private enum AccessState { Checking, Allowed, Denied }
    private AccessState state = AccessState.Checking;
    private bool allowedNotified;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            bool isAdmin = false;
            try
            {
                var response = await httpService.Get<ApiResponse<bool>>("SuperAdminModule/IsV3MAdmin");
                isAdmin = response != null && response.Success && response.Data;
            }
            catch
            {
                isAdmin = false;   // fail closed
            }

            state = isAdmin ? AccessState.Allowed : AccessState.Denied;
            StateHasChanged();

            // if (!isAdmin)
            //     await Alert.ShowError("Access denied. Only V3M Admin can open this page.");
            // return;
        }

        // page markup is rendered now -> let the page load its data
        if (state == AccessState.Allowed && !allowedNotified)
        {
            allowedNotified = true;
            if (OnAllowed.HasDelegate)
                await OnAllowed.InvokeAsync();
        }
    }

    private void GoToDashboard()
    {
        var url = string.IsNullOrWhiteSpace(MenuState.DashboardUrl) ? "/" : MenuState.DashboardUrl;
        Nav.NavigateTo(url);
    }
}
