<button type="button"
        class="ui fade op-1 animated button btn-cancle"
        tabindex="0"
        @onclick="OnClick">

    <div class="visible content">@Text</div>

    <div class="hidden content">
        <i class="fa fa-close"></i>
    </div>
</button>
@code {
@code {
    [Parameter] public string Text { get; set; } = "Cancel";
    [Parameter] public EventCallback OnClick { get; set; }
}
}
