<CustomAlert @ref="customAlert" Title="Alert" />
@code {
    private EditContext editContext;
    private ValidationMessageStore messageStore;

    public class ConcessionTempModel
    {
        public string? ConcessionId { get; set; }
        public string? ConcessionName { get; set; }
        public string? ConcType { get; set; }
        public string? FeeHeadId { get; set; }
        public int ConcStudId { get; set; }
        public string? FeeHeadName { get; set; }
        public DateTime? FromDate { get; set; }
        public DateTime? ToDate { get; set; }
        public bool IsAmount { get; set; }
        public decimal Amount { get; set; }
        public bool IsChecked { get; set; }
    }

    List<ConcessionTempModel> concessionTempList = new();
    private bool IsBranchDisabled = true;
    private bool opensibling;
    private bool OpenConcession;
    private bool OpenConcessionDetails;
    private CustomAlert customAlert;
    private StudentDirectAdmissionModel studentDirectAdmission = new();
    private GetRegistrationModel getRegistration = new();
    private SiblingDetailResponse siblingDetail = new();
    private List<ConcessionModel> concessionlist = new();
    private ParentsDetails parentsDetails = new();
    private List<CommonDomain> feeHeadlist = new();
    private List<BranchClassModel> classlist = new();
    private List<OccupationModal> getoccupationlist = new();
    private List<GenderModal> genderlist = new();
    private List<CategoryModal> categories = new();
    private List<ClassSectionModal> classsectionslist = new();
    private List<CountryModel> countrylist = new();
    private List<MstDistance> distancelist = new();
    private List<BranchNameMst> branchlist = new();
    private List<ReligionMaster> religionlist = new();
    private List<Qualification> qulifationlist = new();
    SearchAnyRequestModel searchAny = new();
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public long RegId { get; set; }
    [Parameter] public long SessionId { get; set; }
    [Parameter]public EventCallback OnSearch { get; set; }
    private bool IsUsingTransport { get; set; } = false;
    private bool IsSibllingAttach = false;
    private string? branchcode;
    private string? groupcode;
    private string? datecalulate = "";
    private string previuscode = "01";
    private string? username;
    private string? sessionvalue;
    private string? currentClassCode;
    private long CurrentSession;
    private string? schoolbranchcode;
    private string? MapSiblingId;
    public int ConcessionId { get; set; } = 0;
    public string SelectedConcessionIds { get; set; } = "";
    private decimal? _concessionApplicable;
    private bool _isSelectedPersentage;
    private int maxlength;
    private bool ShowSuccess;
    private string? ConcessionIdStore;
    IQueryable<ConcessionTempModel> concessionQueryable => concessionTempList.AsQueryable();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await GetData();
            // sessionvalue = await _commonmethod.SetCurrentSession();
            CurrentSession = await _commonmethod.SetCurrentSessionData();
            StateHasChanged();
        }
    }
    protected override void OnInitialized()
    {
        editContext = new EditContext(studentDirectAdmission);
        messageStore = new ValidationMessageStore(editContext);
    }
    private async Task UnMapConcession(string feeHeadId)
    {
        var item = concessionTempList
              .FirstOrDefault(x => x.FeeHeadId == feeHeadId);

        if (item != null)
        {
            IsVisible = false;
            concessionTempList.Remove(item);
            await Alert.ShowDeactive("Concession delete successfully!");
            IsVisible = true;
            return;

        }
    }
    private async Task OnValueChanged(ChangeEventArgs e, CommonDomain context)
    {
        if (!decimal.TryParse(e.Value?.ToString(), out decimal value))
            return;
        if (context.IsSelectedPersentage)
        {
            if (value > context.FeeHeadAmount)
            {
                await customAlert.ShowCustomAlert($"Amount cannot exceed Fee Head Amount ({context.FeeHeadAmount})", false);
                context.ConcessionApplicable = 0;
                return;
            }
        }
        else
        {
            if (value > 100)
            {
                value = 0;
            }
        }

        context.ConcessionApplicable = value;
    }
    private async void GetConcessionData()
    {
        string ApiUri1 = $"Registration/FeeHeadConcession?groupCode={groupcode}&branchCode={branchcode}&sessionId={CurrentSession}&concessionId={ConcessionId}&isMappedOnly={0}";
        feeHeadlist = await httpService.Get<List<CommonDomain>>(ApiUri1) ?? new();
        foreach (var item in feeHeadlist)
        {
            int.TryParse(item.ConcessionType, out int type);
            bool hasValue = item.ConcessionApplicable > 0;
            item.IsSelectedPersentage = (hasValue && type == 1);
            item.IsSelected = hasValue;
        }
        // ConcessionIdStore += string.IsNullOrEmpty(ConcessionIdStore) ? SelectedConcessionIds : "," + SelectedConcessionIds;
        StateHasChanged();
    }
    protected IQueryable<CommonDomain> moduleQuery
    {
        get
        {
            var result = feeHeadlist.AsQueryable();

            return result;
        }
    }
    private async Task SaveSiblingData()
    {

        try
        {

            if (siblingDetail == null || string.IsNullOrEmpty(siblingDetail.SiblingID))
            {
                await customAlert.ShowCustomAlert("Please select sibling first!", false);
                StateHasChanged();
                return;
            }
            ShowSuccess = true;
            await Task.Delay(3000);
            studentDirectAdmission.SiblingID = siblingDetail.SiblingID;
            opensibling = false;
            ShowSuccess = false;

        }
        catch (Exception)
        {

            return;
        }
        finally
        {
            StateHasChanged();
        }

    }
    private async Task SearchSiblingData()
    {

        try
        {
            if (string.IsNullOrEmpty(schoolbranchcode))
            {
                await customAlert.ShowCustomAlert("Please select school branch !", false);
                StateHasChanged();
                return;
            }
            else if (string.IsNullOrEmpty(MapSiblingId))
            {
                await customAlert.ShowCustomAlert("Please enter sibling id !", false);
                StateHasChanged();
                return;
            }
            string ApiUri1 = $"Registration/SiblingDetail?groupCode={groupcode}&branchCode={schoolbranchcode}&sessionId={CurrentSession}&siblingID={MapSiblingId}";
            var response = await httpService.Get<ApiResponse<SiblingDetailResponse>>(ApiUri1) ?? new();
            siblingDetail = response.Data;
        }
        catch (Exception)
        {

            return;
        }
        finally
        {
            StateHasChanged();
        }

    }
    private void CloseConcession()
    {
        OpenConcession = false;

        StateHasChanged();
    }
    private async Task OnClickReset()
    {
        concessionTempList.Clear();
        StateHasChanged();
    }

    private async void OpenConcessionPopup()
    {
        if (!string.IsNullOrEmpty(studentDirectAdmission.FirstName) && !string.IsNullOrEmpty(studentDirectAdmission.ClassCode) && !string.IsNullOrEmpty(studentDirectAdmission.stuManualAdmNo) && studentDirectAdmission.SectionId != 0 && !string.IsNullOrEmpty(studentDirectAdmission.Gender) && studentDirectAdmission.DateOfBirth != null && studentDirectAdmission.AdmissionDate != null && !string.IsNullOrEmpty(studentDirectAdmission.FatherFirstName) && !string.IsNullOrEmpty(studentDirectAdmission.MotherFirstName) && !string.IsNullOrEmpty(studentDirectAdmission.SMSContactNo))
        {
            feeHeadlist.Clear();
            OpenConcession = true;
            await Task.Delay(100);
            await JS.InvokeVoidAsync("scrollToElement", "section2");
            StateHasChanged();
        }
        else
        {
            await customAlert.ShowCustomAlert("Please fill the required field.", false);

        }

    }
    private async Task SaveConcession()
    {
        var selectedRows = moduleQuery.Where(x => x.IsSelected).ToList();
        var SelectType = concessionlist.Where(x => x.ConcessionId == ConcessionId).Select(x => x.Type).FirstOrDefault();
        var names = concessionlist.Where(x => x.ConcessionId == ConcessionId).Select(x => x.Concession).FirstOrDefault();
        if (string.IsNullOrEmpty(names))
        {
            await customAlert.ShowCustomAlert("Please select concession !", false);
            return;
        }
        else if (selectedRows.Count == 0)
        {
            await customAlert.ShowCustomAlert("Please select record  first !", false);
            return;
        }
        else if (selectedRows[0].ConcessionApplicable == null)
        {
            await customAlert.ShowCustomAlert("Please enter amount or percentage !", false);
            return;
        }
        foreach (var row in selectedRows)
        {
            var temp = new ConcessionTempModel
            {
                ConcType = SelectType,
                ConcessionName = names,
                FeeHeadId = row.FeeHeadId,
                FeeHeadName = row.FeeHeadName,
                FromDate = row.FromDate,
                ToDate = row.ToDate,
                IsAmount = !row.IsSelectedPersentage,
                Amount = row.ConcessionApplicable ?? 0,
                ConcessionId = ConcessionId.ToString()
            };

            concessionTempList.Add(temp);


        }

        ConcessionId = 0;
        SelectedConcessionIds = "";
        OpenConcessionDetails = true;

        try
        {
            // OpenConcessionDetails = true;
            await Task.Delay(100);
            await JS.InvokeVoidAsync("scrollToElement", "section4");
            StateHasChanged();
        }
        catch (JSDisconnectedException)
        {
            // safe ignore
        }
        OpenConcession = false;
        StateHasChanged();
    }
    private async void OpenPopupSibling()
    {
        opensibling = true;
        await Task.Delay(100);
        await JS.InvokeVoidAsync("scrollToElement", "section3");
        StateHasChanged();
    }
    private async Task GetData()
    {
        var branchResult = await sessionStorage.GetAsync<string>("BranchCode");
        branchcode = branchResult.Value;
        var groupResult = await sessionStorage.GetAsync<string>("GroupCode");
        groupcode = groupResult.Value;
        var userResult = await sessionStorage.GetAsync<string>("UserName");
        username = userResult.Value;

        string ApiUri = "occupation/AllOccupation";
        string ApiUri2 = "Concession/GetListConcession";
        concessionlist = await httpService.Get<List<ConcessionModel>>(ApiUri2) ?? new();
        getoccupationlist = await httpService.Get<List<OccupationModal>>(ApiUri) ?? new();
        classlist = await httpService.Get<List<BranchClassModel>>("BranchClass/GetClassCode") ?? new();
        categories = await httpService.Get<List<CategoryModal>>("ClassSection/GetCategory") ?? new();
        distancelist = await httpService.Get<List<MstDistance>>("ClassSection/GetDistance") ?? new();
        branchlist = await httpService.Get<List<BranchNameMst>>("ClassSection/GetBranchName") ?? new();
        //var apiResponse = await httpService.Post<ApiResponse<List<SectionModel>>>("", searchAny) ?? new();
        qulifationlist = await httpService.Get<List<Qualification>>("Qualification/GetQualification") ?? new();
        genderlist = await httpService.Get<List<GenderModal>>("gender/GetGender") ?? new();
        countrylist = await httpService.Get<List<CountryModel>>("Country/GetCountry") ?? new();
        religionlist = await httpService.Get<List<ReligionMaster>>("Religion/AllReligion") ?? new();

    }
    private async Task GetSectionData()
    {
        try
        {
            searchAny.GroupCode = groupcode;
            searchAny.BranchCode = branchcode;
            searchAny.RequestName = studentDirectAdmission.ClassCode;
            //searchAny.RequestName = getRegistration.ClassCode;

            string ApiUri1 = "ClassSection/GetClassWithSection";
            var apiResponse = await httpService.Post<ApiResponse<List<ClassSectionModal>>>(ApiUri1, searchAny) ?? new();
            if (apiResponse.Success)
            {
                classsectionslist = apiResponse.Data ?? new();
