    private async Task OnSave(string flag)
    {
        messageStore.Clear();
        if (string.IsNullOrWhiteSpace(studentDirectAdmission.stuManualAdmNo))
        {
            messageStore.Add(() => studentDirectAdmission.stuManualAdmNo, "Admission no is required");

            editContext.NotifyValidationStateChanged();
            return;
        }

        if (string.IsNullOrWhiteSpace(studentDirectAdmission.FirstName))
        {
            messageStore.Add(() => studentDirectAdmission.FirstName, "First Name is required");

            editContext.NotifyValidationStateChanged();
            return;
        }

        if (string.IsNullOrWhiteSpace(studentDirectAdmission.Gender))
        {
            messageStore.Add(() => studentDirectAdmission.Gender, "Gender is required");

            editContext.NotifyValidationStateChanged();
            return;
        }

        if (string.IsNullOrWhiteSpace(studentDirectAdmission.ClassCode))
        {
            messageStore.Add(() => studentDirectAdmission.ClassCode, "Class is required");

            editContext.NotifyValidationStateChanged();
            return;
        }
        var finalList = concessionTempList.Select(x => new FeeHeadDto { FeeHeadId = Convert.ToInt32(x.FeeHeadId), ConcStudId = x.ConcStudId, ConcessionId = Convert.ToInt32(x.ConcessionId), ConcessionType = !x.IsAmount ? 1 : 0, ConcessionValue = x.Amount }).ToList();
        var conceId = concessionTempList.Select(x => x.ConcessionId).Distinct().ToList();
        // if (finalList.Count == 0)
        // {
        //     await customAlert.ShowCustomAlert("Please select record  first !", false);
        //     return;
        // }

        if (flag == "Admission")
        {

        }
        else
        {
            if (finalList.Count == 0)
            {
                await customAlert.ShowCustomAlert("Please select record  first !", false);
                return;
            }

        }
        try
        {
            IsVisible = false;
            var submit = await Alert.ShowConfirm("Are you sure, you want to admit student?");
            if (!submit)
            {
                IsVisible = true;
                StateHasChanged();
                return;
            }

            OpenConcessionDetails = false;
            studentDirectAdmission.SessionId = CurrentSession;
            studentDirectAdmission.CreatedBy = username;
            studentDirectAdmission.GroupCode = groupcode;
            studentDirectAdmission.BranchCode = branchcode;
            studentDirectAdmission.PreviousBranchCode = previuscode;
            studentDirectAdmission.MapConAndChallan = 1;
            studentDirectAdmission.ConcessionId = string.Join(",", conceId);
            studentDirectAdmission.FeeHeadList = finalList;
            string apiurl = "Registration/StudentDirectAdmission";
            var apiResponse = await httpService.Post<ApiResponse<object>>(apiurl, studentDirectAdmission);
            if (apiResponse.Success)
            {
                if (apiResponse.Code == 0)
                {
                    await Alert.ShowWarning("Student No" + @Localizer["Already"]);

                }
                else if (apiResponse.Code == 1)
                {
                    await Alert.ShowSuccess($"Student's details {Localizer["Submit"]}");
                }
                else
                {
                    await Alert.ShowCustomAlert(@Localizer["Admin"]);
                }
                opensibling = false;
                OpenConcession = false;
                getRegistration = new GetRegistrationModel();
                studentDirectAdmission = new();
                concessionTempList.Clear();
                OpenConcessionDetails = false;
                siblingDetail = new();
                await OnClose.InvokeAsync();
                await OnSearch.InvokeAsync();
                StateHasChanged();
            }
            else
            {
                await Alert.ShowCustomAlert(@Localizer["Admin"]);
            }

        }
        catch (Exception ex)
        {
            await Alert.ShowError($"{@Localizer["Error"]}: {ex.Message}");
        }
        finally
        {

            StateHasChanged();
        }
    }
