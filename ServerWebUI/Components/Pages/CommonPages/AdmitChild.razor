    private void OnDOBChanged()
    {
        if (studentDirectAdmission.DateOfBirth <= DateTime.Today)
        {
            if (studentDirectAdmission.DateOfBirth == null)
            {
                datecalulate = "";
                return;
            }
            var dateOfBirth = Convert.ToDateTime(studentDirectAdmission.DateOfBirth);
            datecalulate = _commonmethod.CalculateAge(dateOfBirth);
            StateHasChanged();
        }
        else if (studentDirectAdmission.DateOfBirth < DateTime.Today)
        {
            var dateOfBirth = Convert.ToDateTime(studentDirectAdmission.DateOfBirth);
            datecalulate = _commonmethod.CalculateAge(dateOfBirth);
            StateHasChanged();
        }
        else
        {
            // customAlert.ShowCustomAlert("Please choose the correct Date of Birth.", false);
            getRegistration.DateOfBirth = null;
            studentDirectAdmission.DateOfBirth = null;
            datecalulate = null;
            StateHasChanged();
        }
    }
