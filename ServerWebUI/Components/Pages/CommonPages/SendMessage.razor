@using DomainModel.Admin
@using DomainModel.Enum
@using DomainModel.SchoolMaster
@using MyApp.Common
@using Microsoft.AspNetCore.Components.QuickGrid
@inject Shared.IHttpService httpService
@inject HttpClient Http
@inject IStringLocalizer<Resource> Localizer
@inject SweetAlertService Alert
@rendermode InteractiveServer
@using ServerWebUI.Components.Pages.CommonPages
@inject IJSRuntime JS
@inject NotificationState Notifications
@using System.Linq;

@using static ServerWebUI.Components.Pages.CommonPages.MessageForSelector
@if (ShowPopup)
{
    <div class="custom-modal row m-0 align-items-center">
        <div class="col-12">
            <div class="modal-content clearfix main-popup sm-popup">
                <div class="head-btn">
                    <h5 class="modal-title d-flex align-items-center gap-2" id="exampleModalLabel">
                        <i class="bi bi-chat-square-text-fill"></i> New Message
                    </h5>
                    <button data-access="Close" @onclick="ClosePopup" type="button" class="close sm-close" title="Close" disabled="@IsSending">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">

                        @* ---------------- left (5): compose ---------------- *@
                        <div class="col-12 col-lg-5">
                            <div class="card sm-card h-100">
                                <div class="card-body">
                                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                                        <h6 class="sm-card-title mb-0"><i class="bi bi-pencil-square"></i> Compose Message</h6>
                                        <div class="sm-balance" title="@BalanceMessage">
                                            <i class="bi bi-wallet2"></i>
                                            <span>Available Balance (SMS):</span>
                                            @if (IsLoadingBalance)
                                            {
                                                <span class="sm-spinner"></span>
                                            }
                                            else
                                            {
                                                <span class="sm-balance-val">@(string.IsNullOrWhiteSpace(SmsBalance) ? "-" : SmsBalance)</span>
                                            }
                                        </div>
                                    </div>

                                    <MessageForSelector @bind-Value="MessageBodys" @bind-Value:after="OnChannelChanged" />

                                    <div class="row gap-10-0 mt-3">
                                        <div class="col-12 col-md-6">
                                            <div class="form-box">
                                                <label class="form-label sm-label"><i class="bi bi-list-ul"></i> Message Type</label>
                                                <InputSelect class="form-input" @bind-Value="sentModel.MessageType" @bind-Value:after="OnMessageTypeChanged">
                                                    <option value="0">Select Message Type</option>
                                                    @foreach (var msg in messagetypelist.Where(x => x.IsValid == true))
                                                    {
                                                        <option value="@msg.MessageTypeId">@msg.MessageType</option>
                                                    }
                                                </InputSelect>
                                            </div>
                                        </div>
                                        <div class="col-12 col-md-6">
                                            <div class="form-box">
                                                <label class="form-label sm-label"><i class="bi bi-file-earmark-text"></i> Select Text</label>
                                                @* the selected text gives the Message and (WhatsApp) its template name *@
                                                <InputSelect @bind-Value="SelectedTextId" @bind-Value:after="OnTextSelected" class="form-input">
                                                    <option value="0" selected>Select Message</option>
                                                    @foreach (var msg in smsEmailTextlist.Where(x => x.IsValid == true))
                                                    {
                                                        @* only the shown text is cut at 50; the full text goes to Message *@
                                                        <option value="@msg.SmsEmailTextId" title="@msg.SMSEmailText">@ShortText(msg.SMSEmailText, 50)</option>
                                                    }
                                                </InputSelect>
                                                @if (MessageBodys == MessageType.WhatsApp && SelectedTextId > 0)
                                                {
                                                    <small class="@(string.IsNullOrWhiteSpace(TemplateName) ? "text-danger" : "text-muted")">
                                                        Template: @(string.IsNullOrWhiteSpace(TemplateName) ? "not set: this is an SMS text" : TemplateName)
                                                    </small>
                                                }
                                                else if (MessageBodys == MessageType.SMS && !string.IsNullOrWhiteSpace(SelectedText?.WhatsAppTemplateName))
                                                {
                                                    <small class="text-danger">This text is a WhatsApp template (@SelectedText.WhatsAppTemplateName): select an SMS text.</small>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="form-box">
                                                <label for="sm-message-text" class="form-label sm-label sm-label-blue"><i class="bi bi-chat-left-text"></i> Message:</label>
                                                <textarea id="sm-message-text" class="sms-aria form-input" rows="4" @bind="sentModel.MessageText" @bind:event="oninput"></textarea>
                                                <div class="sm-msg-hint">
                                                    <span><i class="bi bi-info-circle"></i> Customize your message using variables.</span>
                                                    <span>@(sentModel.MessageText?.Length ?? 0) Characters</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="sm-vars">
                                        <div class="sm-vars-title"><i class="bi bi-braces"></i> Available Message Variables</div>
                                        <div class="sm-vars-list">
                                            @for (var i = 0; i < MessageVariables.Length; i++)
                                            {
                                                var v = MessageVariables[i];
                                                <span><b>@v.Code</b> : @v.Name@(i < MessageVariables.Length - 1 ? ", " : "")</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* ---------------- right (7): every attempt of the selected students ---------------- *@
                        <div class="col-12 col-lg-7">
                            <div class="card sm-card h-100">
                                <div class="sm-status-head">
                                    <div class="sm-status-title">
                                        <i class="bi bi-people-fill sm-ico-blue"></i>
                                        <span>Selected Students:</span>
                                        <span class="sm-count">@(Students?.Count ?? 0)</span>
                                        @if (resultRows.Count > 0)
                                        {
                                            <span class="sm-count text-success" title="Sent"><i class="bi bi-check-circle-fill"></i> @SentCount</span>
                                            <span class="sm-count text-danger" title="Failed"><i class="bi bi-x-circle-fill"></i> @FailedCount</span>
                                        }
                                    </div>
                                    <button type="button" class="sm-refresh" title="Refresh grid (reload history)" disabled="@(IsSending || IsLoadingHistory)" @onclick="RefreshGrid">
                                        @if (IsLoadingHistory)
                                        {
                                            <span class="sm-spinner light"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-arrow-clockwise"></i>
                                        }
                                    </button>
                                </div>

                                @if (resultRows.Count == 0)
                                {
                                    <div class="card-body">
                                        <div class="sm-status-empty">
                                            <i class="bi bi-send"></i>
                                            <span>No message sent to the selected student(s) yet. Click "Send Message": every attempt (sent / failed) will show here.</span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div>
                                        <div class="card-body table-card p-0">
                                            <div class="quick-main">
                                                <div class="grid-box-with-btn sm-grid">
                                                    <QuickGrid Items="@resultQuery" Pagination="@pagination" Class="table">
                                                        <TemplateColumn Title="" Align="Align.Center">
                                                            <HeaderTemplate>
                                                                <div class="d-flex align-items-center justify-content-center">
                                                                    <input type="checkbox" title="Select all failed" disabled="@(IsSending || ResendableCount == 0)"
                                                                           @bind="IsAllFailedSelected" @bind:after="ToggleAllFailed" @onclick:stopPropagation="true" />
                                                                </div>
                                                            </HeaderTemplate>
                                                            <ChildContent>
                                                                <div class="d-flex align-items-center justify-content-center">
                                                                    @* only the last failed attempt of a message can be resent; sent rows and older attempts are history *@
                                                                    <input type="checkbox" disabled="@(IsSending || !IsResendable(context))"
                                                                           @bind="context.IsSelected" @onclick:stopPropagation="true" />
                                                                </div>
                                                            </ChildContent>
                                                        </TemplateColumn>
                                                        <PropertyColumn Sortable="true" Property="@(x => x.StudentName)" Title="Name" Class="sm-name" />
                                                        <TemplateColumn Title="Type" Sortable="true" SortBy="GridSort<SendResultRow>.ByAscending(x => x.Type)">
                                                            <span class="sm-type @(context.Type == "WhatsApp" ? "wa" : context.Type == "Email" ? "mail" : "sms")">@context.Type</span>
                                                        </TemplateColumn>
                                                        <TemplateColumn Title="Sent On" Sortable="true" SortBy="GridSort<SendResultRow>.ByDescending(x => x.SentDate)">
                                                            @(context.SentDate?.ToString("dd-MM-yyyy hh:mm tt") ?? "-")
                                                        </TemplateColumn>
                                                        <TemplateColumn Title="Message">
                                                            @* same hover tooltip as the Period column of View Student Receipt *@
                                                            <span class="custom-tooltip" data-tooltip="@context.Message">
                                                                @(string.IsNullOrWhiteSpace(context.Message)
                                                                    ? ""
                                                                    : (context.Message.Length > 30
                                                                        ? context.Message.Substring(0, 30) + "..."
                                                                        : context.Message))
                                                            </span>
                                                        </TemplateColumn>
                                                        <TemplateColumn Class="status-con" Title="Status" Align="Align.Center">
                                                            @if (context.Status == SendStatus.Sending)
                                                            {
                                                                <span class="sm-spinner" title="Sending..."></span>
                                                            }
                                                            else if (context.Status == SendStatus.Sent)
                                                            {
                                                                <span class="sm-pill sent" title="@(context.FailCount > 0 ? $"Sent after {context.FailCount} failed attempt(s). {context.Remark}" : context.Remark)"><i class="bi bi-check-circle-fill"></i> Sent</span>
                                                            }
                                                            else if (context.Status == SendStatus.Failed)
                                                            {
                                                                <span class="sm-pill failed" title="@($"Failed {Math.Max(context.FailCount, 1)} time(s). {context.Remark}")"><i class="bi bi-x-circle-fill"></i> Failed (@Math.Max(context.FailCount, 1))</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="sm-pill pending" title="@context.Remark"><i class="bi bi-clock"></i> Pending</span>
                                                            }
                                                        </TemplateColumn>
                                                    </QuickGrid>
                                                </div>
                                                <div class="footer-pagination">
                                                    <div class="d-flex align-items-center">
                                                        <div class="welcome-text w-100">
                                                            <Paginator State="@pagination" />
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <div class="d-flex align-items-center justify-content-end w-100 flex-wrap gap-2">
                        <div class="d-flex gap-2">
                            <button type="button" class="sm-btn primary" disabled="@IsSending" @onclick="SendSms">
                                @if (IsSending && !IsResending)
                                {
                                    <span class="sm-spinner light"></span>
                                }
                                else
                                {
                                    <i class="bi bi-send-fill"></i>
                                }
                                Send Message
                            </button>
                            @* only when some students failed: tick them in the grid and resend *@
                            @if (ResendableCount > 0 || IsResending)
                            {
                                <button type="button" class="sm-btn warn" title="Resend to the ticked failed students" disabled="@IsSending" @onclick="Resend">
                                    @if (IsResending)
                                    {
                                        <span class="sm-spinner light"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-arrow-repeat"></i>
                                    }
                                    Resend (@ResendableCount)
                                </button>
                            }
                            <button type="button" class="sm-btn outline" disabled="@IsSending" @onclick="ClosePopup">
                                <i class="bi bi-x-circle"></i> Close
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
}
