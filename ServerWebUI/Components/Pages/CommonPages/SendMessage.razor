<script>
    function openSms(mobile, message) {
        const encodedMsg = encodeURIComponent(message);
        window.location.href = `sms:${mobile}?body=${encodedMsg}`;
    }
</script>
@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public bool ShowPopup { get; set; }
    // students selected on the calling page (View Registration / View Publish List)
    [Parameter] public List<MessageRecipient> Students { get; set; } = new();

    private SMSSentModel sentModel = new();
    private MessageType MessageBodys = MessageType.SMS;
    // WhatsApp template name of the selected text (not typed, not saved in SMSSentMaster)
    private string? TemplateName;
    private int SelectedTextId;
    private SmsEmailTextModel? SelectedText => smsEmailTextlist.FirstOrDefault(x => x.SmsEmailTextId == SelectedTextId);
    private string? groupCode;
    private string? branchCode;
    private string? userName;
    // current session: used when the calling page gives no SessionId for a student
    private long currentSessionId;
    private bool IsSending;
    private bool IsResending;
    private bool IsLoadingHistory;
    // SMS balance of the Pinnacle account (footer)
    private string? SmsBalance;
    private string? BalanceMessage;
    private bool IsLoadingBalance;
    private bool wasOpen;
    private bool IsAllFailedSelected;
    // SMS_Or_Mail of SMSSentMaster: SMS = S, WhatsApp = W, Email = E
    private string SMSOrMailCode =>
        MessageBodys switch
        {
            MessageType.SMS => "S",
            MessageType.WhatsApp => "W",
            MessageType.Email => "E",
            _ => ""
        };
    private string ChannelName =>
        MessageBodys switch
        {
            MessageType.WhatsApp => "WhatsApp",
            MessageType.Email => "Email",
            _ => "SMS"
        };
    private List<MessageTypeModal> messagetypelist = new();
    // variables shown under the message (replaced by the API before sending)
    private static readonly (string Code, string Name)[] MessageVariables =
    {
        ("%SN%", "Student Name"), ("%FN%", "Father Name"), ("%MN%", "Mother Name"),
        ("%CS%", "Class-Section Name"), ("%ADMNO%", "Student No"), ("%Fee%", "Balance Amount"),
        ("%PN%", "Period Name"), ("%DT%", "Current Date")
    };
    private List<SmsEmailTextModel> smsEmailTextlist = new();

    // ---------------- status grid: every attempt (history from the DB + this session) ----------------
    private enum SendStatus { Pending, Sending, Sent, Failed }

    private class SendResultRow
    {
        public long RegistrationId { get; set; }
        // Student / Employee: saved as RecipientType with RegistrationId as RecipientId
        public string RecipientType { get; set; } = WhatsAppRecipientType.Student;
        public string? StudentName { get; set; }
        public string? Type { get; set; }
        public string? TemplateName { get; set; }
        public string? Message { get; set; }
        public int MessageTypeId { get; set; }
        // SMSSentMaster id of the message: a resend is a new attempt of the same id
        public int? SmsEmailSentId { get; set; }
        public DateTime? SentDate { get; set; }
        // saved as SessionId of the attempt
        public long? SessionId { get; set; }
        // Alert_SmsEmailToBeSend row: a resend updates this row
        public int? SmsEmailId { get; set; }
        // how many times this message to this student failed
        public int FailCount { get; set; }
        public SendStatus Status { get; set; } = SendStatus.Pending;
        // last attempt of this message to this student and it failed
        public bool CanResend { get; set; }
        // reason of failure / masked mobile no. (tooltip)
        public string? Remark { get; set; }
        public bool IsSelected { get; set; }
    }

    private List<SendResultRow> resultRows = new();
    private IQueryable<SendResultRow> resultQuery => resultRows.AsQueryable();
    PaginationState pagination = new() { ItemsPerPage = 10 };
    private int SentCount => resultRows.Count(x => x.Status == SendStatus.Sent);
    private int FailedCount => resultRows.Count(x => x.Status == SendStatus.Failed);
    private int ResendableCount => resultRows.Count(IsResendable);
    private static bool IsResendable(SendResultRow row) =>
        row.Status == SendStatus.Failed && row.CanResend && row.SmsEmailSentId > 0
        && (row.Type == "SMS" || (row.Type == "WhatsApp" && !string.IsNullOrWhiteSpace(row.TemplateName)));

    private async Task LoadData()
    {
        string ApiUri = "MessageType/GetMessageType";
        messagetypelist = await httpService.Get<List<MessageTypeModal>>(ApiUri) ?? new();
    }
    private async Task LoadSession()
    {
        groupCode ??= (await sessionStorage.GetAsync<string>("GroupCode")).Value;
        branchCode ??= (await sessionStorage.GetAsync<string>("BranchCode")).Value;
        userName ??= (await sessionStorage.GetAsync<string>("UserName")).Value;
        if (currentSessionId <= 0)
            currentSessionId = await CommonMethod.SetCurrentSessionData();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadData();
            await LoadSession();
            StateHasChanged();
        }
    }
    protected override async Task OnParametersSetAsync()
    {
        // popup opened: every earlier attempt (sent / failed) of the selected students
        var opened = ShowPopup && !wasOpen;
        wasOpen = ShowPopup;
        if (opened)
        {
            resultRows = new();
            IsAllFailedSelected = false;
            await LoadHistory();
            await LoadBalance();
        }
    }
    private void OnChannelChanged()
    {
        // template name comes from the selected text (WhatsApp only)
        TemplateName = MessageBodys == MessageType.WhatsApp ? SelectedText?.WhatsAppTemplateName?.Trim() : null;
    }
    // Select Text: full text into Message, its WhatsApp template name (DetSMSEmailText.WhatsAppTemplateName) for WhatsApp
    private void OnTextSelected()
    {
        var text = SelectedText;
        sentModel.MessageText = text?.SMSEmailText ?? "";
        TemplateName = MessageBodys == MessageType.WhatsApp && !string.IsNullOrWhiteSpace(text?.WhatsAppTemplateName)
            ? text.WhatsAppTemplateName.Trim() : null;
    }
    private async Task OnMessageTypeChanged()
    {
        sentModel.MessageText = "";
        SelectedTextId = 0;
        TemplateName = null;
        string api = $"MessageType/GetSMSEmailText?messageTypeId={sentModel.MessageType}";
        smsEmailTextlist = await httpService.Get<List<SmsEmailTextModel>>(api) ?? new();
    }

    // ---------------- SMS balance ----------------
    private async Task LoadBalance()
    {
        IsLoadingBalance = true;
        StateHasChanged();
        try
        {
            var response = await httpService.Get<ApiResponse<SmsBalanceResult>>("SendSMS/GetSmsBalance");
            SmsBalance = response != null && response.Success ? response.Data?.Balance : null;
            BalanceMessage = response?.Message ?? "Unable to load the SMS balance.";
        }
        catch (Exception)
        {
            SmsBalance = null;
            BalanceMessage = "Unable to load the SMS balance.";
        }
        finally
        {
            IsLoadingBalance = false;
            StateHasChanged();
        }
    }

    // ---------------- history ----------------
    private async Task LoadHistory()
    {
        if (Students == null || Students.Count == 0)
        {
            resultRows = new();
            return;
        }

        IsLoadingHistory = true;
        StateHasChanged();
        try
        {
            await LoadSession();
            var request = new MessageHistoryRequest
            {
                GroupCode = groupCode ?? "",
                BranchCode = branchCode ?? "",
                RecipientType = WhatsAppRecipientType.Student,
                RecipientIds = Students.Select(s => s.RegistrationId).Where(id => id > 0).Distinct().ToList()
            };
            var response = await httpService.Post<ApiResponse<List<MessageHistoryRow>>>("SendSMS/GetMessageHistory", request);
            if (response == null || !response.Success)
            {
                await Alert.ShowCustomAlert(response?.Message ?? "Unable to load the message history.");
                return;
            }

            var names = Students.GroupBy(s => s.RegistrationId)
                .ToDictionary(g => g.Key, g => g.First());
            resultRows = (response.Data ?? new()).Select(h =>
            {
                long.TryParse(h.RecipientId, out var id);
                names.TryGetValue(id, out var student);
                int.TryParse(h.SMS_EmailSentId, out var sentId);
                return new SendResultRow
                {
                    RegistrationId = id,
                    RecipientType = h.RecipientType ?? WhatsAppRecipientType.Student,
                    StudentName = student == null ? h.RecipientId
                        : (string.IsNullOrWhiteSpace(student.StudentName) ? student.RegistrationNo : student.StudentName),
                    Type = h.MessageTextType switch { "W" => "WhatsApp", "S" => "SMS", "E" => "Email", _ => h.MessageTextType },
                    TemplateName = h.TemplateName,
                    Message = h.MessageText,
                    MessageTypeId = h.MessageTypeId ?? 0,
                    SmsEmailSentId = sentId > 0 ? sentId : null,
                    SentDate = h.SentDate,
                    SessionId = h.SessionId,
                    SmsEmailId = h.SmsEmailId > 0 ? h.SmsEmailId : null,
                    FailCount = h.FailCount,
                    // 1 = sent; 0 = not sent / failed (99 = failed, older rows)
                    Status = h.Status == 1 ? SendStatus.Sent : SendStatus.Failed,
                    CanResend = h.CanResend,
                    Remark = string.IsNullOrWhiteSpace(h.MobileNo) ? null : $"Mobile: {h.MobileNo}"
                };
            }).ToList();
            IsAllFailedSelected = false;
            await pagination.SetCurrentPageIndexAsync(0);
        }
        catch (Exception)
        {
            await Alert.ShowError("Unable to load the message history right now. Please try again.");
        }
        finally
        {
            IsLoadingHistory = false;
            StateHasChanged();
        }
    }

    // ---------------- send ----------------
    private async Task SendSms()
    {
        if (Students == null || Students.Count == 0)
        {
            await JS.InvokeVoidAsync("showSelectRecordAlert");
            return;
        }
        // WhatsApp: the template name of the selected text is required (SMS / Email have no template)
        if (MessageBodys == MessageType.WhatsApp && SelectedTextId <= 0)
        {
            await Alert.ShowCustomAlert("Select the text to send on WhatsApp.");
            return;
        }
        if (MessageBodys == MessageType.WhatsApp && string.IsNullOrWhiteSpace(TemplateName))
        {
            await Alert.ShowCustomAlert("The selected text is an SMS text (no WhatsApp template). Select a WhatsApp text.");
            return;
        }
        // SMS: a text with a WhatsApp template is for WhatsApp only
        if (MessageBodys == MessageType.SMS && !string.IsNullOrWhiteSpace(SelectedText?.WhatsAppTemplateName))
        {
            await Alert.ShowCustomAlert("The selected text is a WhatsApp template. Select an SMS text.");
            return;
        }
        if (MessageBodys != MessageType.WhatsApp && string.IsNullOrWhiteSpace(sentModel.MessageText))
        {
            await Alert.ShowCustomAlert("Enter the message.");
            return;
        }

        IsSending = true;
        try
        {
            await LoadSession();
            var message = sentModel.MessageText?.Trim();
            // only WhatsApp has a template; SMS / Email send the message text
            var template = MessageBodys == MessageType.WhatsApp && !string.IsNullOrWhiteSpace(TemplateName) ? TemplateName.Trim() : null;

            // 1. the message is saved once in SMSSentMaster (S / W / E; template name is not saved) -> SMS_EmailSentId
            var model = new SMSSentModel
            {
                GroupCode = groupCode,
                BranchCode = branchCode,
                SentBy = string.IsNullOrWhiteSpace(userName) ? "V3M" : userName,
                IsValid = false,
                SMS_Or_Mail = SMSOrMailCode,
                MessageType = sentModel.MessageType,
                MessageText = message,
                TotalMsg = Students.Count.ToString(),
                TotalDelivered = "0",
                SMSVendor = MessageBodys == MessageType.Email ? null : "Pinnacle"
            };
            var log = await httpService.Post<ApiResponse<string>>("SendSMS/send-sms-log", model);
            if (log == null || !log.Success || !int.TryParse(log.Data, out var smsEmailSentId))
            {
                await Alert.ShowCustomAlert(log?.Message ?? "Message could not be saved. Please try again.");
                return;
            }

            // 2. a new row per selected student, on top of the history
            var newRows = Students.Select(s => new SendResultRow
            {
                RegistrationId = s.RegistrationId,
                RecipientType = string.IsNullOrWhiteSpace(s.RecipientType) ? WhatsAppRecipientType.Student : s.RecipientType,
                StudentName = string.IsNullOrWhiteSpace(s.StudentName) ? s.RegistrationNo : s.StudentName,
                Type = ChannelName,
                TemplateName = template,
                Message = message,
                MessageTypeId = sentModel.MessageType,
                SmsEmailSentId = smsEmailSentId,
                SessionId = s.SessionId > 0 ? s.SessionId : (currentSessionId > 0 ? currentSessionId : null),
                SentDate = DateTime.Now
            }).ToList();
            resultRows = newRows.Concat(resultRows).ToList();
            IsAllFailedSelected = false;
            await pagination.SetCurrentPageIndexAsync(0);

            // 3. send
            if (MessageBodys == MessageType.Email)
            {
                // Email gateway is not connected yet: message saved, students stay Pending
                foreach (var row in newRows)
                    row.Remark = $"{ChannelName} API is not connected yet. Message saved (Id {smsEmailSentId}).";
            }
            else
            {
                await SendToStudents(newRows);
            }
        }
        catch (Exception)
        {
            await Alert.ShowError("Unable to send the message right now. Please try again.");
        }
        finally
        {
            IsSending = false;
            StateHasChanged();
        }
    }

    // ticked failed rows are sent again and the SAME row is updated (no new entry):
    // failed again -> "Failed (n)" with the fail count, sent -> Sent
    private async Task Resend()
    {
        var failed = resultRows.Where(x => IsResendable(x) && x.IsSelected).ToList();
        if (failed.Count == 0)
        {
            await Alert.ShowCustomAlert("Tick the failed student(s) to resend.");
            return;
        }

        IsSending = true;
        IsResending = true;
        try
        {
            await LoadSession();
            foreach (var row in failed)
            {
                if (!(row.SessionId > 0) && currentSessionId > 0)
                    row.SessionId = currentSessionId;
            }

            // WhatsApp and SMS rows go to their own API
            foreach (var group in failed.GroupBy(x => x.Type))
                await SendToStudents(group.ToList(), resend: true);
        }
        catch (Exception)
        {
            await Alert.ShowError("Unable to send the message right now. Please try again.");
        }
        finally
        {
            IsAllFailedSelected = false;
            IsSending = false;
            IsResending = false;
            StateHasChanged();
        }
    }

    // WhatsApp / SMS API for each student (by the row's Type): the API sends it and saves the attempt
    // (1 sent / 99 failed) in Alert_SmsEmailToBeSend; the row shows the tick as soon as it is known
    private async Task SendToStudents(List<SendResultRow> rows, bool resend = false)
    {
        if (rows.Count == 0) return;
        var isSms = rows[0].Type == "SMS";
        var api = isSms ? "SMS/SendRegistrationMessage" : "WhatsApp/SendRegistrationMessage";

        foreach (var row in rows)
        {
            row.Status = SendStatus.Sending;
            row.Remark = null;
            row.IsSelected = false;
            row.CanResend = false;
        }
        StateHasChanged();

        foreach (var row in rows)
        {
            var request = new WhatsAppRegistrationMessageRequest
            {
                RegistrationId = row.RegistrationId,
                GroupCode = groupCode ?? "",
                BranchCode = branchCode ?? "",
                TemplateName = row.TemplateName,
                Message = row.Message,
                MessageTypeId = row.MessageTypeId,
                SmsEmailSentId = row.SmsEmailSentId,
                SessionId = row.SessionId,
                RecipientType = row.RecipientType,
                // resend: the row of the first send is updated
                ResendSmsEmailId = resend ? row.SmsEmailId : null
            };
            var response = await httpService.Post<ApiResponse<WhatsAppSendResult>>(api, request);
            if (resend)
                row.SentDate = DateTime.Now;

            if (response == null)
            {
                row.Status = SendStatus.Failed;
                row.Remark = "Unable to reach the server.";
            }
            else if (response.Success)
            {
                row.Status = SendStatus.Sent;
                row.Remark = string.IsNullOrWhiteSpace(response.Data?.MobileNo) ? response.Message : $"{response.Message} ({response.Data.MobileNo})";
            }
            else
            {
                row.Status = SendStatus.Failed;
                row.Remark = response.Message ?? "Message was not sent.";
            }
            // the DB row of this message and how many times it failed
            if (response?.Data?.SmsEmailId > 0)
                row.SmsEmailId = response.Data.SmsEmailId;
            if (response?.Data != null && response.Data.StatusSaved)
                row.FailCount = response.Data.FailCount;
            else if (row.Status == SendStatus.Failed)
                row.FailCount++;
            // a failed row can be resent again
            row.CanResend = row.Status == SendStatus.Failed;
            StateHasChanged();
        }

        var sent = rows.Count(x => x.Status == SendStatus.Sent);
        // SMS balance goes down after a send
        if (isSms && sent > 0)
            await LoadBalance();
        if (sent > 0)
        {
            Notifications.Add(isSms ? "SMS sent" : "WhatsApp message sent",
                $"{sent} of {rows.Count} student(s): {(isSms ? rows[0].Message : rows[0].TemplateName)}",
                isSms ? "bi-chat-dots" : "bi-whatsapp");

            // top-end success toast (SweetAlert)
            await Alert.ShowSuccess(sent == rows.Count
                ? "Message sent successfully."
                : $"Message sent successfully to {sent} of {rows.Count} student(s).");
        }
    }

    // dropdown text: first 50 characters + "..."
    private static string ShortText(string? text, int length)
    {
        var value = text?.Trim() ?? "";
        return value.Length > length ? value[..length].TrimEnd() + "..." : value;
    }

    private void ToggleAllFailed()
    {
        foreach (var row in resultRows.Where(IsResendable))
            row.IsSelected = IsAllFailedSelected;
    }

    // refresh: only the grid, reloaded from the DB (form stays as it is)
    private async Task RefreshGrid()
    {
        if (IsSending || IsLoadingHistory) return;
        await LoadHistory();
    }

    private async Task ClosePopup()
    {
        if (IsSending) return;
        resultRows = new();
        sentModel = new SMSSentModel();
        TemplateName = null;
        SelectedTextId = 0;
        smsEmailTextlist = new();
        if (OnClose.HasDelegate)
            await OnClose.InvokeAsync();
        StateHasChanged();
    }
}
