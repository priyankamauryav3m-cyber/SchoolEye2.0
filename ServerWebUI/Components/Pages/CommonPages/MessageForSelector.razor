@using DomainModel.Enum
<div class="form-box">
    <label class="form-label fw-semibold">@Label</label>
    <div class="border-box mfs-box d-flex justify-content-center align-items-center flex-wrap gap-4 p-2">
        <InputRadioGroup TValue="MessageType" Value="Value" ValueChanged="OnValueChanged" ValueExpression="() => Value">
            <label class="mfs-opt">
                <InputRadio Value="MessageType.SMS" />
                <i class="bi bi-chat-square-text mfs-sms"></i> SMS
            </label>
            <label class="mfs-opt">
                <InputRadio Value="MessageType.WhatsApp" />
                <i class="bi bi-whatsapp mfs-wa"></i> WhatsApp
            </label>
            <label class="mfs-opt">
                <InputRadio Value="MessageType.Email" />
                <i class="bi bi-envelope mfs-mail"></i> Email
            </label>
        </InputRadioGroup>
    </div>
</div>
<style>
    .mfs-box { background: #f7f9fc; border: 1px solid #dfe6ee; border-radius: 10px; min-height: 46px; }
    .mfs-opt { display: inline-flex; align-items: center; gap: 6px; margin: 0; cursor: pointer; font-weight: 500; }
        .mfs-opt input[type=radio] { width: 15px; height: 15px; margin: 0 2px 0 0; cursor: pointer; }
    .mfs-sms { color: #1b6fa8; }
    .mfs-wa { color: #1f9d55; }
    .mfs-mail { color: #d63a4f; }
    html.dark-mode .mfs-box { background: rgba(255,255,255,.04); border-color: rgba(255,255,255,.12); }
</style>
@code {
    [Parameter] public string Label { get; set; } = "Message For";
    [Parameter] public MessageType Value { get; set; }
    [Parameter] public EventCallback<MessageType> ValueChanged { get; set; }

    // tell the parent (@bind-Value) which channel was picked
    private async Task OnValueChanged(MessageType value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }
}
