                                <div class="tab-pane tab-pane-form fade @(ActiveTab == "family-details" ? "show active" : "")" id="family-details">
                                    <EditForm Model="@familyWrapper" OnValidSubmit="Familydetails" FormName="FaimilyForm">
                                        <DataAnnotationsValidator />
                                        <fieldset disabled="@_faimilyFormDisabled" class="overflow-auto min-h-400" style="height: calc(100vh - 215px); scrollbar-width: thin !important;">

                                            @for (int i = 0; i < familyWrapper.Families.Count; i++)
                                            {
                                                var item = familyWrapper.Families[i];

                                                <div class="row m-0 form-row">
                                                    <div class="col-12 col-sm-6 col-md-4 col-lg-1 px-1 mt-3">
                                                        <div class="form-box-group static-label @(_faimilyFormDisabled == true ? "disabled" : "")">
                                                            <label for="image" class="floating-label">
                                                                Sr. No.
                                                            </label>
                                                            <div class="border-box d-flex justify-content-start align-items-center p-2">
                                                                <label class="d-flex align-items-center form-label">
                                                                    @(i + 1)
                                                                </label>
                                                            </div>

                                                        </div>
                                                    </div>
                                                    <div class="col-12 col-sm-6 col-md-4 col-lg-4 px-1 mt-3">
                                                        <div class="form-box-group @(_faimilyFormDisabled == true ? "disabled" : "")">
                                                            <InputText class="floating-input" placeholder=" " @bind-Value="item.FamilyChildName" onkeypress="return /^[a-z A-Z ]$/.test(event.key)" autocomplete="off" maxlength="50" />
                                                            <label class="floating-label">Name</label>
                                                            <ValidationMessage For="@(() => item.FamilyChildName)" />
                                                        </div>
                                                    </div>
                                                    <div class="col-12 col-sm-6 col-md-4 col-lg-4 px-1 mt-3">
                                                        <div class="form-box-group @(_faimilyFormDisabled == true ? "disabled" : "")">
                                                            <InputText class="floating-input" placeholder=" " @bind-Value="item.FamilyChildSchool" onkeypress="return /^[a-z A-Z ]$/.test(event.key)" autocomplete="off" maxlength="50" />
                                                            <label class="floating-label">School/College</label>
                                                            <ValidationMessage For="@(() => item.FamilyChildSchool)" />
                                                        </div>
                                                    </div>
                                                    <div class="col-12 col-sm-6 col-md-4 col-lg-3 px-1 mt-3">
                                                        <div class="form-box-group @(_faimilyFormDisabled == true ? "disabled" : "")">
                                                            <InputText class="floating-input" placeholder=" " @bind-Value="item.FamilyChildclass" autocomplete="off" maxlength="50" />
                                                            <label class="floating-label">Class-Section</label>
                                                            <ValidationMessage For="@(() => item.FamilyChildclass)" />
                                                        </div>
                                                    </div>

                                                </div>

                                            }
                                            <div class="row m-0 form-row">
                                                <div class="col-12 px-1 mt-3">
                                                    <div class="tab-buttons d-flex justify-content-end">
                                                        <button type="button" class="ui animated button form-btn backBtn bg-blue"
                                                                @onclick="AddRow" tabindex="0">
                                                            <div class="visible content">Add Row</div>
                                                            <div class="hidden content">
                                                                <i class="bi bi-plus"></i>
                                                            </div>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>

                                        </fieldset>
                                        <hr class="row m-0 my-2 w-webkit text-light-gray">
                                        <div class="row m-0">
                                            <div class="col-12 p-0 mt-1 d-flex align-items-end justify-content-end">
                                                <div class="tab-buttons d-flex gap-2">

                                                    @if (_faimilyFormDisabled)
                                                    {
                                                        <button type="button" class="ui animated button form-btn backBtn"
                                                                tabindex="0" @onclick='() => SetTab("address-details")'>
                                                            <div class="visible content">Back</div>
                                                            <div class="hidden content">
                                                                <i class="bi bi-arrow-left"></i>
                                                            </div>
                                                        </button>

                                                        <AdmitChildButton CurrentUrl="@UrlData" ButtonText="Edit" Modifiy="() => faimilyDisEnableform(false)" />

                                                    }
                                                    else
                                                    {

                                                        <SaveUpdateButton ShowSaveButton="false" OnClickCancel="() => faimilyDisEnableform(true)" />
                                                    }
                                                    <button type="submit" class="ui animated button form-btn nextBtn"
                                                            tabindex="0">
                                                        <div class="visible content">@buttontitle</div>
                                                        <div class="hidden content">
                                                            <i class="bi bi-arrow-right"></i>
                                                        </div>
                                                    </button>

                                                </div>
                                            </div>
                                        </div>
                                    </EditForm>
                                </div>

                                @*   ---------------------------------- End family-details ---------------------------------------------  *@

                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

}


