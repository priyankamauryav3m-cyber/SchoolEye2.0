    private async Task Addressdetails()
    {
        try
        {
            // permanent address is not the form model, so the form submit does not check its contact no.
            if (!IsSameAsCurrent && !new DomainModel.Common.ValidMobileNoAttribute().IsValid(addressPermanent.ContactNo))
            {
                await customAlert.ShowCustomAlert("Permanent address: Enter valid 10 digit mobile number", false);
                return;
            }
            if (!IsSameAsCurrent && !string.IsNullOrEmpty(addressPermanent.PinCode)
                && !System.Text.RegularExpressions.Regex.IsMatch(addressPermanent.PinCode, @"^[0-9]{6}$"))
            {
                await customAlert.ShowCustomAlert("Permanent address: Enter valid 6 digit pincode", false);
                return;
            }
            if ((IsEdited(addressDetails, _originaladdress)) || (IsEdited(addressPermanent, _originaladdress)))
            {
                addressDetails.RegistrationId = RegId;
                addressDetails.CreatedBy = username;
                addressDetails.GroupCode = groupcode;
                addressDetails.BranchCode = branchcode;
                // addressDetails.StreamCode = "-1";
                addressDetails.SessionId = SessionId;
                var list = new List<AddressDetails>();
                if (addressDetails != null)
                {
                    addressDetails.AddressType = "C";
                    list.Add(addressDetails);
                    if (IsSameAsCurrent)
                    {
                        // addressDetails.RegistrationNo = RegNo;
                        // addressDetails.CreatedBy = "V3M";
                        // addressDetails.GroupCode = groupcode;
                        // addressDetails.SessionName = "2025-2026";
                        list.Add(new AddressDetails
                        {

                            AddressType = "P",
                            AddressTo = addressDetails.AddressTo,
                            ContactNo = addressDetails.ContactNo,
                            PinCode = addressDetails.PinCode,
                            Line1 = addressDetails.Line1,
                            Line2 = addressDetails.Line2,
                            CreatedBy = username,
                            GroupCode = groupcode,
                            RegistrationId = RegId,
                            SessionId = SessionId,
                            BranchCode = branchcode,
                            PermanentLine1 = addressDetails.Line1

                        });
                    }
                    else
                    {
                        if (addressPermanent != null)
                        {
                            addressPermanent.AddressType = "P";
                            list.Add(addressPermanent);
                        }

                    }
                }
                string apiUrl = "Registration/registrationAddressInfo";
                foreach (var item in list)
                {
                    var apiResponse = await httpService.Post<ApiResponse<object>>(apiUrl, item);
                    // not saved -> stay on this tab (no tick)
                    if (apiResponse == null || !apiResponse.Success)
                    {
                        await customAlert.ShowCustomAlert(apiResponse?.Message ?? "Address could not be saved. Please try again.", false);
                        return;
                    }
                }
                // child save sends the same ADM_Registration emergency columns, keep them in step
                childDetails.EmergencyPersonName = addressDetails.EmergencyPersonName ?? string.Empty;
                childDetails.EmergencyPersonRelationShip = addressDetails.EmergencyPersonRelationShip;
                childDetails.EmergencyPersonContactNo = addressDetails.EmergencyPersonContactNo;

                ShowSuccess = true;
                StateHasChanged();
                await Task.Delay(3000);
                ShowSuccess = false;

            }
            addressDisEnableform(true);
            await SaveByActiveTab();
            StateHasChanged();

        }
        catch (Exception ex)
        {
            await customAlert.ShowCustomAlert($"{@Localizer["Error"]}: {ex.Message}", false);
        }
        finally
        {

            StateHasChanged();
        }

    }


    private async Task<AddressDetails?> GetAddressAsync(string addressType)
    {
        try
        {
            var url = await Urldataget("Registration/get-registration-AddressInformation");
            url += $"&AddressType={addressType}";
            var apiResponse = await httpService.Get<ApiResponse<AddressDetails>>(url);
            if (apiResponse?.Success == true && apiResponse.Data != null)
            {
                return apiResponse.Data;
            }

            return new AddressDetails();
        }
        catch (Exception ex)
        {
            await customAlert.ShowCustomAlert($"{@Localizer["Error"]}: {ex.Message}", false);
            return null;
        }
        finally
        {

            StateHasChanged();
        }


    }
    // emergency contact is kept in ADM_Registration and comes with the child details
    private async Task LoadEmergencyContactAsync()
    {
        var url = await Urldataget($"Registration/get-registration-child");
        var child = await httpService.Get<ChildDetails>(url);
        if (child != null)
        {
            childDetails.EmergencyPersonName = child.EmergencyPersonName;
            childDetails.EmergencyPersonRelationShip = child.EmergencyPersonRelationShip;
            childDetails.EmergencyPersonContactNo = child.EmergencyPersonContactNo;
        }
        // set on both addresses, so the same-as-current check still compares the address only
        foreach (var address in new[] { addressDetails, addressPermanent })
        {
            if (address == null)
                continue;
            address.EmergencyPersonName = child?.EmergencyPersonName;
            address.EmergencyPersonRelationShip = child?.EmergencyPersonRelationShip;
            address.EmergencyPersonContactNo = child?.EmergencyPersonContactNo;
        }
        SelectedEmergencyContact = GetEmergencyContactType(child?.EmergencyPersonRelationShip);
    }
    private static string? GetEmergencyContactType(string? relationShip)
    {
        if (string.IsNullOrWhiteSpace(relationShip))
            return null;
        if (relationShip.Equals("Father", StringComparison.OrdinalIgnoreCase))
            return "Father";
        if (relationShip.Equals("Mother", StringComparison.OrdinalIgnoreCase))
            return "Mother";
        return "Other";
    }
    private async Task OnEmergencyContactChanged()
    {
        if (SelectedEmergencyContact == "Father" || SelectedEmergencyContact == "Mother")
        {
            // parents tab may not be opened yet
            if (string.IsNullOrWhiteSpace(parentsDetails?.FatherName) && string.IsNullOrWhiteSpace(parentsDetails?.MotherName))
            {
                var url = await Urldataget($"Registration/get-registration-childParent");
                parentsDetails = await httpService.Get<ParentsDetails>(url) ?? new();
            }
        }
        if (SelectedEmergencyContact == "Father")
        {
            addressDetails.EmergencyPersonName = parentsDetails.FatherName;
            addressDetails.EmergencyPersonRelationShip = "Father";
            addressDetails.EmergencyPersonContactNo = parentsDetails.FatherContactNo;
        }
        else if (SelectedEmergencyContact == "Mother")
        {
            addressDetails.EmergencyPersonName = parentsDetails.MotherName;
            addressDetails.EmergencyPersonRelationShip = "Mother";
            addressDetails.EmergencyPersonContactNo = parentsDetails.MotherContactNo;
        }
        else
        {
            addressDetails.EmergencyPersonName = string.Empty;
            addressDetails.EmergencyPersonRelationShip = string.Empty;
            addressDetails.EmergencyPersonContactNo = string.Empty;
        }
        StateHasChanged();
    }
