            !string.IsNullOrWhiteSpace(f.FamilyChildSchool) ||
            !string.IsNullOrWhiteSpace(f.FamilyChildclass);
    }
    private void faimilyDisEnableform(bool flag)
    {
        familyWrapper.Families = familyWrapper.Families
            .Where(x =>
                !string.IsNullOrWhiteSpace(x.FamilyChildName) ||
                !string.IsNullOrWhiteSpace(x.FamilyChildSchool) ||
                !string.IsNullOrWhiteSpace(x.FamilyChildclass))
            .ToList();

        // 🛡 Agar sab empty the → 1 blank row rakho
        if (!familyWrapper.Families.Any())
