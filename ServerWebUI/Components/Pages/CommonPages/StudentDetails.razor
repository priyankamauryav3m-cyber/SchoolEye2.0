            }
            else
            {
                addressPermanent.ContactNo = null;
                addressPermanent.AddressTo = null;
                addressPermanent.Line2 = null;
                addressDetails.PermanentLine1 = null;
                addressPermanent.PinCode = null;
            }
        }
        catch (Exception ex)
        {
            await Alert.ShowError($"{@Localizer["Error"]}: {ex.Message}");

        }
        finally
