    private async Task Familydetails()
    {

        // every missing required field, with the tab it is on; the first such tab is opened
        var missing = new List<(string Field, string TabId, string TabName)>();
        if (childDetails.Nationality == 0)
            missing.Add(("Nationality", "childs-details", "Child's Details"));
        if (childDetails.SocialCategory == 0)
            missing.Add(("Category", "childs-details", "Child's Details"));
        if (string.IsNullOrEmpty(parentsDetails.SMSMobileNo))
            missing.Add(("SMS mobile number", "parents-details", "Parents Details"));
        if (string.IsNullOrEmpty(addressDetails.Line1))
            missing.Add(("Current address line 1", "address-details", "Address Details"));
        if (string.IsNullOrEmpty(addressDetails.PermanentLine1))
            missing.Add(("Permanent address line 1", "address-details", "Address Details"));

        if (missing.Count > 0)
        {
            var message = string.Join("\n", missing.Select(m => $"{m.Field} is required ({m.TabName} tab)"));
            await SetTab(missing[0].TabId);
            await customAlert.ShowCustomAlert(message, false);
            StateHasChanged();
            return;
        }
        if (IsEdited(familyWrapper, _originalfaimily))
        {

            var listToSave = familyWrapper.Families
                .Where(x =>
                    !string.IsNullOrWhiteSpace(x.FamilyChildName) ||
                    !string.IsNullOrWhiteSpace(x.FamilyChildSchool) ||
                    !string.IsNullOrWhiteSpace(x.FamilyChildclass))
                .ToList();

            if (!listToSave.Any())
                return;


            //var data = new List<FamilyDetails> { listToSave };

            string apiUrl = "Registration/InsertFamilyDetails";

            foreach (var item in listToSave)
            {
                item.RegistrationId = RegId;
                item.BranchCode = branchcode;
                item.GroupCode = groupcode;
                item.CreatedBy = username;
                item.SessionId = SessionId;
                var apiResponse = await httpService.Post<ApiResponse<object>>(apiUrl, item);
                // not saved -> stay on this tab (no tick)
                if (apiResponse == null || !apiResponse.Success)
                {
                    await customAlert.ShowCustomAlert(apiResponse?.Message ?? "Family details could not be saved. Please try again.", false);
                    return;
                }
            }

            ShowSuccess = true;
            StateHasChanged();
            await Task.Delay(3000);
            ShowSuccess = false;
            faimilyDisEnableform(true);
            await SaveByActiveTab();
            StateHasChanged();
        }

        IsVisible = false;
        var submit = await Alert.ShowConfirm("Do you want to submit details?");
        if (!submit)
        {
            IsVisible = true;
            StateHasChanged();
            return;
        }
        registrationStatusModel.GroupCode = groupcode;
        registrationStatusModel.BranchCode = branchcode;
        registrationStatusModel.SessionId = SessionId;
        registrationStatusModel.RegistrationId = RegId;
        registrationStatusModel.CreatedBy = username;
        var apiresponse = await httpService.Post<ApiResponse<object>>("Registration/UpdateStudentStatus", registrationStatusModel);
        if (apiresponse.Success && apiresponse.Code == 2)
        {
            await Alert.ShowSuccess("Student details submit successfullt !");
            await OnSearch.InvokeAsync();
            StateHasChanged();
        }




    }
