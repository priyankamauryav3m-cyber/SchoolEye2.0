                    parentsDetails = await httpService.Get<ParentsDetails>(url) ?? new();
                    break;
                case "address-details":
                    addressDetails = await GetAddressAsync("C");
                    addressPermanent = await GetAddressAsync("P");
                    await LoadEmergencyContactAsync();
                    addressPermanent.AddressType = addressPermanent != null ? "C" : null;
                    IsSameAsCurrent = CreateSnapshot(addressDetails) == CreateSnapshot(addressPermanent) ? true : false;
                    if (IsSameAsCurrent)
                    {
                        addressDetails.PermanentLine1 = addressPermanent.Line1;
                    }
                    addressPermanent.AddressType = addressPermanent != null ? "P" : null;
                    break;
                case "family-details":
                    url = await Urldataget($"Registration/get-registration-FamilyDetails");
                    var dbData = await httpService.Get<List<FamilyDetails>>(url);
                    if (dbData != null && dbData.Any())
                    {
                        familyWrapper.Families = dbData;
                    }
                    else
                    {
                        familyWrapper.Families.Add(new FamilyDetails());
                    }
                    break;

            }
            childDisEnableform(true);
            addressDisEnableform(true);
            parentsDisEnableform(true);
            faimilyDisEnableform(true);
        }
        catch (Exception ex)
