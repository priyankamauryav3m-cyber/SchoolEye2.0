@code {

    // ---------------- chart data (ApexCharts) ----------------
    // one point of a month-wise series coming from USP_AdminDashboard ("Apr,May" + "10,20")
    private class ChartPoint
    {
        public string Label { get; set; } = "";
        public decimal Value { get; set; }
    }

    private class FeeTrendPoint
    {
        public string Month { get; set; } = "";
        public decimal Collected { get; set; }
        public decimal Invoiced { get; set; }
    }

    private List<ChartPoint> collectionSpark = new();
    private List<ChartPoint> newStudentSpark = new();
    private List<ChartPoint> outstandingSpark = new();
    private List<FeeTrendPoint> feeTrend = new();
    private List<ChartPoint> overview = new();

    private static readonly System.Globalization.CultureInfo InCulture = new("en-IN");

    // JS formatter for rupee values (Indian grouping), used by tooltips and axis
    private const string RupeeFormatter = "function (v) { return '₹ ' + Number(v || 0).toLocaleString('en-IN', { maximumFractionDigits: 0 }); }";
    private const string CountFormatter = "function (v) { return Number(v || 0).toLocaleString('en-IN', { maximumFractionDigits: 0 }); }";

    // pairs the month names with their values; a count mismatch or bad number never breaks the page
    private static List<ChartPoint> BuildSeries(string? months, string? points)
    {
        var values = (points ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var labels = (months ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var list = new List<ChartPoint>();
        for (int i = 0; i < values.Length; i++)
        {
            decimal.TryParse(values[i], System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var v);
            list.Add(new ChartPoint { Label = i < labels.Length ? labels[i] : $"#{i + 1}", Value = v });
        }
        return list;
    }

    private void BuildCharts()
    {
        collectionSpark = BuildSeries(adminDashboard.FeeMonthName, adminDashboard.FeeCollecionPoints);
        newStudentSpark = BuildSeries(adminDashboard.NewStudentMonthName, adminDashboard.NewStudentPoints);
        outstandingSpark = BuildSeries(adminDashboard.OutstandingMonthName, adminDashboard.OutstandingFeePoints);

        // collection and invoice months can differ: merge both on month name, keep calendar order (same as the SP)
        feeTrend = collectionSpark.Select(x => x.Label)
            .Union(outstandingSpark.Select(x => x.Label), StringComparer.OrdinalIgnoreCase)
            .OrderBy(MonthOrder)
            .Select(m => new FeeTrendPoint
            {
                Month = m,
                Collected = collectionSpark.Where(x => string.Equals(x.Label, m, StringComparison.OrdinalIgnoreCase)).Sum(x => x.Value),
                Invoiced = outstandingSpark.Where(x => string.Equals(x.Label, m, StringComparison.OrdinalIgnoreCase)).Sum(x => x.Value)
            })
            .ToList();

        // same 4 numbers as the stat cards (order = colours in overviewOptions)
        overview = new List<ChartPoint>
        {
            new() { Label = "Total Students", Value = Math.Max(adminDashboard.TotalStudent, 0) },
            new() { Label = "Today's Collection", Value = Math.Max(adminDashboard.TodayFeeCollection, 0) },
            new() { Label = "New Admissions", Value = Math.Max(adminDashboard.NewAdmissions, 0) },
            new() { Label = "Outstanding Fees", Value = Math.Max(adminDashboard.OutstandingFees, 0) }
        };
    }

    private static int MonthOrder(string month) =>
        DateTime.TryParseExact(month, "MMM", System.Globalization.CultureInfo.InvariantCulture,
                               System.Globalization.DateTimeStyles.None, out var d) ? d.Month : 13;

