@code {

    private string GetNewStudentPoints(string studentPoints)
    {
        if (string.IsNullOrWhiteSpace(studentPoints))
            return "";

        var data = studentPoints.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(int.Parse).ToList();

        if (data.Count == 1)
            return "40,20";

        int width = 80;
        int height = 40;
        int max = data.Max();

        return string.Join(" ",
            data.Select((value, index) =>
            {
                double x = index * (width / (double)(data.Count - 1));
                double y = height - ((value / (double)max) * (height - 4));
                return $"{Math.Round(x)},{Math.Round(y)}";
            })
        );
    }

    private string GetTotalStudentPoints(string studentPoints)
    {
        if (string.IsNullOrWhiteSpace(studentPoints))
            return "";

        var data = studentPoints
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => int.Parse(x))
            .ToList();

        if (data.Count == 1)
            return $"40,20";

        var max = data.Max();
        int width = 80;
        int height = 40;

        return string.Join(" ",
            data.Select((value, i) =>
            {
                double px = i * (width / (double)(data.Count - 1));
                double py = height - ((value / (double)max) * (height - 4));

                return $"{Math.Round(px)},{Math.Round(py)}";
            }));
    }
    private string GetCollectionPoints(string collectionPoints)
    {
        if (string.IsNullOrWhiteSpace(collectionPoints))
            return "";

        var data = collectionPoints
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(decimal.Parse)
            .ToList();

        if (data.Count == 1)
            return "40,20";

        decimal max = data.Max();
        int width = 80;
        int height = 40;

        return string.Join(" ",
            data.Select((value, index) =>
            {
                var x = index * (width / (double)(data.Count - 1));
                var y = height - ((double)(value / max) * (height - 4));

                return $"{Math.Round(x)},{Math.Round(y)}";
            }));
    }
    private string GetOutstandingPoints(string outstandingPoints)
    {
        if (string.IsNullOrWhiteSpace(outstandingPoints))
            return "";

        var data = outstandingPoints
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(decimal.Parse)
            .ToList();

        if (data.Count == 1)
            return "40,20";

        decimal max = data.Max();
        int width = 80;
        int height = 40;

        return string.Join(" ",
            data.Select((value, index) =>
            {
                double x = index * (width / (double)(data.Count - 1));
                double y = height - ((double)(value / max) * (height - 4));

                return $"{Math.Round(x)},{Math.Round(y)}";
            }));
    }
