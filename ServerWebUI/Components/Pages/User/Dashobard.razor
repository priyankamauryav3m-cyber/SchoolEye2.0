<style>
    .stat-spark {
        width: 100%;
    }

    .quickgrid th {
        background-color: #fcfcfc;
        border: none;
    }

    .quickgrid[theme=default] .col-title {
        color: #64748b
    }

    .quickgrid[theme="default"] > tbody > tr > td {
        border: none;
    }

    .quickgrid tbody, td, tfoot, th, thead, tr {
        border-style: solid;
        border-width: 0;
        border-color: #f7f0f0;
    }

        .quickgrid tbody tr:hover td {
            background-color: #f8fafc;
        }

    .quickgrid thead th:last-child {
        min-width: 110px;
    }

    .quickgrid thead th:nth-last-child(2) {
        min-width: 180px;
    }

    .stat-change {
        padding-top: 10px;
        padding-left: 35px;
    }

    .state-icon--bxds {
        gap: 12px;
    }

    .progress-bar-custom {
        height: 5px;
    }

    .fee-status-legend {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px 8px;
        border-top: 1px solid #eef2f7;
        padding-top: 12px;
        margin-top: 8px;
    }

    .overview-donut {
        position: relative;
    }

    .overview-center {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        pointer-events: none;
    }

    .oc-value {
        font-size: 22px;
        font-weight: 700;
        color: #1e293b;
        line-height: 1.1;
    }

    .oc-label {
        font-size: 12px;
        color: #64748b;
    }

    .fs-item {
        display: flex;
        align-items: flex-start;
        gap: 8px;
    }

    .fs-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        margin-top: 4px;
        flex-shrink: 0;
    }

    .fs-label {
        font-size: 12px;
        color: #64748b;
    }

    .fs-value {
        font-size: 14px;
        font-weight: 600;
        color: #1e293b;
    }

    .trend-empty {
        height: 260px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #94a3b8;
        font-size: 13px;
    }

    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 10px;
    }

    .stage-icon {
        width: 50px;
        height: 50px;
    }
</style>

<section class="main-container">

    <div class="row m-0 main-row">
        <div class="content">
            <div class="breadcrumb-custom">
                <a class="current" href="javascript:void(0)" @onclick="RefreshPage">Home / Dashboard</a>
            </div>

            <div class="row g-3 mb-4 align-items-center">
                <div class="col-12 col-md-12 col-lg-3 col-xxl-4">
                    <h2 class="page-title">@DashboardName  Dashboard</h2>
                    <p class="page-sub">Welcome back, Admin User! Here's what's happening in your school today.</p>
                </div>
                <div class="col-12 col-md-12 col-lg-9 col-xxl-8">
                    <div class="row g-2 dash-tint-qa">
                        <div class="col-6 col-md-6 col-lg-3 col-xll-3">
                            <button class="qa-btn qa-adm-btn tint-blue" data-action="new-admission" type="button" @onclick="AdmitStudentDirect">
                                <div class="qa-icon blue"><i class="fas fa-plus"></i></div>
                                <div>
                                    <div class="qa-title">New Admission</div>
                                    <div class="qa-desc">Add a new student</div>
                                </div>
                            </button>
                        </div>
                        <div class="col-6 col-md-6 col-lg-3 col-xll-3">
                            <button class="qa-btn qa-fee-btn tint-green" data-action="collect-fee" type="button" @onclick="CollectFee">
                                <div class="qa-icon green"><i class="fa fa-inr"></i></div>
                                <div>
                                    <div class="qa-title">Collect Fee</div>
                                    <div class="qa-desc">Create new receipt</div>
                                </div>
                            </button>
                        </div>
                        <div class="col-6 col-md-6 col-lg-3 col-xll-3">
                            <button class="qa-btn qa-search-btn tint-purple" data-action="search-student" type="button" @onclick="SearchStudent">
                                <div class="qa-icon purple"><i class="fas fa-search"></i></div>
                                <div>
                                    <div class="qa-title">Search Student</div>
                                    <div class="qa-desc">Find student details</div>
                                </div>
                            </button>
                        </div>
                        <div class="col-6 col-md-6 col-lg-3 col-xll-3">
                            <button class="qa-btn qa-rem-btn tint-orange" data-action="send-reminder">
                                <div class="qa-icon orange"><i class="fas fa-envelope"></i></div>
                                <div>
                                    <div class="qa-title">Send Reminder</div>
                                    <div class="qa-desc">Send fee reminders</div>
                                </div>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-4 dash-tint-stats">
                <div class="col-12 col-md-6 col-xl-3">
                    <div class="stat-card tint-blue">
                        <div class="state-icon--bxds">
                            <div class="stat-icon blue"><i class="fas fa-users"></i></div>
                            <div class="flex-grow-1">
                                <div class="stat-label text-nowrap">Total Students</div>
                                <div class="stat-value">@adminDashboard.TotalStudent</div>
                            </div>
                        </div>
                        <div class="stat-change"><i class="fas fa-arrow-up"></i> @adminDashboard.StudentPercentage vs last session</div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-xl-3">
                    <div class="stat-card tint-orange">
                        <div class="state-icon--bxds">
                            <div class="stat-icon orange"><i class="fas fa-wallet"></i></div>
                            <div class="flex-grow-1">
                                <div class="stat-label">Today's Collection</div>
                                <div class="stat-value">₹ <span>@adminDashboard.TodayFeeCollection.ToString("N0", InCulture)</span></div>
                            </div>
                        </div>
                        <div class="stat-change down"><i class="fas fa-arrow-down"></i> @adminDashboard.CollectionPercentage vs last yesterday</div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-xl-3">
                    <div class="stat-card tint-green">
                        <div class="state-icon--bxds">
                            <div class="stat-icon green"><i class="fas fa-user-plus"></i></div>
                            <div class="flex-grow-1">
                                <div class="stat-label">New Admissions</div>
                                <div class="stat-value">@adminDashboard.NewAdmissions</div>
                            </div>
                        </div>
                        <div class="stat-change"><i class="fas fa-arrow-up"></i> @adminDashboard.AdmissionPercentage vs last month</div>
