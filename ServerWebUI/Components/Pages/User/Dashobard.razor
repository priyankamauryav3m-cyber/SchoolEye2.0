    private decimal GetPercentageValue(string percentage)
    {
        if (string.IsNullOrWhiteSpace(percentage))
            return 0;

        percentage = percentage.Replace("%", "");

        if (decimal.TryParse(percentage, out decimal result))
        {
            return Math.Min(result, 100); // 100 se upar nahi jayega
        }

        return 0;
    }
    private string GetFeeHeadColor(int index)
    {
        string[] colors =
        {
            "#22c55e", // Green
            "#f59e0b", // Yellow
            "#ef4444", // Red
            "#8b5cf6", // Purple
            "#06b6d4", // Cyan
            "#ec4899", // Pink
            "#84cc16", // Lime
            "#f97316", // Orange
            "#3b82f6", // Blue
            "#6366f1"  // Indigo
        };

        return colors[index % colors.Length];
    }

    public string GetTotalStudentAreaPoints(string studentPoint)
    {
        string linePoints = GetTotalStudentPoints(studentPoint);

        if (string.IsNullOrEmpty(linePoints))
            return "";
        var pointsArr = linePoints.Split(' ');
        string firstX = pointsArr[0].Split(',')[0];
        string lastX = pointsArr[pointsArr.Length - 1].Split(',')[0];
        return $"{linePoints} {lastX},40 {firstX},40";
    }
