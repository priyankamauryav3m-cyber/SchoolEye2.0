@page "/verifyotppage"
@layout LoginLayout
@using ServerWebUI.Components.Layout
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager Nav
@inject IConfiguration Configuration
@inject Shared.IHttpService httpService
@using Microsoft.AspNetCore.WebUtilities;
@using System.Security.Claims
@using System.Text.Json
@inject HttpClient httpClient
@using DomainModel.User
@using MyApp.Common
@inject SweetAlertService Alert
@using System.Timers;
@inject IHttpClientFactory HttpClientFactory

<section class="verification-section">
    <div class="otp-card-container">

        <!-- ===================== LEFT PANEL : Verification form ===================== -->
        <div class="left-panel">

            <div class="d-flex justify-content-between align-items-center mb-3">
                @if (IsOtpSent)
                {
                    <a @onclick="BackToSelectMode" class="back-link" style="cursor:pointer;">
                        <i class="fa-solid fa-arrow-left me-1"></i> Change option
                    </a>
                }
                else
                {
                    <div></div>
                }
                <span class="step-pill">Step @(IsOtpSent ? "2" : "1") of 2</span>
            </div>

            <div class="icon-badge">
                <i class="fa-solid fa-lock"></i>
            </div>

            <h2 class="signin-title text-center">Two-Step Verification</h2>
            @if (!IsOtpSent)
            {
                <p class="signin-sub text-center">Select where you would like to receive your 6-digit verification code.</p>
            }
            else
            {
                <p class="signin-sub text-center">
                    Enter the 6-digit code sent to<br />
                    <strong class="text-primary">@(SelectedType == "Email" ? MaskEmail(Email) : MaskMobile(Mobile))</strong>
                </p>
            }

            @if (!IsOtpSent)
            {
                <EditForm Model="@sendOtpRequest" OnSubmit="SendOtpEmailWithPhone">
                    <div class="options-group">
                        <InputRadioGroup TValue="string" @bind-Value="SelectedType">
                            <label class="option-card" for="radio-email">
                                <InputRadio TValue="string" Value='"Email"' id="radio-email" class="form-check-input" />
                                <span class="option-icon"><i class="fa-solid fa-envelope"></i></span>
                                <span class="option-label">Email: @MaskEmail(Email)</span>
                            </label>
                            <label class="option-card" for="radio-mobile">
                                <InputRadio TValue="string" Value='"Mobile"' id="radio-mobile" class="form-check-input" />
                                <span class="option-icon"><i class="fa-solid fa-mobile-screen-button"></i></span>
                                <span class="option-label">Mobile: @MaskMobile(Mobile)</span>
                            </label>
                        </InputRadioGroup>
                    </div>
                    <button class="btn-signin" type="submit">
                        <span>Send OTP</span> <i class="fa-solid fa-paper-plane ms-1"></i>
                    </button>
                </EditForm>
            }
            else
            {
                <div class="mb-2">
                    <input class="field-input otp-input-single"
                           value="@otpdata"
                           @oninput="OnOtpInput"
                           onkeypress="return /^[0-9]$/.test(event.key)"
                           maxlength="6"
                           inputmode="numeric"
                           placeholder="••••••"
                           autofocus />
                    @if (!string.IsNullOrWhiteSpace(OtpError))
                    {
                        <div class="text-danger mt-2 otp-error-shake text-center">
                            <small><strong>@OtpError</strong></small>
                        </div>
                    }
                    <p class="hint">The code expires in 10 minutes.</p>
                </div>

                <div class="timer-text mb-3">
                    @if (SecondsLeft > 0)
                    {
                        <span><i class="fa-regular fa-clock me-1"></i> Resend OTP in (@TimeLeft)</span>
                    }
                    else
                    {
                        <span>Didn't receive code? </span>
                        <a @onclick="ResendOtp" class="link-txt">Resend OTP</a>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(otpdata) && otpdata.Length == 6)
                {
                    <button class="btn-signin btn-verify" type="button" @onclick="VerifyOtpData" disabled="@isVerifying">
                        @if (isVerifying)
                        {
                            <div class="loading-text-container">
                                <div class="loader-spinner"></div>
                                <span>Logging in...</span>
                            </div>
                        }
                        else
                        {
                            <span><i class="fa-solid fa-check-circle me-1"></i> Verify &amp; Continue</span>
                        }
                    </button>
                }
            }

            <div class="info-box">
                <div class="info-icon"><i class="fa-solid fa-circle-info"></i></div>
                <div class="info-text">
                    <h5>Why do we need this?</h5>
                    <p>This extra step helps us protect your account and ensure it's really you logging in.</p>
                </div>
            </div>
        </div>

        <!-- ===================== RIGHT PANEL : SchoolEye Branding ===================== -->
        <div class="right-panel">
            <div class="brand-header">
                <img src="/images/schooleye-logo.png" alt="SchoolEye" class="brand-logo-img" />
            </div>

            <div class="brand-body">
                <p class="eyebrow">Your school. Connected.</p>
                <h1 class="brand-heading">Almost there,<br />SchoolEye family!</h1>
                <p class="brand-desc">Two-step verification protects your SchoolEye workspace by confirming that it is really you signing in.</p>

                <ul class="trust-list">
                    <li>Encrypted verification</li>
                    <li>Time-limited access code</li>
                    <li>Protected account activity</li>
                </ul>
            </div>

            <div class="brand-footer">
                <p class="tagline">Managing school, made simple.</p>
                <p class="powered">Powered by V3M Technologies</p>
            </div>
        </div>

    </div>
</section>

<style>
        body {
        background-image: url('/images/backgroundSchoolEye.png');
        background-repeat: no-repeat;
        background-position: center center;
        background-size: cover;
        background-attachment: fixed;
        background-color: #f0f0f0;
    }
    :root{--navy:#0d2e4d;--navy2:#123c66;--teal:#1fa19a;--blue:#1e6fb3;--ink:#152238;--muted:#6b7c8c}

    .verification-section{
         place-items: center;
    padding: 60px 40px;
    }

    .otp-card-container{
    width: min(1100px, 100%);
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-radius: 26px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(2px);
    }

    /* ---------- LEFT PANEL ---------- */
    .left-panel{
       padding: 49px 49px;
        display: flex;
        flex-direction: column;
       
    }

    .back-link{color:var(--muted);font-size:13px;font-weight:650;text-decoration:none}
    .back-link:hover{color:var(--blue)}

    .step-pill{display:inline-block;padding:5px 12px;border-radius:99px;color:#087bb7;background:#e8f5fb;
        font-size:10.5px;font-weight:800;letter-spacing:.06em;text-transform:uppercase}

    .icon-badge{width:52px;height:52px;display:grid;place-items:center;margin:6px auto 14px;border-radius:16px;
        background:linear-gradient(135deg,var(--blue),var(--teal));box-shadow:0 14px 30px #1e6fb340;color:#fff;font-size:22px}

    .signin-title{margin:0 0 8px;font-size:24px;font-weight:800;letter-spacing:-.02em}
    .signin-sub{margin:0 0 22px;color:var(--muted);font-size:13.5px;line-height:1.6}

    .options-group{display:flex;flex-direction:column;gap:12px;margin-bottom:20px}
    .option-card{display:flex;align-items:center;gap:12px;padding:14px 16px;border:1px solid #e2e8f0;border-radius:12px;
        cursor:pointer;transition:.18s ease;background:#fff}
    .option-card:hover{border-color:var(--blue);background:#f3f9fd}
    .option-card input{margin:0}
    .option-icon{width:32px;height:32px;border-radius:9px;background:#eaf3fb;color:var(--blue);
        display:grid;place-items:center;flex:0 0 auto;font-size:13px}
    .option-label{font-size:13.5px;font-weight:650;color:var(--ink)}

    .btn-signin{width:100%;height:50px;margin-top:4px;border:0;border-radius:12px;color:#fff;
        background:linear-gradient(100deg,var(--blue),var(--teal));box-shadow:0 12px 24px #1e6fb333;
        font-weight:750;font-size:15px;display:flex;align-items:center;justify-content:center;cursor:pointer}
    .btn-signin:disabled{background:#cfdbe2;box-shadow:none;cursor:not-allowed}
    .btn-verify{margin-top:0}

    .otp-input-single{width:100%;height:58px;text-align:center;border:1px solid #cbd9e3;border-radius:12px;
        background:#f9fbfc repeating-linear-gradient(90deg,transparent 0 58px,#cbd9e3 58px 59px);
        color:var(--ink);font-size:24px;font-weight:750;font-family:monospace;letter-spacing:30px;
        padding-left:22px;outline:0}
    .otp-input-single:focus{border-color:var(--blue);background-color:#fff;box-shadow:0 0 0 4px #1e6fb31a}
    .otp-input-single::placeholder{letter-spacing:30px;color:#c3cdd6}

    .hint{margin-top:8px;text-align:left;color:#8998a6;font-size:11px}

    .timer-text{text-align:center;color:var(--muted);font-size:12.5px}
    .link-txt{color:var(--blue);font-weight:700;text-decoration:none;cursor:pointer}
    .link-txt:hover{text-decoration:underline}

    .loading-text-container{display:flex;align-items:center;justify-content:center;gap:8px}
    .loader-spinner{width:16px;height:16px;border:2px solid #ffffff55;border-top-color:#fff;border-radius:50%;
        animation:spin .7s linear infinite}
    @@keyframes spin{to{transform:rotate(360deg)}}

    .otp-error-shake{animation:shake .35s ease}
    @@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-4px)}75%{transform:translateX(4px)}}

    .info-box{display:flex;gap:12px;margin-top:auto;padding-top:22px;margin-top:22px;padding:15px 16px;text-align:left;
        border:1px solid #dce9f0;border-radius:14px;background:#f5f9fb}
    .info-icon{width:34px;height:34px;display:grid;place-items:center;flex:0 0 auto;border-radius:10px;
        color:var(--blue);background:#e2f2fa}
    .info-text h5{margin:0 0 4px;font-size:12px}
    .info-text p{margin:0;color:#708392;font-size:11px;line-height:1.55}

    /* ---------- RIGHT PANEL (matches login page) ---------- */
    .right-panel{
         position: relative;
    overflow: hidden;
    color: #fff;
    padding: 40px 44px;
    display: flex;
    flex-direction: column;
    isolation: isolate;
      background: linear-gradient(145deg, #1769aa 0%, #0b2948 75%, #104560);
    }

    .brand-header{background:#fff;border-radius:12px;padding:10px 16px;display:inline-flex;
        align-items:center;max-width:220px;margin-bottom:50px;position:relative;z-index:2}
    .brand-logo-img{max-height:32px;width:auto;object-fit:contain}

    .brand-body{text-align:center;margin:auto 0;position:relative;z-index:2}
    .eyebrow{color:#7fd6cf;font-size:11.5px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;margin:0 0 18px}
    .brand-heading{font-size:32px;font-weight:800;line-height:1.2;letter-spacing:-.02em;margin:0 0 14px;color:#fff}
    .brand-desc{color:#c3d4e2;font-size:14px;line-height:1.7;max-width:380px;margin:0 auto 22px}

    .trust-list{display:flex;flex-wrap:wrap;justify-content:center;gap:8px;padding:0;list-style:none;margin:0 auto;max-width:380px}
    .trust-list li{padding:8px 12px;border:1px solid #ffffff1a;border-radius:9px;background:#ffffff0d;
        color:#dbe9f1;font-size:11.5px}
    .trust-list li:before{content:"✓";color:#67cf62;margin-right:6px;font-weight:bold}

    .brand-footer{text-align:center;margin-top:40px;position:relative;z-index:2}
    .tagline{font-weight:750;font-size:14px;margin:0 0 4px}
