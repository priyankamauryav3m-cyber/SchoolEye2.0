    @@media(max-width:900px){
        .otp-card-container{grid-template-columns:1fr;max-width:520px}
        .right-panel{order:-1;padding:30px}
        .brand-heading{font-size:26px}
        .brand-header{margin-bottom:26px}
        .left-panel{padding:30px 26px}
    }
</style>

@code {
    private int UserId;
    private string Email = "";
    private string Mobile = "";
    private string SelectedType = "Email";
    private string otpdata = "";
    private string OtpError = "";
    private bool IsVerifyClicked = false;
    private SendOtpRequest sendOtpRequest = new();
    private VerifyOtpRequestDto verifyOtpRequestDto = new();
    // 1.30 Minutes Timer = 90 Seconds
    private int SecondsLeft = 90;
    private bool IsOtpSent = false;
    // Time format 01:30
    private string TimeLeft => $"{SecondsLeft / 60:D2}:{SecondsLeft % 60:D2}";
    private Timer? timer;
    private void OnOtpInput(ChangeEventArgs e)
    {
        otpdata = e.Value?.ToString() ?? "";
        if (IsVerifyClicked)
        {
            if (string.IsNullOrWhiteSpace(otpdata))
                OtpError = "Please enter OTP.";
            else
                OtpError = "";
        }
    }
    private void BackToSelectMode()
    {
        // Stop the active timer
        timer?.Stop();
        IsOtpSent = false;
        otpdata = "";
        OtpError = "";
        IsVerifyClicked = false;
    }
    private string MaskEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email))
            return "";
        var parts = email.Split('@');
        if (parts.Length != 2)
            return email;
        var name = parts[0];
        if (name.Length <= 6)
            return name.Substring(0, Math.Min(2, name.Length)) + "*****@" + parts[1];
        return name.Substring(0, 2) +
               "*****" +
               name.Substring(name.Length - 4) +
               "@" + parts[1];
    }
    private string MaskMobile(string mobile)
    {
        if (string.IsNullOrWhiteSpace(mobile))
            return "";
        if (mobile.Length < 4)
            return "******";
        return "******" + mobile[^4..];
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var branchResult = await sessionStorage.GetAsync<int>("userId");
            UserId = branchResult.Value;
            var emailvalue = await sessionStorage.GetAsync<string>("Email");
            Email = emailvalue.Value;
            var mobileno = await sessionStorage.GetAsync<string>("MobileNo");
            Mobile = mobileno.Value;
            StateHasChanged();
        }
    }
    private async Task SendOtpEmailWithPhone()
    {
        sendOtpRequest.UserId = UserId;
        if (SelectedType == "Email")
        {
            if (string.IsNullOrWhiteSpace(Email))
            {
                await Alert.ShowWarning("Email address is not available.");
                return;
            }
            sendOtpRequest.SendTo = Email;
        }
        else if (SelectedType == "Mobile")
        {
            if (string.IsNullOrWhiteSpace(Mobile))
            {
                await Alert.ShowWarning("Mobile number is not available.");
                return;
            }
            sendOtpRequest.SendTo = Mobile;
        }
        else
        {
            await Alert.ShowWarning("Please select Email or Mobile No.");
            return;
        }
        await JS.InvokeVoidAsync("showProcessingAlert");
        var response = await httpService.Post<ApiResponse<string>>("users/SendOtp", sendOtpRequest);
        if (response.Success && response.Code == 1)
        {
            await Task.Delay(2000);
            await JS.InvokeVoidAsync("closeSwal");
            IsOtpSent = true;
            StartTimer();
            sendOtpRequest = new();
        }
        else if (response.Code == 2)
        {
            await Alert.ShowWarning(response.Message);
        }
        else
        {
            return;
        }
    }
    private bool isVerifying = false;
    private async Task VerifyOtpData()
    {
        try
        {
            IsVerifyClicked = true;
            if (string.IsNullOrWhiteSpace(otpdata))
            {
                OtpError = "Please enter the OTP.";
                return;
            }
            verifyOtpRequestDto.UserId = UserId;
            verifyOtpRequestDto.OtpCode = otpdata;
            if (verifyOtpRequestDto.OtpCode.Length != 6)
            {
                await Alert.ShowWarning("Please enter a valid 6-digit OTP.");
                return;
            }
            // Start Loading State
            isVerifying = true;
            StateHasChanged();
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "DeviceToken");
            if (!string.IsNullOrWhiteSpace(token))
            {
                verifyOtpRequestDto.DeviceToken = Guid.Parse(token);
            }
            var response = await httpService.Post<ApiResponse<UserModels>>("users/VerifyOtp", verifyOtpRequestDto);
            switch (response.Code)
            {
                case 1:
                    if (response.Success && response.Data != null)
                    {
                        var user = response.Data;
                        await JS.InvokeAsync<string>("localStorage.setItem", "authToken", user.Token);
                        await sessionStorage.SetAsync("authToken", user.Token);
                        var dashboard = await sessionStorage.GetAsync<string>("Dashboard");
                        // Success hone par hi form reset hoga
                        verifyOtpRequestDto.OtpCode = "";
                        otpdata = "";
                        OtpError = "";
                        IsOtpSent = false;
                        if (dashboard.Success && !string.IsNullOrWhiteSpace(dashboard.Value))
                        {
                            Nav.NavigateTo("/" + dashboard.Value, true);
                        }
                        else
                        {
                            Nav.NavigateTo("/", true);
                        }
                    }
                    break;
                case 2:
                case 3:
                    OtpError = response.Message; // Screen par error dikhayega
                    otpdata = "";
                    break;
                case 4:
                    OtpError = response.Message;
                    otpdata = "";
                    break;
                default:
                    break;
            }
        }
        catch (Exception ex)
        {
            OtpError = "Something went wrong. Please try again.";
        }
        finally
        {
            // Sirf loading stop karenge, IsOtpSent ko touch nahi karenge
            isVerifying = false;
            StateHasChanged();
        }
    }
    private async Task ResendOtp()
    {
        var request = new ResendOtpRequestDto
        {
            UserId = UserId,
            SendTo = SelectedType == "Email" ? Email : Mobile
        };
        await JS.InvokeVoidAsync("showProcessingAlert");
        var response = await httpService.Post<ApiResponse<string>>("users/ResendOtp", request);
        if (response.Success && response.Code == 1)
        {
            await Task.Delay(2000);
            await JS.InvokeVoidAsync("closeSwal");
            await Alert.ShowSuccess(response.Message);
            StartTimer();
        }
        else
        {
            await Alert.ShowWarning(response.Message);
        }
    }
    private void StartTimer()
    {
        // Set to 90 seconds (1 minute 30 seconds)
        SecondsLeft = 90;
        timer?.Dispose();
        timer = new Timer(1000);
        timer.Elapsed += async (_, _) =>
        {
            if (SecondsLeft > 0)
            {
                SecondsLeft--;
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                timer.Stop();
            }
        };
        timer.Start();
    }
    public void Dispose()
    {
        timer?.Dispose();
    }
}