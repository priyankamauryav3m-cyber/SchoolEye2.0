                                                    </svg>

                                                    <span class="d-none d-sm-block">
                                                        Continue with Facebook
                                                    </span>
                                                    <span class="d-block d-sm-none">Facebook</span>
                                                </button>
                                            </div>
                                            @*
                                            <div class="microsoft-authentication ng-scope">
                                                <button class="social-login_btn ng-scope">
                                                    <svg class="google_svg" viewBox="0 0 15 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                        <path d="M7 8H1V2H7V8Z" fill="#F1511B"></path>
                                                        <path d="M14 8H8V2H14V8Z" fill="#80CC28"></path>
                                                        <path d="M7 15H1V9H7V15Z" fill="#00ADEF"></path>
                                                        <path d="M14 15H8V9H14V15Z" fill="#FBBC09"></path>
                                                    </svg>
                                                    <span class="d-none d-sm-block">
                                                        Continue
                                                        with Microsoft
                                                    </span>
                                                    <span class="d-block d-sm-none">Microsoft</span>
                                                </button>
                                            </div> *@
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 mt-3 d-flex justify-content-center justify-content-sm-between flex-wrap gap-0-15">
                    <a href="https://v3m.in/" target="_blank" class="primary-link font-family-poppins fts-12 text-dark-gray ftw-400 m-0">
                        © 2025 | Powered by V3M Technologies
                    </a>
                    <div class="d-flex gap-3">
                        <a href="https://schooleye.in/Terms-and-conditions.html" target="_blank" class="primary-link font-family-poppins fts-12 text-dark-gray ftw-400 m-0">
                            Terms & Conditions
                        </a>
                        <a href="https://schooleye.in/Terms-and-conditions.html" target="_blank" class="primary-link font-family-poppins fts-12 text-dark-gray ftw-400 m-0">
