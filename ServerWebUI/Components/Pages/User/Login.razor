                                                        <path d="M14.1284 6.77594H13.625V6.75H8V9.25H11.5322C11.0169 10.7053 9.63219 11.75 8 11.75C5.92906 11.75 4.25 10.0709 4.25 8C4.25 5.92906 5.92906 4.25 8 4.25C8.95594 4.25 9.82563 4.61062 10.4878 5.19969L12.2556 3.43187C11.1394 2.39156 9.64625 1.75 8 1.75C4.54844 1.75 1.75 4.54844 1.75 8C1.75 11.4516 4.54844 14.25 8 14.25C11.4516 14.25 14.25 11.4516 14.25 8C14.25 7.58094 14.2069 7.17188 14.1284 6.77594Z" fill="#FFC107"></path>
                                                        <path d="M2.4707 5.09094L4.52414 6.59688C5.07977 5.22125 6.42539 4.25 8.00008 4.25C8.95602 4.25 9.8257 4.61062 10.4879 5.19969L12.2557 3.43187C11.1395 2.39156 9.64633 1.75 8.00008 1.75C5.59945 1.75 3.51758 3.10531 2.4707 5.09094Z" fill="#FF3D00"></path>
                                                        <path d="M8.0001 14.25C9.61447 14.25 11.0813 13.6322 12.1904 12.6275L10.256 10.9906C9.60746 11.4838 8.81493 11.7506 8.0001 11.75C6.37447 11.75 4.99416 10.7134 4.47416 9.26685L2.43604 10.8372C3.47041 12.8612 5.57104 14.25 8.0001 14.25Z" fill="#4CAF50"></path>
                                                        <path d="M14.1284 6.77594H13.625V6.75H8V9.25H11.5322C11.2857 9.94263 10.8417 10.5479 10.255 10.9909L10.2559 10.9903L12.1903 12.6272C12.0534 12.7516 14.25 11.125 14.25 8C14.25 7.58094 14.2069 7.17188 14.1284 6.77594Z" fill="#1976D2"></path>
                                                    </svg>
                                                    <span class="d-none d-sm-block">
                                                        Continue with Google
                                                    </span>
                                                    <span class="d-block d-sm-none">Google</span>
                                                </button>
                                            </div>

                                            <div class="microsoft-authentication ng-scope">
                                                <button class="social-login_btn ng-scope" @onclick="LoginWithFacebook">
