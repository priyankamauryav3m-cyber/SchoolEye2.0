                                        Your Gateway to Smarter School Management
                                    </p>
                                    <hr class="my-2">
                                </div>
                            </div>

                            <EditForm Model="@loginModel" OnValidSubmit="@HandleLogin">
                                <DataAnnotationsValidator />
                                <div class="row px-1">
                                    <div class="col-12 mt-2">
                                        <div class="input-box position-relative d-flex flex-column">
                                            <label for="username1"
                                                   class="input-label fts-12 ftw-600 text-dark-gray font-family-poppins mb-1">Username</label>
                                            <div class="d-flex input-icon-box align-items-center px-2">
                                                <div class="input-icon d-flex align-items-center justify-content-center px-1">
                                                    <i class="bi bi-person"></i>
                                                    <InputText @ref="usernameInput" class="login-input w-100" @bind-Value="loginModel.Username" />
                                                </div>
                                            </div>
                                            <ValidationMessage For="@(() => loginModel.Username)" />
                                        </div>
                                    </div>
                                    <div class="col-12 mt-3">
                                        <div class="input-box position-relative d-flex flex-column">
