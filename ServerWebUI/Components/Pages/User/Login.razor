        </section>

    </div>
</section>
@if (IsLoading)
{
    <div class="grid-loader-overlay">
        <img src="images/loading.gif" alt="Loading..." />
    </div>
}

<CustomAlert @ref="customAlert" Title="Alert" />

@code {

    private UserModels loginModel = new UserModels();
    private int firstNumber;
    private int secondNumber;
    private string operation = "";
    private int correctResult;
    private CustomAlert customAlert;
    private bool _isFirstRender = true;
    private bool _isClientSideReady = false;
    private bool IsLoadingPopUp = true;
    private InputText usernameInput;
    private InputText passwordInput;
    private ElementReference captchaInput;
    private bool IsLoading;
    [Parameter]
    [SupplyParameterFromQuery(Name = "name")]
    public string? Name { get; set; }
    private string? deviceToken;
    private void RefreshCaptcha()
    {
        GenerateMathProblem();
    }

    private async Task HandleInvalidSubmit()
    {
        if (string.IsNullOrWhiteSpace(loginModel.Username))
        {
            await jsRuntime.InvokeVoidAsync("focusElement", usernameInput.Element);
        }
        else if (string.IsNullOrWhiteSpace(loginModel.Password))
        {
            await jsRuntime.InvokeVoidAsync("focusElement", passwordInput.Element);
        }
        else if ((string.IsNullOrWhiteSpace(loginModel.CapchaCode)) || (int.TryParse(loginModel.CapchaCode, out int userInput) && userInput == correctResult))
        {
            await jsRuntime.InvokeVoidAsync("focusElement", captchaInput);
        }
    }
    private void GenerateMathProblem()
    {
        Random random = new Random();
        firstNumber = random.Next(1, 9);
        secondNumber = random.Next(1, 9);
        operation = "+";
        correctResult = firstNumber + secondNumber;
    }
    private async Task ValidFormSubmitted(EditContext editContext)
    {
        await HandleLogin();

    }
    // protected override async Task OnInitializedAsync()
    // {
    //     try
    //     {
    //         GenerateMathProblem();

    //         var authState = await AuthStateProvider.GetAuthenticationStateAsync();

    //         var user = authState.User;

    //         if (user.Identity != null && user.Identity.IsAuthenticated)
    //         {
    //             var email = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;

    //             var name = user.Identity.Name;

    //             Console.WriteLine($"Email: {email}");
    //             Console.WriteLine($"Name: {name}");
    //         }
    //     }
    //     catch (Exception ex)
    //     {
    //         Console.WriteLine(ex.Message);
    //     }
    // }
    protected override Task OnInitializedAsync()
    {

        GenerateMathProblem();
        return base.OnInitializedAsync();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
     
        if (_isFirstRender)
        {
            
            await JS.InvokeVoidAsync("initCarousel");
            _isFirstRender = false;
            await sessionStorage.DeleteAsync("userId");
            await sessionStorage.DeleteAsync("GroupId");
            await sessionStorage.DeleteAsync("GroupCode");
            await sessionStorage.DeleteAsync("HospitalId");
            await sessionStorage.DeleteAsync("HospitalCode");
            await sessionStorage.DeleteAsync("VCId");
            await sessionStorage.DeleteAsync("VCCode");
            await sessionStorage.DeleteAsync("LoginId");
            await sessionStorage.DeleteAsync("UserName");
            await sessionStorage.DeleteAsync("UserType");
            await sessionStorage.DeleteAsync("authToken");
            await sessionStorage.DeleteAsync("Vc_HospitalName");
            await sessionStorage.DeleteAsync("RoleId");
            await sessionStorage.DeleteAsync("RoleName");
            nav.NavigateTo("/");
        }
        if (firstRender && !string.IsNullOrEmpty(Name))
        {
            await customAlert!.ShowCustomAlert("Incorrect login details.", false);
        }

    }
    private async Task HandleLogin()
    {
        try
        {
            IsLoading = true;
            if (string.IsNullOrWhiteSpace(loginModel.Username) || string.IsNullOrWhiteSpace(loginModel.Password))
            {
                await sessionStorage.SetAsync("alertMessage", "Please fill out all required fields.");

                return;
            }
            if (string.IsNullOrWhiteSpace(loginModel.CapchaCode))
            {

                await customAlert.ShowCustomAlert("Please solve the captcha before logging in!", false);
                // await jsRuntime.InvokeVoidAsync("focusElement", captchaInput);
                return;
            }
            if (int.TryParse(loginModel.CapchaCode, out int userInput) && userInput == correctResult)
            {
                var deviceToken = await JS.InvokeAsync<string>("localStorage.getItem", "DeviceToken");
                if (string.IsNullOrWhiteSpace(deviceToken))
                {
                    deviceToken = Guid.NewGuid().ToString();
                    await JS.InvokeVoidAsync("localStorage.setItem", "DeviceToken", deviceToken);
                }

                loginModel.DeviceToken = Guid.Parse(deviceToken);

                var response = await httpClient.PostAsJsonAsync("users/UserloginData", loginModel);
                if (response.IsSuccessStatusCode)
                {
                    var user = await response.Content.ReadFromJsonAsync<UserModels>();
                    if (user != null)
                    {
                        switch (user.Result)
                        {
                            case "-1":
                                await customAlert.ShowCustomAlert("Incorrect login details.", false);
                                return;

                            case "-2":
                                await customAlert.ShowCustomAlert("Incorrect Password.", false);
                                return;

                            case "-3":
                                await customAlert.ShowCustomAlert("User does not exist.", false);
                                return;

                            default:
                                await sessionStorage.SetAsync("userId", user.UserId);
                                await sessionStorage.SetAsync("GroupCode", user.GroupCode);
                                await sessionStorage.SetAsync("BranchCode", user.BranchCode);
                                await sessionStorage.SetAsync("UserName", user.Username);
                                await sessionStorage.SetAsync("RoleName", user.RoleName);
                                await sessionStorage.SetAsync("UserType", user.UserType);
                                await sessionStorage.SetAsync("RoleId", user.RoleId);
                                await sessionStorage.SetAsync("Dashboard", user.RoleDashBoard);
                                PermissionState.RoleId = user.RoleId;
                                if (user.RequiresTwoFactor ==false && string.IsNullOrWhiteSpace(user.Token))
                                {
                                 
                                    await sessionStorage.SetAsync("Email", user.EmailId);
                                    await sessionStorage.SetAsync("MobileNo", user.MobileNo);
                                    NavigationManager.NavigateTo("/verifyotppage", true);
                                    return;
                                }
                                else
                                {
                                    await JS.InvokeVoidAsync("localStorage.setItem", "authToken", user.Token);
                                    await sessionStorage.SetAsync("authToken", user.Token);
                                    var dashboard = await sessionStorage.GetAsync<string>("Dashboard");
                                    if (dashboard.Success && !string.IsNullOrWhiteSpace(dashboard.Value))
                                    {
                                        NavigationManager.NavigateTo("/" + dashboard.Value, true);
                                    }
                                    else
                                    {
                                        NavigationManager.NavigateTo("/", true);
                                    }
                                }

                                break;
                        }

                    }
                    else
                    {
                        await customAlert.ShowCustomAlert(@Localizer["Admin"], false);
                    }
                }
                else
                {
                    await customAlert.ShowCustomAlert(@Localizer["Admin"], false);
                }
            }
            else
            {
                //await jsRuntime.InvokeVoidAsync("focusElement", captchaInput);
                await customAlert.ShowCustomAlert("Captcha code not solved correctly!", false);
            }
        }
        catch (Exception err)
        {
            await customAlert.ShowCustomAlert(@Localizer["Admin"], false);
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }
    private void GoogleLogin()
    {

        NavigationManager.NavigateTo("/login?provider=Google", true);
        // nav.NavigateTo("http://localhost:5205/api/AuthGoogleFb/google", true);

    }
    private void LoginWithFacebook()
    {
        NavigationManager.NavigateTo("/login?provider=Facebook", true);
    }


}

