                                                   class="input-label fts-12 ftw-600 text-dark-gray font-family-poppins mb-1">Password</label>
                                            <div class="d-flex input-icon-box align-items-center px-2">
                                                <div class="input-icon d-flex align-items-center justify-content-center px-1">
                                                    <i class="bi bi-key"></i>
                                                </div>
                                                <InputText @ref="passwordInput" type="password" class="login-input w-100" @bind-Value="loginModel.Password" />
                                            </div>
                                            <ValidationMessage For="@(() => loginModel.Password)" />
                                        </div>
                                    </div>
                                    <div class="col-12 mt-3 d-flex gap-3 align-items-end">
                                        <div class="input-box position-relative d-flex flex-column w-webkit">
                                            <label for="captcha"
                                                   class="input-label fts-12 ftw-600 text-dark-gray font-family-poppins mb-1">Captcha</label>
                                            <div class="d-flex input-icon-box align-items-center px-2">
                                                <div class="input-icon d-flex align-items-center justify-content-center px-1">
                                                    <i class="bi bi-arrow-repeat"></i>
                                                </div>
                                                <input @ref="captchaInput" class="login-input w-100" autocomplete="off" @bind="loginModel.CapchaCode">
                                            </div>
                                        </div>
                                        <div class="captcha-box d-flex">
                                            <div class="captcha-number">
                                                <p class="m-0" for="captchaInput">@($"{firstNumber} {operation} {secondNumber} = ?")</p>
                                            </div>
                                            <button type="button" class="captcha-btn" @onclick="RefreshCaptcha">
                                                <i class="bi bi-arrow-clockwise"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="col-12 mt-3">
                                        <button type="submit" class="primary-btn mt-2 w-100 font-family-poppins fts-18 ftw-400">Login</button>
                                    </div>
                                    <div class="col-12 mt-1 d-flex justify-content-between">
                                        <a href="javascript:void(0)"
                                           class="primary-link font-family-poppins fts-12 text-dark-gray ftw-500 mx-1 open-popup"
                                           data-id="forgotUserId">
                                            Forgot User Id ?
                                        </a>
                                        <a href="javascript:void(0)"
                                           class="primary-link font-family-poppins fts-12 text-dark-gray ftw-500 mx-1 open-popup"
                                           data-id="forgotPassword">
                                            Forgot Password ?
                                        </a>
                                    </div>
                                </div>
                            </EditForm>
                            <div class="row justify-content-center">
                                <div class="col-12 app-info d-flex justify-content-around">
                                    <div class="w-100">
                                        <div class="fxt-style-line">
                                            <h2>OR</h2>
                                            <div class="dvd-line position-absolute"></div>
                                        </div>
                                        <ul class="fxt-socials">
                                            <div class="google-authentication ng-scope">
                                                <button class="social-login_btn" @onclick="GoogleLogin">
