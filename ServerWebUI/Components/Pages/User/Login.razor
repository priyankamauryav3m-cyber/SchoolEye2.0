@page "/"
@layout LoginLayout
@using ServerWebUI.Components.Layout
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject IJSRuntime jsRuntime
@inject HttpClient httpClient
@inject NavigationManager NavigationManager
@inject NavigationManager nav
@inject IConfiguration Configuration
@inject Shared.IHttpService httpService
@using Microsoft.AspNetCore.WebUtilities;
@using System.Security.Claims
@using System.Text.Json
@using DomainModel.User
@using MyApp.Common
@using System.Timers;
@inject IStringLocalizer<Resource> Localizer
@inject PermissionState PermissionState

<section class="login-section">
    <div class="login-card-container">

        <!-- ===================== LEFT PANEL : School Logo + Login Form ===================== -->
        <div class="left-panel">
            <div class=" sign-data1 ">
                <div class="school-logo-wrap sign-data">
                    <img src="/images/school-logo.png" alt="School Logo" class="school-logo-img" />
                </div>
            </div>

            <div class=" sign-data align-items-center justify-content-center">
                <h2 class="signin-title ">Sign in</h2>
            </div>

            @* <p class="signin-sub">Welcome back to your school workspace.</p> *@

            <EditForm Model="@loginModel" OnValidSubmit="ValidFormSubmitted" OnInvalidSubmit="HandleInvalidSubmit">
                <DataAnnotationsValidator />

                <div class="field-block">
                    <label class="field-label">Username</label>
                    <div class="input-with-icon">
                        <i class="fa-solid fa-user"></i>
                        <InputText @ref="usernameInput" class="field-input" placeholder="Enter your username" @bind-Value="loginModel.Username" autocomplete="off" disabled="@IsLoading" />
                    </div>
                </div>

                <div class="field-block">
                    <label class="field-label">Password</label>
                    <div class="input-with-icon">
                        <i class="fa-solid fa-lock"></i>
                        <InputText @ref="passwordInput" class="field-input" type="@(ShowPassword ? "text" : "password")" placeholder="Enter your password" disabled="@IsLoading" @bind-Value="loginModel.Password" autocomplete="off" />
                        <a class="show-toggle" @onclick="() => ShowPassword = !ShowPassword">@(ShowPassword ? "Hide" : "Show")</a>
                    </div>
                </div>

                <div class="field-block">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="field-label m-0">Security check</label>
                        <span class="solve-hint">Solve the sum below</span>
                    </div>
                    <div class="captcha-row">
                        <input @ref="captchaInput" class="field-input captcha-answer" placeholder="Your answer" @bind="loginModel.CapchaCode" @bind:event="oninput" autocomplete="off" />
                        <div class="captcha-box">@firstNumber @operation @secondNumber = ?</div>
                        <button type="button" class="captcha-refresh" @onclick="RefreshCaptcha" title="Refresh captcha">
                            <i class="fa-solid fa-rotate"></i>
                        </button>
                    </div>
                </div>

                <button class="btn-signin" type="submit" disabled="@IsLoading">
                    @if (IsLoading)
                    {
                        <div class="loading-text-container">
                            <div class="loader-spinner"></div>
                            <span>Signing in...</span>
                        </div>
                    }
                    else
                    {
                        <span>Sign in <i class="fa-solid fa-arrow-right ms-1"></i></span>
                    }
                </button>
            </EditForm>

            <div class="forgot-row">
                <a href="/forgotusername" class="link-txt">Forgot username?</a>
                <a href="/forgotpassword" class="link-txt">Forgot password?</a>
            </div>

            <div class="or justify-content-center">
                <span>or continue with</span>
            </div>

            <div class="social-row">
                <button type="button" class="social-btn" @onclick="GoogleLogin">
                    <i class="fa-brands fa-google"></i> Google
                </button>
                <button type="button" class="social-btn" @onclick="LoginWithFacebook">
                    <i class="fa-brands fa-facebook" style="color:#1877f2"></i> Facebook
                </button>
            </div>

            <p class="help-text">Need help signing in? <a href="/contactschool">Contact your school</a></p>
        </div>

    
        <div class="right-panel">
            <div class="brand-top">
                <div class="brand-header">
                    <img src="/images/schooleye-logo.png" alt="SchoolEye" class="brand-logo-img" />
                </div>
            </div>

           
            <div class="brand-body">
                <p class="eyebrow">Your school. Connected.</p>
                <h1 class="brand-heading">Hello,<br />SchoolEye family!</h1>
                <p class="brand-desc">Learning, administration and communication. One connected school community.</p>

                <a href="#" class="contact-btn">Contact your school <i class="fa-solid fa-arrow-up-right-from-square ms-1"></i></a>
            </div>

            <div class="brand-footer">
                <p class="tagline">Managing school, made simple.</p>
                <p class="powered">Powered by V3M Technologies</p>
            </div>
        </div>

    </div>
</section>

<CustomAlert @ref="customAlert" Title="Alert" />

