@page "/StudentDashboard"
@using DomainModel.User
@using MyApp.Common
@inject Shared.IHttpService httpService
@inject ProtectedSessionStorage sessionStorage
@rendermode InteractiveServer

<style>
    .sd {
        --sd-primary: #2563eb;
        --sd-indigo: #4f46e5;
        --sd-border: #e8edf3;
        --sd-text: #1f2937;
        --sd-muted: #6b7280;
        color: var(--sd-text);
    }

    /* ---------- hero ---------- */
    .sd-hero {
        position: relative;
        overflow: hidden;
        border-radius: 16px;
        padding: 26px 28px;
        background: linear-gradient(120deg, #1e3a8a 0%, #2563eb 55%, #4f46e5 100%);
        color: #fff;
        box-shadow: 0 12px 28px -18px rgba(37, 99, 235, .45);
    }

        .sd-hero::before,
        .sd-hero::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            background: rgba(255, 255, 255, .08);
            pointer-events: none;
        }

        .sd-hero::before {
            width: 260px;
            height: 260px;
            right: -70px;
            top: -110px;
        }

        .sd-hero::after {
            width: 170px;
            height: 170px;
            right: 170px;
            bottom: -110px;
        }

    .sd-hero-inner {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 24px;
        flex-wrap: wrap;
    }

    .sd-photo-wrap {
        position: relative;
        flex-shrink: 0;
    }

    .sd-photo,
    .sd-initials {
        width: 116px;
        height: 116px;
        border-radius: 50%;
        border: 4px solid rgba(255, 255, 255, .9);
        box-shadow: 0 10px 26px -10px rgba(0, 0, 0, .55);
        background: #fff;
    }

    .sd-photo {
        object-fit: cover;
        display: block;
    }

    .sd-initials {
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 38px;
        font-weight: 800;
        color: var(--sd-primary);
        background: linear-gradient(135deg, #eff6ff, #e0e7ff);
    }

    .sd-status-dot {
        position: absolute;
        right: 8px;
        bottom: 8px;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        border: 3px solid #fff;
        background: #22c55e;
    }

        .sd-status-dot.off {
            background: #ef4444;
        }

    .sd-hero-text {
        flex: 1 1 280px;
        min-width: 0;
    }

    .sd-welcome {
        font-size: 13px;
        letter-spacing: .5px;
        text-transform: uppercase;
        opacity: .85;
        margin-bottom: 2px;
    }

    .sd-name {
        font-size: 28px;
        font-weight: 800;
        line-height: 1.15;
        margin: 0 0 6px;
        word-break: break-word;
    }

    .sd-sub {
        font-size: 15px;
        opacity: .92;
        margin-bottom: 12px;
    }

    .sd-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .sd-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 999px;
        font-size: 12.5px;
        font-weight: 600;
        background: rgba(255, 255, 255, .16);
        border: 1px solid rgba(255, 255, 255, .25);
        backdrop-filter: blur(4px);
        white-space: nowrap;
    }

        .sd-chip.ok {
            background: rgba(34, 197, 94, .25);
            border-color: rgba(134, 239, 172, .6);
        }

        .sd-chip.bad {
            background: rgba(239, 68, 68, .25);
            border-color: rgba(252, 165, 165, .6);
        }

    .sd-hero-side {
        text-align: right;
        flex: 0 0 auto;
    }

    .sd-school {
        font-size: 16px;
        font-weight: 700;
    }

    .sd-date {
        font-size: 13px;
        opacity: .85;
        margin-top: 4px;
    }

    /* ---------- info cards ---------- */
    .sd-card {
        background: #fff;
        border: 1px solid var(--sd-border);
        border-radius: 14px;
        padding: 20px;
        height: 100%;
        box-shadow: 0 2px 8px rgba(15, 23, 42, .04);
    }

    .sd-card-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 16px;
        color: #0f172a;
    }

        .sd-card-title .ic {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 15px;
            background: linear-gradient(135deg, var(--c1, #2563eb), var(--c2, #60a5fa));
            box-shadow: 0 5px 12px -6px color-mix(in srgb, var(--c1, #2563eb) 35%, transparent);
        }

    .sd-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px 18px;
    }

    .sd-item .k {
        font-size: 11.5px;
        font-weight: 600;
        letter-spacing: .4px;
        text-transform: uppercase;
        color: var(--sd-muted);
        margin-bottom: 2px;
    }

    .sd-item .v {
        font-size: 14.5px;
        font-weight: 600;
        color: var(--sd-text);
        word-break: break-word;
    }

    .sd-item.full {
        grid-column: 1 / -1;
    }

    .sd-empty {
        color: #9ca3af;
        font-weight: 500;
    }

    /* parents */
    .sd-parent {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px;
        border-radius: 12px;
        border: 1px solid var(--sd-border);
        border-left: 3px solid var(--c1, #2563eb);
        background: linear-gradient(135deg, #fff 0%, var(--tint, #eff6ff) 100%);
    }

        .sd-parent + .sd-parent {
            margin-top: 12px;
        }

    .sd-parent-photo,
    .sd-parent-initials {
        width: 54px;
        height: 54px;
        border-radius: 50%;
        flex-shrink: 0;
        border: 2px solid #fff;
        box-shadow: 0 4px 10px -6px rgba(0, 0, 0, .25);
    }

    .sd-parent-photo {
        object-fit: cover;
    }

    .sd-parent-initials {
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        color: #fff;
        background: linear-gradient(135deg, var(--c1, #2563eb), var(--c2, #60a5fa));
    }

    .sd-parent .role {
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: .4px;
        text-transform: uppercase;
        color: var(--c1, #2563eb);
    }

    .sd-parent .nm {
        font-size: 15px;
        font-weight: 700;
    }

    .sd-parent .ct {
        font-size: 13px;
        color: var(--sd-muted);
        word-break: break-word;
    }

        .sd-parent .ct i {
            width: 16px;
        }

    .tone-blue { --c1: #2563eb; --c2: #60a5fa; --tint: #eff6ff; }
    .tone-pink { --c1: #db2777; --c2: #f472b6; --tint: #fdf2f8; }
    .tone-green { --c1: #059669; --c2: #34d399; --tint: #ecfdf5; }
    .tone-orange { --c1: #ea580c; --c2: #fb923c; --tint: #fff7ed; }
    .tone-purple { --c1: #7c3aed; --c2: #a78bfa; --tint: #f5f3ff; }
    .tone-teal { --c1: #0d9488; --c2: #2dd4bf; --tint: #f0fdfa; }

    /* states */
    .sd-state {
        text-align: center;
        padding: 60px 20px;
    }

        .sd-state i {
            font-size: 46px;
            color: #94a3b8;
        }

    .sd-skel {
        border-radius: 14px;
        background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 37%, #f1f5f9 63%);
        background-size: 400% 100%;
        animation: sdShimmer 1.3s ease infinite;
    }

    @@keyframes sdShimmer {
        0% { background-position: 100% 50%; }
        100% { background-position: 0 50%; }
    }

    @@media (max-width: 768px) {
        .sd-hero { padding: 20px; }
        .sd-hero-inner { justify-content: center; text-align: center; }
        .sd-chips { justify-content: center; }
        .sd-hero-side { text-align: center; flex-basis: 100%; }
        .sd-name { font-size: 23px; }
        .sd-list { grid-template-columns: 1fr; }
    }

    html.dark-mode .sd-card,
    html.dark-mode .sd-parent {
        background: rgba(255, 255, 255, .04);
        border-color: rgba(255, 255, 255, .08);
    }

    html.dark-mode .sd-card-title,
    html.dark-mode .sd-item .v,
    html.dark-mode .sd-parent .nm {
        color: #f1f5f9;
    }
</style>

<section class="main-container">
    <div class="row m-0 main-row">
        <div class="content sd">
            @if (IsLoading)
            {
                <div class="sd-skel mb-3" style="height:170px"></div>
                <div class="row g-3 mb-3">
                    @for (var i = 0; i < 4; i++)
                    {
                        <div class="col-12 col-md-6 col-xl-3"><div class="sd-skel" style="height:96px"></div></div>
                    }
                </div>
                <div class="row g-3">
                    <div class="col-12 col-xl-5"><div class="sd-skel" style="height:300px"></div></div>
                    <div class="col-12 col-xl-7"><div class="sd-skel" style="height:300px"></div></div>
                </div>
            }
            else if (student == null)
            {
                <div class="sd-card sd-state">
                    <i class="fas fa-user-graduate mb-3"></i>
                    <h5 class="fw-bold mb-2">Student details are not available</h5>
                    <p class="text-muted mb-3">@ErrorMessage</p>
                    <button type="button" class="table-btn" @onclick="LoadDashboard"><i class="fas fa-rotate-right me-1"></i> Try again</button>
                </div>
            }
            else
            {
                @* ---------- hero: photo + name + key ids ---------- *@
                <div class="sd-hero mb-3 dash-animate" style="--d:.03s">
                    <div class="sd-hero-inner">
                        <div class="sd-photo-wrap">
                            @if (!string.IsNullOrWhiteSpace(student.ImagePath))
                            {
                                <img class="sd-photo" src="@student.ImagePath" alt="@student.StudentName"
                                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                <div class="sd-initials" style="display:none">@Initials(student.StudentName)</div>
                            }
                            else
                            {
                                <div class="sd-initials">@Initials(student.StudentName)</div>
                            }
                            <span class="sd-status-dot @(student.IsActive ? "" : "off")" title="@(student.IsActive ? "Active" : "Inactive")"></span>
                        </div>

                        <div class="sd-hero-text">
                            <div class="sd-welcome">@Greeting, welcome back</div>
                            <h2 class="sd-name">@Show(student.StudentName)</h2>
                            <div class="sd-sub">
                                <i class="fas fa-graduation-cap me-1"></i> Class @ClassSection
                                @if (!string.IsNullOrWhiteSpace(student.SessionName))
                                {
                                    <span class="mx-2">·</span>

                                    <span>Session @student.SessionName</span>
                                }
                            </div>
                            <div class="sd-chips">
                                <span class="sd-chip"><i class="fas fa-id-card"></i> Adm. No: @Show(student.AdmissionNo)</span>
                                <span class="sd-chip"><i class="fas fa-hashtag"></i> Student No: @Show(student.StudentNo)</span>
                                @if (student.RollNo.HasValue)
                                {
                                    <span class="sd-chip"><i class="fas fa-list-ol"></i> Roll No: @student.RollNo</span>
                                }
                                <span class="sd-chip @(student.IsActive ? "ok" : "bad")">
                                    <i class="fas @(student.IsActive ? "fa-circle-check" : "fa-circle-xmark")"></i> @(student.IsActive ? "Active" : "Inactive")
                                </span>
                            </div>
                        </div>

                        <div class="sd-hero-side">
                            <div class="sd-school"><i class="fas fa-school me-1"></i> @Show(student.BranchName)</div>
                            <div class="sd-date"><i class="far fa-calendar me-1"></i> @DateTime.Today.ToString("dddd, dd MMM yyyy")</div>
                        </div>
                    </div>
                </div>

                @* ---------- quick facts (same coloured cards as the other dashboards) ---------- *@
                <div class="row g-3 mb-3 dash-tint-stats">
                    <div class="col-12 col-md-6 col-xl-3 dash-animate" style="--d:.1s">
                        <div class="stat-card tint-blue p-3 bg-white h-100">
                            <div class="state-icon--bxds">
                                <div class="stat-icon blue"><i class="fas fa-chalkboard-user"></i></div>
                                <div class="flex-grow-1">
                                    <div class="stat-label text-nowrap text-muted small">Class &amp; section</div>
                                    <div class="stat-value fw-bold fs-4">@ClassSection</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-xl-3 dash-animate" style="--d:.17s">
                        <div class="stat-card tint-purple p-3 bg-white h-100">
                            <div class="state-icon--bxds">
                                <div class="stat-icon purple"><i class="fas fa-calendar-check"></i></div>
                                <div class="flex-grow-1">
                                    <div class="stat-label text-nowrap text-muted small">Admission date</div>
                                    <div class="stat-value fw-bold fs-5">@ShowDate(student.AdmissionDate)</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-xl-3 dash-animate" style="--d:.24s">
                        <div class="stat-card tint-green p-3 bg-white h-100">
                            <div class="state-icon--bxds">
                                <div class="stat-icon green"><i class="fas fa-cake-candles"></i></div>
                                <div class="flex-grow-1">
                                    <div class="stat-label text-nowrap text-muted small">Age</div>
                                    <div class="stat-value fw-bold fs-4">@AgeText</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-xl-3 dash-animate" style="--d:.31s">
                        <div class="stat-card tint-orange p-3 bg-white h-100">
                            <div class="state-icon--bxds">
                                <div class="stat-icon orange"><i class="fas @(string.IsNullOrWhiteSpace(student.HouseName) ? "fa-bus" : "fa-flag")"></i></div>
                                <div class="flex-grow-1">
                                    @if (!string.IsNullOrWhiteSpace(student.HouseName))
                                    {
                                        <div class="stat-label text-nowrap text-muted small">House</div>
                                        <div class="stat-value fw-bold fs-4">@student.HouseName</div>
                                    }
                                    else
                                    {
                                        <div class="stat-label text-nowrap text-muted small">Transport</div>
                                        <div class="stat-value fw-bold fs-5">@(HasRoute ? "Availing" : "Not availing")</div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    @* ---------- personal details ---------- *@
                    <div class="col-12 col-xl-6 dash-animate" style="--d:.38s">
                        <div class="sd-card tone-blue">
                            <div class="sd-card-title"><span class="ic"><i class="fas fa-user"></i></span> Personal details</div>
                            <div class="sd-list">
                                <div class="sd-item"><div class="k">Full name</div><div class="v">@Show(student.StudentName)</div></div>
                                <div class="sd-item"><div class="k">Gender</div><div class="v">@Show(student.Gender)</div></div>
                                <div class="sd-item"><div class="k">Date of birth</div><div class="v">@ShowDate(student.DateOfBirth)</div></div>
                                <div class="sd-item"><div class="k">Blood group</div><div class="v">@Show(student.BloodGroup)</div></div>
                                <div class="sd-item"><div class="k">Category</div><div class="v">@Show(student.CategoryName)</div></div>
                                <div class="sd-item"><div class="k">Religion</div><div class="v">@Show(student.ReligionName)</div></div>
                                <div class="sd-item"><div class="k">APAAR ID</div><div class="v">@Show(student.ApaarId)</div></div>
                                <div class="sd-item"><div class="k">PEN No</div><div class="v">@Show(student.PenNo)</div></div>
                                <div class="sd-item"><div class="k">Mobile</div><div class="v">@Show(student.StudentMobile)</div></div>
                                <div class="sd-item"><div class="k">Email</div><div class="v">@Show(student.StudentEmail)</div></div>
                            </div>
                        </div>
                    </div>

                    @* ---------- academic details ---------- *@
                    <div class="col-12 col-xl-6 dash-animate" style="--d:.45s">
                        <div class="sd-card tone-purple">
                            <div class="sd-card-title"><span class="ic"><i class="fas fa-book-open"></i></span> Academic details</div>
                            <div class="sd-list">
                                <div class="sd-item"><div class="k">School</div><div class="v">@Show(student.BranchName)</div></div>
                                <div class="sd-item"><div class="k">Session</div><div class="v">@Show(student.SessionName)</div></div>
                                <div class="sd-item"><div class="k">Class</div><div class="v">@Show(student.ClassName)</div></div>
                                <div class="sd-item"><div class="k">Section</div><div class="v">@Show(student.SectionName)</div></div>
                                <div class="sd-item"><div class="k">Admission no</div><div class="v">@Show(student.AdmissionNo)</div></div>
                                <div class="sd-item"><div class="k">Student no</div><div class="v">@Show(student.StudentNo)</div></div>
                                <div class="sd-item"><div class="k">Roll no</div><div class="v">@(student.RollNo?.ToString() ?? "—")</div></div>
                                <div class="sd-item"><div class="k">House</div><div class="v">@Show(student.HouseName)</div></div>
                                <div class="sd-item"><div class="k">Admission date</div><div class="v">@ShowDate(student.AdmissionDate)</div></div>
                                <div class="sd-item"><div class="k">Status</div><div class="v" style="color:@(student.IsActive ? "#059669" : "#e11d48")">@(student.IsActive ? "Active" : "Inactive")</div></div>
                            </div>
                        </div>
                    </div>

                    @* ---------- parents ---------- *@
                    <div class="col-12 col-xl-6 dash-animate" style="--d:.52s">
                        <div class="sd-card tone-green">
                            <div class="sd-card-title"><span class="ic"><i class="fas fa-people-roof"></i></span> Parents</div>

                            <div class="sd-parent tone-blue">
                                @ParentPhoto(student.FatherImagePath, student.FatherName)
                                <div style="min-width:0">
                                    <div class="role">Father</div>
                                    <div class="nm">@Show(student.FatherName)</div>
                                    <div class="ct"><i class="fas fa-phone"></i> @Show(student.FatherContactNo)</div>
                                    @if (!string.IsNullOrWhiteSpace(student.FatherEmail))
                                    {
                                        <div class="ct"><i class="fas fa-envelope"></i> @student.FatherEmail</div>
                                    }
                                </div>
                            </div>

                            <div class="sd-parent tone-pink">
                                @ParentPhoto(student.MotherImagePath, student.MotherName)
                                <div style="min-width:0">
                                    <div class="role">Mother</div>
                                    <div class="nm">@Show(student.MotherName)</div>
                                    <div class="ct"><i class="fas fa-phone"></i> @Show(student.MotherContactNo)</div>
                                    @if (!string.IsNullOrWhiteSpace(student.MotherEmail))
                                    {
                                        <div class="ct"><i class="fas fa-envelope"></i> @student.MotherEmail</div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    @* ---------- address, emergency & transport ---------- *@
                    <div class="col-12 col-xl-6 dash-animate" style="--d:.59s">
                        <div class="sd-card tone-orange">
                            <div class="sd-card-title"><span class="ic"><i class="fas fa-location-dot"></i></span> Address &amp; contact</div>
                            <div class="sd-list">
                                <div class="sd-item full"><div class="k">Address</div><div class="v">@AddressText</div></div>
                                <div class="sd-item"><div class="k">Emergency contact</div><div class="v">@EmergencyText</div></div>
                                <div class="sd-item"><div class="k">Emergency phone</div><div class="v">@Show(student.EmergencyPersonContactNo)</div></div>
                                <div class="sd-item full"><div class="k">Transport route</div><div class="v">@(HasRoute ? student.RouteName : "Not availing transport")</div></div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private StudentDashboardProfile? student;
    private bool IsLoading = true;
    private string ErrorMessage = "";

    // userId saved in session at login is posted to api/StudentDashboard; the API checks it against the login token
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await LoadDashboard();
    }

    private async Task LoadDashboard()
    {
        IsLoading = true;
        ErrorMessage = "";
        StateHasChanged();
        try
        {
            var userIdResult = await sessionStorage.GetAsync<int>("userId");
            if (!userIdResult.Success || userIdResult.Value <= 0)
            {
                student = null;
                ErrorMessage = "Your session has expired. Please log in again.";
                return;
            }

            var response = await httpService.Post<ApiResponse<StudentDashboardProfile>>("StudentDashboard",
                new StudentDashboardRequest { UserId = userIdResult.Value });
            student = response != null && response.Success ? response.Data : null;
            if (student == null)
                ErrorMessage = string.IsNullOrWhiteSpace(response?.Message)
                    ? "Your student record could not be loaded. Please contact the school office."
                    : response!.Message!;
        }
        catch (Exception)
        {
            student = null;
            ErrorMessage = "Your student record could not be loaded. Please try again.";
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private string Greeting => DateTime.Now.Hour switch
    {
        < 12 => "Good morning",
        < 17 => "Good afternoon",
        _ => "Good evening"
    };

    private string ClassSection
    {
        get
        {
            if (student == null || string.IsNullOrWhiteSpace(student.ClassName))
                return "—";
            return string.IsNullOrWhiteSpace(student.SectionName)
                ? student.ClassName!
                : $"{student.ClassName} - {student.SectionName}";
        }
    }

    private string AgeText
    {
        get
        {
            if (student?.DateOfBirth == null)
                return "—";
            var dob = student.DateOfBirth.Value.Date;
            var today = DateTime.Today;
            if (dob > today)
                return "—";
            var years = today.Year - dob.Year;
            if (dob > today.AddYears(-years)) years--;
            return $"{years} yrs";
        }
    }

    private bool HasRoute => !string.IsNullOrWhiteSpace(student?.RouteName);

    private string AddressText
    {
        get
        {
            if (student == null) return "—";
            var parts = new[] { student.AddressLine1, student.AddressLine2, student.DistrictName, student.StateName }
                .Where(p => !string.IsNullOrWhiteSpace(p))
                .Select(p => p!.Trim())
                .ToList();
            var text = string.Join(", ", parts);
            if (!string.IsNullOrWhiteSpace(student.PinCode))
                text = string.IsNullOrEmpty(text) ? student.PinCode! : $"{text} - {student.PinCode}";
            return string.IsNullOrWhiteSpace(text) ? "—" : text;
        }
    }

    private string EmergencyText
    {
        get
        {
            if (student == null || string.IsNullOrWhiteSpace(student.EmergencyPersonName))
                return "—";
            return string.IsNullOrWhiteSpace(student.EmergencyPersonRelationShip)
                ? student.EmergencyPersonName!.Trim()
                : $"{student.EmergencyPersonName!.Trim()} ({student.EmergencyPersonRelationShip})";
        }
    }

    private static string Show(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value.Trim();

    private static string ShowDate(DateTime? value) =>
        value.HasValue && value.Value.Year > 1900 ? value.Value.ToString("dd MMM yyyy") : "—";

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}".ToUpper()
            : parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
    }

    // parent photo, or coloured initials when there is no photo / it fails to load
    private RenderFragment ParentPhoto(string? path, string? name) =>
        @<text>
            @if (!string.IsNullOrWhiteSpace(path))
            {
                <img class="sd-parent-photo" src="@path" alt="@name"
                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                <div class="sd-parent-initials" style="display:none">@Initials(name)</div>
            }
            else
            {
                <div class="sd-parent-initials">@Initials(name)</div>
            }
        </text>;
}
