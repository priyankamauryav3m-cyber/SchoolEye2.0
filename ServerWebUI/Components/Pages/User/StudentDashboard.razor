    private async void SearchRegistrationListToday(bool isCheckedDate)
    {

        if (isCheckedDate)
        {
            fromDateString = fromDate == DateTime.MinValue ? DateTime.Now.ToString("yyyy/MM/dd") : fromDate.ToString("yyyy/MM/dd");
            toDateString = toDate == DateTime.MinValue ? DateTime.Now.ToString("yyyy/MM/dd") : toDate.ToString("yyyy/MM/dd");
        }
        else
        {
            fromDateString = DateTime.Now.ToString("yyyy/MM/dd");
            toDateString = DateTime.Now.ToString("yyyy/MM/dd");
        }
        DurationEnrollmentType = "Today";
        await GetRegistrationList(areaId, inputvalofMedicalNo, inputValueofPhoneNo, inputValOfPatientname, isCheckedDate, fromDateString, toDateString);

        StateHasChanged();
    }

    private async void SearchRegistrationListMonth(bool isCheckedDate)
    {
        if (isCheckedDate)
        {
            fromDateString = new DateTime(fromDate.Year, fromDate.Month, 1).ToString("yyyy/MM/dd");
            toDateString = toDate.ToString("yyyy/MM/dd");
        }
        else
        {
            fromDateString = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).ToString("yyyy/MM/dd");
            toDateString = DateTime.Now.ToString("yyyy/MM/dd");
        }
        DurationEnrollmentType = "Month";
        await GetRegistrationList(areaId, inputvalofMedicalNo, inputValueofPhoneNo, inputValOfPatientname, isCheckedDate, fromDateString, toDateString);

        StateHasChanged();




    }
    private async void SearchRegistrationListYear(bool isCheckedDate)
