@page "/forgotpassword"
@layout LoginLayout
@using ServerWebUI.Components.Layout
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@using DomainModel.User
@using MyApp.Common
@rendermode InteractiveServer
@inject Shared.IHttpService httpService
@inject SweetAlertService Alert
@inject IJSRuntime JS

<section class="reset-section">
    <div class="reset-card">
        <div class="school-logo-wrap">
            <img src="/images/school-logo.png" alt="School Logo" class="school-logo-img" />
        </div>

        <div class="icon-badge"><i class="fa-solid fa-key"></i></div>
        <h2 class="reset-title">Forgot password</h2>

        @if (IsLinkSent)
        {
            @* same message for every username / email, so nobody can tell what is registered *@
            <p class="reset-sub">Email sent. Please check your inbox (and spam folder).</p>
            <button type="button" class="btn-reset" @onclick="SendAgain">Send again</button>
        }
        else
        {
            <p class="reset-sub">Enter your username or email and we'll send you a link to get back into your account.</p>

            <EditForm Model="@request" OnValidSubmit="SendLink">
                <DataAnnotationsValidator />
                <div class="field-block">
                    <div class="input-with-icon">
                        <i class="fa-solid fa-user"></i>
                        <InputText class="field-input" placeholder="Username or email" maxlength="100" autocomplete="off"
                                   @bind-Value="request.UsernameOrEmail" disabled="@IsLoading" />
                    </div>
                    <ValidationMessage For="@(() => request.UsernameOrEmail)" class="field-error" />
                </div>

                <button class="btn-reset" type="submit" disabled="@IsLoading">
                    @if (IsLoading)
                    {
                        <span class="loading-text-container"><span class="loader-spinner"></span> Sending...</span>
                    }
                    else
                    {
                        <span>Send reset link <i class="fa-solid fa-paper-plane ms-1"></i></span>
                    }
                </button>
            </EditForm>
        }

        <div class="back-row">
            <a href="/" class="link-txt"><i class="fa-solid fa-arrow-left me-1"></i> Back to sign in</a>
        </div>
    </div>
</section>

<link rel="stylesheet" href="css/password-reset.css" />

@code {
    private ForgotPasswordRequest request = new();
    private bool IsLoading;
    private bool IsLinkSent;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // when the password is reset from the mail link (another tab), this tab closes / goes to sign in.
        // optional: a missing / cached-old script must not break the page (an unhandled error here
        // ends the circuit and the form then posts as a plain HTTP form)
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("passwordReset.closeOnReset");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"passwordReset.closeOnReset: {ex.Message}");
            }
        }
    }

    private async Task SendLink()
    {
        if (IsLoading) return;
        IsLoading = true;
        try
        {
            request.UsernameOrEmail = request.UsernameOrEmail?.Trim();
            // the API answers the same whether or not the username / email is registered
            var response = await httpService.Post<ApiResponse<string>>("users/ForgotPassword", request);
            if (response != null && response.Success)
                IsLinkSent = true;
            else
                await Alert.ShowWarning(response?.Message ?? "Unable to send the reset link. Please try again.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Forgot password: {ex.Message}");
            await Alert.ShowWarning("Unable to send the reset link. Please try again.");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void SendAgain()
    {
        request = new();
        IsLinkSent = false;
    }
}
