@page "/AdmissionHead"
@using ApexCharts
@using DomainModel
@using DomainModel.Common
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.Extensions.Localization
@using MyApp.Common
@inject NavigationManager Navigation
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime jsRuntime
@rendermode InteractiveServer
@using Newtonsoft.Json
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedSessionStorage sessionStorage
@using System.Text
@inject IWebHostEnvironment env
@inject Shared.IHttpService httpService
@using System.Text.RegularExpressions;
@using ServerWebUI.Components.AlertComponent
@using ServerWebUI.Components.Pages.CommonPages
@inject IStringLocalizer<Resource> Localizer
@inject IJSRuntime JS
@inject CommonMethod EnquiryState
<style>
    /* ---------- shared classes (same convention as Enquiry Dashboard) ---------- */
    .dashboard-card {
        background: #ffffff;
        border-radius: 12px;
        padding: 16px 18px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.03);
        border: 1px solid #f1f5f9;
        height: 100%;
    }

    .card-header-custom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }

    .card-title-custom {
        font-size: 1rem;
        font-weight: 700;
        color: #1e293b;
    }

    .state-icon--bxds {
        gap: 12px;
        display: flex;
        align-items: center;
    }

    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .stat-icon.blue {
            background-color: #c8dcf6;
            color: #3b82f6;
        }

        .stat-icon.orange {
            background-color: #f1e0c5;
            color: #f97316;
        }

        .stat-icon.green {
            background-color: #d6f6e7;
            color: #10b981;
        }

        .stat-icon.red {
            background-color: #FDE9ED;
            color: #ef4444;
        }

        .stat-icon.purple {
            background-color: #ddc2f9;
            color: #a855f7;
        }

    .stat-change {
        padding-top: 10px;
        padding-left: 35px;
    }

    .mini-stat-card {
        border-radius: 10px;
        padding: 15px;
        border: 1px solid #f1f5f9;
        height: 100%;
    }

        .mini-stat-card.mini-stat-blue {
            background-color: #d7e7f9;
        }

        .mini-stat-card.mini-stat-green {
            background-color: #b3f6c8;
        }

        .mini-stat-card.mini-stat-yellow {
            background-color: #f9f3dd;
        }

        .mini-stat-card.mini-stat-purple {
            background-color: #eadef6;
        }

    .custom-table th, .custom-table td {
        font-size: 0.85rem;
        padding: 8px 12px;
    }

    .progress-bar-custom {
        height: 5px;
    }

    /* ---------- Admission Pipeline ---------- */
    .stage-icon {
        width: 40px;
        height: 40px;
        font-size: 15px;
    }

    .pipeline {
        padding-bottom: 6px;
    }

    .info-strip {
        padding: 8px 12px;
        margin-top: 8px;
    }

    /* ---------- Student Status donut (single source of truth — compact size) ---------- */
    .status-donut-wrap {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        justify-content: center;
    }

    .status-donut {
        width: 130px;
        height: 130px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: conic-gradient(#22c55e 0% 96.3%, #f97316 96.3% 97.9%, #ef4444 97.9% 100%);
    }

    .status-donut-inner {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: #fff;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

        .status-donut-inner strong {
            font-size: 1.05rem;
            color: #1e293b;
        }

        .status-donut-inner span {
            font-size: .68rem;
            color: #64748b;
        }

    .status-legend {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

        .status-legend li {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: .8rem;
            color: #334155;
        }

    .legend-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        display: inline-block;
    }

        .legend-dot.green {
            background: #22c55e;
        }

        .legend-dot.orange {
            background: #f97316;
        }

        .legend-dot.red {
            background: #ef4444;
        }

    .status-badge {
        font-size: .72rem;
        font-weight: 600;
        padding: 2px 10px;
        border-radius: 99px;
        background: #ecfdf5;
        color: #16a34a;
    }
</style>

<section class="main-container">

    <div class="row m-0 main-row">
        <div class="content">

            <div class="row g-3 mb-3 ">
                <div class="col-12">
                    <div class="page-heading d-flex align-items-center justify-content-between">
                        <p class="m-0 page-name px-1">@DashboardName Dashboard</p>
                        <div class="d-flex align-items-center gap-2">
                            <div class="form-box">
                                <InputSelect @bind-Value="@CurrentSession" class="form-input">
                                    <option value="0">-- Select Session --</option>
                                    @foreach (var data in sessionlist.Where(x => x.IsValid == true))
                                    {
                                        <option value="@data.SessionId">@data.SessionName</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-12 col-md-6 col-xl-3">
                    <div class="stat-card p-3 bg-white h-100 d-flex flex-column justify-content-center" style="cursor:pointer;" @onclick="AdmitStudentDirect">
                        <div class="row">
                            <div class="col-12">
                                <div class="state-icon--bxds">
                                    <div class="stat-icon blue"><i class="fas fa-plus"></i></div>
                                    <div class="flex-grow-1">
                                        <div class="stat-label text-nowrap text-muted small">New Admission</div>
                                        <div class="stat-value fw-bold fs-6">Add a new student</div>
                                    </div>
                                </div>
                                <div class="stat-change" style="visibility:hidden;">
                                    <i class="fas fa-arrow-up"></i> spacer
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <div class="stat-card p-3 bg-white" style="cursor:pointer;" @onclick='() => GoToEnquiry("TotalEnquiry")'>
                        <div class="row">
                            <div class="col-12">
                                <div class="state-icon--bxds">
                                    <div class="stat-icon blue"><i class="fas fa-comment-dots"></i></div>
                                    <div class="flex-grow-1">
                                        <div class="stat-label text-nowrap text-muted small">Total Enquiry</div>
                                        <div class="stat-value fw-bold fs-4">@admissionDashboardpipeline.TotalEnquiry</div>
                                    </div>
                                </div>
                                <div class="stat-change"><i class="fas fa-arrow-up"></i> @admissionDashboardpipeline.EnquiryPercentage</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <div class="stat-card p-3 bg-white">
                        <div class="row">
                            <div class="col-12">
                                <div class="state-icon--bxds" style="cursor:pointer;" @onclick='() => GoToEnquiry("TotalRegistration")'>
                                    <div class="stat-icon orange"><i class="fas fa-file-alt"></i></div>
                                    <div class="flex-grow-1">
                                        <div class="stat-label text-nowrap text-muted small">Total Registration</div>
                                        <div class="stat-value fw-bold fs-4">@admissionDashboardpipeline.TotalRegistration</div>
                                    </div>
                                </div>
                                <div class="stat-change"><i class="fas fa-arrow-up"></i> @admissionDashboardpipeline.RegistrationPercentage</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <div class="stat-card p-3 bg-white" style="cursor:pointer;" @onclick='() => GoToEnquiry("TotalAdmission")'>
                        <div class="row">
                            <div class="col-12">
                                <div class="state-icon--bxds">
                                    <div class="stat-icon red"><i class="fas fa-user-graduate"></i></div>
                                    <div class="flex-grow-1">
                                        <div class="stat-label text-nowrap text-muted small">Total Admission</div>
                                        <div class="stat-value fw-bold fs-4">@admissionDashboardpipeline.TotalAdmission</div>
                                    </div>
                                </div>
                                <div class="stat-change"><i class="fas fa-arrow-up"></i> @admissionDashboardpipeline.AdmissionPercentage</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-12 col-lg-6">
                    <div class="dashboard-card card-custom-mn-hg">
                        <div class="card-header-custom">
                            <div class="card-title-custom">Admission Pipeline</div>
                            <i class="fas fa-info-circle" style="color:#94a3b8; cursor:pointer;"
                               title="Track admission conversion"></i>
                        </div>
                        <div class="pipeline">
                            <div class="stage">
                                <div class="stage-icon c1"><i class="fas fa-comment-dots"></i></div>
                                <div>
                                    <div class="stage-name">Enquiry</div>
                                    <div class="stage-count">@admissionDashboardpipeline.TotalEnquiry</div>
                                    <div class="stage-pct">@admissionDashboardpipeline.EnquiryPercentage</div>
                                    <div class="stage-bar b1"><span style="width:@(admissionDashboardpipeline.EnquiryPercentage)"></span></div>
                                </div>
                            </div>
                            <div class="stage">
                                <div class="stage-icon c2"><i class="fas fa-file-alt"></i></div>
                                <div>
                                    <div class="stage-name">Registration</div>
                                    <div class="stage-count">@admissionDashboardpipeline.TotalRegistration</div>
                                    <div class="stage-pct">@admissionDashboardpipeline.RegistrationPercentage</div>
                                    <div class="stage-bar b2"> <span style="width:@admissionDashboardpipeline.RegistrationPercentage;"></span></div>
                                </div>
                            </div>

                            <div class="stage">
                                <div class="stage-icon c4"><i class="fas fa-user"></i></div>
                                <div>
                                    <div class="stage-name">Interactions</div>
                                    <div class="stage-count">@admissionDashboardpipeline.InteractionsDone</div>
                                    <div class="stage-pct">@admissionDashboardpipeline.InteractionPercentage</div>
                                    <div class="stage-bar b4"><span data-w="width:@(admissionDashboardpipeline.InteractionPercentage)"></span></div>
                                </div>
                            </div>
                            <div class="stage">
                                <div class="stage-icon c5"><i class="fas fa-shield-alt"></i></div>
                                <div>
                                    <div class="stage-name">Confirmed Admission</div>
                                    <div class="stage-count">@admissionDashboardpipeline.TotalAdmission</div>
                                    <div class="stage-pct">@admissionDashboardpipeline.AdmissionPercentage</div>
                                    <div class="stage-bar b5">  <span style="width:@(admissionDashboardpipeline.AdmissionPercentage)"></span></div>
                                </div>
                            </div>
                        </div>
                        <div class="info-strip">
                            <div class="txt">
                                <i class="fas fa-info-circle"></i> <strong>20.1%</strong> of enquiries have been
                                converted into confirmed admissions.
                            </div>
                            <a href="#">View full pipeline →</a>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6">
                    <div class="dashboard-card h-100">
                        <h6 class="card-title-custom mb-3">Attendance & Movement</h6>
                        <div class="row g-3">
                            <div class="col-6">
                                <div class="mini-stat-card mini-stat-blue d-flex align-items-center">
                                    <div class="stat-icon blue me-2"><i class="fas fa-clipboard-user"></i></div>
                                    <span class="text-muted small d-block">Total Attendance</span>
                                    <h5 class="fw-bold fs-4 mb-0 ms-auto">1,724</h5>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="mini-stat-card mini-stat-green d-flex align-items-center">
                                    <div class="stat-icon green me-2"><i class="fas fa-handshake"></i></div>
                                    <span class="text-muted small d-block">Interactions Done</span>
                                    <h5 class="fw-bold fs-4 mb-0 ms-auto">11</h5>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="mini-stat-card mini-stat-yellow d-flex align-items-center">
                                    <div class="stat-icon orange me-2"><i class="fas fa-arrow-down"></i></div>
                                    <span class="text-muted small">Withdrawals</span>
                                    <h5 class="fw-bold fs-4 mb-0 ms-auto">2</h5>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="mini-stat-card mini-stat-purple d-flex align-items-center">
                                    <div class="stat-icon purple me-2"><i class="fas fa-file-export"></i></div>
                                    <span class="text-muted small">Transfer Certificates</span>
                                    <h5 class="fw-bold fs-4 mb-0 ms-auto">3</h5>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="mini-stat-card mini-stat-yellow d-flex align-items-center">
                                    <div class="stat-icon orange me-2"><i class="fas fa-arrow-down"></i></div>
                                    <span class="text-muted small">Withdrawals</span>
                                    <h5 class="fw-bold fs-4 mb-0 ms-auto">2</h5>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="mini-stat-card mini-stat-purple d-flex align-items-center">
                                    <div class="stat-icon purple me-2"><i class="fas fa-file-export"></i></div>
                                    <span class="text-muted small">Transfer Certificates</span>
                                    <h5 class="fw-bold fs-4 mb-0 ms-auto">3</h5>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <div class="row g-3 mb-4">
                <div class="col-12 col-lg-7">
                    <div class="dashboard-card h-100">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h6 class="card-title-custom mb-0">Student Strength & Movement</h6>
                                <span class="text-muted small">Class-group overview for the current session</span>
                            </div>
                            <h4 class="fw-bold mb-0">1,660</h4>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-borderless custom-table mb-0">
                                <thead>
                                    <tr class="text-muted small">
                                        <th>Class Group</th>
                                        <th>Active</th>
                                        <th>New Admissions</th>
                                        <th>Withdrawals</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Pre-Primary</td>
                                        <td>248</td>
                                        <td class="text-success">+21</td>
                                        <td class="text-danger">-7</td>
                                        <td><span class="status-badge">On track</span></td>
                                    </tr>
                                    <tr>
                                        <td>Primary (I–V)</td>
                                        <td>684</td>
                                        <td class="text-success">+54</td>
                                        <td class="text-danger">-13</td>
                                        <td><span class="status-badge">On track</span></td>
                                    </tr>
                                    <tr>
                                        <td>Middle (VI–VIII)</td>
                                        <td>432</td>
                                        <td class="text-success">+31</td>
                                        <td class="text-danger">-9</td>
                                        <td><span class="status-badge">On track</span></td>
                                    </tr>
                                    <tr>
                                        <td>Senior (IX–XII)</td>
                                        <td>296</td>
                                        <td class="text-success">+18</td>
                                        <td class="text-danger">-6</td>
                                        <td><span class="status-badge">On track</span></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-5">
                    <div class="dashboard-card h-100">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="card-title-custom mb-0">Student Status</h6>
                            <span class="text-muted small">Current student distribution</span>
                        </div>
                        <div class="row align-items-center">
                            <div class="col-12 col-md-6 text-center">
                                @{
                                    var statusChartKey = string.Join("|", studentStatusList.Select(x => $"{x.StatusName}:{x.Count}"));
                                }
                                <div class="donut-container" @key="statusChartKey">
                                    @if (studentStatusList.Any())
                                    {
                                        var statusColorOptions = GetDonutOptions<StudentStatusModel>(
                                            studentStatusList.Select(x => GetStatusColor(x.StatusName)).ToList());

                                        <ApexChart TItem="StudentStatusModel"
                                                   Options="statusColorOptions">
                                            <ApexPointSeries TItem="StudentStatusModel"
                                                             Items="studentStatusList"
                                                             Name="Status"
                                                             SeriesType="SeriesType.Donut"
                                                             XValue="x => x.StatusName"
                                                             YValue="x => (decimal)x.Count" />
                                        </ApexChart>
                                    }
                                </div>
                            </div>
                            <div class="col-12 col-md-6 mt-3 mt-md-0">
                                <ul class="status-legend">
                                    @foreach (var item in studentStatusList)
                                    {
                                        <li>
                                            <span class="legend-dot" style="background:@GetStatusColor(item.StatusName)"></span>
                                            @item.StatusName
                                            <strong class="ms-auto">@item.Count</strong>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>
</section>
@if (IsLoading)
{
    <div class="grid-loader-overlay">
        <img src="images/loading.gif" alt="Loading..." />
    </div>
}
else
{

}

<AdmitChild IsVisible="@addstudent" OnClose="@ClosePopup" />
<CustomAlert @ref="customAlert" Title="Alert" />
@code {
    private CustomAlert customAlert;
    private bool addstudent { get; set; }
    private DateTime fromDate = DateTime.Now;
    private DateTime toDate = DateTime.Now;
    private string CurrentDateTime => DateTime.Now.ToString("yyyy/MM/dd, hh:mm tt");
    private bool IsLoading = false;
    string fromDateString = "", toDateString = "";
    private string nameFilter = "";
    private string branchcode = "";
    private string groupcode = "";
    private string UserName = "";
    private string SelectedData = "This Year";
    private long CurrentSession;
    private string DashboardName = "";
    private SearchAnyRequestModel searchAnyRequest = new();
    private AdmissionDashboardModel admissionDashboardpipeline = new();
    private AdminDashboardModal adminDashboard = new();
    private List<SessionModel> sessionlist = new();
    private void RefreshPage()
    {
        Navigation.NavigateTo("/adminDashboard", forceLoad: true);
    }

    private List<StudentStatusModel> studentStatusList => new()
    {
        new StudentStatusModel { StatusName = "Active", Count = admissionDashboardpipeline.ActiveStudentCount },
        new StudentStatusModel { StatusName = "Notice Period", Count = 29 },
        new StudentStatusModel { StatusName = "Withdrawn", Count = 35 }
    };

    public class StudentStatusModel
    {
        public string StatusName { get; set; } = "";
        public int Count { get; set; }
    }
    private void GoToEnquiry(string value)
    {
        if (value == "TotalEnquiry")
        {
            EnquiryState.DashboardValue = "GetEnquiry";
            NavigationManager.NavigateTo("/enquiry");
            StateHasChanged();
        }
        else if (value == "TotalRegistration")
        {
            EnquiryState.DashboardValue = "GetRegistration";
            NavigationManager.NavigateTo("/ViewRegistration");
            StateHasChanged();
        }
        else if (value == "TotalAdmission")
        {
            EnquiryState.DashboardValue = "Admission";
            NavigationManager.NavigateTo("/admitStudent");
            StateHasChanged();
        }
        else if (value == "TodayEnquiery")
        {
            EnquiryState.DashboardValue = "Date";
            NavigationManager.NavigateTo("/enquiry");
            StateHasChanged();
        }
        else if (value == "TodayFollowup")
        {
            EnquiryState.DashboardValue = "Followup";
            NavigationManager.NavigateTo("/enquiry");
            StateHasChanged();
        }
        else if (value == "TodayConversion")
        {
            EnquiryState.DashboardValue = "Conversion";
            NavigationManager.NavigateTo("/ViewApplication");
            StateHasChanged();
        }
        else if (value == "BasedOnSource")
        {
            EnquiryState.DashboardValue = "Source";
            NavigationManager.NavigateTo("/enquiry");
            StateHasChanged();
        }
        // SendDashboardvalue="GetEnquiry";

    }
    private string GetStatusColor(string name) => name switch
    {
        "Active" => "#22c55e",
        "Notice Period" => "#f97316",
        "Withdrawn" => "#ef4444",
        _ => "#6c757d"
    };

    private ApexChartOptions<TItem> GetDonutOptions<TItem>(List<string> orderedColors) where TItem : class => new()
    {
        Chart = new Chart
        {
            Height = "170",
            Width = "170",
            Toolbar = new Toolbar { Show = false }
        },
        Legend = new Legend { Show = false },
        DataLabels = new DataLabels { Enabled = false },
        Colors = orderedColors,
        PlotOptions = new PlotOptions
        {
            Pie = new PlotOptionsPie
            {
                Donut = new PlotOptionsDonut
                {
                    Size = "50%"
                }
            }
        }
    };
    private async Task GetAdmissionPipelineConfirmetion()
    {
        IsLoading = true;
        searchAnyRequest.GroupCode = groupcode;
        searchAnyRequest.BranchCode = branchcode;
        searchAnyRequest.SessionId = CurrentSession;
        var apiResponse = await httpService.Post<ApiResponse<AdmissionDashboardModel>>("AdminDashboard/GetAdmissionDashboardData", searchAnyRequest) ?? new();
        if (apiResponse.Success == true)
        {
            admissionDashboardpipeline = apiResponse.Data ?? new();
            IsLoading = false;
        }
    }
    private async Task LoadData()
    {
        var branchResult = await sessionStorage.GetAsync<string>("BranchCode");
        branchcode = branchResult.Value;
        var groupResult = await sessionStorage.GetAsync<string>("GroupCode");
        groupcode = groupResult.Value;
        var username = await sessionStorage.GetAsync<string>("UserName");
        UserName = username.Value;
        var dashboard = await sessionStorage.GetAsync<string>("RoleName");
        DashboardName = dashboard.Value;
        searchAnyRequest.GroupCode = groupcode;
        searchAnyRequest.BranchCode = branchcode;
        searchAnyRequest.SessionId = CurrentSession;
        string ApiUri1 = "AdminDashboard/GetAdminDashboard";
        sessionlist = await httpService.Get<List<SessionModel>>("Session/GetSession") ?? new();
        var apiResponse = await httpService.Post<ApiResponse<AdminDashboardModal>>(ApiUri1, searchAnyRequest) ?? new();
        if (apiResponse.Success == true)
        {
            adminDashboard = apiResponse.Data ?? new();
        }
        await GetAdmissionPipelineConfirmetion();

  
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {

            CurrentSession = await CommonMethod.SetCurrentSessionData();
            await LoadData();

            StateHasChanged();
        }
    }

    private async Task AdmitStudentDirect()
    {
        addstudent = true;
        StateHasChanged();

    }
    private void ClosePopup()
    {
        addstudent = false;
        StateHasChanged();
    }

}