                        <div class="row align-items-center">
                            <div class="col-12 col-md-6 text-center">
                                @{
                                    var statusChartKey = string.Join("|", studentStatusList.Select(x => $"{x.StatusName}:{x.Count}"));
                                }
                                <div class="donut-container" @key="statusChartKey">
                                    @if (studentStatusList.Any())
                                    {
                                        var statusColorOptions = GetDonutOptions<StudentStatusModel>(
                                            studentStatusList.Select(x => GetStatusColor(x.StatusName)).ToList());

                                        <ApexChart TItem="StudentStatusModel"
                                                   Options="statusColorOptions">
                                            <ApexPointSeries TItem="StudentStatusModel"
                                                             Items="studentStatusList"
                                                             Name="Status"
                                                             SeriesType="SeriesType.Donut"
                                                             XValue="x => x.StatusName"
                                                             YValue="x => (decimal)x.Count" />
                                        </ApexChart>
                                    }
                                </div>
                            </div>
