@page "/FeeManagement"
@using ApexCharts
@using DomainModel.Common
@using DomainModel
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.Extensions.Localization
@using MyApp.Common
@inject NavigationManager Navigation
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime jsRuntime
@rendermode InteractiveServer
@using Newtonsoft.Json
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedSessionStorage sessionStorage
@using System.Text
@inject IWebHostEnvironment env
@inject Shared.IHttpService httpService
@using System.Text.RegularExpressions;
@using ServerWebUI.Components.AlertComponent
@using ServerWebUI.Components.Pages.CommonPages
@inject IStringLocalizer<Resource> Localizer
@inject IJSRuntime JS
@inject CommonMethod EnquiryState
@implements IDisposable
<style>
    .stat-icon.blue {
        background: #eaf3fb !important;
        color: #1e7fb0 !important;
    }

</style>
<section class="main-container">
    <div class="row m-0 main-row">
        <div class="content">
            <div class="row g-3 mb-3 ">
                <div class="col-12" id="main-header">
                    <PageHeading Tittle="@DashboardName">
                        <div class="form-box">
                            <button type="button" class="table-btn @(SelectedPeriod == "Today" ? "active" : "")" @onclick='() => ApplyPeriodFilter("Today")'>
                                Today
                            </button>
                        </div>
                        <div class="form-box">
                            <button type="button" class="table-btn @(SelectedPeriod == "ThisWeek" ? "active" : "")" @onclick='() => ApplyPeriodFilter("ThisWeek")'>
                                This Week
                            </button>
                        </div>
                        <div class="form-box">
                            <button type="button" class="table-btn @(SelectedPeriod == "ThisMonth" ? "active" : "")" @onclick='() => ApplyPeriodFilter("ThisMonth")'>
                                This Month
                            </button>
                        </div>
                        <div class="form-box">
                            <button type="button" class="table-btn @(SelectedPeriod == "ThisYear" ? "active" : "")" @onclick='() => ApplyPeriodFilter("ThisYear")'>
                                This Year
                            </button>
                        </div>
                        <div class="form-box">
                            <InputSelect @bind-Value="@CurrentSession" class="form-input">
                                <option value="0">-- Select Session --</option>
                                @foreach (var data in sessionlist.Where(x => x.IsValid == true))
                                {
                                    <option value="@data.SessionId">@data.SessionName</option>
                                }
                            </InputSelect>
                        </div>
                    </PageHeading>
                </div>
            </div>
            @if (dashAnimator.IsVisible)
            {
                <div class="dash-animated">
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6 col-xl-3 dash-animate" style="--d:.05s">
                            <div class="stat-card p-3 bg-white">
                                <div class="state-icon--bxds">
                                    <div class="stat-icon blue"><i class="fas fa-user-graduate"></i></div>
                                    <div class="flex-grow-1">
                                        <div class="stat-label text-nowrap text-muted small">Total students</div>
                                        <div class="stat-value fw-bold fs-4">@dashAnimator.Count(TotalStudents)</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 col-xl-3 dash-animate" style="--d:.12s">
                            <div class="stat-card p-3 bg-white">
                                <div class="state-icon--bxds">
                                    <div class="stat-icon green"><i class="fas fa-bus"></i></div>
                                    <div class="flex-grow-1">
                                        <div class="stat-label text-nowrap text-muted small">Transport users</div>
                                        <div class="stat-value fw-bold fs-4">@dashAnimator.Count(TransportUsers)</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 col-xl-3 dash-animate" style="--d:.19s">
                            <div class="stat-card p-3 bg-white">
                                <div class="state-icon--bxds">
                                    <div class="stat-icon blue"><i class="fas fa-briefcase"></i></div>
                                    <div class="flex-grow-1">
                                        <div class="stat-label text-nowrap text-muted small">Total staff</div>
                                        <div class="stat-value fw-bold fs-4">@dashAnimator.Count(TotalStaff)</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 col-xl-3 dash-animate" style="--d:.26s">
                            <div class="stat-card p-3 bg-white">
                                <div class="state-icon--bxds">
                                    <div class="stat-icon blue"><i class="fas fa-shield-alt"></i></div>
                                    <div class="flex-grow-1">
                                        <div class="stat-label text-nowrap text-muted small">EWS students</div>
                                        <div class="stat-value fw-bold fs-4">@dashAnimator.Count(EwsStudents)</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-12 dash-animate" style="--d:.34s">
                            <div class="dashboard-card">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="card-title-custom mb-0">
                                        <span class="status-badge me-2">02</span>Fees &amp; balances
                                    </h5>
                                    <span class="text-muted small">All amounts in INR</span>
                                </div>
                                <div class="row g-3">
                                    <div class="col-6 col-md-3">
                                        <div class="text-muted small mb-1">Total fee due</div>
                                        <div class="metric-box metric-blue"><span>₹</span><strong>@dashAnimator.Amount(TotalFeeDue)</strong></div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="text-muted small mb-1">Total concession</div>
                                        <div class="metric-box metric-purple"><span>₹</span><strong>@dashAnimator.Amount(TotalConcession)</strong></div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="text-muted small mb-1">Total waive off</div>
                                        <div class="metric-box metric-orange"><span>₹</span><strong>@dashAnimator.Amount(TotalWaiveOff)</strong></div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="text-muted small mb-1">Late fine</div>
                                        <div class="metric-box metric-red"><span>₹</span><strong>@dashAnimator.Amount(LateFine)</strong></div>
                                    </div>

                                    <div class="col-6 col-md-3">
                                        <div class="text-muted small mb-1">Total received</div>
                                        <div class="metric-box metric-green"><span>₹</span><strong>@dashAnimator.Amount(TotalReceived)</strong></div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="text-muted small mb-1">Total outstanding</div>
                                        <div class="metric-box metric-indigo"><span>₹</span><strong>@dashAnimator.Amount(TotalOutstanding)</strong></div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="text-muted small mb-1">Pre-session advance</div>
                                        <div class="metric-box metric-teal"><span>₹</span><strong>@dashAnimator.Amount(PreSessionAdvance)</strong></div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="text-muted small mb-1">Current advance</div>
                                        <div class="metric-box metric-pink"><span>₹</span><strong>@dashAnimator.Amount(CurrentAdvance)</strong></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-12 col-lg-7 dash-animate" style="--d:.42s">
                            <div class="dashboard-card h-100">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="card-title-custom mb-0">
                                        <span class="status-badge me-2">03</span>Today's collection
                                    </h6>
                                    <span class="text-muted small">By payment mode</span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="text-muted small">Total collected</span>
                                    <h4 class="fw-bold mb-0">₹ @dashAnimator.Amount(TodayTotalCollected)</h4>
                                </div>
                                <div class="row g-3">
                                    <div class="col-6">
                                        <div class="text-muted small mb-1">Cash</div>
                                        <div class="metric-box metric-blue"><span>₹</span><strong>@dashAnimator.Amount(TodayCash)</strong></div>
                                    </div>
                                    <div class="col-6">
                                        <div class="text-muted small mb-1">Cheque</div>
                                        <div class="metric-box metric-purple"><span>₹</span><strong>@dashAnimator.Amount(TodayCheque)</strong></div>
                                    </div>
                                    <div class="col-6">
                                        <div class="text-muted small mb-1">Online</div>
                                        <div class="metric-box metric-teal"><span>₹</span><strong>@dashAnimator.Amount(TodayOnline)</strong></div>
                                    </div>
                                    <div class="col-6">
                                        <div class="text-muted small mb-1">Other</div>
                                        <div class="metric-box metric-orange"><span>₹</span><strong>@dashAnimator.Amount(TodayOther)</strong></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-5 dash-animate" style="--d:.5s">
                            <div class="dashboard-card h-100">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="card-title-custom mb-0">
                                        <span class="status-badge me-2">04</span>Expenses
                                    </h6>
                                    <span class="text-muted small">INR</span>
                                </div>

                                <div class="row g-3">
                                    <div class="col-12">
                                        <div class="text-muted small mb-1">Total expenses</div>
                                        <div class="metric-box metric-red"><span>₹</span><strong>@dashAnimator.Amount(TotalExpenses)</strong></div>
                                    </div>
                                    <div class="col-12">
                                        <div class="text-muted small mb-1">Today's expenses</div>
                                        <div class="metric-box metric-amber"><span>₹</span><strong>@dashAnimator.Amount(TodayExpenses)</strong></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
@if (IsLoading)
{
    <div class="grid-loader-overlay">
        <div class="loader-card">
            <div class="loader-ring">
                <div class="loader-arc"></div>
                <div class="loader-core">
                    <img src="/images/v3m-favicon-m.png" alt="Loading" class="loader-logo" />
                </div>
            </div>
            <p class="loader-text">Loading<span class="dot d1">.</span><span class="dot d2">.</span><span class="dot d3">.</span></p>
        </div>
    </div>
}

<CustomAlert @ref="customAlert" Title="Alert" />
@code {
    private CustomAlert customAlert;
    private bool addstudent { get; set; }
    private DateTime fromDate = DateTime.Now;
    private DateTime toDate = DateTime.Now;
    private string CurrentDateTime => DateTime.Now.ToString("yyyy/MM/dd, hh:mm tt");
    // Loader is visible from the first render until the dashboard data (and menu/session values) are ready
    private bool IsLoading = true;
    private const int FirstLoadMinLoaderMs = 900;
    // Cards entrance + number count-up animation (shared with other dashboards)
    private readonly DashboardCountAnimator dashAnimator = new();

    // TODO: Static values for now - replace with API data (FeeManagement dashboard endpoint) later
    private int TotalStudents = 1886;
    private int TransportUsers = 352;
    private int TotalStaff = 20;
    private int EwsStudents = 0;

    private decimal TotalFeeDue = 128536473.00m;
    private decimal TotalConcession = 287270.00m;
    private decimal TotalWaiveOff = 5000.00m;
    private decimal LateFine = 0.00m;
    private decimal TotalReceived = 1224841.00m;
    private decimal TotalOutstanding = 127028422.00m;
    private decimal PreSessionAdvance = 1485.00m;
    private decimal CurrentAdvance = -5545.00m;

    private decimal TodayTotalCollected = 136160.00m;
    private decimal TodayCash = 136160.00m;
    private decimal TodayCheque = 0.00m;
    private decimal TodayOnline = 0.00m;
    private decimal TodayOther = 0.00m;

    private decimal TotalExpenses = 0.00m;
    private decimal TodayExpenses = 0.00m;

    public void Dispose() => dashAnimator.Dispose();
    string fromDateString = "", toDateString = "";
    private string nameFilter = "";
    private string branchcode = "";
    private string groupcode = "";
    private string UserName = "";
    private long CurrentSession;
    private string DashboardName = "";
    private AdmissionDashboardRequest searchAnyRequest = new();
    private AdmissionDashboardModel admissionDashboardpipeline = new();
    private AdminDashboardModal adminDashboard = new();
    private List<SessionModel> sessionlist = new();
    private void RefreshPage()
    {
        Navigation.NavigateTo("/adminDashboard", forceLoad: true);
    }
    private string SelectedPeriod = "Today"; // default selected

    private async Task ApplyPeriodFilter(string period)
    {
        SelectedPeriod = period;

        var today = DateTime.Today;

        switch (period)
        {
            case "Today":
                searchAnyRequest.FromDate = today;
                searchAnyRequest.ToDate = today;
                break;

            case "ThisWeek":
                // Monday ko week ka start maan rahe hain
                int diff = (7 + (today.DayOfWeek - DayOfWeek.Monday)) % 7;
                searchAnyRequest.FromDate = today.AddDays(-diff);
                searchAnyRequest.ToDate = today;
                break;

            case "ThisMonth":
                searchAnyRequest.FromDate = new DateTime(today.Year, today.Month, 1);
                searchAnyRequest.ToDate = today;
                break;

            case "ThisYear":
                searchAnyRequest.FromDate = new DateTime(today.Year, 1, 1);
                searchAnyRequest.ToDate = today;
                break;
        }

        await GetAdmissionPipelineConfirmetion();
        StateHasChanged();
        await dashAnimator.PlayAsync(() => InvokeAsync(StateHasChanged));
    }
    private List<StudentStatusModel> studentStatusList => new()
    {
        new StudentStatusModel { StatusName = "Active", Count = admissionDashboardpipeline.ActiveStudentCount },
        new StudentStatusModel { StatusName = "Notice Period", Count = 29 },
        new StudentStatusModel { StatusName = "Withdrawn", Count = 35 }
    };

    public class StudentStatusModel
    {
        public string StatusName { get; set; } = "";
        public int Count { get; set; }
    }
    private void GoToEnquiry(string value)
    {
        if (value == "TotalEnquiry")
        {
            EnquiryState.DashboardValue = "GetEnquiry";
            NavigationManager.NavigateTo("/enquiry");
            StateHasChanged();
        }
        else if (value == "TotalRegistration")
        {
            EnquiryState.DashboardValue = "GetRegistration";
            NavigationManager.NavigateTo("/ViewRegistration");
            StateHasChanged();
        }
        else if (value == "TotalAdmission")
        {
            EnquiryState.DashboardValue = "Admission";
            NavigationManager.NavigateTo("/admitStudent");
            StateHasChanged();
        }


        // SendDashboardvalue="GetEnquiry";

    }
    private string GetStatusColor(string name) => name switch
    {
        "Active" => "#22c55e",
        "Notice Period" => "#f97316",
        "Withdrawn" => "#ef4444",
        _ => "#6c757d"
    };

    private ApexChartOptions<TItem> GetDonutOptions<TItem>(List<string> orderedColors) where TItem : class => new()
    {
        Chart = new Chart
        {
            Height = "170",
            Width = "170",
            Toolbar = new Toolbar { Show = false }
        },
        Legend = new Legend { Show = false },
        DataLabels = new DataLabels { Enabled = false },
        Colors = orderedColors,
        PlotOptions = new PlotOptions
        {
            Pie = new PlotOptionsPie
            {
                Donut = new PlotOptionsDonut
                {
                    Size = "50%"
                }
            }
        }
    };
    private async Task GetAdmissionPipelineConfirmetion()
    {
        IsLoading = true;
        dashAnimator.Hide();
        StateHasChanged();
        try
        {
            searchAnyRequest.GroupCode = groupcode;
            searchAnyRequest.BranchCode = branchcode;
            searchAnyRequest.SessionId = CurrentSession;
            var apiResponse = await httpService.Post<ApiResponse<AdmissionDashboardModel>>("AdminDashboard/GetAdmissionDashboardData", searchAnyRequest) ?? new();
            if (apiResponse.Success == true)
            {
                admissionDashboardpipeline = apiResponse.Data ?? new();
            }
        }
        finally
        {
            // Always hide the loader, even if the API fails, so the screen never stays stuck
            IsLoading = false;
        }
    }
    private async Task LoadData()
    {
        var branchResult = await sessionStorage.GetAsync<string>("BranchCode");
        branchcode = branchResult.Value;
        var groupResult = await sessionStorage.GetAsync<string>("GroupCode");
        groupcode = groupResult.Value;
        var username = await sessionStorage.GetAsync<string>("UserName");
        UserName = username.Value;
        var dashboard = await sessionStorage.GetAsync<string>("RoleName");
        DashboardName = dashboard.Value;
        searchAnyRequest.GroupCode = groupcode;
        searchAnyRequest.BranchCode = branchcode;
        searchAnyRequest.SessionId = CurrentSession;
        string ApiUri1 = "AdminDashboard/GetAdminDashboard";
        sessionlist = await httpService.Get<List<SessionModel>>("Session/GetSession") ?? new();
        var apiResponse = await httpService.Post<ApiResponse<AdminDashboardModal>>(ApiUri1, searchAnyRequest) ?? new();
        if (apiResponse.Success == true)
        {
            adminDashboard = apiResponse.Data ?? new();
        }


        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Keep the loader up for a minimum time after login so the menu settles before the cards animate in
            var minLoaderTask = Task.Delay(FirstLoadMinLoaderMs);
            CurrentSession = await CommonMethod.SetCurrentSessionData();
            await LoadData();
            await minLoaderTask;
            await ApplyPeriodFilter(SelectedPeriod);
        }
    }

    private async Task AdmitStudentDirect()
    {
        addstudent = true;
        StateHasChanged();

    }
    private void ClosePopup()
    {
        addstudent = false;
        StateHasChanged();
    }
}
