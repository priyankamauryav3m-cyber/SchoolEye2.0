@page "/resetpassword"
@layout LoginLayout
@using ServerWebUI.Components.Layout
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@using DomainModel.User
@using MyApp.Common
@rendermode InteractiveServer
@inject Shared.IHttpService httpService
@inject SweetAlertService Alert
@inject NavigationManager Nav
@inject IJSRuntime JS

<section class="reset-section">
    <div class="reset-card">
        <div class="school-logo-wrap">
            <img src="/images/school-logo.png" alt="School Logo" class="school-logo-img" />
        </div>

        <div class="icon-badge"><i class="fa-solid fa-lock"></i></div>
        <h2 class="reset-title">Reset password</h2>

        @if (IsChecking)
        {
            <div class="status-box"><span class="loader-spinner" style="border-color:#1e6fb355;border-top-color:#1e6fb3;display:inline-block"></span> Checking your link...</div>
        }
        else if (!IsLinkValid)
        {
            <div class="status-box error">@linkMessage</div>
            <a href="/forgotpassword" class="btn-reset d-flex align-items-center justify-content-center text-decoration-none">Request a new link</a>
        }
        else
        {
            <p class="reset-sub">Choose a new password (8 to 30 characters).</p>

            <EditForm Model="@request" OnValidSubmit="ResetPasswordAsync">
                <DataAnnotationsValidator />
                <div class="field-block">
                    <label class="field-label">New password</label>
                    <div class="input-with-icon">
                        <i class="fa-solid fa-lock"></i>
                        <InputText class="field-input has-toggle" type="@(ShowPassword ? "text" : "password")" placeholder="Enter new password" maxlength="30" autocomplete="new-password"
                                   @bind-Value="request.NewPassword" disabled="@IsLoading" />
                        <a class="show-toggle" @onclick="() => ShowPassword = !ShowPassword">@(ShowPassword ? "Hide" : "Show")</a>
                    </div>
                    <ValidationMessage For="@(() => request.NewPassword)" class="field-error" />
                </div>

                <div class="field-block">
                    <label class="field-label">Confirm password</label>
                    <div class="input-with-icon">
                        <i class="fa-solid fa-lock"></i>
                        <InputText class="field-input has-toggle" type="@(ShowConfirmPassword ? "text" : "password")" placeholder="Re-enter new password" maxlength="30" autocomplete="new-password"
                                   @bind-Value="request.ConfirmPassword" disabled="@IsLoading" />
                        <a class="show-toggle" @onclick="() => ShowConfirmPassword = !ShowConfirmPassword">@(ShowConfirmPassword ? "Hide" : "Show")</a>
                    </div>
                    <ValidationMessage For="@(() => request.ConfirmPassword)" class="field-error" />
                </div>

                <button class="btn-reset" type="submit" disabled="@IsLoading">
                    @if (IsLoading)
                    {
                        <span class="loading-text-container"><span class="loader-spinner"></span> Resetting...</span>
                    }
                    else
                    {
                        <span>Reset password <i class="fa-solid fa-check ms-1"></i></span>
                    }
                </button>
            </EditForm>
        }

        <div class="back-row">
            <a href="/" class="link-txt"><i class="fa-solid fa-arrow-left me-1"></i> Back to sign in</a>
        </div>
    </div>
</section>

<link rel="stylesheet" href="css/password-reset.css" />

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private ResetPasswordRequest request = new();
    private bool IsChecking = true;
    private bool IsLinkValid;
    private bool IsLoading;
    private bool ShowPassword;
    private bool ShowConfirmPassword;
    private string linkMessage = "This reset link is not valid. Please request a new one.";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // the link is checked as soon as it is opened, so an expired / used link never shows the form
        try
        {
            if (!string.IsNullOrWhiteSpace(Token))
            {
                var response = await httpService.Post<ApiResponse<string>>("users/ValidateResetToken", new ValidateResetTokenRequest { Token = Token });
                IsLinkValid = response != null && response.Success;
                if (!IsLinkValid && !string.IsNullOrWhiteSpace(response?.Message))
                    linkMessage = response.Message;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Validate reset link: {ex.Message}");
            linkMessage = "Unable to check the reset link. Please try again.";
        }
        finally
        {
            IsChecking = false;
            StateHasChanged();
        }
    }

    private async Task ResetPasswordAsync()
    {
        if (IsLoading) return;
        IsLoading = true;
        ApiResponse<string>? response = null;
        try
        {
            request.Token = Token;
            response = await httpService.Post<ApiResponse<string>>("users/ResetPassword", request);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Reset password: {ex.Message}");
            IsLoading = false;
            StateHasChanged();
            await Alert.ShowWarning(string.IsNullOrWhiteSpace(ex.Message) ? "Unable to change the password. Please try again." : ex.Message);
            return;
        }

        if (response != null && response.Success)
        {
            // password changed -> the forgot password tab closes, this tab goes straight to sign in
            try { await JS.InvokeVoidAsync("passwordReset.notifyDone"); } catch (Exception ex) { Console.WriteLine($"Reset notify: {ex.Message}"); }
            _ = ShowSuccessQuietly(response.Message);
            Nav.NavigateTo("/");
            return;
        }

        // expired / used while the page was open
        IsLinkValid = false;
        linkMessage = response?.Message ?? linkMessage;
        IsLoading = false;
        StateHasChanged();
    }

    // not awaited: the popup closes on its own timer, the redirect must not wait for it
    private async Task ShowSuccessQuietly(string? message)
    {
        try
        {
            await Alert.ShowSuccess(message);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Reset password success message: {ex.Message}");
        }
    }
}
