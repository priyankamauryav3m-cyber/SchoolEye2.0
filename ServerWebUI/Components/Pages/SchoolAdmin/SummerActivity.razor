@page "/SummerActivity"
@rendermode InteractiveServer

@* One page for the summer activity masters: Activity, Activity Slot, Dynamic Form and Registrations.
   Each tab is its own component with its own page heading (title + filters) and grid;
   the tabs are shown between the page heading and the grid. *@

@switch (activeTab)
{
    case Tab.Slot:
        <SummerActivitySlot Tabs="@TabBar" />
        break;
    case Tab.DynamicForm:
        <DynamicFormController Tabs="@TabBar" />
        break;
    case Tab.Registrations:
        <SummerActivityRegistrations Tabs="@TabBar" />
        break;
    default:
        <SummerActivityList Tabs="@TabBar" />
        break;
}

<style>
    .sa-tabs { margin: 0; }
        .sa-tabs .wizard-step { cursor: pointer; }
</style>

@code {
    private enum Tab { Activity, Slot, DynamicForm, Registrations }

    private sealed record TabItem(Tab Id, string Title, string Icon);

    private static readonly TabItem[] Tabs =
    {
        new(Tab.Activity, "Summer Activity", "bi-sun"),
        new(Tab.Slot, "Activity Slot", "bi-clock-history"),
        new(Tab.DynamicForm, "Dynamic Form", "bi-ui-checks-grid"),
        new(Tab.Registrations, "Total Registrations", "bi-person-lines-fill")
    };

    private Tab activeTab = Tab.Activity;

    private void SetTab(Tab tab) => activeTab = tab;

    // same step tabs as the Student Details page (wizard-steps)
    private RenderFragment TabBar => __builder =>
    {
        <ul class="wizard-steps sa-tabs">
            @for (var i = 0; i < Tabs.Length; i++)
            {
                var tab = Tabs[i];
                var no = i + 1;
                <li>
                    <a href="javascript:void(0)" class="wizard-step @(activeTab == tab.Id ? "active" : "")"
                       title="@tab.Title" @onclick="() => SetTab(tab.Id)">
                        <span class="wizard-badge">@no</span>
                        <i class="bi @tab.Icon wizard-icon"></i>
                        <span class="wizard-title">@tab.Title</span>
                    </a>
                </li>
            }
        </ul>
    };
}
