@page "/summer-activity-registration"
@layout Layout.LoginLayout
@using DomainModel.SchoolAdmin
@using MyApp.Common
@using System.Globalization
@inject Shared.IHttpService httpService
@inject SweetAlertService Alert
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>@(form?.ActivityName is { Length: > 0 } ? $"{form.ActivityName} - Registration" : "Summer Activity Registration")</PageTitle>

<div class="sar-page">
    <div class="sar-shell">

        @if (state == PageState.Loading)
        {
            <div class="sar-card sar-center">
                <img src="images/logo.png" alt="V3M Technologies" class="sar-v3m-lg" />
                <div class="sar-spinner"></div>
                <p class="sar-muted mb-0">Loading the registration form...</p>
            </div>
        }
        else if (state == PageState.Error)
        {
            <div class="sar-card sar-center">
                <img src="images/logo.png" alt="V3M Technologies" class="sar-v3m-lg" />
                <div class="sar-state-icon error"><i class="bi @(errorCode == -2 ? "bi-calendar-x" : "bi-link-45deg")"></i></div>
                <h2 class="sar-state-title">@(errorCode == -2 ? "Registration Closed" : "Link Not Available")</h2>
                <p class="sar-muted mb-0">@errorMessage</p>
            </div>
        }
        else if (form != null)
        {
            <div class="sar-card">
                @* ---------- header: V3M logo + school ---------- *@
                <header class="sar-header">
                    <img src="images/logo.png" alt="V3M Technologies" class="sar-v3m" />
                    <div class="sar-school">
                        <h1>@form.SchoolName</h1>
                        @if (!string.IsNullOrWhiteSpace(form.Address))
                        {
                            <p class="sar-address"><i class="bi bi-geo-alt"></i> @form.Address</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(form.Phone) || !string.IsNullOrWhiteSpace(form.Email))
                        {
                            <p class="sar-contact">
                                @if (!string.IsNullOrWhiteSpace(form.Phone))
                                {
                                    <span><i class="bi bi-telephone"></i> @form.Phone</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(form.Email))
                                {
                                    <span><i class="bi bi-envelope"></i> @form.Email</span>
                                }
                            </p>
                        }
                    </div>
                    <div class="sar-header-space"></div>
                </header>

                @* ---------- activity banner ---------- *@
                <section class="sar-banner">
                    <div>
                        <span class="sar-eyebrow"><i class="bi bi-sun"></i> Summer Activity Registration</span>
                        <h2>@form.ActivityName</h2>
                    </div>
                    @if (form.StartDate.HasValue || form.EndDate.HasValue)
                    {
                        <div class="sar-dates">
                            <i class="bi bi-calendar-event"></i>
                            <span>@Date(form.StartDate) &ndash; @Date(form.EndDate)</span>
                        </div>
                    }
                </section>

                @if (result != null)
                {
                    @* ---------- success ---------- *@
                    <section class="sar-body sar-center">
                        <div class="sar-state-icon success"><i class="bi bi-check-lg"></i></div>
                        <h2 class="sar-state-title">Registration Submitted</h2>
                        <p class="sar-muted">Thank you! Your registration has been received by the school.</p>
                        <div class="sar-receipt">
                            <div><span>Registration No.</span><strong>@result.RegistrationId</strong></div>
                            <div><span>Activity</span><strong>@result.ActivityName</strong></div>
                            <div><span>Slot</span><strong>@result.SlotName</strong></div>
                            <div><span>Fee Amount</span><strong>@Money(result.Amount)</strong></div>
                        </div>
                        <p class="sar-muted small mb-0">Please keep the registration number for future reference.</p>
                    </section>
                }
                else
                {
                    <section class="sar-body sar-form">
                        <div class="sar-scroll">
                        @if (form.Slots.Count == 0)
                        {
                            <div class="sar-alert"><i class="bi bi-info-circle"></i> No slot is open for this activity right now. Please contact the school.</div>
                        }

                        @* ---------- participant details (Dynamic Form Controller) ---------- *@
                        @if (form.Fields.Count > 0)
                        {
                            <h3 class="sar-section"><span>1</span> Participant Details</h3>
                            @* fewer than 12 fields: 3 per row (col-4); 12 or more: 4 per row (col-3) *@
                            <div class="sar-grid @(form.Fields.Count >= 12 ? "cols-4" : "cols-3")">
                                @foreach (var f in form.Fields)
                                {
                                    var field = f;
                                    var type = (field.FieldType ?? "").Trim().ToLowerInvariant();
                                    var hasError = errors.TryGetValue(field.FieldName, out var error);
                                    <div class="sar-cell">
                                        <div class="sar-field @(hasError ? "invalid" : "")">
                                            <label for="@Id(field)">
                                                @field.DisplayName
                                                @if (field.IsMandatory)
                                                {
                                                    <span class="sar-req">*</span>
                                                }
                                            </label>

                                            @switch (type)
                                            {
                                                case "dropdown":
                                                    <select id="@Id(field)" class="sar-input" value="@Get(field)" @onchange="e => Set(field, e.Value?.ToString())">
                                                        <option value="">Select</option>
                                                        @foreach (var o in field.Options)
                                                        {
                                                            <option value="@o">@o</option>
                                                        }
                                                    </select>
                                                    break;

                                                case "radio":
                                                    <div class="sar-choices" id="@Id(field)">
                                                        @foreach (var o in field.Options)
                                                        {
                                                            var option = o;
                                                            <label class="sar-choice @(Get(field) == option ? "on" : "")">
                                                                <input type="radio" name="@Id(field)" checked="@(Get(field) == option)" @onchange="() => Set(field, option)" />
                                                                <span>@option</span>
                                                            </label>
                                                        }
                                                    </div>
                                                    break;

                                                case "checkbox" when field.Options.Count > 0:
                                                    <div class="sar-choices" id="@Id(field)">
                                                        @foreach (var o in field.Options)
                                                        {
                                                            var option = o;
                                                            var on = IsPicked(field, option);
                                                            <label class="sar-choice @(on ? "on" : "")">
                                                                <input type="checkbox" checked="@on" @onchange="e => Toggle(field, option, e.Value is true)" />
                                                                <span>@option</span>
                                                            </label>
                                                        }
                                                    </div>
                                                    break;

                                                case "checkbox":
                                                    <label class="sar-choice single @(Get(field) == "1" ? "on" : "")">
                                                        <input id="@Id(field)" type="checkbox" checked="@(Get(field) == "1")" @onchange="e => Tick(field, e)" />
                                                        <span>Yes</span>
                                                    </label>
                                                    break;

                                                case "datetime":
                                                    <input id="@Id(field)" type="date" class="sar-input" max="2100-12-31" value="@Get(field)" @onchange="e => Set(field, e.Value?.ToString())" />
                                                    break;

                                                default:
                                                    var dataType = (field.DataType ?? "").Trim().ToLowerInvariant();
                                                    var numeric = dataType is "int" or "long";
                                                    var decimalType = dataType is "decimal" or "double";
                                                    int? maxLen = numeric || decimalType ? null : (field.MaxLength > 0 ? field.MaxLength : 100);
                                                    <input id="@Id(field)" class="sar-input" autocomplete="off"
                                                           type="@(decimalType ? "number" : "text")" step="@(decimalType ? "any" : null)"
                                                           inputmode="@(numeric ? "numeric" : decimalType ? "decimal" : null)"
                                                           maxlength="@maxLen"
                                                           placeholder="@Placeholder(field)"
                                                           value="@Get(field)" @oninput="e => Set(field, e.Value?.ToString())" />
                                                    break;
                                            }

                                            @if (hasError)
                                            {
                                                <small class="sar-error"><i class="bi bi-exclamation-circle"></i> @error</small>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        @* ---------- slot & fee ---------- *@
                        @if (form.Slots.Count > 0)
                        {
                            <h3 class="sar-section mt-4"><span>@(form.Fields.Count > 0 ? "2" : "1")</span> Select Slot</h3>
                            <div id="sar_slot" class="sar-slots @(errors.ContainsKey(SlotKey) ? "invalid" : "")">
                                @foreach (var s in form.Slots)
                                {
                                    var slot = s;
                                    <button type="button" class="sar-slot @(selectedSlotId == slot.SASId ? "on" : "")" @onclick="() => SelectSlot(slot.SASId)">
                                        <i class="bi @(selectedSlotId == slot.SASId ? "bi-check-circle-fill" : "bi-circle")"></i>
                                        <span class="sar-slot-name">@slot.SlotName</span>
                                        <span class="sar-slot-fee">@Money(slot.FeeAmount)</span>
                                    </button>
                                }
                            </div>
                            @if (errors.TryGetValue(SlotKey, out var slotError))
                            {
                                <small class="sar-error"><i class="bi bi-exclamation-circle"></i> @slotError</small>
                            }
                        }

                        @* ---------- total + submit ---------- *@
                        </div>
                        <div class="sar-submit-bar">
                            <div class="sar-total">
                                <span>Total Fee</span>
                                <strong>@Money(SelectedSlot?.FeeAmount ?? 0)</strong>
                            </div>
                            <button type="button" class="sar-submit" disabled="@(IsSaving || form.Slots.Count == 0)" @onclick="Submit">
                                @if (IsSaving)
                                {
                                    <span class="sar-btn-spinner"></span>
                                    <span>Submitting...</span>
                                }
                                else
                                {
                                    <i class="bi bi-send-fill"></i>
                                    <span>Submit Registration</span>
                                }
                            </button>
                        </div>
                    </section>
                }
            </div>
        }

        <footer class="sar-footer">
            <span>Powered by</span>
            <img src="images/logo.png" alt="V3M Technologies Pvt. Ltd." />
        </footer>
    </div>
</div>

<style>
    /* full screen: only the form part scrolls, header / banner / submit bar stay in place */
    .sar-page {
        height: 100vh; height: 100dvh; overflow: hidden;
        display: flex; padding: 14px 16px;
        background: radial-gradient(1200px 500px at 10% -10%, rgba(34,120,108,.25), transparent 60%),
                    radial-gradient(900px 500px at 110% 10%, rgba(14,64,115,.25), transparent 60%),
                    linear-gradient(160deg, #eef4fa 0%, #e6f2f0 100%);
        font-family: inherit;
    }
    .sar-shell { width: 100%; max-width: 100%; margin: 0; display: flex; flex-direction: column; min-height: 0; }
    .sar-card {
        flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column;
        background: #fff; border-radius: 18px; overflow: hidden;
        box-shadow: 0 18px 50px -18px rgba(14, 64, 115, .35);
        border: 1px solid rgba(14, 64, 115, .08);
    }
    .sar-center { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 12px; padding: 48px 24px; }
    .sar-muted { color: #6b7c8f; }

    .sar-header {
        display: grid; grid-template-columns: 170px 1fr 170px; align-items: center; gap: 16px;
        padding: 22px 28px; border-bottom: 1px solid #edf1f6;
    }
    .sar-v3m { width: 160px; height: auto; }
    .sar-v3m-lg { width: 190px; height: auto; margin-bottom: 8px; }
    .sar-school { text-align: center; }
        .sar-school h1 { font-size: clamp(20px, 3vw, 30px); font-weight: 800; color: #12304f; margin: 0 0 4px; letter-spacing: .2px; }
    .sar-address, .sar-contact { margin: 2px 0 0; color: #4a5d72; font-size: 14px; }
    .sar-contact { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 16px; font-size: 13px; }
        .sar-address .bi, .sar-contact .bi { color: #22786c; }

    .sar-banner {
        display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;
        padding: 20px 28px; color: #fff;
        background: linear-gradient(115deg, #0e4073, #22786c);
    }
        .sar-banner h2 { margin: 2px 0 0; font-size: clamp(18px, 2.4vw, 24px); font-weight: 700; }
    .sar-eyebrow { font-size: 12px; text-transform: uppercase; letter-spacing: 1.2px; opacity: .85; display: inline-flex; gap: 6px; align-items: center; }
    .sar-dates {
        display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 999px;
        background: rgba(255,255,255,.16); border: 1px solid rgba(255,255,255,.35); font-weight: 600; font-size: 14px;
    }

    .sar-header, .sar-banner { flex-shrink: 0; }
    .sar-banner h2 { color: #fff !important; }
    .sar-body { padding: 22px 28px 24px; flex: 1 1 auto; min-height: 0; overflow-y: auto; }
    .sar-form { display: flex; flex-direction: column; overflow: hidden; padding: 0; }
    .sar-scroll { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: 22px 28px 20px; scrollbar-width: thin; }
    /* every field = one cell, placed in Display Order: a row fills first, then the next row.
       No field spans or jumps rows, so there are no gaps and nothing overlaps. */
    .sar-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-flow: row; gap: 16px 18px; align-items: start; }
        .sar-grid.cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        .sar-grid.cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    @@media (max-width: 1199px) {
        .sar-grid.cols-4 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
    @@media (max-width: 991px) {
        .sar-grid.cols-3, .sar-grid.cols-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    .sar-cell { min-width: 0; max-width: 100%; }
    .sar-field { min-width: 0; }
    .sar-field label { overflow-wrap: anywhere; }
    .sar-section { display: flex; align-items: center; gap: 10px; font-size: 16px; font-weight: 700; color: #12304f; margin: 0 0 14px; }
        .sar-section span {
            width: 26px; height: 26px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center;
            background: #e3eef9; color: #0e4073; font-size: 13px;
        }

    .sar-field label { display: block; font-size: 13.5px; font-weight: 600; color: #2b3f55; margin-bottom: 6px; }
    .sar-req { color: #d93025; margin-left: 2px; }
    .sar-input {
        width: 100%; height: 44px; padding: 0 14px; border-radius: 10px; font-size: 14.5px; color: #1d2b3a;
        border: 1px solid #d3dde8; background: #fbfcfe; transition: border-color .15s, box-shadow .15s;
    }
        .sar-input:focus { outline: none; border-color: #2a7fc0; background: #fff; box-shadow: 0 0 0 3px rgba(42,127,192,.15); }
    .sar-field.invalid .sar-input, .sar-field.invalid .sar-choice { border-color: #e06666; }
    .sar-error { display: flex; align-items: center; gap: 4px; color: #c62828; font-size: 12.5px; margin-top: 5px; }

    /* options always on one line; if they do not fit, they scroll sideways inside the field */
    .sar-choices { display: flex; flex-wrap: nowrap; gap: 8px; overflow-x: auto; overflow-y: hidden; padding-bottom: 4px; scrollbar-width: thin; }
        .sar-choices .sar-choice { flex: 0 0 auto; white-space: nowrap; height: 44px; padding-top: 0; padding-bottom: 0; }
    .sar-choice {
        display: inline-flex !important; align-items: center; gap: 8px; margin: 0 !important; cursor: pointer;
        padding: 9px 14px; border-radius: 10px; border: 1px solid #d3dde8; background: #fbfcfe;
        font-weight: 500 !important; color: #2b3f55 !important; transition: all .15s;
    }
        .sar-choice input { accent-color: #0e4073; width: 16px; height: 16px; margin: 0; }
        .sar-choice.on { border-color: #2a7fc0; background: #eaf3fc; color: #0e4073 !important; }
        .sar-choice.single { height: 44px; }

  .sar-slots {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
}
    .sar-slot {
        display: flex; align-items: center; gap: 10px; text-align: left; width: 100%;
        padding: 14px 16px; border-radius: 12px; border: 1.5px solid #d3dde8; background: #fff; cursor: pointer;
        transition: all .15s;
    }
        .sar-slot:hover { border-color: #2a7fc0; }
        .sar-slot .bi { color: #9aabbd; font-size: 18px; }
        .sar-slot.on { border-color: #22786c; background: #eef8f6; box-shadow: 0 6px 18px -10px rgba(34,120,108,.6); }
            .sar-slot.on .bi { color: #22786c; }
    .sar-slot-name { flex: 1; font-weight: 600; color: #12304f; }
    .sar-slot-fee { font-weight: 700; color: #0e4073; white-space: nowrap; }
    .sar-slots.invalid .sar-slot { border-color: #e06666; }

    .sar-alert { display: flex; gap: 8px; align-items: center; padding: 12px 14px; border-radius: 10px; background: #fff7e6; color: #8a5a00; border: 1px solid #ffe2a8; margin-bottom: 16px; }

    .sar-submit-bar {
        display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;
        flex-shrink: 0; padding: 14px 28px; border-top: 1px solid #e3eaf2; background: #f8fafd;
    }
    .sar-total { display: flex; flex-direction: column; }
        .sar-total span { font-size: 12.5px; color: #6b7c8f; text-transform: uppercase; letter-spacing: .8px; }
        .sar-total strong { font-size: 24px; color: #0e4073; }
    .sar-submit {
        display: inline-flex; align-items: center; gap: 10px; border: none; cursor: pointer;
        padding: 13px 30px; border-radius: 999px; font-weight: 700; font-size: 15px; color: #fff;
        background: linear-gradient(115deg, #0e4073, #22786c);
        box-shadow: 0 10px 24px -10px rgba(14,64,115,.7); transition: transform .12s, box-shadow .12s, opacity .12s;
    }
        .sar-submit:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 14px 28px -10px rgba(14,64,115,.75); }
        .sar-submit:disabled { opacity: .6; cursor: not-allowed; }

    .sar-state-icon { width: 72px; height: 72px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 34px; }
        .sar-state-icon.success { background: #e2f6ea; color: #17784a; }
        .sar-state-icon.error { background: #fdecec; color: #c62828; }
    .sar-state-title { font-size: 22px; font-weight: 800; color: #12304f; margin: 0; }
    .sar-receipt {
        width: 100%; max-width: 460px; margin: 8px 0; border: 1px solid #e3eaf2; border-radius: 12px; overflow: hidden; text-align: left;
    }
        .sar-receipt div { display: flex; justify-content: space-between; gap: 12px; padding: 11px 16px; border-bottom: 1px solid #eef2f7; }
            .sar-receipt div:last-child { border-bottom: none; background: #f6f9fc; }
        .sar-receipt span { color: #6b7c8f; }
        .sar-receipt strong { color: #12304f; }

    .sar-spinner, .sar-btn-spinner { border-radius: 50%; animation: sar-spin .7s linear infinite; }
    .sar-spinner { width: 38px; height: 38px; border: 3px solid #d8e4f0; border-top-color: #0e4073; }
    .sar-btn-spinner { width: 16px; height: 16px; border: 2px solid rgba(255,255,255,.45); border-top-color: #fff; }
    @@keyframes sar-spin { to { transform: rotate(360deg); } }

    .sar-footer { flex-shrink: 0; display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 10px; color: #6b7c8f; font-size: 13px; }
        .sar-footer img { height: 26px; width: auto; }


    @@media (max-width: 767px) {
        .sar-page { padding: 16px 10px; }
        .sar-header { grid-template-columns: 1fr; text-align: center; padding: 18px; }
        .sar-v3m { margin: 0 auto; width: 140px; }
        .sar-header-space { display: none; }
        .sar-grid, .sar-grid.cols-3, .sar-grid.cols-4 { grid-template-columns: 1fr; }
        .sar-banner, .sar-body, .sar-scroll, .sar-submit-bar { padding-left: 16px; padding-right: 16px; }
        .sar-header { padding: 12px; gap: 6px; }
        .sar-submit { width: 100%; justify-content: center; }
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "key")]
    public string? Key { get; set; }

    private enum PageState { Loading, Ready, Error }
    private const string SlotKey = "SASId";

    private PageState state = PageState.Loading;
    private SummerActivityFormInfo? form;
    private int errorCode;
    private string? errorMessage;
    // FieldName -> value (checkbox list: comma separated)
    private readonly Dictionary<string, string?> values = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, string> errors = new(StringComparer.OrdinalIgnoreCase);
    private int selectedSlotId;
    private bool IsSaving;
    private SummerActivityRegistrationResult? result;
    private bool loaded;

    private SummerActivitySlotOption? SelectedSlot => form?.Slots.FirstOrDefault(x => x.SASId == selectedSlotId);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || loaded) return;
        loaded = true;
        await LoadForm();
    }

    private async Task LoadForm()
    {
        if (string.IsNullOrWhiteSpace(Key))
        {
            ShowError(-6, "This link is not valid. Please check the link sent by the school.");
            return;
        }
        try
        {
            var response = await httpService.Post<ApiResponse<SummerActivityFormInfo>>("SummerActivityRegistration/GetForm",
                new SummerActivityFormRequest { Key = Key });
            if (response != null && response.Success && response.Data != null)
            {
                form = response.Data;
                if (form.Slots.Count == 1)
                    selectedSlotId = form.Slots[0].SASId;
                state = PageState.Ready;
            }
            else
            {
                ShowError(response?.Code ?? -6, response?.Message ?? "This link is not valid. Please check the link sent by the school.");
            }
        }
        catch (Exception)
        {
            ShowError(-99, "Unable to load the form right now. Please try again after some time.");
        }
        StateHasChanged();
    }

    private void ShowError(int code, string message)
    {
        errorCode = code;
        errorMessage = message;
        state = PageState.Error;
        StateHasChanged();
    }

    // display names are often "Enter ..." already: no second "Enter"
    private static string Placeholder(SummerActivityFormField f) =>
        (f.DisplayName ?? "").TrimStart().StartsWith("Enter", StringComparison.OrdinalIgnoreCase) ? f.DisplayName! : $"Enter {f.DisplayName}";

    private static string Id(SummerActivityFormField f) => "sar_" + f.FieldName;
    private static string Date(DateTime? d) => d?.ToString("dd MMM yyyy", CultureInfo.InvariantCulture) ?? "-";
    private static string Money(decimal amount) => "₹" + amount.ToString("N2", CultureInfo.GetCultureInfo("en-IN"));

    private string? Get(SummerActivityFormField f) => values.TryGetValue(f.FieldName, out var v) ? v : null;

    private void Set(SummerActivityFormField f, string? value)
    {
        values[f.FieldName] = value;
        errors.Remove(f.FieldName);
    }

    // single checkbox: 1 ticked, 0 not
    private void Tick(SummerActivityFormField f, ChangeEventArgs e) => Set(f, e.Value is true ? "1" : "0");

    private bool IsPicked(SummerActivityFormField f, string option) =>
        (Get(f) ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Contains(option, StringComparer.OrdinalIgnoreCase);

    private void Toggle(SummerActivityFormField f, string option, bool on)
    {
        var picked = (Get(f) ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        picked.RemoveAll(x => string.Equals(x, option, StringComparison.OrdinalIgnoreCase));
        if (on) picked.Add(option);
        // keep the order of the options
        Set(f, string.Join(",", f.Options.Where(o => picked.Contains(o, StringComparer.OrdinalIgnoreCase))));
    }

    private void SelectSlot(int id)
    {
        selectedSlotId = id;
        errors.Remove(SlotKey);
    }

    // same text as the API (SummerActivityRegistrationService.RequiredMessage)
    private const string RequiredMessage = "This field is required.";

    // first wrong field (in Display Order), then the slot: brought into view
    private async Task ScrollToFirstError()
    {
        StateHasChanged();
        var first = form?.Fields.FirstOrDefault(f => errors.ContainsKey(f.FieldName));
        var id = first != null ? Id(first) : errors.ContainsKey(SlotKey) ? "sar_slot" : null;
        if (id == null) return;
        try
        {
            await Task.Yield();
            await JS.InvokeVoidAsync("scrollToElement", id);
        }
        catch
        {
            // scrolling is only a help
        }
    }

    // quick checks on the page; the API checks everything again
    private bool ValidateForm()
    {
        errors = new(StringComparer.OrdinalIgnoreCase);
        foreach (var f in form!.Fields)
        {
            var value = Get(f)?.Trim();
            var type = (f.FieldType ?? "").Trim().ToLowerInvariant();
            var empty = type == "checkbox" && f.Options.Count == 0 ? value != "1" : string.IsNullOrEmpty(value);
            if (f.IsMandatory && empty)
            {
                errors[f.FieldName] = RequiredMessage;
                continue;
            }
            var dataType = (f.DataType ?? "").Trim().ToLowerInvariant();
            if (!empty && type == "textbox" && dataType is "int" or "long" && !long.TryParse(value, out _))
                errors[f.FieldName] = $"Enter a valid number for {f.DisplayName}.";
        }
        if (selectedSlotId <= 0)
            errors[SlotKey] = "Please select a slot.";
        return errors.Count == 0;
    }

    private async Task Submit()
    {
        if (IsSaving || form == null) return;
        if (!ValidateForm())
        {
            var missing = errors.Values.Count(e => e == RequiredMessage) + (errors.ContainsKey(SlotKey) ? 1 : 0);
            await Alert.ShowWarning(missing > 0
                ? $"Please fill all the required fields ({missing} missing)."
                : "Please correct the highlighted fields.");
            await ScrollToFirstError();
            return;
        }

        IsSaving = true;
        StateHasChanged();
        try
        {
            var request = new SummerActivityRegistrationRequest
            {
                Key = Key,
                SASId = selectedSlotId,
                Values = form.Fields.ToDictionary(f => f.FieldName, f => Get(f)?.Trim())
            };
            var response = await httpService.Post<ApiResponse<SummerActivityRegistrationResult>>("SummerActivityRegistration/Register", request);
            if (response != null && response.Success && response.Data != null)
            {
                result = response.Data;
                await Alert.ShowSuccess("Registration submitted successfully.");
                // straight to the payment page (Complete Your Payment); without a key the success screen stays
                if (!string.IsNullOrWhiteSpace(result.PaymentKey))
                {
                    Nav.NavigateTo($"summer-activity-payment?key={Uri.EscapeDataString(result.PaymentKey)}");
                    return;
                }
            }
            else if (response?.Data?.Errors is { Count: > 0 } fieldErrors)
            {
                errors = new Dictionary<string, string>(fieldErrors, StringComparer.OrdinalIgnoreCase);
                await Alert.ShowWarning(response.Message ?? "Please correct the highlighted fields.");
                await ScrollToFirstError();
            }
            else if (response?.Code is -1 or -2 or -6)
            {
                ShowError(response.Code, response.Message ?? "This activity is not available.");
            }
            else
            {
                await Alert.ShowCustomAlert(response?.Message ?? "Registration could not be saved. Please try again.");
            }
        }
        catch (Exception)
        {
            await Alert.ShowError("Too many requests or the server is busy. Please try again after a minute.");
        }
        finally
        {
            IsSaving = false;
            StateHasChanged();
        }
    }
}
