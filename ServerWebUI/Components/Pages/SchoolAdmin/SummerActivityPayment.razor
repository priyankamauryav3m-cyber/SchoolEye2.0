@page "/summer-activity-payment"
@layout Layout.LoginLayout
@using DomainModel.SchoolAdmin
@using MyApp.Common
@using System.Globalization
@inject Shared.IHttpService httpService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Complete Your Payment</PageTitle>

<div class="pay-page">
    @* ---------- top bar ---------- *@
    <header class="pay-topbar">
        <div class="pay-topbar-in">
            <div class="pay-brand">
                <span class="pay-brand-icon"><img src="images/v3m-favicon.png" alt="V3M" /></span>
                <div>
                    <strong>V3M Technologies</strong>
                    <small>PAYMENT PORTAL</small>
                </div>
            </div>
            <div class="pay-secure"><i class="bi bi-shield-fill-check"></i> Secure payment gateway</div>
        </div>
    </header>

    <main class="pay-main">
        <div class="pay-intro">
            <span class="pay-eyebrow">SIMPLE · SAFE · SECURE</span>
            <h1>Complete Your Payment</h1>
            <p>Review your activity details and confirm the amount before proceeding.</p>
        </div>

        @if (state == PageState.Loading)
        {
            <div class="pay-card pay-center">
                <div class="pay-spinner"></div>
                <p class="pay-muted mb-0">Loading payment details...</p>
            </div>
        }
        else if (state == PageState.Error)
        {
            <div class="pay-card pay-center">
                <div class="pay-state error"><i class="bi bi-link-45deg"></i></div>
                <h2>Payment Link Not Available</h2>
                <p class="pay-muted mb-0">@errorMessage</p>
            </div>
        }
        else if (info != null)
        {
            <div class="pay-card">
                <div class="pay-card-head">
                    <div class="pay-card-title">
                        <span class="pay-title-icon"><i class="bi bi-receipt"></i></span>
                        <span>Pay Fee</span>
                    </div>
                    @if (info.IsFeePaid)
                    {
                        <span class="pay-chip paid"><i class="bi bi-check-circle-fill"></i> Payment completed</span>
                    }
                    else
                    {
                        <span class="pay-chip"><i class="bi bi-check-circle-fill"></i> Review details</span>
                    }
                </div>

                <div class="pay-grid">
                    @* ---------- activity information ---------- *@
                    <section>
                        <h3 class="pay-label">ACTIVITY INFORMATION</h3>
                        <div class="pay-info">
                            <div class="pay-info-row">
                                <span class="pay-info-icon"><i class="bi bi-calendar3"></i></span>
                                <div><small>Activity Name</small><strong>@info.ActivityName</strong></div>
                            </div>
                            <div class="pay-info-row">
                                <span class="pay-info-icon"><i class="bi bi-clock"></i></span>
                                <div><small>Activity Slot</small><strong>@info.SlotName</strong></div>
                            </div>
                            <div class="pay-info-row">
                                <span class="pay-info-icon"><i class="bi bi-hash"></i></span>
                                <div><small>Registration No.</small><strong>@info.RegistrationId</strong></div>
                            </div>
                            <div class="pay-info-row">
                                <span class="pay-info-icon"><i class="bi bi-currency-rupee"></i></span>
                                <div><small>Payment purpose</small><strong>Activity registration fee</strong></div>
                            </div>
                        </div>
                        <p class="pay-protect"><i class="bi bi-lock-fill"></i> Your payment details are protected by a secure checkout.</p>
                    </section>

                    @* ---------- payment summary ---------- *@
                    <section>
                        <h3 class="pay-label">PAYMENT SUMMARY</h3>
                        <div class="pay-summary">
                            <small class="pay-sum-cap">Total amount payable</small>
                            <div class="pay-sum-total">@Money(info.TotalAmount)</div>
                            <small class="pay-sum-inr">Indian Rupees (INR)</small>

                            <div class="pay-sum-lines">
                                <div><span>Activity fee</span><b>@Money(info.ActivityFee)</b></div>
                                <div><span>Convenience fee</span><b>@Money(info.ConvenienceFee)</b></div>
                                <div class="total"><span>Total to pay</span><b>@Money(info.TotalAmount)</b></div>
                            </div>

                            @if (info.IsFeePaid)
                            {
                                <button type="button" class="pay-btn done" @onclick="ProceedToPay">
                                    <i class="bi bi-receipt"></i> Fee Paid · View Receipt
                                </button>
                            }
                            else
                            {
                                <button type="button" class="pay-btn" @onclick="ProceedToPay" disabled="@(info.TotalAmount <= 0)">
                                    Proceed to Pay <i class="bi bi-arrow-right"></i>
                                </button>
                            }
                            <small class="pay-sum-secure"><i class="bi bi-shield-check"></i> Secure and encrypted transaction</small>
                        </div>
                    </section>
                </div>
            </div>
        }
    </main>

    <footer class="pay-footer">© @DateTime.Now.Year <b>V3M Technologies Pvt. Ltd.</b> All rights reserved.</footer>
</div>

<style>
    /* one screen, no page scroll: top bar + footer fixed size, the middle fits (and scrolls inside only on very small screens) */
    .pay-page { height: 100vh; height: 100dvh; overflow: hidden; display: flex; flex-direction: column; background: #f1f5fa; color: #12263f; }
    .pay-topbar, .pay-footer { flex-shrink: 0; }
    .pay-topbar { background: #0b1f45; color: #fff; }
    .pay-topbar-in { max-width: 1140px; margin: 0 auto; padding: 10px 20px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .pay-brand { display: flex; align-items: center; gap: 12px; }
        .pay-brand strong { display: block; font-size: 16px; line-height: 1.2; }
        .pay-brand small { font-size: 10px; letter-spacing: 1.5px; opacity: .75; }
    .pay-brand-icon { width: 38px; height: 38px; border-radius: 10px; background: #fff; display: inline-flex; align-items: center; justify-content: center; overflow: hidden; }
        .pay-brand-icon img { width: 28px; height: 28px; object-fit: contain; }
    .pay-secure { font-size: 13px; opacity: .9; display: inline-flex; align-items: center; gap: 6px; }
        .pay-secure .bi { color: #34d399; }

    .pay-main { flex: 1 1 auto; min-height: 0; overflow-y: auto; width: 100%; max-width: 900px; margin: 0 auto; padding: 18px 16px 8px; display: flex; flex-direction: column; justify-content: safe center; }
    .pay-intro { text-align: center; margin-bottom: 14px; }
    .pay-eyebrow { font-size: 11px; letter-spacing: 2px; font-weight: 700; color: #2563eb; }
    .pay-intro h1 { font-size: clamp(22px, 3.4vw, 30px); font-weight: 800; margin: 4px 0; color: #0f2547; }
    .pay-intro p { color: #64748b; margin: 0; font-size: 14px; }

    .pay-card { background: #fff; border-radius: 18px; box-shadow: 0 20px 50px -24px rgba(15, 37, 71, .35); border: 1px solid #e6ecf4; overflow: hidden; }
    .pay-center { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px; padding: 48px 24px; }
        .pay-center h2 { font-size: 20px; font-weight: 800; margin: 0; }
    .pay-muted { color: #64748b; }
    .pay-card-head { display: flex; align-items: center; justify-content: space-between; padding: 12px 20px; border-bottom: 1px solid #eef2f7; }
    .pay-card-title { display: flex; align-items: center; gap: 12px; font-weight: 700; font-size: 16px; }
    .pay-title-icon { width: 34px; height: 34px; border-radius: 9px; background: #eef3fb; color: #1e3a8a; display: inline-flex; align-items: center; justify-content: center; }
    .pay-chip { font-size: 12px; font-weight: 600; color: #334155; background: #f1f5f9; border-radius: 999px; padding: 5px 12px; display: inline-flex; align-items: center; gap: 6px; }
        .pay-chip .bi { color: #475569; }
        .pay-chip.paid { background: #dcfce7; color: #166534; }
            .pay-chip.paid .bi { color: #16a34a; }

    .pay-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 20px; padding: 16px 20px 18px; }
    .pay-label { font-size: 11px; letter-spacing: 1.4px; font-weight: 700; color: #64748b; margin: 0 0 10px; }
    .pay-info { border: 1px solid #e6ecf4; border-radius: 14px; padding: 6px 16px; }
    .pay-info-row { display: flex; gap: 14px; align-items: flex-start; padding: 9px 0; border-bottom: 1px solid #eef2f7; }
        .pay-info-row:last-child { border-bottom: none; }
        .pay-info-row small { display: block; font-size: 12px; color: #64748b; }
        .pay-info-row strong { font-size: 14px; text-transform: uppercase; color: #0f2547; }
    .pay-info-icon { flex-shrink: 0; width: 32px; height: 32px; border-radius: 8px; background: #f1f5f9; color: #475569; display: inline-flex; align-items: center; justify-content: center; }
    .pay-protect { text-align: center; color: #64748b; font-size: 12.5px; margin: 14px 0 0; }
        .pay-protect .bi { color: #16a34a; }

    .pay-summary {
        position: relative; overflow: hidden; color: #fff; border-radius: 16px; padding: 18px 20px;
        background: radial-gradient(240px 240px at 100% 0%, rgba(255,255,255,.08), transparent 60%), linear-gradient(160deg, #13306b, #0b1f45);
    }
    .pay-sum-cap { color: #93c5fd; font-size: 12px; }
    .pay-sum-total { font-size: 34px; font-weight: 800; margin: 2px 0; }
    .pay-sum-inr { font-size: 12px; opacity: .75; }
    .pay-sum-lines { margin: 12px 0 14px; padding-top: 10px; border-top: 1px solid rgba(255,255,255,.15); }
        .pay-sum-lines div { display: flex; justify-content: space-between; font-size: 13.5px; padding: 5px 0; }
            .pay-sum-lines div span { opacity: .85; }
        .pay-sum-lines .total { margin-top: 8px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,.15); font-size: 14.5px; }
    .pay-btn {
        width: 100%; border: none; border-radius: 12px; padding: 13px 16px; font-weight: 700; font-size: 15px; color: #fff;
        background: linear-gradient(115deg, #22c38e, #14a06d); display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        box-shadow: 0 10px 24px -12px rgba(20,160,109,.8); transition: transform .12s, filter .12s;
    }
        .pay-btn:hover:not(:disabled) { transform: translateY(-1px); filter: brightness(1.05); }
        .pay-btn:disabled { opacity: .7; cursor: not-allowed; }
        .pay-btn.done { background: #16a34a; }
    .pay-sum-secure { display: block; text-align: center; margin-top: 10px; font-size: 12px; color: #a7f3d0; }

    .pay-state { width: 64px; height: 64px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 30px; }
        .pay-state.error { background: #fdecec; color: #c62828; }
    .pay-spinner { width: 36px; height: 36px; border-radius: 50%; border: 3px solid #dbe4f0; border-top-color: #13306b; animation: pay-spin .7s linear infinite; }
    @@keyframes pay-spin { to { transform: rotate(360deg); } }

    .pay-footer { text-align: center; font-size: 12px; color: #64748b; padding: 8px 16px 10px; }
        .pay-footer b { color: #1e3a8a; }

    @@media (max-width: 767px) {
        .pay-grid { grid-template-columns: 1fr; padding: 16px; }
        .pay-secure { display: none; }
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "key")]
    public string? Key { get; set; }

    private enum PageState { Loading, Ready, Error }
    private PageState state = PageState.Loading;
    private SummerActivityPaymentInfo? info;
    private string? errorMessage;
    private bool loaded;

    private static string Money(decimal amount) => "₹" + amount.ToString("N2", CultureInfo.GetCultureInfo("en-IN"));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || loaded) return;
        loaded = true;

        if (string.IsNullOrWhiteSpace(Key))
        {
            Fail("This payment link is not valid.");
            return;
        }
        try
        {
            var response = await httpService.Post<ApiResponse<SummerActivityPaymentInfo>>("SummerActivityRegistration/GetPayment",
                new SummerActivityFormRequest { Key = Key });
            if (response != null && response.Success && response.Data != null)
            {
                info = response.Data;
                state = PageState.Ready;
            }
            else
            {
                Fail(response?.Message ?? "Registration was not found for this payment link.");
            }
        }
        catch (Exception)
        {
            Fail("Unable to load the payment details right now. Please try again after some time.");
        }
        StateHasChanged();
    }

    private void Fail(string message)
    {
        errorMessage = message;
        state = PageState.Error;
        StateHasChanged();
    }

    // checkout page of this registration (same key)
    private void ProceedToPay()
    {
        Navigation.NavigateTo($"summer-activity-checkout?key={Uri.EscapeDataString(Key ?? "")}");
    }
}
