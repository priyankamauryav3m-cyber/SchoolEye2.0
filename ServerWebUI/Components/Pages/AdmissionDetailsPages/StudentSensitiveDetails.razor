                                                {
                                                    <option value="@f.Key">@f.Group – @f.Label (@FieldState(f.Key).ChangeCount)</option>
                                                }
                                            </select>
                                        </div>
                                        <button type="button" class="ssd-btn" @onclick="LoadHistory" title="Reload"><i class="bi bi-arrow-clockwise"></i></button>
                                    </div>
