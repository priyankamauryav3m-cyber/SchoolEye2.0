@page "/StudentSensitiveDetails"
@using DomainModel.Admin
@using DomainModel.Common
@using DomainModel.FinanceMNGT
@using DomainModel.SchoolMaster
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyApp.Common
@using ServerWebUI.Components.Common
@using ServerWebUI.Components.Pages.CommonPages
@inject Shared.IHttpService httpService
@inject SweetAlertService Alert
@inject ICommonMethod _commonmethod
@inject NavigationManager Nav
@implements IDisposable
@rendermode InteractiveServer

@*
    DPDP - Student Sensitive Details
    The only screen that shows a student's / parent's sensitive data WITHOUT masking and the only
    screen where it can be changed. Every other screen shows it masked and read-only (DomainModel.Common.PiiMask).

    APIs:
      StudentSensitiveDetails/CheckAccess   role has PII tick on this page (checked in the DB by the API)
      StudentFee/GetStudentLedgerChallanMiniDetails   student search (same as Student Fee Account)
      StudentSensitiveDetails/GetDetails    unmasked values + how many times each field was changed
      StudentSensitiveDetails/Update        only the changed fields + reason -> USP_DPDP_UpdateStudentSensitiveDetails
                                            (old + new value saved through Usp_SaveTransactionLog)
      StudentSensitiveDetails/GetHistory    change history (Det_TransactionLog)
    No print, no export.
*@

<style>
    .ssd { --ssd-ink: #172033; --ssd-muted: #64748b; --ssd-line: #e6eaf0; --ssd-navy: #1f3a5f; --ssd-amber: #b7791f; --ssd-amber-soft: #fff7e8; --ssd-red: #c0392b; --ssd-red-soft: #fdecea; --ssd-green: #2f7d57; --ssd-green-soft: #e6f3ec; --ssd-teal: #0f766e; }
    .ssd .ssd-card { background: var(--card-bg, #fff); border: 1px solid var(--border-color, var(--ssd-line)); border-radius: var(--se-radius, 12px); box-shadow: var(--se-shadow, none); }
    .ssd .ssd-search-card { overflow: visible !important; position: relative; z-index: 5; }
    .ssd .ssd-searchbar { display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; padding: 12px 16px; }
    .ssd .ssd-searchbar-title { display: flex; align-items: center; gap: 10px; }
    .ssd .ssd-searchbar-title > i { font-size: 20px; color: #fff; background: linear-gradient(135deg, #1f3a5f, #0f766e); width: 40px; height: 40px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; }
    .ssd .ssd-searchbar-head { font-weight: 700; color: var(--ssd-ink); font-size: 15px; }
    .ssd .ssd-searchbar-hint { color: var(--ssd-muted); font-size: 12px; }
    .ssd kbd { background: #f1f4f8; color: #334155; border: 1px solid #d8dee7; border-bottom-width: 2px; border-radius: 4px; padding: 0 5px; font-size: 11px; font-family: inherit; }
    .ssd .ssd-searchbar-tools { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .ssd .ssd-search-box { position: relative; width: 360px; }
    .ssd .ssd-search-input { padding-left: 34px !important; padding-right: 32px !important; }
    .ssd .ssd-search-icon { position: absolute; left: 11px; top: 50%; transform: translateY(-50%); color: #64748b; cursor: pointer; z-index: 2; }
    .ssd .ssd-search-clear { position: absolute; right: 6px; top: 50%; transform: translateY(-50%); border: none; background: none; color: #94a3b8; padding: 2px 6px; z-index: 2; }
    .ssd .ssd-suggest { position: absolute; top: 100%; right: -70px; width: 550px; max-width: 92vw; margin-top: 2px; border: 1px solid #d9d9d9; border-radius: 8px; background: #fff; max-height: 400px; overflow-y: auto; box-shadow: 0 8px 20px rgba(0,0,0,.15); z-index: 2000; }
    .ssd .ssd-suggest-item { display: grid; grid-template-columns: 2fr 1.2fr 1fr 1.6fr; gap: 16px; padding: 10px 14px; cursor: pointer; border-bottom: 1px solid #f1f3f5; }
    .ssd .ssd-suggest-item:hover, .ssd .ssd-suggest-item.active { background: #f7f9fc; }
    .ssd .ssd-suggest-col { display: flex; flex-direction: column; min-width: 0; }
    .ssd .ssd-suggest-label { font-size: 12px; font-weight: 500; color: #263238; }
    .ssd .ssd-suggest-value { font-size: 11px; font-weight: 600; color: #8a94a6; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ssd .ssd-suggest-empty { padding: 14px; color: #6c757d; font-size: 13px; }
    .ssd .ssd-suggest-foot { padding: 7px 14px; font-size: 11.5px; color: var(--ssd-muted); background: #fafbfc; border-top: 1px solid #f1f3f5; position: sticky; bottom: 0; }
    .ssd .ssd-loader { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 28px 13px; color: #68778a; font-weight: 600; }
    .ssd .ssd-spinner { width: 16px; height: 16px; border: 2px solid #cbd8e5; border-top-color: #118c91; border-radius: 50%; display: inline-block; animation: ssd-spin .7s linear infinite; }
    @@keyframes ssd-spin { to { transform: rotate(360deg); } }

    .ssd .ssd-btn { border: 1px solid #cdd5df; background: #fff; color: #1e293b; border-radius: 6px; padding: 7px 13px; font-size: 14px; font-weight: 500; display: inline-flex; align-items: center; gap: 6px; transition: background .15s, border-color .15s, color .15s; }
    .ssd .ssd-btn:hover:not(:disabled) { background: var(--ssd-navy); color: #fff; }
    .ssd .ssd-btn.primary { background: var(--ssd-navy); border-color: var(--ssd-navy); color: #fff; font-weight: 600; }
    .ssd .ssd-btn.primary:hover:not(:disabled) { background: #17304f; }
    .ssd .ssd-btn.danger { color: var(--ssd-red); border-color: #f1c7c2; }
    .ssd .ssd-btn.danger:hover:not(:disabled) { background: var(--ssd-red); color: #fff; }
    .ssd .ssd-btn:disabled { opacity: .55; cursor: not-allowed; }

    /* ---------- header ---------- */
    .ssd .ssd-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; padding: 18px 20px; position: relative; overflow: hidden; }
    .ssd .ssd-head::before { content: ""; position: absolute; inset: 0 auto 0 0; width: 5px; background: linear-gradient(180deg, #1f3a5f, #0f766e); }
    .ssd .ssd-name { font-size: 24px; font-weight: 800; color: var(--ssd-ink); text-transform: uppercase; margin: 0; line-height: 1.15; }
    .ssd .ssd-sub { color: var(--ssd-muted); font-size: 14px; margin-top: 4px; display: flex; flex-wrap: wrap; gap: 4px 14px; }
    .ssd .ssd-sub b { color: var(--ssd-ink); font-weight: 600; }
    .ssd .ssd-badges { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 10px; }
    .ssd .ssd-badge { display: inline-flex; align-items: center; gap: 5px; padding: 3px 10px; border-radius: 14px; font-size: 12px; font-weight: 600; }
    .ssd .ssd-badge.shield { background: #e7f5f3; color: var(--ssd-teal); }
    .ssd .ssd-badge.log { background: #eef2ff; color: #3730a3; }
    .ssd .ssd-badge.noprint { background: var(--ssd-red-soft); color: var(--ssd-red); }
    .ssd .ssd-actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    .ssd .ssd-viewer { font-size: 11.5px; color: var(--ssd-muted); text-align: right; width: 100%; }

    /* ---------- tabs ---------- */
    .ssd .ssd-tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--ssd-line); overflow-x: auto; scrollbar-width: thin; }
    .ssd .ssd-tab { background: none; border: none; padding: 11px 14px; color: #4b5565; font-size: 15px; white-space: nowrap; border-bottom: 3px solid transparent; margin-bottom: -1px; display: inline-flex; align-items: center; gap: 6px; }
    .ssd .ssd-tab:hover { color: var(--ssd-ink); }
    .ssd .ssd-tab.active { color: var(--ssd-ink); font-weight: 600; border-bottom-color: var(--ssd-navy); }
    .ssd .ssd-tab .ssd-dot { min-width: 18px; padding: 0 6px; border-radius: 10px; background: var(--ssd-amber); color: #fff; font-size: 11px; font-weight: 700; line-height: 18px; text-align: center; }

    /* ---------- sections + fields ---------- */
    .ssd .ssd-body { padding-top: 14px; padding-bottom: 90px; position: relative; }
    .ssd .ssd-sections { display: grid; grid-template-columns: repeat(auto-fit, minmax(420px, 1fr)); gap: 14px; }
    .ssd .ssd-section { padding: 0; overflow: hidden; }
    .ssd .ssd-section-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 12px 16px; border-bottom: 1px solid var(--ssd-line); background: linear-gradient(90deg, #f8fafc, var(--card-bg, #fff)); }
    .ssd .ssd-section-title { display: flex; align-items: center; gap: 10px; font-weight: 700; color: var(--ssd-ink); font-size: 15px; }
    .ssd .ssd-section-title i { width: 32px; height: 32px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; background: #eaf0f7; color: var(--ssd-navy); font-size: 16px; }
    .ssd .ssd-section-title small { display: block; font-weight: 500; color: var(--ssd-muted); font-size: 12px; }
    .ssd .ssd-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 16px; padding: 14px 16px 16px; }
    .ssd .ssd-field { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
    .ssd .ssd-field.wide { grid-column: 1 / -1; }
    .ssd .ssd-label { display: flex; align-items: center; justify-content: space-between; gap: 6px; font-size: 12.5px; font-weight: 600; color: #475569; }
    .ssd .ssd-input { width: 100%; border: 1px solid #d3dae4; border-radius: 7px; padding: 8px 11px; font-size: 14px; color: var(--ssd-ink); background: #fff; transition: border-color .15s, box-shadow .15s; user-select: text; }
    .ssd .ssd-input:focus { outline: none; border-color: #1f6fb2; box-shadow: 0 0 0 3px rgba(31,111,178,.12); }
    .ssd textarea.ssd-input { min-height: 64px; resize: vertical; }
    .ssd .ssd-field.changed .ssd-input { border-color: var(--ssd-amber); background: var(--ssd-amber-soft); }
    .ssd .ssd-field.invalid .ssd-input { border-color: var(--ssd-red); background: var(--ssd-red-soft); }
    .ssd .ssd-input.masked { letter-spacing: .5px; color: #475569; background: #f8fafc; }
    .ssd .ssd-meta { display: flex; align-items: center; gap: 8px; min-height: 18px; font-size: 11.5px; color: var(--ssd-muted); }
    .ssd .ssd-err { color: var(--ssd-red); font-size: 12px; }
    .ssd .ssd-count { border: none; background: #eef2ff; color: #3730a3; border-radius: 10px; padding: 1px 8px; font-size: 11px; font-weight: 700; cursor: pointer; white-space: nowrap; }
    .ssd .ssd-count:hover { background: #3730a3; color: #fff; }
    .ssd .ssd-count.zero { background: #f1f5f9; color: #94a3b8; cursor: default; }
    .ssd .ssd-undo { border: none; background: none; color: var(--ssd-amber); font-size: 11.5px; font-weight: 600; padding: 0; cursor: pointer; }
    .ssd .ssd-undo:hover { text-decoration: underline; }
    .ssd .ssd-edited { color: var(--ssd-amber); font-weight: 700; font-size: 11px; }

    /* ---------- pending changes bar ---------- */
    .ssd .ssd-savebar { position: sticky; bottom: 10px; z-index: 20; margin-top: 16px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 12px 16px; border-radius: 12px; background: #1f3a5f; color: #fff; box-shadow: 0 10px 30px rgba(15,23,42,.25); }
    .ssd .ssd-savebar .txt { display: flex; align-items: center; gap: 10px; font-weight: 600; }
    .ssd .ssd-savebar .txt small { display: block; font-weight: 400; color: #cbd5e1; }
    .ssd .ssd-savebar .ssd-btn { border-color: rgba(255,255,255,.35); background: transparent; color: #fff; }
    .ssd .ssd-savebar .ssd-btn.primary { background: #fff; color: #1f3a5f; border-color: #fff; }
    .ssd .ssd-savebar .ssd-btn:hover:not(:disabled) { background: rgba(255,255,255,.15); color: #fff; }
    .ssd .ssd-savebar .ssd-btn.primary:hover:not(:disabled) { background: #e2e8f0; color: #1f3a5f; }

    /* ---------- empty / denied ---------- */
    .ssd .ssd-empty { min-height: 320px; display: flex; align-items: center; justify-content: center; text-align: center; padding: 24px; }
    .ssd .ssd-empty i { font-size: 24px; width: 52px; height: 52px; border-radius: 14px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 10px; background: #eaf3fb; color: #177a9b; }
    .ssd .ssd-empty.denied i { background: var(--ssd-red-soft); color: var(--ssd-red); }
    .ssd .ssd-empty strong { display: block; color: var(--ssd-ink); font-size: 16px; }
    .ssd .ssd-empty div div { color: #94a3b8; font-size: 13px; max-width: 520px; margin: 4px auto 0; }

    /* ---------- change history grid (project QuickGrid) ---------- */
    .ssd .ssd-grid { border-top: 1px solid var(--ssd-line); }
    .ssd .ssd-grid .quickgrid { margin-bottom: 0; }
    .ssd .ssd-grid .grid-box { height: auto; min-height: 0; max-height: calc(100vh - 360px); overflow: auto; border: none; border-radius: 0; margin-bottom: 0; scrollbar-width: thin; }
    .ssd .ssd-grid .grid-box .quickgrid { min-width: 900px; }
    .ssd .ssd-grid .quickgrid thead th { position: sticky; top: 0; z-index: 2; white-space: nowrap; background: #f8fafc; font-size: 12.5px; }
    .ssd .ssd-grid .quickgrid th, .ssd .ssd-grid .quickgrid td { text-align: left; vertical-align: top; }
    .ssd .ssd-grid .quickgrid th .col-header-content { justify-content: flex-start; }
    .ssd .ssd-grid .footer-pagination { padding: 6px 12px; border-top: 1px solid var(--ssd-line); }
    .ssd .ssd-section-head .ssd-filter { margin: 0; }

    /* ---------- review popup (project custom-modal) ---------- */
    .ssd-review-table { max-height: 40vh; overflow: auto; border: 1px solid #e6eaf0; border-radius: 8px; }
    .ssd-table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
    .ssd-table th { text-align: left; font-size: 12px; font-weight: 600; color: #475569; background: #f8fafc; padding: 8px 10px; border-bottom: 1px solid #e6eaf0; position: sticky; top: 0; }
    .ssd-table td { padding: 8px 10px; border-bottom: 1px solid #f0f2f6; vertical-align: top; color: #172033; word-break: break-word; }
    .ssd-old { color: #b42318; text-decoration: line-through; text-decoration-color: rgba(180,35,24,.5); }
    .ssd-new { color: #2f7d57; font-weight: 600; }
    .ssd-empty-val { color: #94a3b8; font-style: italic; }
    .ssd-reason-chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0; }
    .ssd-chip { border: 1px solid #cdd5df; background: #fff; color: #1d3b63; border-radius: 16px; padding: 3px 11px; font-size: 12.5px; font-weight: 600; cursor: pointer; }
    .ssd-chip:hover { background: #1f3a5f; border-color: #1f3a5f; color: #fff; }
    .ssd-note { display: flex; gap: 8px; align-items: flex-start; font-size: 12.5px; color: #475569; background: #f8fafc; border: 1px dashed #d3dae4; border-radius: 8px; padding: 8px 10px; margin-top: 10px; }
    .ssd-filter { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; flex-wrap: wrap; }

    @@media (max-width: 991px) { .ssd .ssd-sections { grid-template-columns: 1fr; } }
    @@media (max-width: 767px) {
        .ssd .ssd-search-box { width: 100%; }
        .ssd .ssd-searchbar-tools { width: 100%; }
        .ssd .ssd-suggest { left: 0; right: auto; width: 100%; }
        .ssd .ssd-fields { grid-template-columns: 1fr; }
        .ssd .ssd-name { font-size: 20px; }
    }
    /* sensitive data must never be printed from this page */
    @@media print { .ssd, .ssd-noprint { display: none !important; } }
</style>

<section class="main-container ssd">
    <div class="row gap-10-0 m-0 main-row">

        @if (!AccessChecked)
        {
            <div class="col-12 p-1">
                <div class="ssd-card ssd-loader"><span>Checking access</span><span class="ssd-spinner" role="status" aria-hidden="true"></span></div>
            </div>
        }
        else if (!HasAccess)
        {
            <div class="col-12 p-1">
                <div class="ssd-card ssd-empty denied">
                    <div>
                        <i class="bi bi-shield-lock"></i>
                        <strong>Access denied</strong>
                        <div>Student sensitive details can be viewed and changed only by roles that have the <b>PII</b> permission on this page (Role Master). Please contact the school administrator.</div>
                    </div>
                </div>
            </div>
        }
        else
        {
            @* ---------- search ---------- *@
            <div class="col-12 p-1">
                <div class="ssd-card ssd-search-card">
                    <div class="ssd-searchbar">
                        <div class="ssd-searchbar-title">
                            <i class="bi bi-shield-lock-fill"></i>
                            <div>
                                <div class="ssd-searchbar-head">@(Details == null ? "Student Sensitive Details" : "Change student")</div>
                                <div class="ssd-searchbar-hint">Type control no. or student name, then press <kbd>Enter</kbd></div>
                            </div>
                        </div>
                        <div class="ssd-searchbar-tools">
                            <div class="form-box">
                                <select class="form-input" value="@CurrentSession" @onchange="OnSessionChanged" title="Session">
                                    <option value="0">-- Select Session --</option>
                                    @foreach (var s in sessionlist.Where(x => x.IsValid))
                                    {
                                        <option value="@s.SessionId">@s.SessionName</option>
                                    }
                                </select>
                            </div>
                            <div class="ssd-search-box">
                                <i class="bi bi-search ssd-search-icon" @onclick="SearchStudent" title="Search"></i>
                                <input @key="searchInputKey" class="form-input w-100 ssd-search-input" placeholder="Control no. or student name" maxlength="200" autocomplete="off"
                                       @bind-Value="searchText" @bind-Value:event="oninput" @bind-Value:after="OnSearchTextChanged" @onkeydown="HandleSearchKeyDown" />
                                @if (!string.IsNullOrEmpty(searchText))
                                {
                                    <button type="button" class="ssd-search-clear" title="Clear" @onclick="ClearSearch"><i class="bi bi-x-lg"></i></button>
                                }
                                @if (ShowSuggestions)
                                {
                                    <div class="ssd-suggest">
                                        @if (IsSearchingStudents)
                                        {
                                            <div class="ssd-loader"><span>Loading students</span><span class="ssd-spinner" role="status" aria-hidden="true"></span></div>
                                        }
                                        else if (suggestions.Count == 0)
                                        {
                                            <div class="ssd-suggest-empty">No matching student found.</div>
                                        }
                                        else
                                        {
                                            @for (int i = 0; i < suggestions.Count; i++)
                                            {
                                                var item = suggestions[i];
                                                var index = i;
                                                <div class="ssd-suggest-item @(index == activeSuggestion ? "active" : "")" @onclick="() => SelectStudent(item)" @onmouseover="() => activeSuggestion = index">
                                                    <div class="ssd-suggest-col"><span class="ssd-suggest-label">Student Name</span><span class="ssd-suggest-value">@Show(item.StudentName)</span></div>
                                                    <div class="ssd-suggest-col"><span class="ssd-suggest-label">Control No.</span><span class="ssd-suggest-value">@Show(item.ControlNo)</span></div>
                                                    <div class="ssd-suggest-col"><span class="ssd-suggest-label">Class</span><span class="ssd-suggest-value">@Show(item.ClassSection)</span></div>
                                                    <div class="ssd-suggest-col"><span class="ssd-suggest-label">Father</span><span class="ssd-suggest-value">@Show(item.FatherName)</span></div>
                                                </div>
                                            }
                                            <div class="ssd-suggest-foot">@suggestions.Count found &middot; <kbd>↑</kbd><kbd>↓</kbd> choose &middot; <kbd>Enter</kbd> open &middot; <kbd>Esc</kbd> close</div>
                                        }
                                    </div>
                                }
                            </div>
                            <button type="button" class="ssd-btn primary" @onclick="SearchStudent"><i class="bi bi-search"></i>Search</button>
                        </div>
                    </div>
                </div>
            </div>

            @if (Details == null)
            {
                <div class="col-12 p-1">
                    <div class="ssd-card ssd-empty">
                        <div>
                            <i class="bi bi-person-lock"></i>
                            <strong>No student selected</strong>
                            <div>Search a student to see and update the full (unmasked) sensitive details of the student and the parents. Everywhere else in SchoolEye these details are masked and read-only.</div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                var h = Details.Header;
                <div class="col-12 p-1">
                    @* ---------- header ---------- *@
                    <div class="ssd-card ssd-head">
                        <div>
                            <h2 class="ssd-name">@Show(h.StudentName)</h2>
                            <div class="ssd-sub">
                                <span>Control No. <b>@Show(h.ControlNo)</b></span>
                                <span>Class <b>@Show(h.ClassSection)</b></span>
                                @if (!string.IsNullOrWhiteSpace(h.FatherName)) { <span>Father <b>@h.FatherName</b></span> }
                                @if (!string.IsNullOrWhiteSpace(h.MotherName)) { <span>Mother <b>@h.MotherName</b></span> }
                            </div>
                            <div class="ssd-badges">
                                <span class="ssd-badge shield"><i class="bi bi-shield-check"></i>DPDP protected – unmasked view</span>
                                <span class="ssd-badge log"><i class="bi bi-journal-text"></i>Every change is logged with old value</span>
                                <span class="ssd-badge noprint"><i class="bi bi-printer"></i>No print / export</span>
                            </div>
                        </div>
                        <div class="ssd-actions">
                            @if (OpenedFromLink)
                            {
                                <button type="button" class="ssd-btn" @onclick="GoBack" title="Back"><i class="bi bi-arrow-left"></i>Back</button>
                            }
                            <button type="button" class="ssd-btn" @onclick="() => ToggleMask()" title="@(MaskValues ? "Show the real values" : "Hide the values (e.g. while screen sharing)")">
                                <i class="bi @(MaskValues ? "bi-eye" : "bi-eye-slash")"></i>@(MaskValues ? "Show values" : "Hide values")
                            </button>
                            <button type="button" class="ssd-btn" @onclick="() => OpenHistory(null)"><i class="bi bi-clock-history"></i>Change History <span class="ssd-count @(TotalChanges == 0 ? "zero" : "")">@TotalChanges</span></button>
                            <button type="button" class="ssd-btn" @onclick="ReloadDetails" title="Reload"><i class="bi bi-arrow-clockwise"></i></button>
                            <div class="ssd-viewer"><i class="bi bi-person-badge"></i> Viewed by @UserName · @ViewedAt.ToString("dd MMM yyyy, HH:mm")</div>
                        </div>
                    </div>
                </div>

                <div class="col-12 p-1">
