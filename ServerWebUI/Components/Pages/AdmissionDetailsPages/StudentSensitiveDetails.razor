                                                    <span class="text-nowrap">@(context.ChangedOn?.ToString("dd MMM yyyy, HH:mm") ?? "-")</span>
                                                </TemplateColumn>
                                                <TemplateColumn Title="Section" Sortable="true" SortBy="@(GridSort<StudentSensitiveHistoryRow>.ByAscending(x => x.FieldKey))">
                                                    @(SensitiveFieldCatalog.Find(context.FieldKey)?.Group ?? "-")
                                                </TemplateColumn>
                                                <TemplateColumn Title="Field">
                                                    @(SensitiveFieldCatalog.Find(context.FieldKey)?.Label ?? context.FieldKey)
                                                </TemplateColumn>
                                                <TemplateColumn Title="Old Value">
                                                    <span class="ssd-old">@ShowValue(MaskValues ? SensitiveFieldCatalog.Mask(context.FieldKey ?? "", context.OldValue) : context.OldValue)</span>
                                                </TemplateColumn>
                                                <TemplateColumn Title="New Value">
                                                    <span class="ssd-new">@ShowValue(MaskValues ? SensitiveFieldCatalog.Mask(context.FieldKey ?? "", context.NewValue) : context.NewValue)</span>
                                                </TemplateColumn>
                                                <TemplateColumn Title="Changed By" Sortable="true" SortBy="@(GridSort<StudentSensitiveHistoryRow>.ByAscending(x => x.ChangedBy))">
