                                                    <button type="button" class="ssd-undo" @onclick='() => UndoField("StudentBankAccount")'><i class="bi bi-arrow-counterclockwise"></i> Undo</button>
                                                }
                                                else
                                                {
                                                    <span>@LastChangedText("StudentBankAccount")</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="ssd-field @FieldCss("IFSC")">
                                            <label class="ssd-label" for="ssd-IFSC">
                                                <span>IFSC Code @if (IsChanged("IFSC")) { <span class="ssd-edited">&middot; edited</span> }</span>
                                                <button type="button" class="ssd-count @CountCss("IFSC")" title="@CountTitle("IFSC")" disabled="@(ChangeCount("IFSC") == 0)" @onclick='() => OpenHistory("IFSC")'><i class="bi bi-arrow-repeat"></i> @ChangeCount("IFSC")&times;</button>
                                            </label>
                                            @if (MaskValues)
                                            {
                                                <input id="ssd-IFSC" class="ssd-input masked" value="@Masked("IFSC", form.IFSC)" readonly title="Values are hidden. Click 'Show values' to edit." />
                                            }
                                            else
                                            {
                                                <input id="ssd-IFSC" class="ssd-input" maxlength="11" autocomplete="off" style="text-transform:uppercase" oninput="this.value=this.value.toUpperCase().replace(/[^A-Z0-9]/g,'')" @bind="form.IFSC" @bind:after='() => OnFieldChanged("IFSC")' />
                                            }
                                            <div class="ssd-meta">
                                                @if (Errors.ContainsKey("IFSC"))
                                                {
                                                    <span class="ssd-err"><i class="bi bi-exclamation-circle"></i> @Errors["IFSC"]</span>
                                                }
                                                else if (IsChanged("IFSC"))
                                                {
                                                    <span>Saved: <b>@ShowValue(original.IFSC)</b></span>
                                                    <button type="button" class="ssd-undo" @onclick='() => UndoField("IFSC")'><i class="bi bi-arrow-counterclockwise"></i> Undo</button>
                                                }
                                                else
                                                {
                                                    <span>@LastChangedText("IFSC")</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (Edits.Count > 0)
                        {
                            <div class="ssd-savebar">
                                <div class="txt">
                                    <i class="bi bi-pencil-square fs-5"></i>
                                    <div>
                                        @Edits.Count change(s) not saved
                                        <small>@(Errors.Count > 0 ? $"{Errors.Count} field(s) need correction" : "Review the changes, give a reason and save")</small>
                                    </div>
                                </div>
                                <div class="d-flex gap-2">
                                    <button type="button" class="ssd-btn" @onclick="DiscardAll"><i class="bi bi-x-circle"></i>Discard</button>
                                    <button type="button" class="ssd-btn primary" @onclick="OpenReview" disabled="@(Errors.Count > 0)"><i class="bi bi-check2-circle"></i>Review &amp; Save</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</section>

@* ---------- review + reason (project custom modal + SaveUpdateButton) ---------- *@
@if (ShowReview && Details != null)
{
