@code {
    // /StudentSensitiveDetails?StudentNo=...&SessionId=... opens the student straight away
    [Parameter]
    [SupplyParameterFromQuery(Name = "StudentNo")]
    public string? QueryStudentNo { get; set; }
    [Parameter]
    [SupplyParameterFromQuery(Name = "SessionId")]
    public long QuerySessionId { get; set; }
    [Parameter]
    [SupplyParameterFromQuery(Name = "ReturnUrl")]
    public string? QueryReturnUrl { get; set; }

    // tabs (Change History is the last tab, after Bank)
    private const string TabStudent = "student";
    private const string TabParents = "parents";
    private const string TabGuardian = "guardian";
    private const string TabAddress = "address";
    private const string TabBank = "bank";
    private const string TabHistory = "history";

    // fields of each tab (for the "changed, not saved" count on the tab)
    private static readonly Dictionary<string, string[]> TabFields = new()
    {
        [TabStudent] = new[] { "DateOfBirth", "AadhaarNo", "MobileNo", "EmailId", "BloodGroup", "MedicalInformation", "NatureOfDisability" },
        [TabParents] = new[] { "FatherContactNo", "FatherEMail", "FatherAadhaarNo", "FatherDOB", "FatherAnnualIncome", "FatherOfficeContactNo", "FatherOfficeAddress",
                               "MotherContactNo", "MotherEMail", "MotherAadhaarNo", "MotherDOB", "MotherAnnualIncome", "MotherOfficeContactNo", "MotherOfficeAddress" },
        [TabGuardian] = new[] { "SMSMobileNo", "GuardianContactNo", "GuardianEmail", "GuardianAddress", "EmergencyPersonContactNo", "EmergencyPersonAddress" },
        [TabAddress] = new[] { "CurrentLine1", "CurrentLine2", "CurrentPinCode", "CurrentContactNo", "PermanentLine1", "PermanentLine2", "PermanentPinCode", "PermanentContactNo" },
        [TabBank] = new[] { "StudentBankAccount", "IFSC" }
    };

    // one property per sensitive field (property name = field key of the API / SP); bound straight to the inputs
    private class StudentSensitiveForm
    {
        public DateTime? DateOfBirth { get; set; }
        public string? AadhaarNo { get; set; }
        public string? MobileNo { get; set; }
        public string? EmailId { get; set; }
        public string? BloodGroup { get; set; }
        public string? MedicalInformation { get; set; }
        public string? NatureOfDisability { get; set; }

        public string? FatherContactNo { get; set; }
        public string? FatherEMail { get; set; }
        public string? FatherAadhaarNo { get; set; }
        public DateTime? FatherDOB { get; set; }
        public string? FatherAnnualIncome { get; set; }
        public string? FatherOfficeContactNo { get; set; }
        public string? FatherOfficeAddress { get; set; }

        public string? MotherContactNo { get; set; }
        public string? MotherEMail { get; set; }
        public string? MotherAadhaarNo { get; set; }
        public DateTime? MotherDOB { get; set; }
        public string? MotherAnnualIncome { get; set; }
        public string? MotherOfficeContactNo { get; set; }
        public string? MotherOfficeAddress { get; set; }

        public string? SMSMobileNo { get; set; }
        public string? GuardianContactNo { get; set; }
        public string? GuardianEmail { get; set; }
        public string? GuardianAddress { get; set; }
        public string? EmergencyPersonContactNo { get; set; }
        public string? EmergencyPersonAddress { get; set; }

        public string? CurrentLine1 { get; set; }
        public string? CurrentLine2 { get; set; }
        public string? CurrentPinCode { get; set; }
        public string? CurrentContactNo { get; set; }
        public string? PermanentLine1 { get; set; }
        public string? PermanentLine2 { get; set; }
        public string? PermanentPinCode { get; set; }
        public string? PermanentContactNo { get; set; }

        public string? StudentBankAccount { get; set; }
        public string? IFSC { get; set; }

        private static readonly string[] DateFormats = { "yyyy-MM-dd", "dd-MM-yyyy", "dd/MM/yyyy", "yyyy-MM-ddTHH:mm:ss" };

        public StudentSensitiveForm Copy() => (StudentSensitiveForm)MemberwiseClone();

        // field value as text (dates yyyy-MM-dd, same as the API)
        public string? Get(string key) => typeof(StudentSensitiveForm).GetProperty(key)?.GetValue(this) switch
        {
            DateTime d => d.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture),
            string s => s,
            _ => null
        };

        public void Set(string key, string? value)
        {
            var prop = typeof(StudentSensitiveForm).GetProperty(key);
            if (prop == null) return;
            // HttpService (DateStringConverter) turns the API's yyyy-MM-dd into the app format dd-MM-yyyy, so read both
            if (prop.PropertyType == typeof(DateTime?))
                prop.SetValue(this, DateTime.TryParseExact(value?.Trim(), DateFormats, System.Globalization.CultureInfo.InvariantCulture,
                    System.Globalization.DateTimeStyles.None, out var d) ? d : null);
            else
                prop.SetValue(this, value);
        }
    }

    private static readonly string[] ReasonChips =
    {
        "Parent request (written)", "Correction of wrong entry", "Document verification", "UDISE / Board submission", "TC / Certificate"
    };

    private bool AccessChecked;
    private bool HasAccess;
    private bool OpenedFromLink;
    private bool IsLoading;
    private bool MaskValues;
    private string ActiveTab = TabStudent;
    private string Today => DateTime.Today.ToString("yyyy-MM-dd");

    private string? groupcode;
    private string? branchcode;
    private string? UserName;
    private long CurrentSession;
    private List<SessionModel> sessionlist = new();
    private DateTime ViewedAt = DateTime.Now;

    // search
    private string? searchText;
    private string searchInputKey = Guid.NewGuid().ToString();
    private bool ShowSuggestions;
    private bool IsSearchingStudents;
    private int activeSuggestion = -1;
    private List<StudentLedgerChallanMiniDetailsResponse> suggestions = new();
    private CancellationTokenSource? typingCts;

    // data (raw values live only in this server-side component; cleared on Dispose)
    private StudentSensitiveDetailsResponse? Details;
    private Dictionary<string, StudentSensitiveField> FieldMap = new();
    private StudentSensitiveForm original = new();   // values as saved
    private StudentSensitiveForm form = new();       // values on screen (bound)
    private Dictionary<string, string?> Edits = new();
    private Dictionary<string, string> Errors = new();

    // review / save
    private bool ShowReview;
    private bool IsSaving;
    private string? SaveReason;
    private string? ReasonError;

    // history
    private PaginationState historyPagination = new() { ItemsPerPage = 15 };
    private bool IsHistoryLoading;
    private string HistoryField = "";
    private List<StudentSensitiveHistoryRow> historyRows = new();

    private int TotalChanges => FieldMap.Values.Sum(x => x.ChangeCount);

    // ======================= lifecycle =======================

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) 
        return;
        OpenedFromLink = !string.IsNullOrWhiteSpace(QueryStudentNo);

        groupcode = (await sessionStorage.GetAsync<string>("GroupCode")).Value;
        branchcode = (await sessionStorage.GetAsync<string>("BranchCode")).Value;
        UserName = (await sessionStorage.GetAsync<string>("UserName")).Value;

        // the API decides (role PII tick checked in the database); null = denied / failed
        var access = await httpService.Post<ApiResponse<bool>>("StudentSensitiveDetails/CheckAccess",
            new StudentSensitiveAccessRequest { GroupCode = groupcode ?? "", BranchCode = branchcode ?? "" });
        HasAccess = access?.Success == true && access.Data;
        AccessChecked = true;
        StateHasChanged();
        if (!HasAccess) return;

        sessionlist = await httpService.Get<List<SessionModel>>("Session/GetSession") ?? new();
        CurrentSession = QuerySessionId > 0 ? QuerySessionId : await _commonmethod.SetCurrentSessionData();

        if (!string.IsNullOrWhiteSpace(QueryStudentNo))
        {
            searchText = QueryStudentNo.Trim();
            searchInputKey = Guid.NewGuid().ToString();
            IsLoading = true;
            StateHasChanged();
            var results = await FetchStudents(searchText);
            IsLoading = false;
            var match = results.FirstOrDefault(x => string.Equals(x.ControlNo, searchText, StringComparison.OrdinalIgnoreCase))
                        ?? (results.Count == 1 ? results[0] : null);
            if (match != null)
                await SelectStudent(match);
        }
        StateHasChanged();
    }

    public void Dispose()
    {
        typingCts?.Cancel();
        typingCts?.Dispose();
        ClearStudentData();
    }

    private void ClearStudentData()
    {
        Details = null;
        FieldMap = new();
        original = new();
        form = new();
        Edits = new();
        Errors = new();
        historyRows = new();
        HistoryField = "";
        SaveReason = null;
    }

    private void GoBack()
    {
        var target = !string.IsNullOrWhiteSpace(QueryReturnUrl) && QueryReturnUrl.StartsWith("/") && !QueryReturnUrl.StartsWith("//")
            ? QueryReturnUrl : "/viewstudent";
        Nav.NavigateTo(target);
    }

    // ======================= search (same as Student Fee Account) =======================

    private async Task<List<StudentLedgerChallanMiniDetailsResponse>> FetchStudents(string term)
    {
        var request = new StudentLedgerChallanMiniDetailsRequest
        {
            GroupCode = groupcode,
            BranchCode = branchcode,
            SessionId = CurrentSession,
            ControlNo = string.Empty,
            StudentName = string.Empty
        };
        if (term.Any(char.IsDigit))
            request.ControlNo = term;
        else
            request.StudentName = term;

        var response = await httpService.Post<ApiResponse<List<StudentLedgerChallanMiniDetailsResponse>>>("StudentFee/GetStudentLedgerChallanMiniDetails", request);
        return (response != null && response.Success && response.Data != null) ? response.Data : new();
    }

    private async Task OnSearchTextChanged()
    {
        typingCts?.Cancel();
        var term = searchText?.Trim() ?? "";
        if (term.Length < 3 || CurrentSession <= 0)
        {
            ShowSuggestions = false;
            suggestions = new();
            return;
        }

        var cts = typingCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(400, cts.Token);
            IsSearchingStudents = true;
            ShowSuggestions = true;
            StateHasChanged();
            var results = await FetchStudents(term);
            if (cts.IsCancellationRequested) return;
            suggestions = results;
            activeSuggestion = results.Count > 0 ? 0 : -1;
        }
        catch (TaskCanceledException) { }
        catch (Exception)
        {
            ShowSuggestions = false;
        }
        finally
        {
            if (!cts.IsCancellationRequested)
            {
                IsSearchingStudents = false;
                StateHasChanged();
            }
        }
    }

    private async Task SearchStudent()
    {
        typingCts?.Cancel();
        var term = searchText?.Trim();
        if (string.IsNullOrWhiteSpace(term))
        {
            await Alert.ShowWarning("Please enter student name or control no to search.");
            return;
        }
        if (CurrentSession <= 0)
        {
            await Alert.ShowWarning("Please select a session.");
            return;
        }

        try
        {
            suggestions = new();
            activeSuggestion = -1;
            IsSearchingStudents = true;
            ShowSuggestions = true;
            StateHasChanged();

            var results = await FetchStudents(term);
            IsSearchingStudents = false;
            if (results.Count == 1)
            {
                ShowSuggestions = false;
                await SelectStudent(results[0]);
                return;
            }
            suggestions = results;
            activeSuggestion = results.Count > 0 ? 0 : -1;
            ShowSuggestions = true;
            if (results.Count == 0)
                await Alert.ShowWarning("No student found.");
        }
        catch (Exception)
        {
            ShowSuggestions = false;
        }
        finally
        {
            IsSearchingStudents = false;
            StateHasChanged();
        }
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown" when ShowSuggestions && suggestions.Count > 0:
                activeSuggestion = (activeSuggestion + 1) % suggestions.Count;
                break;
            case "ArrowUp" when ShowSuggestions && suggestions.Count > 0:
                activeSuggestion = activeSuggestion <= 0 ? suggestions.Count - 1 : activeSuggestion - 1;
                break;
            case "Escape":
                ShowSuggestions = false;
                break;
            case "Enter":
                if (ShowSuggestions && activeSuggestion >= 0 && activeSuggestion < suggestions.Count)
                    await SelectStudent(suggestions[activeSuggestion]);
                else
                    await SearchStudent();
                break;
        }
    }

    private void ClearSearch()
    {
        typingCts?.Cancel();
        searchText = string.Empty;
        searchInputKey = Guid.NewGuid().ToString();
        ShowSuggestions = false;
        suggestions = new();
        activeSuggestion = -1;
    }

    private void OnSessionChanged(ChangeEventArgs e)
    {
        long.TryParse(e.Value?.ToString(), out var sessionId);
        CurrentSession = sessionId;
        ShowSuggestions = false;
    }

    private async Task SelectStudent(StudentLedgerChallanMiniDetailsResponse item)
    {
        typingCts?.Cancel();
        ShowSuggestions = false;
        suggestions = new();

        if (Edits.Count > 0 && Details != null && Details.Header.StudentId != item.StudentId
            && !await Alert.ShowConfirm($"You have {Edits.Count} unsaved change(s) for {Details.Header.StudentName}. Discard them and open another student?"))
            return;

        searchText = string.Empty;
        searchInputKey = Guid.NewGuid().ToString();
        Nav.NavigateTo($"/StudentSensitiveDetails?StudentNo={Uri.EscapeDataString(item.ControlNo ?? "")}&SessionId={CurrentSession}"
                       + (string.IsNullOrWhiteSpace(QueryReturnUrl) ? "" : $"&ReturnUrl={Uri.EscapeDataString(QueryReturnUrl)}"), replace: true);
        await LoadDetails(item.StudentId);
    }

    // ======================= data =======================

    private async Task ReloadDetails()
    {
        if (Details == null) return;
        if (Edits.Count > 0 && !await Alert.ShowConfirm($"Reload will discard {Edits.Count} unsaved change(s). Continue?"))
            return;
        await LoadDetails(Details.Header.StudentId);
    }

    private async Task LoadDetails(long studentId)
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            var request = new StudentSensitiveDetailsRequest
            {
                GroupCode = groupcode ?? "",
                BranchCode = branchcode ?? "",
                SessionId = CurrentSession,
                StudentId = studentId
            };
            var response = await httpService.Post<ApiResponse<StudentSensitiveDetailsResponse>>("StudentSensitiveDetails/GetDetails", request);
            ClearStudentData();
            if (response?.Success == true && response.Data != null)
            {
                Details = response.Data;
                FieldMap = Details.Fields.GroupBy(x => x.FieldKey).ToDictionary(x => x.Key, x => x.First());
                foreach (var f in Details.Fields)
                    original.Set(f.FieldKey, NormalizeLoaded(f.FieldKey, f.FieldValue));
                form = original.Copy();
                ViewedAt = DateTime.Now;
            }
            else
            {
                await Alert.ShowError("Unable to load the student's sensitive details. The student may not exist in this branch or you may not have access.");
            }
        }
        catch (Exception)
        {
            await Alert.ShowError("Unable to load the student's sensitive details.");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }

        // Change History tab open (new student / after save): refresh its grid too
        if (Details != null && ActiveTab == TabHistory)
            await LoadHistory();
    }

    // ======================= fields =======================

    private StudentSensitiveField FieldState(string key) =>
        FieldMap.TryGetValue(key, out var f) ? f : new StudentSensitiveField { FieldKey = key };

    private bool IsChanged(string key) => Edits.ContainsKey(key);

    private int ChangeCount(string key) => FieldState(key).ChangeCount;

    private string FieldCss(string key) => IsChanged(key) ? "changed" : Errors.ContainsKey(key) ? "invalid" : "";

    private string CountCss(string key) => ChangeCount(key) == 0 ? "zero" : "";

    private string CountTitle(string key) =>
        ChangeCount(key) == 0 ? "Never changed" : $"Changed {ChangeCount(key)} time(s) - click for history";

    private string LastChangedText(string key)
    {
        var info = FieldState(key);
        if (!info.LastChangedOn.HasValue) return "";
        return $"Last changed {info.LastChangedOn.Value:dd MMM yyyy, HH:mm}" + (string.IsNullOrWhiteSpace(info.LastChangedBy) ? "" : $" by {info.LastChangedBy}");
    }

    private static string Masked(string key, string? value) => SensitiveFieldCatalog.Mask(key, value);

    private static bool IsOldBloodGroup(string? value) =>
        !string.IsNullOrWhiteSpace(value) && !SensitiveFieldCatalog.BloodGroups.Contains(value);

    private int PendingCount(string tab) =>
        TabFields.TryGetValue(tab, out var keys) ? keys.Count(k => Edits.ContainsKey(k)) : 0;

    private string GuardianSubTitle
    {
        get
        {
            var h = Details?.Header;
            var parts = new List<string>();
            if (!string.IsNullOrWhiteSpace(h?.GuardianName)) parts.Add($"Guardian: {h.GuardianName}");
            if (!string.IsNullOrWhiteSpace(h?.EmergencyPersonName)) parts.Add($"Emergency: {h.EmergencyPersonName}");
            return parts.Count > 0 ? string.Join(" · ", parts) : "SMS number, guardian and emergency contact";
        }
    }

    // saved values in the same form the inputs use (date inputs need yyyy-MM-dd, income without decimals)
    private static string? NormalizeLoaded(string key, string? value)
    {
        var field = SensitiveFieldCatalog.Find(key);
        if (field == null || string.IsNullOrWhiteSpace(value)) return value;
        if (field.Type == SensitiveFieldType.Amount && decimal.TryParse(value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var amt))
            return decimal.Truncate(amt).ToString(System.Globalization.CultureInfo.InvariantCulture);
        return value;
    }

    // after every bound input: compare with the saved value, keep the change list + validation up to date
    private void OnFieldChanged(string key)
    {
        var field = SensitiveFieldCatalog.Find(key);
        if (field == null) return;

        var raw = form.Get(key);
        var normalized = SensitiveFieldCatalog.Normalize(field, raw);
        var saved = SensitiveFieldCatalog.Normalize(field, original.Get(key));

        if (string.Equals(normalized ?? "", saved ?? "", StringComparison.Ordinal))
        {
            Edits.Remove(key);
            Errors.Remove(key);
            return;
        }

        Edits[key] = raw?.Trim();
        var error = SensitiveFieldCatalog.Validate(field, normalized);
        if (error == null) Errors.Remove(key);
        else Errors[key] = error;
    }

    private void UndoField(string key)
    {
        form.Set(key, original.Get(key));
        Edits.Remove(key);
        Errors.Remove(key);
    }

    private async Task DiscardAll()
    {
        if (!await Alert.ShowConfirm($"Discard {Edits.Count} unsaved change(s)?")) return;
        form = original.Copy();
        Edits.Clear();
        Errors.Clear();
    }

    private void ToggleMask() => MaskValues = !MaskValues;

    // ======================= save =======================

    private void OpenReview()
    {
        if (Edits.Count == 0 || Errors.Count > 0) return;
        ReasonError = null;
        ShowReview = true;
    }

    private void CloseReview()
    {
        if (IsSaving) return;
        ShowReview = false;
    }

    private async Task SaveChanges()
    {
        if (Details == null || IsSaving) return;

        var reason = SaveReason?.Trim() ?? "";
        if (reason.Length < 5)
        {
            ReasonError = "Enter the reason (at least 5 characters).";
            return;
        }
        ReasonError = null;

        // validate once more with the shared rules (the API checks again)
        foreach (var (key, value) in Edits)
        {
            var f = SensitiveFieldCatalog.Find(key)!;
            var error = SensitiveFieldCatalog.Validate(f, SensitiveFieldCatalog.Normalize(f, value));
            if (error != null) Errors[key] = error;
        }
        if (Errors.Count > 0)
        {
            ShowReview = false;
            await Alert.ShowWarning("Please correct the highlighted fields.");
            return;
        }

        IsSaving = true;
        StateHasChanged();
        try
        {
            var request = new StudentSensitiveUpdateRequest
            {
                GroupCode = groupcode ?? "",
                BranchCode = branchcode ?? "",
                SessionId = CurrentSession,
                StudentId = Details.Header.StudentId,
                Reason = reason,
                Changes = Edits.Select(x => new StudentSensitiveFieldChange { FieldKey = x.Key, NewValue = x.Value }).ToList()
            };
            var response = await httpService.Post<ApiResponse<StudentSensitiveUpdateResult>>("StudentSensitiveDetails/Update", request);

            if (response?.Success == true)
            {
                ShowReview = false;
                SaveReason = null;
                await Alert.ShowSuccess(response.Message ?? "Saved successfully.");
                await LoadDetails(Details.Header.StudentId);
            }
            else if (response != null && response.Code == 3)
            {
                ShowReview = false;
                Edits.Clear();
                Errors.Clear();
                await Alert.ShowWarning(response.Message ?? "Nothing to update.");
            }
            else
            {
                await Alert.ShowError(response?.Message ?? "Unable to save the changes. Please check the values and try again.");
            }
        }
        catch (Exception)
        {
            await Alert.ShowError("Unable to save the changes right now. Please try again.");
        }
        finally
        {
            IsSaving = false;
            StateHasChanged();
        }
    }

    // ======================= history =======================

    // field badge / header button -> Change History tab (filtered to that field)
    private async Task OpenHistory(string? fieldKey)
    {
        HistoryField = fieldKey ?? "";
        ActiveTab = TabHistory;
        await LoadHistory();
    }

    private async Task OnTabClick(string key)
    {
        ActiveTab = key;
        if (key == TabHistory)
            await LoadHistory();
    }

    private async Task OnHistoryFieldChanged(ChangeEventArgs e)
    {
        HistoryField = e.Value?.ToString() ?? "";
        await LoadHistory();
    }

    private async Task LoadHistory()
    {
        if (Details == null) return;
        IsHistoryLoading = true;
        StateHasChanged();
        try
        {
            var request = new StudentSensitiveDetailsRequest
            {
                GroupCode = groupcode ?? "",
                BranchCode = branchcode ?? "",
                SessionId = CurrentSession,
                StudentId = Details.Header.StudentId,
                FieldKey = string.IsNullOrWhiteSpace(HistoryField) ? null : HistoryField
            };
            var response = await httpService.Post<ApiResponse<List<StudentSensitiveHistoryRow>>>("StudentSensitiveDetails/GetHistory", request);
            historyRows = response?.Success == true && response.Data != null ? response.Data : new();
            await historyPagination.SetCurrentPageIndexAsync(0);
        }
        catch (Exception)
        {
            historyRows = new();
        }
        finally
        {
            IsHistoryLoading = false;
            StateHasChanged();
        }
    }

    // ======================= helpers =======================

    private static string Show(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static MarkupString ShowValue(string? value) =>
        string.IsNullOrWhiteSpace(value)
            ? new MarkupString("<span class=\"ssd-empty-val\">(empty)</span>")
            : new MarkupString(System.Net.WebUtility.HtmlEncode(value));
}
