@page "/ViewRTEStudent"
@using DomainModel.Admin
@using DomainModel.SchoolMaster
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyApp.Common
@using Microsoft.AspNetCore.Authorization
@using ServerWebUI.Components.Pages.CommonPages
@inject Shared.IHttpService httpService
@inject IJSRuntime JS
@inject HttpClient Http
@inject IStringLocalizer<Resource> Localizer
@inject SweetAlertService Alert
@inject ICommonMethod _commonmethod
@rendermode InteractiveServer

<div class="main-container">
    <div class="row m-0 main-row">
        <div class="col-12 p-1" id="main-header">
            <PageHeading Tittle="View RTE Student Data">
                <div class="form-box">
                    <InputSelect class="form-input" @bind-Value="@CurrentSession" name="session">
                        <option value="0" selected>Select-Session</option>
                        @foreach (var data in sessionlist.Where(x => x.IsValid))
                        {
                            <option value="@data.SessionId">@data.SessionName</option>
                        }
                    </InputSelect>
                </div>
                    <div class="form-box">
                        <div class="border-box d-flex justify-content-center align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                <input type="checkbox"class="form-check-input m-0" checked="@(searchRequest.IsRTE == 1)"   @onchange="OnRteChanged" />
                                <label class="form-label mb-0">
                                    Is RTE
                                </label>
                            </div>
                        </div>
                    </div>
                <div class="form-box">
                    <button class="icon-btn icon-btn-white open-popup" @onclick="OpenSearch" data-id="popup" tabindex="0">
                        <i class="bi bi-sliders"></i>
                    </button>
                </div>
                <div class="form-box">
                    <button class="ui fade op-1 animated button form-btn" tabindex="0" @onclick="SearchStudents">
                        <div class="visible content">Search</div>
                        <div class="hidden content">
                            <i class="bi bi-search"></i>
                        </div>
                    </button>
                </div>
            </PageHeading>
        </div>

        <div class="col-12 p-1">
            <div class="card">
                <div class="card-body table-card p-0">
                    <div class="quick-main">
                        <div class="grid-box-with-btn">
                            <QuickGrid Items="@moduleQuery" Class="table" Pagination="@pagination">
                                <TemplateColumn Title="" Align="Align.Center">
                                    <HeaderTemplate>
                                        <div class="d-flex align-items-center justify-content-center">
                                            <input type="checkbox" @bind="IsAllSelected" @bind:after="ToggleAll" @onclick:stopPropagation="true" />
                                        </div>
                                    </HeaderTemplate>
                                    <ChildContent>
                                        <div class="d-flex align-items-center justify-content-center">
                                            <input type="checkbox" @bind="context.IsSelected" @onclick:stopPropagation="true" />
                                        </div>
                                    </ChildContent>
                                </TemplateColumn>
                                <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.ControlNo) ? " " : x.ControlNo)" Title="Student No" Sortable="true" Align="Align.Left">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="Search..." />
                                        </div>
                                    </ColumnOptions>
                                </PropertyColumn>
                                <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.StudentName) ? " " : x.StudentName)" Title="Name" Sortable="true" Align="Align.Left">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="Search..." />
                                        </div>
                                    </ColumnOptions>
                                </PropertyColumn>
                                <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.ClassName) ? " " : x.ClassName)" Title="Class" Class="text-center" Align="Align.Center" />
                                <TemplateColumn Title="Bank Name" Align="Align.Left">
                                    <ChildContent>
                                        <input class="form-input" @bind="context.BankName" @bind:event="oninput" placeholder=" " />
                                    </ChildContent>
                                </TemplateColumn>
                                <TemplateColumn Title="Account No" Align="Align.Left">
                                    <ChildContent>
                                        <input class="form-input" @bind="context.AccountNumber" @bind:event="oninput" placeholder=" " />
                                    </ChildContent>
                                </TemplateColumn>
                                <TemplateColumn Title="IFSC Code" Align="Align.Left">
                                    <ChildContent>
                                        <input class="form-input" @bind="context.IFSCCODE" @bind:event="oninput" placeholder=" " />
                                    </ChildContent>
                                </TemplateColumn>
                                <TemplateColumn Title="Account Holder Name" Align="Align.Left">
                                    <ChildContent>
                                        <input class="form-input" @bind="context.AccountHolderName" @bind:event="oninput" placeholder=" " />
                                    </ChildContent>
                                </TemplateColumn>
                                <TemplateColumn Title="RTE Category" Class="text-center" Align="Align.Center">
                                    <ChildContent>
                                        <select class="form-input" @bind="context.StudentRTECategory">
                                            <option value="0">--Select--</option>
                                            @foreach (var cat in categorylist)
                                            {
                                                <option value="@cat.CategoryId">@cat.CategoryName</option>
                                            }
                                        </select>
                                    </ChildContent>
                                </TemplateColumn>
                                <TemplateColumn Title="RTE Sub Category" Class="text-center" Align="Align.Center">
                                    <ChildContent>
                                        <select class="form-input" @bind="context.StudentRTESubCategory">
                                            <option value="0">Please select a item.</option>
                                            <option value="1">Income Below One Lakh</option>
                                            <option value="2">Disabled Child / Widow Parent / Old Parents</option>
                                            <option value="3">Parents Below Poverty Line</option>
                                        </select>
                                    </ChildContent>
                                </TemplateColumn>
                            </QuickGrid>
                        </div>
                        <div class="footer-pagination">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="welcome-text w-100">
                                    <Paginator State="@pagination" />
                                </div>
                                
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 p-1">
            <div class="page-heading d-flex align-items-center justify-content-end">
                <div class="d-flex align-items-center gap-2">
                    <div class="form-box">
                        <button type="button" class="table-btn" @onclick="OnSubmit">Submit</button>
                    </div>
                
                    <AdmitChildButton CurrentUrl="@currentUrl" ButtonText="Print List" Print="@OnPrint" />
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===================== SEARCH POPUP (fixed size per Rule A5) ===================== -->
@if (ShowSearchPopup)
{
    <div class="custom-modal row m-0">
        <div class="col-12 col-sm-7 col-md-5 col-lg-4 col-xl-9">
            <div class="modal-content clearfix main-popup">
                <div class="head-btn">
                    <h5 class="modal-title">Search</h5>
                    <button data-access="Close" type="button" @onclick="ClosePopup" class="close"><span aria-hidden="true">×</span></button>
                </div>
                <div class="modal-body">
                    <div class="row m-0 form-row">
                        <div class="col-12 col-lg-4 px-2">
                            <div class="form-box-group static-label">
                                <InputSelect class="floating-input" placeholder=" " @bind-Value="searchRequest.ClassCode" @bind-Value:after="OnSearchClassChanged">
                                    <option value="">All</option>
                                    @foreach (var cs in classlist.Where(x => x.IsValid == true))
                                    {
                                        <option value="@cs.ClassCode">@cs.ClassName</option>
                                    }
                                </InputSelect>
                                <label class="floating-label">Class</label>
                            </div>
                        </div>
                        <div class="col-12 col-lg-4 px-2">
                            <div class="form-box-group static-label">
                                <InputSelect class="floating-input" placeholder=" " @bind-Value="searchRequest.SectionCode">
                                    <option value="">All</option>
                                    @foreach (var sec in sectionlist)
                                    {
                                        <option value="@sec.SectionId">@sec.SectionName</option>
                                    }
                                </InputSelect>
                                <label class="floating-label">Section</label>
                            </div>
                        </div>
                        <div class="col-12 col-lg-4 px-2">
                            <div class="form-box-group static-label">
                                <InputSelect class="floating-input" placeholder=" " @bind-Value="searchRequest.Status">
                                    <option value="2">All</option>
                                    <option value="1">Active</option>
                                    <option value="0">Inactive</option>
                                </InputSelect>
                                <label class="floating-label">Status</label>
                            </div>
                        </div>
                        <div class="col-12 col-lg-4 px-2">
                            <div class="form-box-group static-label">
                                <InputSelect class="floating-input" placeholder=" " @bind-Value="searchRequest.RTECategory">
                                    <option value="0">All</option>
                                    @foreach (var cat in categorylist)
                                    {
                                        <option value="@cat.CategoryId">@cat.CategoryName</option>
                                    }
                                </InputSelect>
                                <label class="floating-label">RTE Category</label>
                            </div>
                        </div>
                        <div class="col-12 col-lg-4 px-2">
                            <div class="form-box-group">
                                <InputText class="floating-input" placeholder=" " @bind-Value="searchRequest.AdmissionNo" />
                                <label class="floating-label">Student No.</label>
                            </div>
                        </div>
                        <div class="col-12 col-lg-4 px-2">
                            <div class="form-box-group">
                                <InputText class="floating-input" placeholder=" " @bind-Value="searchRequest.StudentName" />
                                <label class="floating-label">First Name</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="ui fade op-1 animated button form-btn" @onclick="SearchStudents" tabindex="0">
                        <div class="visible content">Search</div>
                        <div class="hidden content">
                            <i class="bi bi-search"></i>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (IsLoading)
{
    <div class="grid-loader-overlay">
        <img src="images/loading.gif" alt="Loading..." />
    </div>
}
else
{

}

@code {
    // ---------------------------------------------------------------------
    // ASSUMPTIONS (adjust if different in your project):
    // - StudentRTEResponse fields assumed: StudentId (long, used as the id
    //   in StudentDetails), StudentNo, StudentName, ClassName, BankName,
    //   AccountNo, IFSCCode, AccountHolderName, RTECategoryId,
    //   RTESubCategoryId, IsSelected (bool - add if not already there).
    // - "RTE Category" (grid column + search filter) is loaded from
    //   Category/GetCategory -> RTECategoryModel (CategoryId/CategoryName).
    // - "RTE Sub Category" (grid column only) is static per your list:
    //   1=Income Below One Lakh, 2=Disabled Child/Widow Parent/Old Parents,
    //   3=Parents Below Poverty Line.
    // - Status: "0"=Inactive, "1"=Active, "2"=All (default "1" per screenshot).
    // - StudentDetails format per selected row:
    //   StudentId|AccountNo|BankName|IFSCCode|AccountHolderName|RTECategoryId|RTESubCategoryId
    //   joined with "~" between students.
    // - "Print" has no endpoint specified, so it's a button stub (TODO).
    // ---------------------------------------------------------------------

    private List<SessionModel> sessionlist = new();
    private List<BranchClassModel> classlist = new();
    private List<SectionModel> sectionlist = new();
    private List<RTECategoryModel> categorylist = new();
    private List<StudentRTEResponse> studentlist = new();

    private StudentRTERequest searchRequest = new();
    private SearchAnyRequestModel searchAny = new();

    private bool ShowSearchPopup;
    private bool IsAllSelected;

    private PaginationState pagination = new() { ItemsPerPage = 15 };

    private long CurrentSession;
    private bool IsLoading = false;
    private string? nameFilter;

    private string? branchcode;
    private string? groupcode;
    private string username = string.Empty;
    private string currentUrl = "";

    protected IQueryable<StudentRTEResponse> moduleQuery
    {
        get
        {
            var result = studentlist.AsQueryable();
            if (!string.IsNullOrEmpty(nameFilter))
            {
                result = result.Where(x =>
                    (x.ControlNo != null && x.ControlNo.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)) ||
                    (x.StudentName != null && x.StudentName.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)));
            }
            return result;
        }
    }

    protected override void OnInitialized()
    {
        PermissionState.OnChange += StateHasChanged;
        currentUrl = Nav.Uri;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CurrentSession = await _commonmethod.SetCurrentSessionData();

            var userResult = await sessionStorage.GetAsync<string>("UserName");
            username = userResult.Value ?? string.Empty;

            var branchResult = await sessionStorage.GetAsync<string>("BranchCode");
            branchcode = branchResult.Value;

            var groupResult = await sessionStorage.GetAsync<string>("GroupCode");
            groupcode = groupResult.Value;

            await LoadData();
            StateHasChanged();
        }
    }

    private async Task LoadData()
    {
        sessionlist = await httpService.Get<List<SessionModel>>("Session/GetSession") ?? new();

        string ApiUri = "BranchClass/GetClassCode";
        classlist = await httpService.Get<List<BranchClassModel>>(ApiUri) ?? new();

        string ApiUri2 = "Category/GetCategory";
        categorylist = await httpService.Get<List<RTECategoryModel>>(ApiUri2) ?? new();

        StateHasChanged();
    }

    private async Task OnSearchClassChanged()
    {
        searchRequest.SectionCode = string.Empty;
        sectionlist = new();

        if (string.IsNullOrEmpty(searchRequest.ClassCode))
        {
            StateHasChanged();
            return;
        }

        searchAny.GroupCode = groupcode;
        searchAny.BranchCode = branchcode;
        searchAny.RequestName = searchRequest.ClassCode;

        string ApiUri1 = "ClassSection/GetClassWithSection";
        var apiResponse = await httpService.Post<ApiResponse<List<SectionModel>>>(ApiUri1, searchAny) ?? new();
        if (apiResponse.Success)
        {
            sectionlist = apiResponse.Data ?? new();
        }
        StateHasChanged();
    }

    private void OpenSearch()
    {
        ShowSearchPopup = true;
    }

    private void ClosePopup()
    {
        ShowSearchPopup = false;
    }

    private void ToggleAll()
    {
        foreach (var row in studentlist)
            row.IsSelected = IsAllSelected;
    }

    private async Task SearchStudents()
    {
        searchRequest.GroupCode = groupcode;
        searchRequest.BranchCode = branchcode;
        searchRequest.SessionId = CurrentSession;

        ShowSearchPopup = false;
        IsLoading = true;
        StateHasChanged();

        try
        {
            string apiUrl = "StudentRTE/GetSearchedStudentRTEData";
            var apiResponse = await httpService.Post<ApiResponse<List<StudentRTEResponse>>>(apiUrl, searchRequest);

            studentlist = (apiResponse != null && apiResponse.Success) ? (apiResponse.Data ?? new()): new();

            if (apiResponse != null && apiResponse.Success && apiResponse.Code == 0)
            {
                await Alert.ShowWarning(apiResponse.Message ?? "No records found.");
            }
        }
        catch
        {
            studentlist = new();
            await Alert.ShowWarning("An error occurred while searching for RTE students.");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnSubmit()
    {
        var selected = studentlist.Where(x => x.IsSelected).ToList();
        if (selected.Count == 0)
        {
            await JS.InvokeVoidAsync("showSelectRecordAlert");
            return;
        }

        var studentDetails = string.Join("~", selected.Select(x =>
            $"{x.StudentId}|{x.AccountNumber}|{x.BankName}|{x.IFSCCODE}|{x.AccountHolderName}|{x.StudentRTECategory}|{x.StudentRTECategory}"));

        var model = new RTEStudentDataRequest
        {
            GroupCode = groupcode,
            BranchCode = branchcode,
            SessionId = CurrentSession,
            StudentDetails = studentDetails,
            CreatedBy = username
        };

        IsLoading = true;
        StateHasChanged();

        try
        {
            string apiUrl = "StudentRTE/AddUpdateRTEStudentData";
            var apiResponse = await httpService.Post<ApiResponse<object>>(apiUrl, model);

            if (apiResponse != null && apiResponse.Success)
            {
                await Alert.ShowSuccess(apiResponse.Message ?? "RTE student data saved successfully.");
                await SearchStudents();
            }
            else
            {
                await Alert.ShowWarning(apiResponse?.Message ?? "RTE student data was not saved.");
            }
        }
        catch (Exception ex)
        {
            await Alert.ShowError($"{@Localizer["Error"]}: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }
    private void OnRteChanged(ChangeEventArgs e)
    {
        searchRequest.IsRTE =
            e.Value is bool isChecked && isChecked
                ? 1
                : 0;
    }
    private async Task OnPrint()
    {
        IsLoading = true;
        var data=moduleQuery.ToList();
        if (data.Count == 0)
        {
            await Alert.ShowWarning("No records found.");
            StateHasChanged();
            IsLoading=false;
            return;
        }
        string ApiUri = "Export/GenerateStudentRTEExcelData";

        var response = await httpService.Post<ApiResponse<object>>(ApiUri, data);

        if (response != null && response.Success && response.Data != null)
        {
            IsLoading = false;
            var base64Excel = response.Data.ToString();

            if (!string.IsNullOrEmpty(base64Excel))
            {

                await JS.InvokeVoidAsync("downloadExcel", base64Excel, "StudentRTECatagery.xlsx");
            }
        }
        IsLoading = false;
    }
}
