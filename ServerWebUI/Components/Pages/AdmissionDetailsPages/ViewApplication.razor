    }
    private void UpdateIntratction()
    {
        IsEditMode = true;
        StateHasChanged();
    }
    private bool HasInteractionChanges()
    {
        if (originalInteractionModel == null)
            return true;

        return
            interactionModel.StarRating != originalInteractionModel.StarRating
            || interactionModel.Recommendation != originalInteractionModel.Recommendation
            || interactionModel.Remarks != originalInteractionModel.Remarks
            || interactionModel.FileName != originalInteractionModel.FileName
            || interactionModel.FilePath != originalInteractionModel.FilePath;
    }
    private void CancelInteractionEdit()
    {
        if (originalInteractionModel != null)
        {
            interactionModel.StarRating =
                originalInteractionModel.StarRating;

            interactionModel.Recommendation =
                originalInteractionModel.Recommendation;

            interactionModel.Remarks =
                originalInteractionModel.Remarks;

            interactionModel.FileName =
                originalInteractionModel.FileName;

            interactionModel.FilePath =
                originalInteractionModel.FilePath;
        }

        IsEditMode = false;

        StateHasChanged();
    }
}
