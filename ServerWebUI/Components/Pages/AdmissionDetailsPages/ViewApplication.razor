        foreach (var item in documentlist)
            item.IsSelected = false;

        doc.IsSelected = true;
        selectedDocument = doc;
    }

    private async Task VerifyAndTakeDocument()
    {

        ShowDocumentPopup = false;
        if (documentlist[0].Verified == 1)
        {
            await Alert.ShowWarning("Document already verified.");
            ShowDocumentPopup = true;
            StateHasChanged();
            return;
        }
        if (selectedDocument == null)
        {
            await JS.InvokeVoidAsync("showSelectRecordAlert");
            ShowDocumentPopup = true;
            StateHasChanged();
            return;
        }
        var model = new StudentDocumentModel
        {
            GroupCode = groupcode,
            BranchCode = branchcode,
            SessionId = CurrentSession,
            RegistrationId = selectedStudentRow!.RegistrationId,
            DocumentId = selectedDocument.DocumentId,
            CreatedBy = username
        };
        ShowDocumentPopup = false;
        StateHasChanged();
        var apiResponse = await httpService.Post<ApiResponse<object>>("Registration/VerifyAndTakeDocument", model);
        if (apiResponse.Success && apiResponse.Code == 1)
        {
            await Alert.ShowSuccess("Document verified and saved successfully.");
            await LoadDocumentList();
            ShowDocumentPopup = true;
            StateHasChanged();
        }
        else if (apiResponse.Success && apiResponse.Code == 2)
        {
            await Alert.ShowSuccess("Document record updated successfully.");
        }
        else
        {
            await Alert.ShowWarning("Document not verified.");
        }
    }

