        await LoadDocumentList();
        selectedDocument = null;
        ShowDocumentPopup = true;
        StateHasChanged();
    }

    private async Task LoadDocumentList()
    {
        try
        {
            IsLoading = true;
            StateHasChanged();

            documentsRequest.RegistrationId = selectedStudentRow!.RegistrationId;
            documentsRequest.ClassCode = selectedStudentRow.ClassCode;
            documentsRequest.SessionId = CurrentSession;
            documentsRequest.GroupCode = groupcode;
            documentsRequest.BranchCode = branchcode;
            string apiUrl = $"Registration/GetClassRegistrationDocuments";
            var apiResponse = await httpService.Post<ApiResponse<List<ClassRegistrationDocumentsResponse>>>(apiUrl, documentsRequest);
            if (apiResponse.Success == true)
            {
                documentlist = apiResponse.Data ?? new();
            }
        }
        catch
        {
            documentlist = new();
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void CloseDocumentPopup()
    {
        ShowDocumentPopup = false;
        StateHasChanged();
    }
    private void SelectDocumentRow(ClassRegistrationDocumentsResponse doc)
    {
        foreach (var item in documentlist)
            item.IsSelected = false;

        doc.IsSelected = true;
        selectedDocument = doc;
    }

    private async Task VerifyAndTakeDocument()
    {

        ShowDocumentPopup = false;
        if (documentlist[0].Verified == 1)
        {
            await Alert.ShowWarning("Document already verified.");
            ShowDocumentPopup = true;
            StateHasChanged();
            return;
        }
        if (selectedDocument == null)
        {
            await JS.InvokeVoidAsync("showSelectRecordAlert");
            ShowDocumentPopup = true;
            StateHasChanged();
            return;
        }
        var model = new StudentDocumentModel
        {
            GroupCode = groupcode,
            BranchCode = branchcode,
            SessionId = CurrentSession,
            RegistrationId = selectedStudentRow!.RegistrationId,
            DocumentId = selectedDocument.DocumentId,
            CreatedBy = username
        };
        ShowDocumentPopup = false;
        StateHasChanged();
        var apiResponse = await httpService.Post<ApiResponse<object>>("Registration/VerifyAndTakeDocument", model);
        if (apiResponse.Success && apiResponse.Code == 1)
        {
            await Alert.ShowSuccess("Document verified and saved successfully.");
            await LoadDocumentList();
            ShowDocumentPopup = true;
            StateHasChanged();
        }
        else if (apiResponse.Success && apiResponse.Code == 2)
        {
            await Alert.ShowSuccess("Document record updated successfully.");
        }
        else
        {
            await Alert.ShowWarning("Document not verified.");
        }
    }

    private async Task DeActivateDocument()
    {
        ShowDocumentPopup = false;
        if (documentlist[0].Verified == 0)
        {
            await Alert.ShowWarning("Document already deactivated.");
            ShowDocumentPopup = true;
            StateHasChanged();
            return;
        }
        if (selectedDocument == null)
        {
            await JS.InvokeVoidAsync("showSelectRecordAlert");
            ShowDocumentPopup = true;
            StateHasChanged();
            return;
        }

        var model = new StudentDocumentModel
        {
            GroupCode = groupcode,
            BranchCode = branchcode,
            SessionId = CurrentSession,
            RegistrationId = selectedStudentRow!.RegistrationId,
            DocumentId = selectedDocument.DocumentId,
            CreatedBy = username
        };

        ShowDocumentPopup = false;
        StateHasChanged();

        var apiResponse = await httpService.Post<ApiResponse<object>>("Registration/DeActivateDocument", model);
        if (apiResponse.Success && apiResponse.Code == 1)
        {
            await Alert.ShowSuccess("Document record deactivated successfully.");
            await LoadDocumentList();
            ShowDocumentPopup = true;
            StateHasChanged();
        }
        else
        {
            await Alert.ShowWarning("Document not deactivated.");
        }
    }
