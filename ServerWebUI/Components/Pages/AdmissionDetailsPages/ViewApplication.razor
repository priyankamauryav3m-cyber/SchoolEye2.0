    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file == null)
            return;

        if (!file.ContentType.StartsWith("image/"))
            return;

        var uploadFolderAbsolute = Path.Combine(
            Environment.CurrentDirectory,
            "wwwroot",
            "uploads",
            "interaction"
        );

        if (!Directory.Exists(uploadFolderAbsolute))
            Directory.CreateDirectory(uploadFolderAbsolute);

        var uniqueFileName = $"{Guid.NewGuid()}_{file.Name}";

        var filePathAbsolute = Path.Combine(uploadFolderAbsolute, uniqueFileName);

        using (var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024))
        using (var fs = new FileStream(filePathAbsolute, FileMode.Create))
        {
            await stream.CopyToAsync(fs);
        }

        interactionModel.FileName = file.Name;

        // Web-relative path — ye hi browser mein <img src> ke kaam aayega
        interactionModel.FilePath = "/" + Path.Combine("uploads", "interaction", uniqueFileName).Replace("\\", "/");

        // Live preview turant naye upload se
        using var previewStream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
        using var memoryStream = new MemoryStream();
        await previewStream.CopyToAsync(memoryStream);
        var imageBytes = memoryStream.ToArray();

        SelectedImagePreview = $"data:{file.ContentType};base64,{Convert.ToBase64String(imageBytes)}";

        StateHasChanged();
    }
