    private async Task DirectAdmission()
    {
        var data = moduleQuery.Where(x => x.IsSelected).ToList();
        if (data.Count == 0)
        {
            await JS.InvokeVoidAsync("showSelectRecordAlert");
            StateHasChanged();
            return;
        }
        else if (data.Count > 1)
        {
            await JS.InvokeVoidAsync("showSelectRecordAlert");
            StateHasChanged();
            return;
        }

        StateHasChanged();
        try
        {
            IsLoading = true;

            registrationStatus.GroupCode = groupcode;
            registrationStatus.BranchCode = branchcode;
            registrationStatus.SessionId = CurrentSession;
            registrationStatus.RegistrationId = data[0].RegistrationId;
            registrationStatus.AppStatus = "4";
            registrationStatus.CreatedBy = username;
            var submit = await Alert.ShowConfirm("Are you sure, you want to approve selected student for admission.?");
            if (!submit)
            {
                StateHasChanged();
                IsLoading = false;
                return;
