@page "/ViewApplication"
@using DomainModel.Admin
@using DomainModel.SchoolMaster
@using System.Net
@using System.Text.Json
@using Microsoft.AspNetCore.Mvc
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyApp.Common
@inject Shared.IHttpService httpService
@inject IJSRuntime JSs
@inject HttpClient Http
@inject IStringLocalizer<Resource> Localizer
@inject SweetAlertService Alert
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using ServerWebUI.Components.Pages.CommonPages
@inject ICommonMethod _commonmethod
@inject IHttpClientFactory ClientFactory
@inject IJSRuntime JS
<style>
    .quickgrid tbody tr.selectRow td {
        background-color: #cce5ff !important;
    }

    .quickgrid thead th:last-child {
        min-width: 75px;
    }
</style>
<div class="main-container">
    <div class="row m-0 main-row">
        <div class="col-12 p-1" id="main-header">
            <div class="page-heading d-flex align-items-center justify-content-between">
                <p class="m-0 page-name px-1">View Application Status</p>
                <div class="d-flex align-items-center gap-2">
                    <div class="form-box">
                        <select name="branch" id="gender" class="form-input" placeholder=" ">
                            <option value="0">V3M International School</option>
                        </select>
                    </div>
                    <div class="form-box">
                        <InputSelect class="form-input" placeholder=" " @bind-Value="CurrentSession" name="session">
                            <option value="" selected>--Select--</option>
                            @foreach (var data in sessionlist.Where(x => x.IsValid == true))
                            {
                                <option value="@data.SessionId">@data.SessionName </option>
                            }
                        </InputSelect>
                    </div>
                    <div class="form-box">
                        <InputSelect class="form-input" placeholder=" " @bind-Value="searchModel.ClassCode" name="gender" id="gender">
                            <option value="" selected>--Select--</option>
                            <option value="" selected>All</option>
                            @foreach (var cs in classlist.Where(x => x.IsValid == true))
                            {
                                <option Value="@cs.ClassCode">@cs.ClassName</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="form-box">
                        <div class="d-flex gap-2">
                            <button class="icon-btn icon-btn-white open-popup " @onclick="OpenSearch" data-id="popup" tabindex="0">
                                <i class="bi bi-sliders"></i>
                            </button>
                        </div>
                    </div>
                    <div class="form-box">
                        <button class="ui fade op-1 animated button form-btn" @onclick="SearchRegEnterDetails" tabindex="0">
                            <div class="visible content">Search</div>
                            <div class="hidden content">
                                <i class="bi bi-search"></i>
                            </div>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 p-1">
            <div class="card">
                <div class="card-body table-card p-0">
                    <div class="quick-main">
                        <div class="grid-box-with-btn">
                            <QuickGrid Items="@moduleQuery" Pagination="@pagination" Class="table">

                                <TemplateColumn Title="" Align="Align.Left">
                                    <HeaderTemplate>
                                        <div>
                                            <input type="checkbox" @bind="IsAllSelected" @bind:after="ToggleAll" @onclick:stopPropagation="true" />
                                        </div>
                                    </HeaderTemplate>
                                    <ChildContent>
                                        <div>
                                            <input type="checkbox" @bind="context.IsSelected" @onclick:stopPropagation="true" />
                                        </div>
                                    </ChildContent>
                                </TemplateColumn>

                                <PropertyColumn Property="@(x => x.RegistrationNo)" Sortable="true" Title="Reg.No." />

                                <PropertyColumn Sortable="true" Property="@(x => x.StudentName)" Title="Student Name">

                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" @bind="nameFilter" @bind:event="oninput" placeholder="Studentname...." />
                                        </div>
                                    </ColumnOptions>
                                </PropertyColumn>
                                <TemplateColumn SortBy="@(GridSort<RegistrationDto>.ByAscending(x => x.ClassName))" Title="Applied Class">
                                    <ChildContent>
                                        @(string.IsNullOrWhiteSpace(context.ClassName) ? " " : context.ClassName)
                                    </ChildContent>
                                </TemplateColumn>
                                <PropertyColumn Class="text-center" Sortable="true" Property="@(x => x.AppliedDate)" Title="Applied Date" />
                                <PropertyColumn Class="text-center" Sortable="true" Property="@(x => x.AppliedDate)" Title="Admission Date" />
                                <TemplateColumn Title="Contact No." Class="text-center" Align="Align.Center">
                                    <ChildContent>
                                        @(string.IsNullOrWhiteSpace(context.FatherContactNo) ? " " : context.FatherContactNo)
                                    </ChildContent>
                                </TemplateColumn>
                                <PropertyColumn Property="@(x => x.Gender)" Sortable="true" Title="Gender" />
                                <PropertyColumn Property="@(x => x.Points)" Sortable="true" Title="Points" Class="text-center" Align="Align.Center" />
                                <TemplateColumn Title="Email" Class="text-center" Align="Align.Center">
                                    <ChildContent>
                                        @(string.IsNullOrWhiteSpace(context.FatherEMail) ? " " : context.FatherEMail)
                                    </ChildContent>
                                </TemplateColumn>
                                <TemplateColumn Class="status-con" Title="EWS" Align="Align.Center">
                                    <div class="text-center">
                                        @if (context.IsReservedSeat == 0)
                                        {
                                            <img class="grid-status" src="/images/status-false.png" />
                                        }
                                        else
                                        {
                                            <img class="grid-status" src="/images/status-success.png" />
                                        }
                                    </div>
                                </TemplateColumn>
                            </QuickGrid>
                        </div>
                        <div class="footer-pagination">
                            <div class="d-flex align-items-center">
                                <div class="welcome-text w-100">
                                    <Paginator State="@pagination" />
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-12 p-1">
            <div class="page-heading d-flex align-items-center justify-content-end">

                <div class="d-flex align-items-center gap-2">
                    <div class="form-box">
                        <button class="table-btn" @onclick="AdmitChildStudent">
                            AdmitChild
                        </button>
                    </div>
                    <div class="form-box">
                        <button type="button" class="table-btn" @onclick="SaveStudentDetails">
                            View Details
                        </button>
                    </div>
                    <div class="form-box">
                        <button class="table-btn" @onclick="PrintRec">
                            Print Rec.
                        </button>
                    </div>
                    <div class="form-box">
                        <button class="table-btn" @onclick="DirectAdmission">
                            Direct Admission
                        </button>
                    </div>
                    <div class="form-box">
                        <button class="table-btn" @onclick="AddIntraction">
                            Intraction
                        </button>
                    </div>
                    <div class="form-box">
                        <button class="table-btn" @onclick="AddOrVerifyDoument">
                            Document
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (ShowPopup)
{
    <div class="custom-modal row m-0">
        <div class="col-12 col-sm-7 col-md-5 col-lg-4 col-xl-9">
            <div class="modal-content clearfix main-popup ">
                <div class="head-btn">
                    <h5 class="modal-title">Search  Application</h5>
                    <button data-access="Close" type="button" @onclick="ClosePopup" class="close"><span aria-hidden="true">×</span></button>
                </div>
                <div class="modal-body">
                    <div class="row m-0 form-row">
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 px-2">

                            <div class="form-box-group static-label">
                                <InputSelect class="floating-input" placeholder=" " @bind-Value="searchModel.AppStatus">
                                    <option value="2" selected>Details Entered</option>
                                    <option value="3">Intraction Done</option>
                                    <option value="4">Selected For Admission</option>
                                    <option value="5"> Admission Done</option>
                                </InputSelect>
                                <label class="floating-label">App.Status</label>
                            </div>


                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 px-2">

                            <div class="form-box-group static-label">
                                <InputSelect class="floating-input" placeholder=" " autocomplete="off" @bind-Value="searchModel.Gender" maxlength="10" required>
                                    <option value="" selected>--Select--</option>
                                    @foreach (var cs in genderModallist.Where(x => x.IsValid == true))
                                    {
                                        <option Value="@cs.GenderName">@cs.GenderName</option>
                                    }
                                </InputSelect>
                                <label class="floating-label">Gender</label>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 px-2">
                            <div class="form-box-group">
                                <input type="date" class="floating-input" placeholder=" " @ref="dateFromInput" @bind="searchModel.DateFrom" @onclick='() => OpenDateFrom("DateFrom")' />
                                <label class="floating-label">Date From</label>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 px-2">
                            <div class="form-box-group">
                                <input type="date" class="floating-input" placeholder=" " @ref="dateToInput" @bind="searchModel.DateTo" @onclick='() => OpenDateFrom("DateTo")' />
                                <label class="floating-label">Date To</label>

                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 px-2">
                            <div class="form-box-group">
                                <InputText class="floating-input" placeholder=" " @bind-Value="searchModel.RegistrationFrom" oninput="this.value=this.value.replace(/[^a-zA-Z0-9]/g,'')" />
                                <label class="floating-label">Reg. No. From</label>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 px-2">
                            <div class="form-box-group">
                                <InputText class="floating-input" placeholder=" " @bind-Value="searchModel.RegistrationTo" oninput="this.value=this.value.replace(/[^a-zA-Z0-9]/g,'')" />
                                <label class="floating-label">Reg. No. To</label>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 px-2">
                            <div class="form-box-group">
                                <InputText class="floating-input" placeholder=" " @bind-Value="searchModel.StudentName" oninput="this.value=this.value.replace(/[^a-zA-Z]/g,'')" />
                                <label class="floating-label">First Name</label>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 px-2">
                            <div class="form-box-group static-label">
                                <InputSelect class="floating-input" placeholder=" " @bind-Value="searchModel.TransportDistance" id="gender">
                                    <option value="" selected>--Select--</option>
                                    @foreach (var item in distanceslist)
                                    {
                                        <option value="@item.DistanceId">@item.DistanceName</option>
                                    }
                                </InputSelect>
                                <label class="floating-label">Distance</label>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-6 px-2">
                            <div class="form-box-group static-label">
                                <label class="floating-label">&nbsp;</label>
                                <div class="border-box d-flex justify-content-center align-items-center gap-3">
                                    <div class="d-flex align-items-center gap-1">
                                        <input type="checkbox" class="form-input" checked="@(searchModel.IsTransport == 1)"
                                               @onchange="e => searchModel.IsTransport = (bool)e.Value! ? 1 : 0" autocomplete="off" />
                                        <label class="form-label">
                                            Transport
                                        </label>
                                        <input type="checkbox" checked="@(searchModel.Sibling == 1)"
                                               @onchange="e => searchModel.Sibling = (bool)e.Value! ? 1 : 0" autocomplete="off" />
                                        <label class="form-label">
                                            Sibling
                                        </label>
                                        <input type="checkbox" class="form-input" checked="@(searchModel.DocumentSelected == 1)"
                                               @onchange="e => searchModel.DocumentSelected = (bool)e.Value! ? 1 : 0" autocomplete="off" />
                                        <label class="form-label">
                                            Document
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 px-2">
                            <div class="form-box-group">
                                <InputText class="floating-input" placeholder=" " @bind-Value="searchModel.PointsFrom" oninput="this.value=this.value.replace(/[^a-zA-Z0-9]/g,'')" />
                                <label class="floating-label">Points From</label>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 px-2">
                            <div class="form-box-group">
                                <InputText class="floating-input" placeholder=" " @bind-Value="searchModel.PointsTo" oninput="this.value=this.value.replace(/[^a-zA-Z0-9]/g,'')" />
                                <label class="floating-label">Points To</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="ui fade op-1 animated button form-btn" @onclick="SearchRegEnterDetails" tabindex="0">
                        <div class="visible content">Search</div>
                        <div class="hidden content">
                            <i class="bi bi-search"></i>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ===================== INTERACTION POPUP ===================== -->
@if (ShowInteractionPopup)
{
    <div class="custom-modal row m-0 align-items-center">
        <div class="col-12 col-sm-7 col-md-5 col-lg-4 col-xl-8">
            <div class="modal-content clearfix main-popup">
                <div class="head-btn">
                    <h5 class="modal-title">Interaction</h5>
                    <button data-access="Close" type="button" @onclick="CloseInteractionPopup" class="close"><span aria-hidden="true">×</span></button>
                </div>
                <EditForm Model="@interactionModel" OnValidSubmit="OnSubmitInteraction">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="row m-0 form-row">
                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                <div class="divider-box d-flex justify-content-between align-items-center gap-2">
                                    <p class="total-text-with-bg bg-light-gray">
                                        Student Details
                                    </p>
                                    <hr class="m-0 w-webkit text-light-gray op-1">
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-4 col-lg-4 px-2 ">
                                <div class="form-box-group">
                                    <input class="floating-input" placeholder=" " value="@selectedStudentRow?.RegistrationNo" readonly />
                                    <label class="floating-label">Reg. No.</label>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-4 col-lg-4 px-2 ">
                                <div class="form-box-group">
                                    <input class="floating-input" placeholder=" " value="@selectedStudentRow?.StudentName" readonly />
                                    <label class="floating-label">Student Name</label>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-4 col-lg-4 px-2 ">
                                <div class="form-box-group">
                                    <input class="floating-input" placeholder=" " value="@selectedStudentRow?.ClassName" readonly />
                                    <label class="floating-label">Class</label>
                                </div>
                            </div>

                            <!-- ---------- Teacher Details (read-only) ---------- -->
                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                <div class="divider-box d-flex justify-content-between align-items-center gap-2">
                                    <p class="total-text-with-bg bg-light-gray">
                                        Teacher Details
                                    </p>
                                    <hr class="m-0 w-webkit text-light-gray op-1">
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-4 col-lg-4 px-2 ">
                                <div class="form-box-group static-label">
                                    @* <InputSelect class="floating-input" placeholder=" " @bind-Value="selectedEmployeeId" @bind-Value:after="OnTeacherChanged">
                                        <option value="">--Select--</option>
                                        @foreach (var emp in teacherlist)
                                        {
                                            <option value="@emp.EmployeeId">@emp.FirstName</option>
                                        }
                                    </InputSelect> *@
                                    <input class="floating-input" placeholder=" " value="@selectedTeacher?.FirstName" readonly />
                                    <label class="floating-label">Teacher Name</label>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-4 col-lg-4 px-2 ">
                                <div class="form-box-group">
                                    <input class="floating-input" placeholder=" " value="@selectedTeacher?.Gender" readonly />
                                    <label class="floating-label">Gender</label>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-4 col-lg-4 px-2 ">
                                <div class="form-box-group">
                                    <input class="floating-input" placeholder=" " value="@selectedTeacher?.EmpMobileNo" readonly />
                                    <label class="floating-label">Mobile No.</label>
                                </div>
                            </div>

                            <!-- ---------- Interaction (editable / submitted) ---------- -->
                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                <div class="divider-box d-flex justify-content-between align-items-center gap-2">
                                    <p class="total-text-with-bg bg-light-gray">
                                        Interaction
                                    </p>
                                    <hr class="m-0 w-webkit text-light-gray op-1">
                                </div>
                            </div>

                            <!-- Clickable yellow star rating -->
                            <div class="col-12 col-sm-6 col-md-4 col-lg-3 px-2 ">
                                <div class="form-box-group static-label">
                                    <label class="floating-label">Star Rating</label>
                                    <div class="border-box d-flex justify-content-center align-items-center gap-1">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            var starValue = i;
                                            <i class="bi @(interactionModel.StarRating >= starValue ? "bi-star-fill" : "bi-star")"
                                               style="color:#ffc107; font-size:20px; cursor:pointer;"
                                               @onclick="() => SetStarRating(starValue)"></i>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Readonly label derived from the star rating -->
                            <div class="col-12 col-sm-6 col-md-4 col-lg-3 px-2 ">
                                <div class="form-box-group static-label">
                                    <input class="floating-input" placeholder=" " value="@GetStarRatingLabel()" readonly />
                                    <label class="floating-label">Rating</label>
                                </div>
                            </div>
                            <!-- Recommendation Yes/No -->
                            <div class="col-12 col-sm-6 col-md-4 col-lg-3 px-2 ">
                                <div class="form-box-group static-label">
                                    <label class="floating-label">Recommendation</label>
                                    <div class="border-box d-flex justify-content-center align-items-center gap-3">
                                        <InputRadioGroup @bind-Value="interactionModel.Recommendation">
                                            <div class="d-flex align-items-center gap-1">
                                                <InputRadio Value="true" />
                                                <label class="form-label">Yes</label>
                                            </div>
                                            <div class="d-flex align-items-center gap-1">
                                                <InputRadio Value="false" />
                                                <label class="form-label">No</label>
                                            </div>
                                        </InputRadioGroup>
                                    </div>
                                </div>
                            </div>
                            <!-- File upload -->
                            <div class="col-12 col-sm-6 col-md-4 col-lg-3 px-2 ">
                                <div class="form-box-group static-label">
                                    <InputFile class="floating-input" OnChange="OnFileSelected" />
                                    <label class="floating-label">Attachment</label>
                                </div>
                            </div>
                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2 ">
                                <div class="form-box-group">
                                    <InputTextArea class="floating-input" placeholder=" " rows="3" @bind-Value="interactionModel.Remarks" maxlength="1000" />
                                    <label class="floating-label">
                                        Remarks <span class="required">*</span>
                                    </label>
                                    <ValidationMessage For="@(() => interactionModel.InteractionComments)" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="ui animated button form-btn backBtn" tabindex="0">
                            <div class="visible content">Submit</div>
                            <div class="hidden content">
                                <i class="fa fa fa-save"></i>
                            </div>
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (ShowDocumentPopup)
{
    <div class="custom-modal row m-0 align-items-center">
        <div class="col-12 col-sm-10 col-md-9 col-lg-8 col-xl-7">
            <div class="modal-content clearfix main-popup">
                <div class="head-btn d-flex align-items-center justify-content-between">
                    <h5 class="modal-title">Verify Document</h5>
                    <div class="d-flex align-items-center ">
                        <button data-access="Close" type="button" @onclick="CloseDocumentPopup" class="close"><span aria-hidden="true">×</span></button>
                    </div>
                </div>
                <div class="modal-body">
                    <div class="row m-0 form-row">
                        <div class="col-12 col-sm-4 col-md-4 col-lg-4 px-2">
                            <div class="form-box-group">
                                <input class="floating-input" placeholder=" " value="@CurrentSessionName" readonly />
                                <label class="floating-label">Session</label>
                            </div>
                        </div>
                        <div class="col-12 col-sm-4 col-md-4 col-lg-4 px-2">
                            <div class="form-box-group">
                                <input class="floating-input" placeholder=" " value="@selectedStudentRow?.RegistrationNo" readonly />
                                <label class="floating-label">Registration No.</label>
                            </div>
                        </div>
                        <div class="col-12 col-sm-4 col-md-4 col-lg-4 px-2">
                            <div class="form-box-group">
                                <input class="floating-input" placeholder=" " value="@selectedStudentRow?.StudentName" readonly />
                                <label class="floating-label">Name</label>
                            </div>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-body table-card p-0">
                            <div class="quick-main">
                                <div class="grid-box-with-btn" style="height: 320px;">
                                    <QuickGrid Items="@documentQuery" Class="table">
                                        <TemplateColumn Class="text-center" Title="" Align="Align.Center">
                                            <ChildContent>
                                                <input type="checkbox" checked="@context.IsSelected" @onchange="() => SelectDocumentRow(context)" @onclick:stopPropagation="true" />
                                            </ChildContent>
                                        </TemplateColumn>
                                        <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.DocumentName) ? " " : x.DocumentName)" Title="Document" Align="Align.Left" />
                                        <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.Remarks) ? " " : x.Remarks)" Title="Remarks" Align="Align.Left" />
                                        <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.DocPath) ? " " : x.DocPath)" Title="Date" Class="text-center" Align="Align.Center" />
                                        <TemplateColumn Title="Att." Class="text-center" Align="Align.Center">
                                            <ChildContent>

                                                <a href="@(string.IsNullOrWhiteSpace(context.DocPath) ? " " : context.DocPath)" target="_blank"><i class="bi bi-paperclip"></i></a>

                                            </ChildContent>
                                        </TemplateColumn>
                                        <TemplateColumn Title="Taken" Class="text-center" Align="Align.Center">
                                            <ChildContent>
                                                @if (context.Verified == 1)
                                                {
                                                    <i class="bi bi-check-circle-fill" style="color:#28a745; font-size:18px;"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-x-circle-fill" style="color:#dc3545; font-size:18px;"></i>
                                                }
                                            </ChildContent>
                                        </TemplateColumn>
                                    </QuickGrid>
                                </div>
                                <div class="footer-pagination">
                                    <div class="d-flex align-items-center">
                                        <div class="welcome-text w-100">
                                            <Paginator State="@pagination" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer d-flex justify-content-end gap-2">
                    <button type="button" class="table-btn" @onclick="VerifyAndTakeDocument">Verified And Taken</button>
                    <button type="button" class="table-btn" @onclick="DeActivateDocument">Deactivate</button>
                    @* <button type="button" class="table-btn" @onclick="CloseDocumentPopup">Close</button> *@
                    <SaveUpdateButton ShowSaveButton="false" OnClickCancel="@CloseDocumentPopup" />
                </div>
            </div>
        </div>
    </div>
}


