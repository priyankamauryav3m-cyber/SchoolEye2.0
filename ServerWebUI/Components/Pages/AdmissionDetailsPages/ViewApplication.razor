        catch
        {
            return;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }
    private async Task AdmitChildStudent()
    {
        var data = moduleQuery.Where(x => x.IsSelected).ToList();
        if (data.Count == 0)
        {
            await JS.InvokeVoidAsync("showSelectRecordAlert");
            StateHasChanged();
            return;
        }
        else if (data.Count > 1)
        {
            await JS.InvokeVoidAsync("showSelectRecordAlert");
            StateHasChanged();
            return;
        }

        StateHasChanged();
        try
        {
            IsLoading = true;

            admitChildRequest.GroupCode = groupcode;
            admitChildRequest.BranchCode = branchcode;
            admitChildRequest.SessionId = CurrentSession;
            admitChildRequest.RegistrationId = data[0].RegistrationId;
            admitChildRequest.CreatedBy = username;
