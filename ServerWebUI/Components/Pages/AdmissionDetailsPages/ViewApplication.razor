    private async Task OnSubmitInteraction()
    {
        ShowInteractionPopup = true;
        if (selectedStudentRow == null)
        {
            await customAlert.ShowCustomAlert("Please select a student.",false);
            ShowInteractionPopup = true;
            StateHasChanged();
            return;
        }

        if (selectedTeacher == null)
        {
            await customAlert.ShowCustomAlert("Please select a teacher.", false);
            ShowInteractionPopup = true;
            StateHasChanged();
            return;
        }
        if (IsExistingInteraction)
        {
            if (!HasInteractionChanges())
            {
                await customAlert.ShowCustomAlert("No change detected.", false);
                ShowInteractionPopup = true;
                StateHasChanged();
                return;
            }
        }

        try
        {
            IsLoading = true;
            StateHasChanged();
            ShowInteractionPopup = false;
            interactionModel.InteractionBy = selectedTeacher.EmployeeId;
            interactionModel.GroupCode = groupcode;
            interactionModel.BranchCode = branchcode;
            interactionModel.SessionId = CurrentSession;
            interactionModel.RegistrationId = selectedStudentRow.RegistrationId;
            interactionModel.CreatedBy = username;
            interactionModel.CreatedDate = DateTime.Now;
            interactionModel.IsValid = true;

            string apiUrl = "InteractionPanel/AddOrUpdateInteraction";

            var apiResponse =  await httpService.Post<ApiResponse<object>>( apiUrl,interactionModel);

            if (apiResponse != null && apiResponse.Success && apiResponse.Code == 1)
            {
                await Alert.ShowSuccess( "Interaction " + Localizer["Inserted"]);
                originalInteractionModel = new InteractionCommentsModel
                {
                    IID = interactionModel.IID,
                    StarRating = interactionModel.StarRating,
                    Recommendation = interactionModel.Recommendation,
                    Remarks = interactionModel.Remarks,
                    FileName = interactionModel.FileName,
                    FilePath = interactionModel.FilePath
                };

                IsEditMode = false;
                IsExistingInteraction = true;

                ShowInteractionPopup = false;

                interactionModel = new();
                originalInteractionModel = new(); ;
            }
            else if (apiResponse != null && apiResponse.Success && apiResponse.Code == 2)
            {
                await Alert.ShowSuccess("Interaction " + Localizer["Updated"]);
                originalInteractionModel = new InteractionCommentsModel
                {
                    IID = interactionModel.IID,
                    StarRating = interactionModel.StarRating,
                    Recommendation = interactionModel.Recommendation,
                    Remarks = interactionModel.Remarks,
                    FileName = interactionModel.FileName,
                    FilePath = interactionModel.FilePath
                };

                IsEditMode = false;
                IsExistingInteraction = true;

                ShowInteractionPopup = false;

                interactionModel = new();
                originalInteractionModel = new(); ;
            }
            else
            {
                await Alert.ShowWarning("Failed to save interaction.");
            }
        }
        catch (Exception ex)
        {
            await Alert.ShowWarning("Failed to save interaction.");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }
   

