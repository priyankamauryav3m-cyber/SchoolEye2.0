@page "/StudentIndiscipline"
@using DomainModel.Admin
@using DomainModel.SchoolMaster
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyApp.Common
@using Microsoft.AspNetCore.Authorization
@using ServerWebUI.Components.Pages.CommonPages
@inject Shared.IHttpService httpService
@inject IJSRuntime JS
@inject HttpClient Http
@inject IStringLocalizer<Resource> Localizer
@inject SweetAlertService Alert
@inject ICommonMethod _commonmethod
@rendermode InteractiveServer
<style>
    .quickgrid tbody tr.selectRow td {
        background-color: #e7f1ff !important;
    }
    .card {
        border-radius: 12px;
    }

    .crumb {
        display: flex;
        gap: 10px;
        align-items: center;
        color: #2455a6;
        margin-bottom: 10px;
    }

    .redio-button-grid {
        width: 18px;
        height: 18px
    }
</style>
<div class="main-container">
    <div class="row m-0 main-row">
        <div class="col-12 p-1" id="main-header">
            <PageHeading Tittle="Student Indiscipline">

                <div class="form-box">
                    <InputSelect class="form-input" placeholder=" " @bind-Value="indisciplineCommentRequest.ClassCode" @bind-Value:after="OnClassChanged">
                        <option value="">--All Class --</option>
                        @foreach (var cs in classlist.Where(x => x.IsValid == true))
                        {
                            <option value="@cs.ClassCode">@cs.ClassName</option>
                        }
                    </InputSelect>
                </div>
                <div class="form-box">
                    <InputSelect class="form-input" placeholder=" " @bind-Value="indisciplineCommentRequest.SectionId">
                        <option value="">-All Section -</option>
                        @foreach (var sec in sectionlist)
                        {
                            <option value="@sec.SectionId">@sec.SectionName</option>
                        }
                    </InputSelect>
                </div>
                <div class="form-box">
                    <div class="d-flex gap-2">
                        <button class="icon-btn icon-btn-white open-popup " @onclick="OpenSearch" data-id="popup" tabindex="0">
                            <i class="bi bi-sliders"></i>
                        </button>
                    </div>
                </div>
                <div class="form-box">
                    <button class="ui fade op-1 animated button form-btn" @onclick="SearchDisciplineList" tabindex="0">
                        <div class="visible content">Search</div>
                        <div class="hidden content">
                            <i class="bi bi-search"></i>
                        </div>
                    </button>
                </div>
                <div class="form-box">
                    <ActionButtonGroup ButtonText="New" CurrentUrl="@currentUrl" Add="OpenNewPopup" />
                </div>
            </PageHeading>
        </div>

        <div class="col-12 p-1">
            <div class="card">
                <div class="card-body table-card p-0">
                    <div class="quick-main">
                        <div class="grid-box">
                            <QuickGrid Items="@moduleQuery" Class="table" Pagination="@pagination">
                                <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.ControlNo) ? " " : x.ControlNo)" Title="Student No." Sortable="true" Align="Align.Left">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="Search..." />
                                        </div>
                                    </ColumnOptions>
                                </PropertyColumn>
                                <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.StudentName) ? " " : x.StudentName)" Title="Student Name" Sortable="true" Align="Align.Left">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="Search..." />
                                        </div>
                                    </ColumnOptions>
                                </PropertyColumn>
                                <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.ClassSection) ? " " : x.ClassSection)" Title="Class" Class="text-center" Align="Align.Center" />
                                <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.CategoryName) ? " " : x.CategoryName)" Title="Category" Align="Align.Left" />
                                <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.IndisciplineComment) ? " " : x.IndisciplineComment)" Title="Comment" Align="Align.Left" />
                                <PropertyColumn Property="@(x => x.Fine)" Title="Fine" Class="text-right" Align="Align.Center" />
                                <TemplateColumn Title="Status" Class="text-center" Align="Align.Center">
                                    <ChildContent>
                                        <div class="text-center">
                                            @if (context.IsValid == true)
                                            {
                                                <span class="badge rounded-pill bg-success">
                                                    <i class="bi bi-check-circle-fill"></i> Success
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill bg-danger">
                                                    <i class="bi bi-x-circle-fill"></i> Fail
                                                </span>
                                            }
                                        </div>
                                    </ChildContent>
                                </TemplateColumn>
                                <TemplateColumn Title="Status" Class="text-center" Align="Align.Center">
                                    <ChildContent>
                                        <div class="action-btn-group">
                                            @if (context.IsValid == false)
                                            {
                                                <button class="btn-icon active-btn custom-tooltip" data-tooltip="Active" @onclick="() => ActiveData(context)">
                                                    <i class='fas fa-toggle-on' style="font-size:12px;"></i>&nbsp; Active
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn-icon inactive-btn custom-tooltip" data-tooltip="Deactive" @onclick="() => DeactiveData(context)">
                                                    <i class='fas fa-toggle-off' style="font-size:12px;"></i>&nbsp; Deactive
                                                </button>
                                            }
                                        </div>
                                    </ChildContent>
                                </TemplateColumn>
                            </QuickGrid>
                        </div>
                        <div class="footer-pagination">
                            <div class="d-flex align-items-center">
                                <div class="welcome-text w-100">
                                    <Paginator State="@pagination" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>


    </div>
</div>

<!-- ===================== MAIN "NEW" POPUP (col-xl-12, two cards) ===================== -->
