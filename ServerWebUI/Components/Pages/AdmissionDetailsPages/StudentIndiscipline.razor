                </div>
                <div class="modal-footer d-flex justify-content-end gap-2">
                    <button type="submit" class="ui fade op-1 animated button form-btn" @onclick="ConfirmSelectStudent">

                        <div class="visible content justify-content-center">Select Student</div>
                        <div class="hidden content">
                            <i class="bi bi-check-circle-fill"></i>
                        </div>
                    </button>
                    @* <button type="button" class="ui fade op-1 animated button form-btn" @onclick="ConfirmSelectStudent">Select Student</button> *@
                    <SaveUpdateButton ShowSaveButton="false" OnClickCancel="@CloseStudentSearch" />
                </div>
            </div>
        </div>
    </div>
}

