@code {
    // ---------------------------------------------------------------------
    // NOTE / ASSUMPTIONS:
    // - StudentIndisciplineListResponse: StudentNo, StudentName, ClassName,
    //   CategoryName, Comment, Fine, Status (outer list grid) - no API
    //   given yet for this list, endpoint left as a placeholder TODO.
    // - StudentDisciplineModel: StudentNo, StudentName, ClassCode, ClassName,
    //   SectionCode, SectionName, IndisciplineDate (DateTime?), CategoryId,
    //   Fine, IndisciplineComment - no save API given yet, placeholder TODO.
    // - Category dropdown is static per your list (6-10), not loaded from
    //   an API.
    // ---------------------------------------------------------------------

    private List<SessionModel> sessionlist = new();
    private List<BranchClassModel> classlist = new();
    private List<SectionModel> sectionlist = new();
    private List<IndisciplineCommentResponse> disciplineList = new();
    private List<SiblingStudentResponse> studentSearchResults = new();
    private List<DisCategoryModel> disCategorielist = new();
    private SiblingStudentRequest searchRequest = new();
    private IndisciplineCommentResponse disciplineModel = new();
    private IndisciplineCommentRequest indisciplineCommentRequest = new();
    private AddStudentDisciplineRequest addStudentDiscipline = new();
    private SiblingStudentResponse? selectedStudent;
    private string studentGridSearch = string.Empty;
    private SearchAnyRequestModel searchAny = new();
    private ElementReference dateFromInput;
    private ElementReference dateToInput;
    private bool isSibling = false;
    private bool ShowPopup = false;
    private int incidentCharCount = 0;
    private string? nameFilter;

    private bool ShowDisciplinePopup;
    private bool ShowSelectStudentPopup;

    private PaginationState pagination = new() { ItemsPerPage = 15 };
    private PaginationState studentPagination = new() { ItemsPerPage = 6 };

    private long CurrentSession;
    private bool IsLoading = false;

    private string? branchcode;
    private string? groupcode;
    private string username = string.Empty;
    private string currentUrl = "";
    private string CurrentSessionName => sessionlist.FirstOrDefault(x => x.SessionId == CurrentSession)?.SessionName ?? string.Empty;
    protected IQueryable<IndisciplineCommentResponse> moduleQuery
    {
        get
        {
            var result = disciplineList.AsQueryable();
            if (!string.IsNullOrEmpty(nameFilter))
            {
                result = result.Where(x => (x.StudentName != null && x.StudentName.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)) ||
               (x.ControlNo != null && x.ControlNo.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)));
            }
            return result;
        }
    }

    //private IQueryable<SiblingStudentResponse> studentSearchQuery => studentSearchResults.AsQueryable();

    private IQueryable<SiblingStudentResponse> studentSearchQuery
    {
        get
        {
            var query = studentSearchResults.AsQueryable();

            if (!string.IsNullOrWhiteSpace(studentGridSearch))
            {
                var searchText = studentGridSearch.Trim();

                query = query.Where(x =>
                    (!string.IsNullOrWhiteSpace(x.RollNo) &&
                     x.RollNo.Contains(searchText, StringComparison.OrdinalIgnoreCase))

                    ||

                    (!string.IsNullOrWhiteSpace(x.ControlNo) &&
                     x.ControlNo.Contains(searchText, StringComparison.OrdinalIgnoreCase))

                    ||

                    (!string.IsNullOrWhiteSpace(x.StudentName) &&
                     x.StudentName.Contains(searchText, StringComparison.OrdinalIgnoreCase))

                    ||

                    (!string.IsNullOrWhiteSpace(x.ClassName) &&
                     x.ClassName.Contains(searchText, StringComparison.OrdinalIgnoreCase))

                    ||

                    (!string.IsNullOrWhiteSpace(x.SectionName) &&
                     x.SectionName.Contains(searchText, StringComparison.OrdinalIgnoreCase))

                    ||

                    (!string.IsNullOrWhiteSpace(x.FatherName) &&
                     x.FatherName.Contains(searchText, StringComparison.OrdinalIgnoreCase))

                    ||

                    (!string.IsNullOrWhiteSpace(x.SMSMobileNo) &&
                     x.SMSMobileNo.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                );
            }

            return query;
        }
    }
    protected override void OnInitialized()
    {
        PermissionState.OnChange += StateHasChanged;
        currentUrl = Nav.Uri;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CurrentSession = await _commonmethod.SetCurrentSessionData();

            var userResult = await sessionStorage.GetAsync<string>("UserName");
            username = userResult.Value ?? string.Empty;

            var branchResult = await sessionStorage.GetAsync<string>("BranchCode");
            branchcode = branchResult.Value;

            var groupResult = await sessionStorage.GetAsync<string>("GroupCode");
            groupcode = groupResult.Value;

            await LoadData();
            StateHasChanged();
        }
    }

    private async Task LoadData()
    {
        sessionlist = await httpService.Get<List<SessionModel>>("Session/GetSession") ?? new();
        string ApiUri = "BranchClass/GetClassCode";
        classlist = await httpService.Get<List<BranchClassModel>>(ApiUri) ?? new();
        disCategorielist = await httpService.Get<List<DisCategoryModel>>($"DisCategory/GetDisCategory?sessionId={CurrentSession}") ?? new();
        StateHasChanged();
    }

    private async Task OnSearchClassChanged()
    {
        searchRequest.SectionCode = string.Empty;
        sectionlist = new();

        if (string.IsNullOrEmpty(searchRequest.ClassCode))
        {
            StateHasChanged();
            return;
        }

        searchAny.GroupCode = groupcode;
        searchAny.BranchCode = branchcode;
        searchAny.RequestName = searchRequest.ClassCode;

        string ApiUri1 = "ClassSection/GetClassWithSection";
        var apiResponse = await httpService.Post<ApiResponse<List<SectionModel>>>(ApiUri1, searchAny) ?? new();
        if (apiResponse.Success)
        {
            sectionlist = apiResponse.Data ?? new();
        }
        StateHasChanged();
    }

    private void OpenNewPopup()
    {
        disciplineModel = new()
        {
            IndisciplineDate = DateTime.Today
        };
        selectedStudent = null;
        incidentCharCount = 0;
        ShowDisciplinePopup = true;

    }

    private void CloseDisciplinePopup()
    {
        ShowDisciplinePopup = false;
        addStudentDiscipline = new();
        disciplineModel = new();
        studentSearchResults.Clear();
        studentGridSearch = "";
    }

    private void OnIncidentDetailsInput(ChangeEventArgs e)
    {
        incidentCharCount = e.Value?.ToString()?.Length ?? 0;
    }

    // Opens the nested Select Student popup. Pre-highlights the currently
    // selected student's radio (so "Change Student" shows their row already
    // checked) but does NOT touch the main card until confirmed.
    private void ShowStudentSearch()
    {
        ShowDisciplinePopup = false;
        ShowSelectStudentPopup = true;
        StateHasChanged();
    }

    private void CloseStudentSearch()
    {
        ShowSelectStudentPopup = false;
        ShowDisciplinePopup = true;
        studentSearchResults.Clear();
        studentGridSearch = "";
        StateHasChanged();

    }


    private async Task SearchStudents()
    {
        searchRequest.GroupCode = groupcode;
        searchRequest.BranchCode = branchcode;
        searchRequest.SessionId = CurrentSession;
        ShowDisciplinePopup = false;
        ShowSelectStudentPopup = false;
        IsLoading = true;
        StateHasChanged();

        try
        {
            string apiUrl = isSibling ? "StudentDiscipline/GetSearchedSiblingStudentData" : "StudentDiscipline/GetSearchedStudent";

            var apiResponse = await httpService.Post<ApiResponse<List<SiblingStudentResponse>>>(apiUrl, searchRequest);

            studentSearchResults = (apiResponse != null && apiResponse.Success) ? (apiResponse.Data ?? new()) : new();
            ShowSelectStudentPopup = true;
            if (apiResponse != null && apiResponse.Success == false)
            {
                await Alert.ShowWarning(apiResponse.Message ?? "No records found.");
                ShowDisciplinePopup = true;
                ShowSelectStudentPopup = true;
                StateHasChanged();
            }
        }
        catch
        {
            studentSearchResults = new();
            await Alert.ShowWarning("An error occurred while searching for students.");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // Footer "Select Student" button inside the nested popup - only NOW
    // does the confirmed pick get applied to the main card & popup closed.
    private async Task ConfirmSelectStudent()
    {
        ShowDisciplinePopup = false;
        ShowSelectStudentPopup = false;
        var data = studentSearchQuery.Where(x => x.IsSelected).ToList();
        if (data.Count == 0 || data.Count > 1)
        {
            await JS.InvokeVoidAsync("showSelectRecordAlert");
            ShowSelectStudentPopup = true;
            StateHasChanged();
            return;

        }

        selectedStudent = data[0];
        disciplineModel.ControlNo = selectedStudent.ControlNo;
        disciplineModel.StudentName = selectedStudent.StudentName;
        disciplineModel.ClassName = selectedStudent.ClassName;
        disciplineModel.SectionName = selectedStudent.SectionName;
        ShowSelectStudentPopup = false;
        ShowDisciplinePopup = true;
        StateHasChanged();
    }

    private async Task OnSaveDiscipline()
    {
        ShowDisciplinePopup = false;
        if (selectedStudent == null)
        {
            await Alert.ShowWarning("Please select a student.");
            ShowDisciplinePopup = true;
            StateHasChanged();
            return;
        }
        addStudentDiscipline.GroupCode = groupcode;
        addStudentDiscipline.BranchCode = branchcode;
        addStudentDiscipline.SessionId = CurrentSession;
        addStudentDiscipline.CreatedBy = username;
        addStudentDiscipline.StudentId = selectedStudent.StudentId;
        IsLoading = true;
        StateHasChanged();

        try
        {
            // TODO: rename this endpoint to your actual save API
            string apiUrl = "StudentDiscipline/AddStudentDisciplineData";
            var apiResponse = await httpService.Post<ApiResponse<object>>(apiUrl, addStudentDiscipline);

            if (apiResponse != null && apiResponse.Success)
            {
                await Alert.ShowSuccess("Record saved successfully.");
                ShowDisciplinePopup = false;
                addStudentDiscipline=new();
                disciplineModel = new();
                studentSearchResults.Clear();
                studentGridSearch = "";
                await SearchDisciplineList();
            }
            else
            {
                await Alert.ShowWarning(apiResponse?.Message ?? "Record was not saved.");
            }
        }
        catch (Exception ex)
        {
            await Alert.ShowError($"{@Localizer["Error"]}: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task SearchDisciplineList()
    {
        try
        {
            IsLoading = true;
            ShowPopup = false;
            indisciplineCommentRequest.GroupCode = groupcode;
            indisciplineCommentRequest.BranchCode = branchcode;

            string apiUrl = "StudentDiscipline/GetIndisciplineCommentData";
            var apiResponse = await httpService.Post<ApiResponse<List<IndisciplineCommentResponse>>>(apiUrl, indisciplineCommentRequest);

            disciplineList = (apiResponse != null && apiResponse.Success)
                ? (apiResponse.Data ?? new())
                : new();
            IsLoading = false;
        }
        catch
        {
            disciplineList = new();
        }
        StateHasChanged();
    }
    private void ClosePopup()
    {
        ShowPopup = false;
        StateHasChanged();
    }
    private void OpenSearch()
    {
        ShowPopup = true;
        StateHasChanged();
    }
    private async Task OpenDateFrom(string value)
    {
        if (value == "DateFrom")
        {
            await JS.InvokeVoidAsync("openDatePicker", dateFromInput);
        }
        else
        {
            await JS.InvokeVoidAsync("openDatePicker", dateToInput);

        }
    }
    private async Task OnClassChanged()
    {

        indisciplineCommentRequest.SectionId = string.Empty;
        sectionlist = new();
        if (string.IsNullOrEmpty(indisciplineCommentRequest.ClassCode))
        {
            StateHasChanged();
            return;
        }

        searchAny.GroupCode = groupcode;
        searchAny.BranchCode = branchcode;
        searchAny.RequestName = indisciplineCommentRequest.ClassCode;
        string ApiUri = "ClassSection/GetClassWithSection";
        var apiResponse = await httpService.Post<ApiResponse<List<SectionModel>>>(ApiUri, searchAny) ?? new();
        if (apiResponse.Success)
        {
            sectionlist = apiResponse.Data ?? new();
        }
        StateHasChanged();
    }
    private async Task ActiveData(IndisciplineCommentResponse row)
    {
        var submit = await Alert.ShowConfirm("Are you sure, you want to activate the selected record?");
        if (!submit)
        {
            StateHasChanged();
            return;
        }

        IsLoading = true;
        StateHasChanged();

        try
        {
            var model = new IndisciplineCommentResponse { DisId = row.DisId };

            string apiUrl = "StudentDiscipline/EnableStudentDiscipline";
            var apiResponse = await httpService.Post<ApiResponse<object>>(apiUrl, model);

            if (apiResponse != null && apiResponse.Success)
            {
                await Alert.ShowSuccess("Selected record activated successfully.");
                await SearchDisciplineList();
            }
            else
            {
                await Alert.ShowWarning(apiResponse?.Message ?? "Failed to enable the discipline record.");
            }
        }
        catch (Exception ex)
        {
            await Alert.ShowError($"{@Localizer["Error"]}: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task DeactiveData(IndisciplineCommentResponse row)
    {
        var submit = await Alert.ShowConfirm("Are you sure, you want to deactivate the selected record?");
        if (!submit)
        {
            StateHasChanged();
            return;
        }

        IsLoading = true;
        StateHasChanged();

        try
        {
            var model = new IndisciplineCommentResponse { DisId = row.DisId };

            string apiUrl = "StudentDiscipline/DisbleStudentDisciplineData";
            var apiResponse = await httpService.Post<ApiResponse<object>>(apiUrl, model);

            if (apiResponse != null && apiResponse.Success)
            {
                await Alert.ShowSuccess("Selected record deactivated successfully.");
                await SearchDisciplineList();
            }
            else
            {
                await Alert.ShowWarning(apiResponse?.Message ?? "Failed to disable the discipline record.");
            }
        }
        catch (Exception ex)
        {
            await Alert.ShowError($"{@Localizer["Error"]}: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }
    private void SelectStudent(SiblingStudentResponse selectedStudent)
    {
        foreach (var item in studentSearchResults)
        {
            item.IsSelected = false;
        }

        selectedStudent.IsSelected = true;
        StateHasChanged();
    }
}
