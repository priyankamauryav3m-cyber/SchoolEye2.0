                                            </div>


                                            <div class="col-6 col-sm-4 col-md-2 col-lg px-2 mb-3 mb-lg-0">

                                                <div class="text-muted mb-1">
                                                    Class
                                                </div>

                                                <div class="fw-semibold ">
                                                    @disciplineModel.ClassName
                                                </div>

                                            </div>


                                            <div class="col-6 col-sm-4 col-md-2 col-lg px-2 mb-3 mb-lg-0">

                                                <div class="text-muted mb-1">
                                                    Section
                                                </div>

                                                <div class="fw-semibold ">
                                                    @disciplineModel.SectionName
                                                </div>

                                            </div>

                                        </div>
                                    }

                                </div>
                            </div>
                            @* <div class="col-12 px-2">
                                <div class="card p-3">
                                    <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2 mb-3">
                                        <div class="divider-box d-flex justify-content-between align-items-center gap-2">
                                            <p class="total-text-with-bg">
                                                Student Details
                                            </p>
                                            <hr class="m-0 w-webkit text-light-gray op-1">
                                            @if (selectedStudent != null)
                                            {
                                                <button type="button" class="table-btn" @onclick="ShowStudentSearch">Change Student</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="table-btn" @onclick="ShowStudentSearch">Select Student</button>
                                            }
                                        </div>
                                    </div>
                                  
                                    @if (selectedStudent == null)
                                    {
                                        <div class="border-box" style="border-style:dashed;height: 60px;padding: 10px 12px;">
                                            <p class="form-label fw-bold m-1">No student selected</p>
                                            <p class="form-label text-muted m-0">Choose a student before recording discipline details.</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="row m-0">
                                            <div class="col-12 col-sm-6 col-md-4 col-lg-4 px-2">
                                                <div class="form-box-group">
                                                    <input class="floating-input" placeholder=" " value="@CurrentSessionName" readonly disabled />
                                                    <label class="floating-label">Session Name</label>
                                                </div>
                                            </div>
                                            <div class="col-12 col-sm-6 col-md-4 col-lg-4 px-2">
                                                <div class="form-box-group">
                                                    <input class="floating-input" placeholder=" " value="@disciplineModel.ControlNo" readonly disabled />
                                                    <label class="floating-label">Student No.</label>
                                                </div>
                                            </div>
                                            <div class="col-12 col-sm-6 col-md-4 col-lg-4 px-2">
                                                <div class="form-box-group">
                                                    <input class="floating-input" placeholder=" " value="@disciplineModel.StudentName" readonly disabled />
                                                    <label class="floating-label">Student Name</label>
                                                </div>
                                            </div>
                                            <div class="col-12 col-sm-6 col-md-4 col-lg-4 px-2">
                                                <div class="form-box-group">
                                                    <input class="floating-input" placeholder=" " value="@disciplineModel.ClassName" readonly disabled />
                                                    <label class="floating-label">Class</label>
                                                </div>
                                            </div>
                                            <div class="col-12 col-sm-6 col-md-4 col-lg-4 px-2">
                                                <div class="form-box-group">
                                                    <input class="floating-input" placeholder=" " value="@disciplineModel.SectionName" readonly disabled />
                                                    <label class="floating-label">Section</label>
                                                </div>
                                            </div>
                                            <div class="col-12 col-sm-6 col-md-4 col-lg-4 px-2">
                                                <div class="form-box-group">
                                                    <InputDate class="floating-input" placeholder=" " @bind-Value="@addStudentDiscipline.IndisciplineDate" />
                                                    <label class="floating-label">Indiscipline Date</label>
                                                    <ValidationMessage For="@(() => addStudentDiscipline.IndisciplineDate)" />
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div> *@
                            <div class="col-12 px-2">
                                <div class="card p-3">
                                    <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2 mb-2">
                                        <div class="divider-box d-flex justify-content-between align-items-center gap-2">
                                            <p class="total-text-with-bg">
                                                Discipline Details
                                            </p>
                                            <hr class="m-0 w-webkit text-light-gray op-1">
                                        </div>
                                    </div>
                                    <div class="row m-0">
                                        <div class="col-12 col-sm-6 col-md-6 col-lg-4 px-2">
                                            <div class="form-box-group static-label">
                                                <InputSelect class="floating-input" placeholder=" " @bind-Value="@addStudentDiscipline.CategoryId">
                                                    <option value="0">Select</option>
                                                    @foreach (var data in disCategorielist)
                                                    {
                                                        <option value="@data.CategoryId">@data.CategoryName</option>
                                                    }

                                                </InputSelect>
                                                <label class="floating-label">
                                                    Category <span class="required">*</span>
                                                </label>
                                                <ValidationMessage For="@(() => addStudentDiscipline.CategoryId)" />
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-6 col-lg-4 px-2">
                                            <div class="form-box-group">
                                                <InputNumber class="floating-input" placeholder=" " @bind-Value="addStudentDiscipline.Fine" />
                                                <label class="floating-label">Fine</label>

                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-6 col-lg-4 px-2">
                                            <div class="form-box-group static-label">
                                                <InputDate class="floating-input" @bind-Value="addStudentDiscipline.IndisciplineDate" />
