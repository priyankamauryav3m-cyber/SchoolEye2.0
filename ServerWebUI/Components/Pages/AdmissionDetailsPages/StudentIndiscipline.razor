                                                <ValidationMessage For="@(() => addStudentDiscipline.IndisciplineDate)" />
                                            </div>
                                        </div>
                                        <div class="col-12 px-2">
                                            <div class="form-box-group">
                                                <InputTextArea class="floating-input" placeholder=" " rows="2" @bind-Value="addStudentDiscipline.IndisciplineComment" maxlength="500" />
                                                <label class="floating-label">
                                                    Incident details <span class="required">*</span>
                                                </label>
                                                <ValidationMessage For="@(() => addStudentDiscipline.IndisciplineComment)" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                    <div class="modal-footer d-flex justify-content-end gap-2">
                        <SaveUpdateButton OnClickCancel="@CloseDisciplinePopup" />
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
