@page "/online-registration-form"
@layout Layout.LoginLayout
@using DomainModel.Admin
@using DomainModel.SchoolMaster
@using System.Threading.Tasks
@using MyApp.Common
@inject Shared.IHttpService httpService
@inject HttpClient httpClient;
@inject ICommonMethod _commonmethod
@inject SweetAlertService Alert
@inject IStringLocalizer<Resource> Localizer
<section class="main-container m-0">
    <div class="row m-0 main-row">

        <div class="col-12 p-1">
            <div class="card">
                <div class="card-body pt-0">
                    <EditForm Model="registration" OnValidSubmit="Save" FormName="registration">

                        <DataAnnotationsValidator />

                        <div class="row p-1 form-row">
                            <div class="col-12 mt-3">
                                <div class="form-box">
                                    <img src="images/reg_logo.png" class="w-100" />
                                </div>
                            </div>
                            <hr class="m-0" />
                            <div class="col-12 px-2 mt-3">
                                <div class="form-div p-1 pb-3">
                                    <div class="form-title">
                                        <p class="mb-0">Student's Information</p>
                                    </div>
                                    <div class="row px-2">
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group">
                                                <InputText class="floating-input" placeholder=" " @bind-Value="registration.ChildFirstName" autocomplete="off" onkeypress="return /^[a-z A-Z ]$/.test(event.key)" maxlength="100" />
                                                <label class="floating-label">First Name <span class="required">*</span></label>
                                                <ValidationMessage For="@(() => registration.ChildFirstName)" />
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group">
                                                <InputText class="floating-input" placeholder=" " @bind-Value="registration.ChildMiddleName" autocomplete="off" onkeypress="return /^[a-z A-Z ]$/.test(event.key)" maxlength="100" />
                                                <label class="floating-label">Middle Name</label>
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group">
                                                <InputText class="floating-input" placeholder=" " @bind-Value="registration.ChildLastName" autocomplete="off" onkeypress="return /^[a-z A-Z ]$/.test(event.key)" maxlength="100" />
                                                <label class="floating-label">Last Name</label>
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group static-label">
                                                <InputSelect class="floating-input" placeholder=" " @bind-Value="registration.ClassCode">
                                                    <option value="" selected>--Select--</option>
                                                    @if (classlist != null)
                                                    {
                                                        foreach (var cls in classlist)
                                                        {
                                                            <option value="@cls.ClassCode">@cls.ClassName</option>
                                                        }
                                                    }

                                                </InputSelect>
                                                <label class="floating-label">Class <span class="required">*</span></label>
                                                <ValidationMessage For="@(() => registration.ClassCode)" />
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group">
                                                <InputDate class="floating-input" placeholder=" " @bind-Value="registration.DateOfBirth" autocomplete="off" maxlength="12" @bind-Value:after="OnDOBChanged" />
                                                <label class="floating-label">Date of Birth <span class="required">*</span></label>
                                                <ValidationMessage For="@(() => registration.DateOfBirth)" />
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box disabled">
                                                <div class="border-box d-flex justify-content-start align-items-center p-2">
                                                    <label class="d-flex align-items-center form-label"> @datecalulate</label>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group static-label">
                                                <InputSelect class="floating-input" placeholder=" " @bind-Value="registration.Gender">
                                                    <option value="" selected>-- Select --</option>
                                                    @if (genderModallist != null)
                                                    {
                                                        foreach (var cls in genderModallist)
                                                        {
                                                            <option value="@cls.GenderName">@cls.GenderName</option>
                                                        }
                                                    }
                                                </InputSelect>
                                                <label class="floating-label">Gander <span class="required">*</span></label>
                                                <ValidationMessage For="@(() => registration.Gender)" />
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group">
                                                <InputText class="floating-input" placeholder=" " @bind-Value="registration.ChildAadharNo" autocomplete="off" onkeypress="return  /^[0-9]$/.test(event.key)" maxlength="20" />
                                                <label class="floating-label">Aadhar No. <span class="required">*</span></label>
                                                <ValidationMessage For="@(() => registration.ChildAadharNo)" />
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group static-label">
                                                <InputSelect class="floating-input" placeholder=" " @bind-Value="registration.MotherTongue">
                                                    <option value="" selected hidden=""></option>
                                                    @foreach (var cls in mstMotherlist)
                                                    {
                                                        <option value="@cls.TongueId">@cls.TongueName</option>
                                                    }
                                                </InputSelect>
                                                <label class="floating-label">Mother Tongue</label>
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group static-label">
                                                <InputSelect class="floating-input" placeholder=" " @bind-Value="registration.Nationality">
                                                    <option value="0">-- Select --</option>
                                                    @if (countrylist != null)
                                                    {
                                                        foreach (var cls in countrylist)
                                                        {
                                                            <option value="@cls.CountryId">@cls.CountryName</option>
                                                        }
                                                    }
                                                </InputSelect>
                                                <label class="floating-label">Nationality</label>
                                                <ValidationMessage For="@(() => registration.Nationality)" />
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group">
                                                <InputText class="floating-input" placeholder=" " @bind-Value="registration.PreviousSchool" autocomplete="off" onkeypress="return /^[a-z A-Z ]$/.test(event.key)" maxlength="100" />
                                                <label class="floating-label">Name of the school last attended <span class="required">*</span></label>
                                                <ValidationMessage For="@(() => registration.PreviousSchool)" />
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group">
                                                <InputText class="floating-input" placeholder=" " @bind-Value="registration.PreviousSchoolAddress" autocomplete="off" onkeypress="return /^[a-z A-Z ]$/.test(event.key)" maxlength="100" />
                                                <label class="floating-label">Address of the school last attended<span class="required">*</span></label>
                                                <ValidationMessage For="@(() => registration.PreviousSchoolAddress)" />
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group">
                                                <InputText class="floating-input" placeholder=" " @bind-Value="registration.LastClass" onkeypress="return /[0-9]/.test(event.key)" autocomplete="off" maxlength="10" />
                                                <label class="floating-label">Last promoted to class</label>
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group">
                                                <InputText class="floating-input" placeholder=" " @bind-Value="registration.SessionName" onkeypress="return /[0-9-]/.test(event.key)" autocomplete="off" maxlength="10" />
                                                <label class="floating-label">In Academic Session</label>
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group">
                                                <InputText class="floating-input" placeholder=" " @bind-Value="registration.StudentResidentialAdd" autocomplete="off" onkeypress="return /^[a-z A-Z ]$/.test(event.key)" maxlength="100" />
                                                <label class="floating-label">Residential Address <span class="required">*</span></label>
                                                <ValidationMessage For="@(() => registration.StudentResidentialAdd)" />
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group">
                                                <InputText class="floating-input" placeholder=" " @bind-Value="registration.StuResidentialAddPinCode" onkeypress="return /[0-9]/.test(event.key)" autocomplete="off" maxlength="10" />
                                                <label class="floating-label">Pincode <span class="required">*</span></label>
                                                <ValidationMessage For="@(() => registration.StuResidentialAddPinCode)" />
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group static-label">
                                                <label class="floating-label">Same Address</label>
                                                <div class="border-box d-flex justify-content-center align-items-center">
                                                    <div class="d-flex align-items-center gap-1">
                                                        <InputCheckbox class="form-check-label" autocomplete="off" @bind-Value:after="OnCheckboxChanged" @bind-Value="IsSameAsCurrent"></InputCheckbox>
                                                        <label class="form-label">
                                                            Same as above
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-6 mt-3">
                                            <div class="form-box-group">
                                                <InputText class="floating-input" placeholder=" " @bind-Value="registration.StudentPermanentAdd" autocomplete="off" onkeypress="return /^[a-z A-Z ]$/.test(event.key)" maxlength="100" />
                                                <label class="floating-label">Permanent Address</label>
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group">
                                                <InputText class="floating-input" placeholder=" " @bind-Value="registration.StuPermanentAddPinCode" onkeypress="return /[0-9]/.test(event.key)" autocomplete="off" maxlength="10" />
                                                <label class="floating-label">Pincode</label>
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group">
                                                @* <InputNumber class="floating-input" placeholder=" " @bind-Value="registration.EnglishMarks" onkeypress="return /[0-9.]/.test(event.key)" autocomplete="off" maxlength="10" /> *@
                                                <input class="floating-input"
                                                       placeholder=" "
                                                       @bind="registration.EnglishMarks"
                                                       onkeypress="return /[0-9.]/.test(event.key)"
                                                       maxlength="5"
                                                       autocomplete="off" />
                                                <label class="floating-label">English(Max Marks: 80)</label>
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group">
                                                @* <InputNumber class="floating-input" placeholder=" " @bind-Value="registration.OptionalMarks" onkeypress="return /[0-9.]/.test(event.key)" autocomplete="off" maxlength="10" /> *@
                                                <input class="floating-input"
                                                       placeholder=" "
                                                       @bind="registration.OptionalMarks"
                                                       onkeypress="return /[0-9.]/.test(event.key)"
                                                       maxlength="5"
                                                       autocomplete="off" />
                                                <label class="floating-label">Hindi/Sanskrit/French(Max Marks: 80)</label>
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group">
                                                @* <InputNumber class="floating-input" placeholder=" " @bind-Value="registration.MathsMarks" onkeypress="return /[0-9.]/.test(event.key)" autocomplete="off" maxlength="10" /> *@
                                                <input class="floating-input"
                                                       placeholder=" "
                                                       @bind="registration.MathsMarks"
                                                       onkeypress="return /[0-9.]/.test(event.key)"
                                                       maxlength="5"
                                                       autocomplete="off" />
                                                <label class="floating-label">Maths(Max Marks: 80)</label>
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group">
                                                @* <InputNumber class="floating-input" placeholder=" " @bind-Value="registration.SocialSciencemarks" onkeypress="return /[0-9.]/.test(event.key)" autocomplete="off" maxlength="10" /> *@
                                                <input class="floating-input"
                                                       placeholder=" "
                                                       @bind="registration.SocialSciencemarks"
                                                       onkeypress="return /[0-9.]/.test(event.key)"
                                                       maxlength="5"
                                                       autocomplete="off" />
                                                <label class="floating-label">Social Studies(Max Marks: 80)</label>
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group">
                                                @* <InputNumber class="floating-input" placeholder=" " @bind-Value="registration.ScienceMarks" onkeypress="return /[0-9.]/.test(event.key)" autocomplete="off" maxlength="10" /> *@
                                                <input class="floating-input"
                                                       placeholder=" "
                                                       @bind="registration.ScienceMarks"
                                                       onkeypress="return /[0-9.]/.test(event.key)"
                                                       maxlength="5"
                                                       autocomplete="off" />
                                                <label class="floating-label">Science(Max Marks: 80)</label>
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group static-label">
                                                <label for="applied" class="floating-label">Does the child have any special needs? <span class="required">*</span></label>
                                                <div class="border-box d-flex justify-content-center align-items-center gap-3">
                                                    <InputRadioGroup @bind-Value="registration.SpecialNeeds" @bind-Value:after="OnStudentTypeChanged">
                                                        <div class="d-flex align-items-center gap-1">
                                                            <InputRadio Value="@(true)" />
                                                            <label class="form-label">
                                                                Yes
                                                            </label>
                                                        </div>
                                                        <div class="d-flex align-items-center gap-1">
                                                            <InputRadio Value="@(false)" />
                                                            <label class="form-label">
                                                                No
                                                            </label>
                                                        </div>

                                                    </InputRadioGroup>

                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group">
                                                <InputText class="floating-input" placeholder=" " @bind-Value="registration.SpecialneedsDetail" disabled="@IsBranchDisabled" autocomplete="off" onkeypress="return /^[a-z A-Z ]$/.test(event.key)" maxlength="100" />
                                                <label class="floating-label">If Yes please give details</label>
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group static-label">
                                                <label for="applied" class="floating-label">Previous School's Affiliation <span class="required">*</span></label>
                                                <div class="border-box d-flex justify-content-center align-items-center gap-3">
                                                    <InputRadioGroup @bind-Value="registration.IsCBSEDetails">
                                                        <div class="d-flex align-items-center gap-1">
                                                            <InputRadio Value="@("CBSE")" />
                                                            <label class="form-label">
                                                                CBSE
                                                            </label>
                                                        </div>
                                                        <div class="d-flex align-items-center gap-1">
                                                            <InputRadio Value="@("ICSE")" />
                                                            <label class="form-label">
                                                                ICSE
                                                            </label>
                                                        </div>
                                                        <div class="d-flex align-items-center gap-1">
                                                            <InputRadio Value="@("State Board")" />
                                                            <label class="form-label">
                                                                State Board
                                                            </label>
                                                        </div>

                                                    </InputRadioGroup>

                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group static-label">
                                                <InputSelect class="floating-input" placeholder=" " @bind-Value="registration.StreamCode" @bind-Value:after="GetConcessionData">
                                                    <option value="0">-- Select ---</option>
                                                    <option value="Medical">Medical</option>
                                                    <option value="Non-Medical">Non-Medical</option>
                                                    <option value="Commerce">Commerce</option>
                                                    <option value="Humanities">Humanities</option>
                                                </InputSelect>
                                                <label class="floating-label">Stream <span class="required">*</span></label>
                                                <ValidationMessage For="@(() => registration.StreamCode)" />
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group static-label">
                                                <InputSelect class="floating-input" placeholder=" " @bind-Value="registration.CompulsorySubject" disabled>

                                                    @if (Compulsorylist != null)
                                                    {
                                                        foreach (var cls in Compulsorylist)
                                                        {
                                                            <option value="@cls.ValueField">@cls.TextField</option>
                                                        }
                                                    }
                                                </InputSelect>
                                                <label class="floating-label">Compulsory Subject</label>
                                                <ValidationMessage For="@(() => registration.CompulsorySubject)" />
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group static-label">
                                                <InputSelect class="floating-input" placeholder=" " @bind-Value="registration.Subject3">
                                                    @* <option value="0">-- Select Subject --</option> *@

                                                    @if (Subject1 != null)
                                                    {
                                                        foreach (var cls in Subject1)
                                                        {
                                                            <option value="@cls.TextField">@cls.TextField</option>
                                                        }
                                                    }

                                                </InputSelect>
                                                <label class="floating-label">Subject-2 <span class="required">*</span></label>
                                                <ValidationMessage For="@(() => registration.Subject3)" />
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group static-label">
                                                <InputSelect class="floating-input" placeholder=" " @bind-Value="registration.Subject4">
                                                    @* <option value="0">-- Select Subject --</option> *@

                                                    @if (Subject2 != null)
                                                    {
                                                        foreach (var cls in Subject2)
                                                        {
                                                            <option value="@cls.TextField">@cls.TextField</option>
                                                        }
                                                    }

                                                </InputSelect>
                                                <label class="floating-label">Subject-3 <span class="required">*</span></label>
                                                <ValidationMessage For="@(() => registration.Subject4)" />
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group static-label">
                                                <InputSelect class="floating-input" placeholder=" " @bind-Value="registration.Subject5">
                                                    @*   <option value="0">-- Select Subject --</option> *@

                                                    @if (Subject3 != null)
                                                    {
                                                        foreach (var cls in Subject3)
                                                        {
                                                            <option value="@cls.TextField">@cls.TextField</option>
                                                        }
                                                    }

                                                </InputSelect>
                                                <label class="floating-label">Subject-4 <span class="required">*</span></label>
                                                <ValidationMessage For="@(() => registration.Subject5)" />
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group static-label">
                                                <InputSelect class="floating-input" placeholder=" " @bind-Value="registration.Subject6">
                                                    @*  <option value="0">-- Select Subject --</option> *@

                                                    {
                                                    @if (Subject4 != null)
                                                    {
                                                        foreach (var cls in Subject4)
                                                        {
                                                            <option value="@cls.TextField">@cls.TextField</option>
                                                        }

                                                    }
                                                </InputSelect>
                                                <label class="floating-label">Subject-5 <span class="required">*</span></label>
                                                <ValidationMessage For="@(() => registration.Subject6)" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 px-2 mt-3">
                                <div class="form-div p-1 pb-3">
                                    <div class="form-title">
                                        <p class="mb-0">Mother's Information</p>
                                    </div>
                                    <div class="row px-2">
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group">
                                                <InputText class="floating-input" placeholder=" " @bind-Value="registration.MotherFName" autocomplete="off" onkeypress="return /^[a-z A-Z ]$/.test(event.key)" maxlength="100" />
                                                <label class="floating-label">First Name <span class="required">*</span></label>
                                                <ValidationMessage For="@(() => registration.MotherFName)" />
                                            </div>
                                        </div>
                                        @* <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group">
                                                <InputText class="floating-input" placeholder=" " @bind-Value="registration.MotherMName" autocomplete="off" onkeypress="return /^[a-z A-Z ]$/.test(event.key)" maxlength="100" />
                                                <label class="floating-label">Middle Name</label>
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group">
                                                <InputText class="floating-input" placeholder=" " @bind-Value="registration.MotherLName" autocomplete="off" onkeypress="return /^[a-z A-Z ]$/.test(event.key)" maxlength="100" />
                                                <label class="floating-label">Last Name</label>
                                            </div>
                                        </div> *@
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group">
                                                <InputText class="floating-input" placeholder=" " @bind-Value="registration.MotherAadharNo" autocomplete="off" onkeypress="return  /^[0-9]$/.test(event.key)" maxlength="20" />
                                                <label class="floating-label">Aadhar No. <span class="required">*</span></label>
                                                <ValidationMessage For="@(() => registration.MotherAadharNo)" />
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group static-label">
                                                <InputSelect class="floating-input" placeholder=" " @bind-Value="registration.MotherQualification">
                                                    <option value="0">-- Select --</option>
                                                    @if (qulifationlist != null)
                                                    {
                                                        foreach (var cls in qulifationlist)
                                                        {
                                                            <option value="@cls.QualificationTypeId">@cls.QualificationName</option>
                                                        }
                                                    }
                                                </InputSelect>
                                                <label class="floating-label">Qualification <span class="required">*</span></label>
                                                <ValidationMessage For="@(() => registration.MotherQualification)" />
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group static-label">
                                                <InputSelect class="floating-input" placeholder=" " @bind-Value="registration.MotherOccupation">
                                                    <option value="0">-- Select --</option>
                                                    @if (getoccupationlist != null)
                                                    {
                                                        foreach (var cls in getoccupationlist)
                                                        {
                                                            <option value="@cls.OccupationId">@cls.OccupationName</option>
                                                        }
                                                    }
                                                </InputSelect>
                                                <label class="floating-label">Occupation <span class="required">*</span></label>
                                                <ValidationMessage For="@(() => registration.MotherOccupation)" />
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mt-3">
                                            <div class="form-box-group">
