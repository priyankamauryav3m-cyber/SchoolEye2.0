<CustomAlert @ref="customAlert" Title="Alert" />
@code {
    private OnlineRegistration registration = new();
    private List<BranchClassModel> classlist = new();
    private CustomAlert? customAlert;
    private List<GenderModal> genderModallist = new();
    private List<MstMotherTongue> mstMotherlist = new();
    private List<CountryModel> countrylist = new();
    private List<Qualification> qulifationlist = new();
    private List<OccupationModal> getoccupationlist = new();
    private List<ShareDomain> Compulsorylist = new();
    private List<ShareDomain> result = new();
    private List<ShareDomain> Subject1 = new();
    private List<ShareDomain> Subject2 = new();
    private List<ShareDomain> Subject3 = new();
    private List<ShareDomain> Subject4 = new(); private string? datecalulate = "";
    private string? branchcode = "03";
    private string? groupcode = "18";
    private string? username = "Online";
    private string? SessionName;
    private bool IsSameAsCurrent;
    private string previuscode = "01";
    private bool IsBranchDisabled = true;
    private int firstNumber;
    private int secondNumber;
    private string operation = "";
    private int correctResult;
    private string? inputcaptcha;
    private bool termsaccept = false;
    private long CurrentSession;
    private void OnStudentTypeChanged()
    {
        if (registration.SpecialNeeds)
        {
            IsBranchDisabled = false;   // Enable dropdown
        }
        else
        {
            IsBranchDisabled = true;    // Disable dropdown
        }
    }
    private async Task LoadData()
    {
        getoccupationlist = await httpService.Get<List<OccupationModal>>("occupation/AllOccupation") ?? new();
        mstMotherlist = await httpService.Get<List<MstMotherTongue>>("ClassSection/GetMstMotherTongue") ?? new();
        classlist = await httpService.Get<List<BranchClassModel>>("BranchClass/GetClassCode") ?? new();
        qulifationlist = await httpService.Get<List<Qualification>>("Qualification/GetQualification") ?? new();
        genderModallist = await httpService.Get<List<GenderModal>>("gender/GetGender") ?? new();
        countrylist = await httpService.Get<List<CountryModel>>("Country/GetCountry") ?? new();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CurrentSession = await CommonMethod.SetCurrentSessionData();
            await LoadData();
            SessionName = await _commonmethod.GetCurrentSession();
            GenerateMathProblem();
        }
        StateHasChanged();
    }
    private async Task OnDOBChanged()
    {
        try
        {
            if (!registration.DateOfBirth.HasValue)
                return;
            if (registration.DateOfBirth <= DateTime.Today)
            {
                if (registration.DateOfBirth == null)
                {
                    datecalulate = "";
                    return;
                }
                var dateOfBirth = Convert.ToDateTime(registration.DateOfBirth);
                datecalulate = _commonmethod.CalculateAge(dateOfBirth);
            }
            else
            {
                await customAlert!.ShowCustomAlert("Please choose the correct Date of Birth.", false);
                registration.DateOfBirth = null;
                StateHasChanged();
            }
        }
        catch (Exception)
        {

        }
        finally
        {
            StateHasChanged();
        }
    }
    private void RefreshCaptcha()
    {
        GenerateMathProblem();
    }
    private void GenerateMathProblem()
    {
        Random random = new Random();
        firstNumber = random.Next(1, 9);
        secondNumber = random.Next(1, 9);
        operation = "+";
        correctResult = firstNumber + secondNumber;
    }
    // private async Task GetData()
    // {
    //     var branchResult = await sessionStorage.GetAsync<string>("BranchCode");
    //     branchcode = branchResult.Value;
    //     var groupResult = await sessionStorage.GetAsync<string>("GroupCode");
    //     groupcode = groupResult.Value; var userResult = await sessionStorage.GetAsync<string>("UserName");
    //     username = userResult.Value;
    // }
    private async Task Save()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(inputcaptcha))
            {

                await customAlert!.ShowCustomAlert("Please solve the captcha before logging in!", false);
                return;
            }
            if (!termsaccept)
            {
                await customAlert!.ShowCustomAlert("Please accept Terms & Conditions", false);
                return;
            }
            if (!int.TryParse(inputcaptcha, out int userInput) || userInput != correctResult)
            {
                await customAlert!.ShowCustomAlert("Captcha code not solved correctly!", false);
                return;
            }
            if (registration.IsCBSEDetails == "CBSE")
            {
                registration.IsCBSEDetails = "CBSE";
                registration.IsCBSE = true;
            }
            else if (registration.IsCBSEDetails == "ICSE")
            {
                registration.IsCBSEDetails = "ICSE";
                registration.IsCBSE = false;
            }
            else
            {
                registration.IsCBSEDetails = "STATE BOARD";
                registration.IsCBSE = false;
            }
            registration.CreatedBy = username;
            registration.GroupCode = groupcode;
            registration.BranchCode = branchcode;
            registration.SessionId = CurrentSession;
            string apiUrl = "Registration/OnlineRegistration";
            var apiResponse = await httpClient.PostAsJsonAsync(apiUrl, registration);
            if (apiResponse.IsSuccessStatusCode)
            {
                var result = await apiResponse.Content.ReadFromJsonAsync<ApiResponse<string>>();
                var registrationNo = result?.Data;
                await Alert.ShowRegistrationSuccess($"{Localizer["RegSave"]}<br/>" + $"<b>Registration No:</b> {registrationNo}");
                // await customAlert!.ShowCustomAlert($"Registration successful. Registration No: {registrationNo}", false);

            }
            else
            {
                await customAlert!.ShowCustomAlert("Registration failed. Please try again.", false);
            }
            registration = new OnlineRegistration();
            inputcaptcha = "";
            termsaccept = false;
            datecalulate = "";
            StateHasChanged();


        }
        catch (Exception ex)
        {
            registration = new OnlineRegistration();
            inputcaptcha = "";
            termsaccept = false;
            await Alert.ShowError($"{@Localizer["Error"]}: {ex.Message}");
        }
        finally
        {

            StateHasChanged();
        }
    }
    private async Task OnCheckboxChanged()
    {
        try
        {
            if (IsSameAsCurrent)
            {
                registration.StudentPermanentAdd = registration.StudentResidentialAdd;
                registration.StuPermanentAddPinCode = registration.StuResidentialAddPinCode;
            }
            else
            {
                registration.StudentPermanentAdd = null;
                registration.StuPermanentAddPinCode = null;
            }
        }
        catch (Exception ex)
        {
            await Alert.ShowError($"{@Localizer["Error"]}: {ex.Message}");

        }
        finally
        {

            StateHasChanged();
        }
    }
    private async void GetConcessionData()
    {
        result = new();
        Compulsorylist = new();
        string ApiUri1 = $"SubjectName/GetCompulsorySubjects?groupCode={groupcode}&branchCode={branchcode}&streamCode={registration.StreamCode}";
        Compulsorylist = await httpService.Get<List<ShareDomain>>(ApiUri1) ?? new();
        for (int count = 1; count <= 4; count++)
        {
            try
            {
                string ApiUri = $"SubjectName/ElectiveSubjects?groupCode={groupcode}&branchCode={branchcode}&streamCode={registration.StreamCode}&groupId={count}&firstElement=-- Select --";

                result = await httpService.Get<List<ShareDomain>>(ApiUri) ?? new();

                switch (count)
                {
                    case 1:
                        Subject1 = result;
                        break;

                    case 2:
                        Subject2 = result;
                        break;

                    case 3:
                        Subject3 = result;
                        break;

                    case 4:
                        Subject4 = result;
                        break;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine(ex.Message);
            }
        }

        StateHasChanged();
    }
