                            </div>
                        </button>
                    </div>

                </div>
            </div>
        </div>
    }

}


@if (ShowHandoverPopup)
{
    <div class="custom-modal row m-0 align-items-center">
        <div class="col-12 col-sm-10 col-md-9 col-lg-8 col-xl-9">
            <div class="modal-content clearfix main-popup">
                <div class="head-btn d-flex align-items-center justify-content-between">
                    <h5 class="modal-title">Handover Document</h5>
                    <button data-access="Close" type="button" @onclick="CloseHandoverPopup" class="close"><span aria-hidden="true">×</span></button>
                </div>
