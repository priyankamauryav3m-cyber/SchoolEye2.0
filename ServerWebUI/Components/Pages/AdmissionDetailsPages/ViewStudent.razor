    protected IQueryable<ViewStudentModal> moduleQuery
    {
        get
        {
            var result = viewStudentlist.AsQueryable();
            if (!string.IsNullOrEmpty(nameFilter))
            {
                result = result.Where(x => (x.StudentName != null && x.StudentName.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)) ||
               (x.ControlNo != null && x.ControlNo.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)));

            }
            return result;
        }
    }
    protected IQueryable<GetSearchedViewStudentModel> SearchedstudentmoduleQuery
    {
        get
        {
            var result = getSearchedViewStudentlist.AsQueryable();
            if (!string.IsNullOrEmpty(nameFilter))
            {
                result = result.Where(x => (x.StudentName != null && x.StudentName.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)) ||
               (x.ControlNo != null && x.ControlNo.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)) ||
                 (x.RollNo != null && x.RollNo.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)));

            }
            return result;
        }
    }
    private async Task ExportToExcel()
    {
        IsLoading = true;
        if (roleId == "8")
        {
            var data = moduleQuery.Where(x => x.IsSelected).ToList();
            if (data.Count == 0)
            {
                IsLoading = false;
                await Alert.ShowWarning("Please select record");
                StateHasChanged();

                return;
            }
            var response = await httpService.Post<ApiResponse<object>>("Export/ViewStudentExcelData", data);
            if (response != null && response.Success)
            {
                var base64 = response.Data;
                await JS.InvokeVoidAsync("downloadExcel", base64, "ViewStudent.xlsx");
                StateHasChanged();
            }
        }
        else
        {
            var data = SearchedstudentmoduleQuery.Where(x => x.IsSelected).ToList();
            if (data.Count == 0)
            {
                IsLoading = false;
                await Alert.ShowWarning("Please select record");
                StateHasChanged();

                return;
            }
            var response = await httpService.Post<ApiResponse<object>>("Export/ViewStudentExcelData", data);
            if (response != null && response.Success)
            {
                var base64 = response.Data;
                await JS.InvokeVoidAsync("downloadExcel", base64, "ViewStudent.xlsx");
                StateHasChanged();
            }
        }

        IsLoading = false;
        StateHasChanged();
    }
    private async Task OnClassAllChanged()
    {
        foreach (var item in classlist)
        {
            item.IsSelected = SelectAll;
        }

        await GetSectionData();
    }
    private async Task GetSectionData()
    {
        try
        {
            var selectedClasses = classlist.Where(x => x.IsSelected).ToList();

            SelectAll = selectedClasses.Count == classlist.Count;
            if (!selectedClasses.Any())
            {
                sectionModellist.Clear();
                SelectAllSection = false;

                StateHasChanged();
                return;
            }
            if (selectedClasses.Count > 1)
            {
                sectionModellist.Clear();

                SelectAllSection = true;

                StateHasChanged();
                return;
            }
            SelectAllSection = false;
            searchAny.GroupCode = groupcode;
            searchAny.BranchCode = branchcode;
            searchAny.RequestName = selectedClasses.First().ClassCode;
            string ApiUri = "ClassSection/GetClassWithSection";
            var apiResponse = await httpService.Post<ApiResponse<List<SectionModel>>>(ApiUri, searchAny) ?? new();
            if (apiResponse.Success)
            {
                sectionModellist = apiResponse.Data ?? new();
            }

            StateHasChanged();
        }
        catch
        {
            return;
        }
    }
    private void ToggleSelectAllSection()
    {
        foreach (var item in sectionModellist)
        {
            item.IsSelected = SelectAllSection;
        }

        StateHasChanged();
    }
    private string SelectedText
    {
        get
        {
            if (SelectAll && classlist.Any())
                return "All";
            var selected = classlist.Where(x => x.IsSelected).Select(x => x.ClassName).ToList();
            if (!selected.Any())
                return "Select Class";

            return string.Join(", ", selected);
        }
    }
    private string SelectedSectionText
    {
        get
        {
            if (SelectAllSection)
                return "All";

            var selected = sectionModellist.Where(x => x.IsSelected).Select(x => x.SectionName).ToList();

            if (!selected.Any())
                return "Select Section";

            return string.Join(", ", selected);
        }
    }

    private async Task SearchStudentData()
    {

        IsLoading = true;
        ShowPopup = false;

        try
        {
            studentRequest.GroupCode = groupcode;
            studentRequest.BranchCode = branchcode;
            studentRequest.SessionId = CurrentSession;
            studentRequest.ClassCode = string.Join(",", classlist.Where(x => x.IsSelected).Select(x => x.ClassCode));
            studentRequest.SectionId = string.Join(",", sectionModellist.Where(x => x.IsSelected).Select(x => x.SectionId));
            string apiUrl = "ViewStudent/ViewStudentList";
            var apiResponse = await httpService.Post<ApiResponse<List<ViewStudentModal>>>(apiUrl, studentRequest) ?? new();
            if (apiResponse.Success)
            {
                viewStudentlist = apiResponse.Data ?? new List<ViewStudentModal>();
                studentRequest = new();
            }
            else
            {
                viewStudentlist = new List<ViewStudentModal>();
            }

        }
        catch
        {
            viewStudentlist = new List<ViewStudentModal>();
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }
    private async Task GetSearchedStudent()
    {

        IsLoading = true;
        ShowPopup = false;
        try
        {
            studentRequestModel.GroupCode = groupcode;
            studentRequestModel.BranchCode = branchcode;
            studentRequestModel.SessionId = CurrentSession;
            studentRequestModel.IsEWS = "0";
            studentRequestModel.JoinType = "inner";
            studentRequestModel.ClassCode = string.Join(",", classlist.Where(x => x.IsSelected).Select(x => x.ClassCode));
            studentRequestModel.SectionCode = string.Join(",", sectionModellist.Where(x => x.IsSelected).Select(x => x.SectionId));
            string apiUrl = "ViewStudent/ViewGetSearchedStudentList";
            var apiResponse = await httpService.Post<ApiResponse<List<GetSearchedViewStudentModel>>>(apiUrl, studentRequestModel) ?? new();
            if (apiResponse.Success)
            {
                getSearchedViewStudentlist = apiResponse.Data ?? new List<GetSearchedViewStudentModel>();
                studentRequestModel = new();
            }
            else
            {
                getSearchedViewStudentlist = new List<GetSearchedViewStudentModel>();
            }

        }
        catch
        {
            getSearchedViewStudentlist = new List<GetSearchedViewStudentModel>();
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }
