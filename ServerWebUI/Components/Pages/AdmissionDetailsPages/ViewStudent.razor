<AdmitChild IsVisible="@addstudent" OnClose="@ClosePopup" />
<StudentViewDetails IsVisible="@OpenDetail" SessionId="@CurrentSession" CurrectUrl="@currentUrl" StudentId="@SelectedStudentId" OnClose="@ClosePopup" />
<StudentVisitorDetails IsVisible="@OpenVisitorDetail" SessionId="@CurrentSession" StudentMobileNo="@SelectedStudentMobileNo"
                       CurrectUrl="@currentUrl" StudentId="@SelectedStudentId" StudentName="@SelectedStudentName" OnClose="@ClosePopup" StudentNo="@SelectedStudentNo" />
@code {
    private bool SelectAll = true;
    private bool OpenDetail = false;
    private bool OpenVisitorDetail = false;
    private bool SelectAllSection = true;
    private bool IsAllSelected;
    public bool IsSelected { get; set; }
    private List<BranchClassModel> classlist = new();
    private bool IsLoading = false;
    private List<GenderModal> genderModallist = new();
    private List<SessionModel> sessionlist = new();
    private List<ViewStudentModal> viewStudentlist = new();
    private List<GetSearchedViewStudentModel> getSearchedViewStudentlist = new();
