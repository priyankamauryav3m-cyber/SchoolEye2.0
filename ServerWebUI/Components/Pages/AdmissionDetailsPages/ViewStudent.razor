@page "/viewstudent"
@using DomainModel.Admin
@using DomainModel.SchoolMaster
@using System.Net
@using System.Text.Json
@using Microsoft.AspNetCore.Mvc
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyApp.Common
@inject Shared.IHttpService httpService
@inject IJSRuntime JSs
@inject HttpClient Http
@inject IStringLocalizer<Resource> Localizer
@inject SweetAlertService Alert
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using ServerWebUI.Components.Pages.CommonPages
@inject IHttpClientFactory ClientFactory
@inject ICommonMethod _commonmethod
@inject IJSRuntime JS
<style>
    .quickgrid tbody tr.selectRow td {
        background-color: #cce5ff !important;
    }

    .quickgrid thead th:last-child {
        min-width: 75px;
    }

    .quickgrid thead th:nth-last-child(2) {
        min-width: 50px;
    }
</style>


@if (roleId == "4")
{
    <div class="main-container">
        <div class="row m-0 main-row">
            <div class="col-12 p-1" id="main-header">
                <div class="page-heading d-flex align-items-center justify-content-between">
                    <p class="m-0 page-name px-1">View Student</p>
                    <div class="d-flex align-items-center gap-2">

                        <div class="form-box">
                            <InputSelect @bind-Value="CurrentSession" name="session" class="form-input">
                                <option value="0">-- Select Session --</option>
                                @foreach (var data in sessionlist.Where(x => x.IsValid == true))
                                {
                                    <option value="@data.SessionId">@data.SessionName </option>
                                }
                            </InputSelect>
                        </div>
                        <div class="form-box">
                            <button class="form-input w-webkit" type="button" data-bs-toggle="dropdown">
                                @SelectedText
                            </button>
                            <div class="dropdown-menu cu-dropdown" style="max-height:350px; overflow-y:auto; align-items:center; align-content:center;">

                                <div class="form-check">
                                    <input class="form-check-input map-checkbox" type="checkbox" @bind="SelectAll" @bind:after="OnClassAllChanged" />

                                    <span>All</span>
                                </div>

                                @foreach (var item in classlist)
                                {
                                    <div class="form-check">

                                        <input class="form-check-input map-checkbox" type="checkbox" @bind="item.IsSelected" @bind:after="GetSectionData" />
                                        <span>@item.ClassName</span>

                                    </div>
                                }

                            </div>
                        </div>

                        <div class="form-box">

                            <button class="form-input" type="button" data-bs-toggle="dropdown">
                                @SelectedSectionText
                            </button>

                            <div class="dropdown-menu" style="max-height:350px; overflow-y:auto;">

                                <div class="form-check">

                                    <input class="form-check-input map-checkbox" type="checkbox" @bind="SelectAllSection" @bind:after="ToggleSelectAllSection" />

                                    <span>All</span>

                                </div>

                                @foreach (var item in sectionModellist)
                                {
                                    <div class="form-check">

                                        <input class="form-check-input map-checkbox"
                                               type="checkbox"
                                               @bind="item.IsSelected" />

                                        <span>@item.SectionName</span>

                                    </div>
                                }

                            </div>
                        </div>

                        <div class="form-box">
                            <div class="d-flex gap-2">
                                <button class="icon-btn icon-btn-white open-popup " @onclick="OpenSearch" data-id="popup" tabindex="0">
                                    <i class="bi bi-sliders"></i>
                                </button>
                            </div>
                        </div>
                        <div class="form-box">
                            <button class="ui fade op-1 animated button form-btn" @onclick="GetSearchedStudent" tabindex="0">
                                <div class="visible content">Search</div>
                                <div class="hidden content">
                                    <i class="bi bi-search"></i>
                                </div>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 p-1">
                <div class="card">
                    <div class="card-body table-card p-0">
                        <div class="quick-main">
                            <div class="grid-box-with-btn">
                                <QuickGrid Items="@SearchedstudentmoduleQuery" Pagination="@pagination" Class="table">

                                    <TemplateColumn Title="" Align="Align.Left">
                                        <HeaderTemplate>
                                            <div>
                                                <input type="checkbox" @bind="IsAllSelected" @bind:after="ToggleAll" @onclick:stopPropagation="true" />
                                            </div>
                                        </HeaderTemplate>
                                        <ChildContent>
                                            <div>
                                                <input type="checkbox" @bind="context.IsSelected" @onclick:stopPropagation="true" />
                                            </div>
                                        </ChildContent>
                                    </TemplateColumn>

                                    <PropertyColumn Class="text-right" Property="@(x => x.RollNo)" Title="Roll No." Align="Align.Center">

                                    </PropertyColumn>
                                    <PropertyColumn Sortable="true" Class="text-center" Property="@(x => x.ControlNo)" Title="Student No." Align="Align.Center">

                                        <ColumnOptions>
                                            <div class="search-box">
                                                <input type="search" @bind="nameFilter" @bind:event="oninput" placeholder="Student No...." />
                                            </div>
                                        </ColumnOptions>
                                    </PropertyColumn>
                                    <PropertyColumn Sortable="true" Property="@(x => x.StudentName)" Title="Student Name">

                                        <ColumnOptions>
                                            <div class="search-box">
                                                <input type="search" @bind="nameFilter" @bind:event="oninput" placeholder="Studentname...." />
                                            </div>
                                        </ColumnOptions>
                                    </PropertyColumn>
                                    <PropertyColumn Property="@(x => x.Gender)" Title="Gender" />
                                    <TemplateColumn Title="Class">
                                        @(string.IsNullOrWhiteSpace(context.ClassName) ? " " : context.ClassName)
                                    </TemplateColumn>
                                    <PropertyColumn Format="dd/MM/yyyy" Property="@(x => x.DateOfBirth)" Title=" DOB" Class="text-center" Align="Align.Center" />
                                    <TemplateColumn Title="Father">
                                        @(string.IsNullOrWhiteSpace(context.FatherName) ? " " : context.FatherName)
                                    </TemplateColumn>
                                    <TemplateColumn Title="Mother">
                                        @(string.IsNullOrWhiteSpace(context.MotherName) ? " " : context.MotherName)
                                    </TemplateColumn>
                                    <TemplateColumn Title="SMS Mob.No" Class="text-center" Align="Align.Center">
                                        @(string.IsNullOrWhiteSpace(context.SMSMobileNo) ? " " : context.SMSMobileNo)
                                    </TemplateColumn>
                                    <PropertyColumn Format="dd/MM/yyyy" Property="@(x => x.AdmissionDate)" Title="Adm.Date" Class="text-center" Align="Align.Center" />
                                    <TemplateColumn Title="Aadhaar No">
                                        @(string.IsNullOrWhiteSpace(context.AadhaarNo) ? " " : context.AadhaarNo)
                                    </TemplateColumn>
                                    <TemplateColumn Title="Category" Class="text-center" Align="Align.Center">
                                        @(string.IsNullOrWhiteSpace(context.StudentCategoryName) ? " " : context.StudentCategoryName)
                                    </TemplateColumn>

                                 
                                </QuickGrid>
                            </div>
                            <div class="footer-pagination">
                                <div class="d-flex align-items-center">
                                    <div class="welcome-text w-100">
                                        <Paginator State="@pagination" />
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-12 p-1">
                <div class="page-heading d-flex align-items-center justify-content-end">

                    <div class="d-flex align-items-center gap-2">
                        <div class="form-box">
                            <AdmitChildButton CurrentUrl="@currentUrl" ButtonText="Export" Export="ExportToExcel" />
                        </div>
                        <AdmitChildButton CurrentUrl="@currentUrl" ButtonText="Details" AdmitClicked="DetailsPopupOpen" />
                        @* <div class="form-box">
                            <button type="button" class="table-btn" @onclick="DetailsPopupOpen">Details</button>
                        </div> *@
                        <div class="form-box">
                            <button class="table-btn" @onclick="OpenStudentVisitorDetails">Visitor</button>
                        </div>
                        <div class="form-box">
                            <button class="table-btn" type="button" @onclick="OpenDocumentPopup">Document</button>
                        </div>
                        <div class="form-box">
                            <button class="table-btn" type="button" @onclick="OpenHandoverDocsPopup">Handover Docs</button>
                        </div>
                        <div class="form-box">
                            <button class="table-btn" type="button" @onclick="GenerateClassList">
                                Class List
                            </button>
                        </div>
                        @*   <div class="form-box">
                        <button type="button" class="table-btn" @onclick="DetailsPopupOpen">
                            Details
                        </button>
                    </div>
                        <div class="form-box">
                            <button class="table-btn">Visitor</button>
                        </div>
                        <div class="form-box">
                            <button class="table-btn">Print</button>
                        </div>
                        <div class="form-box">
                            <button class="table-btn">Withdrawal</button>
                        </div>
                        <div class="form-box">
                            <button class="table-btn">Admission Letter</button>
                        </div>
                        <div class="form-box">
                            <button class="table-btn">
                                Class List
                            </button>
                        </div>
                        <div class="form-box">
                            <button class="table-btn">
                                ByMeAboutMe SMS
                            </button>
                        </div> *@

                    </div>
                </div>
            </div>


        </div>
    </div>

    @if (ShowPopup)
    {
        <div class="custom-modal row m-0">
            <div class="col-12 col-sm-7 col-md-5 col-lg-4 col-xl-9">
                <div class="modal-content clearfix main-popup ">
                    <div class="head-btn">
                        <h5 class="modal-title">View Student</h5>
                        <button data-access="Close" type="button" @onclick="ClosePopup" class="close"><span aria-hidden="true">×</span></button>
                    </div>
                    <div class="modal-body">
                        <div class="row gap-10-0">

                            <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                                <div class="form-box-group static-label">
                                    <InputSelect class="floating-input" placeholder=" " autocomplete="off" @bind-Value="studentRequestModel.Gender" maxlength="10" required>
                                        <option value="" selected>-- Select Gender --</option>
                                        @foreach (var cs in genderModallist.Where(x => x.IsValid == true))
                                        {
                                            <option Value="@cs.GenderName">@cs.GenderName</option>
                                        }
                                    </InputSelect>
                                    <label class="floating-label">Gender</label>
                                </div>
                            </div>

                            <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                                <div class="form-box-group">
                                    <InputText class="floating-input" placeholder=" " @bind-Value="studentRequestModel.StudentName" />
                                    <label class="floating-label">First Name</label>
                                </div>
                            </div>

                            <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                                <div class="form-box-group">
                                    <InputText class="floating-input" placeholder=" " @bind-Value="studentRequestModel.ControlNo" />
                                    <label class="floating-label">Student No.</label>
                                </div>
                            </div>



                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="ui fade op-1 animated button form-btn" @onclick="GetSearchedStudent" tabindex="0">
                            <div class="visible content">Search</div>
                            <div class="hidden content">
                                <i class="bi bi-search"></i>
                            </div>
                        </button>
                    </div>

                </div>
            </div>
        </div>
    }

}


