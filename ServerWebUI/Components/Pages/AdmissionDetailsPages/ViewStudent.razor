                                    <InputText class="floating-input" placeholder=" " @bind-Value="studentRequest.StudentName" oninput="this.value=this.value.replace(/[^a-zA-Z]/g,'')" />
                                    <label class="floating-label">First Name</label>
                                </div>
                            </div>

                            <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                                <div class="form-box-group">
                                    <InputText class="floating-input" placeholder=" " @bind-Value="studentRequest.StudentNo" oninput="this.value=this.value.replace(/[^a-zA-Z0-9]/g,'')" />
