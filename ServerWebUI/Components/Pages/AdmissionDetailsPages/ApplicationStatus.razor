@page "/ApplicationStatus"
@using DomainModel.Admin
@using DomainModel.SchoolMaster
@using System.Net
@using System.Text.Json
@using Microsoft.AspNetCore.Mvc
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyApp.Common
@inject Shared.IHttpService httpService
@inject IJSRuntime JSs
@inject HttpClient Http
@inject IStringLocalizer<Resource> Localizer
@inject SweetAlertService Alert
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@inject IHttpClientFactory ClientFactory
@inject IJSRuntime JS
<style>
 
        .quickgrid thead th:nth-last-child(2) {
            width: 100px 
        }
        .quickgrid thead th:last-child {
            width: 75px;
        }

</style>
<div class="main-container">
    <div class="row m-0 main-row">
        <div class="col-12 p-1" id="main-header">
            <div class="page-heading d-flex align-items-center justify-content-between">
                <p class="m-0 page-name px-1">View Application Status</p>
                <div class="d-flex align-items-center gap-2">
                    <div class="form-box">
                        <InputSelect @bind-Value="sessionName" name="session" class="form-input">
                            <option value="0">-- Select Session --</option>
                            @foreach (var data in sessionlist.Where(x => x.IsValid == true))
                            {
                                <option>@data.SessionName </option>
                            }
                        </InputSelect>
                    </div>
                    <div class="form-box">
                        <InputSelect @bind-Value="branchCode" name="gender" id="gender" class="form-input">
                            <option value="0" selected>Select-Branch</option>
                            <option value="01">V3M International School</option>
                        </InputSelect>
                    </div>
                 
                    <div class="form-box">
                        <input type="text" @bind="registrationNo" placeholder="Reg.No" class="form-input">
                    </div>
                    <div class="form-box">
                        <button class="ui fade op-1 animated button form-btn" @onclick="SearchByRegistrationNo" tabindex="0">
                            <div class="visible content">Search</div>
                            <div class="hidden content">
                                <i class="bi bi-search"></i>
                            </div>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 p-1">
            <div class="card">
                <div class="card-body table-card p-0">
                    <div class="quick-main">
                        <div class="grid-box-with-btn">
                            <QuickGrid Items="@moduleQuery"@key="statusList" Class="table ">

                                <PropertyColumn Property="@(x => x.StatusName)" Title="STEP" />
                            <TemplateColumn Title="STATUS" Class="text-center" Align="Align.Center">
                                    @if (context.IsDone)
                                {
                                    <span class="text-success fs-4">✔</span>
                                }
                                else
                                {
                                    <span class="text-danger fs-4">✖</span>
                                }
                            </TemplateColumn>

                        </QuickGrid>

                        </div>
                       
                    </div>

                </div>
            </div>
        </div>

       
    </div>
</div>


@code {
    private string? registrationNo;
    private string? branchCode;
    private string? sessionName;
    private List<RegistrationStatusModel> statusList = new();
    private List<SessionModel> sessionlist = new();
    protected IQueryable<RegistrationStatusModel> moduleQuery => statusList.AsQueryable();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await  LoadData();
            StateHasChanged();
        }
    }
    private async Task LoadData()
    {
  
        string ApiUri = "Session/GetSession";
        sessionlist = await httpService.Get<List<SessionModel>>(ApiUri) ?? new();

        StateHasChanged();
    }
    private async Task SearchByRegistrationNo()
    {
        string url =
         $"ApplicationStatus/registration-status" +
         $"?groupCode=01" +
         $"&branchCode={branchCode}" +
         $"&sessionName={sessionName}" +
         $"&registrationNo={registrationNo}";

        var response = await httpService.Get<List<RegistrationStatusModel>>(url) ?? new();
        statusList = response ?? new();
        StateHasChanged(); 
       
    }
}
