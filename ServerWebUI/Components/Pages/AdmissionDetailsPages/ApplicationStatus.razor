@page "/ApplicationStatus"
@using DomainModel.Admin
@using DomainModel.SchoolMaster
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyApp.Common
@using Microsoft.AspNetCore.Authorization
@using ServerWebUI.Components.Pages.CommonPages
@inject Shared.IHttpService httpService
@inject IJSRuntime JS
@inject HttpClient Http
@inject IStringLocalizer<Resource> Localizer
@inject SweetAlertService Alert
@inject ICommonMethod _commonmethod
@rendermode InteractiveServer

<div class="main-container">
    <div class="row m-0 main-row">
        <div class="col-12 p-1" id="main-header">
            <PageHeading>
                <div class="form-box">
                    <InputSelect @bind-Value="@CurrentSession" class="form-input">
                        <option value="0">-- Select Session --</option>
                        @foreach (var data in sessionlist.Where(x => x.IsValid))
                        {
                            <option value="@data.SessionId">
                                @data.SessionName
                            </option>
                        }
                    </InputSelect>
                </div>
                <div class="form-box">
                    <InputSelect @bind-Value="schoolbranchcode" class="form-input" autocomplete="off" disabled>
                        <option value="" selected>--Select--</option>
                        @foreach (var cs in branchlist)
                        {
                            <option Value="@cs.BranchCode">@cs.BranchName</option>
                        }
                    </InputSelect>
                </div>
                <div class="form-box">
                    <InputText class="form-input" placeholder="Enter Reg.No " @bind-Value="searchRequest.RegistrationNo" @bind-Value:after="TrimRegistrationNo" />
                </div>
                <div class="form-box">
                    <button class="ui fade op-1 animated button form-btn" tabindex="0" @onclick="SearchApplicationStatus">
                        <div class="visible content">Search</div>
                        <div class="hidden content">
                            <i class="bi bi-search"></i>
                        </div>
                    </button>
                </div>
            </PageHeading>
        </div>

        <div class="col-12 p-1">
            @if (statuslist.Count > 0)
            {
                <div class="app-status-card">
                    <div class="app-status-head">
                        <div>
                            <div class="app-status-label">Registration No.</div>
                            <div class="app-status-regno">@searchedRegistrationNo</div>
                        </div>
                        @* progress ring: completed steps / all steps *@
                        <div class="app-status-ring" style="--pct:@ProgressPercent">
                            <span>@ProgressPercent%</span>
                        </div>
                    </div>

                    <ul class="app-status-steps">
                        @foreach (var step in statuslist)
                        {
                            var state = GetStepState(step);
                            <li class="app-status-step @state">
                                <span class="app-status-icon">
                                    <i class="bi @(state == "pending" ? "bi-hourglass-split" : "bi-check-lg")"></i>
                                </span>
                                <div class="app-status-text">
                                    <div class="app-status-name">@(string.IsNullOrWhiteSpace(step.StatusName) ? "—" : step.StatusName)</div>
                                    <div class="app-status-date">@(string.IsNullOrWhiteSpace(step.StatusDate) ? "—" : step.StatusDate)</div>
                                </div>
                                <span class="app-status-badge">@GetStepLabel(state)</span>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .app-status-card {
        max-width: 100%;
        background: #fff;
        border: 1px solid #e9edf3;
        border-radius: 14px;
        padding: 22px 26px 18px;
        box-shadow: 0 2px 10px rgba(16, 24, 40, .04);
        height: 600px
    }

    .app-status-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
    }

    .app-status-label {
        font-size: 13px;
        color: #6b7280;
    }

    .app-status-regno {
        font-size: 22px;
        font-weight: 700;
        color: #111827;
        letter-spacing: .3px;
    }

    .app-status-ring {
        --pct: 0;
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: conic-gradient(#20a090 calc(var(--pct) * 1%), #e5e7eb 0);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .app-status-ring span {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 700;
            color: #111827;
        }

    .app-status-steps {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .app-status-step {
        position: relative;
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 9px 0;
    }

        /* vertical line between the icons */
        .app-status-step:not(:last-child)::after {
            content: "";
            position: absolute;
            left: 19px;
            top: 48px;
            bottom: -10px;
            width: 2px;
            background: #e5e7eb;
        }

    .app-status-icon {
        flex: 0 0 40px;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 15px;
        box-shadow: 0 0 0 4px var(--ring);
        background: var(--fill);
        z-index: 1;
    }

    .app-status-text {
        flex: 1;
        min-width: 0;
    }

    .app-status-name {
        font-size: 15px;
        font-weight: 600;
        color: #111827;
    }

    .app-status-date {
        font-size: 13px;
        color: #6b7280;
    }

    .app-status-badge {
        font-size: 12px;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 8px;
        color: var(--badge-text);
        background: var(--badge-bg);
    }

    .app-status-step.done {
        --fill: #1f6fb5;
        --ring: #dbe8f6;
        --badge-text: #1f6fb5;
        --badge-bg: #e8f1fb;
    }

    .app-status-step.success {
        --fill: #22a447;
        --ring: #d9f3e1;
        --badge-text: #16803a;
        --badge-bg: #e8f8ee;
    }

    .app-status-step.pending {
        --fill: #f29d12;
        --ring: #fdeccf;
        --badge-text: #c2570c;
        --badge-bg: #fff4e5;
    }
</style>
@if (IsLoading)
{
    <div class="grid-loader-overlay">
        <div class="loader-card">
            <div class="loader-ring">
                <div class="loader-arc"></div>
                <div class="loader-core">
                    <img src="/images/v3m-favicon-m.png" alt="Loading" class="loader-logo" />
                </div>
            </div>
            <p class="loader-text">Loading<span class="dot d1">.</span><span class="dot d2">.</span><span class="dot d3">.</span></p>
        </div>
    </div>
}
else
{

}

@code {

    private long CurrentSession;
    private string schoolbranchcode = string.Empty;
    private List<SessionModel> sessionlist = new();
    private SearchAnyRequestModel searchAnyRequest = new();
    private List<BranchModel> branchlist = new();
    private List<RegistrationStatusResponse> statuslist = new();
    private bool IsLoading = false;
    private RegistrationRequest searchRequest = new();

    // registration no. shown on the status card (the one that was searched)
    private string searchedRegistrationNo = "";

    private string? branchcode;
    private string? groupcode;
    private string currentUrl = "";
    private string username = "";

    // step state: registration step = done (blue), finished step = success (green), else pending (orange)
    private static string GetStepState(RegistrationStatusResponse step)
    {
        if (step.ApplicationStatus == 0)
            return "done";
        return step.IsDone == 1 ? "success" : "pending";
    }

    private static string GetStepLabel(string state) => state switch
    {
        "done" => "Done",
        "success" => "Success",
        _ => "Pending"
    };

    private int ProgressPercent => statuslist.Count == 0
        ? 0
        : (int)Math.Round(100.0 * statuslist.Count(x => GetStepState(x) != "pending") / statuslist.Count);

    protected override void OnInitialized()
    {
        PermissionState.OnChange += StateHasChanged;
        currentUrl = Nav.Uri;
    }
    private void TrimRegistrationNo()
    {
        searchRequest.RegistrationNo = searchRequest.RegistrationNo?.Trim();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CurrentSession = await _commonmethod.SetCurrentSessionData();

            var userResult = await sessionStorage.GetAsync<string>("UserName");
            username = userResult.Value ?? string.Empty;

            var branchResult = await sessionStorage.GetAsync<string>("BranchCode");
            branchcode = branchResult.Value;

            var groupResult = await sessionStorage.GetAsync<string>("GroupCode");
            groupcode = groupResult.Value;

            schoolbranchcode = branchcode ?? string.Empty;

            await LoadData();
            StateHasChanged();
        }
    }

    private async Task LoadData()
    {
        sessionlist = await httpService.Get<List<SessionModel>>("Session/GetSession") ?? new();
        //branchlist = await httpService.Get<List<BranchNameMst>>("ClassSection/GetBranchName") ?? new();
        searchAnyRequest.GroupCode = groupcode;
        await GetBranchName();
        StateHasChanged();
    }
    private async Task GetBranchName()
    {
        if (!string.IsNullOrEmpty(searchAnyRequest.GroupCode))
        {
            string ApiUri = "Branch/GetBranch";
            branchlist = await httpService.Post<List<BranchModel>>(ApiUri, searchAnyRequest) ?? new();
            StateHasChanged();
        }
        else
        {
            branchlist.Clear();
            StateHasChanged();
        }
    }
    private async Task SearchApplicationStatus()
    {
        searchRequest.GroupCode = groupcode;
        searchRequest.BranchCode = schoolbranchcode;
        searchRequest.SessionId = CurrentSession;

        IsLoading = true;
        StateHasChanged();

        try
        {
            if (string.IsNullOrEmpty(searchRequest.RegistrationNo))
            {
                statuslist.Clear();
                await Alert.ShowWarning("Registration no. can not be blank.");
                StateHasChanged();
                return;
            }
            var apiResponse = await httpService.Post<ApiResponse<List<RegistrationStatusResponse>>>(
                "Registration/GetRegistrationStatus", searchRequest);

            statuslist = (apiResponse != null && apiResponse.Success)
                ? (apiResponse.Data ?? new())
                : new();
            searchedRegistrationNo = searchRequest.RegistrationNo ?? "";

            if (apiResponse != null && !apiResponse.Success)
            {
                await Alert.ShowWarning(apiResponse.Message ?? "No registration documents found.");
            }
        }
        catch
        {
            statuslist = new();
            await Alert.ShowWarning("An error occurred while fetching registration status.");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }
}