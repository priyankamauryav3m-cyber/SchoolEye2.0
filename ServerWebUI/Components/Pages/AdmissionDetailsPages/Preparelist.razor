@page "/PreparePublishList"
@using DomainModel.Admin
@using DomainModel.FinanceMNGT
@using Microsoft.AspNetCore.Authorization
@inject IHttpClientFactory ClientFactory
@using DomainModel.SchoolMaster
@using Microsoft.AspNetCore.Components.QuickGrid
@using System.Net
@using System.Text.Json
@inject IStringLocalizer<Resource> Localizer
@using MyApp.Common
@using ServerWebUI.Components.Pages.AdmissionDetailsPages
@using ServerWebUI.Components.Pages.CommonPages
@inject IJSRuntime JS
@inject Shared.IHttpService httpService
@inject HttpClient Http
@inject SweetAlertService Alert
@rendermode InteractiveServer
<style>
    .quickgrid thead th:nth-last-child(2) {
        min-width: 75px;
    }</style>
    <div class="main-container">
        <div class="row m-0 main-row">
            <div class="col-12 p-1" id="main-header">
                <div class="page-heading no-btn-top d-flex align-items-center justify-content-between">
                    <p class="m-0 page-name px-1">Prepare/Publish List</p>
                    <div class="d-flex align-items-center gap-2">
                        <div class="form-box">
                            <InputSelect @bind-Value="@CurrentSession" class="form-input">
                                <option value="0">-- Select Session --</option>
                                @foreach (var data in sessionlist.Where(x => x.IsValid == true))
                                {
                                    <option value="@data.SessionId">@data.SessionName </option>
                                }
                            </InputSelect>
                        </div>

                        <div class="form-box">
                            <InputSelect class="form-input" placeholder=" " @bind-Value="searchRequest.ApplicationStatus" @bind-Value:after='()=>OnSearchPrepareList("ApplicationStatus")'>
