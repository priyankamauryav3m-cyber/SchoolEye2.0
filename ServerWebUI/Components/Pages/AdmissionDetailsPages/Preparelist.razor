    {
        ShowSearchPopup = true;
    }
    private async Task GetListData()
    {
        searchAnyRequest.GroupCode = groupcode;
        searchAnyRequest.BranchCode = branchcode;
        searchAnyRequest.SessionId = CurrentSession;
        string ApiUri = "PrepareList/GetPublishList";
        var apiResponse = await httpService.Post<ApiResponse<List<PublishListModel>>>(ApiUri, searchAnyRequest) ?? new();
        if (apiResponse.Success)
        {
            publishList = apiResponse.Data ?? new();
