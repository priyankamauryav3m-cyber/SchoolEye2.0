    private async Task MoveSelectedToRight()
    {
        var selected = leftList.Where(x => x.IsSelected).ToList();
        if (selected.Count==0)
        {
            await JS.InvokeVoidAsync("showSelectRecordAlert");
            StateHasChanged();
            return;
        }
        if (rightListFilter == 0)
        {
            await Alert.ShowWarning("Please select a publish list.");

            return;
        }
        IsLoading = true;

        try
        {
            studentInListRequest.GroupCode = groupcode;
            studentInListRequest.BranchCode = branchcode;
            studentInListRequest.SessionId = CurrentSession;
            studentInListRequest.CreatedBy = username;
            studentInListRequest.PublishListNo = rightListFilter;
            studentInListRequest.RegistrationId = string.Join(",", selected.Select(x => x.RegistrationId));
            string ApiUri = "PrepareList/AddStudentInList";

            var apiresponse = await httpService.Post<ApiResponse<object>>(ApiUri, studentInListRequest);

            if (apiresponse?.Success == true && apiresponse.Code == 1)
            {
                await OnSearchPrepareList("");
                await OnSearch();
            }
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }

    }

