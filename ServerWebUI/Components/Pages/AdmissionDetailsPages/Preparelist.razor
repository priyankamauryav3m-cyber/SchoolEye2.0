    // OnValidSubmit="OnSearch"). Nothing else (radio change, dropdown change,
    // typing) calls this automatically.
    private async Task OnSearch()
    {
        IsLoading = true;
        searchRequest.GroupCode = groupcode;
        searchRequest.BranchCode = branchcode;
        searchRequest.ClassCode = SelectedClassCodes;

        string ApiUri = "PrepareList/GetRegistrationInfoList";
        var result = await httpService.Post<ApiResponse<List<RegistrationInfoListResponse>>>(ApiUri, searchRequest) ?? new();
        if (result.Success == true)
        {
            leftList = result.Data.ToList();

        }
        IsLoading = false;
        ShowSearchPopup = false;
        StateHasChanged();
    }
