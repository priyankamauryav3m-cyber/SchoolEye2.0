                            </div>
                        </div>
                        <div class="col-6 col-sm-3 px-1">
                            <div class="form-box">
                                <InputSelect class="form-input" placeholder=" " @bind-Value="rightListFilter"  @bind-Value:after='() => OnSearchPrepareList("ListName")'>
                                    <option value="0">-Select-</option>
                                    @foreach (var cs in publishList.Where(x => x.IsActive == true))
