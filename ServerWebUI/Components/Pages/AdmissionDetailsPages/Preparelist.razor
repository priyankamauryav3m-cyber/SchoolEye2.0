                                        </div>

                                        <div class="radio-item">
                                            <InputRadio id="published" Value="@("Published")" />
                                            <label for="published">Published</label>
                                        </div>

                                        <div class="radio-item">
                                            <InputRadio id="prepared" Value="@("Prepared")" />
