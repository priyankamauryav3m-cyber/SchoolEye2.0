                                    </TemplateColumn>
                                    <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.RegistrationNo) ? " " : x.RegistrationNo)" class="text-center" Title="Reg. No." Sortable="true" Align="Align.Left">
                                        <ColumnOptions>
                                            <div class="search-box">
                                                <input type="search" autofocus @bind="regNoFilter" @bind:event="oninput" placeholder="Reg. No..." />
                                            </div>
                                        </ColumnOptions>
                                    </PropertyColumn>
                                    <TemplateColumn Title="Student Name" Sortable="true" SortBy="@(GridSort<RegistrationInfoListResponse>.ByAscending(x => x.StudentName))" Align="Align.Left">
                                        <ColumnOptions>
                                            <div class="search-box">
                                                <input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="Student Name..." />
                                            </div>
                                        </ColumnOptions>
                                        <ChildContent>
                                            @(string.IsNullOrWhiteSpace(context.StudentName) ? " " : context.StudentName)
                                        </ChildContent>
                                    </TemplateColumn>
                                    <PropertyColumn Format="dd-MM-yyyy" Property="@(x => x.AppliedDate)" Title="App. Date" class="text-center" Sortable="true" Align="Align.Center" />
                                    <PropertyColumn Property="@(x => x.Points)" Title="Points" Sortable="true" class="text-center" Align="Align.Center" />
                                </QuickGrid>
                            </div>
                            <div class="footer-pagination">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="welcome-text w-100">
                                        <Paginator State="@pagination1" />
                                    </div>
