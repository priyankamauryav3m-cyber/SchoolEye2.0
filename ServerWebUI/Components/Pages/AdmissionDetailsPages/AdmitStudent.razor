    private async Task SearchByStudent(string value)
    {
        IsLoading = true;
        request.GroupCode = groupcode;
        request.BranchCode = branchcode;
        request.SessionId = CurrentSession;
        request.ClassCode = SelectedClassCodes;
        request.SectionId = SelectedSectionIds;
        if (request.SectionId == "")
        {
            IsLoading = false;
            await Alert.ShowWarning("Please select a section.");
            StateHasChanged();
            return;
        }
        request.ClassCode = string.IsNullOrWhiteSpace(request.ClassCode) ? null : request.ClassCode;
        request.Gender = string.IsNullOrWhiteSpace(request.Gender) || request.Gender == "0" ? null : request.Gender;
        request.StudentName = string.IsNullOrWhiteSpace(request.StudentName) ? null : request.StudentName.Trim();
        request.StudentNo = string.IsNullOrWhiteSpace(request.StudentNo) ? null : request.StudentNo.Trim();
        request.ValidStatus = string.IsNullOrWhiteSpace(request.ValidStatus) ? null : request.ValidStatus;
        if (request.AdmFromDate.HasValue && request.AdmToDate.HasValue && request.AdmFromDate.Value.Date > request.AdmToDate.Value.Date)
        {
            IsLoading = false;
            await Alert.ShowWarning("Adm. Date From can not be after Adm. Date To.");
            StateHasChanged();
            return;
        }
        if (value == "Admission")
        {
            request.AdmFromDate = null;
            request.AdmToDate = null;
        }
        else if (value == "Today")
        {
            var today = DateTime.Today;
            request.AdmFromDate = today;
            request.AdmToDate = today;
        }

        else if (value == "ThisWeek")
        {
            var today = DateTime.Today;
            int diff = (7 + (today.DayOfWeek - DayOfWeek.Monday)) % 7;
            request.AdmFromDate = today.AddDays(-diff);
            request.AdmToDate = today;
        }
        else if (value == "ThisMonth")
        {
            var today = DateTime.Today;
            request.AdmFromDate = new DateTime(today.Year, today.Month, 1);
            request.AdmToDate = today;
        }
        else if (value == "ThisYear")
        {
            var today = DateTime.Today;
            request.AdmFromDate = new DateTime(today.Year, 1, 1);
            request.AdmToDate = today;
        }
        ShowPopup = false;
        StateHasChanged();
        try
        {
            string apiUrl = "registration/StudentList";
            var apiResponse = await httpService.Post<ApiResponse<List<StudentListResponse>>>(apiUrl, request);
            if (apiResponse.Success)
            {
                listResponses = apiResponse.Data ?? new List<StudentListResponse>();
            }
            else
            {
                listResponses = new List<StudentListResponse>();
            }
        }
        catch
        {
            listResponses = new List<StudentListResponse>();
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }
