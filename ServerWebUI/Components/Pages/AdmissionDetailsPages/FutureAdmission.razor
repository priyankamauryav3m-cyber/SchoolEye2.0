    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CurrentSession = await _commonmethod.SetCurrentSessionData();
            sessionlist = await httpService.Get<List<SessionModel>>("Session/GetSession") ?? new();

            await GetData();
            StateHasChanged();
        }
    }

    private async Task GetData()
    {
        var branchResult = await sessionStorage.GetAsync<string>("BranchCode");
        branchcode = branchResult.Value;
        var groupResult = await sessionStorage.GetAsync<string>("GroupCode");
        groupcode = groupResult.Value;
        var userResult = await sessionStorage.GetAsync<string>("UserName");
        username = userResult.Value;

        string ApiUri = "occupation/AllOccupation";
        string ApiUri2 = "Concession/GetListConcession";
        concessionlist = await httpService.Get<List<ConcessionModel>>(ApiUri2) ?? new();
        getoccupationlist = await httpService.Get<List<OccupationModal>>(ApiUri) ?? new();
        classlist = await httpService.Get<List<BranchClassModel>>("BranchClass/GetClassCode") ?? new();
        categories = await httpService.Get<List<CategoryModal>>("ClassSection/GetCategory") ?? new();
        distancelist = await httpService.Get<List<MstDistance>>("ClassSection/GetDistance") ?? new();
        branchlist = await httpService.Get<List<BranchNameMst>>("ClassSection/GetBranchName") ?? new();
        qulifationlist = await httpService.Get<List<Qualification>>("Qualification/GetQualification") ?? new();
        genderlist = await httpService.Get<List<GenderModal>>("gender/GetGender") ?? new();
        countrylist = await httpService.Get<List<CountryModel>>("Country/GetCountry") ?? new();
        religionlist = await httpService.Get<List<ReligionMaster>>("Religion/AllReligion") ?? new();
    }

    private async Task OnSave()
    {
        registration.GroupCode = groupcode ?? string.Empty;
        registration.BranchCode = branchcode ?? string.Empty;
        registration.SessionName = sessionlist.FirstOrDefault(x => x.SessionId == CurrentSession)?.SessionName ?? string.Empty;
        registration.CreatedBy = username;

        try
        {
            string apiUrl = "FutureAdmission/AddOrUpdateFutureAdmission";
            var apiResponse = await httpService.Post<ApiResponse<object>>(apiUrl, registration);
            if (apiResponse != null && apiResponse.Success)
            {
                await Alert.ShowSuccess("Future admission saved successfully.");
                registration = new();
                dobValue = null;
                admissionDateValue = null;
                datecalulate = null;
            }
            else
            {
                await Alert.ShowWarning(apiResponse?.Message ?? "Future admission was not saved.");
            }
        }
        catch (Exception ex)
        {
            await Alert.ShowError($"{@Localizer["Error"]}: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task OnClassChanged()
    {
        registration.SectionId = "0";
        await GetSectionData();
    }

    private async Task GetSectionData()
    {
        try
        {
            searchAny.GroupCode = groupcode;
            searchAny.BranchCode = branchcode;
            searchAny.RequestName = registration.ClassCode;

            string ApiUri1 = "ClassSection/GetClassWithSection";
            var apiResponse = await httpService.Post<ApiResponse<List<ClassSectionModal>>>(ApiUri1, searchAny) ?? new();
            if (apiResponse.Success)
            {
                classsectionslist = apiResponse.Data ?? new();
            }
            StateHasChanged();
        }
        catch (Exception)
        {
            return;
        }
    }

    private void OnDOBChanged()
    {
        if (!dobValue.HasValue)
        {
            datecalulate = "";
            registration.DateOfBirth = string.Empty;
            StateHasChanged();
            return;
        }

        if (dobValue.Value.Date <= DateTime.Today)
        {
            registration.DateOfBirth = dobValue.Value.ToString("dd-MM-yyyy");
            datecalulate = _commonmethod.CalculateAge(dobValue.Value);
            StateHasChanged();
        }
        else
        {
            // Please choose the correct Date of Birth.
            dobValue = null;
            registration.DateOfBirth = string.Empty;
            datecalulate = null;
            StateHasChanged();
        }
    }

    private void OnAdmissionDateChanged()
    {
        registration.AdmissionDate = admissionDateValue.HasValue ? admissionDateValue.Value.ToString("dd-MM-yyyy") : "0";
    }
}
