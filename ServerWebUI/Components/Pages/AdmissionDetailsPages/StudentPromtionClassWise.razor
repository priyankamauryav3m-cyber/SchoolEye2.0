@page "/studentpromotin"
@using DomainModel.Admin
@using DomainModel.FinanceMNGT;
@using DomainModel.SchoolMaster
@using Microsoft.AspNetCore.Authorization
@using Newtonsoft.Json
@using ServerWebUI.Components.Common
@using ServerWebUI.Components.Pages.CommonPages
@inject IHttpClientFactory ClientFactory
@using Microsoft.AspNetCore.Components.QuickGrid
@using System.Net
@using System.Text.Json
@inject IStringLocalizer<Resource> Localizer
@using MyApp.Common
@inject IJSRuntime JS
@inject Shared.IHttpService httpService
@inject HttpClient Http
@inject SweetAlertService Alert
@rendermode InteractiveServer
@inject PermissionState PermissionState
@inject NavigationManager Nav
<style>
    .quickgrid thead th:nth-last-child(2) {
        min-width: 75px;
    }

    .form-box-group {
        margin-bottom: 0px;
    }
</style>
<div class="main-container">
    <div class="row m-0 main-row">
        <div class="col-12 p-1" id="main-header">
            <div class="page-heading no-btn-top d-flex align-items-center justify-content-between">
                <p class="m-0 page-name px-1">Student Promotion</p>
            </div>
        </div>

        <div class="col-6 p-1">
            <div class="card">
                <div class="row m-0 px-1 mt-2">
                    <div class="col-6 col-sm-3 px-1">
                        <div class="form-box-group static-label">
                            <InputSelect class="floating-input" placeholder=" " @bind-Value="CurrentSession" name="session">
                                <option value="" selected>--Select--</option>
                                @foreach (var data in sessionlist.Where(x => x.IsValid == true))
                                {
                                    <option value="@data.SessionId">@data.SessionName </option>
                                }
                            </InputSelect>
                            <label class="floating-label">Session</label>
                        </div>
                    </div>
                    <div class="col-6 col-sm-4 px-1">
                        <div class="form-box-group static-label">
                            <InputSelect class="floating-input" placeholder=" " @bind-Value="selectedClass" @bind-Value:after='() => GetSectionData("current")'>
                                <option value="" selected>--Select--</option>
                                @foreach (var cs in classlist.Where(x => x.IsValid == true))
                                {
                                    <option Value="@cs.ClassCode">@cs.ClassName </option>
                                }
                            </InputSelect>
                            <label class="floating-label">Class</label>
                        </div>
                    </div>
                    <div class="col-6 col-sm-4 px-1">
                        <div class="form-box-group static-label">
                            <InputSelect class="floating-input" placeholder=" " @bind-Value="selectedSection">

                                @if (string.IsNullOrEmpty(selectedClass))
                                {
                                    <option value="0">Select</option>
                                }
                                else
                                {
                                    <option value="0" selected>All</option>
                                    @foreach (var cs in sectionModellist)
                                    {
                                        <option Value="@cs.SectionId">@cs.SectionName </option>
                                    }
                                }
                            </InputSelect>
                            <label class="floating-label">Section</label>
                        </div>
                    </div>
                    <div class="col-6 col-sm-1 px-1">

                        <div class="form-box align-items-center">
                            <div class="d-flex gap-2">
                                <button class="icon-btn" @onclick="SearchCurrentStudentData">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <hr class="mb-0 mt-2" />
                <div class="card-body table-card p-0">
                    <div class="quick-main">
                        <div class="grid-box-with-btn" style="height: calc(100vh - 323px);">
                            <QuickGrid Items="@studentmoduleQuery" Class="table" Pagination="@pagination">
                                <TemplateColumn Class="text-center" Title="" Align="Align.Left">
                                    <ChildContent>
                                        <div>
                                            <input type="checkbox" @bind="context.IsSelected" @onclick:stopPropagation="true" />
                                        </div>
                                    </ChildContent>
                                </TemplateColumn>

                                <PropertyColumn Property="@(x => x.ControlNo)" Title="Student No" Class="text-center" Sortable="true" Align="Align.Center">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="StudentNo ..." />
                                        </div>
                                    </ColumnOptions>
                                </PropertyColumn>

                                <TemplateColumn Title="Student Name" Sortable="true" SortBy="@(GridSort<ClassWiseStudentForPromotion>.ByAscending(x => x.StudentName))" Align="Align.Left">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="StudentName..." />
                                        </div>
                                    </ColumnOptions>
                                    <ChildContent>
                                        @(string.IsNullOrWhiteSpace(context.StudentName) ? " " : context.StudentName)
                                    </ChildContent>
                                </TemplateColumn>
                                <PropertyColumn Property="@(x => x.SectionName)" Class="text-center" Sortable="true" Title="Section" Align="Align.Left">

                                </PropertyColumn>
                                <PropertyColumn Property="@(x => x.Gender)" Title="Gender" Align="Align.Center">

                                </PropertyColumn>


                            </QuickGrid>

                        </div>
                        <div class="footer-pagination">
                            <div class="d-flex align-items-center">
                                <div class="welcome-text w-100">
                                    <Paginator State="@pagination" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 p-1">
            <div class="card">
                <div class="row m-0 px-1 mt-2">
                    <div class="col-6 col-sm-3 px-1">
                        <div class="form-box-group static-label">
                            <InputSelect class="floating-input" placeholder=" " @bind-Value="promoteClass.SessionId" name="session">
                                <option value="" selected>--Select--</option>
                                @foreach (var data in sessionlist.Where(x => x.IsValid == true))
                                {
                                    <option value="@data.SessionId">@data.SessionName </option>
                                }
                            </InputSelect>
                            <label class="floating-label">Session</label>
                        </div>
                    </div>
                    <div class="col-6 col-sm-4 px-1">
                        <div class="form-box-group static-label">
                            <InputSelect class="floating-input" placeholder=" " @bind-Value="promoteClass.ClassCode" @bind-Value:after='() => GetSectionData("promoted")'>
                                <option value="" selected>--Select--</option>
                                @foreach (var cs in classlist.Where(x => x.IsValid == true))
                                {
                                    <option Value="@cs.ClassCode">@cs.ClassName </option>
                                }
                            </InputSelect>
                            <label class="floating-label">Class</label>
                        </div>
                    </div>
                    <div class="col-6 col-sm-4 px-1">
                        <div class="form-box-group static-label">
                            <InputSelect class="floating-input" placeholder=" " @bind-Value="promoteClass.SectionId">

                                @if (string.IsNullOrEmpty(promoteClass.ClassCode))
                                {
                                    <option value="0">Select</option>
                                }
                                else
                                {
                                    <option value="0" selected>All</option>
                                    @foreach (var cs in sectionModellist1)
                                    {
                                        <option Value="@cs.SectionId">@cs.SectionName </option>
                                    }
                                }
                            </InputSelect>
                            <label class="floating-label">Section</label>
                        </div>
                    </div>
                    <div class="col-6 col-sm-1 px-1">

                        <div class="form-box align-items-center">
                            <div class="d-flex gap-2">
                                <button class="icon-btn" @onclick="SearchStudentpromotedData">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <hr class="mb-0 mt-2" />
                <div class="card-body table-card p-0">
                    <div class="quick-main">
                        <div class="grid-box-with-btn" style="height: calc(100vh - 323px);">
                            <QuickGrid Items="@studentpromotedmoduleQuery" Class="table" Pagination="@pagination1">

                                <PropertyColumn Property="@(x => x.ControlNo)" Title="Student No" Class="text-center" Sortable="true" Align="Align.Center">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="StudentNo ..." />
                                        </div>
                                    </ColumnOptions>
                                </PropertyColumn>

                                <TemplateColumn Title="Student Name" Sortable="true" SortBy="@(GridSort<ClassWiseStudentForPromotion>.ByAscending(x => x.StudentName))" Align="Align.Left">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="StudentName..." />
                                        </div>
                                    </ColumnOptions>
                                    <ChildContent>
                                        @(string.IsNullOrWhiteSpace(context.StudentName) ? " " : context.StudentName)
                                    </ChildContent>
                                </TemplateColumn>
                                <PropertyColumn Property="@(x => x.SectionName)" Sortable="true" Class="text-center" Title="Section" Align="Align.Left">

                                </PropertyColumn>
                                <PropertyColumn Property="@(x => x.Gender)" Title="Gender" Align="Align.Center">

                                </PropertyColumn>


                            </QuickGrid>

                        </div>
                        <div class="footer-pagination">
                            <div class="d-flex align-items-center">
                                <div class="welcome-text w-100">
                                    <Paginator State="@pagination1" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 p-1">
            <div class="page-heading d-flex align-items-center justify-content-end">

                <div class="col-6 p-1">
                    <div class="form-box-group">
                        <InputText class="floating-input" placeholder=" " @bind-Value="@promoteClass.PromoteComment" type="text" />
                        <label class="floating-label">Remarks</label>
                    </div>
                </div>
                <div class="col-6 p-1">
                    <div class="d-flex align-items-center justify-content-end gap-2">
                        <div class="form-box-group ">
                            <button type="button" class="table-btn" @onclick="OnSavePromoteStudentClass">Promote/Demote</button>
                        </div>
                        <div class="form-box-group ">
                            <AdmitChildButton CurrentUrl="@currentUrl" ButtonText="Not Promotion List List" Print="OnPrintClick" />
                        </div>
                    </div>

                </div>

             



            </div>
        </div>
    </div>

</div>


@if (IsLoading)
{
    <div class="grid-loader-overlay">
        <img src="images/loading.gif" alt="Loading..." />
    </div>
}
else
{

}
<CustomAlert @ref="customAlert" Title="Alert" />
@code {

    private CustomAlert customAlert;
    private string olddesignation = "";
    private List<ClassWiseStudentForPromotion> studentpromotedlist = new();
    private List<StudentNotPromotedModel> studentNotpromotedlist = new();
    private List<ClassWiseStudentForPromotion> studentlist = new();
    private List<SessionModel> sessionlist = new();
    private string nameFilter = string.Empty;
    PaginationState pagination = new PaginationState() { ItemsPerPage = 15 };
    PaginationState pagination1 = new PaginationState() { ItemsPerPage = 15 };
    private bool IsLoading = true;
    private bool ShowPopup;
    private string branchcode;
    private string groupcode;
    private string UserName;
    private string? currentUrl;
    private long CurrentSession;
    private long NextCurrentSession;
    private string? selectedClass;
    private int selectedSection;
    private PromoteClassModel promoteClass = new();
    private List<MissingStudentModel> MissingStudents = new();
    private SearchAnyRequestModel searchAny = new();
    private List<BranchClassModel> classlist = new();
    private List<SectionModel> sectionModellist = new();
    private List<SectionModel> sectionModellist1 = new();
    protected override void OnInitialized()
    {

        PermissionState.OnChange += StateHasChanged;
        currentUrl = Nav.Uri;
        StateHasChanged();

    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CurrentSession = await CommonMethod.SetCurrentSessionData();
            await LoadData();
            StateHasChanged();

        }
    }

    private async Task LoadData()
    {
        var branchResult = await sessionStorage.GetAsync<string>("BranchCode");
        branchcode = branchResult.Value;
        var groupResult = await sessionStorage.GetAsync<string>("GroupCode");
        var username = await sessionStorage.GetAsync<string>("UserName");
        UserName = username.Value;
        groupcode = groupResult.Value;
        IsLoading = true;
        string ApiUri = "FeeHead/GetFeeHeadList";
        classlist = await httpService.Get<List<BranchClassModel>>("BranchClass/GetClassCode") ?? new();
        sessionlist = await httpService.Get<List<SessionModel>>("Session/GetSession") ?? new();
        IsLoading = false;
    }

    private void ClosePopup()
    {
        ShowPopup = false;
        StateHasChanged();
    }
    private async Task GetSectionData(string val)
    {
        try
        {
            // string code = "";
            // if (val == "")
            // {
            //     code = promoteClass.ClassCode;
            // }
            // else
            // {
            //     code = selectedClass;
            // }
            searchAny.GroupCode = groupcode;
            searchAny.BranchCode = branchcode;
            if (val == "promoted")
            {
                searchAny.RequestName = promoteClass.ClassCode;
                searchAny.RequestId = promoteClass.SectionId;
                string ApiUri1 = "ClassSection/GetClassWithSection";
                var apiResponse = await httpService.Post<ApiResponse<List<SectionModel>>>(ApiUri1, searchAny) ?? new();
                if (apiResponse.Success)
                {
                    sectionModellist1 = apiResponse.Data ?? new();
                }
            }
            else
            {
                searchAny.RequestName = selectedClass;
                searchAny.RequestId = selectedSection;
                string ApiUri1 = "ClassSection/GetClassWithSection";
                var apiResponse = await httpService.Post<ApiResponse<List<SectionModel>>>(ApiUri1, searchAny) ?? new();
                if (apiResponse.Success)
                {
                    sectionModellist = apiResponse.Data ?? new();
                }
            }
            searchAny = new();

            StateHasChanged();
        }
        catch (Exception)
        {

            return;
        }
    }
    protected IQueryable<ClassWiseStudentForPromotion> studentmoduleQuery
    {
        get
        {
            var result = studentlist.AsQueryable();
            if (!string.IsNullOrEmpty(nameFilter))
            {
                result = result.Where(x => (x.StudentName != null && x.StudentName.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)) ||
            (x.ControlNo != null && x.ControlNo.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)));

            }
            return result;
        }
    }
    protected IQueryable<ClassWiseStudentForPromotion> studentpromotedmoduleQuery
    {
        get
        {
            var result = studentpromotedlist.AsQueryable();
            if (!string.IsNullOrEmpty(nameFilter))
            {
                result = result.Where(x => (x.StudentName != null && x.StudentName.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)) ||
            (x.ControlNo != null && x.ControlNo.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)));

            }
            return result;
        }
    }
    private async Task OnSavePromoteStudentClass()
    {
        try
        {

            if (promoteClass.SessionId == 0)
            {
                await Alert.ShowWarning("Please select a session.");
                return;

            }
            else if (string.IsNullOrEmpty(promoteClass.ClassCode))
            {
                await Alert.ShowWarning("Please select a class.");
                return;
            }
            else if (string.IsNullOrEmpty(promoteClass.PromoteComment))
            {
                await Alert.ShowWarning("Please enter remarks.");
                return;
            }
            else if (promoteClass.SectionId == 0)
            {
                await Alert.ShowWarning("Please select a section.");
                return;
            }
            var selectedStudents = studentmoduleQuery.Where(x => x.IsSelected).ToList();
            if (selectedStudents.Count == 0)
            {
                await JS.InvokeVoidAsync("showSelectRecordAlert");
                return;
            }

            List<PromoteClassModel> promoteList = new();

            foreach (var student in selectedStudents)
            {
                promoteList.Add(new PromoteClassModel
                {
                    GroupCode = groupcode,
                    BranchCode = branchcode,
                    SessionId = promoteClass.SessionId,
                    StudentId = student.StudentId,
                    ClassCode = promoteClass.ClassCode,
                    SectionId = promoteClass.SectionId,
                    PromoteComment = promoteClass.PromoteComment,
                    PromoteType = "1",
                    CreatedBy = UserName
                });
            }
            IsLoading = true;
            string ApiUri1 = "StudentPromotion/PromoteStudentClass";
            var apiResponse = await httpService.Post<ApiResponse<object>>(ApiUri1, promoteList) ?? new();
            if (apiResponse.Success)
            {
                if (apiResponse.Code == 1)
                {
                    await Alert.ShowSuccess("Student Promoted Successfully !");
                    IsLoading = false;
                    promoteClass = new();
                }
                else
                {
                    await Alert.ShowCustomAlert(@Localizer["Admin"]);
                }
                StateHasChanged();
            }
            else
            {
                await Alert.ShowCustomAlert(@Localizer["Admin"]);
            }

            StateHasChanged();
        }
        catch (Exception)
        {

            return;
        }
    }
    private async Task SearchCurrentStudentData()
    {
        try
        {
            searchAny.RequestName = selectedClass;
            if (string.IsNullOrEmpty(searchAny.RequestName))
            {
                await Alert.ShowWarning("Please select a class.");
                return;
            }
            IsLoading = true;
            searchAny.GroupCode = groupcode;
            searchAny.BranchCode = branchcode;
            searchAny.SessionId = CurrentSession;

            string ApiUri1 = "StudentPromotion/GetStudentPromotion";
            var apiResponse = await httpService.Post<ApiResponse<List<ClassWiseStudentForPromotion>>>(ApiUri1, searchAny) ?? new();
            if (apiResponse.Success)
            {
                studentlist = apiResponse.Data ?? new();
            }
            IsLoading = false;
            StateHasChanged();
        }
        catch (Exception)
        {

            return;
        }
    }
    private async Task SearchStudentpromotedData()
    {
        try
        {
            if (promoteClass.SessionId == 0)
            {
                await Alert.ShowWarning("Please select a  session.");
                return;
            }
            if (string.IsNullOrEmpty(promoteClass.ClassCode))
            {
                await Alert.ShowWarning("Please select a class.");
                return;
            }

            IsLoading = true;
            searchAny.GroupCode = groupcode;
            searchAny.BranchCode = branchcode;
            searchAny.RequestName = promoteClass.ClassCode;
            searchAny.SessionId = promoteClass.SessionId;
            searchAny.RequestId = promoteClass.SectionId;
            string ApiUri1 = "StudentPromotion/GetStudentPromotion";
            var apiResponse = await httpService.Post<ApiResponse<List<ClassWiseStudentForPromotion>>>(ApiUri1, searchAny) ?? new();
            if (apiResponse.Success)
            {
                studentpromotedlist = apiResponse.Data ?? new();
            }
            IsLoading = false;
            StateHasChanged();
        }
        catch (Exception)
        {

            return;
        }
    }

    private async Task OnPrintClick()
    {
        try
        {
            if (CurrentSession == 0)
            {
                await Alert.ShowWarning("Please select a  session.");
                return;
            }
            IsLoading = true;
            searchAny.GroupCode = groupcode;
            searchAny.BranchCode = branchcode;
            searchAny.SessionId = CurrentSession;
            string ApiUri1 = "StudentPromotion/GetStudentNotPromoted";
            var apiResponse = await httpService.Post<ApiResponse<List<StudentNotPromotedModel>>>(ApiUri1, searchAny) ?? new();
            if (apiResponse.Success)
            {
                studentNotpromotedlist = apiResponse.Data ?? new();
                IsLoading = false;
                StateHasChanged();
            }

            var result = await JS.InvokeAsync<JsonElement>("showPrintConfirm");
            bool isPdf = result.GetProperty("isConfirmed").GetBoolean();
            bool isExcel = result.GetProperty("isDenied").GetBoolean();
            if (isPdf)
            {
                await PrintPdfList();
                StateHasChanged();
            }
            else if (isExcel)
            {

                await PrintExcel();
                StateHasChanged();
            }
            StateHasChanged();
        }
        catch (Exception)
        {

            return;
        }

       
    }
    private async Task PrintPdfList()
    {
        try
        {


            var response = await httpService.Post<ApiResponse<object>>("Export/GenerateNotPrommotedStudentPdf", studentNotpromotedlist);
            if (response != null && response.Success)
            {
                var base64 = response.Data;
                //await JS.InvokeVoidAsync("downloadPdf", base64, "StudentNotPromotedList.pdf");
                await JS.InvokeVoidAsync("viewPdf", base64);
                StateHasChanged();
            }
            else
            {
                await Alert.ShowCustomAlert(@Localizer["Admin"]);
            }
        }
        catch (Exception ex)
        {

            await Alert.ShowError($"{@Localizer["Error"]}: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
        }

    }
    private async Task PrintExcel()
    {
        try
        {
            var response = await httpService.Post<ApiResponse<object>>("Export/PrintStudentNotPromotedExcelData", studentNotpromotedlist);
            if (response != null && response.Success)
            {
                var base64 = response.Data;
                await JS.InvokeVoidAsync("downloadExcel", base64, "StudentNotPromoted.xlsx");
                //await JS.InvokeVoidAsync("openExcelDirect", base64);
                StateHasChanged();
            }
            else
            {
                await Alert.ShowCustomAlert(@Localizer["Admin"]);
            }
        }
        catch (Exception ex)
        {

            await Alert.ShowError($"{@Localizer["Error"]}: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
        }

    }

}





