@page "/OptionalFeeGroup"
@using DomainModel.FinanceMNGT
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyApp.Common
@using Microsoft.AspNetCore.Authorization
@using ServerWebUI.Components.Pages.CommonPages
@inject Shared.IHttpService httpService
@inject IJSRuntime JS
@inject SweetAlertService Alert
@inject ICommonMethod _commonmethod
@rendermode InteractiveServer

<div class="main-container">
    <div class="row m-0 main-row">
        <div class="col-12 p-1" id="main-header">
            <PageHeading Tittle="Optional Fee Group">
                <ActionButtonGroup CurrentUrl="@currentUrl" Add="OpenNewPopup" ButtonText="Add Group" />
            </PageHeading>
        </div>

        <div class="col-12 p-1">
            <div class="card">
                <div class="card-body table-card p-0">
                    <div class="quick-main">
                        <div class="grid-box">
                            <QuickGrid Items="@moduleQuery" Class="table" Pagination="@pagination">
                                <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.OptionalGroupName) ? " " : x.OptionalGroupName)" Title="Group Name" Sortable="true" Align="Align.Left">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="Search..." />
                                        </div>
                                    </ColumnOptions>
                                </PropertyColumn>
                                <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.OptionalGroupCode) ? " " : x.OptionalGroupCode)" Title="Group Code" Class="text-center" Align="Align.Center" />
                                <PropertyColumn Property="@(x => x.MaxFeeHeadCount)" Title="Max Fee Heads" Class="text-center" Align="Align.Center" />
                                <PropertyColumn Property="@(x => x.OpenTillDate.HasValue ? x.OpenTillDate.Value.ToString("dd-MM-yyyy") : " ")" Title="Open Till" Class="text-center" Align="Align.Center" />
                                <TemplateColumn Title="Status" Class="text-center" Align="Align.Center">
                                    <ChildContent>
                                        @if (context.IsValid)
                                        {
                                            <i class="bi bi-check-circle-fill" style="color:#28a745; font-size:18px;"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-x-circle-fill" style="color:#dc3545; font-size:18px;"></i>
                                        }
                                    </ChildContent>
                                </TemplateColumn>
                                <TemplateColumn Title="Mapping" Class="text-center" Align="Align.Center">
                                    <ChildContent>
                                        <button class="btn-icon edit-btn custom-tooltip" data-tooltip="Map Classes & Fee Heads" @onclick="() => OpenMappingPopup(context)">
                                            <i class="bi bi-diagram-3"></i>
                                        </button>
                                    </ChildContent>
                                </TemplateColumn>
                                <TemplateColumn Title="Action" Align="Align.Center">
                                    <ChildContent>
                                        <ActionButtonGroup  CurrentUrl="@currentUrl" IsValid="@context.IsValid"
                                                            OnEditClick="() => EditGroup(context)"
                                                            OnStatusClick="() => ToggleStatus(context)" />
                                    </ChildContent>
                                </TemplateColumn>
                            </QuickGrid>
                        </div>
                        <div class="footer-pagination">
                            <div class="d-flex align-items-center">
                                <div class="welcome-text w-100">
                                    <Paginator State="@pagination" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (ShowPopup)
{
    <div class="custom-modal row m-0">
        <div class="col-12 col-sm-7 col-md-5 col-lg-4 col-xl-8">
            <div class="modal-content clearfix main-popup">
                <div class="head-btn">
                    <h5 class="modal-title">@(model.OptionalGroupId == 0 ? "Add" : "Edit") Optional Fee Group</h5>
                    <button data-access="Close" type="button" @onclick="ClosePopup" class="close"><span aria-hidden="true">×</span></button>
                </div>
                <EditForm Model="@model" OnValidSubmit="@OnSave">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="row m-0 form-row">
                            <div class="col-lg-4 col-12 mb-2">
                                <div class="form-box-group">
                                    <InputText class="floating-input" placeholder=" " @bind-Value="model.OptionalGroupName" />
                                    <label class="floating-label">Group Name <span class="required">*</span></label>
                                    <ValidationMessage For="@(() => model.OptionalGroupName)" />
                                </div>
                            </div>
                            <div class="col-lg-4 col-12 mb-2">
                                <div class="form-box-group">
                                    <InputText class="floating-input" placeholder=" " @bind-Value="model.OptionalGroupCode" />
                                    <label class="floating-label">Group Code <span class="required">*</span></label>
                                    <ValidationMessage For="@(() => model.OptionalGroupCode)" />
                                </div>
                            </div>
                            <div class="col-lg-4 col-12 mb-2">
                                <div class="form-box-group">
                                    <InputNumber class="floating-input" placeholder=" " @bind-Value="model.MaxFeeHeadCount" />
                                    <label class="floating-label">Max Fee Head Count <span class="required">*</span></label>
                                    <ValidationMessage For="@(() => model.MaxFeeHeadCount)" />
                                </div>
                            </div>
                            <div class="col-lg-4 col-12 mb-2">
                                <div class="form-box-group">
                                    <InputDate class="floating-input" placeholder=" " @bind-Value="model.OpenTillDate" />
                                    <label class="floating-label">Open Till Date</label>
                                </div>
                            </div>
                            <div class="col-lg-8 col-12 mb-2">
                                <div class="form-box-group">
                                    <InputText class="floating-input" placeholder=" " @bind-Value="model.Remarks" />
                                    <label class="floating-label">Remarks</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <div class="form-group btn-gr">
                            <SaveUpdateButton Id="model.OptionalGroupId" TextSave="Save" OnClickCancel="ClosePopup" />
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (ShowMappingPopup)
{
    <div class="custom-modal row m-0">
        <div class="col-12 col-sm-7 col-md-5 col-lg-4 col-xl-9">
            <div class="modal-content clearfix main-popup">
                <div class="head-btn">
                    <h5 class="modal-title">Map Classes & Fee Heads — @selectedGroup?.OptionalGroupName</h5>
                    <button data-access="Close" type="button" @onclick="CloseMappingPopup" class="close"><span aria-hidden="true">×</span></button>
                </div>
                <div class="modal-body">
                    <div class="row m-0 form-row">
                        <div class="col-12 col-lg-12 px-2 mb-3">
                            <div class="divider-box d-flex justify-content-between align-items-center gap-2">
                                <p class="total-text-with-bg">Map Class</p>
                                <hr class="m-0 w-webkit text-light-gray op-1">
                            </div>
                        </div>
                        <div class="col-lg-8 col-12 mb-2">
                            <div class="form-box-group static-label">
                                <InputSelect class="floating-input" placeholder=" " @bind-Value="classMapModel.ClassCode">
                                    <option value="">--Select Class--</option>
                                    @foreach (var item in classlist)
                                    {
                                        <option value="@item.ClassCode">@item.ClassName</option>
                                    }
                                </InputSelect>
                                <label class="floating-label">Class</label>
                            </div>
                        </div>
                        <div class="col-lg-4 col-12 mb-2 d-flex align-items-center">
                            <button type="button" class="table-btn" @onclick="AddClassMap">Map Class</button>
                        </div>

                        <div class="col-12 col-lg-12 px-2 mb-3 mt-2">
                            <div class="divider-box d-flex justify-content-between align-items-center gap-2">
                                <p class="total-text-with-bg">Map Fee Head & Amount</p>
                                <hr class="m-0 w-webkit text-light-gray op-1">
                            </div>
                        </div>
                        <div class="col-lg-5 col-12 mb-2">
                            <div class="form-box-group static-label">
                                <InputSelect class="floating-input" placeholder=" " @bind-Value="headMapModel.FeeHeadId">
                                    <option value="0">--Select Fee Head--</option>
                                    @foreach (var item in feeHeadList)
                                    {
                                        <option value="@item.FeeHeadId">@item.FeeHeadName</option>
                                    }
                                </InputSelect>
                                <label class="floating-label">Fee Head</label>
                            </div>
                        </div>
                        <div class="col-lg-3 col-12 mb-2">
                            <div class="form-box-group">
                                <input class="floating-input" placeholder=" " type="number" step="0.01" @bind="headMapModel.Amount" />
                                <label class="floating-label">Amount</label>
                            </div>
                        </div>
                        <div class="col-lg-4 col-12 mb-2 d-flex align-items-center">
                            <button type="button" class="table-btn" @onclick="AddHeadMap">Map Fee Head</button>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <SaveUpdateButton ShowSaveButton="false" OnClickCancel="@CloseMappingPopup" />
                </div>
            </div>
        </div>
    </div>
}

@if (IsLoading)
{
    <div class="grid-loader-overlay">
        <img src="images/loading.gif" alt="Loading..." />
    </div>
}

@code {
    // ---------------------------------------------------------------------
    // ASSUMPTIONS:
    // - BranchClassModel has ClassCode/ClassName (per frontend-agent.md §14).
    // - FeeHeadModel exposes FeeHeadId/FeeHeadName — endpoint "FeeHead/ListFeeHead"
    //   assumed from the existing FeeHeadController naming pattern; adjust if different.
    // ---------------------------------------------------------------------

    private List<OptionalFeeGroupModel> list = new();
    private List<BranchClassModel> classlist = new();
    private List<FeeHeadModel> feeHeadList = new();

    private OptionalFeeGroupModel model = new();
    private OptionalFeeGroupClassMapModel classMapModel = new();
    private OptionalFeeGroupHeadModel headMapModel = new();
    private OptionalFeeGroupModel? selectedGroup;

    private bool ShowPopup;
    private bool ShowMappingPopup;
    private bool IsLoading;
    private string? nameFilter;
    private PaginationState pagination = new() { ItemsPerPage = 15 };

    private long CurrentSession;
    private string? branchcode;
    private string? groupcode;
    private string currentUrl = "";

    protected override void OnInitialized()
    {
        currentUrl = Nav.Uri;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CurrentSession = await _commonmethod.SetCurrentSessionData();
            branchcode = (await sessionStorage.GetAsync<string>("BranchCode")).Value;
            groupcode = (await sessionStorage.GetAsync<string>("GroupCode")).Value;

            await LoadData();
            StateHasChanged();
        }
    }

    protected IQueryable<OptionalFeeGroupModel> moduleQuery
    {
        get
        {
            var result = list.AsQueryable();
            if (!string.IsNullOrEmpty(nameFilter))
            {
                result = result.Where(x => (x.OptionalGroupName != null && x.OptionalGroupName.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)) ||
                                            (x.OptionalGroupCode != null && x.OptionalGroupCode.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)));
            }
            return result;
        }
    }

    private async Task LoadData()
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            var req = new SearchAnyRequestModel { GroupCode = groupcode, BranchCode = branchcode, SessionId = CurrentSession };
            var apiResponse = await httpService.Post<ApiResponse<List<OptionalFeeGroupModel>>>("OptionalFeeGroup/ListOptionalFeeGroup", req);
            list = (apiResponse != null && apiResponse.Success) ? (apiResponse.Data ?? new()) : new();

            classlist = await httpService.Get<List<BranchClassModel>>("BranchClass/GetClassCode") ?? new();
            feeHeadList = await httpService.Get<List<FeeHeadModel>>("FeeHead/ListFeeHead") ?? new();
        }
        catch
        {
            list = new();
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void OpenNewPopup()
    {
        model = new OptionalFeeGroupModel { GroupCode = groupcode, BranchCode = branchcode, SessionId = CurrentSession };
        ShowPopup = true;
    }

    private void EditGroup(OptionalFeeGroupModel row)
    {
        model = new OptionalFeeGroupModel
        {
            OptionalGroupId = row.OptionalGroupId,
            GroupCode = groupcode,
            BranchCode = branchcode,
            SessionId = CurrentSession,
            OptionalGroupName = row.OptionalGroupName,
            OptionalGroupCode = row.OptionalGroupCode,
            MaxFeeHeadCount = row.MaxFeeHeadCount,
            OpenTillDate = row.OpenTillDate,
            Remarks = row.Remarks,
            IsValid = row.IsValid
        };
        ShowPopup = true;
    }

    private void ClosePopup() => ShowPopup = false;

    private async Task OnSave()
    {
        model.CreatedBy = (await sessionStorage.GetAsync<string>("UserName")).Value ?? string.Empty;
        model.IsValid = true;
        ShowPopup = false;
        IsLoading = true;
        StateHasChanged();
        try
        {
            var apiResponse = await httpService.Post<ApiResponse<object>>("OptionalFeeGroup/AddUpdateOptionalFeeGroup", model);
            if (apiResponse != null && apiResponse.Success && apiResponse.Code != 0)
            {
                ShowPopup = false;
                await Alert.ShowSuccess(apiResponse.Code == 1 ? "Optional Fee Group created successfully." : "Optional Fee Group updated successfully.");
                await LoadData();
            }
            else
            {
                await Alert.ShowWarning(apiResponse?.Message ?? "Optional Fee Group code already exists.");
            }
        }
        catch (Exception ex)
        {
            await Alert.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task ToggleStatus(OptionalFeeGroupModel row)
    {
        ShowPopup = false;
        var confirm = await Alert.ShowConfirm("Are you sure, you want to change the status of the selected record?");
        if (!confirm)
        {
            ShowPopup = true;
            StateHasChanged();
            return;
        }

        IsLoading = true;
        StateHasChanged();
        try
        {
            var apiResponse = await httpService.Post<ApiResponse<string>>("OptionalFeeGroup/ToggleOptionalFeeGroup", row);
            if (apiResponse != null && apiResponse.Success)
            {
                await Alert.ShowSuccess("Status updated successfully.");
                await LoadData();
            }
            else
            {
                await Alert.ShowWarning(apiResponse?.Message ?? "Operation failed.");
            }
        }
        catch (Exception ex)
        {
            await Alert.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void OpenMappingPopup(OptionalFeeGroupModel row)
    {
        selectedGroup = row;
        classMapModel = new OptionalFeeGroupClassMapModel { OptionalGroupId = row.OptionalGroupId };
        headMapModel = new OptionalFeeGroupHeadModel { OptionalGroupId = row.OptionalGroupId };
        ShowMappingPopup = true;
    }

    private void CloseMappingPopup() => ShowMappingPopup = false;

    private async Task AddClassMap()
    {
        ShowMappingPopup = false;
        if (string.IsNullOrEmpty(classMapModel.ClassCode))
        {
            await Alert.ShowWarning("Please select a Class.");
            ShowMappingPopup = true;
            StateHasChanged();
            return;
        }

        classMapModel.CreatedBy = (await sessionStorage.GetAsync<string>("UserName")).Value ?? string.Empty;
        try
        {
            await httpService.Post<ApiResponse<string>>("OptionalFeeGroup/MapClass", classMapModel);
            await Alert.ShowSuccess("Class mapped successfully.");
            classMapModel.ClassCode = string.Empty;
        }
        catch (Exception ex)
        {
            await Alert.ShowError($"Error: {ex.Message}");
        }
    }

    private async Task AddHeadMap()
    {
        ShowMappingPopup = false;
        if (headMapModel.FeeHeadId <= 0)
        {
            await Alert.ShowWarning("Please select a Fee Head.");
            ShowMappingPopup = true;
            StateHasChanged();
            return;
        }

        headMapModel.CreatedBy = (await sessionStorage.GetAsync<string>("UserName")).Value ?? string.Empty;
        try
        {
            await httpService.Post<ApiResponse<string>>("OptionalFeeGroup/MapFeeHead", headMapModel);
            await Alert.ShowSuccess("Fee Head mapped successfully.");
            headMapModel = new OptionalFeeGroupHeadModel { OptionalGroupId = selectedGroup!.OptionalGroupId };
        }
        catch (Exception ex)
        {
            await Alert.ShowError($"Error: {ex.Message}");
        }
    }
}
