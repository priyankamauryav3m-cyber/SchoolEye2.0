@page "/MiscellaneousReceipt"
@using DomainModel.FinanceMNGT
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyApp.Common
@using ServerWebUI.Components.Pages.CommonPages
@inject Shared.IHttpService httpService
@inject SweetAlertService Alert
@inject ICommonMethod _commonmethod
@rendermode InteractiveServer

<div class="main-container">
    <div class="row m-0 main-row">
        <div class="col-12 p-1" id="main-header">
            <PageHeading Tittle="Miscellaneous Receipt">
                <ActionButtonGroup CurrentUrl="@currentUrl" Add="OpenNewPopup" ButtonText="New Receipt" />
            </PageHeading>
        </div>

        <div class="col-12 p-1">
            <div class="card">
                <div class="card-body table-card p-0">
                    <div class="quick-main">
                        <div class="grid-box">
                            <QuickGrid Items="@moduleQuery" Class="table" Pagination="@pagination">
                                <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.ReceiptNo) ? " " : x.ReceiptNo)" Title="Receipt No" Sortable="true" Align="Align.Left">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="Search receipt no..." />
                                        </div>
                                    </ColumnOptions>
                                </PropertyColumn>
                                <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.StudentName) ? " " : x.StudentName)" Title="Student" Align="Align.Left" />
                                <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.FeeHeadName) ? " " : x.FeeHeadName)" Title="Fee Head" Align="Align.Left" />
                                <PropertyColumn Property="@(x => x.Amount.ToString("N2"))" Title="Amount" Align="Align.Right" />
                                <PropertyColumn Property="@(x => x.ReceiptDate.ToString("dd-MM-yyyy"))" Title="Receipt Date" Align="Align.Center" />
                                <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.PaymentModeName) ? " " : x.PaymentModeName)" Title="Payment Mode" Align="Align.Left" />
                            </QuickGrid>
                        </div>
                        <div class="footer-pagination">
                            <div class="d-flex align-items-center">
                                <div class="welcome-text w-100">
                                    <Paginator State="@pagination" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (ShowPopup)
{
    <div class="custom-modal row m-0">
        <div class="col-12 col-sm-7 col-md-5 col-lg-4 col-xl-8">
            <div class="modal-content clearfix main-popup">
                <div class="head-btn">
                    <h5 class="modal-title">Record Miscellaneous Receipt</h5>
                    <button data-access="Close" type="button" @onclick="ClosePopup" class="close"><span aria-hidden="true">×</span></button>
                </div>
                <EditForm Model="@model" OnValidSubmit="@OnSave">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="row m-0 form-row">
                            <div class="col-lg-6 col-12 mb-2">
                                <div class="form-box-group static-label">
                                    <InputSelect class="floating-input" placeholder=" " @bind-Value="classCode" @bind-Value:after="OnClassChanged">
                                        <option value="">--Select Class--</option>
                                        @foreach (var item in classlist)
                                        {
                                            <option value="@item.ClassCode">@item.ClassName</option>
                                        }
                                    </InputSelect>
                                    <label class="floating-label">Class</label>
                                </div>
                            </div>
                            <div class="col-lg-6 col-12 mb-2">
                                <div class="form-box-group static-label">
                                    <InputSelect class="floating-input" placeholder=" " @bind-Value="model.StudentIdRef" @bind-Value:after="OnStudentChanged">
                                        <option value="0">--Select Student--</option>
                                        @foreach (var item in studentlist)
                                        {
                                            <option value="@item.StudentId">@item.StudentName</option>
                                        }
                                    </InputSelect>
                                    <label class="floating-label">Student <span class="required">*</span></label>
                                    <ValidationMessage For="@(() => model.StudentIdRef)" />
                                </div>
                            </div>
                            <div class="col-lg-12 col-12 mb-2">
                                <div class="form-box-group static-label">
                                    <InputSelect class="floating-input" placeholder=" " @bind-Value="model.MiscChallanId" @bind-Value:after="OnChallanChanged">
                                        <option value="">-- Direct Receipt (no pending challan) --</option>
                                        @foreach (var item in pendingChallans)
                                        {
                                            <option value="@item.MiscChallanId">@item.FeeHeadName - @item.Amount.ToString("N2") (@item.ForMonth)</option>
                                        }
                                    </InputSelect>
                                    <label class="floating-label">Against Pending Challan</label>
                                </div>
                            </div>
                            <div class="col-lg-4 col-12 mb-2">
                                <div class="form-box-group static-label">
                                    <InputSelect class="floating-input" placeholder=" " @bind-Value="model.FeeHeadId">
                                        <option value="0">--Select Fee Head--</option>
                                        @foreach (var item in feeHeadList)
                                        {
                                            <option value="@item.FeeHeadId">@item.FeeHeadName</option>
                                        }
                                    </InputSelect>
                                    <label class="floating-label">Fee Head <span class="required">*</span></label>
                                    <ValidationMessage For="@(() => model.FeeHeadId)" />
                                </div>
                            </div>
                            <div class="col-lg-4 col-12 mb-2">
                                <div class="form-box-group">
                                    <InputText class="floating-input" placeholder=" " @bind-Value="model.ReceiptNo" />
                                    <label class="floating-label">Receipt No <span class="required">*</span></label>
                                    <ValidationMessage For="@(() => model.ReceiptNo)" />
                                </div>
                            </div>
                            <div class="col-lg-4 col-12 mb-2">
                                <div class="form-box-group">
                                    <InputNumber class="floating-input" placeholder=" " @bind-Value="model.Amount" />
                                    <label class="floating-label">Amount <span class="required">*</span></label>
                                    <ValidationMessage For="@(() => model.Amount)" />
                                </div>
                            </div>
                            <div class="col-lg-4 col-12 mb-2">
                                <div class="form-box-group static-label">
                                    <InputSelect class="floating-input" placeholder=" " @bind-Value="model.PaymentModeId">
                                        <option value="0">--Select Mode--</option>
                                        @foreach (var item in paymentModeList)
                                        {
                                            <option value="@item.PMId">@item.ModeName</option>
                                        }
                                    </InputSelect>
                                    <label class="floating-label">Payment Mode <span class="required">*</span></label>
                                    <ValidationMessage For="@(() => model.PaymentModeId)" />
                                </div>
                            </div>
                            <div class="col-lg-4 col-12 mb-2">
                                <div class="form-box-group">
                                    <InputDate class="floating-input" placeholder=" " @bind-Value="model.ReceiptDate" />
                                    <label class="floating-label">Receipt Date</label>
                                </div>
                            </div>
                            <div class="col-lg-8 col-12 mb-2">
                                <div class="form-box-group">
                                    <InputText class="floating-input" placeholder=" " @bind-Value="model.Remarks" />
                                    <label class="floating-label">Remarks</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <div class="form-group btn-gr">
                            <SaveUpdateButton Id="0" TextSave="Record Receipt" OnClickCancel="ClosePopup" />
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (IsLoading)
{
    <div class="grid-loader-overlay">
        <img src="images/loading.gif" alt="Loading..." />
    </div>
}

@code {
    // ASSUMPTIONS: PaymentModeModel exposes PaymentModeId/PaymentModeName from the
    // existing "PaymentMode/ListPaymentMode" endpoint (per PaymentModeController).

    private List<MiscellaneousReceiptModel> list = new();
    private List<BranchClassModel> classlist = new();
    private List<StudentClassModal> studentlist = new();
    private List<FeeHeadModel> feeHeadList = new();
    private List<PaymentModel> paymentModeList = new();
    private List<MiscellaneousChallanModel> pendingChallans = new();

    private MiscellaneousReceiptModel model = new();
    private string? classCode;

    private bool ShowPopup;
    private bool IsLoading;
    private string? nameFilter;
    private PaginationState pagination = new() { ItemsPerPage = 15 };

    private long CurrentSession;
    private string? branchcode;
    private string? groupcode;
    private string username = string.Empty;
    private string currentUrl = "";

    protected override void OnInitialized() => currentUrl = Nav.Uri;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CurrentSession = await _commonmethod.SetCurrentSessionData();
            branchcode = (await sessionStorage.GetAsync<string>("BranchCode")).Value;
            groupcode = (await sessionStorage.GetAsync<string>("GroupCode")).Value;
            username = (await sessionStorage.GetAsync<string>("UserName")).Value ?? string.Empty;

            classlist = await httpService.Get<List<BranchClassModel>>("BranchClass/GetClassCode") ?? new();
            feeHeadList = await httpService.Get<List<FeeHeadModel>>("FeeHead/GetFeeHeadList") ?? new();
            paymentModeList = await httpService.Get<List<PaymentModel>>("PaymentMode/GetBankPaymentMode") ?? new();
            await LoadData();
            StateHasChanged();
        }
    }

    protected IQueryable<MiscellaneousReceiptModel> moduleQuery
    {
        get
        {
            var result = list.AsQueryable();
            if (!string.IsNullOrEmpty(nameFilter))
            {
                result = result.Where(x => x.ReceiptNo != null && x.ReceiptNo.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase));
            }
            return result;
        }
    }

    private async Task LoadData()
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            var req = new SearchAnyRequestModel { GroupCode = groupcode, BranchCode = branchcode, SessionId = CurrentSession };
            var apiResponse = await httpService.Post<ApiResponse<List<MiscellaneousReceiptModel>>>("MiscellaneousChallan/ListMiscReceipt", req);
            list = (apiResponse != null && apiResponse.Success) ? (apiResponse.Data ?? new()) : new();
        }
        catch { list = new(); }
        finally { IsLoading = false; StateHasChanged(); }
    }

    private void OpenNewPopup()
    {
        model = new MiscellaneousReceiptModel { GroupCode = groupcode, BranchCode = branchcode, SessionId = CurrentSession, ReceiptDate = DateTime.Today };
        classCode = null;
        studentlist = new();
        pendingChallans = new();
        ShowPopup = true;
    }

    private void ClosePopup() => ShowPopup = false;

    private async Task OnClassChanged()
    {
        studentlist = new();
        model.StudentIdRef = 0;
        pendingChallans = new();
        if (string.IsNullOrEmpty(classCode)) { StateHasChanged(); return; }

        var searchAny = new SearchAnyRequestModel { GroupCode = groupcode, BranchCode = branchcode, RequestName = classCode, SessionId = CurrentSession };
        studentlist = await httpService.Post<List<StudentClassModal>>("Student/GetStudentByClass", searchAny) ?? new();
        StateHasChanged();
    }

    private async Task OnStudentChanged()
    {
        pendingChallans = new();
        model.MiscChallanId = null;
        if (model.StudentIdRef <= 0) { StateHasChanged(); return; }

        var req = new SearchAnyRequestModel { GroupCode = groupcode, BranchCode = branchcode, SessionId = CurrentSession, StudentId = model.StudentIdRef };
        var apiResponse = await httpService.Post<ApiResponse<List<MiscellaneousChallanModel>>>("MiscellaneousChallan/ListMiscChallan", req);
        var challans = (apiResponse != null && apiResponse.Success) ? (apiResponse.Data ?? new()) : new();
        pendingChallans = challans.Where(x => x.Status == "Pending").ToList();
        StateHasChanged();
    }

    private void OnChallanChanged()
    {
        var challan = pendingChallans.FirstOrDefault(x => x.MiscChallanId == model.MiscChallanId);
        if (challan != null)
        {
            model.FeeHeadId = challan.FeeHeadId;
            model.Amount = challan.Amount;
        }
    }

    private async Task OnSave()
    {
        model.CreatedBy = username;
        IsLoading = true;
        StateHasChanged();
        try
        {
            var apiResponse = await httpService.Post<ApiResponse<object>>("MiscellaneousChallan/AddMiscReceipt", model);
            if (apiResponse != null && apiResponse.Success && apiResponse.Code == 1)
            {
                ShowPopup = false;
                await Alert.ShowSuccess("Miscellaneous Receipt recorded successfully.");
                await LoadData();
            }
            else
            {
                await Alert.ShowWarning(apiResponse?.Message ?? "Receipt No already exists.");
            }
        }
        catch (Exception ex)
        {
            await Alert.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }
}
