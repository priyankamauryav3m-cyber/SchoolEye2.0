@page "/AdjustmentReceipt"
@using DomainModel.FinanceMNGT
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyApp.Common
@using ServerWebUI.Components.Pages.CommonPages
@inject Shared.IHttpService httpService
@inject SweetAlertService Alert
@inject ICommonMethod _commonmethod
@rendermode InteractiveServer

<div class="main-container">
    <div class="row m-0 main-row">
        <div class="col-12 p-1" id="main-header">
            <PageHeading Tittle="Adjustment Receipts">
                <ActionButtonGroup CurrentUrl="@currentUrl" Add="OpenNewPopup" ButtonText="New Adjustment" />
            </PageHeading>
        </div>

        <div class="col-12 p-1">
            <div class="card">
                <div class="card-body table-card p-0">
                    <div class="quick-main">
                        <div class="grid-box">
                            <QuickGrid Items="@moduleQuery" Class="table" Pagination="@pagination">
                                <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.StudentName) ? " " : x.StudentName)" Title="Student" Sortable="true" Align="Align.Left">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="Search..." />
                                        </div>
                                    </ColumnOptions>
                                </PropertyColumn>
                                <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.FeeHeadName) ? " " : x.FeeHeadName)" Title="Fee Head" Align="Align.Left" />
                                <TemplateColumn Title="Type" Align="Align.Center">
                                    <ChildContent>
                                        @if (context.AdjustmentType == "Add")
                                        {
                                            <i class="bi bi-plus-circle-fill" style="color:#28a745;"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-dash-circle-fill" style="color:#dc3545;"></i>
                                        }
                                        @context.AdjustmentType
                                    </ChildContent>
                                </TemplateColumn>
                                <PropertyColumn Property="@(x => x.Amount.ToString("N2"))" Title="Amount" Align="Align.Right" />
                                <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.Reason) ? " " : x.Reason)" Title="Reason" Align="Align.Left" />
                                <PropertyColumn Property="@(x => x.AdjustmentDate.ToString("dd-MM-yyyy"))" Title="Date" Align="Align.Center" />
                                <TemplateColumn Title="Status" Align="Align.Center">
                                    <ChildContent>
                                        @if (context.Status == "Approved")
                                        {
                                            <span class="badge bg-success">Approved</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                    </ChildContent>
                                </TemplateColumn>
                                <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.ApprovedBy) ? " " : x.ApprovedBy)" Title="Approved By" Align="Align.Left" />
                                <TemplateColumn Title="Action" Align="Align.Center">
                                    <ChildContent>
                                        @if (context.Status != "Approved")
                                        {
                                            @if (string.Equals(context.CreatedBy, username, StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="text-muted" title="You created this adjustment — a different user must approve it.">Awaiting another approver</span>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-success" @onclick="() => ApproveReceipt(context)">Approve</button>
                                            }
                                        }
                                    </ChildContent>
                                </TemplateColumn>
                            </QuickGrid>
                        </div>
                        <div class="footer-pagination">
                            <div class="d-flex align-items-center">
                                <div class="welcome-text w-100">
                                    <Paginator State="@pagination" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (ShowPopup)
{
    <div class="custom-modal row m-0">
        <div class="col-12 col-sm-7 col-md-5 col-lg-4 col-xl-8">
            <div class="modal-content clearfix main-popup">
                <div class="head-btn">
                    <h5 class="modal-title">New Adjustment Receipt</h5>
                    <button data-access="Close" type="button" @onclick="ClosePopup" class="close"><span aria-hidden="true">×</span></button>
                </div>
                <EditForm Model="@model" OnValidSubmit="@OnSave">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="row m-0 form-row">
                            <div class="col-lg-6 col-12 mb-2">
                                <div class="form-box-group static-label">
                                    <InputSelect class="floating-input" placeholder=" " @bind-Value="classCode" @bind-Value:after="OnClassChanged">
                                        <option value="">--Select Class--</option>
                                        @foreach (var item in classlist)
                                        {
                                            <option value="@item.ClassCode">@item.ClassName</option>
                                        }
                                    </InputSelect>
                                    <label class="floating-label">Class</label>
                                </div>
                            </div>
                            <div class="col-lg-6 col-12 mb-2">
                                <div class="form-box-group static-label">
                                    <InputSelect class="floating-input" placeholder=" " @bind-Value="model.StudentIdRef">
                                        <option value="0">--Select Student--</option>
                                        @foreach (var item in studentlist)
                                        {
                                            <option value="@item.StudentId">@item.StudentName</option>
                                        }
                                    </InputSelect>
                                    <label class="floating-label">Student <span class="required">*</span></label>
                                    <ValidationMessage For="@(() => model.StudentIdRef)" />
                                </div>
                            </div>
                            <div class="col-lg-4 col-12 mb-2">
                                <div class="form-box-group static-label">
                                    <InputSelect class="floating-input" placeholder=" " @bind-Value="feeHeadIdText">
                                        <option value="">-- General (not head-specific) --</option>
                                        @foreach (var item in feeHeadList)
                                        {
                                            <option value="@item.FeeHeadId">@item.FeeHeadName</option>
                                        }
                                    </InputSelect>
                                    <label class="floating-label">Fee Head</label>
                                </div>
                            </div>
                            <div class="col-lg-4 col-12 mb-2">
                                <div class="form-box-group static-label">
                                    <label class="floating-label">Adjustment Type <span class="required">*</span></label>
                                    <div class="border-box d-flex justify-content-center align-items-center gap-3">
                                        <InputRadioGroup @bind-Value="model.AdjustmentType">
                                            <div class="d-flex align-items-center gap-1">
                                                <InputRadio Value="@("Add")" />
                                                <label class="form-label">Add (+)</label>
                                            </div>
                                            <div class="d-flex align-items-center gap-1">
                                                <InputRadio Value="@("Deduct")" />
                                                <label class="form-label">Deduct (-)</label>
                                            </div>
                                        </InputRadioGroup>
                                    </div>
                                    <ValidationMessage For="@(() => model.AdjustmentType)" />
                                </div>
                            </div>
                            <div class="col-lg-4 col-12 mb-2">
                                <div class="form-box-group">
                                    <InputNumber class="floating-input" placeholder=" " @bind-Value="model.Amount" />
                                    <label class="floating-label">Amount <span class="required">*</span></label>
                                    <ValidationMessage For="@(() => model.Amount)" />
                                </div>
                            </div>
                            <div class="col-lg-12 col-12 mb-2">
                                <div class="form-box-group">
                                    <InputText class="floating-input" placeholder=" " @bind-Value="model.Reason" />
                                    <label class="floating-label">Reason <span class="required">*</span></label>
                                    <ValidationMessage For="@(() => model.Reason)" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <div class="form-group btn-gr">
                            <SaveUpdateButton Id="0" TextSave="Post Adjustment" OnClickCancel="ClosePopup" />
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (IsLoading)
{
    <div class="grid-loader-overlay">
        <img src="images/loading.gif" alt="Loading..." />
    </div>
}

@code {
    private List<AdjustmentReceiptModel> list = new();
    private List<BranchClassModel> classlist = new();
    private List<StudentResponse> studentlist = new();
    private List<FeeHeadModel> feeHeadList = new();

    private AdjustmentReceiptModel model = new();
    private string? classCode;

    // InputSelect needs a string-backed value to represent "no selection" for a nullable int cleanly.
    private string feeHeadIdText
    {
        get => model.FeeHeadId?.ToString() ?? "";
        set => model.FeeHeadId = string.IsNullOrEmpty(value) ? null : int.Parse(value);
    }

    private bool ShowPopup;
    private bool IsLoading;
    private string? nameFilter;
    private PaginationState pagination = new() { ItemsPerPage = 15 };

    private long CurrentSession;
    private string? branchcode;
    private string? groupcode;
    private string username = string.Empty;
    private string currentUrl = "";

    protected override void OnInitialized() => currentUrl = Nav.Uri;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CurrentSession = await _commonmethod.SetCurrentSessionData();
            branchcode = (await sessionStorage.GetAsync<string>("BranchCode")).Value;
            groupcode = (await sessionStorage.GetAsync<string>("GroupCode")).Value;
            username = (await sessionStorage.GetAsync<string>("UserName")).Value ?? string.Empty;

            classlist = await httpService.Get<List<BranchClassModel>>("BranchClass/GetClassCode") ?? new();
            feeHeadList = await httpService.Get<List<FeeHeadModel>>("FeeHead/GetFeeHeadList") ?? new();
            await LoadData();
            StateHasChanged();
        }
    }

    protected IQueryable<AdjustmentReceiptModel> moduleQuery
    {
        get
        {
            var result = list.AsQueryable();
            if (!string.IsNullOrEmpty(nameFilter))
            {
                result = result.Where(x => x.StudentName != null && x.StudentName.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase));
            }
            return result;
        }
    }

    private async Task LoadData()
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            var req = new SearchAnyRequestModel { GroupCode = groupcode, BranchCode = branchcode, SessionId = CurrentSession };
            var apiResponse = await httpService.Post<ApiResponse<List<AdjustmentReceiptModel>>>("AdjustmentReceipt/ListAdjustmentReceipt", req);
            list = (apiResponse != null && apiResponse.Success) ? (apiResponse.Data ?? new()) : new();
        }
        catch { list = new(); }
        finally { IsLoading = false; StateHasChanged(); }
    }

    private void OpenNewPopup()
    {
        model = new AdjustmentReceiptModel { GroupCode = groupcode, BranchCode = branchcode, SessionId = CurrentSession, AdjustmentType = "Add" };
        classCode = null;
        studentlist = new();
        ShowPopup = true;
    }

    private void ClosePopup() => ShowPopup = false;

    private async Task OnClassChanged()
    {
        studentlist = new();
        model.StudentIdRef = 0;
        if (string.IsNullOrEmpty(classCode)) { StateHasChanged(); return; }

        var searchAny = new SearchAnyRequestModel { GroupCode = groupcode, BranchCode = branchcode, RequestName = classCode, SessionId = CurrentSession };
        var apiresponse = await httpService.Post<ApiResponse<List<StudentResponse>>>("Student/GetStudentByClass", searchAny) ?? new();
        if(apiresponse.Success==true && apiresponse.Data != null)
        {
            studentlist = apiresponse.Data ?? new();
        }
        StateHasChanged();
    }

    private async Task OnSave()
    {
        model.CreatedBy = username;
        IsLoading = true;
        ShowPopup = false;
        StateHasChanged();
        try
        {
            var apiResponse = await httpService.Post<ApiResponse<object>>("AdjustmentReceipt/AddAdjustmentReceipt", model);
            if (apiResponse != null && apiResponse.Success && apiResponse.Code == 1)
            {
                ShowPopup = false;
                await Alert.ShowSuccess("Adjustment recorded successfully.");
                await LoadData();
            }
            else
            {
                await Alert.ShowWarning(apiResponse?.Message ?? "Operation failed.");
            }
        }
        catch (Exception ex)
        {
            await Alert.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task ApproveReceipt(AdjustmentReceiptModel row)
    {
        var confirm = await Alert.ShowConfirm("Approve this adjustment? This will apply it to the student's ledger.");
        if (!confirm) return;

        IsLoading = true;
        StateHasChanged();
        try
        {
            // ApprovedBy is intentionally not sent — the server derives and verifies the
            // approver from the authenticated user's token, and rejects self-approval.
            var request = new AdjustmentApprovalRequest
            {
                AdjustmentId = row.AdjustmentId,
                GroupCode = groupcode,
                BranchCode = branchcode,
                SessionId = CurrentSession
            };
            var apiResponse = await httpService.Post<ApiResponse<object>>("AdjustmentReceipt/ApproveAdjustmentReceipt", request);
            if (apiResponse != null && apiResponse.Success)
            {
                await Alert.ShowSuccess("Adjustment approved successfully.");
                await LoadData();
            }
            else
            {
                await Alert.ShowWarning(apiResponse?.Message ?? "Operation failed.");
            }
        }
        catch (Exception ex)
        {
            await Alert.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }
}
