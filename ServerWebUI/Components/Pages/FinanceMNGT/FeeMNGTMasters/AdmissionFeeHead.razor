@page "/feeAdmissionHead"
@using DomainModel.FinanceMNGT;
@using Microsoft.AspNetCore.Authorization
@using ServerWebUI.Components.Pages.CommonPages
@inject IHttpClientFactory ClientFactory
@using Microsoft.AspNetCore.Components.QuickGrid
@using System.Net
@using System.Text.Json
@inject IStringLocalizer<Resource> Localizer
@using MyApp.Common
@inject IJSRuntime JS
@inject Shared.IHttpService httpService
@inject HttpClient Http
@inject SweetAlertService Alert
@rendermode InteractiveServer
<div class="main-container">
    <div class="row m-0 main-row">
        <div class="col-12 p-1">
            <div class="page-heading d-flex align-items-center justify-content-between">
                <p class="m-0 page-name px-1">Admission Fee </p>
                <div class="d-flex gap-2">
                    <button class="ui fade op-1 animated button form-btn" @onclick="AddFeeHeadModel">
                        <div class="visible content">Add</div>
                        <div class="hidden content"><i class="bi bi-plus-lg"></i></div>
                    </button>
                </div>
            </div>
        </div>
        <div class="col-12 p-1">
            <div class="card">
                <div class="card-body table-card p-0 scrollbar-thin">
                    <div class="quick-main">
                        <div class="grid-box">
                            <QuickGrid Items="@FilteredItems" Class="table table-bordered  table-striped" Pagination="@pagination">

                                <PropertyColumn Property="@(x => x.BankName)" Title="Admission Fee Head" Sortable="true" Align="Align.Left">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="bank Name Name..." />
                                        </div>
                                    </ColumnOptions>

                                </PropertyColumn>
                                <PropertyColumn Property="@(x => x.BranchName)" Title="Fee Head Type" Sortable="true" Align="Align.Left">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="branch Name..." />
                                        </div>
                                    </ColumnOptions>
                                </PropertyColumn>
                                <PropertyColumn Property="@(x => x.BranchName)" Title="DisplayOrder" Sortable="true" Align="Align.Left">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="branch Name..." />
                                        </div>
                                    </ColumnOptions>
                                </PropertyColumn>
                                <TemplateColumn Title="Status" Align="Align.Center">
                                    <ColumnOptions>
                                        <div>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "2")" @onchange="() => FilterChangedAsync(2)" /> Both
                                            </label>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "1")" @onchange="() => FilterChangedAsync(1)" /> Active
                                            </label>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "0")" @onchange="() => FilterChangedAsync(0)" /> Inactive
                                            </label>
                                        </div>
                                    </ColumnOptions>
                                    <ChildContent>
                                        <span class="@GetStatusClass(context.IsValid == true)">

                                            @(context.IsValid == true ? "Active" : "Inactive")
                                        </span>
                                    </ChildContent>
                                </TemplateColumn>

                                <TemplateColumn Align="Align.Center" Title="Action">
                                    <ActionButtonGroup IsValid="context.IsValid" OnEditClick="() => EditFeeHead(context)" OnStatusClick="() => ChangeFeeHeadStatus(context.BankId, context.IsValid)" />
                                </TemplateColumn>
                            </QuickGrid>

                        </div>
                        <div class="footer-pagination">
                            <div class="d-flex align-items-center">
                                <div class="welcome-text w-100">
                                    <Paginator State="@pagination" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>

@if (ShowPopup)
{
    <div class="custom-modal row m-0 align-items-center">
        <div class="col-12 col-sm-7 col-md-5 col-lg-4 col-xl-4">
            <div class="modal-content clearfix main-popup">
                <div class="head-btn">
                    <h5 class="modal-title">@((bankModel.BankId == 0) ? "Add Fee Head" : "Edit Fee Head")</h5>
                    <button data-access="Close" type="button" @onclick="ClosePopup" class="close"><span aria-hidden="true">×</span></button>
                </div>
                <EditForm Model="@bankModel" OnValidSubmit="OnSave">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="row gap-10-0">

                            <div class="col-12 ">
                                <div class="form-box">
                                    <label class="form-label">Fee Head Name<span class="required">*</span></label>

                                    <InputText class="form-input" @bind-Value="bankModel.BankName" onkeypress="return /^[a-z A-Z ]$/.test(event.key)" autocomplete="off" required />
                                    <ValidationMessage For="@(() => bankModel.BankName)" />
                                </div>
                            </div>
                            <div class="col-12 mt-3">
                                <div class="form-box">
                                    <label class="form-label">Fee Head Type <span class="required">*</span></label>

                                    <InputText class="form-input" @bind-Value="bankModel.BranchName" onkeypress="return /^[a-z A-Z ]$/.test(event.key)" autocomplete="off" required />
                                    <ValidationMessage For="@(() => bankModel.BranchName)" />
                                </div>
                            </div>
                            <div class="col-12 mt-3">
                                <div class="form-box">
                                    <label class="form-label">Fee Application Type <span class="required">*</span></label>

                                    <InputText class="form-input" @bind-Value="bankModel.BankAddress" onkeypress="return /^[a-z A-Z ]$/.test(event.key)" autocomplete="off" required />
                                    <ValidationMessage For="@(() => bankModel.BankAddress)" />
                                </div>
                            </div>
                            <div class="col-12 mt-3">
                                <div class="form-box">
                                    <label class="form-label">DisplayOrder </label>

                                    <InputText class="form-input" @bind-Value="bankModel.BankAddress" autocomplete="off" required />
                                    <ValidationMessage For="@(() => bankModel.BankAddress)" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <div class="form-group btn-gr">
                            <SaveUpdateButton Id="bankModel.BankId" OnClickCancel="ClosePopup" />
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}


@if (IsLoading)
{
    <div class="grid-loader-overlay">
        <img src="images/loading.gif" alt="Loading..." />
    </div>
}
else
{
    @if (Banklist.Count > 0)
    {
    }
}

@code
{
    private BankModel bankModel = new();
    private List<BankModel> Banklist = new();
    private string olddesignation = "";
    private string nameFilter = string.Empty;
    PaginationState pagination = new() { ItemsPerPage = 15 };
    private string statusFilter = "1";
    private bool IsLoading = true;
    private bool ShowPopup;
    private string? branchcode;
    private string? groupcode;
    private string? username;

    private void AddFeeHeadModel()
    {
        ShowPopup = true;
    }
    private void ClosePopup()
    {
        ShowPopup = false;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadData();
            var userResult = await sessionStorage.GetAsync<string>("UserName");
            username = userResult.Value;
            StateHasChanged();
        }
    }

    private async Task LoadData()
    {
        var branchResult = await sessionStorage.GetAsync<string>("BranchCode");
        branchcode = branchResult.Value;
        var groupResult = await sessionStorage.GetAsync<string>("GroupCode");
        groupcode = groupResult.Value;
        IsLoading = true;
        string ApiUri = "Finance/GetBank";
        Banklist = await httpService.Get<List<BankModel>>(ApiUri) ?? new();
        IsLoading = false;
    }
    private async Task OnSave()
    {

        try
        {
            if (bankModel.BankId > 0)
            {
                ShowPopup = false;
                var isConfirmed = await JS.InvokeAsync<bool>("showUpdateConfirm");
                if (!isConfirmed)
                {
                    ShowPopup = true;
                    return;
                }
                bool isSame = CommonMethod.IsEdited(bankModel, olddesignation);
                if (!isSame)
                {
                    await Alert.ShowWarning("No changes detected.");
                    ShowPopup = true;
                    return;
                }
            }
            ShowPopup = false;
            bankModel.IsValid = true;
            bankModel.GroupCode = groupcode;
            bankModel.CreatedBy = username;
            //bankModel.CreatedDate = DateTime.Now;
            string apiUrl = "Finance/AddOrUpdateFINBank";
            var apiResponse = await httpService.Post<ApiResponse<object>>(apiUrl, bankModel);
            var responsecode = apiResponse.Code;
            if (responsecode == 0)
            {
                await Alert.ShowWarning("Bank Name " + @Localizer["Already"]);
            }
            else if (responsecode == 1)
            {
                await Alert.ShowSuccess("Bank Name " + @Localizer["Inserted"]);
            }
            else if (responsecode == 2)
            {
                await Alert.ShowUpdate("Bank Name " + @Localizer["Updated"]);
            }
            else
            {
                await Alert.ShowCustomAlert(@Localizer["Admin"]);
            }

            await LoadData();
            bankModel = new BankModel();
        }
        catch (Exception ex)
        {
            await Alert.ShowError($"{@Localizer["Error"]}: {ex.Message}");
        }
        finally
        {
           
            StateHasChanged();
        }
    }

    private void EditFeeHead(BankModel item)
    {
        bankModel = new BankModel
        {
            BankId = item.BankId,
            BankName = item.BankName,
            BranchName = item.BranchName,
            BankAddress = item.BankAddress
        };
        olddesignation = CommonMethod.CreateSnapshot(bankModel);
        ShowPopup = true;
    }


    protected IQueryable<BankModel> FilteredItems
    {
        get
        {
            var result = Banklist.AsQueryable();
            if (!string.IsNullOrEmpty(nameFilter))
            {
                result = result.Where(x => (x.BankName != null && x.BankName.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)) ||
            (x.BranchName != null && x.BranchName.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)));

            }
            if (statusFilter == "1")
            {
                result = result.Where(s => s.IsValid);
            }
            else if (statusFilter == "0")
            {
                result = result.Where(s => !s.IsValid);
            }
            return result;
        }
    }
    private string GetStatusClass(bool isActive)
    {
        return isActive ? "activeClr" : "inactiveClr";
    }
    private void FilterChangedAsync(int filterValue)
    {
        statusFilter = filterValue.ToString();
        StateHasChanged();
    }
    private async Task ChangeFeeHeadStatus(int id, bool isValid)
    {
        try
        {
            bool isActivate = !isValid;
            bool isConfirmed = await JS.InvokeAsync<bool>(isActivate ? "showActiveConfirm" : "showDeleteConfirm");
            if (!isConfirmed)
                return;

            string apiUrl = "Finance/DeleteFINBank";

            var apiResponse = await httpService.Post<ApiResponse<object>>(apiUrl, id);

            if (apiResponse.Success)
            {
                if (isActivate)
                    await Alert.ShowActive(Localizer["Activated"]);
                else
                    await Alert.ShowDeactive(Localizer["Deleted"]);

                await LoadData();
                StateHasChanged();
            }
            else
            {
                await Alert.ShowCustomAlert(@Localizer["Admin"]);
            }
        }
        catch (Exception ex)
        {
            await Alert.ShowError($"{Localizer["Error"]}: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
            await LoadData();
        }
    }
}

