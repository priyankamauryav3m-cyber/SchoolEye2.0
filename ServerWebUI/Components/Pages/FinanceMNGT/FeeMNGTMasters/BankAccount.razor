@page "/bankAccount"
@using DomainModel.FinanceMNGT;
@using Microsoft.AspNetCore.Authorization
@using ServerWebUI.Components.Pages.CommonPages
@inject IHttpClientFactory ClientFactory
@using Microsoft.AspNetCore.Components.QuickGrid
@using System.Net
@using System.Text.Json
@inject IStringLocalizer<Resource> Localizer
@using MyApp.Common
@inject IJSRuntime JS
@inject Shared.IHttpService httpService
@inject HttpClient Http
@inject SweetAlertService Alert
@rendermode InteractiveServer
<div class="main-container">
    <div class="row m-0 main-row">
        <div class="col-12 p-1">
            <div class="page-heading d-flex align-items-center justify-content-between">
                <p class="m-0 page-name px-1">Bank Account </p>
                <div class="d-flex gap-2">
                    @* <button class="ui fade op-1 animated button form-btn" @onclick="AddAccount">
                        <div class="visible content">Add</div>
                        <div class="hidden content"><i class="bi bi-plus-lg"></i></div>
                    </button> *@
                    <ActionButtonGroup CurrentUrl="@currentUrl" Add="AddAccount" />
                </div>
            </div>
        </div>
        <div class="col-12 p-1">
            <div class="card">
                <div class="card-body table-card p-0 scrollbar-thin">
                    <div class="quick-main">
                        <div class="grid-box">
                            <QuickGrid Items="@FilteredItems" Class="table" Pagination="@pagination">

                                <PropertyColumn Property="@(x => x.AccountType)" Title="Account Type" Sortable="true" Align="Align.Left">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="Account No...." />
                                        </div>
                                    </ColumnOptions>

                                </PropertyColumn>

                                <TemplateColumn Title="Status" Align="Align.Center">
                                    <ColumnOptions>
                                        <div>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "2")" @onchange="() => FilterChangedAsync(2)" /> Both
                                            </label>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "1")" @onchange="() => FilterChangedAsync(1)" /> Active
                                            </label>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "0")" @onchange="() => FilterChangedAsync(0)" /> Inactive
                                            </label>
                                        </div>
                                    </ColumnOptions>
                                    <ChildContent>
                                        <span class="@GetStatusClass(context.IsValid == true)">

                                            @(context.IsValid == true ? "Active" : "Inactive")
                                        </span>
                                    </ChildContent>
                                </TemplateColumn>


                                <TemplateColumn Align="Align.Center" Title="Action">
                                    <ActionButtonGroup IsValid="context.IsValid" CurrentUrl="@currentUrl" OnEditClick="() => EditAccount(context)" OnStatusClick="() => ChangeAccountStatus(context.DetBankAcId, context.IsValid)" />
                                </TemplateColumn>
                            </QuickGrid>


                        </div>
                        <div class="footer-pagination">
                            <div class="d-flex align-items-center">
                                <div class="welcome-text w-100">
                                    <Paginator State="@pagination" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>

@if (ShowPopup)
{
    <div class="custom-modal row m-0 align-items-center">
        <div class="col-12 col-sm-7 col-md-5 col-lg-4 col-xl-4">
            <div class="modal-content clearfix main-popup">
                <div class="head-btn">
                    <h5 class="modal-title">@((accountModel.DetBankAcId == 0) ? "Add Account No." : "Edit Account No.")</h5>
                    <button data-access="Close" type="button" @onclick="ClosePopup" class="close"><span aria-hidden="true">×</span></button>
                </div>
                <EditForm Model="@accountModel" OnValidSubmit="OnSave">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="row m-0 form-row">

                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                <div class="form-box-group">
                                    <InputText class="floating-input" placeholder=" " @bind-Value="accountModel.AccountNo" onkeypress="return  /^[0-9]$/.test(event.key)" autocomplete="off" required />
                                    <label class="floating-label">
                                        Account No. <span class="required">*</span>
                                    </label>
                                    <ValidationMessage For="@(() => accountModel.AccountNo)" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                <div class="form-box-group">
                                    <InputText class="floating-input" placeholder=" " @bind-Value="accountModel.AccountType" onkeypress="return /^[a-z A-Z]$/.test(event.key)" autocomplete="off" required />
                                    <label class="floating-label">Account Type</label>
                                </div>
                            </div>
                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                <div class="form-box-group static-label">
                                    <InputSelect class="floating-input" placeholder=" " @bind-Value="accountModel.BankId">
                                        <option  value="" selected >--Select--</option>
                                        @foreach (var data in Banklist.Where(x => x.IsValid == true))
                                        {
                                            <option value="@data.BankId">@data.BankName</option>
                                        }
                                    </InputSelect>
                                    <label class="floating-label">
                                        Bank Name <span class="required">*</span>
                                    </label>
                                    <ValidationMessage For="@(() => accountModel.BankId)" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                <div class="form-box-group">
                                    <InputText class="floating-input" placeholder=" " @bind-Value="accountModel.DisplayName" onkeypress="return /^[a-z A-Z]$/.test(event.key)" autocomplete="off" required />
                                    <label class="floating-label">Display Name</label>
                                    <ValidationMessage For="@(() => accountModel.DisplayName)" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <div class="form-group btn-gr">
                            <SaveUpdateButton Id="accountModel.DetBankAcId" OnClickCancel="ClosePopup" />

                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}


@if (IsLoading)
{
    <div class="grid-loader-overlay">
        <img src="images/loading.gif" alt="Loading..." />
    </div>
}
else
{
    @if (bankAccountlist.Count > 0)
    {
    }
}




