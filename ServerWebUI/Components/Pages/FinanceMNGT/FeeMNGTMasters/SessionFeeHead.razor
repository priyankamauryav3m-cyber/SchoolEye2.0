@page "/feeHeadsession"
@using DomainModel.Admin
@using DomainModel.FinanceMNGT;
@using Microsoft.AspNetCore.Authorization
@using ServerWebUI.Components.Pages.CommonPages
@inject IHttpClientFactory ClientFactory
@using Microsoft.AspNetCore.Components.QuickGrid
@using System.Net
@using System.Text.Json
@inject IStringLocalizer<Resource> Localizer
@using MyApp.Common
@inject IJSRuntime JS
@inject Shared.IHttpService httpService
@inject HttpClient Http
@inject SweetAlertService Alert
@rendermode InteractiveServer
<div class="main-container">
    <div class="row m-0 main-row">
        <div class="col-12 p-1">
            <div class="page-heading d-flex align-items-center justify-content-between">
                <p class="m-0 page-name px-1">Fee Head Session </p>
                <div class="d-flex gap-2">
                    <div class="form-box">
                        <InputSelect @bind-Value="@CurrentSession" name="session" class="form-input">
                            <option value="0">-- Select Session --</option>
                            @foreach (var data in sessionlist.Where(x => x.IsValid == true))
                            {
                                <option value="@data.SessionId">@data.SessionName </option>
                            }
                        </InputSelect>
                    </div>
                    <div class="form-box">
                        <button class="ui fade op-1 animated button form-btn" @onclick="SearchBySessionFeeHead" tabindex="0">
                            <div class="visible content">Search</div>
                            <div class="hidden content">
                                <i class="bi bi-search"></i>
                            </div>
                        </button>
                    </div>
                    <ActionButtonGroup CurrentUrl="@currentUrl" Add="AddFeeHeadSessionModel" />
                </div>

            </div>
        </div>
        <div class="col-12 p-1">
            <div class="card">
                <div class="card-body table-card p-0 scrollbar-thin">
                    <div class="quick-main">
                        <div class="grid-box">
                            <QuickGrid Items="@FilteredItems" Class="table" Pagination="@pagination">

                                @* <PropertyColumn Property="@(x => x.Session)" Title="Session Name" Sortable="true" Align="Align.Left">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="Session Name..." />
                                        </div>
                                    </ColumnOptions>

                                </PropertyColumn> *@


                                <PropertyColumn Property="@(x => x.FeeHeadName)" Title="FeeHead Name" Sortable="true" Align="Align.Left">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="Fee Head Name..." />
                                        </div>
                                    </ColumnOptions>

                                </PropertyColumn>
                                <PropertyColumn Property="@(x => x.FeeHeadType)" Title="FeeHead Type" Sortable="true" Align="Align.Left">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="Fee Head Type..." />
                                        </div>
                                    </ColumnOptions>

                                </PropertyColumn>


                                <TemplateColumn Title="Status" Align="Align.Center">
                                    <ColumnOptions>
                                        <div>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "2")" @onchange="() => FilterChangedAsync(2)" /> Both
                                            </label>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "1")" @onchange="() => FilterChangedAsync(1)" /> Active
                                            </label>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "0")" @onchange="() => FilterChangedAsync(0)" /> Inactive
                                            </label>
                                        </div>
                                    </ColumnOptions>
                                    <ChildContent>
                                        <span class="@GetStatusClass(context.IsValid == true)">

                                            @(context.IsValid == true ? "Active" : "Inactive")
                                        </span>
                                    </ChildContent>
                                </TemplateColumn>

                                <TemplateColumn Align="Align.Center" Title="Action">
                                    <ActionButtonGroup IsValid="context.IsValid" CurrentUrl="@currentUrl" OnEditClick="() => EditFeeHead(context)" OnStatusClick="() => ChangeFeeHeadStatus(context.Sid, context.IsValid)" />
                                </TemplateColumn>
                            </QuickGrid>

                        </div>
                        <div class="footer-pagination">
                            <div class="d-flex align-items-center">
                                <div class="welcome-text w-100">
                                    <Paginator State="@pagination" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>

@if (ShowPopup)
{
    <div class="custom-modal row m-0 align-items-center">
        <div class="col-12 col-sm-7 col-md-5 col-lg-4 col-xl-4">
            <div class="modal-content clearfix main-popup">
                <div class="head-btn">
                    <h5 class="modal-title">@((detSession.Sid == 0) ? "Add Fee Head Session" : "Edit Fee Head Session")</h5>
                    <button data-access="Close" type="button" @onclick="ClosePopup" class="close"><span aria-hidden="true">×</span></button>
                </div>
                <EditForm Model="@detSession" OnValidSubmit="OnSave">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="row gap-10-0">
                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                <div class="form-box-group static-label">
                                    <InputSelect class="floating-input" placeholder=" " @bind-Value="@detSession.SessionId" name="session">
                                        <option value="0" hidden=""></option>
                                        @foreach (var data in sessionlist.Where(x => x.IsValid == true))
                                        {
                                            <option value="@data.SessionId">@data.SessionName </option>
                                        }
                                    </InputSelect>
                                    <label class="floating-label">
                                        Session <span class="required">*</span>
                                    </label>
                                    <ValidationMessage For="@(() => detSession.SessionId)" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2 mt-2">
                                <div class="form-box-group static-label">
                                    <InputSelect class="floating-input" placeholder=" " @bind-Value="@detSession.FeeHeadId">
                                        <option value="0" hidden=""></option>
                                        @foreach (var data in feeHeadlist.Where(x => x.IsValid == true))
                                        {
                                            <option value="@data.FeeHeadId">@data.FeeHeadName</option>
                                        }
                                    </InputSelect>
                                    <label class="floating-label">
                                        Fee Head Name <span class="required">*</span>
                                    </label>
                                    <ValidationMessage For="@(() => detSession.FeeHeadId)" />
                                </div>
                            </div>

                        </div>
                    </div>

                    <div class="modal-footer">
                        <div class="form-group btn-gr">
                            <SaveUpdateButton Id="detSession.Sid" OnClickCancel="ClosePopup" />
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}


@if (IsLoading)
{
    <div class="grid-loader-overlay">
        <img src="images/loading.gif" alt="Loading..." />
    </div>
}
else
{
    @if (detSessionlist.Count > 0)
    {
    }
}



@code {
    private DetSessionModel detSession = new();
    private string olddesignation = "";
    private List<DetSessionModel> detSessionlist = new();
    private List<FeeHeadModel> feeHeadlist = new();
    private string nameFilter = string.Empty;
    PaginationState pagination = new() { ItemsPerPage = 15 };
    private string statusFilter = "1";
    private bool IsLoading = false;
    private bool ShowPopup;
    private string branchcode;
    private string groupcode;
    private string UserName;
    private List<SessionModel> sessionlist = new();
    SearchAnyRequestModel searchAny = new();
    private string? currentUrl;
    private long CurrentSession;
    protected override void OnInitialized()
    {

        PermissionState.OnChange += StateHasChanged;
        currentUrl = Nav.Uri;
        StateHasChanged();

    }
    private void AddFeeHeadSessionModel()
    {
        detSession = new();
        ShowPopup = true;
    }
    private void ClosePopup()
    {
        detSession = new();
        ShowPopup = false;
        StateHasChanged();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CurrentSession = await CommonMethod.SetCurrentSessionData();
            await LoadData();
            StateHasChanged();

        }
    }

    private async Task LoadData()
    {
        var branchResult = await sessionStorage.GetAsync<string>("BranchCode");
        branchcode = branchResult.Value;
        var groupResult = await sessionStorage.GetAsync<string>("GroupCode");
        var username = await sessionStorage.GetAsync<string>("UserName");
        UserName = username.Value;
        groupcode = groupResult.Value;
        string ApiUri1 = "FeeHead/GetFeeHeadList";
        feeHeadlist = await httpService.Get<List<FeeHeadModel>>(ApiUri1) ?? new();
        string ApiUri2 = "Session/GetSession";
        sessionlist = await httpService.Get<List<SessionModel>>(ApiUri2) ?? new();
        await SearchBySessionFeeHead();

    }
    private async Task OnSave()
    {

        try
        {
            if (detSession.Sid > 0)
            {
                ShowPopup = false;
                var isConfirmed = await JS.InvokeAsync<bool>("showUpdateConfirm");
                if (!isConfirmed)
                {
                    ShowPopup = true;
                    return;
                }
                bool isSame = CommonMethod.IsEdited(detSession, olddesignation);
                if (!isSame)
                {
                    await Alert.ShowWarning("No changes detected.");
                    ShowPopup = true;
                    return;
                }
            }

            ShowPopup = false;
            if (detSession.SessionId == 0)
            {
                await Alert.ShowWarning("Please select a session");
                ShowPopup = true;
                StateHasChanged();
                return;
            }
            detSession.IsValid = true;
            detSession.GroupCode = groupcode;
            detSession.BranchCode = branchcode;
            detSession.CreatedBy = UserName;
            string apiUrl = "SessionFeeHeads/AddOrUpdateDetSession";
            var apiResponse = await httpService.Post<ApiResponse<object>>(apiUrl, detSession);
            var responsecode = apiResponse.Code;
            if (responsecode == 0)
            {
                await Alert.ShowWarning("Fee Head" + @Localizer["Already"]+"in this session");
            }
            else if (responsecode == 1)
            {
                await Alert.ShowSuccess("Fee Head mapped to session successfully!");
            }
            else if (responsecode == 2)
            {
                await Alert.ShowUpdate("Fee Head mapping " + @Localizer["Updated"]);
            }
            else
            {
                await Alert.ShowCustomAlert(@Localizer["Admin"]);
            }

            await LoadData();
            detSession = new DetSessionModel();

        }
        catch (Exception ex)
        {
            await Alert.ShowError($"{@Localizer["Error"]}: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
        }
    }

    private void EditFeeHead(DetSessionModel item)
    {
        detSession = new DetSessionModel
        {
            Sid = item.Sid,
            FeeHeadId = item.FeeHeadId,
            SessionId = item.SessionId

        };
        olddesignation = CommonMethod.CreateSnapshot(detSession);
        ShowPopup = true;
    }


    protected IQueryable<DetSessionModel> FilteredItems
    {
        get
        {
            var result = detSessionlist.AsQueryable();
            if (!string.IsNullOrEmpty(nameFilter))
            {
                result = result.Where(x => (x.Session != null && x.Session.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)));

            }
            if (statusFilter == "1")
            {
                result = result.Where(s => s.IsValid);
            }
            else if (statusFilter == "0")
            {
                result = result.Where(s => !s.IsValid);
            }
            return result;
        }
    }
    private string GetStatusClass(bool isActive)
    {
        return isActive ? "activeClr" : "inactiveClr";
    }
    private void FilterChangedAsync(int filterValue)
    {
        statusFilter = filterValue.ToString();
        StateHasChanged();
    }
    private async Task ChangeFeeHeadStatus(int id, bool isValid)
    {
        try
        {
            bool isActivate = !isValid;
            bool isConfirmed = await JS.InvokeAsync<bool>(isActivate ? "showActiveConfirm" : "showDeleteConfirm");
            if (!isConfirmed)
                return;

            string apiUrl = "SessionFeeHeads/DeleteSession";

            var apiResponse = await httpService.Post<ApiResponse<object>>(apiUrl, id);

            if (apiResponse.Success)
            {
                if (isActivate)
                    await Alert.ShowActive(Localizer["Activated"]);
                else
                    await Alert.ShowDeactive(Localizer["Deleted"]);

                await LoadData();
                StateHasChanged();
            }
            else
            {
                await Alert.ShowCustomAlert(@Localizer["Admin"]);
            }
        }
        catch (Exception ex)
        {
            await Alert.ShowError($"{Localizer["Error"]}: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
            await LoadData();
        }
    }
    private async Task SearchBySessionFeeHead()
    {
        try
        {
    
            IsLoading = true;
            searchAny.GroupCode = groupcode;
            searchAny.BranchCode = branchcode;
            searchAny.SessionId = CurrentSession;

            var apiResponse = await httpService.Post<ApiResponse<List<DetSessionModel>>>("SessionFeeHeads/GetSessionFeeHead", searchAny);
            if (apiResponse.Success)
            {
                detSessionlist = apiResponse.Data ?? new List<DetSessionModel>();
                IsLoading = false;
            }
            else
            {
                detSessionlist = new List<DetSessionModel>();
            }

        }
        catch
        {
            detSessionlist = new List<DetSessionModel>();
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }

    }
}

