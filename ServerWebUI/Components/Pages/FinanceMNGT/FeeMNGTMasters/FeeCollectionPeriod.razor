            {
                await Alert.ShowUpdate("Fee Period Name" + @Localizer["Updated"]);
            }
            else
            {   
                await Alert.ShowCustomAlert(@Localizer["Admin"]);
            }

            await SearchFeeCollection();
            feeCollectionPeriod = new FeeCollectionPeriodConfig();
