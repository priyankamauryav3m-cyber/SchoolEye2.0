    private async Task OnSave()
    {

        try
        {

            ShowPopup = false;
            if (feeCollectionPeriod.PeriodId > 0)
            {
                feeCollectionPeriod.MonthNos = string.Join(",", monthmappinglist.Select(x => x.MonthNo));
                if (string.IsNullOrWhiteSpace(feeCollectionPeriod.MonthNos))
                {
                    await Alert.ShowWarning("Please select  month!");
                    ShowPopup = true;
                    StateHasChanged();
                    return;
                }
                bool isSame = CommonMethod.IsEdited(feeCollectionPeriod, olddesignation);
                if (!isSame)
                {
                    await Alert.ShowWarning("No changes detected.");
                    ShowPopup = true;
                    StateHasChanged();
                    return;
                }
            }
            else
            {
                feeCollectionPeriod.MonthNos = string.Join(",", monthmappinglist.Where(x => x.IsSelected).Select(x => x.MonthNo));
                if (string.IsNullOrWhiteSpace(feeCollectionPeriod.MonthNos))
                {
                    await Alert.ShowWarning("Please select  month!");
                    ShowPopup = true;
                    StateHasChanged();
                    return;
                }
            }
            feeCollectionPeriod.IsValid = true;
            feeCollectionPeriod.GroupCode = groupcode;
            feeCollectionPeriod.BranchCode = branchcode;
            feeCollectionPeriod.CreatedBy = UserName;
            feeCollectionPeriod.SessionId = CurrentSession;
            feeCollectionPeriod.QuarterName = feeCollectionPeriod.PeriodType == "Quarterly" ? "Qurt" : feeCollectionPeriod.PeriodType == "Monthly" ? "Month" : feeCollectionPeriod.PeriodType == "Custom" ? "Cus" : "";
            feeCollectionPeriod.NoOfMonth = feeCollectionPeriod.PeriodType == "Quarterly" ? 3 : feeCollectionPeriod.PeriodType == "Custom" ? monthmappinglist.Count(x => x.IsSelected) : 1;

            string apiUrl = "FeeCollectionPeriodConfig/AddUpdateFeeCollection";
