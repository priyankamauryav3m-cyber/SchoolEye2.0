    private async Task OnSaveLetFeeConfiguration()
    {
        try
        {
            var classdata = string.Join(",", getAllClasslist.Where(x => x.IsSelected).Select(x => x.ClassCode));
            if (string.IsNullOrEmpty(classdata))
            {
                await customAlert.ShowCustomAlert("Please select a class.", false);
                StateHasChanged();
                return;
            }
            OpenAddLetFeePopup = false;
            var submit = await Alert.ShowConfirm("Are you sure, you want to submit late fees.");
            if (!submit)
            {
                OpenAddLetFeePopup = true;
                StateHasChanged();
                return;
