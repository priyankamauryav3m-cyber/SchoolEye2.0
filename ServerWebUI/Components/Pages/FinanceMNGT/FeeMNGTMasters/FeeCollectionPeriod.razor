    private string GetStatusClass(bool isActive)
    {
        return isActive ? "activeClr" : "inactiveClr";

    }
    private void FilterChangedAsync(int filterValue)
    {
        statusFilter = filterValue.ToString();
        StateHasChanged();
    }
    private async Task ChangeLateFeeConfigStatus(int id, bool isValid, long SessionId)
    {

        try
        {
            OpenSetletFeePopup = false;
            bool isActivate = !isValid;
            bool isConfirmed = await JS.InvokeAsync<bool>(isActivate ? "showActiveConfirm" : "showDeleteConfirm");
            if (!isConfirmed)
            {
                OpenSetletFeePopup = true;
                StateHasChanged();
                return;
            }
           
            activateModal.Lid = id;
            activateModal.CreatedBy = UserName;
            activateModal.Status = isValid ? 0 : 1;
            activateModal.SessionId = SessionId;
            string apiUrl = "FeeCollectionPeriodConfig/ActivateDeactivateLateFeeConfig";
            var apiResponse = await httpService.Post<ApiResponse<object>>(apiUrl, activateModal);
            if (apiResponse.Success)
            {
                if (isActivate)
                {
                    await Alert.ShowActive(Localizer["Activated"]);
                    OpenSetletFeePopup = true;
                }

                else
                {
                    await Alert.ShowDeactive(Localizer["Deleted"]);
                    OpenSetletFeePopup = true;
                }


                await SearchLateFeeConfig();
                StateHasChanged();
            }
            else
            {
                await Alert.ShowCustomAlert(@Localizer["Admin"]);
            }
        }
        catch (Exception ex)
        {
            await Alert.ShowError($"{Localizer["Error"]}: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
            await LoadData();
        }
    }

    private async Task ChangeFeePeriodStatus(int id, bool isValid)
    {
        try
        {
            bool isActivate = !isValid;
            bool isConfirmed = await JS.InvokeAsync<bool>(isActivate ? "showActiveConfirm" : "showDeleteConfirm");
            if (!isConfirmed)
                return;

            string apiUrl = "FeeCollectionPeriodConfig/DeleteFeeCollection";

            var apiResponse = await httpService.Post<ApiResponse<object>>(apiUrl, id);

            if (apiResponse.Success)
            {
                if (isActivate)
                    await Alert.ShowActive(Localizer["Activated"]);
                else
                    await Alert.ShowDeactive(Localizer["Deleted"]);

                await LoadData();
                StateHasChanged();
            }
            else
            {
                await Alert.ShowCustomAlert(@Localizer["Admin"]);
            }
        }
        catch (Exception ex)
        {
            await Alert.ShowError($"{Localizer["Error"]}: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
            await LoadData();
        }
    }
