@page "/feeCollectionPeriod"
@using DomainModel.Admin
@using DomainModel.FinanceMNGT;
@using Microsoft.AspNetCore.Authorization
@using ServerWebUI.Components.Pages.CommonPages
@inject IHttpClientFactory ClientFactory
@using Microsoft.AspNetCore.Components.QuickGrid
@using System.Net
@using System.Text.Json
@inject IStringLocalizer<Resource> Localizer
@using MyApp.Common
@using System.Threading.Tasks
@inject IJSRuntime JS
@inject Shared.IHttpService httpService
@inject HttpClient Http
@inject SweetAlertService Alert
@rendermode InteractiveServer
@inject ICommonMethod _commonmethod
<style>
    .select-month thead tr:first-child th {
        min-width: 30px;
    }
</style>

<div class="main-container">
    <div class="row m-0 main-row">
        <div class="col-12 p-1">
            <div class="page-heading d-flex align-items-center justify-content-between">
                <p class="m-0 page-name px-1">Fee Collection Period </p>
                <div class="d-flex gap-2">
                    <div class="form-box">
                        <InputSelect @bind-Value="@CurrentSession" name="session" class="form-input">
                            <option value="0">-- Select Session --</option>
                            @foreach (var data in sessionlist.Where(x => x.IsValid == true))
                            {
                                <option value="@data.SessionId">@data.SessionName </option>
                            }
                        </InputSelect>
                    </div>
                    <div class="form-box">
                        <button class="ui fade op-1 animated button form-btn" @onclick="SearchFeeCollection" tabindex="0">
                            <div class="visible content">Search</div>
                            <div class="hidden content">
                                <i class="bi bi-search"></i>
                            </div>
                        </button>
                    </div>
                    <ActionButtonGroup CurrentUrl="@currentUrl" Add="AddFeePeriod" />

                </div>
            </div>
        </div>
        <div class="col-12 p-1">
            <div class="card">
                <div class="card-body table-card p-0 ">
                    <div class="quick-main">
                        <div class="grid-box-with-btn">
                            <QuickGrid Items="@FilteredItems" Class="table" Pagination="@pagination">
                                <TemplateColumn Title="" Align="Align.Center">
                                    <ChildContent>
                                        <div class="d-flex align-items-center justify-content-center">
                                            <input @bind="context.IsSelected" @onclick:stopPropagation="true" type="checkbox" />
                                        </div>
                                    </ChildContent>
                                </TemplateColumn>
                                <PropertyColumn Property="@(x => x.PeriodName)" Title="Period Name" Sortable="true" Align="Align.Left">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="Period Name..." />
                                        </div>
                                    </ColumnOptions>

                                </PropertyColumn>
                                <TemplateColumn Title="Period Type" Sortable="true" Align="Align.Left">
                                    <ChildContent>
                                        @(string.IsNullOrWhiteSpace(context.PeriodType) ? " " : context.PeriodType)
                                    </ChildContent>
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" @bind="nameFilter" @bind:event="oninput" placeholder="Period Type..." />
                                        </div>
                                    </ColumnOptions>
                                </TemplateColumn>

                                <PropertyColumn Property="@(x => x.NoOfMonth)" Title="No Of Month" Class="text-center" Align="Align.Center">

                                </PropertyColumn>

                                <TemplateColumn Title="Status" Align="Align.Center">
                                    <ColumnOptions>
                                        <div>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "2")" @onchange="() => FilterChangedAsync(2)" /> Both
                                            </label>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "1")" @onchange="() => FilterChangedAsync(1)" /> Active
                                            </label>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "0")" @onchange="() => FilterChangedAsync(0)" /> Inactive
                                            </label>
                                        </div>
                                    </ColumnOptions>
                                    <ChildContent>
                                        <span class="@GetStatusClass(context.IsValid == true)">

                                            @(context.IsValid == true ? "Active" : "Inactive")
                                        </span>
                                    </ChildContent>
                                </TemplateColumn>

                                <TemplateColumn Align="Align.Center" Title="Action">
                                    <ActionButtonGroup IsValid="context.IsValid" CurrentUrl="@currentUrl" OnEditClick=" () => EditFeeCollection(context)" OnStatusClick="() => ChangeFeePeriodStatus(context.PeriodId, context.IsValid)" />
                                </TemplateColumn>
                            </QuickGrid>

                        </div>
                        <div class="footer-pagination">
                            <div class="d-flex align-items-center">
                                <div class="welcome-text w-100">
                                    <Paginator State="@pagination" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 p-1">
            <div class="page-heading d-flex align-items-center justify-content-end gap-2">
                <button @onclick="SetLetFeeData" type="button" class="table-btn">
                    View Late Fee
                </button>
                <button @onclick="AddletFee" type="button" class="table-btn">
                    Set Late Fee
                </button>
            </div>
        </div>

    </div>

</div>



@if (OpenSetletFeePopup)
{
    <div class="custom-modal row m-0 align-items-center">
        <div class="col-12 col-sm-10 col-md-9 col-lg-11">
            <div class="modal-content clearfix main-popup">
                <div class="head-btn">
                    <h5 class="modal-title">Late Fee Configuration</h5>
                    <button data-access="Close" type="button" @onclick="ClosePopup" class="close"><span aria-hidden="true">×</span></button>
                </div>
                <div class="modal-body">

                    <div class="tab-content form-tab-count">
                        <div class="row gap-15-0 m-0 mt-3">

                            <div class="col-12 col-sm-6 col-md-4 px-2">
                                <div class="form-box">
                                    <label for="class" class="form-label"> &nbsp; </label>
                                    <div class="border-box d-flex justify-content-between align-items-center gap-2 px-2">
                                        <p class="form-label">Session : </p>
                                        <p class="form-label">@SelectSession</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-4 px-2">
                                <div class="form-box">
                                    <label for="class" class="form-label"> Period </label>
                                    <InputSelect @bind-Value="Searchletfeedata.PeriodId" autocomplete="off" class="form-input">
                                        <option value="0" selected>All</option>
                                        @foreach (var data in feeCollectionPeriodlist)
                                        {
                                            <option value="@data.PeriodId">@data.PeriodName</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-4 px-2">
                                <div class="form-box">
                                    <label for="class" class="form-label"> Class </label>
                                    <InputSelect @bind-Value="Searchletfeedata.ClassCode" autocomplete="off" class="form-input">
                                        <option value="" selected>All</option>
                                        @foreach (var data in classlist.Where(x => x.IsValid == true))
                                        {
                                            <option value="@data.ClassCode">@data.ClassName</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-4 px-2">
                                <div class="form-box">
                                    <label for="remarks" class="form-label"> Penalty Type </label>
                                    <InputSelect @bind-Value="Searchletfeedata.PenaltyType" autocomplete="off" class="form-input">
                                        <option value="" selected>All</option>
                                        <option value="1">Per Day</option>
                                        <option value="2">Date Range+Per Day</option>
                                    </InputSelect>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-2 px-2">
                                <div class="form-box">
                                    <label for="remarks" class="form-label">&nbsp;</label>
                                    <button class="ui fade op-1 animated button form-btn" @onclick="SearchLateFeeConfig" tabindex="0">
                                        <div class="visible content">Search</div>
                                        <div class="hidden content">
                                            <i class="bi bi-search"></i>
                                        </div>
                                    </button>
                                </div>
                            </div>

                        </div>

                        <div class="col-12 p-1">
                            <div class="card">
                                <div class="card-body table-card p-0 ">
                                    <div class="quick-main">
                                        <div class="overflow-auto scrollbar-thin" style="height: calc(100vh - 350px); min-height: 300px;">
                                            <QuickGrid Items="@Getletfeequiery" Class="table" Pagination="@pagination">

                                                <PropertyColumn Property="@(x => x.PeriodName)" Title="Period Name" Sortable="true" Align="Align.Left">
                                                    <ColumnOptions>
                                                        <div class="search-box">
                                                            <input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="Period Name..." />
                                                        </div>
                                                    </ColumnOptions>

                                                </PropertyColumn>
                                                <TemplateColumn Title="Class Name" Align="Align.Left">
                                                    <ChildContent>
                                                        @(string.IsNullOrWhiteSpace(context.ClassName) ? " " : context.ClassName)
                                                    </ChildContent>

                                                </TemplateColumn>
                                                <PropertyColumn Format="dd/MM/yyyy" Property="@(x => x.StartDate)" Class="text-center" Align="Align.Center" Title="Start Date">

                                                </PropertyColumn>
                                                <PropertyColumn Format="dd/MM/yyyy" Property="@(x => x.EndDate)" Class="text-center" Align="Align.Center" Title="End Date">

                                                </PropertyColumn>

                                                <PropertyColumn Property="@(x => x.Amount)" Class="text-right" Align="Align.Center" Title=" Late Fine">

                                                </PropertyColumn>
                                                <PropertyColumn Property="@(x => x.MaxLimit)" Class="text-right" Align="Align.Center" Title="Max Late Fee">

                                                </PropertyColumn>
                                                <TemplateColumn Title="Status" Align="Align.Center">
                                                    <ColumnOptions>
                                                        <div>
                                                            <label>
                                                                <input type="radio" checked="@(statusFilter == "2")" name="status" @onchange="() => FilterChangedAsync(2)" /> Both
                                                            </label>
                                                            <label>
                                                                <input type="radio" checked="@(statusFilter == "1")" name="status" @onchange="() => FilterChangedAsync(1)" /> Active
                                                            </label>
                                                            <label>
                                                                <input type="radio" checked="@(statusFilter == "0")" name="status" @onchange="() => FilterChangedAsync(0)" /> Inactive
                                                            </label>
                                                        </div>
                                                    </ColumnOptions>
                                                    <ChildContent>
                                                        <span class="@GetStatusClass(context.IsValid == true)">

                                                            @(context.IsValid == true ? "Active" : "Inactive")
                                                        </span>
                                                    </ChildContent>
                                                </TemplateColumn>

                                                <TemplateColumn Align="Align.Center" Title="Action">
                                                    <ActionButtonGroup IsValid="context.IsValid" CurrentUrl="@currentUrl" OnEditClick="() => EditLateFeeConfig(context)" OnStatusClick="() => ChangeLateFeeConfigStatus(context.Lid, context.IsValid, context.SessionId)" />
                                                </TemplateColumn>
                                            </QuickGrid>

                                        </div>
                                        <div class="footer-pagination">
                                            <div class="d-flex align-items-center">
                                                <div class="welcome-text w-100">
                                                    <Paginator State="@pagination" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                </div>

            </div>
        </div>
    </div>
    @if (OpenEditPopup)
    {
        <div class="custom-modal row m-0 align-items-center">
            <div class="col-12 col-sm-7 col-md-5 col-lg-4 col-xl-7">
                <div class="modal-content clearfix main-popup">
                    <div class="head-btn">
                        <h5 class="modal-title">Modify Late Fine Configuration</h5>
                        <button data-access="Close" type="button" @onclick="ClosePopup1" class="close"><span aria-hidden="true">×</span></button>
                    </div>
                    <div class="modal-body">
                        <div class="row gap-15-0 m-0">
                            <div class="col-12 col-sm-6  px-2">
                                <div class="form-box">
                                    <label for="class" class="form-label"> &nbsp; </label>
                                    <div class="border-box d-flex justify-content-between align-items-center gap-2 px-2">
                                        <p class="form-label">Session : </p>
                                        <p class="form-label">@lateFeeConfig.SessionName</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6  px-2">
                                <div class="form-box">
                                    <label for="class" class="form-label"> &nbsp; </label>
                                    <div class="border-box d-flex justify-content-between align-items-center gap-2 px-2">
                                        <p class="form-label">Period Name : </p>
                                        <p class="form-label">@lateFeeConfig.PeriodName</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6  px-2">
                                <div class="form-box">
                                    <label for="class" class="form-label"> &nbsp; </label>
                                    <div class="border-box d-flex justify-content-between align-items-center gap-2 px-2">
                                        <p class="form-label">Class Name : </p>
                                        <p class="form-label">@lateFeeConfig.ClassName</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 px-2">
                                <div class="form-box-group">
                                    <InputDate class="floating-input" placeholder=" " @bind-Value="lateFeeConfig.StartDate" autocomplete="off" />
                                    <label class="floating-label">Start Date</label>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 px-2">
                                <div class="form-box-group">
                                    <InputDate class="floating-input" placeholder=" " @bind-Value="lateFeeConfig.EndDate" autocomplete="off" />
                                    <label class="floating-label">End Date</label>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 px-2">
                                <div class="form-box-group">
                                    <InputNumber class="floating-input" placeholder=" " @bind-Value="lateFeeConfig.Amount" autocomplete="off" />
                                    <label class="floating-label">Late Fee Amount</label>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <div class="form-group btn-gr">
                                <button type="button" class="ui fade op-1 animated button form-btn" @onclick="UpdateLetFeeConfig">
                                    <div class="visible content">Update</div>
                                    <div class="hidden content">
                                        <i class="bi bi-cloud-check"></i>
                                    </div>
                                </button>
                                <SaveUpdateButton ShowSaveButton="false" OnClickCancel="ClosePopup1" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }


}


@if (OpenAddLetFeePopup)
{
    <div class="custom-modal row m-0 align-items-center">
        <div class="col-12 col-sm-7 col-md-5 col-lg-4 col-xl-10">
            <div class="modal-content clearfix main-popup">
                <div class="head-btn">
                    <h5 class="modal-title">Add Late Fee With Class</h5>
                    <button data-access="Close" type="button" @onclick="ClosePopup1" class="close"><span aria-hidden="true">×</span></button>
                </div>
                <div class="overflow-auto" style="height: calc(128vh - 280px); min-height: 400px;">
                    <div class="modal-body">
                        <div class="tab-content form-tab-count">
                            <EditForm Model="@feeConfigration" OnValidSubmit="OnSaveLetFeeConfiguration">
                                <DataAnnotationsValidator />
                                <div class="row gap-15-0 m-0 mt-2">
                                    <div class="col-12 col-sm-6 col-md-4 px-2">
                                        <div class="form-box">
                                            <label for="remarks" class="form-label"> &nbsp;</label>

                                            <div class="border-box d-flex justify-content-between align-items-center gap-2 px-2">
                                                <p class="form-label">Session : </p>
                                                <p class="form-label">@SelectSession</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6 col-md-4 px-2">
                                        <div class="form-box">
                                            <label for="remarks" class="form-label"> &nbsp;</label>

                                            <div class="border-box d-flex justify-content-between align-items-center gap-2 px-2">
                                                <p class="form-label">Period Name : </p>
                                                <p class="form-label">@SelectPeriodName</p>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12 col-sm-6 col-md-4 px-2">
                                        <div class="form-box-group">
                                            <InputNumber class="floating-input" placeholder=" " @bind-Value="@feeConfigration.Amount" autocomplete="off" required />
                                            <label class="floating-label">Late Fee Amount</label>
                                        </div>
                                        <ValidationMessage For="@(() => feeConfigration.Amount)" />
                                    </div>
                                    <div class="col-12 col-sm-6 col-md-4 px-2">
                                        <div class="form-box-group">
                                            <InputDate class="floating-input" placeholder=" " @bind-Value="@feeConfigration.StartDate" autocomplete="off" required />
                                            <label class="floating-label">Start Date</label>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6 col-md-4 px-2">
                                        <div class="form-box-group">
                                            <InputDate class="floating-input" placeholder=" " @bind-Value="@feeConfigration.EndDate" autocomplete="off" required />
                                            <label class="floating-label">End Date</label>
                                        </div>
                                    </div>


                                    <div class="col-12 col-sm-6 col-md-4 px-2">
                                        <div class="form-box-group">
                                            <InputNumber class="floating-input" placeholder=" " @bind-Value="@feeConfigration.MaxAmount" autocomplete="off" required />
                                            <label class="floating-label">Max Late Fee</label>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6 col-md-4 col-lg-8 px-2">
                                        <div class="form-box">
                                            <label for="status" class="form-label">Penalty Type</label>
                                            <div class="border-box d-flex justify-content-center align-items-center gap-3">
                                                <InputRadioGroup @bind-Value="feeConfigration.PenaltyType">

                                                    <div class="d-flex align-items-center gap-1">
                                                        <InputRadio Value="@("1")" />
                                                        <label class="form-label">
                                                            Per Day
                                                        </label>
                                                    </div>
                                                    <div class="d-flex align-items-center gap-1">
                                                        <InputRadio Value="@("2")" />
                                                        <label class="form-label">
                                                            Date Range + Per Day
                                                        </label>
                                                    </div>
                                                </InputRadioGroup>

                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6 col-md-2 px-1">
                                        <div class="form-box">
                                            <label for="remarks" class="form-label">&nbsp;</label>
                                            <button type="submit" class="ui fade op-1 animated button form-btn">
                                                <div class="visible content">Save</div>
                                                <div class="hidden content">
                                                    <i class="bi bi-plus"></i>
                                                </div>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </EditForm>
                            <div class="col-12 p-1">
                                <div class="card">
                                    <div class="card-body table-card p-0 ">
                                        <div class="quick-main">
                                            <div class="overflow-auto scrollbar-thin" style="height: calc(100vh - 350px); min-height: 300px;">
                                                <QuickGrid Items="@getAllClasslist.AsQueryable()" Class="table" Pagination="@pagination">
                                                    <TemplateColumn Title="" Align="Align.Center">
                                                        <HeaderTemplate>
                                                            <div class="d-flex align-items-center justify-content-center">
                                                                <input @onchange="ToggleSelectAll" checked="@isAllSelected" type="checkbox" />
                                                            </div>
                                                        </HeaderTemplate>
                                                        <ChildContent>
                                                            <div class="d-flex align-items-center justify-content-center">
                                                                <input @bind="context.IsSelected" @onclick:stopPropagation="true" disabled="@(context.IsMapped > 0)" type="checkbox" />
                                                            </div>
                                                        </ChildContent>
                                                    </TemplateColumn>
                                                    <TemplateColumn Title="Class Name" Align="Align.Left">
                                                        <ChildContent>
                                                            @(string.IsNullOrWhiteSpace(context.ClassName) ? " " : context.ClassName)
                                                        </ChildContent>

                                                    </TemplateColumn>
                                                    <PropertyColumn Property="@(x => x.Amount)" Class="text-right" Align="Align.Center" Title=" Late Fine">

                                                    </PropertyColumn>
                                                    <TemplateColumn Title="Order" class="text-center" Align="Align.Center">
                                                        <ChildContent>
                                                            @(string.IsNullOrWhiteSpace(context.ClassOrder) ? " " : context.ClassOrder)
                                                        </ChildContent>

                                                    </TemplateColumn>
                                                </QuickGrid>

                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>


                    </div>

                </div>
            </div>
        </div>
    </div>
}


@if (ShowPopup)
{

    <div class="custom-modal row m-0 align-items-center">
        <div class="col-12 col-sm-7 col-md-5 col-lg-4 col-xl-8">
            <div class="modal-content clearfix main-popup">
                <div class="head-btn">
                    <h5 class="modal-title">@((feeCollectionPeriod.PeriodId == 0) ? "Add Fee Collection Period" : "Edit Fee Collection Period")</h5>
                    <button data-access="Close" type="button" @onclick="ClosePopup" class="close"><span aria-hidden="true">×</span></button>
                </div>

                <div class="modal-body pb-0">
                    <div class="row gap-10-0 d-flex">
                        <div class="col-12 col-sm-6 col-md-4 col-lg-6 px-2 mt-2">

                            <div class="card">
                                <div class="card-body table-card p-0">
                                    <div class="quick-main">
                                        <QuickGrid Items="@monthmappinglist.Where(x => x.IsValid == true).AsQueryable()" Class="table select-month" Pagination="@pagination">
                                            <TemplateColumn Align="Align.Center" Title=" ">
                                                <ChildContent>
                                                    <div class="d-flex align-items-center justify-content-center">
                                                        <input type="checkbox" @bind="context.IsSelected" @bind:after="(() => OnMonthChanged(context))" disabled="@(context.IsMapped == 1)"
                                                               @onclick:stopPropagation="true" />
                                                    </div>
                                                </ChildContent>
                                            </TemplateColumn>
                                            <PropertyColumn Property="@(x => x.MonthName)" Title="Month Name" Align="Align.Left" />
                                        </QuickGrid>

                                    </div>
                                </div>
                            </div>

                        </div>

                        <div class="col-12 col-sm-6 col-md-4 col-lg-6 px-2 mt-2">
                            <EditForm Model="@feeCollectionPeriod" OnValidSubmit="OnSave">
                                <div class="card">
                                    <div class="card-body table-card ">
                                        <DataAnnotationsValidator />
                                        <div class="row gap-10-0">
                                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                                <div class="form-box-group static-label">
                                                    <InputSelect class="floating-input" placeholder=" " @bind-Value="@CurrentSession" name="session" @bind-Value:after="GetMappingMonth">
                                                        <option value="0" hidden=""></option>
                                                        @foreach (var data in sessionlist.Where(x => x.IsValid == true))
                                                        {
                                                            <option value="@data.SessionId">@data.SessionName </option>
                                                        }
                                                    </InputSelect>
                                                    <label class="floating-label">
                                                        Session Name
                                                    </label>
                                                    <ValidationMessage For="@(() => feeCollectionPeriod.SessionName)" />
                                                </div>
                                            </div>
                                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2 mt-2">
                                                <div class="form-box-group static-label">
                                                    <InputSelect class="floating-input" placeholder=" " @bind-Value="feeCollectionPeriod.PeriodType" disabled="@(feeCollectionPeriod.PeriodId > 0)" @bind-Value:after="OnPeriodTypeChanged">
                                                        <option  value="" selected >--Select--</option>
                                                        @foreach (var data in PeriodTypeList)
                                                        {
                                                            <option value="@data.PeriodTypeName">@data.PeriodTypeName</option>
                                                        }
                                                    </InputSelect>
                                                    <label class="floating-label">
                                                        Period Type <span class="required">*</span>
                                                    </label>
                                                    <ValidationMessage For="@(() => feeCollectionPeriod.PeriodType)" />
                                                </div>
                                            </div>

                                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2 mt-2">
                                                <div class="form-box-group">
                                                    <InputText class="floating-input" placeholder=" " @bind-Value="feeCollectionPeriod.PeriodName" autocomplete="off" />
                                                    <label class="floating-label">
                                                        Period Name <span class="required">*</span>
