            var data = FilteredItems?.Where(x => x.IsSelected).Select(x => x.PeriodId).FirstOrDefault();

            feeConfigration.GroupCode = groupcode;
            feeConfigration.BranchCode = branchcode;
            feeConfigration.CreatedBy = UserName;
            feeConfigration.SessionId = CurrentSession;
            feeConfigration.PeriodId = data.Value;
            feeConfigration.ClassCode = classdata;
            string apiUrl = "FeeCollectionPeriodConfig/AddLateFeeConfigration";
            var apiResponse = await httpService.Post<ApiResponse<object>>(apiUrl, feeConfigration);
            if (apiResponse.Success)
            {
                if (apiResponse.Code == 0)
                {
                    await Alert.ShowWarning("Late fee" + @Localizer["Already"]);
                }
                else if (apiResponse.Code == 1)
                {
                    await Alert.ShowSuccess("Late fee" + @Localizer["Inserted"]);
                }
                else if (apiResponse.Code == 2)
                {
                    await Alert.ShowUpdate("Late fee" + @Localizer["Updated"]);
                }
                else
                {
                    await Alert.ShowCustomAlert(@Localizer["Admin"]);
                }
                data = 0;
                classdata = "";
                feeConfigration = new();
            }
        }
        catch (Exception ex)
        {
            await Alert.ShowError($"{@Localizer["Error"]}: {ex.Message}");
        }
        finally
        {

            StateHasChanged();
        }
    }
