    private void OnMonthChanged(FeeCollectionMonthMappingModel month)
    {
        if (_disposed) return;

        if (feeCollectionPeriod.PeriodType != "Quarterly")
            return;

        if (month.IsSelected)
        {
            var sortedMonths = monthmappinglist.OrderBy(x => x.MonthIndex).Where(x => x.IsValid = true).ToList();
            int currentIndex = sortedMonths.IndexOf(month);

            foreach (var m in sortedMonths)
            {
                int idx = sortedMonths.IndexOf(m);

                if (idx >= currentIndex && idx < currentIndex + 3)
                {
                    m.IsSelected = true;
                    m.IsDisabled = false;
                }
                else
                {
                    m.IsSelected = false;
                    m.IsDisabled = true;
                }
            }
        }
        else
        {
            if (!monthlist.Any(x => x.IsSelected))
            {
                foreach (var m in monthlist)
                {
                    m.IsDisabled = false;
                }
            }
        }

        InvokeAsync(StateHasChanged);
    }
    private async Task OnPeriodTypeChanged()
    {
        await GetMappingMonth();
        if (_disposed) return;

        if (feeCollectionPeriod.PeriodType == "Monthly")
        {
            foreach (var m in monthlist)
                m.IsDisabled = false;

            _quarterStartMonth = null;
        }
        else
        {
            ResetMonths();
        }
        InvokeAsync(StateHasChanged);
    }
    private void ResetMonths()
