                await customAlert.ShowCustomAlert("Please select student first !", false);
                return;
            }
            feeHeadToStudent.InvoiceId = selecteddata.InvoiceId;
            feeHeadToStudent.StudentId = data.StudentId;
            feeHeadToStudent.HeadId = selecteddata.FeeHeadId;
            feeHeadToStudent.CreatedBy = UserName;
            feeHeadToStudent.Narration1 = "";
            feeHeadToStudent.SelectMonthNo = selecteddata.MonthNo;
            InvoiceEdit = false;
            ShowPopupAddFeehead = false;
            var response = await httpService.Post<ApiResponse<object>>("StudentFeeInvoice/RemoveFeeHeadToStudentChallan", feeHeadToStudent);
            if (response.Success && response.Code == 1)
            {
                await Alert.ShowSuccess("Fee head removed successfully.");
                await OpenStudentInvoicePreviewAndEdit();
                InvoiceEdit = true;
                StateHasChanged();
                feeHeadToStudent = new();
                IsLoading = false;
            }
        }
        catch (Exception ex)
        {

            return;
        }
        finally
        {
            StateHasChanged();
            IsLoading = false;
        }

    }
    private async Task OnSaveFeeHeadAmount()
    {
        try
        {

            IsLoading = true;

            var data = moduleQuery.Where(x => x.IsSelected).Select(x => new { x.StudentId, x.InvoiceId }).FirstOrDefault();
            if (data == null)
            {
                InvoiceEdit = false;
                ShowPopupAddFeehead = false;
                await customAlert.ShowCustomAlert("Please select student first !", false);
                return;
            }
            feeHeadToStudent.InvoiceId = data.InvoiceId;
            feeHeadToStudent.StudentId = data.StudentId;
            feeHeadToStudent.HeadId = SelectedFeeHeadId;
            feeHeadToStudent.HeadAmount = SelectedFeeHeadAmount;
            feeHeadToStudent.CreatedBy = UserName;
            feeHeadToStudent.Narration1 = "";
            feeHeadToStudent.MonthNo = MonthList.Where(x => x.IsSelected && !x.IsDisabled).Select(x => x.MonthNo).ToList();
            if (feeHeadToStudent.HeadId == 0)
            {
                await customAlert.ShowCustomAlert("Please select fee head name !", false);
                return;
            }
            InvoiceEdit = false;
            ShowPopupAddFeehead = false;
            var response = await httpService.Post<ApiResponse<object>>("StudentFeeInvoice/AddFeeHeadToStudentChallan", feeHeadToStudent);
            if (response.Success && response.Code == 1)
            {
                await Alert.ShowSuccess("Feehead added sucessfully.");
                await OpenStudentInvoicePreviewAndEdit();
                await OnFeeHeadChanged();
                InvoiceEdit = true;
                StateHasChanged();
                feeHeadToStudent = new();
                IsLoading = false;
            }
        }
        catch (Exception ex)
        {

            return;
        }
        finally
        {
            StateHasChanged();
            IsLoading = false;
        }
        //feeHeadToStudent.MonthNo = string.Join(",", MonthList.Where(x => x.IsSelected && !x.IsDisabled).Select(x => x.MonthNo));

    }
    private async Task AddNewFeeHeadWithAmout()
    {
        try
        {
            searchAny.GroupCode = groupcode;
            searchAny.BranchCode = branchcode;
            searchAny.SessionId = CurrentSession;
            var response = await httpService.Post<ApiResponse<List<FeeHeadDropdownModel>>>("StudentFeeInvoice/GetFeeHeadWithAmount", searchAny);
            if (response.Data.Count != 0 && response.Success)
            {
                feeHeadDropdownlist = response.Data ?? new();
                StateHasChanged();
            }
            var data = moduleQuery.Where(x => x.IsSelected).Select(x => x.StudentId).FirstOrDefault();
            if (data == 0)
            {
                InvoiceEdit = false;
                ShowPopupUpdateDueDate = false;
                await customAlert.ShowCustomAlert("Please select student first !", false);
                return;
            }
            searchAny.StudentId = data;
            searchAny.SessionId = CurrentSession;
            var apiResponse = await httpService.Post<ApiResponse<List<TransportSelectMonthModel>>>("StudentFeeInvoice/GetTransportMonthWithStudent", searchAny);
            if (apiResponse.Data.Count != 0 && apiResponse.Success)
            {
                transportSelectMonthlist = apiResponse.Data ?? new();
                StateHasChanged();
            }
            ShowPopupAddFeehead = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {

            return;
        }
        finally
        {
            StateHasChanged();
            IsLoading = false;
        }
    }
    private async Task UpdateDueDate()
    {

        try
        {
            IsLoading = true;

            var data = moduleQuery.Where(x => x.IsSelected).Select(x => x.InvoiceId).FirstOrDefault();
            if (data == 0)
            {
                InvoiceEdit = false;
                ShowPopupUpdateDueDate = false;
                await customAlert.ShowCustomAlert("Please select student first !", false);
                return;
            }

            challanDueDate.GroupCode = groupcode;
            challanDueDate.BranchCode = branchcode;
            challanDueDate.UpdatedBy = UserName;
            challanDueDate.InvoiceId = data;
            InvoiceEdit = false;
            ShowPopupUpdateDueDate = false;
            var response = await httpService.Post<ApiResponse<object>>("StudentFeeInvoice/StudentUpdateInvoiceDue", challanDueDate);
            if (response.Code == 1 && response.Success)
            {
                await Alert.ShowSuccess("Invoice due date has been updated successfully..");
                // searchAny.RequestName= challanDueDate.InvoiceId.ToString();
                await OpenStudentInvoicePreviewAndEdit();
                InvoiceEdit = true;
                StateHasChanged();
                challanDueDate = new();
                IsLoading = false;
            }
            IsLoading = false;

        }
        catch (Exception ex)
        {

            return;
        }
        finally
        {
            StateHasChanged();
            IsLoading = false;
        }
    }
}




@if (InvoicePreview)
