@page "/invoicegeneration"
@using DomainModel.Admin
@using DomainModel.SchoolMaster
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyApp.Common
@using System.Data;
@using ServerWebUI.Components.Pages.CommonPages
@inject Shared.IHttpService httpService
@inject IJSRuntime JSs
@inject HttpClient Http
@inject IStringLocalizer<Resource> Localizer
@inject SweetAlertService Alert
@rendermode InteractiveServer
@inject IHttpClientFactory ClientFactory
@inject ICommonMethod _commonmethod
@inject IJSRuntime JS

<style>

    .sms-aria {
        height: 64px;
    }

    .profile-photo {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #e5e7eb;
        background: #fff;
    }

    .field-title {
        font-weight: 500;
        color: #1f2937;
    }

    .field-value {
        color: #6b7280;
        font-weight: 500;
    }


    .border-column {
        border-right: 2px solid #ccc;
        min-height: 40px;
        display: flex;
        align-items: center;
        padding-left: 40px;
    }

 
    #splitter {
        width: 8px;
        cursor: col-resize;
        background: #e5e7eb;
        transition: .2s;
    }

        #splitter:hover {
            background: #2563eb;
        }

</style>
<div class="main-container">
    <div class="row m-0 main-row">
        <div class="col-12 p-1" id="main-header">
            <div class="page-heading d-flex align-items-center justify-content-between">
                <h1 class="m-0 page-name px-1"><strong>View Invoice Dues</strong> </h1>
                <div class="d-flex align-items-center gap-2">
                    <div class="form-box">
                        <select class="form-input">
                            @foreach (var data in societyModellist.Where(x => x.IsValid == true))
                            {
                                <option value="@data.SocietyId">@data.SocietyName</option>
                            }
                        </select>
                    </div>
                    <div class="form-box">
                        <InputSelect @bind-Value="CurrentSession" name="session" class="form-input">
                            <option value="0">-- Select Session --</option>
                            @foreach (var data in sessionlist.Where(x => x.IsValid == true))
                            {
                                <option value="@data.SessionId">@data.SessionName </option>
                            }
                        </InputSelect>
                    </div>
                    <div class="form-box">
                        <div class="d-flex gap-2">
                            <button class="icon-btn icon-btn-white open-popup " @onclick="OpenSearch" data-id="popup" tabindex="0">
                                <i class="bi bi-sliders"></i>
                            </button>
                        </div>
                    </div>
                    <div class="form-box">
                        <button class="ui fade op-1 animated button form-btn" type="button" tabindex="0" @onclick="SearchStudentAdvamceData">
                            <div class="visible content">Search</div>
                            <div class="hidden content">
                                <i class="bi bi-search"></i>
                            </div>
                        </button>
                    </div>
                </div>

            </div>
        </div>

        <div class="col-12 p-1">
            <div class="split-container" id="splitContainer">
                <div class="grid-pane" id="gridPane">
                    <div class="card">
                        <div class="card-body table-card p-0">
                            <div class="quick-main">
                                <div class="grid-box-with-btn ">
                                    <QuickGrid Items="@moduleQuery" Pagination="@pagination" Class="table">
                                        <TemplateColumn Title="" class="text-center" Align="Align.Center">
                                            <HeaderTemplate>
                                                <div>
                                                    <input type="checkbox" @bind="IsAllSelected" @bind:after="ToggleAll" @onclick:stopPropagation="true" />
                                                </div>
                                            </HeaderTemplate>
                                            <ChildContent>
                                                <div>
                                                    <input type="checkbox" @bind="context.IsSelected" @onclick:stopPropagation="true" />
                                                </div>
                                            </ChildContent>
                                        </TemplateColumn>
                                        <TemplateColumn Title="Admission No" Align="Align.Center" Class="text-center" Sortable="true" SortBy="GridSort<SearchStudentBalanceDto>.ByAscending(x => x.AdmissionNo)">
                                            <ColumnOptions>
                                                <div class="search-box">
                                                    <input type="search" @bind="nameFilter" @bind:event="oninput" placeholder="Admission No...." />
                                                </div>
                                            </ColumnOptions>
                                            <ChildContent>
                                                @(string.IsNullOrEmpty(context.AdmissionNo) ? " " : context.AdmissionNo)

                                            </ChildContent>
                                        </TemplateColumn>
                                        <TemplateColumn Title="Student Name" Sortable="true" SortBy="GridSort<SearchStudentBalanceDto>.ByAscending(x => x.StudentName)" Align="Align.Left">
                                            <ColumnOptions>
                                                <div class="search-box">
                                                    <input type="search" @bind="nameFilter" @bind:event="oninput" placeholder="Student Name...." />
                                                </div>
                                            </ColumnOptions>
                                            <ChildContent>
                                                @(string.IsNullOrEmpty(context.StudentName) ? " " : context.StudentName)
                                            </ChildContent>
                                        </TemplateColumn>

                                        <TemplateColumn Title="Class" Sortable="true" SortBy="GridSort<SearchStudentBalanceDto>.ByAscending(x => x.ClassSection)" Align="Align.Left">
                                            <ChildContent>
                                                <div>
                                                    @(string.IsNullOrEmpty(context.ClassSection) ? " " : context.ClassSection)
                                                </div>
                                            </ChildContent>
                                        </TemplateColumn>
                                        <TemplateColumn Title="Fee Structure" Sortable="true" SortBy="GridSort<SearchStudentBalanceDto>.ByAscending(x => x.TemplateName)" Align="Align.Left">
                                            <ChildContent>
                                                <div>
                                                    @(string.IsNullOrEmpty(context.TemplateName) ? " " : context.TemplateName)
                                                </div>
                                            </ChildContent>
                                        </TemplateColumn>
                                        <TemplateColumn Title="Amount" Class="text-right" Align="Align.Center">
                                            <span>₹ @context.TotalAmount.ToString("N0")</span>
                                        </TemplateColumn>

                                    </QuickGrid>

                                </div>
                                <div class="footer-pagination">
                                    <div class="d-flex align-items-center">
                                        <div class="welcome-text w-100">
                                            <Paginator State="@pagination" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="splitter" id="gridSplitter" title="Drag to resize"></div>

                <div class="summary-pane" id="summaryPane">
                    <div class="card summary-card">
                        <div class="summary-card-title">
                            <span>Invoice Summary</span>
                            <button type="button" class="pin-btn" id="summaryPinBtn" title="Hide summary">
                                <i class="bi bi-pin-angle-fill"></i>
                            </button>
                        </div>
                        <div class="summary-line">
                            <div class="summary-line-label"><i class="fa-solid fa-wallet text-blue"></i><span class="fw-bold">Total Amount</span></div>
                            <div class="summary-line-value text-blue">₹ @TotalAmount.ToString("N2")</div>
                        </div>
                        <div class="summary-line">
                            <div class="summary-line-label"><i class="fa-solid fa-percent text-green"></i><span class="fw-bold">Total Concession</span></div>
                            <div class="summary-line-value text-green">₹ @TotalConcession.ToString("N2")</div>
                        </div>
                        <div class="summary-line">
                            <div class="summary-line-label"><i class="fa-solid fa-clock-rotate-left text-orange"></i><span class="fw-bold">Total Arrear</span></div>
                            <div class="summary-line-value text-orange">₹ @TotalArrearAmount.ToString("N2")</div>
                        </div>
                        <div class="summary-received">
                            <span class="lab">Total Received</span>
                            <span class="val">₹ @TotalReceivedAmount.ToString("N2")</span>
                        </div>
                    </div>
                </div>

                <button type="button" class="summary-restore-btn" id="summaryRestoreBtn" title="Show summary">
                    <i class="bi bi-pin-angle"></i>
                </button>
            </div>
        </div>

        <div class="col-12 p-1">
            <div class="page-heading d-flex align-items-center justify-content-end">
                <div class="d-flex align-items-center gap-2">
                    <div class="form-box">
                        <button type="button" class="table-btn" @onclick="OpenStudentInvoicePreview">
                            Generation Priview
                        </button>
                    </div>
                    <div class="form-box">
                        <button type="button" class="table-btn" @onclick="OpenStudentInvoicePreviewAndEdit">
                            Edit Invoice
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>


@if (ShowPopup)
{
    <div class="custom-modal row m-0">
        <div class="col-12 col-sm-7 col-md-5 col-lg-4 col-xl-9">
            <div class="modal-content clearfix main-popup ">
                <div class="head-btn">
                    <h5 class="modal-title">Generate Student Fee Invoice</h5>
                    <button data-access="Close" type="button" @onclick="ClosePopup" class="close"><span aria-hidden="true">×</span></button>
                </div>
                    <div class="modal-body">
                        <div class="row gap-10-0">
                            <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                                <div class="form-box">
                                    <label for="first-name" class="form-label">Class</label>
                                    <div class="position-relative">
                                        <button class="form-input w-webkit" type="button" data-bs-toggle="dropdown">
                                            @SelectedText
                                        </button>
                                        <div class="dropdown-menu cu-dropdown" style="max-height:350px; overflow-y:auto; align-items:center; align-content:center; scrollbar-width: thin;">

                                            <div class="form-check">
                                                <input class="form-check-input map-checkbox" type="checkbox" @bind="SelectAll" @bind:after="OnClassAllChanged" />

                                                <span>All</span>
                                            </div>

                                            @foreach (var item in classlist)
                                            {
                                                <div class="form-check">

                                                    <input class="form-check-input map-checkbox" type="checkbox" @bind="item.IsSelected" @bind:after="GetSectionData" />
                                                    <span>@item.ClassName</span>

                                                </div>
                                            }

                                        </div>
                                    </div>
                                </div>

                            </div>
                            <div class="col-12 col-sm-6 col-md-4 col-lg-4">

                                <div class="form-box">
                                    <label for="first-name" class="form-label">Section</label>
                                    <div class="position-relative">
                                        <button class="form-input w-webkit" type="button" data-bs-toggle="dropdown">
                                            @SelectedSectionText
                                        </button>

                                        <div class="dropdown-menu cu-dropdown" style="max-height:350px; overflow-y:auto; align-items:center; align-content:center; scrollbar-width: thin;">

                                            <div class="form-check">

                                                <input class="form-check-input map-checkbox" type="checkbox" @bind="SelectAllSection" @bind:after="ToggleSelectAllSection" />

                                                <span>All</span>

                                            </div>

                                            @foreach (var item in sectionModellist)
                                            {
                                                <div class="form-check">

                                                    <input class="form-check-input map-checkbox"
                                                           type="checkbox"
                                                           @bind="item.IsSelected" />

                                                    <span>@item.SectionName</span>

                                                </div>
                                            }

                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                                <div class="form-box-group static-label">
                                    <InputSelect class="floating-input" placeholder=" " @bind-Value="searchModel.PeriodType" @bind-Value:after="OnPeriodTypeChanged">
                                        <option  value="" selected>--Select--</option>
                                        @foreach (var data in PeriodTypeList)
                                        {
                                            <option value="@data.PeriodTypeName">@data.PeriodTypeName</option>
                                        }
                                    </InputSelect>
                                    <label class="floating-label">Period Type</label>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                                <div class="form-box-group static-label">
                                    <InputSelect class="floating-input" placeholder=" " @bind-Value="searchModel.PeriodId">
                                        <option  value="" selected>--Select--</option>
                                        @foreach (var data in feeCollectionPeriodlist)
                                        {
                                            <option value="@data.PeriodId">@data.PeriodName</option>
                                        }
                                    </InputSelect>
                                    <label class="floating-label">Period</label>
                                </div>
                            </div>

                            <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                                <div class="form-box-group">
                                    <InputText class="floating-input" placeholder=" " @bind-Value="searchModel.StudentNo" autocomplete="off" />
                                    <label class="floating-label">Student No.</label>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                                <div class="form-box-group static-label">
                                    <InputSelect class="floating-input" placeholder=" " @bind-Value="@searchModel.InvType">
                                        <option  value="" selected>--Select--</option>
                                        @foreach (var data in InvoiceTypelist)
                                        {
                                            <option value="@data.InvoiceTypeId"> @data.InvoiceTypeName </option>
                                        }
                                    </InputSelect>
                                    <label class="floating-label">Invoice Type</label>
                                </div>
                            </div>
                        </div>
                    </div>
                <div class="modal-footer">
                    <button class="ui fade op-1 animated button form-btn" @onclick="SearchStudentAdvamceData" tabindex="0">
                        <div class="visible content">Search</div>
                        <div class="hidden content">
                            <i class="bi bi-search"></i>
                        </div>
                    </button>
                </div>

            </div>
        </div>
    </div>
}




@if (InvoiceEdit)
{
    <div class="custom-modal row m-0 align-items-center">
        <div class="col-12 col-sm-7 col-md-5 col-lg-4 col-xl-12">
            <div class="modal-content clearfix main-popup">
                <div class="head-btn">
                    <h5 class="modal-title">Invoice Preview</h5>
                    <button data-access="Close" type="button" @onclick="ClosePopup" class="close"><span aria-hidden="true">×</span></button>
                </div>
                <div class="tab-pane tab-pane-form fade show active overflow-auto min-h-650" style="height: calc(112vh - 270px)" ;>

                    <div class="modal-body">
                        <div class="tab-content form-tab-count">
                            <div class="row gap-10-0 form-row">
                                <div class="col-12 col-sm-12 col-md-12 col-lg-9 px-3 mt-2">
                                    <div class="divider-box d-flex justify-content-between align-items-center gap-2">
                                        <p class="total-text-with-bg ">
                                            Invoice Preview
                                        </p>
                                        <hr class="m-0 w-webkit text-light-gray op-1">
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-4 col-lg-3 px-3 mt-2">
                                    <div class="form-box-group static-label">
                                        <InputSelect class="floating-input" placeholder=" " @bind-Value="@SelectInvtypeId" @bind-Value:after="OpenStudentInvoicePreviewAndEdit">
                                            <option  value="" selected>--Select--</option>
                                            @foreach (var data in InvoiceTypelist)
                                            {
                                                <option value="@data.InvoiceTypeId"> @data.InvoiceTypeName </option>
                                            }
                                        </InputSelect>
                                        <label class="floating-label">Invoice Type</label>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-4 col-lg-3 border-column">

                                    <div class="form-box">
                                        <label for="first-name" class="form-label">Invoice No. :</label>
                                        <label for="first-name" class="form-label">@InvoiceMaster.InvoiceNo</label>

                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-4 col-lg-3 border-column">

                                    <div class="form-box">
                                        <label for="first-name" class="form-label">Fee Period :</label>
                                        <label for="first-name" class="form-label"> @InvoiceMaster.PeriodName</label>

                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-4 col-lg-3 border-column">

                                    <div class="form-box">
                                        <label for="first-name" class="form-label">Invoice Date :</label>
                                        <label for="first-name" class="form-label">@InvoiceMaster.CreatedDate.ToString("dd-MM-yyyy")</label>

                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-4 col-lg-3 border-column border-0">

                                    <div class="form-box">
                                        <label for="first-name" class="form-label">Due Date :</label>
                                        <label for="first-name" class="form-label">@InvoiceMaster.DueDate.ToString("dd-MM-yyyy")</label>

                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="card shadow-sm border-0 p-3">

                                        <div class="row align-items-center">
                                            <div class="col-md-2 text-center">

                                                <img src="@StudentImagePreview" class="profile-photo mb-2" />

                                            </div>
                                            <div class="col-md-10">
                                                <div class="row g-2">
                                                    <div class="col-md-12 ">
                                                        <span class="fw-bold text-primary">@InvoiceMaster.StudentName</span>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <span class="field-title">Student No.:</span>
                                                        <span class="field-value">@InvoiceMaster.ControlNo</span>
                                                    </div>

                                                    <div class="col-md-8">
                                                        <span class="field-title">Session Name:</span>
                                                        <span class="field-value">@InvoiceMaster.SessionName</span>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <span class="field-title">Class / Section:</span>
                                                        <span class="field-value">@InvoiceMaster.ClassSection</span>
                                                    </div>
                                                    <div class="col-md-8">
                                                        <span class="field-title">Fee Structure:</span>
                                                        <span class="field-value">@SelectTemplate</span>
                                                    </div>

                                                </div>
                                            </div>

                                        </div>

                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="card">
                                        <div class="card-body table-card p-0">
                                            <div class="quick-main">
                                                <div class="grid-box scrollbar-thin" style="max-height: 250px; min-height:100px;">
                                                    <QuickGrid Items="@FeeHeadList.AsQueryable()" Pagination="@pagination" Class="table">
                                                        <TemplateColumn Title="" Align="Align.Center">
                                                            <ChildContent>
                                                                <div>
                                                                    <input type="checkbox" @bind="context.IsSelected" @onclick:stopPropagation="true" />
                                                                </div>
                                                            </ChildContent>
                                                        </TemplateColumn>

                                                        <TemplateColumn Title="Fee Head" Align="Align.Left" Sortable="true" SortBy="GridSort<InvoiceFeeHeadModel>.ByAscending(x => x.FeeHeadName)">

                                                            <ChildContent>
                                                                @(string.IsNullOrEmpty(context.FeeHeadName) ? " " : context.FeeHeadName)
                                                            </ChildContent>
                                                        </TemplateColumn>
                                                        <TemplateColumn Title="Month" Align="Align.Left" Sortable="true" SortBy="GridSort<InvoiceFeeHeadModel>.ByAscending(x => x.MonthName)">

                                                            <ChildContent>
                                                                @(string.IsNullOrEmpty(context.MonthName) ? " " : context.MonthName)
                                                            </ChildContent>
                                                        </TemplateColumn>
                                                        <TemplateColumn Title="Amount (₹)" Sortable="true" Class="text-right" SortBy="GridSort<InvoiceFeeHeadModel>.ByAscending(x => x.FeeHeadAmount)" Align="Align.Right">

                                                            <ChildContent>
                                                                @(context.FeeHeadAmount)
                                                            </ChildContent>
                                                        </TemplateColumn>

                                                        <TemplateColumn Title="Concession (₹)" Class="text-right" Sortable="true" Align="Align.Right">
                                                            <ChildContent>
                                                                <div>
                                                                    @(context.Concession)
                                                                </div>
                                                            </ChildContent>
                                                        </TemplateColumn>
                                                        <TemplateColumn Title="Waiver (₹)" Class="text-right" Sortable="true" Align="Align.Right">
                                                            <ChildContent>
                                                                <div>
                                                                    @(context.WaiveOff)
                                                                </div>
                                                            </ChildContent>
                                                        </TemplateColumn>
                                                        <TemplateColumn Title="Received (₹)" Class="text-right" Align="Align.Right">
                                                            <span>@context.ReceivedAmt.ToString("N0")</span>
                                                        </TemplateColumn>

                                                    </QuickGrid>

                                                </div>

                                            </div>
                                        </div>
                                    </div>

                                </div>

                                <div class="col-12 col-sm-6 col-md-4 col-lg-2 mt-2">
                                    <div class="form-box-group">
                                        <input type="text"
                                               class="floating-input text-end"
                                               placeholder=" "
                                               value="@InvoiceMaster.ArrearAmount.ToString("N2")"
                                               readonly />
                                        <label class="floating-label">Previous Arrear</label>
                                    </div>

                                </div>
                                <div class="col-12 col-sm-6 col-md-4 col-lg-2 mt-2">
                                    <div class="form-box-group">
                                        <input type="text"
                                               class="floating-input form-control text-end"
                                               placeholder=" "
                                               value="@InvoiceMaster.TotalAmount.ToString("N2")"
                                               readonly />
                                        <label class="floating-label">Total Amount</label>
                                    </div>
                                </div>

                                <div class="col-12 col-sm-6 col-md-4 col-lg-2 mt-2">
                                    <div class="form-box-group">
                                        <input type="text"
                                               class="floating-input form-control text-end"
                                               placeholder=" "
                                               value="@InvoiceMaster.TotalConcession.ToString("N2")"
                                               readonly />
                                        <label class="floating-label">Total Concession</label>
                                    </div>
                                </div>

                                <div class="col-12 col-sm-6 col-md-4 col-lg-2 mt-2">
                                    <div class="form-box-group">
                                        <input type="text"
                                               class="floating-input form-control text-end"
                                               placeholder=" "
                                               value="@InvoiceMaster.ReceivedAmount.ToString("N2")"
                                               readonly />
                                        <label class="floating-label">Received</label>
                                    </div>
                                </div>

                                <div class="col-12 col-sm-6 col-md-4 col-lg-2 mt-2">
                                    <div class="form-box-group">
                                        <input type="text"
                                               class="floating-input form-control text-end fw-bold"
                                               placeholder=" "
                                               value="@InvoiceMaster.StudentLateFee.ToString("N2")"
                                               readonly />
                                        <label class="floating-label">Late Charges</label>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-4 col-lg-2 mt-2">
                                    <div class="form-box-group">
                                        <input type="text"
                                               class="floating-input form-control text-end fw-bold text-primary"
                                               placeholder=" "
                                               value="@InvoiceMaster.TotalAmount.ToString("N2")"
                                               readonly />
                                        <label class="floating-label text-primary">Balance</label>
                                    </div>
                                </div>

                                <div class="col-12 mt-2">
                                    <div class="form-box-group">
                                        <textarea type="text" class="floating-input sms-aria" placeholder=" "></textarea>
                                        <label class="floating-label text-primary">Narration</label>
                                    </div>
                                </div>


                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 p-3">
                    <div class="page-heading d-flex align-items-center justify-content-end">
                        <div class="d-flex align-items-center gap-2">
                            <div class="form-box">
                                <button type="button" class="table-btn">
                                    Create Instalment
                                </button>
                            </div>
                            <div class="form-box">
                                <button type="button" class="table-btn" @onclick="ModifyDueDate">
                                    Modify Due Date
                                </button>
                            </div>

                            <div class="form-box">
                                <button type="button" class="table-btn" @onclick="AddNewFeeHeadWithAmout">
                                    Add Fee Head
                                </button>
                            </div>

                            <div class="form-box">
                                <button type="button" class="table-btn" @onclick="RemoveFeeHeadWithAmount">
                                    Remove Fee Head
                                </button>
                            </div>

                            <div class="form-box">
                                <button type="button" class="table-btn">
                                    Apply Concession
                                </button>
                            </div>

                            <div class="form-box">
                                <button type="button" class="table-btn">
                                    Remove Concession
                                </button>
                            </div>


                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    @if (ShowPopupUpdateDueDate)
    {
        <div class="custom-modal row m-0 align-items-center">
