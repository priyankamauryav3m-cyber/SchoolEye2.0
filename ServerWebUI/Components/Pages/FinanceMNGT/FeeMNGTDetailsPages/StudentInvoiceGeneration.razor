<script>
    (function() {
        function initSplitter() {
            var container = document.getElementById('splitContainer');
            var gridPane = document.getElementById('gridPane');
            var splitter = document.getElementById('gridSplitter');
            if (!container || !gridPane || !splitter || splitter.dataset.bound === '1') return;
            splitter.dataset.bound = '1';

            var dragging = false;

            splitter.addEventListener('mousedown', function(e) {
                dragging = true;
                splitter.classList.add('active');
                document.body.style.userSelect = 'none';
                e.preventDefault();
            });

            document.addEventListener('mousemove', function(e) {
                if (!dragging) return;
                var rect = container.getBoundingClientRect();
                var newWidth = e.clientX - rect.left;
                var minWidth = 320;
                var maxWidth = rect.width - 230;
                if (newWidth < minWidth) newWidth = minWidth;
                if (newWidth > maxWidth) newWidth = maxWidth;
                gridPane.style.flex = '0 0 ' + newWidth + 'px';
            });

            document.addEventListener('mouseup', function() {
                if (!dragging) return;
                dragging = false;
                splitter.classList.remove('active');
                document.body.style.userSelect = '';
            });
        }

        function initSummaryPin() {
            var pinBtn = document.getElementById('summaryPinBtn');
            var restoreBtn = document.getElementById('summaryRestoreBtn');
            var summaryPane = document.getElementById('summaryPane');
            var splitter = document.getElementById('gridSplitter');
            var gridPane = document.getElementById('gridPane');
            if (!pinBtn || !restoreBtn || !summaryPane || !splitter || !gridPane) return;
            if (pinBtn.dataset.bound === '1') return;
            pinBtn.dataset.bound = '1';

            function collapseSummary() {
                summaryPane.classList.add('collapsed');
                splitter.classList.add('hidden-splitter');
                restoreBtn.classList.add('show');
                gridPane.style.flex = '1 1 auto';
                gridPane.style.maxWidth = '100%';
            }

            function expandSummary() {
                summaryPane.classList.remove('collapsed');
                splitter.classList.remove('hidden-splitter');
                restoreBtn.classList.remove('show');
                gridPane.style.flex = '0 0 76%';
                gridPane.style.maxWidth = '88%';
            }

            pinBtn.addEventListener('click', collapseSummary);
            restoreBtn.addEventListener('click', expandSummary);
        }

        function initAll() {
            initSplitter();
            initSummaryPin();
        }

        initAll();
        document.addEventListener('DOMContentLoaded', initAll);
        setInterval(initAll, 1000);
    })();
</script>

