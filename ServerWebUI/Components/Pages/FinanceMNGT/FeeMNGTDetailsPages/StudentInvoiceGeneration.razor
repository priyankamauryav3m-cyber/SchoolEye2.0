@page "/invoicegeneration"
@using DomainModel.Admin
@using DomainModel.SchoolMaster
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyApp.Common
@using System.Data;
@using ServerWebUI.Components.Pages.CommonPages
@inject Shared.IHttpService httpService
@inject IJSRuntime JSs
@inject HttpClient Http
@inject IStringLocalizer<Resource> Localizer
@inject SweetAlertService Alert
@rendermode InteractiveServer
@inject IHttpClientFactory ClientFactory
@inject ICommonMethod _commonmethod
@inject IJSRuntime JS

<style>

     .sms-aria {
        height: 100px;
    }
    

    .field-title {
        font-weight: 500;
        color: #1f2937;
    }

    .field-value {
        color: #6b7280;
        font-weight: 500;
    }


    .border-column {
        border-right: 2px solid #ccc;
        min-height: 40px;
        display: flex;
        align-items: center;
        padding-left: 40px;
    }

 
    #splitter {
        width: 8px;
        cursor: col-resize;
        background: #e5e7eb;
        transition: .2s;
    }

        #splitter:hover {
            background: #2563eb;
        }

</style>

<div class="main-container">
    <div class="row m-0 main-row">
        <div class="col-12 p-1" id="main-header">
            <PageHeading Tittle="View Invoice Dues">
                <div class="form-box">
                    <select class="form-input">
                        @foreach (var data in societyModellist.Where(x => x.IsValid == true))
                        {
                            <option value="@data.SocietyId">@data.SocietyName</option>
                        }
                    </select>
                </div>
                <div class="form-box">
                    <InputSelect @bind-Value="CurrentSession" name="session" class="form-input">
                        <option value="0">-- Select Session --</option>
                        @foreach (var data in sessionlist.Where(x => x.IsValid == true))
                        {
                            <option value="@data.SessionId">@data.SessionName </option>
                        }
                    </InputSelect>
                </div>
                <div class="form-box">
                    <div class="d-flex gap-2">
                        <button class="icon-btn icon-btn-white open-popup " @onclick="OpenSearch" data-id="popup" tabindex="0">
                            <i class="bi bi-sliders"></i>
                        </button>
                    </div>
                </div>
                <div class="form-box">
                    <button class="ui fade op-1 animated button form-btn" type="button" tabindex="0" @onclick="SearchStudentAdvamceData">
                        <div class="visible content">Search</div>
                        <div class="hidden content">
                            <i class="bi bi-search"></i>
                        </div>
                    </button>
                </div>
            </PageHeading>
        </div>

        <div class="col-12 p-1">
            <div class="split-container" id="splitContainer">
                <div class="grid-pane" id="gridPane">
                    <div class="card">
                        <div class="card-body table-card p-0">
                            <div class="quick-main">
                                <div class="grid-box-with-btn ">
                                    <QuickGrid Items="@moduleQuery" Pagination="@pagination" Class="table">
                                        <TemplateColumn Title="" class="text-center" Align="Align.Center">
                                            <HeaderTemplate>
                                                <div>
                                                    <input type="checkbox" @bind="IsAllSelected" @bind:after="ToggleAll" @onclick:stopPropagation="true" />
                                                </div>
                                            </HeaderTemplate>
                                            <ChildContent>
                                                <div>
                                                  <input type="checkbox" @bind="context.IsSelected" @onclick:stopPropagation="true" disabled="@(context.Status == "0")" />
                                               </div>
                                            </ChildContent>
                                        </TemplateColumn>
                                        <TemplateColumn Title="Admission No" Align="Align.Center" Class="text-center" Sortable="true" SortBy="GridSort<SearchStudentBalanceDto>.ByAscending(x => x.AdmissionNo)">
                                            <ColumnOptions>
                                                <div class="search-box">
                                                    <input type="search" @bind="nameFilter" @bind:event="oninput" placeholder="Admission No...." />
                                                </div>
                                            </ColumnOptions>
                                            <ChildContent>
                                                @(string.IsNullOrEmpty(context.AdmissionNo) ? " " : context.AdmissionNo)

                                            </ChildContent>
                                        </TemplateColumn>
                                        <TemplateColumn Title="Student Name" Sortable="true" SortBy="GridSort<SearchStudentBalanceDto>.ByAscending(x => x.StudentName)" Align="Align.Left">
                                            <ColumnOptions>
                                                <div class="search-box">
                                                    <input type="search" @bind="nameFilter" @bind:event="oninput" placeholder="Student Name...." />
                                                </div>
                                            </ColumnOptions>
                                            <ChildContent>
                                                @(string.IsNullOrEmpty(context.StudentName) ? " " : context.StudentName)
                                            </ChildContent>
                                        </TemplateColumn>

                                        <TemplateColumn Title="Class" Sortable="true" SortBy="GridSort<SearchStudentBalanceDto>.ByAscending(x => x.ClassSection)" Align="Align.Left">
                                            <ChildContent>
                                                <div>
                                                    @(string.IsNullOrEmpty(context.ClassSection) ? " " : context.ClassSection)
                                                </div>
                                            </ChildContent>
                                        </TemplateColumn>
                                        <TemplateColumn Title="Fee Structure" Sortable="true" SortBy="GridSort<SearchStudentBalanceDto>.ByAscending(x => x.TemplateName)" Align="Align.Left">
                                            <ChildContent>
                                                <div>
                                                    @(string.IsNullOrEmpty(context.TemplateName) ? " " : context.TemplateName)
                                                </div>
                                            </ChildContent>
                                        </TemplateColumn>
                                        <TemplateColumn Title="Amount" Class="text-right" Align="Align.Center">
                                            <span>₹ @context.TotalAmount.ToString("N0")</span>
                                        </TemplateColumn>

                                    </QuickGrid>

                                </div>
                                <div class="footer-pagination">
                                    <div class="d-flex align-items-center">
                                        <div class="welcome-text w-100">
                                            <Paginator State="@pagination" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="splitter" id="gridSplitter" title="Drag to resize"></div>

                <div class="summary-pane" id="summaryPane">
                    <div class="card summary-card">
                        <div class="summary-card-title">
                            <span>Invoice Summary</span>
                            <button type="button" class="pin-btn" id="summaryPinBtn" title="Hide summary">
                                <i class="bi bi-pin-angle-fill"></i>
                            </button>
                        </div>
                        <div class="summary-line">
                            <div class="summary-line-label"><i class="fa-solid fa-wallet text-blue"></i><span class="fw-bold">Total Amount</span></div>
                            <div class="summary-line-value text-blue">₹ @TotalAmount.ToString("N2")</div>
                        </div>
                        <div class="summary-line">
                            <div class="summary-line-label"><i class="fa-solid fa-percent text-green"></i><span class="fw-bold">Total Concession</span></div>
                            <div class="summary-line-value text-green">₹ @TotalConcession.ToString("N2")</div>
                        </div>
                        <div class="summary-line">
                            <div class="summary-line-label"><i class="fa-solid fa-clock-rotate-left text-orange"></i><span class="fw-bold">Total Arrear</span></div>
                            <div class="summary-line-value text-orange">₹ @TotalArrearAmount.ToString("N2")</div>
                        </div>
                        <div class="summary-received">
                            <span class="lab">Total Received</span>
                            <span class="val">₹ @TotalReceivedAmount.ToString("N2")</span>
                        </div>
                    </div>
                </div>

                <button type="button" class="summary-restore-btn" id="summaryRestoreBtn" title="Show summary">
                    <i class="bi bi-pin-angle"></i>
                </button>
            </div>
        </div>

        <div class="col-12 p-1">
            <div class="page-heading d-flex align-items-center justify-content-end">
                <div class="d-flex align-items-center gap-2">
                    <div class="form-box">
                        <button type="button" class="table-btn" @onclick="OpenStudentInvoicePreview">
                            Generation Priview
                        </button>
                    </div>
                    <div class="form-box">
                        <button type="button" class="table-btn" @onclick="OpenEditInvoice">
                            Edit Invoice
                        </button>
                    </div>
                    <div class="form-box">
                        <button type="button" class="table-btn" @onclick="OpenCancelInvoice">
                            Cancel Invoice
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>


@if (ShowPopup)
{
    <div class="custom-modal row m-0">
        <div class="col-12 col-sm-7 col-md-5 col-lg-4 col-xl-9">
            <div class="modal-content clearfix main-popup ">
                <div class="head-btn">
                    <h5 class="modal-title">Generate Student Fee Invoice</h5>
                    <button data-access="Close" type="button" @onclick="ClosePopup" class="close"><span aria-hidden="true">×</span></button>
                </div>
                <div class="modal-body">
                    <div class="row gap-10-0">
                        <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                            <div class="form-box">
                                <label for="first-name" class="form-label">Class</label>
                                <div class="position-relative">
                                    <button class="form-input w-webkit" type="button" data-bs-toggle="dropdown">
                                        @SelectedText
                                    </button>
                                    <div class="dropdown-menu cu-dropdown" style="max-height:350px; overflow-y:auto; align-items:center; align-content:center; scrollbar-width: thin;">

                                        <div class="form-check">
                                            <input class="form-check-input map-checkbox" type="checkbox" @bind="SelectAll" @bind:after="OnClassAllChanged" />

                                            <span>All</span>
                                        </div>

                                        @foreach (var item in classlist)
                                        {
                                            <div class="form-check">

                                                <input class="form-check-input map-checkbox" type="checkbox" @bind="item.IsSelected" @bind:after="GetSectionData" />
                                                <span>@item.ClassName</span>

                                            </div>
                                        }

                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-4">

                            <div class="form-box">
                                <label for="first-name" class="form-label">Section</label>
                                <div class="position-relative">
                                    <button class="form-input w-webkit" type="button" data-bs-toggle="dropdown">
                                        @SelectedSectionText
                                    </button>

                                    <div class="dropdown-menu cu-dropdown" style="max-height:350px; overflow-y:auto; align-items:center; align-content:center; scrollbar-width: thin;">

                                        <div class="form-check">

                                            <input class="form-check-input map-checkbox" type="checkbox" @bind="SelectAllSection" @bind:after="ToggleSelectAllSection" />

                                            <span>All</span>

                                        </div>

                                        @foreach (var item in sectionModellist)
                                        {
                                            <div class="form-check">

                                                <input class="form-check-input map-checkbox"
                                                       type="checkbox"
                                                       @bind="item.IsSelected" />

                                                <span>@item.SectionName</span>

                                            </div>
                                        }

                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                            <div class="form-box-group static-label">
                                <InputSelect class="floating-input" placeholder=" " @bind-Value="searchModel.PeriodType" @bind-Value:after="OnPeriodTypeChanged">
                                    <option value="" selected>--Select--</option>
                                    @foreach (var data in PeriodTypeList)
                                    {
                                        <option value="@data.PeriodTypeName">@data.PeriodTypeName</option>
                                    }
                                </InputSelect>
                                <label class="floating-label">Period Type</label>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                            <div class="form-box-group static-label">
                                <InputSelect class="floating-input" placeholder=" " @bind-Value="searchModel.PeriodId">
                                    <option value="" selected>--Select--</option>
                                    @foreach (var data in feeCollectionPeriodlist)
                                    {
                                        <option value="@data.PeriodId">@data.PeriodName</option>
                                    }
                                </InputSelect>
                                <label class="floating-label">Period</label>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                            <div class="form-box-group">
                                <InputText class="floating-input" placeholder=" " @bind-Value="searchModel.StudentNo" autocomplete="off" />
                                <label class="floating-label">Student No.</label>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                            <div class="form-box-group static-label">
                                <InputSelect class="floating-input" placeholder=" " @bind-Value="@searchModel.InvType">
                                    <option value="" selected>--Select--</option>
                                    @foreach (var data in InvoiceTypelist)
                                    {
                                        <option value="@data.InvoiceTypeId"> @data.InvoiceTypeName </option>
                                    }
                                </InputSelect>
                                <label class="floating-label">Invoice Type</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="ui fade op-1 animated button form-btn" @onclick="SearchStudentAdvamceData" tabindex="0">
                        <div class="visible content">Search</div>
                        <div class="hidden content">
                            <i class="bi bi-search"></i>
                        </div>
                    </button>
                </div>

            </div>
        </div>
    </div>
}




@if (ShowEditInvoice)
{
          <EditInvoice ShowEditInvoice="@ShowEditInvoice" SelectedStudent="@EditInvoiceStudent"  CurrentSessionInfo="@sessionlist.FirstOrDefault(x => x.SessionId == CurrentSession)"
           SessionId="@CurrentSession" BranchCode="@branchcode" GroupCode="@groupcode"   UserName="@UserName" OnClose="CloseEditInvoice" />
}

@if (ShowInvoicePreview)
{
    <InvoicePreview ShowInvoicePreview="@ShowInvoicePreview" SelectedStudent="@PreviewInvoiceStudent"
                    BranchCode="@branchcode" GroupCode="@groupcode" OnClose="CloseInvoicePreview" />
}

@if (ShowCancelInvoice)
{
    <div class="custom-modal row m-0 align-items-center">
        <div class="col-12 col-sm-8 col-md-6 col-lg-5 col-xl-5">
            <div class="modal-content clearfix main-popup">
                <div class="head-btn">
                    <h5 class="modal-title">Cancel Invoice</h5>
                    <button data-access="Close" type="button" @onclick="CloseCancelInvoice" class="close"><span aria-hidden="true">×</span></button>
                </div>
                <div class="modal-body">
                    <div class="row gap-10-0">
                        <div class="col-12">
                            <span class="field-title">Student:</span>
                            <span class="field-value">@CancelInvoiceStudent.StudentName - @CancelInvoiceStudent.AdmissionNo</span>
                        </div>
                        <div class="col-12">
                            <div class="form-box">
                                <label class="form-label">Reason <span class="text-danger">*</span></label>
                                <textarea class=" sms-aria form-input" rows="4" maxlength="200" placeholder="Enter reason for cancellation" @bind="CancelReason" @bind:event="oninput"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="ui fade op-1 animated button form-btn" type="button" @onclick="SubmitCancelInvoice" disabled="@IsLoading" tabindex="0">
                        <div class="visible content">Submit</div>
                        <div class="hidden content">
                            <i class="bi bi-check2"></i>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (IsLoading)
{
    <div class="grid-loader-overlay">
        <div class="loader-card">
            <div class="loader-ring">
                <div class="loader-arc"></div>
                <div class="loader-core">
                    <img src="/images/v3m-favicon-m.png" alt="Loading" class="loader-logo" />
                </div>
            </div>
            <p class="loader-text">Loading<span class="dot d1">.</span><span class="dot d2">.</span><span class="dot d3">.</span></p>
        </div>
    </div>

}
else
{

}


@code {
    private string StudentImagePreview = "https://demo.schooleye.in/Images/NoPhoto.gif";
    private IBrowserFile? StudentSelectedFile;
    private async Task OnFileStudentSelected(InputFileChangeEventArgs e)
    {
        StudentSelectedFile = e.File;
        using var stream = StudentSelectedFile.OpenReadStream(5 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        StudentImagePreview = $"data:{StudentSelectedFile.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
        StateHasChanged();

    }
    private decimal TotalAmount => moduleQuery.Sum(x => x.TotalAmount);
    private decimal TotalConcession => moduleQuery.Sum(x => x.TotalConcession);
    private decimal TotalArrearAmount => moduleQuery.Sum(x => x.ArrearAmount);
    private decimal TotalReceivedAmount => moduleQuery.Sum(x => x.ReceivedAmount);
    private bool SelectAll = true;
    private bool ShowInvoicePreview;
    private SearchStudentBalanceDto PreviewInvoiceStudent = new();
    private bool ShowEditInvoice;
    private SearchStudentBalanceDto EditInvoiceStudent = new();
    private bool ShowCancelInvoice;
    private SearchStudentBalanceDto CancelInvoiceStudent = new();
    private string CancelReason = string.Empty;
    private bool SelectAllSection = true;
    private bool addstudent { get; set; }
    private DateTime fromDate = DateTime.Now;
    private DateTime toDate = DateTime.Now;
    private string CurrentDateTime => DateTime.Now.ToString("yyyy/MM/dd, hh:mm tt");
    private bool IsLoading = false;
    private string? branchcode;
    private string? groupcode;
    private string? currentUrl;
    private string? UserName;
    private string? nameFilter = "";
    private bool ShowPopup = false;
    private string? roleId;
    private int SelectInvtypeId = 0;
    private long CurrentSession;
    private SearchAnyRequestModel searchAny = new();
    private List<BranchClassModel> classlist = new();
    private List<GenderModal> genderModallist = new();
    private List<SessionModel> sessionlist = new();
    private List<SectionModel> sectionModellist = new();
    PaginationState pagination = new() { ItemsPerPage = 15 };
    private bool IsAllSelected;
    private SearchStudentBalanceDto searchModel = new();
    private StudentInvoice studentInvoice = new();
    private List<SearchStudentBalanceDto> studentResponselist = new();
    private List<SocietyModel> societyModellist = new();
    private bool ShowPopupGenerateInvoice = false;
    private List<PeriodMaster> PeriodTypeList = new();
    private List<FeeCollectionPeriodConfig> feeCollectionPeriodlist = new();
    private List<InvoiceTypeModel> InvoiceTypelist = new();
    private FeeHeadTemplateRequest gridRequest = new();

    private void ToggleAll()
    {
        foreach (var row in moduleQuery)
            row.IsSelected = IsAllSelected;
    }
    private async Task LoadData()
    {
        IsLoading = true;
        var roleResult = await sessionStorage.GetAsync<string>("RoleId");
        roleId = roleResult.Value;
        var branchResult = await sessionStorage.GetAsync<string>("BranchCode");
        branchcode = branchResult.Value;
        var groupResult = await sessionStorage.GetAsync<string>("GroupCode");
        groupcode = groupResult.Value;
        var username = await sessionStorage.GetAsync<string>("UserName");
        UserName = username.Value;
        string ApiUri1 = "gender/GetGender";
        genderModallist = await httpService.Get<List<GenderModal>>(ApiUri1) ?? new();
        string ApiUri = "BranchClass/GetClassCode";
        classlist = await httpService.Get<List<BranchClassModel>>(ApiUri) ?? new();
        string ApiUri2 = "Session/GetSession";
        sessionlist = await httpService.Get<List<SessionModel>>(ApiUri2) ?? new();
        IsLoading = false;
        string ApiUri3 = "Society/ListSociety";
        societyModellist = await httpService.Get<List<SocietyModel>>(ApiUri3) ?? new();
        PeriodTypeList = await httpService.Get<List<PeriodMaster>>("FeeCollectionPeriodConfig/GetPeriodTypeName") ?? new();
        await GetInvoivetype();
        OnClassAllChanged();
        await SearchStudentAdvamceData();
        StateHasChanged();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {

        if (firstRender)
        {
            CurrentSession = await _commonmethod.SetCurrentSessionData();

            foreach (var item in classlist)
            {
                item.IsSelected = true;
            }
            await LoadData();
            StateHasChanged();
        }
    }
    protected IQueryable<SearchStudentBalanceDto> moduleQuery
    {
        get
        {
            var result = studentResponselist.AsQueryable();
            if (!string.IsNullOrEmpty(nameFilter))
            {
                result = result.Where(x => (x.StudentName != null && x.StudentName.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)) ||
            (x.ControlNo != null && x.ControlNo.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)));

            }
            return result;
        }
    }

    private async Task SearchStudentAdvamceData()
    {
        ShowPopup = false;
        searchModel.GroupCode = groupcode;
        searchModel.BranchCode = branchcode;
        searchModel.SessionId = CurrentSession;
        searchModel.ClassCode = string.Join(",", classlist.Where(x => x.IsSelected).Select(x => x.ClassCode));
        searchModel.SectionId = string.Join(",", sectionModellist.Where(x => x.IsSelected).Select(x => x.SectionId));
        IsLoading = true;
        StateHasChanged();
        try
        {
            string apiUrl = "StudentFeeInvoice/GetStudentGenerateInvoiceFee";
            var apiResponse = await httpService.Post<ApiResponse<List<SearchStudentBalanceDto>>>(apiUrl, searchModel);
            if (apiResponse.Success)
            {
                studentResponselist = apiResponse.Data ?? new List<SearchStudentBalanceDto>();
            }
            else
            {
                studentResponselist = new List<SearchStudentBalanceDto>();
            }

        }
        catch
        {
            studentResponselist = new List<SearchStudentBalanceDto>();
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnClassAllChanged()
    {
        foreach (var item in classlist)
        {
            item.IsSelected = SelectAll;
        }

        await GetSectionData();
    }
    private async Task GetSectionData()
    {
        try
        {
            var selectedClasses = classlist.Where(x => x.IsSelected).ToList();

            SelectAll = selectedClasses.Count == classlist.Count;
            if (!selectedClasses.Any())
            {
                sectionModellist.Clear();
                SelectAllSection = false;

                StateHasChanged();
                return;
            }
            if (selectedClasses.Count > 1)
            {
                sectionModellist.Clear();

                SelectAllSection = true;

                StateHasChanged();
                return;
            }
            SelectAllSection = false;
            searchAny.GroupCode = groupcode;
            searchAny.BranchCode = branchcode;
            searchAny.RequestName = selectedClasses.First().ClassCode;
            string ApiUri = "ClassSection/GetClassWithSection";
            var apiResponse = await httpService.Post<ApiResponse<List<SectionModel>>>(ApiUri, searchAny) ?? new();
            if (apiResponse.Success)
            {
                sectionModellist = apiResponse.Data ?? new();
            }

            StateHasChanged();
        }
        catch
        {
            return;
        }
    }
    private string SelectedText
    {
        get
        {
            if (SelectAll && classlist.Any())
                return "All";
            var selected = classlist.Where(x => x.IsSelected).Select(x => x.ClassName).ToList();
            if (!selected.Any())
                return "Select Class";

            return string.Join(", ", selected);
        }
    }
    private string SelectedSectionText
    {
        get
        {
            if (SelectAllSection)
                return "All";

            var selected = sectionModellist.Where(x => x.IsSelected).Select(x => x.SectionName).ToList();

            if (!selected.Any())
                return "Select Section";

            return string.Join(", ", selected);
        }
    }
    private void ToggleSelectAllSection()
    {
        foreach (var item in sectionModellist)
        {
            item.IsSelected = SelectAllSection;
        }

        StateHasChanged();
    }
    private async Task OnPeriodTypeChanged()
    {
        try
        {
            searchAny.GroupCode = groupcode;
            searchAny.BranchCode = branchcode;
            searchAny.SessionId = CurrentSession;
            searchAny.RequestName = searchModel.PeriodType;
            if (!string.IsNullOrEmpty(searchAny.RequestName))
            {

                string ApiUri3 = "FeeCollectionPeriodConfig/GetFeeCollectionPeriod";
                feeCollectionPeriodlist = await httpService.Post<List<FeeCollectionPeriodConfig>>(ApiUri3, searchAny) ?? new();
            }
            else
            {
                feeCollectionPeriodlist.Clear();
            }
            StateHasChanged();
        }
        catch (Exception)
        {
            return;
        }


    }

    private void OpenSearch()
    {

        ShowPopup = true;
        StateHasChanged();
    }
    private async Task GetInvoivetype()
    {
        InvoiceTypelist = await httpService.Get<List<InvoiceTypeModel>>("StudentFeeInvoice/GetInvoiceTypeList") ?? new();
        if (InvoiceTypelist.Count > 0)
        {
            SelectInvtypeId = InvoiceTypelist[0].InvoiceTypeId;
        }
    }

    // Edit Invoice button: validate a single student is selected, then hand that
    // student off to the EditInvoice component, which loads and manages the
    // invoice edit workflow entirely on its own.
    private async Task OpenEditInvoice()
    {
        var data = moduleQuery.Where(x => x.IsSelected).ToList();
        if (data.Count == 0 || data.Count > 1)
        {
            await JS.InvokeVoidAsync("showSelectRecordAlert");
            return;
        }
        EditInvoiceStudent = data[0];
        ShowEditInvoice = true;
        StateHasChanged();
    }

    private async Task CloseEditInvoice(bool refresh)
    {
        ShowEditInvoice = false;
        EditInvoiceStudent = new();
        if (refresh)
        {
            await SearchStudentAdvamceData();
        }
        StateHasChanged();
    }

    // Cancel Invoice button: exactly one invoice must be checked; the reason
    // entered in the popup is sent as Narration1.
    private async Task OpenCancelInvoice()
    {
        var data = moduleQuery.Where(x => x.IsSelected).ToList();
        if (data.Count == 0 || data.Count > 1)
        {
            await JS.InvokeVoidAsync("showSelectRecordAlert");
            return;
        }
        if (data[0].InvoiceId <= 0)
        {
            await Alert.ShowWarning("Selected student has no generated invoice.");
            return;
        }
        CancelInvoiceStudent = data[0];
        CancelReason = string.Empty;
        ShowCancelInvoice = true;
        StateHasChanged();
    }

    private void CloseCancelInvoice()
    {
        ShowCancelInvoice = false;
        CancelInvoiceStudent = new();
        CancelReason = string.Empty;
        StateHasChanged();
    }

    private async Task SubmitCancelInvoice()    
    {
         ShowCancelInvoice = false;
        if (string.IsNullOrWhiteSpace(CancelReason))
        {
            await Alert.ShowWarning("Please enter reason for cancel invoice.");
             ShowCancelInvoice = true;
            return;
        }
        try
        {
            IsLoading = true;
            StateHasChanged();
            // Matches CancelGeneratedStudentChallanRequest on the API side.
            var request = new
            {
                InvoiceId = CancelInvoiceStudent.InvoiceId,
                CreatedBy = UserName,
                Narration1 = CancelReason.Trim()
            };
            var response = await httpService.Post<ApiResponse<object>>("StudentFeeInvoice/CancelGeneratedStudentChallan", request);
            if (response != null && response.Success)
            {
                ShowCancelInvoice = false;
                CancelInvoiceStudent = new();
                CancelReason = string.Empty;
                await Alert.ShowSuccess("Invoice cancelled successfully.");
                await SearchStudentAdvamceData();
            }
            else
            {
                await Alert.ShowError(string.IsNullOrWhiteSpace(response?.Message) ? "Unable to cancel invoice." : response.Message);
            }
        }
        catch (Exception)
        {
            await Alert.ShowError("Unable to cancel invoice.");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // Invoice Preview button: exactly one student must be selected, then the
    // InvoicePreview component loads and shows that invoice on its own.
    private async Task OpenStudentInvoicePreview()
    {
        var data = moduleQuery.Where(x => x.IsSelected).ToList();
        if (data.Count == 0 || data.Count > 1)
        {
            await JS.InvokeVoidAsync("showSelectRecordAlert");
            return;
        }
        PreviewInvoiceStudent = data[0];
        ShowInvoicePreview = true;
        StateHasChanged();
    }

    private void CloseInvoicePreview()
    {
