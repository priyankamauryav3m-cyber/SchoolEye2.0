@code {
    private List<MonthModel> MonthList = new();
    private async Task OnSessionChanged()
    {

        var selectedSession = sessionlist.FirstOrDefault(x => x.SessionId == CurrentSession);

        if (selectedSession == null)
            return;
        int startMonth = selectedSession.StartDate.Month;
        int endMonth = selectedSession.EndDate.Month;
        var orderedMonths = new List<MonthModel>();
        int current = startMonth;
        while (true)
        {
            orderedMonths.Add(MonthList.First(x => x.MonthNo == current)
            );

            if (current == endMonth)
                break;
            current++;

            if (current > 12)
                current = 1;
        }
        MonthList = orderedMonths;
        StateHasChanged();
    }
    private async Task OnTransportChanged()
    {
        if (IsTransport == true)
        {
            var trans = transportFeelist.FirstOrDefault(x => x.DistanceId == InvoiceMaster.RouteDistance);
            if (trans != null)
            {
                SelectedDistanceAmount = trans.Amount;
            }
            else
            {
                SelectedDistanceAmount = 0;
            }
            foreach (var month in MonthList)
            {
                month.IsDisabled = false;
                month.IsSelected = false;
            }
            foreach (var item in transportSelectMonthlist)
            {
                var month = MonthList.FirstOrDefault(x => x.MonthNo == item.MonthNo);
                if (month != null)
                {
                    month.IsSelected = true;
                    month.IsDisabled = true;
                }
            }
            SelectedFeeHeadId = 0;
            SelectedFeeHeadAmount = 0;

        }
        else
        {
            foreach (var month in MonthList)
            {
                month.IsDisabled = false;
                month.IsSelected = false;
            }

        }

        StateHasChanged();
    }
    private async Task OnFeeHeadChanged()
    {
        var feeHead = feeHeadDropdownlist.FirstOrDefault(x => x.FeeHeadId == SelectedFeeHeadId);
        SelectedFeeHeadAmount = feeHead?.Amount ?? 0;
        foreach (var month in MonthList)
        {
            month.IsDisabled = false;
            month.IsSelected = false;
        }
        var feeHeadItems = FeeHeadList.Where(x => x.FeeHeadId == SelectedFeeHeadId).ToList();
        if (feeHeadItems.Any())
        {
            var applicableType = feeHeadItems.First().FeeApplicableType;
            if (applicableType.Equals("Annual", StringComparison.OrdinalIgnoreCase) || applicableType.Equals("OneTime", StringComparison.OrdinalIgnoreCase))
            {
                foreach (var month in MonthList)
                {
                    month.IsDisabled = true;
                }
                foreach (var item in feeHeadItems)
                {
                    var month = MonthList.FirstOrDefault(x => x.MonthNo == item.MonthNo);
                    if (month != null)
                    {
                        month.IsSelected = true;
                    }
                }
            }
            else
            {
                foreach (var item in feeHeadItems)
                {
                    var month = MonthList.FirstOrDefault(x => x.MonthNo == item.MonthNo);
                    if (month != null)
                    {
                        month.IsSelected = true;
                        month.IsDisabled = true;
                    }
                }
            }
        }

        await InvokeAsync(StateHasChanged);
    }
