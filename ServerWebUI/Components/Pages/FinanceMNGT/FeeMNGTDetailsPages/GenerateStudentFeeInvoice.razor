@page "/studentgenerateinvoice"
@using DomainModel.Admin
@using DomainModel.SchoolMaster
@using DomainModel.FinanceMNGT
@using System.Net
@using System.Text.Json
@using Microsoft.AspNetCore.Mvc
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyApp.Common
@inject Shared.IHttpService httpService
@inject HttpClient Http
@inject IStringLocalizer<Resource> Localizer
@inject SweetAlertService Alert
@rendermode InteractiveServer
@using ServerWebUI.Components.Common
@using ServerWebUI.Components.Pages.CommonPages
@inject IJSRuntime JS
@inject ICommonMethod _commonmethod
@inject PermissionState PermissionState
@inject NavigationManager Nav
<style>
    .quickgrid thead th:nth-last-child(2) {
        min-width: 75px;
    }

    .quickgrid tbody tr.selectRow td {
        background-color: #e7f1ff !important;
    }

    .quickgrid thead th:last-child {
        min-width: 75px;
    }
</style>
<div class="main-container">
    <div class="row m-0 main-row">
        <div class="col-12 p-1" id="main-header">
            <PageHeading Tittle="Invoice Generation">
                <div class="form-box">
                    <select @bind="studentInvoice.SocietyId" class="form-input">
                        @foreach (var data in societyModellist.Where(x => x.IsValid == true))
                        {
                            <option value="@data.SocietyId">@data.SocietyName</option>
                        }
                    </select>
                </div>
                <div class="form-box">
                    <InputSelect @bind-Value="CurrentSession" name="session" class="form-input">
                        <option value="0">-- Select Session --</option>
                        @foreach (var data in sessionlist.Where(x => x.IsValid == true))
                        {
                            <option value="@data.SessionId">@data.SessionName </option>
                        }
                    </InputSelect>
                </div>
                <div class="form-box">
                    <InputSelect @bind-Value="searchModel.ClassCode" class="form-input" @bind-Value:after="GetSectionData">
                        <option value="" selectedselected>All</option>
                        @foreach (var cs in classlist.Where(x => x.IsValid == true))
                        {
                            <option Value="@cs.ClassCode">@cs.ClassName</option>
                        }
                    </InputSelect>
                </div>
                <div class="form-box">
                    <InputSelect @bind-Value="searchModel.Section" class="form-input">
                        <option value="0" selected>All</option>
                        @foreach (var cs in sectionModellist)
                        {
                            <option Value="@cs.SectionId">@cs.SectionName </option>
                        }
                    </InputSelect>
                </div>



                <div class="form-box">
                    <div class="d-flex gap-2">
                        <button class="icon-btn icon-btn-white open-popup " @onclick="OpenSearch" data-id="popup" tabindex="0">
                            <i class="bi bi-sliders"></i>
                        </button>
                    </div>
                </div>
                <div class="form-box">
                    <button class="ui fade op-1 animated button form-btn" @onclick="SearchStudentInvoiceData" tabindex="0">
                        <div class="visible content">Search</div>
                        <div class="hidden content">
                            <i class="bi bi-search"></i>
                        </div>
                    </button>
                </div>
            </PageHeading>
        </div>

        <div class="col-12 p-1">
            <div class="card">
                <div class="card-body table-card p-0">
                    <div class="quick-main">
                        <div class="grid-box-with-btn">
                            <QuickGrid Items="@moduleQuery" Pagination="@pagination" Class="table">

                                <TemplateColumn Title="Roll No." Sortable="true" SortBy="@RollNoSort" Class="text-right" Align="Align.Center">
                                    <ChildContent>
                                        @(string.IsNullOrWhiteSpace(context.RollNo) ? " " : context.RollNo)
                                    </ChildContent>
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" @bind="rollNoFilter" @bind:event="oninput" placeholder="Roll No...." />
                                        </div>
                                    </ColumnOptions>
                                </TemplateColumn>

                                <PropertyColumn Sortable="true" Class="text-center" Property="@(x => x.ControlNo)" Title="Student No." Align="Align.Center">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" @bind="nameFilter" @bind:event="oninput" placeholder="StudentNo...." />
                                        </div>
                                    </ColumnOptions>
                                </PropertyColumn>
                                <TemplateColumn Title="Student Name" Sortable="true" SortBy="GridSort<StudentFeeInvoiceResponseModel>.ByAscending(x => x.StudentName)" Align="Align.Left">
                                    <ChildContent>
                                        @(string.IsNullOrWhiteSpace(context.StudentName) ? " " : context.StudentName)
                                    </ChildContent>
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" @bind="nameFilter" @bind:event="oninput" placeholder="StudentName..." />
                                        </div>
                                    </ColumnOptions>
                                </TemplateColumn>
                                <TemplateColumn Title="Class" Class="text-center" Sortable="true" SortBy="GridSort<StudentFeeInvoiceResponseModel>.ByAscending(x => x.ClassName)" Align="Align.Center">
                                    <ChildContent>
                                        @(string.IsNullOrWhiteSpace(context.ClassName) ? " " : context.ClassName)
                                    </ChildContent>

                                </TemplateColumn>
                                <TemplateColumn Title="Section" Class="text-center" Align="Align.Center">
                                    <ChildContent>
                                        @(string.IsNullOrWhiteSpace(context.SectionName) ? " " : context.SectionName)
                                    </ChildContent>

                                </TemplateColumn>
                                <TemplateColumn Title="Invoice No." Class="text-center" Sortable="true" SortBy="GridSort<StudentFeeInvoiceResponseModel>.ByAscending(x => x.InvoiceNo)" Align="Align.Center">
                                    <ChildContent>
                                        @(string.IsNullOrWhiteSpace(context.InvoiceNo) ? " " : context.InvoiceNo)
                                    </ChildContent>

                                </TemplateColumn>
                                <TemplateColumn Title="Student Category" Class="text-center" Align="Align.Center">
                                    <ChildContent>
                                        @(string.IsNullOrWhiteSpace(context.StudentCategoryName) ? " " : context.StudentCategoryName)
                                    </ChildContent>

                                </TemplateColumn>
                                <TemplateColumn Title="Created Date" Class="text-center" Align="Align.Center">
                                    <ChildContent>
                                        @(string.IsNullOrWhiteSpace(context.CreatedDate) ? " " : context.CreatedDate)
                                    </ChildContent>

                                </TemplateColumn>

                            </QuickGrid>
                        </div>
                        <div class="footer-pagination">
                            <div class="d-flex align-items-center">
                                <div class="welcome-text w-100">
                                    <Paginator State="@pagination" />
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <div class="col-12 p-1">
            <div class="page-heading d-flex align-items-center justify-content-end">

                <div class="d-flex align-items-center gap-2">
                    <div class="form-box">
                        <button type="button" class="table-btn" @onclick="OpenGenerateInvoice">
                            Generate Invoice For All Class
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (ShowPopup)
{
    <div class="custom-modal row m-0">
        <div class="col-12 col-sm-7 col-md-5 col-lg-4 col-xl-9">
            <div class="modal-content clearfix main-popup ">
                <div class="head-btn">
                    <h5 class="modal-title">Generate Student Fee Invoice</h5>
                    <button data-access="Close" type="button" @onclick="ClosePopup" class="close"><span aria-hidden="true">×</span></button>
                </div>
                <div class="modal-body">
                    <div class="row gap-10-0">

                        <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                            <div class="form-box-group static-label">
                                <InputSelect class="floating-input" placeholder=" " @bind-Value="searchModel.PeriodType" @bind-Value:after="OnPeriodTypeChanged">
                                    <option value="" selected>--Select--</option>
                                    @foreach (var data in PeriodTypeList)
                                    {
                                        <option value="@data.PeriodTypeName">@data.PeriodTypeName</option>
                                    }
                                </InputSelect>
                                <label class="floating-label">Period Type</label>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                            <div class="form-box-group static-label">
                                <InputSelect class="floating-input" placeholder=" " @bind-Value="searchModel.PeriodId">
                                    <option value="" selected>--Select--</option>
                                    @foreach (var data in feeCollectionPeriodlist.Where(x => string.Equals(x.PeriodType, searchModel.PeriodType, StringComparison.OrdinalIgnoreCase)))
                                    {
                                        <option value="@data.PeriodId">@data.PeriodName</option>
                                    }
                                </InputSelect>
                                <label class="floating-label">Period</label>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                            <div class="form-box-group static-label">
                                <InputSelect class="floating-input" placeholder=" " @bind-Value="searchModel.StudentCategory">
                                    <option value="0" selected>No-Item</option>
                                </InputSelect>
                                <label class="floating-label">Student Category</label>
                            </div>
                        </div>

                        <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                            <div class="form-box-group static-label">
                                <InputSelect class="floating-input" placeholder=" " @bind-Value="searchModel.IsGenerated">
                                    <option value="-1" selected>All</option>
                                    <option Value="1">Yes</option>
                                    <option Value="0">No</option>
                                </InputSelect>
                                <label class="floating-label">Generated</label>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                            <div class="form-box-group">
                                <InputText class="floating-input" placeholder=" " @bind-Value="searchModel.StudentName" autocomplete="off" />
                                <label class="floating-label">Student First Name</label>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                            <div class="form-box-group">
                                <InputText class="floating-input" placeholder=" " @bind-Value="searchModel.StudentNo" autocomplete="off" />
                                <label class="floating-label">Student No.</label>
                            </div>
                        </div>

                    </div>
                </div>
                <div class="modal-footer">
                    <button class="ui fade op-1 animated button form-btn" @onclick="SearchStudentInvoiceData" tabindex="0">
                        <div class="visible content">Search</div>
                        <div class="hidden content">
                            <i class="bi bi-search"></i>
                        </div>
                    </button>
                </div>

            </div>
        </div>
    </div>
}


@if (ShowPopupGenerateInvoice)
{
    <GenerateInvoicePopup SessionId="@CurrentSession"
                          GroupCode="@groupcode"
                          BranchCode="@branchcode"
                          UserName="@UserName"
                          SocietyId="@studentInvoice.SocietyId"
                          OnClose="CloseGenerateInvoice" />
}



@if (IsLoading)
{
    <div class="grid-loader-overlay">
        <div class="loader-card">
            <div class="loader-ring">
                <div class="loader-arc"></div>
                <div class="loader-core">
                    <img src="/images/v3m-favicon-m.png" alt="Loading" class="loader-logo" />
                </div>
            </div>
            <p class="loader-text">Loading<span class="dot d1">.</span><span class="dot d2">.</span><span class="dot d3">.</span></p>
        </div>
    </div>
}
else
{

}

@code {
    private string? currentUrl;
    private List<BranchClassModel> classlist = new();
    private bool IsLoading = false;
    private StudentForInvoiceRequestModel searchModel = new();
    // header Society select (sent with the generated invoice)
    private StudentInvoice studentInvoice = new();
    private List<SessionModel> sessionlist = new();
    private List<SectionModel> sectionModellist = new();
    private List<StudentFeeInvoiceResponseModel> studentFeeInvoiceResponselist = new();
    private List<SocietyModel> societyModellist = new();
    private bool ShowPopup = false;
    private bool ShowPopupGenerateInvoice = false;
    PaginationState pagination = new() { ItemsPerPage = 15 };
    private string? nameFilter;
    private string? branchcode;
    private string? groupcode;
    private string? UserName;
    private long CurrentSession;
    private SearchAnyRequestModel searchAny = new();
    private List<PeriodMaster> PeriodTypeList = new();
    private List<FeeCollectionPeriodConfig> feeCollectionPeriodlist = new();

    protected override void OnInitialized()
    {
        PermissionState.OnChange += StateHasChanged;
        currentUrl = Nav.Uri;
        searchModel.PeriodType = "";
    }

    // search popup: periods of the selected period type
    private async Task OnPeriodTypeChanged()
    {
        try
        {
            feeCollectionPeriodlist = new();
            if (string.IsNullOrEmpty(searchModel.PeriodType))
            {
                StateHasChanged();
                return;
            }
            searchAny.GroupCode = groupcode;
            searchAny.BranchCode = branchcode;
            searchAny.SessionId = CurrentSession;
            searchAny.RequestName = searchModel.PeriodType;
            feeCollectionPeriodlist = await httpService.Post<List<FeeCollectionPeriodConfig>>("FeeCollectionPeriodConfig/GetFeeCollectionPeriod", searchAny) ?? new();
        }
        catch (Exception)
        {
            return;
        }
        StateHasChanged();
    }

    private async Task GetSectionData()
    {
        try
        {
            searchAny.GroupCode = groupcode;
            searchAny.BranchCode = branchcode;
            searchAny.RequestName = searchModel.ClassCode;
            var apiResponse = await httpService.Post<ApiResponse<List<SectionModel>>>("ClassSection/GetClassWithSection", searchAny) ?? new();
            if (apiResponse.Success)
            {
                sectionModellist = apiResponse.Data ?? new();
            }
        }
        catch (Exception)
        {
            return;
        }
    }

    private async Task LoadData()
    {
        branchcode = (await sessionStorage.GetAsync<string>("BranchCode")).Value;
        groupcode = (await sessionStorage.GetAsync<string>("GroupCode")).Value;
        UserName = (await sessionStorage.GetAsync<string>("UserName")).Value;
        sessionlist = await httpService.Get<List<SessionModel>>("Session/GetSession") ?? new();
        classlist = await httpService.Get<List<BranchClassModel>>("BranchClass/GetClassCode") ?? new();
        societyModellist = await httpService.Get<List<SocietyModel>>("Society/ListSociety") ?? new();
        PeriodTypeList = await httpService.Get<List<PeriodMaster>>("FeeCollectionPeriodConfig/GetPeriodTypeName") ?? new();
        StateHasChanged();
        await SearchStudentInvoiceData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CurrentSession = await _commonmethod.SetCurrentSessionData();
            await LoadData();
            StateHasChanged();
        }
    }

    // Roll No. column: search box and sorting by number (2 before 10)
    private string? rollNoFilter;
    private GridSort<StudentFeeInvoiceResponseModel> RollNoSort = GridSort<StudentFeeInvoiceResponseModel>.ByAscending(x => x.RollNo == null ? 0 : x.RollNo.Length).ThenAscending(x => x.RollNo);

    protected IQueryable<StudentFeeInvoiceResponseModel> moduleQuery
    {
        get
        {
            var result = studentFeeInvoiceResponselist.AsQueryable();
            if (!string.IsNullOrEmpty(nameFilter))
            {
                result = result.Where(x => (x.StudentName != null && x.StudentName.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)) ||
                                           (x.ControlNo != null && x.ControlNo.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)));
            }
            if (!string.IsNullOrWhiteSpace(rollNoFilter))
                result = result.Where(x => x.RollNo != null && x.RollNo.Contains(rollNoFilter.Trim(), StringComparison.CurrentCultureIgnoreCase));
            return result;
        }
    }

    private async Task SearchStudentInvoiceData()
    {
        ShowPopup = false;
        searchModel.GroupCode = groupcode;
        searchModel.BranchCode = branchcode;
        searchModel.SessionId = CurrentSession;
        IsLoading = true;
        StateHasChanged();
        try
        {
            var apiResponse = await httpService.Post<ApiResponse<List<StudentFeeInvoiceResponseModel>>>("StudentFeeInvoice/GetForStudentGenerateInvoice", searchModel);
            studentFeeInvoiceResponselist = apiResponse != null && apiResponse.Success
                ? apiResponse.Data ?? new List<StudentFeeInvoiceResponseModel>()
                : new List<StudentFeeInvoiceResponseModel>();
        }
        catch
        {
            studentFeeInvoiceResponselist = new List<StudentFeeInvoiceResponseModel>();
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void OpenSearch()
    {
        ShowPopup = true;
        StateHasChanged();
    }

    // "Generate Invoice For All Class" -> shared GenerateInvoicePopup component
    private void OpenGenerateInvoice()
    {
        ShowPopupGenerateInvoice = true;
        StateHasChanged();
    }

    private async Task CloseGenerateInvoice(bool generated)
    {
        ShowPopupGenerateInvoice = false;
        StateHasChanged();
        if (generated)
            await SearchStudentInvoiceData();
    }

    private void ClosePopup()
    {
        ShowPopup = false;
        StateHasChanged();
    }
}
