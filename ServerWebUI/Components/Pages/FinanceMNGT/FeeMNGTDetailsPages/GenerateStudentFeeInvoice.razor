{
    <div class="grid-loader-overlay">
        <img src="images/loading.gif" alt="Loading..." />
    </div>
}
else
{

}

@code {


    private List<StudentClassModal> Students = new();
    private string SelectedText
    {
        get
        {
            var selected = classlist.Where(x => x.IsSelected).Select(x => x.ClassName).ToList();

            if (!selected.Any())
                return "Select Class";

            if (SelectAll)
                return "All Class Selected";

            if (selected.Count <= 4)
                return string.Join(", ", selected);

            return $"{string.Join(", ", selected.Take(4))} +{selected.Count - 4} more";
        }
    }
    private string SelectedPeriodText
    {
        get
        {
            var selected = feeCollectionPeriodlist.Where(x => x.IsSelected).Select(x => x.PeriodName).ToList();

            if (!selected.Any())
                return "Select Period";

            if (SelectAllPeriod)
                return "All Period Selected";

            if (selected.Count == 1)
                return selected[0];

            if (selected.Count == 2)
                return $"{selected[0]}, {selected[1]}";

            return $"{selected[0]}, {selected[1]} +{selected.Count - 2} more";
        }
    }
    private async Task ToggleSelectAll()
    {
        try
        {
            foreach (var item in classlist)
            {
                item.IsSelected = SelectAll;
            }
            await SearchStudentSelect();

        }
        catch (Exception)
        {

            throw;
        }


    }
    protected IQueryable<StudentClassModal> StudentmoduleQuery
    {
        get
        {
            var result = Students.AsQueryable();
            if (!string.IsNullOrWhiteSpace(nameFilter))
            {
                result = result.Where(x => x.StudentName.Contains(nameFilter, StringComparison.OrdinalIgnoreCase)
                  || x.ControlNo.Contains(nameFilter, StringComparison.OrdinalIgnoreCase)
                );
            }
            return result;
        }
    }
    private async Task SearchStudentSelect()
    {
        try
        {

            SelectedClassCode = string.Join(",", classlist.Where(x => x.IsSelected).Select(x => x.ClassCode));
            if (!string.IsNullOrWhiteSpace(SelectedClassCode))
            {
                searchAny.GroupCode = groupcode;
                searchAny.BranchCode = branchcode;
                searchAny.RequestName = SelectedClassCode;
                searchAny.SessionId = CurrentSession;
                Students = await httpService.Post<List<StudentClassModal>>("StudentFeeInvoice/ClassBasedStudent", searchAny) ?? new();
            }
            else
            {
                Students = new();
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }
    private Task ToggleSelectAllPeriod()
    {
        foreach (var item in feeCollectionPeriodlist.Where(x => string.Equals(x.PeriodType, searchModel.PeriodType, StringComparison.OrdinalIgnoreCase)))
        {
            item.IsSelected = SelectAllPeriod;
        }

        StateHasChanged();
        return Task.CompletedTask;
    }
    private Task UpdateSelectAllPeriod()
    {
        var periods = feeCollectionPeriodlist
            .Where(x => string.Equals(x.PeriodType, studentInvoice.PeriodType, StringComparison.OrdinalIgnoreCase))
            .ToList();

        SelectAllPeriod = periods.Any() && periods.All(x => x.IsSelected);

        StateHasChanged();
        return Task.CompletedTask;
    }
    private async Task UpdateSelectAllClass()
    {
        var updateclass = classlist.Where(x => x.IsValid == true).ToList();
        SelectAll = updateclass.Any() && updateclass.All(x => x.IsSelected);
        await SearchStudentSelect();
        StateHasChanged();
    }
    private bool SelectAll = true;
    private bool SelectAllPeriod = false;
    private string searchText = "";
    private string? SelectedStudentId;
    private string? SelectedClassCode;
    private string? SelectedPeriodId;
    private string? currentUrl;
    private bool IsAllSelected;
    private bool IsAllStudentSelected;
    public bool IsSelected { get; set; }
    private List<BranchClassModel> classlist = new();
    private bool IsLoading = false;
    private StudentForInvoiceRequestModel searchModel = new();
    private StudentInvoice studentInvoice = new();
    private List<SessionModel> sessionlist = new();
    private List<SectionModel> sectionModellist = new();
    private List<StudentFeeInvoiceResponseModel> studentFeeInvoiceResponselist = new();
    private List<SocietyModel> societyModellist = new();
    private bool ShowPopup = false;
    private bool ShowPopupGenerateInvoice = false;
    PaginationState pagination = new() { ItemsPerPage = 15 };
    private string? nameFilter;
    private string? branchcode;
    private string? groupcode;
    private string UserName;
    private long CurrentSession;
    private SearchAnyRequestModel searchAny = new();
    private List<PeriodMaster> PeriodTypeList = new();
    private List<FeeCollectionPeriodConfig> feeCollectionPeriodlist = new();
    private List<InvoiceTypeModel> InvoiceTypelist = new();

    protected override void OnInitialized()
    {

        PermissionState.OnChange += StateHasChanged;
        currentUrl = Nav.Uri;
        searchModel.PeriodType = "";
        StateHasChanged();

    }

    private void ToggleAll()
    {
        foreach (var row in moduleQuery)
            row.IsSelected = IsAllSelected;
    }
    private void ToggleAllStudent()
    {
        foreach (var row in StudentmoduleQuery)
            row.IsSelected = IsAllStudentSelected;
    }
    private async Task OnPeriodTypeChanged()
    {
        try
        {
            searchAny.GroupCode = groupcode;
            searchAny.BranchCode = branchcode;
            searchAny.SessionId = CurrentSession;
            searchAny.RequestName = studentInvoice.PeriodType;

            string ApiUri3 = "FeeCollectionPeriodConfig/GetFeeCollectionPeriod";

            feeCollectionPeriodlist = await httpService.Post<List<FeeCollectionPeriodConfig>>(ApiUri3, searchAny)?? new();
            SelectAll = false;

            foreach (var item in feeCollectionPeriodlist)
            {
                item.IsSelected = false;
            }
        }
        catch (Exception)
        {
            return;
        }

        StateHasChanged();
    }
    private async Task GetSectionData()
    {
        try
        {
            searchAny.GroupCode = groupcode;
            searchAny.BranchCode = branchcode;
            searchAny.RequestName = searchModel.ClassCode;
            string ApiUri1 = "ClassSection/GetClassWithSection";
            var apiResponse = await httpService.Post<ApiResponse<List<SectionModel>>>(ApiUri1, searchAny) ?? new();
            if (apiResponse.Success)
            {
                sectionModellist = apiResponse.Data ?? new();
            }

        }
        catch (Exception)
        {

            return;
        }
    }

    private async Task LoadData()
    {
        var branchResult = await sessionStorage.GetAsync<string>("BranchCode");
        branchcode = branchResult.Value;
        var groupResult = await sessionStorage.GetAsync<string>("GroupCode");
        groupcode = groupResult.Value;
        var username = await sessionStorage.GetAsync<string>("UserName");
        UserName = username.Value;
        string ApiUri1 = "Session/GetSession";
        sessionlist = await httpService.Get<List<SessionModel>>(ApiUri1) ?? new();
        string ApiUri = "BranchClass/GetClassCode";
        classlist = await httpService.Get<List<BranchClassModel>>(ApiUri) ?? new();
        string ApiUri2 = "Society/ListSociety";
        societyModellist = await httpService.Get<List<SocietyModel>>(ApiUri2) ?? new();
        PeriodTypeList = await httpService.Get<List<PeriodMaster>>("FeeCollectionPeriodConfig/GetPeriodTypeName") ?? new();
        InvoiceTypelist = await httpService.Get<List<InvoiceTypeModel>>("StudentFeeInvoice/GetInvoiceTypeList") ?? new();
        StateHasChanged();
        await SearchStudentInvoiceData();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            
            CurrentSession = await _commonmethod.SetCurrentSessionData();
            await LoadData();
            await OnPeriodTypeChanged();
            StateHasChanged();
        }
    }
    protected IQueryable<StudentFeeInvoiceResponseModel> moduleQuery
    {
        get
        {
            var result = studentFeeInvoiceResponselist.AsQueryable();
            if (!string.IsNullOrEmpty(nameFilter))
            {
                result = result.Where(x => (x.StudentName != null && x.StudentName.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)) ||
            (x.ControlNo != null && x.ControlNo.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)));

            }
            return result;
        }
    }
    private async Task SearchStudentInvoiceData()
    {
        ShowPopup = false;
        searchModel.GroupCode = groupcode;
        searchModel.BranchCode = branchcode;
        searchModel.SessionId = CurrentSession;
        IsLoading = true;
        StateHasChanged();
        try
        {
            string apiUrl = "StudentFeeInvoice/GetForStudentGenerateInvoice";
            var apiResponse = await httpService.Post<ApiResponse<List<StudentFeeInvoiceResponseModel>>>(apiUrl, searchModel);
            if (apiResponse.Success)
            {
                studentFeeInvoiceResponselist = apiResponse.Data ?? new List<StudentFeeInvoiceResponseModel>();
            }
            else
            {
                studentFeeInvoiceResponselist = new List<StudentFeeInvoiceResponseModel>();
            }

        }
        catch
        {
            studentFeeInvoiceResponselist = new List<StudentFeeInvoiceResponseModel>();
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task GenerateStudentInvoiveAllClass()
    {
        ShowPopupGenerateInvoice = false;
        studentInvoice.ClassCode = string.Join(",", classlist.Where(x => x.IsSelected).Select(x => x.ClassCode));
        studentInvoice.GroupCode = groupcode;
        studentInvoice.BranchCode = branchcode;
        studentInvoice.CreatedBy = UserName;
        studentInvoice.SessionId = CurrentSession;
        studentInvoice.StudentId = string.Join(",", Students.Where(x => x.IsSelected).Select(x => x.StudentId));
        studentInvoice.PeriodId = string.Join(",", feeCollectionPeriodlist.Where(x => x.IsSelected).Select(x => x.PeriodId));
        if (string.IsNullOrEmpty(studentInvoice.ClassCode))
        {
            await Alert.ShowWarning("Please select a class first.");
            ShowPopupGenerateInvoice = true;
            StateHasChanged();
            return;

        }
        else if (string.IsNullOrEmpty(studentInvoice.PeriodType))
        {
            await Alert.ShowWarning("Please select a period type.");
            ShowPopupGenerateInvoice = true;
            StateHasChanged();
            return;

        }
        else if (string.IsNullOrEmpty(studentInvoice.PeriodId))
        {
            await Alert.ShowWarning("Please select a period first.");
            ShowPopupGenerateInvoice = true;
            StateHasChanged();
            return;

        }
        else if (studentInvoice.InvoiceTypeId==0)
        {
            await Alert.ShowWarning("Please select a invoice type");
            ShowPopupGenerateInvoice = true;
            StateHasChanged();
            return;

        }
        try
        {
            ShowPopupGenerateInvoice = false;
            var submit = await Alert.ShowConfirm("Do you want to submit details?");
            if (!submit)
            {
                ShowPopupGenerateInvoice = true;
                StateHasChanged();
                return;
            }
            string apiurl = "StudentFeeInvoice/StudentChallanGenerate";
            var apiResponse = await httpService.Post<ApiResponse<string>>(apiurl, studentInvoice);
            if (apiResponse.Success && apiResponse.Code == 1)
            {
                await Alert.ShowSuccess("Invoice Generated Successfully");
                await SearchStudentInvoiceData();
                studentInvoice = new();
                StateHasChanged();
                ClosePopup();

            }
            else
            {
                await Alert.ShowCustomAlert(@Localizer["Admin"]);
                StateHasChanged();
                ClosePopup();
                return;
            }

            
        }
        catch (Exception)
        {

            return;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private void OpenSearch()
    {

        ShowPopup = true;
        StateHasChanged();
    }
    private void OpenGenerateInvoice()
    {

        ShowPopupGenerateInvoice = true;
        StateHasChanged();
    }
    private void ClosePopup()
    {
        SelectAll = false;
        foreach (var item in classlist)
        {
            item.IsSelected = false;
        }
        foreach (var item in Students)
        {
            item.IsSelected = false;
        }
        searchText = string.Empty;
        Students = new();
        SelectAllPeriod = false;
        IsAllStudentSelected = false;
        foreach (var item in feeCollectionPeriodlist)
        {
            item.IsSelected = false;
        }
        ShowPopup = false;
        ShowPopupGenerateInvoice = false;
        StateHasChanged();
    }



