@page "/ViewStudentInvoiceDues"
@using DomainModel.Admin
@using DomainModel.SchoolMaster
@using DomainModel.FinanceMNGT
@using System.Net
@using System.Text.Json
@using Microsoft.AspNetCore.Mvc
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyApp.Common
@inject Shared.IHttpService httpService
@inject HttpClient Http
@inject IStringLocalizer<Resource> Localizer
@inject SweetAlertService Alert
@rendermode InteractiveServer
@using ServerWebUI.Components.Common
@using ServerWebUI.Components.Pages.CommonPages
@inject IJSRuntime JS
@inject ICommonMethod _commonmethod
@inject PermissionState PermissionState
@inject NavigationManager Nav
<style>
    .quickgrid thead th:nth-last-child(2) {
        min-width: 75px;
    }

    .quickgrid tbody tr.selectRow td {
        background-color: #cce5ff !important;
    }

    .quickgrid thead th:last-child {
        min-width: 75px;
    }
</style>
<div class="main-container">
    <div class="row m-0 main-row">
        <div class="col-12 p-1" id="main-header">
            <div class="page-heading d-flex align-items-center justify-content-between">
                <p class="m-0 page-name px-1">
                    View Student Invoice Dues
                </p>
                <div class="d-flex align-items-center gap-2">
                    <div class="form-box">
                        <select @bind="searchModel.SocietyId" class="form-input">
                            @foreach (var data in societyModellist.Where(x => x.IsValid == true))
                            {
                                <option value="@data.SocietyId">@data.SocietyName</option>
                            }
                        </select>
                    </div>
                    <div class="form-box">
                        <InputSelect @bind-Value="CurrentSession" name="session" class="form-input">
                            <option value="0">-- Select Session --</option>
                            @foreach (var data in sessionlist.Where(x => x.IsValid == true))
                            {
                                <option value="@data.SessionId">@data.SessionName </option>
                            }
                        </InputSelect>
                    </div>
                    <div class="form-box">

                        <button class="form-input" type="button" data-bs-toggle="dropdown">
                            @SelectedText
                        </button>
                        <div class="dropdown-menu" style="max-height:350px; overflow-y:auto;">

                            <div class="form-check">
                                <input class="form-check-input map-checkbox" type="checkbox" @bind="SelectAll" @bind:after="OnClassAllChanged" />

                                <span>All</span>
                            </div>

                            @foreach (var item in classlist)
                            {
                                <div class="form-check">

                                    <input class="form-check-input map-checkbox" type="checkbox" @bind="item.IsSelected" @bind:after="GetSectionData" />
                                    <span>@item.ClassName</span>

                                </div>
                            }

                        </div>
                    </div>

                    <div class="form-box">

                        <button class="form-input" type="button" data-bs-toggle="dropdown">
                            @SelectedSectionText
                        </button>

                        <div class="dropdown-menu" style="max-height:350px; overflow-y:auto;">

                            <div class="form-check">

                                <input class="form-check-input map-checkbox" type="checkbox" @bind="SelectAllSection" @bind:after="ToggleSelectAllSection" />

                                <span>All</span>

                            </div>

                            @foreach (var item in sectionModellist)
                            {
                                <div class="form-check">

                                    <input class="form-check-input map-checkbox"
                                           type="checkbox"
                                           @bind="item.IsSelected" />

                                    <span>@item.SectionName</span>

                                </div>
                            }

                        </div>
                    </div>

             
                    <div class="form-box">
                        <div class="d-flex gap-2">
                            <button class="icon-btn icon-btn-white open-popup " @onclick="OpenSearch" data-id="popup" tabindex="0">
                                <i class="bi bi-sliders"></i>
                            </button>
                        </div>
                    </div>
                    <div class="form-box">
                        <button class="ui fade op-1 animated button form-btn" @onclick="SearchStudentInvoiceData" tabindex="0">
                            <div class="visible content justify-content-center">Search</div>
                            <div class="hidden content">
                                <i class="bi bi-search"></i>
                            </div>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 p-1">
            <div class="card">
                <div class="card-body table-card p-0">
                    <div class="quick-main">
                        <div class="grid-box-with-btn">
                            <QuickGrid Items="@moduleQuery" Pagination="@pagination" Class="table">
                                <TemplateColumn Title="" Align="Align.Center">
                                    <HeaderTemplate>
                                        <div class="d-flex align-items-center justify-content-center">
                                            <input type="checkbox" @bind="IsAllSelected" @bind:after="ToggleAll" @onclick:stopPropagation="true" />
                                        </div>
                                    </HeaderTemplate>
                                    <ChildContent>
                                        <div class="d-flex align-items-center justify-content-center">
                                            <input type="checkbox" @bind="context.IsSelected" @onclick:stopPropagation="true" />
                                        </div>
                                    </ChildContent>
                                </TemplateColumn>

                                @* <PropertyColumn Class="text-right" Property="@(x => x.RollNo)" Title="Roll No." Align="Align.Center" /> *@

                                <PropertyColumn Sortable="true" Class="text-center" Property="@(x => x.ControlNo)" Title="Student No." Align="Align.Center">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" @bind="nameFilter" @bind:event="oninput" placeholder="StudentNo...." />
                                        </div>
                                    </ColumnOptions>
                                </PropertyColumn>
                                <TemplateColumn Title="Student Name" Sortable="true" SortBy="GridSort<StudentDuesModel>.ByAscending(x => x.StudentName)" Align="Align.Left">
                                    <ChildContent>
                                        @(string.IsNullOrWhiteSpace(context.StudentName) ? " " : context.StudentName)
                                    </ChildContent>
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" @bind="nameFilter" @bind:event="oninput" placeholder="StudentName..." />
                                        </div>
                                    </ColumnOptions>
                                </TemplateColumn>
                                <TemplateColumn Title="Class Section" Sortable="true" SortBy="GridSort<StudentDuesModel>.ByAscending(x => x.ClassSection)" Align="Align.Center">
                                    <ChildContent>
                                        @(string.IsNullOrWhiteSpace(context.ClassSection) ? " " : context.ClassSection)
                                    </ChildContent>

                                </TemplateColumn>
                                <TemplateColumn Title="Category" Sortable="true" SortBy="GridSort<StudentDuesModel>.ByAscending(x => x.StudentName)" Align="Align.Left">
                                    <ChildContent>
                                        @(string.IsNullOrWhiteSpace(context.Category) ? " " : context.Category)
                                    </ChildContent>
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" @bind="nameFilter" @bind:event="oninput" placeholder="StudentName..." />
                                        </div>
                                    </ColumnOptions>
                                </TemplateColumn>
                                <TemplateColumn Title="Mobile No." Class="text-center" Align="Align.Center">
                                    <ChildContent>
                                        @(string.IsNullOrWhiteSpace(context.SMSMobileNo) ? " " : context.SMSMobileNo)
                                    </ChildContent>

                                </TemplateColumn>
                                <TemplateColumn Title="Email" Class="text-center" Sortable="true" SortBy="GridSort<StudentDuesModel>.ByAscending(x => x.FatherEMail)" Align="Align.Center">
                                    <ChildContent>
                                        @(string.IsNullOrWhiteSpace(context.FatherEMail) ? " " : context.FatherEMail)
                                    </ChildContent>

                                </TemplateColumn>
                                @* <TemplateColumn Title="Category" Class="text-center" Align="Align.Center">
                                    <ChildContent>
                                        @(string.IsNullOrWhiteSpace(context.stu) ? " " : context.StudentCategoryName)
                                    </ChildContent>

                                </TemplateColumn> *@
                                <PropertyColumn Title="Toltal Amount" Class="text-right" Property="@(x => x.Amount)" Align="Align.Center">
                                </PropertyColumn>

                                <TemplateColumn Title="Comment" Class="text-center" Align="Align.Center">
                                    <ChildContent>
                                        @(string.IsNullOrWhiteSpace(context.CommentText) ? " " : context.CommentText)
                                    </ChildContent>

                                </TemplateColumn>
                                <TemplateColumn Title="Status" Class="text-center" Align="Align.Center">
                                    <ChildContent>
                                        <div class="text-center">
                                            @if (context.IsValid == true)
                                            {
                                                // <span class="fa fa-check text-success"></span>
                                                    <img class="grid-status" src="/images/status-success.png" />
                                            }
                                            else
                                            {
                                                <img class="grid-status" src="/images/status-false.png" />
                                            }
                                        </div>
                                    </ChildContent>

                                </TemplateColumn>
                            </QuickGrid>
                        </div>
                        <div class="footer-pagination">
                            <div class="d-flex align-items-center">
                                <div class="welcome-text w-100">
                                    <Paginator State="@pagination" />
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <div class="col-12 p-1">
            <div class="page-heading d-flex align-items-center justify-content-end">

                <div class="d-flex align-items-center gap-2">
                    <div class="form-box">
                        @*    <button type="button" class="table-btn" @onclick="AllStudentPrintChallan">
                            Print
                        </button> *@
                      
                    </div>
                    <AdmitChildButton CurrentUrl="@currentUrl" ButtonText="Print" Print="OnPrintClick" />
                    <AdmitChildButton CurrentUrl="@currentUrl" ButtonText="Print Challan" Print="StudentPrintChallan" />
                </div>
            </div>
        </div>
    </div>
</div>

