                        <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                            <div class="form-box-group static-label">
                                <label for="sibling" class="floating-label">Late Fee</label>
                                <div class="border-box d-flex justify-content-center align-items-center gap-3">
                                    <div class="d-flex align-items-center gap-1">
                                        <InputCheckbox @bind-Value="searchModel.IsWithLateFee" class="form-input" autocomplete="off" />
