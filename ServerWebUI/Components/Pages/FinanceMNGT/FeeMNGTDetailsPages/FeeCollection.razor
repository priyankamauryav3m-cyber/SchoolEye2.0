@page "/feecollectionnew"
@using DomainModel.Admin
@using Microsoft.AspNetCore.Authorization
@using static DomainModel.FinanceMNGT.FeeCollectionDuesNew
@inject IHttpClientFactory ClientFactory
@using DomainModel.SchoolMaster
@using Microsoft.AspNetCore.Components.QuickGrid
@using ServerWebUI.Components.Common
@inject ICommonMethod _commonmethod
@using System.Net
@using System.Drawing;
@using System.Text.Json
@using MyApp.Common
@using System.Text.RegularExpressions
@using ServerWebUI.Components.Pages.CommonPages
@inject IJSRuntime JS
@inject Shared.IHttpService httpService
@inject HttpClient Http
@inject IStringLocalizer<Resource> Localizer
@inject SweetAlertService Alert
@inject IWebHostEnvironment env
@rendermode InteractiveServer


<style>

    .quickgrid thead th:last-child {
        min-width: 70px;
    }

    .grid-box {
        height: calc(90vh - 250px);
        min-height: 250px;
    }

    .quickgrid thead th:nth-last-child(2) {
        min-width: 50px;
    }
</style>

@* page styles: NewStyle.css -> "Fee Collection page" block (all scoped under .fee-collection-page) *@
<div class="fee-collection-page">
<div class="main-container">
    <div class="row m-0 main-row">

        <div class="col-12 p-1">
            <nav class="crumb" aria-label="Breadcrumb">
                <strong>Finance</strong><span>&rsaquo;</span>
                <span class="text-muted">Collect Fee</span>
            </nav>
        </div>

        <div class="col-12 p-1" id="main-header">
            <PageHeading Tittle="Fee Collection">
                <div class="form-box">
                    <InputSelect @bind-Value="CurrentSession" name="session" class="form-input">
                        <option value="0">-- Select Session --</option>
                        @foreach (var data in sessionlist.Where(x => x.IsValid == true))
                        {
                            <option value="@data.SessionId">@data.SessionName </option>
                        }
                    </InputSelect>
                </div>
                <div class="form-box student-search-wrap">
                    <input @key="searchInputKey" class="form-input" placeholder="Enter student no. or student name" @bind-Value="searchTerm" @bind-Value:event="oninput" @bind-Value:after="OnSearchTermChanged" @onkeydown="HandleSearchKeyDown" />

                    @if (ShowSuggestions)
                    {
                        <div class="student-suggest-box">
                            @* search running -> "Loading" with the small spinner, then the students to select *@
                            @if (IsSearchingStudents)
                            {
                                <div class="inline-loader">
                                    <span>Loading students</span>
                                    <span class="inline-spinner" role="status" aria-hidden="true"></span>
                                </div>
                            }
                            else if (filteredSuggestions.Count == 0)
                            {
                                <div class="student-suggest-empty">No matching student found.</div>
                            }
                            else
                            {
                                @for (int i = 0; i < filteredSuggestions.Count; i++)
                                {
                                    var item = filteredSuggestions[i];
                                    var index = i;
                                    <div class="student-suggest-item @(index == activeSuggestion ? "active" : "")" @onclick="() => SelectStudent(item)">
                                        <div class="student-suggest-column">
                                            <span class="student-suggest-label">Student Name</span>
                                            <span class="student-suggest-value">@item.StudentName</span>
                                        </div>
                                        <div class="student-suggest-column">
                                            <span class="student-suggest-label">Admission No.</span>
                                            <span class="student-suggest-value">@item.ControlNo</span>
                                        </div>
                                        <div class="student-suggest-column">
                                            <span class="student-suggest-label">Class</span>
                                            <span class="student-suggest-value">@item.ClassSection</span>
                                        </div>
                                        <div class="student-suggest-column">
                                            <span class="student-suggest-label">Father</span>
                                            <span class="student-suggest-value">@item.FatherName</span>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
                <div class="form-box">
                    <button class="ui fade op-1 animated button form-btn" tabindex="0" @onclick="SearchStudent">
                        <div class="visible content justify-content-center">Search</div>
                        <div class="hidden content">
                            <i class="bi bi-search"></i>
                        </div>
                    </button>
                </div>
            </PageHeading>
        </div>
        <div class="col-12 p-1">
            <div class="card">
                <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-3">

                    <div class="d-flex align-items-center gap-2">
                        <div class="student-avatar">
                            @GetInitials(IsStudentSelected ? selectedStudent.StudentName : null)
                        </div>

                        <div>
                            <div class="student-name">
                                @(IsStudentSelected ? selectedStudent.StudentName : "No student selected")
                            </div>

                            <div class="student-sub">
                                @if (IsStudentSelected)
                                {
                                    @:Admission no. @selectedStudent.ControlNo &nbsp;&middot;&nbsp; Class @selectedStudent.ClassSection &nbsp;&middot;&nbsp; Father: @selectedStudent.FatherName
                                }
                                else
                                {
                                    @:Search and select a student to view fee details.
                                }
                            </div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2">

                        <div class="form-box">
                            <label class="form-label">RECEIPT DATE</label>
                            <InputDate @bind-Value="studentDetailsForFeeRequest.ReceiptDate"
                                       class="form-input" />
                        </div>

                        <button type="button"
                                class="table-btn mt-3"
                                @onclick="StudentDetails">
                            Student details
                        </button>

                    </div>

                </div>
            </div>
        </div>

        <div class="col-12 p-1 ">

            <div class="d-flex align-items-center gap-2">
                <div class="form-box">
                    <button type="button" class="table-btn active">Collect fee</button>

                </div>
                <div class="form-box">
                    <button type="button" class="table-btn" @onclick="OpenLedgerPopup">Ledger details</button>

                </div>
                <div class="form-box">
                    <button type="button" class="table-btn" @onclick="OpenTransportPopup">Map transport</button>

                </div>
                <div class="form-box">
                    <button type="button" class="table-btn" @onclick="OpenConcessionPopup">Map concession</button>
                </div>
                <div class="form-box">
                    <button type="button" class="table-btn" @onclick="OpenWaivePopup">Waive off</button>

                </div>
                <div class="form-box">
                    <button type="button" class="table-btn" @onclick="OpenAdvancePopup">Advance fee</button>

                </div>
                <div class="form-box">
                    <button type="button" class="table-btn" @onclick="OpenChallanPopup">Generate challan</button>

                </div>
                <div class="form-box">
                    <button type="button" class="table-btn" @onclick="OpenAdjustPopup">Adjust advance</button>
                </div>


            </div>

        </div>


        <div class="col-12 col-lg-8 p-1">
            <div class="card h-100">
                <div class="card-body table-card p-0">
                    <div class="quick-main">
                        <div class="d-flex align-items-start justify-content-between flex-wrap gap-3 mb-3">
                            <div>
                                <div class="fee-head-title" style="font-size:15px;">Fee particulars</div>
                                <div class="fee-head-sub">Review dues and enter the amount being paid.</div>
                            </div>
                            <div class="d-flex gap-2 mt-2">
                                <div class="form-box-group static-label mb-0" style="min-width:140px;">
                                    <select class="floating-input w-100" @bind="SelectedTillMonth" @bind:after="OnTillMonthChanged">
                                        @foreach (var month in distinctMonths)
                                        {
                                            <option value="@month.MonthNo">@month.MonthDisplay</option>
                                        }
                                    </select>
                                    <label class="floating-label" style="white-space:nowrap;">Collect up to</label>
                                </div>
                                <div class="form-box-group static-label mb-0" style="min-width:180px;">
                                    <select class="floating-input w-100">
                                        <option>School Fee Account</option>
                                    </select>
                                    <label class="floating-label" style="white-space:nowrap;">Deposit account</label>
                                </div>
                            </div>
                        </div>
                        <div class="grid-box">
                            <QuickGrid Items="@moduleQuery" Pagination="@pagination" Class="table">

                                <TemplateColumn Title="Feehead" Align="Align.Left">
                                    <ChildContent>
                                        @(string.IsNullOrWhiteSpace(context.FeeHeadName) ? " " : context.FeeHeadName)
                                    </ChildContent>
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" @bind="nameFilter" @bind:event="oninput" placeholder="Feehead name..." />
                                        </div>
                                    </ColumnOptions>
                                </TemplateColumn>
                                <PropertyColumn Sortable="true" Align="Align.Center" class="text-center" Property="@(x => x.MonthDisplay)" Title="Month">

                                </PropertyColumn>
                                @* every amount shows as ₹1,24,000.00 *@
                                <TemplateColumn Title="Amount" Align="Align.Center" class="text-right" Sortable="true" SortBy="@(GridSort<FeeCollectionDuesNew>.ByAscending(x => x.Amount))">
                                    <ChildContent>@Money(context.Amount)</ChildContent>
                                </TemplateColumn>
                                <TemplateColumn Title="Concession" Align="Align.Center" class="text-right" Sortable="true" SortBy="@(GridSort<FeeCollectionDuesNew>.ByAscending(x => x.Concession))">
                                    <ChildContent>@Money(context.Concession)</ChildContent>
                                </TemplateColumn>
                                <TemplateColumn Title="Waive Off" Align="Align.Center" class="text-right">
                                    <ChildContent>@Money(context.WaiveOff)</ChildContent>
                                </TemplateColumn>
                                <TemplateColumn Title="Payable" Align="Align.Center" class="text-right">
                                    <ChildContent>@Money(context.Payable)</ChildContent>
                                </TemplateColumn>
                                <TemplateColumn Title="Received" Align="Align.Center" class="text-right">
                                    <ChildContent>@Money(context.ReceivedAmt)</ChildContent>
                                </TemplateColumn>
                                @* paying amount is filled month by month (April first) *@
                                <TemplateColumn Title="Paying" Align="Align.Center" class="text-right">
                                    <ChildContent>
                                        @Money(GetRowPaying(context))
                                    </ChildContent>
                                </TemplateColumn>

                                <TemplateColumn Title="Status" Align="Align.Center">
                                    <ChildContent>
                                        <div class="text-center">
                                            <button type="button"
                                                    class="btn btn-link text-danger p-0"
                                                    title="Delete">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </div>
                                    </ChildContent>
                                </TemplateColumn>

                            </QuickGrid>
                        </div>
                        <div class="footer-pagination mt-3">
                            <div class="d-flex align-items-center">
                                <div class="welcome-text w-100">
                                    <Paginator State="@pagination" />
                                </div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center justify-content-between mt-4">
                            <div class="fee-head-sub">
                                <i class="bi bi-info-circle"></i>
                                You can collect a partial amount by editing "Paying now".
                            </div>
                            <a href="javascript:void(0)" class="fee-head-sub" @onclick="ResetAmounts">Reset amounts</a>
                        </div>


                    </div>

                </div>
            </div>

        </div>

        <div class="col-12 col-lg-4 p-1">
            <div class="amount-to-collect-card mb-2">
                <div class="row g-2">
                    <div class="col-6">
                        <div class="amount-stat-label">TOTAL FEE</div>
                        <div class="amount-stat-value">@Money(TotalAmount)</div>
                    </div>
                    @* already received earlier against these dues (partly paid months) *@
                    <div class="col-6">
                        <div class="amount-stat-label">TOTAL RECEIVED</div>
                        <div class="amount-stat-value">@Money(TotalReceived)</div>
                    </div>
                    <div class="col-6">
                        <div class="amount-stat-label">PREVIOUS ADVANCE</div>
                        <div class="amount-stat-value">@(IsStudentSelected ? Money(selectedStudent.PreviousBalance) : "-")</div>
                    </div>
                    <div class="col-6">
                        <div class="amount-stat-label">CONCESSION</div>
                        <div class="amount-stat-value">@Money(TotalConcession)</div>
                    </div>
                    @* payable = total fee - received - concession - waive off + late fee *@
                    <div class="col-6">
                        <div class="amount-stat-label">PAYABLE</div>
                        <div class="amount-stat-value">@Money(TotalWithLateFee)</div>
                    </div>
                    <div class="col-6">
                        <div class="amount-stat-label">BALANCE</div>
                        <div class="amount-stat-value">@Money(RemainingBalance)</div>
                    </div>
                </div>
                <div class="amount-divider"></div>
                <div class="row g-2 align-items-end">
                    <div class="col-7">
                        <div class="amount-to-collect-label">AMOUNT TO COLLECT</div>
                        <div class="amount-to-collect-value mb-2">@Money(PayingAmount)</div>
                    </div>
                    <div class="col-5 text-end">
                        @* late fee is always shown; it is added to the payable only when collecting up to the last month *@
                        <div class="amount-stat-label">LATE FEE</div>
                        <div class="amount-stat-value mb-2">@(IsStudentSelected ? Money(selectedStudent.LateFee) : "-")</div>
                        @if (IsStudentSelected && selectedStudent.LateFee > 0 && ApplicableLateFee == 0)
                        {
                            <div class="amount-stat-label mb-2" style="font-size:10px;">Added when collecting up to the last month</div>
                        }
                    </div>
                </div>
                <div class="d-flex align-items-center justify-content-between">
                    <span>Remaining balance @Money(RemainingBalance)</span>
                    @if (RemainingBalance > 0)
                    {
                        <span class="balance-badge">Partial payment</span>
                    }
                    else if (PayingAmount > 0)
                    {
                        <span class="balance-badge" style="background:#22c55e;">Full payment</span>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <div class="fee-head-title mb-3" style="font-size:15px;">Payment details</div>

                    <label class="fee-head-sub d-block mb-2">Payment mode</label>
                    <div class="d-flex gap-2 mb-3">
                        <button type="button" class="payment-mode-btn @(SelectedPaymentMode == "Cash" ? "active" : "")" @onclick='() => SelectPaymentMode("Cash")'>
                            Cash
                        </button>

                        <button type="button" class="payment-mode-btn @(SelectedPaymentMode == "UPI" ? "active" : "")" @onclick='() => SelectPaymentMode("UPI")'>
                            UPI
                        </button>
                        <button type="button" class="payment-mode-btn @(SelectedPaymentMode == "Cheque" ? "active" : "")" @onclick='() => SelectPaymentMode("Cheque")'>
                            Cheque
                        </button>
                    </div>

                    @if (SelectedPaymentMode == "Cash")
                    {
                        <div class="form-box-group mb-3">
                            <input type="number"
                                   class="floating-input"
                                   min="0.01"
                                   step="0.01"
                                   @bind="@CashPaymentAmount"
                                   @bind:event="oninput"
                                   @onchange="ValidateCashPaymentAmount"
                                   placeholder="Optional for cash payment" />
                            <label class="floating-label">Paying</label>
                        </div>
                    }
                    else
                    {
                        <div class="form-box-group mb-3">
                            <input type="text"
                                   class="floating-input"
                                   placeholder="Enter reference / transaction no." />

                            <label class="floating-label">Reference / transaction no.</label>
                        </div>
                    }

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <div class="form-box-group static-label mb-0">
                                <input type="text" class="floating-input" value="08-09-2026" />
                                <label class="floating-label">Payment date</label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-box-group static-label mb-0">
                                <select class="floating-input">
                                    <option>Accounts Desk</option>
                                </select>
                                <label class="floating-label">Received by</label>
                            </div>
                        </div>
                    </div>

                    <label class="form-label d-block mb-2">Remark</label>
                    <InputTextArea class="fee-remark" @bind-Value="adjustStudentFeeHeadWise.Remark" rows="2" placeholder="Add an internal note (optional)"></InputTextArea>
                    <div class="row g-2 mt-3">
                        <div class="col-4">

                            <div class="form-box">
                                <button class="ui fade op-1 animated button form-btn w-100" tabindex="0" @onclick="OpenReceiptPreview">
                                    <div class="visible content justify-content-center">Preview</div>
                                    <div class="hidden content">
                                        <i class="bi bi-eye"></i>
                                    </div>
                                </button>

                            </div>
                        </div>
                        <div class="col-8">


                            <button class="ui fade op-1 animated button form-btn w-100" tabindex="0" @onclick="OnSaveFeeCollection">
                                <div class="visible content justify-content-center">Collect @Money(PayingAmount)</div>
                                <div class="hidden content">
                                    <i class="bi bi-check-lg"></i>
                                </div>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mt-2">
                <div class="card-body d-flex align-items-start gap-2">
                    <span class="ready-dot mt-1"></span>
                    <div>
                        <div class="fee-head-title">Ready to collect</div>
                        <div class="fee-head-sub">All required details are complete.</div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
@if (ShowReceiptPreview)
{
    <div class="custom-modal row m-0 align-items-center">
        <div class="col-12 col-sm-8 col-md-6 col-lg-5 col-xl-5">
            <div class="modal-content clearfix main-popup">
                <div class="head-btn">
                    <h5 class="modal-title">Receipt preview</h5>
                    <button data-access="Close" type="button" @onclick="CloseReceiptPreview" class="close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <div class="receipt-preview-box card p-2">
                        <div class="receipt-preview-row justify-content-between">
                            <span class="student-suggest-label">Student</span>
                            <span class="student-suggest-value">@selectedStudent.StudentName &middot; @selectedStudent.ClassSection</span>
                        </div>
                        <div class="receipt-preview-row">
                            <span class="student-suggest-label">Admission no.</span>
                            <span class="student-suggest-value">@selectedStudent.ControlNo</span>
                        </div>
                        <div class="receipt-preview-row">
                            <span class="student-suggest-label">Payment mode</span>
                            <span class="student-suggest-value">@AdvancePaymentMode</span>
                        </div>
                        <div class="receipt-preview-row">
                            <span class="student-suggest-label">Receipt date</span>
                            <span class="student-suggest-value">@studentDetailsForFeeRequest.ReceiptDate.ToString("d MMM yyyy")</span>
                        </div>
                        <div class="receipt-preview-divider"></div>
                        <div class="receipt-preview-row">
                            <span class="student-suggest-label" style="font-size:14px;">Amount</span>
                            <span class="student-suggest-value" style="font-size:18px;">@Money(PayingAmount)</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="form-group btn-gr d-flex">
                        <SaveUpdateButton ShowSaveButton="false" Text="Go Back" OnClickCancel="CloseReceiptPreview" />
                        <div class="form-box">

                            <button class="ui fade op-1 animated button form-btn w-100" tabindex="0" @onclick="ConfirmPayment">
                                <div class="visible content justify-content-center">Confirm payment</div>
                                <div class="hidden content">
                                    <i class="bi bi-check-lg"></i>
                                </div>
                            </button>
                        </div>


                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (ShowLedgerPopup)
{
    <div class="custom-modal row m-0">
        <div class="col-12 col-xl-12">
            <div class="modal-content clearfix main-popup">
                <div class="head-btn">
                    <h5 class="modal-title">Student fee ledger</h5>
                    <button data-access="Close" type="button" @onclick="CloseLedgerPopup" class="close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="overflow-auto" style="height: calc(125vh - 280px); min-height: 400px; border-radius:10px;">
                    <div class="modal-body">
                        <div class="tab-content form-tab-count">
                            <ViewStudentReceipt @ref="ledgerReceiptRef" classs=""
                                                SearchTerm="@(IsStudentSelected && !string.IsNullOrWhiteSpace(selectedStudent.ControlNo) ? selectedStudent.ControlNo : searchTerm)"
                                                SessionId="@CurrentSession"
                                                FeeDues="@feeCollectionDuelist"
                                                OnClose="CloseLedgerPopup"></ViewStudentReceipt>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="form-group btn-gr d-flex">
                        <SaveUpdateButton ShowSaveButton="false" Text="Close" OnClickCancel="CloseLedgerPopup" />
                        <div class="form-box">
                            <button class="ui fade op-1 animated button form-btn w-100" tabindex="0" @onclick="CloseLedgerPopup">
                                <div class="visible content justify-content-center">Print ledger</div>
                                <div class="hidden content">
                                    <i class="bi bi-printer"></i>
                                </div>
                            </button>
                        </div>
                        <div class="form-box">
                            <button type="button" class="table-btn" @onclick="OpenLedgerEditInvoice">
                                Edit Invoice
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<MapTransportWithStudent IsVisible="@ShowTransportPopup" CurrentSessionData="@CurrentSession" SetStudentMapTransportList="@transportStudentList" CurrectUrl="@currentUrl" OnSaveSuccess="@CloseTransportPopup" OnClose="@CloseTransportPopup" />

@if (ShowConcessionPopup)
{
    <div class="custom-modal row m-0">
        <div class="col-12 col-xl-11">
            <div class="modal-content clearfix main-popup">
                <div class="head-btn">
                    <h5 class="modal-title">Map student concession</h5>
                    <button data-access="Close" type="button" @onclick="CloseConcessionPopup" class="close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <div class="fee-module-content">
                        <p class="fee-head-sub mb-3">Choose whether the concession is a percentage or fixed amount.</p>

                        <div class="module-toolbar info">
                            <div class="field"><label>Session</label><input value="@selectedStudent.SessionName" readonly disabled /></div>
                            <div class="field"><label>Admission no.</label><input value="@selectedStudent.ControlNo" readonly disabled /></div>
                            <div class="field"><label>Student name</label><input value="@selectedStudent.StudentName" readonly disabled /></div>
                            <div class="field"><label>Class-section</label><input value="@selectedStudent.ClassSection" readonly disabled /></div>
                        </div>

                        <div class="module-grid">
                            <div class="module-panel">
                                <h3>Concession details</h3>
                                <div class="form-grid">
                                    <div class="field full">
                                        <label>Concession scheme</label>
                                        <select value="@MapConcessionId" @onchange="OnMapConcessionChanged" disabled="@IsFeeHeadLoading">
                                            <option value="0">Select concession</option>
                                            @foreach (var data in concessionlist.Where(x => x.IsValid == true))
                                            {
                                                <option value="@data.ConcessionId" style="@(data.Type == "General" ? "color:red;" : "")">
                                                    @data.Concession
                                                    @(data.Type == "General" ? " (General)" : "")
                                                </option>
                                            }
                                        </select>
                                    </div>
                                    <div class="field"><label>Valid from</label><input type="date" value="@mapConcessionDto.FromDate.ToString("yyyy-MM-dd")" readonly disabled /></div>
                                    <div class="field"><label>Valid until</label><InputDate @bind-Value="mapConcessionDto.ToDate" /></div>
                                    <div class="field">
                                        <label>Calculation type</label>
                                        <select value="@(MapIsAmount ? "Amount" : "Percentage")" @onchange="OnMapCalcTypeChanged" disabled="@IsMapGeneralSelected">
                                            <option value="Percentage">Percentage</option>
                                            <option value="Amount">Fixed amount</option>
                                        </select>
                                    </div>
                                    <div class="field">
                                        <label>Value</label>
                                        @* percentage: max 100 / amount: max the (smallest selected) fee head amount *@
                                        <input @key="mapValueKey" type="number" min="0" step="0.01"
                                               max="@(MapIsAmount ? MapMaxAmount : 100)"
                                               placeholder="@(MapIsAmount ? $"Enter amount (Max {Money(MapMaxAmount)})" : "Enter % (Max 100)")"
                                               value="@MapConcessionValue" @oninput="OnMapConcessionValueInput" disabled="@IsMapGeneralSelected" />
                                    </div>
                                </div>
                            </div>
                            <div class="module-panel">
                                <h3>Student details</h3>
                                <div class="receipt-row"><span>Student</span><strong>@selectedStudent.StudentName</strong></div>
                                <div class="receipt-row"><span>Admission no.</span><strong>@selectedStudent.ControlNo</strong></div>
                                <div class="receipt-row"><span>Class-section</span><strong>@selectedStudent.ClassSection</strong></div>
                                <div class="receipt-row"><span>Father</span><strong>@selectedStudent.FatherName</strong></div>
                                <div class="receipt-row total">
                                    <span>Current concession</span>
                                    <strong class="text-end">
                                        @if (CurrentStudentConcessions.Count == 0)
                                        {
                                            @:None
                                        }
                                        else
                                        {
                                            @foreach (var con in CurrentStudentConcessions)
                                            {
                                                <div class="d-flex align-items-center justify-content-end flex-wrap gap-1 mb-1">
                                                    @con.ConcessionName
                                                    <span class="badge rounded-pill @(con.Status == 1 ? "bg-success" : con.Status == 2 ? "bg-danger" : "bg-warning text-dark")" style="font-size:10px;">
                                                        @(con.Status == 1 ? "Approved" : con.Status == 2 ? "Rejected" : "Pending")
                                                    </span>
                                                    @* left pending -> approve / reject it here *@
                                                    @if (con.Status == 0)
                                                    {
                                                        <button type="button" class="concession-toast-btn approve" disabled="@IsConcessionActionRunning" @onclick="() => ApproveConcession(con)">
                                                            @if (concessionAction == $"Approve-{con.ConcStudId}")
                                                            {
                                                                <span class="inline-spinner light"></span>
                                                                <span>Approving</span>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-check-lg"></i>
                                                                <span>Approve</span>
                                                            }
                                                        </button>
                                                        <button type="button" class="concession-toast-btn reject" disabled="@IsConcessionActionRunning" @onclick="() => RejectConcession(con)">
                                                            @if (concessionAction == $"Reject-{con.ConcStudId}")
                                                            {
                                                                <span class="inline-spinner light"></span>
                                                                <span>Rejecting</span>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-x-lg"></i>
                                                                <span>Reject</span>
                                                            }
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        }
                                    </strong>
                                </div>
                            </div>
                        </div>

                        <section class="module-section mt-3">
                            <div class="module-section-head"><h3>Apply to fee heads</h3><span>@(IsMapGeneralSelected ? "General concession - fee heads are fixed" : "Select eligible heads")</span></div>
                            @if (IsFeeHeadLoading)
                            {
                                <div class="inline-loader">
                                    <span>Loading fee heads</span>
                                    <span class="inline-spinner" role="status" aria-hidden="true"></span>
                                </div>
                            }
                            else if (MapConcessionId == 0)
                            {
                                <div class="fee-head-sub" style="padding:13px;">Select a concession to view its fee heads.</div>
                            }
                            else if (mapFeeHeadList.Count == 0)
                            {
                                <div class="fee-head-sub" style="padding:13px;">No fee head found for this concession.</div>
                            }
                            else
                            {
                                <div class="period-list">
                                    @foreach (var head in mapFeeHeadList)
                                    {
                                        <label class="period-option">
                                            <input class="check-cell" type="checkbox" @bind="head.IsSelected" disabled="@IsMapGeneralSelected" />
                                            <span>
                                                <strong>@head.FeeHeadName</strong><br />
                                                <small>
                                                    @Money(head.FeeHeadAmount)
                                                    @if (IsMapGeneralSelected && head.ConcessionApplicable > 0)
                                                    {
                                                        @: &middot; @(head.IsSelectedPersentage ? Money(head.ConcessionApplicable ?? 0) : $"{head.ConcessionApplicable:0.##}%")
                                                    }
                                                </small>
                                            </span>
                                        </label>
                                    }
                                </div>
                            }
                            <div class="field" style="padding: 0 13px 13px;">
                                <label>Remarks <span class="text-danger">*</span></label>
                                <textarea placeholder="Reason or approval reference" @bind="mapConcessionDto.Remarks"></textarea>
                            </div>
                        </section>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="form-group btn-gr d-flex">
                        <SaveUpdateButton ShowSaveButton="false" Text="Close" OnClickCancel="CloseConcessionPopup" />
                        <div class="form-box">

                            <button class="ui fade op-1 animated button form-btn w-100" tabindex="0" @onclick="SaveMapConcession" disabled="@IsFeeHeadLoading">
                                <div class="visible content justify-content-center">Save concession</div>
                                <div class="hidden content">
                                    <i class="bi bi-percent"></i>
                                </div>
                            </button>
                        </div>


                    </div>

                </div>
            </div>
        </div>
    </div>
}

