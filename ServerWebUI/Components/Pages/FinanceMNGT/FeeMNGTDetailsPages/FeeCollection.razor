@page "/feecollectionnew"
@using DomainModel.Admin
@using Microsoft.AspNetCore.Authorization
@using static DomainModel.FinanceMNGT.FeeCollectionDuesNew
@inject IHttpClientFactory ClientFactory
@using DomainModel.SchoolMaster
@using Microsoft.AspNetCore.Components.QuickGrid
@using ServerWebUI.Components.Common
@inject ICommonMethod _commonmethod
@using System.Net
@using System.Drawing;
@using System.Text.Json
@using MyApp.Common
@using System.Text.RegularExpressions
@using ServerWebUI.Components.Pages.CommonPages
@inject IJSRuntime JS
@inject Shared.IHttpService httpService
@inject HttpClient Http
@inject IStringLocalizer<Resource> Localizer
@inject SweetAlertService Alert
@inject IWebHostEnvironment env
@rendermode InteractiveServer


<style>
    .quickgrid thead th:last-child {
        min-width: 70px;
    }

    .quickgrid thead th:nth-last-child(2) {
        min-width: 50px;
    }

    .student-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #dbeafe;
        color: #1d4ed8;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
    }

    .student-name {
        font-weight: 700;
        font-size: 15px;
    }

    .student-sub {
        font-size: 12.5px;
        color: #6c757d;
    }

    .fee-search-box {
        position: relative;
        min-width: 260px;
    }

        .fee-search-box input {
            width: 100%;
            border: 1px solid #d9d9d9;
            border-radius: 8px;
            padding: 8px 12px 8px 34px;
            font-size: 13px;
        }

        .fee-search-box i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
        }

    .receipt-date-label {
        font-size: 11px;
        color: #6c757d;
        letter-spacing: .04em;
    }

    .receipt-date-value {
        font-weight: 600;
        font-size: 14px;
    }

    .fee-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13.5px;
    }

        .fee-table thead th {
            text-align: left;
            font-size: 11px;
            color: #6c757d;
            letter-spacing: .04em;
            border-bottom: 1px solid #e5e7eb;
            padding: 8px 10px;
        }

        .fee-table tbody td {
            padding: 12px 10px;
            border-bottom: 1px solid #f1f3f5;
            vertical-align: middle;
        }

    .fee-head-title {
        font-weight: 600;
    }

    .fee-head-sub {
        font-size: 12px;
        color: #9ca3af;
    }

    .paying-now-input {
        width: 90px;
        border: 1px solid #93c5fd;
        border-radius: 6px;
        padding: 6px 8px;
        text-align: right;
        font-weight: 600;
    }

    .amount-to-collect-card {
        background: linear-gradient(135deg, var(--navy), #14557f);
        color: #fff;
        border-radius: 10px;
        padding: 20px;
    }

    .amount-to-collect-label {
        font-size: 11px;
        letter-spacing: .05em;
        color: #b7c6da;
    }

    .amount-to-collect-value {
        font-size: 30px;
        font-weight: 700;
        margin: 4px 0 12px 0;
    }

    .balance-badge {
        background: #f59e0b;
        color: #1f2937;
        font-size: 11px;
        font-weight: 700;
        padding: 2px 10px;
        border-radius: 12px;
    }

    .amount-divider {
        border-top: 1px solid rgba(255,255,255,.15);
        margin: 16px 0;
    }

    .amount-stat-label {
        font-size: 11px;
        color: #b7c6da;
    }

    .amount-stat-value {
        font-size: 15px;
        font-weight: 700;
    }

    .payment-mode-btn {
        flex: 1;
        border: 1px solid #d9d9d9;
        border-radius: 8px;
        padding: 10px;
        text-align: center;
        font-weight: 600;
        font-size: 13.5px;
        background: #fff;
        cursor: pointer;
    }

        .payment-mode-btn.active {
            border-color: #0d9488;
            color: #0d9488;
            background: #f0fdfa;
        }

    .fee-remark {
        width: 100%;
        border: 1px solid #d9d9d9;
        border-radius: 8px;
        padding: 10px;
        font-size: 13px;
        resize: none;
    }

    .crumb {
        display: flex;
        gap: 10px;
        align-items: center;
        color: #2455a6;
        margin-bottom: 10px;
    }

    .ready-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #16a34a;
        display: inline-block;
    }

    .receipt-preview-box {
        border: 1px dashed #cbd5e1;
        border-radius: 10px;
        padding: 16px;
    }

    .receipt-preview-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 6px 0;
    }

    .receipt-preview-divider {
        border-top: 1px solid #e5e7eb;
        margin: 10px 0;
    }

    .student-search-wrap {
        position: relative;
        min-width: 550px;
    }

    .student-suggest-box {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        margin-top: 4px;
        border: 1px solid #d9d9d9;
        border-radius: 8px;
        background: #fff;
        max-height: 500px;
        overflow-y: auto;
        box-shadow: 0 4px 10px rgba(0,0,0,.08);
        z-index: 1050;
    }



   
    .student-suggest-item {
        display: grid;
        grid-template-columns: 2fr 1.4fr 1fr 1.6fr;
        gap: 20px;
        padding: 10px 14px;
        cursor: pointer;
        background: #fff;
        border-bottom: 1px solid #f1f3f5;
        cursor: pointer;
    }

        .student-suggest-item:hover {
            background: #f7f9fc;
        }

    .student-suggest-column {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .student-suggest-label {
        font-size: 12px;
        font-weight: 500;
        margin-bottom: 2px;
        color: #263238;
    }

    .student-suggest-value {
        font-size: 11px;
        font-weight: 600;
        color: #8a94a6;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }



    .student-suggest-item:last-child {
        border-bottom: none;
    }

    .student-suggest-item:hover {
        background: #f8f9fa;
    }

    .student-suggest-empty {
        padding: 14px;
        color: #6c757d;
        font-size: 13px;
    }

    /* ===================== Fee module popup content =====================
                   Scoped under .fee-module-content so it never leaks outside these
                   popups. Inner design ported from the static reference; only the
                   outer popup shell (custom-modal / head-btn / modal-body / modal-footer)
                   follows our own convention. */
    .fee-module-content {
        --m-navy: #0b2948;
        --m-line: #dbe4ee;
        --m-muted: #68778a;
        --m-soft: #f3f7fb;
        --m-green: #15835b;
        color: #172334;
        font-size: 13.5px;
    }

        .fee-module-content .icon {
            width: 18px;
            height: 18px;
            display: inline-block;
            vertical-align: -4px;
            stroke: currentColor;
            stroke-width: 2;
            fill: none;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .fee-module-content .hint {
            color: var(--m-muted);
            font-size: 12px;
            display: flex;
            align-items: center;
            gap: 6px;
            margin-top: 15px;
        }

        .fee-module-content .module-toolbar {
            display: grid;
            grid-template-columns: repeat(4, minmax(145px, 1fr)) auto;
            gap: 11px;
            align-items: end;
            background: #fff;
            border: 1px solid var(--m-line);
            border-radius: 12px;
            padding: 13px 14px;
            margin-bottom: 13px;
        }

            .fee-module-content .module-toolbar.compact {
                grid-template-columns: repeat(3, minmax(150px, 1fr)) auto;
            }

        .fee-module-content .field label {
            display: block;
            color: #5a6b7d;
            font-size: 12px;
            font-weight: 700;
            margin: 0 0 5px;
        }

        .fee-module-content .field input,
        .fee-module-content .field select,
        .fee-module-content .field textarea {
            width: 100%;
            border: 1px solid #cbd8e5;
            background: #fff;
            border-radius: 9px;
            outline: none;
            font: inherit;
        }

        .fee-module-content .field input,
        .fee-module-content .field select {
            height: 40px;
            padding: 0 11px;
        }

        .fee-module-content .field textarea {
            height: 66px;
            padding: 9px 11px;
            resize: vertical;
        }

        .fee-module-content .field.full {
            grid-column: 1 / -1;
        }

        .fee-module-content .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 13px;
        }

        .fee-module-content .module-search {
            height: 40px;
            white-space: nowrap;
        }

        .fee-module-content .module-summary {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
            margin-bottom: 13px;
        }

        .fee-module-content .summary-tile {
            background: #fff;
            border: 1px solid var(--m-line);
            border-radius: 11px;
            padding: 12px 14px;
        }

            .fee-module-content .summary-tile span {
                display: block;
                color: var(--m-muted);
                font-size: 11px;
                text-transform: uppercase;
                font-weight: 750;
                letter-spacing: .35px;
            }

            .fee-module-content .summary-tile strong {
                display: block;
                text-align: right;
                font-size: 18px;
                margin-top: 3px;
            }

            .fee-module-content .summary-tile.featured {
                color: #fff;
                background: linear-gradient(135deg, var(--m-navy), #14577d);
                border-color: transparent;
            }

                .fee-module-content .summary-tile.featured span {
                    color: #bfdae9;
                }

        .fee-module-content .module-section {
            background: #fff;
            border: 1px solid var(--m-line);
            border-radius: 12px;
            overflow: hidden;
            margin-bottom: 13px;
        }

        .fee-module-content .module-section-head {
            min-height: 48px;
            padding: 10px 14px;
            border-bottom: 1px solid var(--m-line);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

            .fee-module-content .module-section-head h3 {
                margin: 0;
                font-size: 15px;
            }

            .fee-module-content .module-section-head span {
                color: var(--m-muted);
                font-size: 12px;
            }

        .fee-module-content .module-table-wrap {
            overflow: auto;
        }

        .fee-module-content .module-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 640px;
        }

            .fee-module-content .module-table th {
                font-size: 11px;
                text-transform: uppercase;
                letter-spacing: .42px;
                text-align: left;
                color: #607286;
                background: #f5f8fb;
                border-bottom: 1px solid var(--m-line);
                padding: 11px 12px;
            }

            .fee-module-content .module-table td {
                border-bottom: 1px solid #e8eef4;
                padding: 11px 12px;
            }

            .fee-module-content .module-table tr:last-child td {
                border-bottom: 0;
            }

            .fee-module-content .module-table .num {
                text-align: right;
                font-variant-numeric: tabular-nums;
            }

        .fee-module-content .module-input {
            height: 36px;
            border: 1px solid #bdcddd;
            border-radius: 8px;
            background: #fff;
            padding: 0 9px;
            outline: none;
            width: 100%;
            font: inherit;
        }

            .fee-module-content .module-input.num {
                text-align: right;
            }

        .fee-module-content .check-cell {
            width: 18px;
            height: 18px;
            accent-color: #118c91;
        }

        .fee-module-content .module-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 13px;
        }

        .fee-module-content .module-panel {
            background: #fff;
            border: 1px solid var(--m-line);
            border-radius: 12px;
            padding: 15px;
        }

            .fee-module-content .module-panel h3 {
                font-size: 15px;
                margin: 0 0 13px;
            }

        .fee-module-content .empty-state {
            min-height: 200px;
            display: grid;
            place-items: center;
            text-align: center;
            color: var(--m-muted);
            padding: 24px;
        }

            .fee-module-content .empty-state .empty-icon {
                width: 48px;
                height: 48px;
                border-radius: 14px;
                background: #ebf5fa;
                color: #177a9b;
                display: grid;
                place-items: center;
                margin: 0 auto 10px;
            }

        .fee-module-content .period-list {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 9px;
            padding: 13px;
        }

        .fee-module-content .period-option {
            display: flex;
            align-items: center;
            gap: 9px;
            border: 1px solid var(--m-line);
            border-radius: 9px;
            padding: 10px;
            background: #fff;
        }

            .fee-module-content .period-option small {
                color: var(--m-muted);
            }

        .fee-module-content .ledger-columns {
            display: grid;
            grid-template-columns: 1.2fr 1fr 1fr;
            gap: 12px;
        }

        .fee-module-content .ledger-pane .module-section {
            height: 100%;
            margin: 0;
        }

        .fee-module-content .module-caption {
            font-size: 12px;
            color: var(--m-muted);
            padding: 10px 12px;
            background: #fbfdff;
            border-top: 1px solid var(--m-line);
        }

        .fee-module-content .receipt-row {
            display: flex;
            justify-content: space-between;
            gap: 20px;
            margin: 8px 0;
        }

            .fee-module-content .receipt-row span {
                color: var(--m-muted);
            }

            .fee-module-content .receipt-row.total {
                font-size: 16px;
                font-weight: 800;
                padding-top: 10px;
                margin-top: 8px;
                border-top: 1px solid var(--m-line);
            }

        .fee-module-content .module-payment-methods {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 7px;
        }

        .fee-module-content .module-pay-option {
            border: 1px solid #d1dde8;
            border-radius: 9px;
            background: #fff;
            min-height: 41px;
            font-size: 12px;
            font-weight: 720;
        }

            .fee-module-content .module-pay-option.active {
                border-color: #1690a6;
                color: #08798b;
                background: #e9f8fa;
                box-shadow: inset 0 0 0 1px #1690a6;
            }

    @@media (max-width: 900px) {
        .fee-module-content .module-toolbar,
        .fee-module-content .module-toolbar.compact,
        .fee-module-content .module-summary {
            grid-template-columns: 1fr 1fr;
        }

        .fee-module-content .module-grid,
        .fee-module-content .ledger-columns {
            grid-template-columns: 1fr;
        }

        .fee-module-content .period-list {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>

<div class="main-container">
    <div class="row m-0 main-row">

        <div class="col-12 p-1">
            <nav class="crumb" aria-label="Breadcrumb">
                <strong>Finance</strong><span>›</span>
                <span class="text-muted">Collect Fee</span>
            </nav>
        </div>

        <div class="col-12 p-1" id="main-header">
            <PageHeading Tittle="Fee Collection">
                <div class="form-box">
                    <InputSelect @bind-Value="CurrentSession" name="session" class="form-input">
                        <option value="0">-- Select Session --</option>
                        @foreach (var data in sessionlist.Where(x => x.IsValid == true))
                        {
                            <option value="@data.SessionId">@data.SessionName </option>
                        }
                    </InputSelect>
                </div>
                <div class="form-box student-search-wrap">
                    <input @key="searchInputKey" class="form-input" placeholder="Enter student no. or student name" @bind-Value="searchTerm" @bind-Value:event="oninput" @bind-Value:after="OnSearchTermChanged" @onkeydown="HandleSearchKeyDown" />

                    @if (ShowSuggestions)
                    {
                        <div class="student-suggest-box">
                            @if (filteredSuggestions.Count == 0)
                            {
                                <div class="student-suggest-empty">No matching student found.</div>
                            }
                            else
                            {
                                @foreach (var item in filteredSuggestions)
                                {

                                    <div class="student-suggest-item" @onclick="() => SelectStudent(item)">
                                        <div class="student-suggest-column">
                                            <span class="student-suggest-label">Student Name</span>
                                            <span class="student-suggest-value">@item.StudentName</span>
                                        </div>
                                        <div class="student-suggest-column">
                                            <span class="student-suggest-label">Admission No.</span>
                                            <span class="student-suggest-value">@item.ControlNo</span>
                                        </div>
                                        <div class="student-suggest-column">
                                            <span class="student-suggest-label">Class</span>
                                            <span class="student-suggest-value">@item.ClassSection</span>
                                        </div>
                                        <div class="student-suggest-column">
                                            <span class="student-suggest-label">Father</span>
                                            <span class="student-suggest-value">@item.FatherName</span>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
                <div class="form-box">
                    <button class="ui fade op-1 animated button form-btn" tabindex="0" @onclick="SearchStudent">
                        <div class="visible content justify-content-center">Search</div>
                        <div class="hidden content">
                            <i class="bi bi-search"></i>
                        </div>
                    </button>
                </div>
            </PageHeading>
        </div>
        <div class="col-12 p-1">
            <div class="card">
                <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-3">

                    <div class="d-flex align-items-center gap-2">
                        <div class="student-avatar">
                            @GetInitials(IsStudentSelected ? selectedStudent.StudentName : null)
                        </div>

                        <div>
                            <div class="student-name">
                                @(IsStudentSelected ? selectedStudent.StudentName : "No student selected")
                            </div>

                            <div class="student-sub">
                                @if (IsStudentSelected)
                                {
                                    @:Admission no. @selectedStudent.ControlNo &nbsp;&middot;&nbsp; Class @selectedStudent.ClassSection &nbsp;&middot;&nbsp; Father: @selectedStudent.FatherName
                                }
                                else
                                {
                                    @:Search and select a student to view fee details.
                                }
                            </div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2">

                        <div class="form-box">
                            <label class="form-label">RECEIPT DATE</label>
                            <InputDate @bind-Value="studentDetailsForFeeRequest.ReceiptDate"
                                       class="form-input" />
                        </div>

                        <button type="button"
                                class="table-btn mt-3"
                                @onclick="StudentDetails">
                            Student details
                        </button>

                    </div>

                </div>
            </div>
        </div>

        <div class="col-12 p-1 ">

            <div class="d-flex align-items-center gap-2">
                <div class="form-box">
                    <button type="button" class="table-btn active">Collect fee</button>

                </div>
                <div class="form-box">
                    <button type="button" class="table-btn" @onclick="OpenLedgerPopup">Ledger details</button>

                </div>
                <div class="form-box">
                    <button type="button" class="table-btn" @onclick="OpenTransportPopup">Map transport</button>

                </div>
                <div class="form-box">
                    <button type="button" class="table-btn" @onclick="OpenConcessionPopup">Map concession</button>
                </div>
                <div class="form-box">
                    <button type="button" class="table-btn" @onclick="OpenWaivePopup">Waive off</button>

                </div>
                <div class="form-box">
                    <button type="button" class="table-btn" @onclick="OpenAdvancePopup">Advance fee</button>

                </div>
                <div class="form-box">
                    <button type="button" class="table-btn" @onclick="OpenChallanPopup">Generate challan</button>

                </div>
                <div class="form-box">
                    <button type="button" class="table-btn" @onclick="OpenAdjustPopup">Adjust advance</button>
                </div>


            </div>

        </div>


        <div class="col-12 col-lg-8 p-1">
            <div class="card h-100">
                <div class="card-body table-card p-0">

                    <div class="quick-main">
                        <div class="d-flex align-items-start justify-content-between flex-wrap gap-3 mb-3">
                            <div>
                                <div class="fee-head-title" style="font-size:15px;">Fee particulars</div>
                                <div class="fee-head-sub">Review dues and enter the amount being paid.</div>
                            </div>
                            <div class="d-flex gap-2 mt-2">
                                <div class="form-box-group static-label mb-0" style="min-width:140px;">
                                    <select class="floating-input w-100" @bind="SelectedTillMonth" @bind:after="OnTillMonthChanged">
                                        @foreach (var month in distinctMonths)
                                        {
                                            <option value="@month.MonthNo">@month.MonthDisplay</option>
                                        }
                                    </select>
                                    <label class="floating-label" style="white-space:nowrap;">Collect up to</label>
                                </div>
                                <div class="form-box-group static-label mb-0" style="min-width:180px;">
                                    <select class="floating-input w-100">
                                        <option>School Fee Account</option>
                                    </select>
                                    <label class="floating-label" style="white-space:nowrap;">Deposit account</label>
                                </div>
                            </div>
                        </div>
                        <div class="grid-box">
                            <QuickGrid Items="@moduleQuery" Pagination="@pagination" Class="table">

                                <TemplateColumn Title="Feehead" Align="Align.Left">
                                    <ChildContent>
                                        @(string.IsNullOrWhiteSpace(context.FeeHeadName) ? " " : context.FeeHeadName)
                                    </ChildContent>
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" @bind="nameFilter" @bind:event="oninput" placeholder="Feehead name..." />
                                        </div>
                                    </ColumnOptions>
                                </TemplateColumn>
                                <PropertyColumn Sortable="true" Align="Align.Center" class="text-center" Property="@(x => x.MonthDisplay)" Title="Month">

                                </PropertyColumn>
                                <PropertyColumn Sortable="true" Align="Align.Center" class="text-right" Property="@(x => x.Amount)" Title="Amount">

                                </PropertyColumn>

                                <PropertyColumn Align="Align.Center" class="text-right" Sortable="true" Property="@(x => x.Concession)" Title="Concession" />
                                <PropertyColumn Property="@(x => x.WaiveOff)" Title="Waive Off" Align="Align.Center" class="text-right">

                                </PropertyColumn>
                                <PropertyColumn Title="Payable" Property="@(x => x.Payable)" Align="Align.Center" class="text-right">

                                </PropertyColumn>
                                <PropertyColumn Title="Paying" Property="@(x => x.Payable)" Align="Align.Center" class="text-right">

                                </PropertyColumn>

                                <TemplateColumn Title="Status" Align="Align.Center">
                                    <ChildContent>
