                await Alert.ShowWarning("Fee is collected, but the receipt could not be generated.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error printing fee receipt: {ex.Message}");
            IsLoading = false;
            StateHasChanged();
            await Alert.ShowWarning("Fee is collected, but the receipt could not be generated.");
        }
    }


