    private async Task OnMapConcessionValueInput(ChangeEventArgs e)
    {
        var text = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(text))
        {
            MapConcessionValue = null;
            return;
        }
        if (!decimal.TryParse(text, out var value) || value < 0)
        {
            ClearMapConcessionValue();
            return;
        }
        if (!MapIsAmount && value > 100)
        {
            ClearMapConcessionValue();
            await customAlert.ShowCustomAlert("Percentage cannot be more than 100.", false);
            return;
        }
        if (MapIsAmount && value > MapMaxAmount)
        {
            ClearMapConcessionValue();
            await customAlert.ShowCustomAlert($"Amount cannot exceed Fee Head Amount ({Money(MapMaxAmount)})", false);
            return;
        }
        MapConcessionValue = value;
    }

