    // counter receipt is saved as cash (same value goes on the printed receipt)
    private const string CounterPaymentMode = "Cash";

    private async Task OnSaveFeeCollection()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(searchTerm))
            {
                await Alert.ShowWarning("Please enter student name or student no to search.");
                StateHasChanged();
                return;
            }
            if (studentDetailsForFeeList.Count == 0)
            {
                await Alert.ShowWarning("Please fetch student data first.");
                StateHasChanged();
                return;
            }
            if (!IsStudentSelected)
            {
                await Alert.ShowWarning("Please select a student");
                StateHasChanged();
                return;
            }
            if (string.IsNullOrEmpty(adjustStudentFeeHeadWise.Remark))
            {
                await customAlert.ShowCustomAlert("Please enter remarks", false);
                StateHasChanged();
                return;
            }
            if (feeCollectionDuelist.Count == 0)
            {
                await Alert.ShowWarning("No fee dues found to collect.");
                StateHasChanged();
                return;
            }

            var allocation = GetPayingAllocation();
            var paidDues = allocation.Where(x => x.Value > 0).ToList();
            if (paidDues.Count == 0)
            {
                await Alert.ShowWarning("Please enter the paying amount.");
                StateHasChanged();
                return;
            }

            // No -> nothing changes, the entered details stay as they are
            if (!await Alert.ShowConfirm("Are you sure, you want to submit student fee?"))
                return;

            IsLoading = true;
            StateHasChanged();

            // late fee is added to the receipt by the save SP itself, so PaidAmount stays the dues part
            var lateFee = ChargedLateFee;
            // receipt data is taken now, the dues are reloaded after saving
            var receipt = BuildFeeReceipt(lateFee, allocation);

            adjustStudentFeeHeadWise.GroupCode = groupcode;
            adjustStudentFeeHeadWise.BranchCode = branchcode;
            adjustStudentFeeHeadWise.SessionId = CurrentSession;
            adjustStudentFeeHeadWise.StudentId = selectedStudent.StudentId;
            adjustStudentFeeHeadWise.ClassCode = selectedStudent.ClassCode;
            adjustStudentFeeHeadWise.SectionId = selectedStudent.SectionId;
            adjustStudentFeeHeadWise.PaidAmount = DuesPayingAmount;
            adjustStudentFeeHeadWise.Balance = selectedStudent.StudentBalance;
            adjustStudentFeeHeadWise.PaymentMode = CounterPaymentMode;
            adjustStudentFeeHeadWise.ChequeNo = "";
            adjustStudentFeeHeadWise.ChequeDate = null;
            adjustStudentFeeHeadWise.ChequeBank = "";
            adjustStudentFeeHeadWise.ChequeType = "";
            adjustStudentFeeHeadWise.LateFee = lateFee;
            adjustStudentFeeHeadWise.PreviousBalance = selectedStudent.PreviousBalance;
            adjustStudentFeeHeadWise.SocietyId = 0;
            adjustStudentFeeHeadWise.CreatedBy = UserName;
            adjustStudentFeeHeadWise.ReceiptDate = studentDetailsForFeeRequest.ReceiptDate;
            adjustStudentFeeHeadWise.BankAccountId = 1;
            adjustStudentFeeHeadWise.BankBranch = "";
            // only the rows this payment reaches; a partly paid row keeps its balance for the next receipt
            adjustStudentFeeHeadWise.FeeHeadDetails = paidDues
              .Select(p => new FeeHeadDetailModel
              {
                  FeeHeadId = (int)p.Key.FeeHeadId,
                  PaidAmount = p.Value,
                  LumpsumAmount = p.Key.Amount,
                  MonthNoCsv = p.Key.MonthNo.ToString(),
                  FeeHeadAmount = p.Key.Amount,
                  Concession = p.Key.Concession,
                  Deduction = p.Key.WaiveOff,
                  StatusFlag = p.Key.Status.ToString(),
                  DetInvoiceId = (int)p.Key.DetInvoiceId,
                  AdjustAmount = p.Key.Payable
              })
              .ToList();


            var response = await httpService.Post<ApiResponse<AdjustStudentFeeHeadWiseResponse>>("StudentFee/AdjustStudentFeeCollection", adjustStudentFeeHeadWise);

            if (response != null && response.Success && response.Data != null)
            {
                IsLoading = false;
                StateHasChanged();

                // Yes -> receipt opens in a new tab, then the success message
                receipt.ReceiptNo = response.Data.StudentReceiptNo;
                if (await Alert.ShowConfirm("Do you want to print receipt?"))
                    await PrintFeeReceipt(receipt);

                await Alert.ShowSuccess($"Fee collected successfully. Receipt No: {response.Data.StudentReceiptNo}");
                adjustStudentFeeHeadWise = new();
                await GetStudentFeeDetails();
                StateHasChanged();
            }
            else
            {
                IsLoading = false;
                allFeeCollectionDues = new();
                feeCollectionDuelist = new();
                distinctMonths = new();
                await Alert.ShowWarning("No student fee details found.");
            }

        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error collecting student fee: {ex.Message}");
            IsLoading = false;
            StateHasChanged();
            await Alert.ShowError("Unable to collect the fee. Please try again.");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // receipt print data, same layout as the admission receipt (Export/GenerateAdmitChildReceiptPdf):
    // one row per fee head with its months, e.g. "Tuition fee (May,Jun,Jul)", plus the late fee when charged
    // receipt shows the full payable of all due months (e.g. Apr-Mar 124000) and, separately, only what is paid now (e.g. 4000)
    private AdmitChildReceiptPrintModel BuildFeeReceipt(decimal lateFee, Dictionary<FeeCollectionDuesNew, decimal> allocation)
    {
        var dues = allFeeCollectionDues.OrderBy(x => GetSessionMonthOrder(x.MonthNo)).ToList();
        var months = dues.Select(x => x.MonthDisplay).Where(x => !string.IsNullOrEmpty(x)).Distinct().ToList();

        var feeHeads = dues
            .GroupBy(x => x.FeeHeadName)
            .Select(g => new AdmitChildReceiptPrintFeeHead
            {
                FeeHeadName = $"{g.Key} ({string.Join(",", g.Select(x => x.MonthDisplay).Where(x => !string.IsNullOrEmpty(x)).Distinct())})",
                Amount = g.Sum(x => x.Payable)
            })
            .ToList();
        // payable = the full amount shown when collecting all months (dues + student's late fee), e.g. 119540 + 460 = 120000,
        // even on a partial payment where the late fee is not charged yet
        var fullLateFee = Math.Max(lateFee, selectedStudent.LateFee);
        if (fullLateFee > 0)
            feeHeads.Add(new AdmitChildReceiptPrintFeeHead { FeeHeadName = "Late Fee", Amount = fullLateFee });

        var payable = dues.Sum(x => x.Payable) + fullLateFee;
        var paid = allocation.Values.Sum() + lateFee;
        return new AdmitChildReceiptPrintModel
        {
            ReceiptDate = studentDetailsForFeeRequest.ReceiptDate,
            RegistrationNo = selectedStudent.RegistrationNo,
            // "Student No." on the receipt shows the admission control no. (same as the admission receipt)
            StudentNo = selectedStudent.ControlNo,
            StudentName = selectedStudent.StudentName,
            FatherName = selectedStudent.FatherName,
            ClassName = selectedStudent.ClassName,
            SessionName = selectedStudent.SessionName,
            PeriodName = months.Count switch { 0 => "", 1 => months[0], _ => $"{months[0]} To {months[^1]}" },
            PaymentMode = CounterPaymentMode,
            // PDF prints Payable = TotalAmount - Concession, then Paid and Balance
            TotalAmount = payable,
            Concession = 0,
            PaidAmount = paid,
            // all dues still left after this receipt (incl. the unpaid part of a partly paid month)
            Balance = payable - paid,
            FeeHeads = feeHeads,
            AmountHeader = "Payable"
        };
    }

    // a print failure must not look like a collection failure, the fee is already saved
    private async Task PrintFeeReceipt(AdmitChildReceiptPrintModel receipt)
    {
        IsLoading = true;
