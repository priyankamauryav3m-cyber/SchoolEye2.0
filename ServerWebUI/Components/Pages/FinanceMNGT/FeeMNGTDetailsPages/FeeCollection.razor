    // the same fixed amount goes to every selected head, so it cannot exceed the smallest of them
    private decimal MapMaxAmount
    {
        get
        {
            var heads = mapFeeHeadList.Any(x => x.IsSelected) ? mapFeeHeadList.Where(x => x.IsSelected) : mapFeeHeadList;
            return heads.Any() ? heads.Min(x => x.FeeHeadAmount) : 0;
        }
    }

