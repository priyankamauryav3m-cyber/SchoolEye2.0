<StudentViewDetails IsVisible="@OpenDetail" SessionId="@CurrentSession" CurrectUrl="@currentUrl" StudentId="@SelectedStudentId" OnClose="@ClosePopup" />


@code {

    private bool ShowReceiptPreview = false;
    private string AdvancePaymentMode = "Cash";
    private bool OpenDetail = false;
    private long CurrentSession;
    private string? currentUrl;
    private string? branchcode;
    private string? groupcode;
    private string UserName;
    private bool IsLoading = false;
    private long SelectedStudentId = 0;
    private string? searchTerm;
    private string searchInputKey = Guid.NewGuid().ToString();
    private string? nameFilter = "";
    private string? studentNoFilter = "";
    private StudentDetailsForFeeRequest studentDetailsForFeeRequest = new();
    private GetStudentFeeHeadDuesForAdjustmentRequest getStudentFeeHeadDuesForAdjustment = new();
    private List<FeeCollectionDuesNew> feeCollectionDuelist = new();
    private List<FeeCollectionDuesNew> allFeeCollectionDues = new();
    private List<FeeCollectionDuesNew> distinctMonths = new();
    private List<StudentDetailsForFee> studentDetailsForFeeList = new();
    private List<StudentDetailsForFee> filteredSuggestions = new();
    private StudentDetailsForFee selectedStudent = new();
    private bool ShowSuggestions = false;
    private bool IsStudentSelected = false;
    private List<BranchClassModel> classlist = new();
    private List<SectionModel> sectionModellist = new();
    private List<SessionModel> sessionlist = new();
    private List<MonthModel> MonthList = new();
    private List<MonthModel> transportMonths = new();
    PaginationState pagination = new() { ItemsPerPage = 30 };
    private bool ShowLedgerPopup = false;
    private bool ShowTransportPopup = false;
    private bool ShowConcessionPopup = false;
    private bool ShowWaivePopup = false;
    private bool ShowAdvancePopup = false;
    private bool ShowChallanPopup = false;
    private bool ShowAdjustPopup = false;
    private int SelectedTillMonth = 4; // Default: April
    private readonly int academicStartYear = 2026; // ASSUMPTION - see notes above


    private void OpenLedgerPopup() { ShowLedgerPopup = true; StateHasChanged(); }
    private void CloseLedgerPopup() { ShowLedgerPopup = false; StateHasChanged(); }

    private void OpenTransportPopup() { ShowTransportPopup = true; StateHasChanged(); }
    private void CloseTransportPopup() { ShowTransportPopup = false; StateHasChanged(); }

    private void OpenConcessionPopup() { ShowConcessionPopup = true; StateHasChanged(); }
    private void CloseConcessionPopup() { ShowConcessionPopup = false; StateHasChanged(); }

    private void OpenWaivePopup() { ShowWaivePopup = true; StateHasChanged(); }
    private void CloseWaivePopup() { ShowWaivePopup = false; StateHasChanged(); }

    private void OpenAdvancePopup() { ShowAdvancePopup = true; StateHasChanged(); }
    private void CloseAdvancePopup() { ShowAdvancePopup = false; StateHasChanged(); }

    private void OpenChallanPopup() { ShowChallanPopup = true; StateHasChanged(); }
    private void CloseChallanPopup() { ShowChallanPopup = false; StateHasChanged(); }

    private void OpenAdjustPopup() { ShowAdjustPopup = true; StateHasChanged(); }
    private void CloseAdjustPopup() { ShowAdjustPopup = false; StateHasChanged(); }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {

            CurrentSession = await _commonmethod.SetCurrentSessionData();
            await LoadData();
            StateHasChanged();
        }
    }
    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchStudent();
        }
    }
    protected async Task LoadData()
    {
        var branchResult = await sessionStorage.GetAsync<string>("BranchCode");
        branchcode = branchResult.Value;
        var groupResult = await sessionStorage.GetAsync<string>("GroupCode");
        groupcode = groupResult.Value;
        var username = await sessionStorage.GetAsync<string>("UserName");
        UserName = username.Value;
        sessionlist = await httpService.Get<List<SessionModel>>("Session/GetSession") ?? new();
        classlist = await httpService.Get<List<BranchClassModel>>("BranchClass/GetClassCode") ?? new();
        string ApiUri1 = "Month/GetMonth";
        MonthList = await httpService.Get<List<MonthModel>>(ApiUri1) ?? new();
    }
    protected override async Task OnInitializedAsync()
    {

        PermissionState.OnChange += StateHasChanged;
        currentUrl = Nav.Uri;
        StateHasChanged();


    }
    protected IQueryable<FeeCollectionDuesNew> moduleQuery
    {
        get
        {
            var result = feeCollectionDuelist.AsQueryable();
            if (!string.IsNullOrEmpty(nameFilter))
            {
                result = result.Where(x => (x.FeeHeadName != null && x.FeeHeadName.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)));

            }
            return result;
        }
    }

    private decimal TotalAmount => feeCollectionDuelist.Sum(x => x.Amount);
    private decimal TotalConcession => feeCollectionDuelist.Sum(x => x.Concession);
    private decimal TotalPayable => feeCollectionDuelist.Sum(x => x.Payable);

    private DateTime ComputeTillDate(int monthNo)
    {
        int year = monthNo >= 4 ? academicStartYear : academicStartYear + 1;
        var lastDay = DateTime.DaysInMonth(year, monthNo);
        return new DateTime(year, monthNo, lastDay);
    }

    private void OnSearchTermChanged()
    {
        ShowSuggestions = false;
        filteredSuggestions = new();
        selectedStudent = new();
        SelectedStudentId = 0;
        IsStudentSelected = false;
        StateHasChanged();
    }

    private async Task SelectStudent(StudentDetailsForFee item)
    {
        selectedStudent = item;
        SelectedStudentId = item.StudentId;
        searchTerm = item.StudentName;
        searchInputKey = Guid.NewGuid().ToString();
        IsStudentSelected = true;
        ShowSuggestions = false;
        getStudentFeeHeadDuesForAdjustment.StudentId = item.StudentId;

        SelectedTillMonth = 4;
        getStudentFeeHeadDuesForAdjustment.TillDate = "";

        await GetStudentFeeDetails();
        StateHasChanged();
    }

    private void OnTillMonthChanged()
    {
        ApplyTillMonthFilter();
        StateHasChanged();
    }

    private void ApplyTillMonthFilter()
    {
        feeCollectionDuelist = allFeeCollectionDues
            .Where(x => x.MonthNo <= SelectedTillMonth)
            .ToList();
    }


    private async Task GetStudentFeeDetails()
    {
        try
        {
            IsLoading = true;
            getStudentFeeHeadDuesForAdjustment.GroupCode = groupcode;
            getStudentFeeHeadDuesForAdjustment.BranchCode = branchcode;
            getStudentFeeHeadDuesForAdjustment.SessionId = CurrentSession;
            getStudentFeeHeadDuesForAdjustment.BankAccountId = "0";

            var response = await httpService.Post<ApiResponse<List<FeeCollectionDuesNew>>>("StudentFee/GetStudentFeeCollectionDues", getStudentFeeHeadDuesForAdjustment);

            if (response != null && response.Success && response.Data != null && response.Data.Any())
            {
                allFeeCollectionDues = response.Data;

                distinctMonths = allFeeCollectionDues
                    .GroupBy(x => x.MonthNo)
                    .Select(g => g.First())
                    .OrderBy(x => x.MonthNo)
                    .ToList();

                SelectedTillMonth = distinctMonths.FirstOrDefault()?.MonthNo ?? SelectedTillMonth;

                ApplyTillMonthFilter();
            }
            else
            {
                allFeeCollectionDues = new();
                feeCollectionDuelist = new();
                distinctMonths = new();
                await Alert.ShowWarning(response?.Message ?? "No student fee details found.");
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching student details: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";

        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
            return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();

        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }

    private async Task SearchStudent()
    {
        try
        {
            IsLoading = true;
            if (string.IsNullOrWhiteSpace(searchTerm))
            {
                await Alert.ShowWarning("Please enter student name or student no to search.");
                IsLoading = false;
                StateHasChanged();
                return;
            }

            studentDetailsForFeeRequest.GroupCode = groupcode;
            studentDetailsForFeeRequest.BranchCode = branchcode;
            studentDetailsForFeeRequest.SessionId = CurrentSession;
            if (searchTerm.Any(char.IsLetterOrDigit) && searchTerm.Any(char.IsDigit))
            {
                studentDetailsForFeeRequest.ControlNo = searchTerm;
                studentDetailsForFeeRequest.StudentName = string.Empty;
            }
            else
            {
                studentDetailsForFeeRequest.ControlNo = string.Empty;
                studentDetailsForFeeRequest.StudentName = searchTerm;
            }

            var response = await httpService.Post<ApiResponse<List<StudentDetailsForFee>>>("StudentFee/GetStudentDetailsForFee", studentDetailsForFeeRequest);

            if (response != null && response.Success && response.Data != null && response.Data.Any())
            {
                studentDetailsForFeeList = response.Data;

                if (studentDetailsForFeeList.Count == 1)
                {
                    await SelectStudent(studentDetailsForFeeList[0]);
                }
                else
                {
                    filteredSuggestions = studentDetailsForFeeList;
                    selectedStudent = new();
                    IsStudentSelected = false;
                    ShowSuggestions = true;
                }
            }
            else
            {
                studentDetailsForFeeList = new();
                filteredSuggestions = new();
                selectedStudent = new();
                IsStudentSelected = false;
                ShowSuggestions = true;
                await Alert.ShowWarning(response?.Message ?? "No student found.");
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching student details: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task StudentDetails()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            await Alert.ShowWarning("Please enter student no to search.");
            StateHasChanged();
            return;
        }
        if (!IsStudentSelected)
        {
            await Alert.ShowWarning("Please fetch student data first.");
            StateHasChanged();
            return;
        }

        OpenDetail = true;
        StateHasChanged();
    }

    private void ClosePopup()
    {

        OpenDetail = false;

        StateHasChanged();
    }
    private async Task OpenReceiptPreview()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            await Alert.ShowWarning("Please enter student no to search.");
            StateHasChanged();
            return;
        }
        if (!IsStudentSelected)
        {
            await Alert.ShowWarning("Please fetch student data first.");
            StateHasChanged();
            return;
        }

        ShowReceiptPreview = true;
        StateHasChanged();
    }

    private void CloseReceiptPreview()
    {
        ShowReceiptPreview = false;
        StateHasChanged();
    }

    private Task ConfirmPayment()
    {
        // TODO: no collect-payment endpoint specified yet - wire this once provided.
        ShowReceiptPreview = false;
        StateHasChanged();
        return Task.CompletedTask;
    }
}
