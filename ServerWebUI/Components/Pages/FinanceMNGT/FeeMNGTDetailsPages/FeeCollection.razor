    private async Task GenerateStudentChallan()
    {
        challanInvoice.PeriodId = string.Join(",", challanPeriodList.Where(x => x.IsSelected).Select(x => x.PeriodId));
        string? warning = null;
        if (string.IsNullOrEmpty(challanInvoice.PeriodType))
            warning = "Please select a period type.";
        else if (string.IsNullOrEmpty(challanInvoice.PeriodId))
            warning = "Please select a period first.";
        else if (challanInvoice.InvoiceTypeId == 0)
            warning = "Please select a invoice type";
        else if (string.IsNullOrEmpty(challanInvoice.InvoiceFor))
            warning = "Please select invoice for.";

        ShowChallanPopup = false;
        if (warning != null)
        {
            await Alert.ShowWarning(warning);
            ShowChallanPopup = true;
            StateHasChanged();
            return;
        }
        if (!await Alert.ShowConfirm("Do you want to generate challan for this student?"))
        {
            ShowChallanPopup = true;
            StateHasChanged();
            return;
        }

        // popup stays open, the Generate challan button shows "Generating" with a spinner
        ShowChallanPopup = true;
        IsChallanGenerating = true;
        StateHasChanged();
        try
        {
            // only this student of his class
            challanInvoice.ClassCode = selectedStudent.ClassCode;
            challanInvoice.StudentId = selectedStudent.StudentId.ToString();
            challanInvoice.GroupCode = groupcode;
            challanInvoice.BranchCode = branchcode;
            challanInvoice.CreatedBy = UserName;
            challanInvoice.SessionId = CurrentSession;

            var apiResponse = await httpService.Post<ApiResponse<string>>("StudentFeeInvoice/StudentChallanGenerate", challanInvoice);
            IsChallanGenerating = false;
            if (apiResponse != null && apiResponse.Success && apiResponse.Code == 1)
            {
                ShowChallanPopup = false;
                ResetChallan();
                StateHasChanged();
                await Alert.ShowSuccess("Invoice Generated Successfully");
                // new challan -> its dues show in the grid
