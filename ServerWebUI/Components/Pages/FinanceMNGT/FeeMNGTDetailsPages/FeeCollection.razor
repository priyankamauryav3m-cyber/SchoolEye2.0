        ApplyTillMonthFilter();
        CashPaymentAmount = TotalWithLateFee;
        StateHasChanged();
    }

    private void ApplyTillMonthFilter()
    {
        var tillMonthOrder = GetSessionMonthOrder(SelectedTillMonth);
        feeCollectionDuelist = allFeeCollectionDues
            .Where(x => GetSessionMonthOrder(x.MonthNo) <= tillMonthOrder)
            .ToList();
    }

    // Academic session runs April -> March, so April = 0 ... March = 11
    private const int SessionStartMonth = 4;

    // month 0 = one-time heads (no month), they come before April
    private static int GetSessionMonthOrder(int monthNo)
    {
        if (monthNo == 0)
            return -1;
        return (monthNo - SessionStartMonth + 12) % 12;
    }


    // resetWhenEmpty = false keeps the student selected when there are no dues, so a challan / concession can still be done
    private async Task GetStudentFeeDetails(bool resetWhenEmpty = true)
    {
        try
        {
            IsLoading = true;
            getStudentFeeHeadDuesForAdjustment.GroupCode = groupcode;
            getStudentFeeHeadDuesForAdjustment.BranchCode = branchcode;
            getStudentFeeHeadDuesForAdjustment.SessionId = CurrentSession;
            getStudentFeeHeadDuesForAdjustment.BankAccountId = "0";

            var response = await httpService.Post<ApiResponse<List<FeeCollectionDuesNew>>>("StudentFee/GetStudentFeeCollectionDues", getStudentFeeHeadDuesForAdjustment);

            if (response != null && response.Success && response.Data != null && response.Data.Any())
            {
                allFeeCollectionDues = response.Data;

                distinctMonths = allFeeCollectionDues
                    .GroupBy(x => x.MonthNo)
                    .Select(g => g.First())
                    .OrderBy(x => GetSessionMonthOrder(x.MonthNo))
                    .ToList();

                SelectedTillMonth = distinctMonths.LastOrDefault()?.MonthNo ?? SelectedTillMonth;

                ApplyTillMonthFilter();
                CashPaymentAmount = TotalWithLateFee;
            }
            else
            {
                allFeeCollectionDues = new();
                feeCollectionDuelist = new();
                distinctMonths = new();
                CashPaymentAmount = 0;
                await customAlert.ShowCustomAlert("Either challan is not genereated of this student or fee is already paid.", false);
                // nothing left to collect (e.g. fully paid) -> page back to a fresh search
                if (resetWhenEmpty)
                    ResetFeeCollection();
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching student details: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";

        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
            return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();

        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }

    private bool IsSearchingStudents = false;

    private async Task SearchStudent()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(searchTerm))
            {
                await Alert.ShowWarning("Please enter student name or student no to search.");
                StateHasChanged();
                return;
            }

            // loader shows inside the student list under the search box (not the full page loader)
            filteredSuggestions = new();
            activeSuggestion = -1;
            IsSearchingStudents = true;
            ShowSuggestions = true;
            StateHasChanged();

            studentDetailsForFeeRequest.GroupCode = groupcode;
            studentDetailsForFeeRequest.BranchCode = branchcode;
            studentDetailsForFeeRequest.SessionId = CurrentSession;
            if (searchTerm.Any(char.IsLetterOrDigit) && searchTerm.Any(char.IsDigit))
            {
                studentDetailsForFeeRequest.ControlNo = searchTerm;
                studentDetailsForFeeRequest.StudentName = string.Empty;
            }
            else
            {
                studentDetailsForFeeRequest.ControlNo = string.Empty;
                studentDetailsForFeeRequest.StudentName = searchTerm;
            }

            // student list loader stays for 5 seconds (API runs alongside, so it never takes longer than needed)
            var loaderDelay = Task.Delay(5000);
            var response = await httpService.Post<ApiResponse<List<StudentDetailsForFee>>>("StudentFee/GetStudentDetailsForFee", studentDetailsForFeeRequest);
            await loaderDelay;
            IsSearchingStudents = false;

            if (response != null && response.Success && response.Data != null && response.Data.Any())
            {
                studentDetailsForFeeList = response.Data;

                if (studentDetailsForFeeList.Count == 1)
                {
                    ShowSuggestions = false;
                    await SelectStudent(studentDetailsForFeeList[0]);
                }
                else
                {
                    filteredSuggestions = studentDetailsForFeeList;
                    activeSuggestion = 0;
                    selectedStudent = new();
                    IsStudentSelected = false;
                    ShowSuggestions = true;
                }

            }
            else
            {
                studentDetailsForFeeList = new();
                filteredSuggestions = new();
                activeSuggestion = -1;
                selectedStudent = new();
                IsStudentSelected = false;
                ShowSuggestions = true;
                await Alert.ShowWarning(response?.Message ?? "No student found.");
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching student details: {ex.Message}");
            ShowSuggestions = false;
        }
        finally
        {
            IsSearchingStudents = false;
            StateHasChanged();
        }
    }

