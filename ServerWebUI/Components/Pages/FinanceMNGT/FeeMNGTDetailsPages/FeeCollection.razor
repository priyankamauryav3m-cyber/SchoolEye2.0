    // concession selected -> its fee heads load inside the "Apply to fee heads" card
    private async Task OnMapConcessionChanged(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out var concessionId);
        MapConcessionId = concessionId;
        MapIsAmount = false;
        MapConcessionValue = null;
        mapFeeHeadList = new();
        if (MapConcessionId == 0)
            return;

        try
        {
            IsFeeHeadLoading = true;
            StateHasChanged();
            string apiUri = $"Registration/FeeHeadConcession?groupCode={groupcode}&branchCode={branchcode}&sessionId={CurrentSession}&concessionId={MapConcessionId}&isMappedOnly={0}";
            // fee head loader stays for 10 seconds (API runs alongside, so it never takes longer than needed)
            var loaderDelay = Task.Delay(10000);
            var list = await httpService.Get<List<CommonDomain>>(apiUri) ?? new();
            await loaderDelay;
            foreach (var item in list)
            {
                int.TryParse(item.ConcessionType, out int type);
                bool hasValue = item.ConcessionApplicable > 0;
                // same flags as Student Concession: IsSelectedPersentage = true means the value is an amount
                item.IsSelectedPersentage = hasValue && type == 1;
                item.IsSelected = hasValue;
            }

            // the user may have picked another concession while this one was loading
            if (concessionId != MapConcessionId)
                return;
            mapFeeHeadList = list;

            // already configured heads fill the calculation type / value
            var configured = mapFeeHeadList.FirstOrDefault(x => x.IsSelected);
            if (configured != null)
            {
                MapIsAmount = configured.IsSelectedPersentage;
                MapConcessionValue = configured.ConcessionApplicable;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading concession fee heads: {ex.Message}");
            await Alert.ShowError("Unable to load fee heads for this concession.");
        }
        finally
        {
            IsFeeHeadLoading = false;
            StateHasChanged();
        }
    }

    private async Task SaveMapConcession()
    {
        var concession = concessionlist.FirstOrDefault(x => x.ConcessionId == MapConcessionId);
        var selectedHeads = mapFeeHeadList.Where(x => x.IsSelected).ToList();

        if (concession == null)
        {
            await customAlert.ShowCustomAlert("Please select a concession !", false);
            return;
        }
        if (selectedHeads.Count == 0)
        {
            await customAlert.ShowCustomAlert("Please select fee head", false);
            return;
        }
        if (!IsMapGeneralSelected)
        {
            if (MapConcessionValue == null || MapConcessionValue <= 0)
            {
                await customAlert.ShowCustomAlert("Please enter amount or percentage !", false);
                return;
            }
            if (!MapIsAmount && MapConcessionValue > 100)
            {
                await customAlert.ShowCustomAlert("Percentage cannot be more than 100.", false);
                return;
            }
            var exceeded = MapIsAmount ? selectedHeads.FirstOrDefault(x => MapConcessionValue > x.FeeHeadAmount) : null;
            if (exceeded != null)
            {
                await customAlert.ShowCustomAlert($"Amount cannot exceed Fee Head Amount ({exceeded.FeeHeadName}: {Money(exceeded.FeeHeadAmount)})", false);
                return;
            }
        }
        if (mapConcessionDto.ToDate.Date < mapConcessionDto.FromDate.Date)
        {
            await customAlert.ShowCustomAlert("Valid until date cannot be before valid from date.", false);
            return;
        }
        if (string.IsNullOrWhiteSpace(mapConcessionDto.Remarks))
        {
            await customAlert.ShowCustomAlert("Please enter remarks.", false);
            return;
        }

        ShowConcessionPopup = false;
        if (!await Alert.ShowConfirm("Are you sure, you want to map selected concession?"))
        {
            ShowConcessionPopup = true;
            StateHasChanged();
            return;
        }

        try
        {
            IsLoading = true;
            StateHasChanged();

            mapConcessionDto.GroupCode = groupcode;
            mapConcessionDto.BranchCode = branchcode;
            mapConcessionDto.SessionId = CurrentSession;
            mapConcessionDto.StudentId = selectedStudent.StudentId;
            mapConcessionDto.ClassCode = selectedStudent.ClassCode;
            mapConcessionDto.CreatedBy = UserName;
            mapConcessionDto.ConcessionIds = new List<int> { MapConcessionId };
            // ConcessionType 1 = amount, 0 = percentage (same as Student Concession)
            mapConcessionDto.FeeHeadList = selectedHeads.Select(x => new FeeHeadDto
            {
                FeeHeadId = Convert.ToInt32(x.FeeHeadId),
                ConcessionId = MapConcessionId,
                ConcessionType = (IsMapGeneralSelected ? x.IsSelectedPersentage : MapIsAmount) ? 1 : 0,
                ConcessionValue = IsMapGeneralSelected ? x.ConcessionApplicable ?? 0 : MapConcessionValue ?? 0
            }).ToList();

            var apiResponse = await httpService.Post<ApiResponse<object>>("Concession/AddStudentConcession", mapConcessionDto);
            if (apiResponse != null && apiResponse.Success && apiResponse.Code == 1)
            {
                var concessionName = concession.Concession;
                var mappedConcessionId = MapConcessionId;
                ResetMapConcession();

                // the new mapping is the latest pending one of this concession -> show it in the top card
                await LoadStudentMappedConcessions();
                pendingConcession = CurrentStudentConcessions
                    .Where(x => x.ConcessionId == mappedConcessionId && x.Status == 0)
                    .OrderByDescending(x => x.ConcStudId)
                    .FirstOrDefault();
                if (pendingConcession != null)
                    pendingConcession.ConcessionName ??= concessionName;
                else
                    await Alert.ShowSuccess("Concession mapped successfully.");
            }
            else if (apiResponse != null && apiResponse.Success && apiResponse.Code == -2)
            {
                await Alert.ShowWarning("Concession limit exceeded. Maximum allowed is 100%.");
                ShowConcessionPopup = true;
            }
            else
            {
                await Alert.ShowCustomAlert(@Localizer["Admin"]);
                ShowConcessionPopup = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error mapping concession: {ex.Message}");
            await Alert.ShowError("Unable to map the concession. Please try again.");
            ShowConcessionPopup = true;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // used by the top card and by the pending concessions in the Map concession popup
    private async Task ApproveConcession(StudentMappedConcessionDto? concession)
    {
        if (concession == null || IsConcessionActionRunning)
            return;

        // same rule as Student Concession: only two concessions can be approved for a student
        int approvedCount = CurrentStudentConcessions.Count(x => x.Status == 1);
        if (approvedCount >= 2)
        {
            await Alert.ShowWarning("Only two concessions can be assigned to a student.");
            return;
        }

        try
        {
            concessionAction = $"Approve-{concession.ConcStudId}";
            StateHasChanged();
            var request = new ConcessionManageRequest
            {
                GroupCode = groupcode,
                BranchCode = branchcode,
                CreatedBy = UserName,
                ApproveBy = UserName,
                ConcStudId = concession.ConcStudId,
                SessionId = CurrentSession,
                StudentId = selectedStudent.StudentId,
                ApproveRemarks = "Approved from fee collection"
            };
            var apiResponse = await httpService.Post<ApiResponse<object>>("Concession/manage-concession-approval", request);
            concessionAction = "";
            if (apiResponse != null && apiResponse.Success && apiResponse.Code == 2)
                await OnConcessionActionDone(concession, "Concession approved successfully.");
            else
                await Alert.ShowCustomAlert(@Localizer["Admin"]);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error approving concession: {ex.Message}");
            concessionAction = "";
            await Alert.ShowError("Unable to approve the concession. Please try again.");
        }
        finally
        {
            concessionAction = "";
            StateHasChanged();
        }
    }

    private async Task RejectConcession(StudentMappedConcessionDto? concession)
    {
        if (concession == null || IsConcessionActionRunning)
            return;

        try
        {
            concessionAction = $"Reject-{concession.ConcStudId}";
            StateHasChanged();
            var request = new UnMapConcessionRequest
            {
                GroupCode = groupcode,
                BranchCode = branchcode,
                CreatedBy = UserName,
                ApproveBy = UserName,
                ConcessionId = concession.ConcessionId,
                SessionId = CurrentSession,
                StudentId = selectedStudent.StudentId,
                ConcStudId = concession.ConcStudId,
                ApproveRemarks = "Rejected from fee collection"
            };
            var apiResponse = await httpService.Post<ApiResponse<object>>("Concession/UnMapConcession", request);
            concessionAction = "";
            if (apiResponse != null && apiResponse.Success && apiResponse.Code == 2)
                await OnConcessionActionDone(concession, "Concession rejected successfully.");
            else
                await Alert.ShowCustomAlert(@Localizer["Admin"]);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error rejecting concession: {ex.Message}");
            concessionAction = "";
            await Alert.ShowError("Unable to reject the concession. Please try again.");
        }
        finally
        {
            concessionAction = "";
            StateHasChanged();
        }
