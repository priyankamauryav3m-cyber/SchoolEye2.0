    // paying edited (on leaving the box): "Collect up to" moves to the month the amount reaches,
    // e.g. dues Apr-Mar = 124000, paying 4000, April = 5000 -> Collect up to = April, balance 1000
    private async Task ValidateCashPaymentAmount(ChangeEventArgs e)
    {
        if (!IsStudentSelected || allFeeCollectionDues.Count == 0 || distinctMonths.Count == 0)
            return;

        var allDues = allFeeCollectionDues.Sum(x => x.Payable);
        var fullAmount = allDues + selectedStudent.LateFee;

        // empty / zero -> back to the full payable of the selected months
        if (CashPaymentAmount <= 0)
        {
            CashPaymentAmount = TotalWithLateFee;
            return;
        }

        // more than all dues -> all months, full amount
        if (CashPaymentAmount > fullAmount)
            CashPaymentAmount = fullAmount;

        decimal cumulative = 0;
        int tillMonth = distinctMonths[^1].MonthNo;
        foreach (var month in distinctMonths)
        {
            cumulative += allFeeCollectionDues.Where(x => x.MonthNo == month.MonthNo).Sum(x => x.Payable);
            if (cumulative >= CashPaymentAmount)
            {
                tillMonth = month.MonthNo;
                break;
            }
        }
        SelectedTillMonth = tillMonth;
        ApplyTillMonthFilter();

        // clearing every due charges the late fee, so it must be paid in full
        if (ApplicableLateFee > 0 && CashPaymentAmount >= TotalPayable && CashPaymentAmount < TotalWithLateFee)
        {
            CashPaymentAmount = TotalWithLateFee;
            StateHasChanged();
            await Alert.ShowWarning($"Late fee of {Money(ApplicableLateFee)} is charged when all dues are cleared, so it is added to the paying amount.");
        }
        StateHasChanged();
    }

    // "Reset amounts": all due months and the full payable again
    private void ResetAmounts()
    {
        if (!IsStudentSelected || distinctMonths.Count == 0)
            return;
        SelectedTillMonth = distinctMonths[^1].MonthNo;
        ApplyTillMonthFilter();
        CashPaymentAmount = TotalWithLateFee;
        StateHasChanged();
    }
