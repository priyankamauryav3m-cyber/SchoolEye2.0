    private decimal TotalAmount => feeCollectionDuelist.Sum(x => x.Amount);
    private decimal TotalConcession => feeCollectionDuelist.Sum(x => x.Concession);
    private decimal TotalReceived => feeCollectionDuelist.Sum(x => x.ReceivedAmt);
    private decimal TotalPayable => feeCollectionDuelist.Sum(x => x.Payable);

    // Late fee is charged by the save SP (V3M_FIN_InsertLateFeeForReceipt) only when the receipt clears every due
    // invoice, i.e. "Collect up to" is on the last month of the dues; then it is part of the total and the paying amount.
    private bool IsLastInvoiceSelected => distinctMonths.Count > 0 && SelectedTillMonth == distinctMonths[^1].MonthNo;
    private decimal ApplicableLateFee => IsStudentSelected && IsLastInvoiceSelected ? selectedStudent.LateFee : 0;
    private decimal TotalWithLateFee => TotalPayable + ApplicableLateFee;

    // paying = the cash amount entered (UPI / cheque pay the full payable); balance = payable - paying
    private decimal PayingAmount => SelectedPaymentMode == "Cash" ? CashPaymentAmount : TotalWithLateFee;
    private decimal RemainingBalance => Math.Max(0, TotalWithLateFee - PayingAmount);

    // rupee format used for every amount on this page: ₹1,24,000.00 / ₹0.01 (Indian grouping, always 2 decimals)
    private static readonly System.Globalization.NumberFormatInfo RupeeFormat = new()
    {
        NumberGroupSizes = new[] { 3, 2 },
        NumberGroupSeparator = ",",
        NumberDecimalSeparator = ".",
        NumberDecimalDigits = 2
    };
    private static string Money(decimal value) =>
        (value < 0 ? "-₹" : "₹") + Math.Abs(value).ToString("N2", RupeeFormat);

    // late fee goes on the receipt only when this payment clears every due incl. the late fee
    private decimal ChargedLateFee => ApplicableLateFee > 0 && PayingAmount >= TotalWithLateFee ? ApplicableLateFee : 0;
    // part of the paying amount that goes to the fee heads
    private decimal DuesPayingAmount => Math.Max(0, Math.Min(TotalPayable, PayingAmount - ChargedLateFee));

    // paying amount split over the dues: oldest month first (one-time heads before April), fee head order inside a month
    private Dictionary<FeeCollectionDuesNew, decimal> GetPayingAllocation()
    {
        var allocation = new Dictionary<FeeCollectionDuesNew, decimal>();
        var remaining = DuesPayingAmount;
        var ordered = feeCollectionDuelist
            .Select((due, index) => (due, index))
            .OrderBy(x => GetSessionMonthOrder(x.due.MonthNo))
            .ThenBy(x => x.index);
        foreach (var (due, _) in ordered)
        {
            var paying = Math.Max(0, Math.Min(due.Payable, remaining));
            allocation[due] = paying;
            remaining -= paying;
        }
        return allocation;
    }

    private decimal GetRowPaying(FeeCollectionDuesNew due) =>
        GetPayingAllocation().TryGetValue(due, out var paying) ? paying : 0;

    private DateTime ComputeTillDate(int monthNo)
    {
        int year = monthNo >= 4 ? academicStartYear : academicStartYear + 1;
        var lastDay = DateTime.DaysInMonth(year, monthNo);
        return new DateTime(year, monthNo, lastDay);
    }

