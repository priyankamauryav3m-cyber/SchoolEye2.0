@page "/studentconcession"
@using DomainModel.Admin
@inject IJSRuntime jsRuntime
@rendermode InteractiveServer
@inject IHttpClientFactory ClientFactory
@using System.Net
@using System.Text.Json
@inject NavigationManager Nav
@inject IStringLocalizer<Resource> Localizer
@using DomainModel.SchoolMaster
@using DomainModel.FinanceMNGT
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyApp.Common
@using ServerWebUI.Components.Pages.CommonPages
@inject IJSRuntime JS
@inject Shared.IHttpService httpService
@inject HttpClient Http
@inject ICommonMethod _commonmethod
@inject SweetAlertService Alert
@inject ProtectedSessionStorage sessionStorage
<style>
    .quickgrid tbody tr.selectRow td {
        background-color: #cce5ff !important;
    }

    .quickgrid thead th:last-child {
        min-width: 80px;
    }

    .quickgrid thead th:nth-last-child(2) {
        min-width: 75px;
    }

    .status {
        align-items: center;
        gap: 6px;
        padding: 3px 8px;
        border-radius: 20px;
        font-weight: 500;
    }

    .completed {
        background-color: #9BE9A8;
        color: #006B21;
    }

    .blocked {
        background-color: #FF9E8F;
        color: #8B0000;
    }

    .progress {
        background-color: #FFE082;
        color: #9A6700;
    }

    .grid-input {
        width: 100%;
        box-sizing: border-box;
        display: block;
    }
</style>
<section class="main-container">
    <div class="row m-0 main-row">
        <div class="col-12 p-1" id="main-header">
            <div class="page-heading no-btn-top d-flex align-items-center justify-content-between">
                <p class="m-0 page-name px-1">Student Concession</p>
                <div class="d-flex align-items-center gap-2">
                    <div class="form-box">
                        <InputSelect @bind-Value="CurrentSession" name="session" class="form-input">
                            <option value="0">-- Select Session --</option>
                            @foreach (var data in sessionlist.Where(x => x.IsValid == true))
                            {
                                <option value="@data.SessionId">@data.SessionName </option>
                            }
                        </InputSelect>
                    </div>
                    <div class="form-box">
                        <InputSelect @bind-Value="concessionFilterDto.ConcessionId" class="form-input">
                            <option value="0">AllConcessionSelected</option>
                            @foreach (var data in concessionlist.Where(x => x.IsValid == true))
                            {
                                <option value="@data.ConcessionId">@data.Concession </option>
                            }
                        </InputSelect>
                    </div>  
                        

                    <div class="form-box">
                        <div class="d-flex gap-2">
                            <button class="icon-btn icon-btn-white open-popup" @onclick="OpenSearch" data-id="popup" tabindex="0">
                                <i class="bi bi-sliders"></i>
                            </button>
                        </div>
                    </div>
                    <div class="form-box">
                        <button class="ui fade op-1 animated button form-btn" @onclick="SearchStudentDataMapConcession" tabindex="0">
                            <div class="visible content">Search</div>
                            <div class="hidden content">
                                <i class="bi bi-search"></i>
                            </div>
                        </button>
                    </div>
                </div>

            </div>
        </div>

        <div class="col-12 p-1">
            <div class="card">
                <div class="card-body table-card p-0">
                    <div class="quick-main">
                        <div class="grid-box-with-btn">
                            <QuickGrid Items="@moduleQuery" Pagination="@pagination" Class="table">
                                <TemplateColumn Title="" Align="Align.Center">

                                    <ChildContent>
                                        <div class="d-flex align-items-center justify-content-center">
                                            <input @bind="context.IsSelected" @onclick:stopPropagation="true" type="checkbox" />
                                        </div>
                                    </ChildContent>
                                </TemplateColumn>
                                <TemplateColumn Class="text-right" Title="Roll No." Align="Align.Left">
                                    <ChildContent>
                                        @(string.IsNullOrWhiteSpace(context.RollNo) ? " " : context.RollNo)
                                    </ChildContent>
                                </TemplateColumn>
                                <PropertyColumn Sortable="true" Class="text-center" Property="@(x => x.ControlNo)" Title="Student No">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" @bind="studentNoFilter" @bind:event="oninput" placeholder="Student No..." />
                                        </div>
                                    </ColumnOptions>
                                </PropertyColumn>
                                <PropertyColumn Sortable="true" Align="Align.Left" Property="@(x => x.StudentName)" Title="Student Name">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" @bind="nameFilter" @bind:event="oninput" placeholder="Student Name..." />
                                        </div>
                                    </ColumnOptions>
                                </PropertyColumn>
                                <TemplateColumn Title="Concession" Align="Align.Left">
                                    <ChildContent>
                                        @(string.IsNullOrWhiteSpace(context.Concession) ? " " : context.Concession)
                                    </ChildContent>
                                </TemplateColumn>
                                <TemplateColumn Title="Class Section" Align="Align.Left">
                                    <ChildContent>
                                        @(string.IsNullOrWhiteSpace(context.ClassSection) ? " " : context.ClassSection)
                                    </ChildContent>
                                </TemplateColumn>
                                <TemplateColumn Title="Valid From" Align="Align.Left">
                                    <ChildContent>
                                        @(string.IsNullOrWhiteSpace(context.ValidFrom) ? " " : context.ValidFrom)
                                    </ChildContent>
                                </TemplateColumn>
                                <TemplateColumn Title="Valid UpTo" Align="Align.Left">
                                    <ChildContent>
                                        @(string.IsNullOrWhiteSpace(context.ValidUpto) ? " " : context.ValidUpto)
                                    </ChildContent>
                                </TemplateColumn>
                                <TemplateColumn Title="Remarks" Align="Align.Left">
                                    <ChildContent>
                                        @(string.IsNullOrWhiteSpace(context.Remarks) ? " " : context.Remarks)
                                    </ChildContent>
                                </TemplateColumn>

                                <TemplateColumn Title="Status" Align="Align.Center">
                                    <ChildContent>

                                        <div class="text-center">

                                            @if (context.Status == 1)
                                            {
                                                <span class="badge rounded-pill bg-success"> Completed </span>
                                            }
                                            else if (context.Status == 2)
                                            {
                                                <span class="badge rounded-pill bg-danger"> Rejected</span>
                                            }
                                            else if (context.Status == 0)
                                            {
                                                <span class="badge rounded-pill bg-warning text-dark">Pending... </span>
                                            }

                                        </div>

                                    </ChildContent>
                                </TemplateColumn>
                                <TemplateColumn Title="Action" Align="Align.Center">
                                    <div class="action-btn-group">

                                        <button class="btn-icon check-btn" disabled="@(context.Status == 2)" @onclick="() => OpenApproveData(context)">
                                            <i class="bi bi-check-circle-fill"></i>
                                        </button>

                                        <button class="btn-icon  edit-btn" @onclick="() => ViewDetail(context)">
                                            <i class="bi bi-info-circle"></i>
                                        </button>
                                    </div>
                                </TemplateColumn>
                            </QuickGrid>
                        </div>
                        <div class="footer-pagination">
                            <div class="d-flex align-items-center">
                                <div class="welcome-text w-100">
                                    <Paginator State="@pagination" />
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <div class="col-12 p-1">
            <div class="page-heading d-flex align-items-center justify-content-end">

                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="table-btn" @onclick="PrintDateWise">Concession Summary</button>
                    <button type="button" class="table-btn" @onclick="RouteDistanceSummary">Concession Given</button>
                    <button type="button" class="table-btn" @onclick="MapConcessionWithStudent">Map Concession</button>
                    <button type="button" class="table-btn">Concession Detail</button>
                    <button type="button" class="table-btn"> Concession Records</button>
                    <AdmitChildButton CurrentUrl="@currentUrl" ButtonText="Print " Export="ConcessionExpotToExcel" />

                </div>
            </div>
        </div>

        @if (ShowPopupOnSearch)
        {
            <div class="custom-modal row m-0">
                <div class="col-12 col-sm-7 col-md-5 col-lg-4 col-xl-9">
                    <div class="modal-content clearfix main-popup ">
                        <div class="head-btn">
                            <h5 class="modal-title">Search Student</h5>
                            <button data-access="Close" type="button" @onclick="ClosePopup" class="close"><span aria-hidden="true">×</span></button>
                        </div>
                        <div class="modal-body">
                            <div class="row gap-10-0">
                                <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                                    <div class="form-box-group static-label">
                                        <InputSelect class="floating-input" placeholder=" " @bind-Value="concessionFilterDto.ClassCode" @bind-Value:after="GetSectionData">
                                            <option value="" selected>--Select--</option>
                                            @foreach (var cs in classlist.Where(x => x.IsValid == true))
                                            {
                                                <option Value="@cs.ClassCode">@cs.ClassName </option>
                                            }
                                        </InputSelect>
                                        <label class="floating-label">Class</label>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                                    <div class="form-box-group static-label">
                                        <InputSelect class="floating-input" placeholder=" " @bind-Value="concessionFilterDto.SectionId">
                                            <option value="" selected>--Select--</option>
                                            @foreach (var cs in sectionModellist)
                                            {
                                                <option Value="@cs.SectionId">@cs.SectionName </option>
                                            }
                                        </InputSelect>
                                        <label class="floating-label">Section</label>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                                    <div class="form-box-group static-label">
                                        <label for="status" class="floating-label">Concession Status</label>
                                        <div class="border-box d-flex justify-content-center align-items-center gap-3">
                                            <InputRadioGroup @bind-Value="concessionFilterDto.ConStatus">
                                                <div class="d-flex align-items-center gap-1">
                                                    <InputRadio Value="@("3")" />
                                                    <label class="form-label">
                                                        All
                                                    </label>
                                                </div>
                                                <div class="d-flex align-items-center gap-1">
                                                    <InputRadio Value="@("1")" />
                                                    <label class="form-label">
                                                        Approved
                                                    </label>
                                                </div>
                                                <div class="d-flex align-items-center gap-1">
                                                    <InputRadio Value="@("0")" />
                                                    <label class="form-label">
                                                        Not Approved
                                                    </label>
                                                </div>
                                            </InputRadioGroup>

                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-4 col-lg-4">
                                    <div class="form-box-group static-label">
                                        <label for="status" class="floating-label">Student  Status</label>
                                        <div class="border-box d-flex justify-content-center align-items-center gap-3">
                                            <InputRadioGroup @bind-Value="concessionFilterDto.StudentStatus">
                                                <div class="d-flex align-items-center gap-1">
                                                    <InputRadio Value="@("-1")" />
                                                    <label class="form-label">
                                                        All
                                                    </label>
                                                </div>
                                                <div class="d-flex align-items-center gap-1">
                                                    <InputRadio Value="@("1")" />
                                                    <label class="form-label">
                                                        Active
                                                    </label>
                                                </div>
                                                <div class="d-flex align-items-center gap-1">
                                                    <InputRadio Value="@("0")" />
                                                    <label class="form-label">
                                                        Deactive
                                                    </label>
                                                </div>
                                            </InputRadioGroup>

                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                        <div class="modal-footer">
                            <button class="ui fade op-1 animated button form-btn" @onclick="SearchStudentDataMapConcession" tabindex="0">
                                <div class="visible content">Search</div>
                                <div class="hidden content">
                                    <i class="bi bi-search"></i>
                                </div>
                            </button>
                        </div>

                    </div>
                </div>
            </div>
        }


        @if (OpenConcession)
        {
            <div class="custom-modal row m-0 align-items-center">
                <div class="col-@(isViewMode ? "9" : "12")">
                    <div class="modal-content clearfix main-popup">
                        <div class="head-btn">
                            <h5 class="modal-title">Student Concession</h5>
                            <button data-access="Close" type="button" @onclick="ClosePopup" class="close"><span aria-hidden="true">×</span></button>
                        </div>
                        <div class="overflow-auto" style="height: calc(128vh - 280px); min-height: 400px;">
                            <div class="modal-body">

                                <div class="tab-content form-tab-count">
                                    <div class="row gap-10-0 mt-3">

                                        <div class="col-12 col-sm-6 col-md-3">
                                            <div class="form-box-group">
                                                <input class="floating-input" placeholder=" " type="text" @bind="selectedData.SessionName" readonly disabled />
                                                <label class="floating-label">Session Name</label>
                                            </div>
                                        </div>

                                        <div class="col-12 col-sm-6 col-md-3">
                                            <div class="form-box-group">
                                                <InputText class="floating-input" placeholder=" " type="text" @bind-Value="selectedData.StudentName" readonly disabled />
                                                <label class="floating-label">Student Name</label>
                                            </div>

                                        </div>
                                        <div class="col-12 col-sm-6 col-md-3">
                                            <div class="form-box-group">
                                                <input class="floating-input" placeholder=" " type="text" @bind="selectedData.ClassName" readonly disabled />
                                                <label class="floating-label">Class</label>
                                            </div>

                                        </div>
                                        <div class="col-12 col-sm-6 col-md-3">
                                            <div class="form-box-group">
                                                <input class="floating-input" placeholder=" " type="text" @bind="selectedData.SectionName" readonly disabled />
                                                <label class="floating-label">Section</label>
                                            </div>

                                        </div>
                                        <div class="col-12 col-sm-6 col-md-3">
                                            <div class="form-box-group">
                                                <InputDate class="floating-input" placeholder=" " @bind-Value="@concessionDto.FromDate" readonly disabled />
                                                <label class="floating-label">From Date</label>
                                            </div>

                                        </div>

                                        <div class="col-12 col-sm-6 col-md-3">
                                            <div class="form-box-group">
                                                <InputDate class="floating-input" placeholder=" " @bind-Value="@concessionDto.ToDate" />
                                                <label class="floating-label">To Date</label>
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6 col-md-2">
                                            <div class="form-box-group">
                                                <input type="search" class="floating-input" placeholder=" "  @bind="@studentNoFilter"  />
                                                <label class="floating-label">Student No.</label>
                                                @if (_showDropdown && filteredStudents.Any())
                                                {
                                                    <div class="dropdown-box">
                                                        <div class="dropdown-header">
                                                            <div class="col-4"><b>Student No</b></div>
                                                            <div class="col-6"><b>Student Name</b></div>
                                                            <div class="col-2"><b>Class</b></div>
                                                        </div>
                                                        @foreach (var item in filteredStudents)
                                                        {
                                                            <div class="dropdown-item search-item"
                                                                 @onclick="() => SelectStudent(item)">

                                                                <div class="col-4">@item.ControlNo</div>
                                                                <div class="col-6">@item.StudentName</div>
                                                                <div class="col-2">@item.ClassName</div>

                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>

                                        </div>
                                        <div class="col-12 col-sm-6 col-md-1">
                                            <div class="form-box-group static-label">
                                                <button class="ui fade op-1 animated button form-btn" @onclick="SearchStudentData" tabindex="0">
                                                    <div class="visible content">Search</div>
                                                    <div class="hidden content">
                                                        <i class="bi bi-search"></i>
                                                    </div>
                                                </button>

                                            </div>

                                        </div>
                                        @if (isViewMode == true)
                                        {
                                            <div class="col-12 col-sm-6 col-md-3">
                                                <div class="form-box-group static-label">
                                                    <InputSelect class="floating-input" placeholder=" " @bind-Value="SelectedConType" disabled="@isViewMode">
                                                        <option value="" selected>--Select--</option>
                                                        @foreach (var data in concessionlist.Where(x => x.IsValid == true))
                                                        {
                                                            <option value="@data.Type">@data.Type </option>
                                                        }
                                                    </InputSelect>
                                                    <label class="floating-label">Concession Type</label>
                                                </div>
                                            </div>

                                        }
                                        else
                                        {
                                            <div class="col-12 col-sm-6 col-md-3">
                                                <div class="form-box-group static-label">
                                                    <InputSelect class="floating-input" placeholder=" " @bind-Value="ConcessionId" @bind-Value:after="GetConcessionData">
                                                        <option value="" selected>--Select--</option>
                                                        @foreach (var data in concessionlist.Where(x => x.IsValid == true))
                                                        {
                                                            <option value="@data.ConcessionId" style="@(data.Type == "General" ? "color:red;" : "")">
                                                                @data.Concession
                                                                @(data.Type == "General" ? " (General)" : "")

                                                            </option>
                                                        }
                                                    </InputSelect>
                                                    <label class="floating-label">Concession</label>
                                                </div>
                                            </div>

                                        }

                                    </div>
                                    <div class="quick-main mt-4">
                                        <div class="grid-box-with-btn">
                                            @if (isViewMode == true)
                                            {
                                                <QuickGrid Items="@MappedconcessionQueryable" Class="table">
                                                    <TemplateColumn Title="Concession" Align="Align.Left">
                                                        <ChildContent>
                                                            @{
                                                                var firstItem = context.FirstOrDefault();
                                                            }

                                                            @if (firstItem != null)
                                                            {
                                                                @(string.IsNullOrWhiteSpace(firstItem.ConcessionName) ? " " : firstItem.ConcessionName)
                                                            }
                                                        </ChildContent>
                                                    </TemplateColumn>
                                                    <TemplateColumn Title="Fee Head" Align="Align.Left">
                                                        <ChildContent>
                                                            @foreach (var item in context)
                                                            {
                                                                <div class="m-0">
                                                                    @(string.IsNullOrWhiteSpace(item.FeeHeadName) ? " " : item.FeeHeadName)
                                                                </div>

                                                                @if (item != context.Last())
                                                                {
                                                                    <hr class="my-1 row-tb" />
                                                                }
                                                            }
                                                        </ChildContent>
                                                    </TemplateColumn>
                                                    <TemplateColumn Title="VALUE (% OR AMOUNT)" Class="text-right" Align="Align.Center">
                                                        <ChildContent>
                                                            @foreach (var item in context)
                                                            {
                                                                <div class="m-0 ">
                                                                    @(item.ConcessionType == 0 ? $"{item.ConcessionValue:0}%" : $"{item.ConcessionValue}")
                                                                </div>

                                                                @if (item != context.Last())
                                                                {
                                                                    <hr class="my-1 row-tb" />
                                                                }
                                                            }
                                                        </ChildContent>
                                                    </TemplateColumn>
                                                    <TemplateColumn Title="Approve Remarks" Align="Align.Left">
                                                        <ChildContent>
                                                            @foreach (var item in context)
                                                            {
                                                                <div class="m-0 ">
                                                                    @(string.IsNullOrWhiteSpace(item.ApproveRemarks) ? " " : item.ApproveRemarks)
                                                                </div>

                                                                @if (item != context.Last())
                                                                {
                                                                    <hr class="my-1 row-tb" />
                                                                }
                                                            }
                                                        </ChildContent>
                                                    </TemplateColumn>
                                                    <TemplateColumn Title="Status" Class="text-center" Align="Align.Center">
                                                        <ChildContent>
                                                            @{
                                                                var firstItem = context.FirstOrDefault();
                                                            }

                                                            @if (firstItem != null)
                                                            {
                                                                @if (firstItem.Status == 0)
                                                                {
                                                                    <span class="badge rounded-pill bg-warning text-dark">Pending... </span>
                                                                }
                                                                else if (firstItem.Status == 1)
                                                                {
                                                                    <span class="badge rounded-pill bg-success"> Approved </span>
                                                                }
                                                                else if (firstItem.Status == 2)
                                                                {
                                                                    <span class="badge rounded-pill bg-danger"> Rejected</span>
                                                                }
                                                            }
                                                        </ChildContent>
                                                    </TemplateColumn>

                                                    
                                                </QuickGrid>
                                            }
                                            else
                                            {
                                                <QuickGrid Items="@ConcessionmoduleQuery" Pagination="@MapConpagination" Class="table">
                                                    <TemplateColumn Class="text-center" Title="" Align="Align.Left">
                                                        <ChildContent>
                                                            <div>
                                                                <input type="checkbox" @bind="context.IsSelected" disabled="@IsGeneralSelected" @onclick:stopPropagation="true" />
                                                            </div>
                                                        </ChildContent>
                                                    </TemplateColumn>

                                                    <TemplateColumn Title="FEE HEAD" Align="Align.Left">
                                                        <ChildContent>
                                                            @(string.IsNullOrWhiteSpace(context.FeeHeadName) ? " " : context.FeeHeadName)
                                                        </ChildContent>
                                                    </TemplateColumn>

                                                    <TemplateColumn Title="TYPE(% OR AMOUNT)" Class="text-center" Align="Align.Center">
                                                        <ChildContent>
                                                            <div>
                                                                <input type="checkbox" @bind="context.IsSelectedPersentage" disabled="@IsGeneralSelected" @onclick:stopPropagation="true" />
                                                            </div>
                                                        </ChildContent>
                                                    </TemplateColumn>
                                                    <TemplateColumn Title="VALUE (% OR AMOUNT)" Align="Align.Center">
                                                        <ChildContent>


                                                            <input type="text" value="@context.ConcessionApplicable" disabled="@IsGeneralSelected" @oninput="(e => OnValueChanged(e, context))" maxlength="@(context.IsSelectedPersentage ? 6 : 3)"
                                                                   onkeypress="return /^[0-9]$/.test(event.key)" placeholder="@(context.IsSelectedPersentage ? "Enter Amount" : "Enter % (Max 100)")" class="grid-input w-100" />

                                                        </ChildContent>
                                                    </TemplateColumn>
                                                </QuickGrid>
                                            }
                                        </div>
                                        <div class="footer-pagination">
                                            <div class="d-flex align-items-center">
                                                <div class="welcome-text w-100">
                                                    <Paginator State="@MapConpagination" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    @if (isViewMode == true && concessionRemarks.Status == "1")
                                    {
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-7 mt-3">
                                            <div class="form-box-group">
                                                <InputText class="floating-input" placeholder=" " @bind-Value="@concessionDto.Remarks" autocomplete="off" />
                                                <label class="floating-label">Remarks</label>
                                            </div>
                                        </div>

                                    }
                                    else if (isViewMode == true && concessionRemarks.Status == "2" || concessionRemarks.Status == "0")
                                    {

                                    }
                                    else
                                    {
                                        <div class="col-12 col-sm-6 col-md-4 col-lg-7 mt-3">
                                            <div class="form-box-group">
                                                <InputText class="floating-input" placeholder=" " @bind-Value="@concessionDto.Remarks" autocomplete="off" />
                                                <label class="floating-label">Remarks</label>
                                            </div>
                                        </div>
                                        <strong>Note: If Type checkbox is checked then concession is in amount. If unchecked then concession is in percentage(%)</strong>
                                    }
                                    <div class="modal-footer">

                                        <div class="form-group btn-gr">
                                            @if (isViewMode == true && concessionRemarks.Status == "1")
                                            {
                                                <button type="button" class="ui fade op-1 animated button form-btn" @onclick="UpdateConcessionRemarks">

                                                    <div class="visible content">Update</div>
                                                    <div class="hidden content">
                                                        <i class="fa fa-save"></i>
                                                    </div>
                                                </button>
                                            }
                                            else if (isViewMode == true && concessionRemarks.Status == "2" || concessionRemarks.Status == "0")
                                            {

                                            }
                                            else
                                            {
                                                <button type="button" class="ui fade op-1 animated button form-btn" @onclick="SaveConcession">

                                                    <div class="visible content">Add Concession</div>
                                                    <div class="hidden content">
                                                        <i class="fa fa-save"></i>
                                                    </div>
                                                </button>
                                            }


                                            <SaveUpdateButton ShowSaveButton="false" OnClickCancel="ClosePopup"></SaveUpdateButton>
                                        </div>
                                    </div>

                                    
                                </div>
                            </div>

                            @if (OpenConcessionDetails)
                            {
