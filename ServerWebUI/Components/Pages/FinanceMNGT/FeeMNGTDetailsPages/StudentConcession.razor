    {
        if (selectedData.StudentId == 0 || selectedData.SessionId == 0)
        {
            await customAlert.ShowCustomAlert("Please search and select a student before proceeding.", false);
            return;
        }
        if (string.IsNullOrEmpty(concessionDto.Remarks))
        {
            await customAlert.ShowCustomAlert("Please enter remarks.", false);
            return;
        }
        var names = concessionlist.Where(x => x.ConcessionId == ConcessionId).Select(x => x.Concession).FirstOrDefault();
        var SelectType = concessionlist.Where(x => x.ConcessionId == ConcessionId).Select(x => x.Type).FirstOrDefault();
        var selectedRows = ConcessionmoduleQuery.Where(x => x.IsSelected).ToList();
        if (selectedRows.Count == 0)
        {
            await customAlert.ShowCustomAlert("Please select record  first !", false);
            return;
        }
        else if (selectedRows[0].ConcessionApplicable == null)
        {
            await customAlert.ShowCustomAlert("Please enter amount or percentage !", false);
            return;
        }

        foreach (var row in selectedRows)
        {
            var temp = new ConcessionTempModel
            {
                ConcType = SelectType,
                ConcessionName = names,
                FeeHeadId = row.FeeHeadId,
                FeeHeadName = row.FeeHeadName,
                FromDate = row.FromDate,
                ToDate = row.ToDate,
                IsAmount = !row.IsSelectedPersentage,
                Amount = row.ConcessionApplicable ?? 0,
                ConcessionId = ConcessionId.ToString()
            };

            concessionTempList.Add(temp);

        }

        ConcessionId = 0;
        SelectedConcessionIds = "";
        OpenConcessionDetails = true;

        try
        {
            await Task.Delay(100);
            await JS.InvokeVoidAsync("scrollToElement", "section4");
            StateHasChanged();
        }
        catch (JSDisconnectedException)
        {
        }
        feeHeadlist.Clear();
        OpenConcession = true;
        StateHasChanged();
    }
    private async Task UpdateConcessionRemarks()
    {
        try
        {

            OpenConcession = false;
            var submit = await Alert.ShowConfirm("Are you sure, you want to update remarks?");
            if (!submit)
            {
                OpenConcession = true;
                StateHasChanged();
                return;
            }
            concessionRemarks.GroupCode = groupcode;
            concessionRemarks.BranchCode = branchcode;
            concessionRemarks.CreatedBy = UserName;
            concessionRemarks.Remarks = concessionDto.Remarks;
            string ApiUri1 = "Concession/UpdateStudentConcessionRemark";
            var apiResponse = await httpService.Post<ApiResponse<object>>(ApiUri1, concessionRemarks);
            if (apiResponse.Success)
            {
                if (apiResponse.Code == 1)
                {
                    OpenConcession = false;
                    await Alert.ShowSuccess($"Student remark {Localizer["Updated"]}");

                }
                else if (apiResponse.Code == 2 && apiResponse.Success)
                {
                    await Alert.ShowSuccess($"Student concession {Localizer["Updated"]}");
                }
                else
                {
                    await Alert.ShowCustomAlert(@Localizer["Admin"]);
                }
                studentNoFilter = "";
                selectedData = new();
                concessionDto = new();
                StateHasChanged();
            }
        }
        catch (Exception)
        {

            return;
        }
        finally
        {
            StateHasChanged();
        }
    }
    private async Task OnSaveConcessionWithStudent()
    {
        try
        {

            // var selectedList = concessionTempList.Where(x => x.IsChecked).ToList();
            // if (!selectedList.Any())
            // {
            //     await customAlert.ShowCustomAlert("Please select at least one concession.", false);
            //     return;
            // }

            OpenConcession = false;
            var submit = await Alert.ShowConfirm("Are you sure, you want to map selected concession?");
            if (!submit)
            {
                OpenConcession = true;
                StateHasChanged();
                return;
            }
            concessionDto.GroupCode = groupcode;
            concessionDto.BranchCode = branchcode;
            concessionDto.SessionId = selectedData.SessionId;
            concessionDto.StudentId = selectedData.StudentId;
            concessionDto.ClassCode = selectedData.ClassCode;
            concessionDto.CreatedBy = UserName;
            concessionDto.ConcessionIds = concessionTempList.Select(x => Convert.ToInt32(x.ConcessionId)).Distinct().ToList();
            concessionDto.FeeHeadList = concessionTempList.Select(x => new FeeHeadDto { FeeHeadId = Convert.ToInt32(x.FeeHeadId), ConcStudId = x.ConcStudId, ConcessionId = Convert.ToInt32(x.ConcessionId), ConcessionType = !x.IsAmount ? 1 : 0, ConcessionValue = x.Amount }).ToList();
            string ApiUri1 = "Concession/AddStudentConcession";
            var apiResponse = await httpService.Post<ApiResponse<object>>(ApiUri1, concessionDto);
            if (apiResponse.Success)
            {
                if (apiResponse.Code == 1)
                {
                    OpenConcession = false;
                    await Alert.ShowSuccess("Concession mapped successfully.");
                    studentNoFilter = "";
                    selectedData = new();
                    concessionDto = new();
                    concessionTempList.Clear();
                    OpenConcessionDetails = false;

                }
                else if (apiResponse.Code == -2 && apiResponse.Success)
                {
                    await Alert.ShowWarning("Concession limit exceeded. Maximum allowed is 100%.");
                    OpenConcessionDetails = true;
                    return;
                }
                else
                {
                    await Alert.ShowCustomAlert(@Localizer["Admin"]);
                    studentNoFilter = "";
                    selectedData = new();
                    concessionDto = new();
                    concessionTempList.Clear();
                    OpenConcessionDetails = false;
                }

                StateHasChanged();
            }
        }
        catch (Exception)
        {

            return;
        }
        finally
        {
            StateHasChanged();
        }
    }
