                                                                    Reject
                                                                </button>
                                                            }
                                                            else if (firstItem.Status == 2)
                                                            {
                                                                <button class="btn-icon inactive-btn" disabled>
                                                                    Rejected
                                                                </button>
                                                            }

                                                        </div>
                                                    }
                                                </ChildContent>
                                            </TemplateColumn>

                                        </QuickGrid>

