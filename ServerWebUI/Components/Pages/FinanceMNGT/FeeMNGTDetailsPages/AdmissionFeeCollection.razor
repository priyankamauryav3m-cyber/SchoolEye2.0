@page "/admissionfeecollection"
@using DomainModel.Admin
@using DomainModel.SchoolMaster
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyApp.Common
@using ServerWebUI.Components.Common
@using ServerWebUI.Components.Pages.CommonPages
@inject ICommonMethod _commonmethod
@inject Shared.IHttpService httpService
@inject SweetAlertService Alert
@inject IJSRuntime JS
@implements IDisposable
@rendermode InteractiveServer

<style>
    .quickgrid thead th:nth-last-child(2) {
        min-width: 90px;
    }

    .grid-box {
        height: calc(85vh - 250px);
        min-height: 250px;
    }

    .grid-box-with-btn {
        height: calc(90vh - 273px);
    }
    .border-box{
       height: 36px;
    }
    .student-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #dbeafe;
        color: #1d4ed8;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
    }

    .student-name {
        font-weight: 700;
        font-size: 15px;
    }

    .student-sub {
        font-weight: 500;
        font-size: 13px;
        color: #6c757d;
    }

    .fee-head-title {
        font-weight: 600;
    }

    .fee-head-sub {
        font-size: 12px;
        color: #9ca3af;
    }

    .amount-to-collect-card {
        background: linear-gradient(135deg, var(--navy), #14557f);
        color: #fff;
        border-radius: 10px;
        padding: 15px;
    }

    .amount-to-collect-label {
        font-size: 11px;
        letter-spacing: .05em;
        color: #b7c6da;
    }

    .amount-to-collect-value {
        font-size: 25px;
        font-weight: 700;
        margin: 3px 0 10px 0;
    }

    .amount-divider {
        border-top: 1px solid rgba(255,255,255,.15);
        margin: 10px 0;
    }

    .amount-stat-label {
        font-size: 11px;
        color: #b7c6da;
    }

    .amount-stat-value {
        font-size: 15px;
        font-weight: 700;
    }

    .crumb {
        display: flex;
        gap: 10px;
        align-items: center;
        color: #2455a6;
        margin-bottom: 10px;
    }

    .student-search-wrap {
        width: 300px;
    }

    @@media (max-width: 767px) {
        .student-search-wrap {
            width: 100%;
        }
    }
</style>

