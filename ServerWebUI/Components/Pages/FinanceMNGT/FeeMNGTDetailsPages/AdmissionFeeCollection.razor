    private async Task SearchStudent()
    {
        if (IsLoading) return;
        var term = searchTerm?.Trim();
        if (string.IsNullOrWhiteSpace(term))
        {
            await Alert.ShowWarning("Please enter registration no. or student name to search.");
            return;
        }
        if (CurrentSession <= 0)
        {
            await Alert.ShowWarning("Please select a session.");
            return;
        }

        IsLoading = true;
        StateHasChanged();
        ApiResponse<RegistrationDetailsResponse>? response;
        try
        {
            var request = new RegistrationDetailsRequest
            {
                GroupCode = groupcode ?? "",
                BranchCode = branchcode ?? "",
                SessionId = CurrentSession
            };

            if (term.Any(char.IsDigit))
                request.RegistrationNo = term;
            else
                request.StudentName = term;

            response = await httpService.Post<ApiResponse<RegistrationDetailsResponse>>("AdmitChild/GetRegistrationDetails", request);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching registration details: {ex.Message}");
            ClearSelectedStudent();
            IsLoading = false;
            StateHasChanged();
            await Alert.ShowWarning("Unable to fetch student details. Please try again.");
            return;
        }

        // hide the loader before any alert is shown
        IsLoading = false;
        if (response != null && response.Success && response.Data != null)
        {
            SelectStudent(response.Data);
            StateHasChanged();
        }
        else
        {
            ClearSelectedStudent();
            StateHasChanged();
            await Alert.ShowWarning("No student found.");
        }
    }

    // admit child + receipt no + receipt fee head details, one API / one transaction
    private async Task AdmitChild()
    {
        if (IsLoading) return;
        if (!IsStudentSelected)
        {
            await Alert.ShowWarning("Please search and select a student first.");
            return;
        }
        if (selectedStudent.RegistrationId <= 0)
        {
            await Alert.ShowWarning("Registration id not found for this student.");
            return;
        }
        if (IsUsingTransport && RouteDistance == 0)
        {
            await Alert.ShowWarning("Please select route distance.");
            return;
        }
        // validate before calling the API
        if (string.IsNullOrEmpty(SelectedPeriodType))
        {
            await Alert.ShowWarning("Please select period type.");
            return;
        }
        if (SelectedPeriodId <= 0)
        {
            await Alert.ShowWarning("Please select period name.");
            return;
        }
        if (feeHeadList.Count == 0)
        {
            await Alert.ShowWarning("No fee heads found for the selected period.");
            return;
        }
        if (SelectedPaymentModeId <= 0)
        {
            await Alert.ShowWarning("Please select payment mode.");
            return;
        }
        // cheque / NEFT details only for a non cash mode (branch is optional)
        if (IsChequeDetailsEnabled)
        {
            if (SelectedChequeTypeId <= 0)
            {
                await Alert.ShowWarning("Please select cheque type.");
                return;
            }
            if (string.IsNullOrWhiteSpace(ChequeNo))
            {
                await Alert.ShowWarning("Please enter NEFT / cheque no.");
                return;
            }
            if (ChequeDate == null)
            {
                await Alert.ShowWarning("Please select NEFT / cheque date.");
                return;
            }
            if (SelectedBankId <= 0)
            {
                await Alert.ShowWarning("Please select bank.");
                return;
            }
        }
        if (PayingAmount < 0 || PayingAmount > TotalAmount - TotalConcession)
        {
            await Alert.ShowWarning("Paying amount can not be more than payable amount.");
            return;
        }
        if (string.IsNullOrWhiteSpace(Remarks))
        {
            await Alert.ShowWarning("Please enter remarks.");
            return;
        }

        // No -> nothing changes, the entered details stay as they are
        if (!await Alert.ShowConfirm("Are you sure, you want to admit child?"))
            return;

        IsLoading = true;
        StateHasChanged();
        try
        {
            var periodMonth = feeCollectionPeriodlist.FirstOrDefault(x => x.PeriodId == SelectedPeriodId)?.DueFrom?.Month ?? DateTime.Today.Month;
            var request = new AdmitChildWithReceiptRequest
            {
                // admission
                RegistrationId = selectedStudent.RegistrationId.ToString(),
                GroupCode = groupcode ?? "",
                BranchCode = branchcode ?? "",
                SessionId = CurrentSession,
                CreatedBy = username ?? "",
                //RouteDistance = (int)selectedStudent.DistanceFromSchool,
                SocietyId = SelectedSocietyId,
                RouteDistance=RouteDistance,
                // receipt
                ClassCode = selectedStudent.ClassCode,
                TotalAmount = TotalAmount,
                PaidAmount = PayingAmount,
                Concession = TotalConcession,
                Balance = TotalAmount - TotalConcession - PayingAmount,
                PaymentMode = paymentModeList.FirstOrDefault(x => x.PMId == SelectedPaymentModeId)?.ModeName ?? "",
                ChequeNo = ChequeNo,
                ChequeDate = ChequeDate,
                ChequeBank = bankList.FirstOrDefault(x => x.BankId == SelectedBankId)?.BankName ?? "",
                ChequeType = chequeTypeList.FirstOrDefault(x => x.Sid == SelectedChequeTypeId)?.ChequeTypeName ?? "",
                Remark = Remarks,
                PeriodType = SelectedPeriodType,
                PeriodId = SelectedPeriodId,
                ReceiptDate = ReceiptDate,

                // receipt details - one row per fee head per month, e.g. "Apr, May, Jun" -> 4, 5, 6
                FeeHeads = BuildReceiptFeeHeads(periodMonth),

                // concession applied from the popup, mapped to the student in the same transaction
                ConcessionId = AppliedConcessionId,
                ConcessionFeeHeads = AppliedConcessionFeeHeads
            };

            // one call: admit child + receipt no + receipt details in a single transaction
            var response = await httpService.Post<ApiResponse<AdmitChildWithReceiptResponse>>("AdmitChild/AdmitChildWithReceipt", request);
            if (response == null || !response.Success || string.IsNullOrWhiteSpace(response.Data?.StudentReceiptNo))
            {
                await StopLoaderAndShowError(response?.Message ?? "Unable to admit the child. Please try again.");
                return;
            }

            IsLoading = false;
            StateHasChanged();

            // Yes -> receipt opens in a new tab, then the success message
            if (await Alert.ShowConfirm("Are you sure, you want to print receipt?"))
                await PrintReceipt(response.Data);

            await Alert.ShowSuccess($"Child admitted successfully. Receipt No: {response.Data.StudentReceiptNo}");

            // ready for the next student
            await ResetPage();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            // HttpService throws with the API message on a non-success status
            Console.WriteLine($"Error in admit child: {ex.Message}");
            await StopLoaderAndShowError(string.IsNullOrWhiteSpace(ex.Message) ? "Unable to admit the child. Please try again." : ex.Message);
        }
    }

    // receipt PDF is generated by the API (Export/GenerateAdmitChildReceiptPdf) from the page's current data;
    // a print failure must not look like an admission failure, the child is already admitted
    private async Task PrintReceipt(AdmitChildWithReceiptResponse admitted)
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            var receipt = new AdmitChildReceiptPrintModel
            {
                ReceiptNo = admitted.StudentReceiptNo,
                ReceiptDate = ReceiptDate,
                RegistrationNo = selectedStudent.RegistrationNo,
                // "Student No." on the receipt shows the admission control no.
                StudentNo = admitted.ControlNo,
                StudentName = selectedStudent.StudentName,
                FatherName = selectedStudent.FatherName,
                ClassName = selectedStudent.ClassName,
                SessionName = sessionlist.FirstOrDefault(x => x.SessionId == CurrentSession)?.SessionName,
                PeriodName = feeCollectionPeriodlist.FirstOrDefault(x => x.PeriodId == SelectedPeriodId)?.PeriodName,
                PaymentMode = paymentModeList.FirstOrDefault(x => x.PMId == SelectedPaymentModeId)?.ModeName,
                TotalAmount = TotalAmount,
                Concession = TotalConcession,
                PaidAmount = PayingAmount,
                Balance = Balance,
                FeeHeads = feeHeadList.Select(x => new AdmitChildReceiptPrintFeeHead
                {
                    FeeHeadName = string.IsNullOrWhiteSpace(x.MonthNames) ? x.FeeHeadName : $"{x.FeeHeadName} ({x.MonthNames})",
                    Amount = x.Amount
                }).ToList()
            };

            var response = await httpService.Post<ApiResponse<string>>("Export/GenerateAdmitChildReceiptPdf", receipt);
            IsLoading = false;
            StateHasChanged();
            if (response != null && response.Success && !string.IsNullOrEmpty(response.Data))
                await JS.InvokeVoidAsync("viewPdf", response.Data);
            else
                await Alert.ShowWarning("Child is admitted, but the receipt could not be generated.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error printing admission receipt: {ex.Message}");
            IsLoading = false;
            StateHasChanged();
            await Alert.ShowWarning("Child is admitted, but the receipt could not be generated.");
        }
    }

    // fee head ledger needs one row per month: the fee head's MonthNames ("Apr, May, Jun") give the month nos;
    // amount and concession are split equally per month, the last month takes the rounding difference
    private List<AdmissionReceiptFeeHead> BuildReceiptFeeHeads(int periodMonth)
    {
        var rows = new List<AdmissionReceiptFeeHead>();
        var rowNo = 1;
        foreach (var x in feeHeadList)
        {
            var months = (x.MonthNames ?? "")
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(m => DateTime.TryParseExact(m, "MMM", System.Globalization.CultureInfo.InvariantCulture,
                    System.Globalization.DateTimeStyles.None, out var d) ? d.Month : 0)
                .Where(m => m > 0)
                .ToList();
            if (months.Count == 0)
                months.Add(periodMonth);

            var monthAmount = Math.Round(x.Amount / months.Count, 2);
            var monthConcession = Math.Round(x.Concession / months.Count, 2);
            for (var i = 0; i < months.Count; i++)
            {
                var isLast = i == months.Count - 1;
                var amount = isLast ? x.Amount - monthAmount * (months.Count - 1) : monthAmount;
                var concession = isLast ? x.Concession - monthConcession * (months.Count - 1) : monthConcession;
                rows.Add(new AdmissionReceiptFeeHead
                {
                    RowNo = rowNo++,
                    FeeHeadId = (int)x.FeeHeadId,
                    MonthNo = months[i],
                    PayableAmount = amount - concession,
                    FeeHeadAmount = amount,
                    ConcessionAmt = concession
                });
            }
        }
        return rows;
    }

    private async Task StopLoaderAndShowError(string message)
    {
        IsLoading = false;
        StateHasChanged();
        await Alert.ShowError(message);
    }

    private void SelectStudent(RegistrationDetailsResponse item)
    {
        // a new student -> start again from period selection
        ResetAll();
        selectedStudent = item;
        IsUsingTransport = selectedStudent.IsTransportRequired;
        IsStudentSelected = true;
    }

