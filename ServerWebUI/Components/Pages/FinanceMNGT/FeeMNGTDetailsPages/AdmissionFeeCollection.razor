    private async Task OpenConcessionPopup()
    {
        if (!IsStudentSelected)
        {
            await Alert.ShowWarning("Please search and select a student first.");
            return;
        }

        if (SelectedPeriodId <= 0 || feeHeadList.Count == 0)
        {
            await Alert.ShowWarning("Please select period name to load fee heads first.");
            return;
        }

        SelectedConcessionId = 0;
        concessionFeeHeadList = new();
        ShowConcessionPopup = true;
        if (concessionList.Count == 0)
        {
            IsConcessionLoading = true;
            StateHasChanged();
            try
            {
                concessionList = await httpService.Get<List<ConcessionModel>>("Concession/GetListConcession") ?? new();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error fetching concessions: {ex.Message}");
            }
            finally
            {
                IsConcessionLoading = false;
            }
        }
    }

    private void CloseConcessionPopup()
    {
        ShowConcessionPopup = false;
        SelectedConcessionId = 0;
        concessionFeeHeadList = new();
    }

    private async Task OnConcessionChanged()
    {
        concessionFeeHeadList = new();
        if (SelectedConcessionId <= 0)
            return;

        IsConcessionLoading = true;
        StateHasChanged();
        try
        {
            string apiUri = $"Registration/FeeHeadConcession?groupCode={groupcode}&branchCode={branchcode}&sessionId={CurrentSession}&concessionId={SelectedConcessionId}&isMappedOnly={0}";
            var result = await httpService.Get<List<CommonDomain>>(apiUri) ?? new();

            concessionFeeHeadList = result.Where(x => (x.ConcessionApplicable ?? 0) > 0).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching fee head concession: {ex.Message}");
        }
        finally
        {
            IsConcessionLoading = false;
            StateHasChanged();
        }
    }

    private static bool IsAmountConcession(CommonDomain item) =>
        int.TryParse(item.ConcessionType, out var type) && type == 1;

    private ClassMapTemplateFeeHeadResponse? FindGridFeeHead(CommonDomain item) =>
        long.TryParse(item.FeeHeadId, out var feeHeadId)
            ? feeHeadList.FirstOrDefault(x => x.FeeHeadId == feeHeadId)
            : null;

    private static decimal CalculateConcession(CommonDomain item, decimal feeHeadAmount)
    {
        var value = item.ConcessionApplicable ?? 0;
        var concession = IsAmountConcession(item) ? value : Math.Round(feeHeadAmount * value / 100, 2);
        return Math.Clamp(concession, 0, feeHeadAmount);
    }

    private async Task ApplyConcession()
    {
        if (feeHeadList.Count == 0)
        {
            await Alert.ShowWarning("Please select period name to load fee heads first.");
            return;
        }

        var matched = concessionFeeHeadList
            .Select(x => new { Concession = x, FeeHead = FindGridFeeHead(x) })
            .Where(x => x.FeeHead != null)
            .ToList();
        if (matched.Count == 0)
        {
            await Alert.ShowWarning("This concession has no fee head of the student's fee particulars.");
            return;
        }

        AppliedConcessionId = SelectedConcessionId;
        AppliedConcessionFeeHeads = concessionFeeHeadList
            .Where(x => int.TryParse(x.FeeHeadId, out _))
            .Select(x => new AdmissionConcessionFeeHead
            {
                FeeHeadId = int.Parse(x.FeeHeadId!),
                ConcessionType = x.ConcessionType,
                ConcessionValue = x.ConcessionApplicable ?? 0
            })
            .ToList();

        CloseConcessionPopup();
        IsLoading = true;
        StateHasChanged();
        try
        {

            await Task.Delay(300);

            foreach (var feeHead in feeHeadList)
                feeHead.Concession = 0;
            foreach (var item in matched)
                item.FeeHead!.Concession = CalculateConcession(item.Concession, item.FeeHead.Amount);

            PayingAmount = TotalPayable;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }


