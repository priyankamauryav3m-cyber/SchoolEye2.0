        <div class="col-12 p-1">
    <div class="card">
        <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-3">

            <div class="d-flex align-items-center gap-2">
                <div class="student-avatar">
                    @GetInitials(IsStudentSelected ? selectedStudent.StudentName : null)
                </div>
                <div>
                    <div class="student-name">
                        @(IsStudentSelected ? selectedStudent.StudentName : "No student selected")
                    </div>
                    <div class="student-sub">
                        @if (IsStudentSelected)
                        {
                            @:Registration no. @selectedStudent.RegistrationNo &nbsp;·&nbsp; Class @selectedStudent.ClassName &nbsp;·&nbsp; Father Name: @selectedStudent.FatherName &nbsp;·&nbsp; Mobile No: @selectedStudent.FatherContactNo
                        }
                        else
                        {
                            @:Search and select a student to view fee details.
                        }
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-3 flex-wrap">
                         
                <div class="form-box">
                      <label class="form-label">&nbsp;</label>
                    <div class="border-box d-flex justify-content-center align-items-center gap-3">
                        <div class="d-flex align-items-center gap-1">
                            <input type="checkbox"
                                   class="form-input"
                                   @bind="@IsUsingTransport" />
                            <label class="form-label">Transport Required</label>
                        </div>
                    </div>
                </div>

                <div class="form-box">
                    <label class="form-label">Route Distance</label>

                        <InputSelect disabled="@(!IsUsingTransport)"
                                     class="form-input"
                                     autocomplete="off"
                                     @bind-Value="@RouteDistance">
                            <option value="0">--Select--</option>
                            @foreach (var cs in distancelist)
                            {
                                <option value="@cs.DistanceId">@cs.DistanceName</option>
                            }
                        </InputSelect>
                   
                </div>

                <div class="form-box">
                    <label class="form-label">Receipt Date</label>
                    <InputDate @bind-Value="ReceiptDate" class="form-input" />
                </div>

            </div>
        </div>
    </div>
</div>
        @* action buttons — static for now *@
        <div class="col-12 p-1">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <div class="form-box">
                    <button type="button" class="table-btn active">Collect fee</button>
                </div>
          
                <div class="form-box">
                    <button type="button" class="table-btn">Add feehead</button>
                </div>
                <div class="form-box">
                    <button type="button" class="table-btn" @onclick="OpenConcessionPopup">Map concession</button>
                </div>
            </div>
        </div>

        @* fee head grid *@
        <div class="col-12 col-lg-7 p-1">
            <div class="card h-100">
                <div class="card-body table-card p-0">
                    <div class="quick-main">
                        <div class="mb-3">
                            <div class="fee-head-title" style="font-size:15px;">Fee particulars</div>
                            <div class="fee-head-sub">Review admission dues and enter the amount being paid.</div>
                        </div>
                        <div class="grid-box">
                            <QuickGrid Items="@feeHeadQuery" Pagination="@pagination" Class="table">
                                <TemplateColumn Title="Feehead" Align="Align.Left">
                                    <ChildContent>
                                        @context.FeeHeadName@(string.IsNullOrWhiteSpace(context.MonthNames) ? "" : $" ({context.MonthNames})")
                                    </ChildContent>
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" @bind="nameFilter" @bind:event="oninput" placeholder="Feehead name..." />
                                        </div>
                                    </ColumnOptions>
                                </TemplateColumn>
                                @* one month's amount; "-" when the months have different amounts *@
                                <TemplateColumn Title="Amount" Align="Align.Center" Class="text-right" SortBy="@(GridSort<ClassMapTemplateFeeHeadResponse>.ByAscending(x => x.MonthlyAmount))">
                                    @(context.MonthlyAmount == null ? "-" : $"₹{context.MonthlyAmount:N2}")
                                </TemplateColumn>
                                @* total of the period — read only *@
                                <TemplateColumn Title="Total" Align="Align.Center" Class="text-right" SortBy="@(GridSort<ClassMapTemplateFeeHeadResponse>.ByAscending(x => x.Amount))">
                                    <input type="text" class="form-input w-100 text-end" value="@($"₹{context.Amount:N2}")" disabled />
                                </TemplateColumn>
                                <TemplateColumn Title="Concession" Align="Align.Center" Class="text-right" SortBy="@(GridSort<ClassMapTemplateFeeHeadResponse>.ByAscending(x => x.Concession))">
                                    @($"₹{context.Concession:N2}")
                                </TemplateColumn>
                                <TemplateColumn Title="Payable" Align="Align.Center" Class="text-right">
                                    @($"₹{context.Amount - context.Concession:N2}")
                                </TemplateColumn>
                            </QuickGrid>
                        </div>
                        <div class="footer-pagination mt-3">
                            <div class="d-flex align-items-center">
                                <div class="welcome-text w-100">
                                    <Paginator State="@pagination" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* fee collection — static for now *@
        <div class="col-12 col-lg-5 p-1">
            <div class="amount-to-collect-card mb-2">
                <div class="amount-to-collect-label">AMOUNT TO COLLECT</div>
                <div class="amount-to-collect-value">&#8377;@TotalPayable.ToString("N2")</div>
                <div class="amount-divider"></div>
                <div class="row g-2">
                    <div class="col-6">
                        <div class="amount-stat-label">TOTAL FEE</div>
                        <div class="amount-stat-value">&#8377;@TotalAmount.ToString("N2")</div>
                    </div>
                    <div class="col-6">
                        <div class="amount-stat-label">CONCESSION</div>
                        <div class="amount-stat-value">&#8377;@TotalConcession.ToString("N2")</div>
                    </div>
                    <div class="col-6">
                        <div class="amount-stat-label">PAYABLE</div>
                        <div class="amount-stat-value">&#8377;@TotalPayable.ToString("N2")</div>
                    </div>
                    <div class="col-6">
                        <div class="amount-stat-label">BALANCE</div>
                        <div class="amount-stat-value">&#8377;@Balance.ToString("N2")</div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <div class="fee-head-title mb-3" style="font-size:15px;">Payment details</div>

                    <div class="row g-3">
                        <div class="col-6">
                            <div class="form-box-group static-label mb-0">
                                <InputSelect class="form-input w-100" @bind-Value="SelectedPeriodType" @bind-Value:after="OnPeriodTypeChanged">
                                    <option value="">Select</option>
                                    @foreach (var data in PeriodTypeList)
                                    {
                                        <option value="@data.PeriodTypeName">@data.PeriodTypeName</option>
                                    }
                                </InputSelect>
                                <label class="floating-label">Period Type</label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-box-group static-label mb-0">
                                <InputSelect class="form-input w-100" @bind-Value="SelectedPeriodId" @bind-Value:after="OnPeriodChanged">
                                    <option value="0">Select</option>
                                    @foreach (var data in feeCollectionPeriodlist)
                                    {
                                        <option value="@data.PeriodId">@data.PeriodName</option>
                                    }
                                </InputSelect>
                                <label class="floating-label">Period Name</label>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="form-box-group static-label mb-0">
                                <InputSelect class="form-input w-100" @bind-Value="SelectedPaymentModeId" @bind-Value:after="OnPaymentModeChanged">
                                    <option value="0">Select</option>
                                    @foreach (var data in paymentModeList.Where(x => x.IsValid))
                                    {
                                        <option value="@data.PMId">@data.ModeName</option>
                                    }
                                </InputSelect>
                                <label class="floating-label">Payment Mode</label>
                            </div>
                        </div>
                            <div class="col-6">
                            <div class="form-box-group static-label mb-0">
                                <input type="number" class="form-input w-100" min="0" step="0.01" placeholder=" " @bind="PayingAmount" />
                                <label class="floating-label">Paying</label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-box-group static-label mb-0">
                                <InputSelect class="form-input w-100" @bind-Value="SelectedChequeTypeId" disabled="@(!IsChequeDetailsEnabled)">
                                    <option value="0">Select</option>
                                    @foreach (var data in chequeTypeList.Where(x => x.IsValid))
                                    {
                                        <option value="@data.Sid">@data.ChequeTypeName</option>
                                    }
                                </InputSelect>
                                <label class="floating-label">Cheque Type</label>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="form-box-group static-label mb-0">
                                <input type="text" class="form-input w-100" maxlength="50" placeholder=" " @bind="ChequeNo" disabled="@(!IsChequeDetailsEnabled)" />
                                <label class="floating-label">NEFT / Cheque No.</label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-box-group static-label mb-0">
                                <InputDate class="form-input w-100" @bind-Value="ChequeDate" disabled="@(!IsChequeDetailsEnabled)" />
                                <label class="floating-label">NEFT / Cheque Date</label>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="form-box-group static-label mb-0">
                                <InputSelect class="form-input w-100" @bind-Value="SelectedBankId" disabled="@(!IsChequeDetailsEnabled)">
                                    <option value="0">Select</option>
                                    @foreach (var data in bankList.Where(x => x.IsValid))
                                    {
                                        <option value="@data.BankId">@data.BankName</option>
                                    }
                                </InputSelect>
                                <label class="floating-label">Bank</label>
                            </div>
                        </div>
                    
                        <div class="col-12">
                            <div class="form-box-group static-label mb-0">
                                <input type="text" class="form-input w-100" maxlength="100" placeholder=" " @bind="BankBranch" disabled="@(!IsChequeDetailsEnabled)" />
                                <label class="floating-label">Branch</label>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-box-group static-label mb-0">
                                <input type="text" class="form-input w-100" maxlength="300" placeholder=" " @bind="Remarks" />
                                <label class="floating-label">Remarks</label>
                            </div>
                        </div>

                      
                    </div>

                    <div class="row g-2 mt-3">
                        <div class="col-12">
                            <button class="ui fade op-1 animated button form-btn w-100" tabindex="0" @onclick="AdmitChild">
                                <div class="visible content justify-content-center">Admit Child</div>
                                <div class="hidden content">
                                    <i class="bi bi-check-lg"></i>
                                </div>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@if (ShowConcessionPopup)
{
    <div class="custom-modal row m-0">
        <div class="col-12 col-xl-8">
            <div class="modal-content clearfix main-popup">
                <div class="head-btn">
                    <h5 class="modal-title">Map concession</h5>
                    <button data-access="Close" type="button" @onclick="CloseConcessionPopup" class="close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <div class="row m-0">
                        <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-1">
                            <div class="divider-box d-flex justify-content-between align-items-center gap-2">
                                <p class="total-text-with-bg">Add Concession : -</p>
                                <hr class="m-0 w-webkit text-light-gray op-1">
                                <div class="form-box" style="min-width:220px;">
                                    <InputSelect @bind-Value="SelectedConcessionId" @bind-Value:after="OnConcessionChanged" class="form-input w-100">
                                        <option value="0">Select Concession</option>
                                        @foreach (var data in concessionList.Where(x => x.IsValid == true))
                                        {
                                            <option value="@data.ConcessionId">@data.Concession</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 p-1">
                            <div class="card">
                                <div class="card-body table-card p-0">
                                    <div class="quick-main">
                                        <div class="grid-box-with-btn">
                                            <QuickGrid Items="@concessionFeeHeadQuery" Class="table" Pagination="@concessionPagination">
                                                <TemplateColumn Title="Fee Head" Align="Align.Left">
                                                    <ChildContent>
                                                        @(string.IsNullOrWhiteSpace(context.FeeHeadName) ? " " : context.FeeHeadName)
                                                    </ChildContent>
                                                </TemplateColumn>
                                                <TemplateColumn Title="Type" Align="Align.Center" Class="text-center">
                                                    <ChildContent>
                                                        @(IsAmountConcession(context) ? "Amount" : "Percentage")
                                                    </ChildContent>
                                                </TemplateColumn>
                                                <TemplateColumn Title="Value" Align="Align.Center" Class="text-right">
                                                    <ChildContent>
                                                        @(IsAmountConcession(context)
                                                            ? $"₹{(context.ConcessionApplicable ?? 0):N2}"
                                                            : $"{(context.ConcessionApplicable ?? 0):0.##}%")
                                                    </ChildContent>
                                                </TemplateColumn>
                                                <TemplateColumn Title="Feehead Amount" Align="Align.Center" Class="text-right">
                                                    <ChildContent>
                                                        @{
                                                            var feeHead = FindGridFeeHead(context);
                                                        }
                                                        @(feeHead == null ? "-" : $"₹{feeHead.Amount:N2}")
                                                    </ChildContent>
                                                </TemplateColumn>
                                                <TemplateColumn Title="Concession Amount" Align="Align.Center" Class="text-right">
                                                    <ChildContent>
                                                        @{
                                                            var gridFeeHead = FindGridFeeHead(context);
                                                        }
                                                        @(gridFeeHead == null ? "-" : $"₹{CalculateConcession(context, gridFeeHead.Amount):N2}")
                                                    </ChildContent>
                                                </TemplateColumn>
                                            </QuickGrid>
                                        </div>
                                        <div class="footer-pagination">
                                            <div class="d-flex align-items-center">
                                                <div class="welcome-text w-100">
                                                    <Paginator State="@concessionPagination" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="form-group btn-gr d-flex">
                        <div class="form-box">
                            <button type="button" class="ui fade op-1 animated button form-btn" disabled="@(concessionFeeHeadList.Count == 0)" @onclick="ApplyConcession">
                                <div class="visible content">Submit</div>
                                <div class="hidden content">
                                    <i class="fa fa-save"></i>
                                </div>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (IsConcessionLoading)
        {
            <div class="grid-loader-overlay">
                <div class="loader-card">
                    <div class="loader-ring">
                        <div class="loader-arc"></div>
                        <div class="loader-core">
                            <img src="/images/v3m-favicon-m.png" alt="Loading" class="loader-logo" />
                        </div>
                    </div>
                    <p class="loader-text">Loading<span class="dot d1">.</span><span class="dot d2">.</span><span class="dot d3">.</span></p>
                </div>
            </div>
        }
    </div>
}

@if (IsLoading)
{
    <div class="grid-loader-overlay">
        <div class="loader-card">
            <div class="loader-ring">
                <div class="loader-arc"></div>
                <div class="loader-core">
                    <img src="/images/v3m-favicon-m.png" alt="Loading" class="loader-logo" />
                </div>
            </div>
            <p class="loader-text">Loading<span class="dot d1">.</span><span class="dot d2">.</span><span class="dot d3">.</span></p>
        </div>
    </div>
}
@* <MapTransportWithStudent IsVisible="@OpenMapTransportStudent" CurrentSessionData="@CurrentSession" SetStudentMapTransportList="@SelectStudentMapTransport"  CurrectUrl="@currentUrl" OnClose="@ClosePopup" /> *@
@code {
    private bool OpenMapTransportStudent = false;
    private string? groupcode;
    private string? branchcode;
    private long CurrentSession;
    private List<SessionModel> sessionlist = new();
    private List<SocietyModel> societyModellist = new();
    private int SelectedSocietyId;
    private string? username;
    private List<TransportStudentDataModel> SelectStudentMapTransport = new();
    // search
    private string? searchTerm;
    private RegistrationDetailsResponse selectedStudent = new();
    private bool IsStudentSelected;
    private bool IsLoading;
    private bool IsUsingTransport = false;
    // fee heads of the student's class for the selected period
    private List<ClassMapTemplateFeeHeadResponse> feeHeadList = new();
    private string? nameFilter;
    private PaginationState pagination = new() { ItemsPerPage = 20 };
    private DateTime ReceiptDate = DateTime.Today;

    // payment details — masters are loaded, values are not saved yet
    private List<PeriodMaster> PeriodTypeList = new();
    private List<FeeCollectionPeriodConfig> feeCollectionPeriodlist = new();
    private List<PaymentModel> paymentModeList = new();
    private List<ChequeTypeModel> chequeTypeList = new();
    private List<BankModel> bankList = new();
    private const string DefaultPeriodType = "Quarterly";
    private const string CashPaymentMode = "Cash";
    private string SelectedPeriodType = "";
    private int SelectedPeriodId;
    private int SelectedPaymentModeId;
    private int SelectedChequeTypeId;
    private int SelectedBankId;
    private string ChequeNo = "";
    private DateTime? ChequeDate = DateTime.Today;
    private string BankBranch = "";
    private string Remarks = "";
    private decimal PayingAmount;
    private string currentUrl = "";
    private int RouteDistance;
    // map concession popup
    private bool ShowConcessionPopup;
    private bool IsConcessionLoading;
    private int SelectedConcessionId;
    private List<MstDistance> distancelist = new();
    private List<ConcessionModel> concessionList = new();
    private List<CommonDomain> concessionFeeHeadList = new();
    private PaginationState concessionPagination = new() { ItemsPerPage = 10 };
    private IQueryable<CommonDomain> concessionFeeHeadQuery => concessionFeeHeadList.AsQueryable();
    // concession applied on the grid, sent with Admit Child
    private int AppliedConcessionId;
    private List<AdmissionConcessionFeeHead> AppliedConcessionFeeHeads = new();

    private IQueryable<ClassMapTemplateFeeHeadResponse> feeHeadQuery =>
        (string.IsNullOrWhiteSpace(nameFilter)
            ? feeHeadList
            : feeHeadList.Where(x => x.FeeHeadName != null && x.FeeHeadName.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)))
        .AsQueryable();

    private decimal TotalAmount => feeHeadList.Sum(x => x.Amount);
    private decimal TotalConcession => feeHeadList.Sum(x => x.Concession);
    private decimal TotalPayable => TotalAmount - TotalConcession;
    private decimal Balance => TotalPayable - PayingAmount;

