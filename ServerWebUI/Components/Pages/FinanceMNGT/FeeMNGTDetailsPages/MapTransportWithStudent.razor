@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string StudentNo { get; set; }
    public long SessionId { get; set; }
    [Parameter] public string CurrectUrl { get; set; }
    public string SelectedStudentNo { get; set; }
    [Parameter] public EventCallback OnSaveSuccess { get; set; }
    [Parameter] public long CurrentSessionData { get; set; }
    [Parameter] public List<TransportStudentDataModel> SetStudentMapTransportList { get; set; }
    private List<TransportRoute> transportroutelist = new();
    private List<TransportRoutePoint> transportPickupBoardingList = new();
    private List<TransportRoutePoint> transportDropBoardingList = new();
    private SearchAnyRequestModel searchAny = new();
    private List<TransportFeeConfig> distancelist = new();
    [Parameter] public EventCallback OnClose { get; set; }
    private bool _isFirstRender = true;
    private List<RoleaBase> menus = new();
    private string? roleId;
    private string? branchcode;
    private string? groupcode;
    private string UserName;
    private long CurrentSession;
    private bool ShowPopup;
    private bool ShowPopupOnSearch;
    private bool ShowPopupMapTransport;
    private bool ShowPopupMapRoute;
    private bool ShowPopupMapRouteDetails;
    private bool isAllSelected = false;
    private bool IsUsingTransport { get; set; } = false;
    private TransportSearchModel transportSearch = new();
    private List<TransportStudentDataModel> transportStudentlistdata = new();
    private List<SessionModel> sessionlist = new();
    private TransportRequestModel transportRequest = new();
    private List<StudentTransportMappedModel> studentTransportMappedlist = new();
    private List<MonthModel> FilteredMonthList = new();
    private bool IsAllMonthSelected;
    private bool OpenMappedTransportHistory;
    private List<MonthModel> MonthList = new();
    private async Task OnSessionChanged()
    {
       
            var selectedSession = sessionlist.FirstOrDefault(x => x.SessionId == CurrentSessionData);

            if (selectedSession == null)
                return;
            int startMonth = selectedSession.StartDate.Month;
            int endMonth = selectedSession.EndDate.Month;
            var orderedMonths = new List<MonthModel>();
            int current = startMonth;
            while (true)
            {
                orderedMonths.Add(MonthList.First(x => x.MonthNo == current)
                );

                if (current == endMonth)
                    break;
                current++;

                if (current > 12)
                    current = 1;
            }
            MonthList = orderedMonths;
            if (!string.IsNullOrWhiteSpace(transportRequest.SelectedMonthNo))
            {
                var selectedMonths = transportRequest.SelectedMonthNo
                    .Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Select(int.Parse)
                    .ToList();

                foreach (var month in MonthList)
                {
                    month.IsSelected = selectedMonths.Contains(month.MonthNo);
                }
            }
            IsAllMonthSelected = MonthList.Any() && MonthList.All(x => x.IsSelected);
        
        StateHasChanged();
    }
    private void SelectAllMonths(ChangeEventArgs e)
    {
        IsAllMonthSelected = (bool)e.Value!;

        foreach (var month in MonthList)
        {
            month.IsSelected = IsAllMonthSelected;
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CurrentSession = await CommonMethod.SetCurrentSessionData();
            StateHasChanged();
        }
    }

    protected IQueryable<StudentTransportMappedModel> MappedTransportmoduleQuery
    {
        get
        {
            var result = studentTransportMappedlist.AsQueryable();

            return result;
        }
    }
    private async Task MapTransportHistory()
    {

        try
        {
            OpenMappedTransportHistory = true;
            StateHasChanged();
            await Task.Delay(100);
            await JS.InvokeVoidAsync("scrollToElement", "section4");
            var selectedStudents = SetStudentMapTransportList.Select(x => x.StudentId).ToList();
            var studentNos = string.Join(",", selectedStudents);
            searchAny.GroupCode = groupcode;
            searchAny.BranchCode = branchcode;
            searchAny.SessionId = CurrentSession;
            searchAny.RequestName = studentNos;
            string ApiUri = "MapTransport/GetStudentMappedTransport";
            var apiResponse = await httpService.Post<ApiResponse<List<StudentTransportMappedModel>>>(ApiUri, searchAny) ?? new();
            if (apiResponse.Success)
            {
                studentTransportMappedlist = apiResponse.Data ?? new();
            }

            StateHasChanged();
        }
        catch
        {
            return;
        }
        IsVisible = true;
      
    }

    private async Task SetAllRecordStudent()
    {

        if (SetStudentMapTransportList?.Count == 1)
        {
            var student = SetStudentMapTransportList[0];

            transportRequest = new TransportRequestModel
            {
                StudentId = student.StudentId,
                Amount=student.Amount,
                SessionId = student.SessionId,
                StudentName = student.StudentName,
                FatherName = student.FatherName,
                ControlNo = student.ControlNo,
                ClassSection = student.ClassSection,
                CurrentAddress = student.CurrentAddress,
                SelectedMonthNo = student.SelectedMonthNo,
                DistanceName = student.DistanceName,
                RouteId = student.RouteId.ToString(),
                BoardingPointId = student.BoardingPointId.ToString(),
                DropRouteId = student.DropRouteId.ToString(),
                DropPointId = student.DropPointId.ToString(),
                TransportAppliedFrom = student.TransportAppliedFrom,
                DistanceId = Convert.ToInt32(student.DistanceId)
            };
        }
        await GetMapRouteBoardingPoint("pickup");
        await GetMapRouteBoardingPoint("drop");
        await OnSessionChanged();
       
    }

    protected override async Task OnParametersSetAsync()
    {
        if (SetStudentMapTransportList.Count != 0)
        {
            await LoadData();
            await SetAllRecordStudent();
            
        }

    }
    protected async Task LoadData()
    {
        var roleResult = await sessionStorage.GetAsync<string>("RoleId");
        roleId = roleResult.Value;
        var branchResult = await sessionStorage.GetAsync<string>("BranchCode");
        branchcode = branchResult.Value;
        var groupResult = await sessionStorage.GetAsync<string>("GroupCode");
        groupcode = groupResult.Value;
        var username = await sessionStorage.GetAsync<string>("UserName");
        UserName = username.Value;
        string ApiUri2 = $"TransportFee/GetMapAmountDistance?SessionId={CurrentSession}";
        sessionlist = await httpService.Get<List<SessionModel>>("Session/GetSession") ?? new();
        distancelist = await httpService.Get<List<TransportFeeConfig>>(ApiUri2) ?? new();
        string ApiUri1 = "Month/GetMonth";
        MonthList = await httpService.Get<List<MonthModel>>(ApiUri1) ?? new();
        searchAny.GroupCode = groupcode;
        searchAny.BranchCode = branchcode;
        string ApiUri3 = "MapTransport/GetStudentTransportRoute";
        var apiResponse = await httpService.Post<ApiResponse<List<TransportRoute>>>(ApiUri3, searchAny) ?? new();
        if (apiResponse.Success)
        {
            transportroutelist = apiResponse.Data ?? new();
        }
    }
    private async Task GetMapRouteBoardingPoint(string type)
    {
        try
        {
            searchAny.GroupCode = groupcode;
            searchAny.BranchCode = branchcode;
            if (type == "pickup")
            {

                if (!string.IsNullOrWhiteSpace(transportRequest.RouteId))
                {
                    searchAny.RequestId = Convert.ToInt32(transportRequest.RouteId);
                }
                var response = await httpService.Post<ApiResponse<List<TransportRoutePoint>>>("MapTransport/GetStudentBoardingPoint", searchAny);
                if (response.Success)
                {
                    transportPickupBoardingList = response.Data ?? new();
                }


            }
            else if (type == "drop")
            {

                searchAny.RequestId = Convert.ToInt32(transportRequest.DropRouteId);


                var response = await httpService.Post<ApiResponse<List<TransportRoutePoint>>>("MapTransport/GetStudentBoardingPoint", searchAny);

                if (response.Success)
                {
                    transportDropBoardingList = response.Data ?? new();
                }

            }

            StateHasChanged();
        }
        catch
        {
            return;
        }
    }
    private async Task SaveStudentWithTransport()
    {
        try
        {
            IsVisible = false;
            if (transportRequest.DistanceId == 0)
            {
                await Alert.ShowWarning("Please Select a distance.");
                IsVisible = true;
                return;
            }
            else if (string.IsNullOrEmpty(transportRequest.RouteId))
            {
                await Alert.ShowWarning("Please Select a pickup route.");
                IsVisible = true;
                return;
            }
            else if (string.IsNullOrEmpty(transportRequest.DropRouteId))
            {
                await Alert.ShowWarning("Please Select a  drop route.");
                IsVisible = true;
                return;
            }
            else if (string.IsNullOrEmpty(transportRequest.BoardingPointId))
            {
                await Alert.ShowWarning("Please Select a pickup point.");
                IsVisible = true;
                return;
            }
            else if (string.IsNullOrEmpty(transportRequest.DropPointId))
            {
                await Alert.ShowWarning("Please Select a  drop point.");
                IsVisible = true;
                return;
            }
            bool isSuccess = true;

            string ApiUri = "MapTransport/AddOrUpdateTransportMapMonthConfig";
            foreach (var student in SetStudentMapTransportList)
            {

                transportRequest.GroupCode = groupcode;
                transportRequest.BranchCode = branchcode;
                transportRequest.CreatedBy = UserName;
                transportRequest.UpdatedBy = UserName;
                transportRequest.StudentId = student.StudentId;
                transportRequest.SessionId = student.SessionId;
                transportRequest.PassengerType = "Student";
                transportRequest.IsTrasportReq = IsUsingTransport ? 1 : 0;
                transportRequest.SelectedMonthNo = string.Join(",", MonthList.Select(x => $"{x.MonthNo}~{(x.IsSelected ? 1 : 0)}"));
                var response = await httpService.Post<ApiResponse<string>>(ApiUri, transportRequest);
                if (response == null || !response.Success || response.Code != 1)
                {
                    isSuccess = false;
                    return;
                }

            }
            if (isSuccess)
            {
                await Alert.ShowUpdate("Transport submitted successfully.");
                transportRequest = new();
            }
            else
            {
                await Alert.ShowError("Transport submit failed.");
            }
            await ClosePopup();
            await OnSaveSuccess.InvokeAsync();
            StateHasChanged();
        }
        catch (Exception)
        {
            return;
        }
        finally
        {
            StateHasChanged();
        }
    }
    private async Task ClosePopup()
    {
        if (OnClose.HasDelegate)
            await OnClose.InvokeAsync();
        ResetMonths();
    }
    private void CloseHistory()
    {
        OpenMappedTransportHistory = false;
    }
    private void ResetMonths()
    {
        foreach (var month in MonthList)
        {
            month.IsSelected = false;
        }
        OpenMappedTransportHistory = false;
        IsAllMonthSelected = false;
    }
}

