@using Microsoft.AspNetCore.Components.QuickGrid
@using MyApp.Common
@using ServerWebUI.Components.Pages.CommonPages
@inject Shared.IHttpService httpService
@inject SweetAlertService Alert
@inject IStringLocalizer<Resource> Localizer
<style>
    .profile-photo {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #e5e7eb;
        background: #fff;
    }

    .field-title {
        font-weight: 500;
        color: #1f2937;
    }

    .field-value {
        color: #6b7280;
        font-weight: 500;
    }

    .border-column {
      border-right: 2px solid #ccc;
    min-height: 20px;
    display: flex;
    align-items: center;
    padding-left: 40px;
    }

    /* small coloured total cards next to the fee head grid (same look as Edit Invoice) */
    .invoice-amount-tile {
        border-radius: 10px;
        padding: 10px 12px;
        border: 1px solid transparent;
        height: 100%;
    }

        .invoice-amount-tile span {
            display: block;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .3px;
            opacity: .85;
        }

        .invoice-amount-tile strong {
            display: block;
            text-align: right;
            font-size: 17px;
            margin-top: 4px;
        }

        .invoice-amount-tile.tile-blue {
            background: #eff6ff;
            border-color: #bfdbfe;
            color: #1d4ed8;
        }

        .invoice-amount-tile.tile-green {
            background: #f0fdf4;
            border-color: #bbf7d0;
            color: #15803d;
        }

        .invoice-amount-tile.tile-amber {
            background: #fffbeb;
            border-color: #fde68a;
            color: #b45309;
        }

        .invoice-amount-tile.tile-navy {
            background: linear-gradient(135deg, #0b2948, #14577d);
            color: #fff;
        }
</style>

@if (ShowInvoicePreview)
{
    <div class="custom-modal row m-0 align-items-center">
        <div class="col-12 col-sm-7 col-md-5 col-lg-4 col-xl-12">
            <div class="modal-content clearfix main-popup">
                <div class="head-btn">
                    <h5 class="modal-title">Invoice Preview</h5>
                    <button data-access="Close" type="button" @onclick="CloseInvoicePreview" class="close"><span aria-hidden="true">×</span></button>
                </div>
                <div class="modal-body">
                    <div class="row gap-10-0">
                        <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-3 mt-2">
                            <div class="divider-box d-flex justify-content-between align-items-center gap-2">
                                <p class="total-text-with-bg ">
                                    Invoice Preview
                                </p>
                                <hr class="m-0 w-webkit text-light-gray op-1">
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 border-column">
                            <div class="form-box">
                                <label class="form-label">Invoice No. : @InvoiceMaster.InvoiceNo</label>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 border-column">
                            <div class="form-box">
                                <label class="form-label">Fee Period : @InvoiceMaster.PeriodName</label>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 border-column">
                            <div class="form-box">
                                <label class="form-label">Invoice Date : @InvoiceMaster.CreatedDate.ToString("dd-MM-yyyy")</label>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 ">
                            <div class="form-box">
                                <label class="form-label">Due Date : @InvoiceMaster.DueDate.ToString("dd-MM-yyyy")</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="card shadow-sm border-0 p-3">
                                <div class="row align-items-center">
                                    <div class="col-md-2 text-center">
                                        <img src="@StudentImagePreview" class="profile-photo mb-2" />
                                    </div>
                                    <div class="col-md-10">
                                        <div class="row g-2">
                                            <div class="col-md-12 ">
                                                <span class="fw-bold text-primary">@InvoiceMaster.StudentName</span>
                                            </div>
                                            <div class="col-md-4">
                                                <span class="field-title">Admission No.:</span>
                                                <span class="field-value">@InvoiceMaster.ControlNo</span>
                                            </div>
                                            <div class="col-md-8">
                                                <span class="field-title">Roll No.:</span>
                                                <span class="field-value">@InvoiceMaster.ControlNo</span>
                                            </div>
                                            <div class="col-md-4">
                                                <span class="field-title">Class / Section:</span>
                                                <span class="field-value">@InvoiceMaster.ClassSection</span>
                                            </div>
                                            <div class="col-md-8">
                                                <span class="field-title">Fee Structure:</span>
                                                <span class="field-value">@SelectTemplate</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-9">
                            <div class="card h-100">
                                <div class="card-body table-card p-0">
                                    <div class="quick-main">
                                        <div class="grid-box scrollbar-thin" style="max-height: 300px; min-height:100px;">
                                            <QuickGrid Items="@FeeHeadList.AsQueryable()" Class="table">
                                                @* fee head with its months, e.g. "Tuition Fee (Apr, May, Jun)" *@
                                                <TemplateColumn Title="Fee Head" Align="Align.Left" Sortable="true" SortBy="GridSort<InvoiceFeeHeadModel>.ByAscending(x => x.FeeHeadName)">
                                                    <ChildContent>
                                                        @GetFeeHeadWithMonths(context)
                                                    </ChildContent>
                                                </TemplateColumn>
                                                <TemplateColumn Title="Amount (₹)" Sortable="true" Class="text-right" SortBy="GridSort<InvoiceFeeHeadModel>.ByAscending(x => x.FeeHeadAmount)" Align="Align.Right">
                                                    <ChildContent>
                                                        @(context.FeeHeadAmount)
                                                    </ChildContent>
                                                </TemplateColumn>
                                                <TemplateColumn Title="Concession (₹)" Class="text-right" Sortable="true" Align="Align.Right">
                                                    <ChildContent>
                                                        <div>
                                                            @(context.Concession)
                                                        </div>
                                                    </ChildContent>
                                                </TemplateColumn>
                                                <TemplateColumn Title="Waiver (₹)" Class="text-right" Sortable="true" Align="Align.Right">
                                                    <ChildContent>
                                                        <div>
                                                            @(context.WaiveOff)
                                                        </div>
                                                    </ChildContent>
                                                </TemplateColumn>
                                                <TemplateColumn Title="Net Amount (₹)" Class="text-right" Align="Align.Right">
                                                    <span>@context.Payable.ToString("N0")</span>
                                                </TemplateColumn>
                                            </QuickGrid>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        @* totals as small coloured cards (2 + 2) next to the grid *@
                        <div class="col-12 col-lg-3">
                            <div class="card h-100">
                                <div class="card-body p-3">
                                    <div class="row g-2">
                                        <div class="col-12">
                                            <div class="invoice-amount-tile tile-blue">
                                                <span>Total Amount</span>
                                                <strong>₹ @StudentTotalAmount.ToString("N2")</strong>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="invoice-amount-tile tile-green">
                                                <span>Total Concession</span>
                                                <strong>₹ @StudentTotalConcession.ToString("N2")</strong>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="invoice-amount-tile tile-amber">
                                                <span>Total Waiver</span>
                                                <strong>₹ @TotalWaiver.ToString("N2")</strong>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="invoice-amount-tile tile-navy">
                                                <span>Net Amount</span>
                                                <strong>₹ @TotalNetAmount.ToString("N2")</strong>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (IsLoading)
{
    <div class="grid-loader-overlay">
        <div class="loader-card">
            <div class="loader-ring">
                <div class="loader-arc"></div>
                <div class="loader-core">
                    <img src="/images/v3m-favicon-m.png" alt="Loading" class="loader-logo" />
                </div>
            </div>
            <p class="loader-text">Loading<span class="dot d1">.</span><span class="dot d2">.</span><span class="dot d3">.</span></p>
        </div>
    </div>
}

@code {
    // Same pattern as EditInvoice: the calling page passes the selected invoice
    // (InvoiceId, TemplateName, ImagePath) and shows/hides this component.
    //   StudentInvoiceGeneration -> "Invoice Preview" button
    //   ViewStudentDuesAndReceipt       -> click on Invoice No in the invoice grid
    [Parameter] public SearchStudentBalanceDto SelectedStudent { get; set; } = new();
    [Parameter] public string? BranchCode { get; set; }
    [Parameter] public string? GroupCode { get; set; }
    [Parameter] public bool ShowInvoicePreview { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private bool IsLoading;
    private string? SelectTemplate;
    private string StudentImagePreview = "https://demo.schooleye.in/Images/NoPhoto.gif";

    private SearchAnyRequestModel searchAny = new();
    private InvoiceMasterModel InvoiceMaster = new();
    private List<InvoiceFeeHeadModel> FeeHeadList = new();

    private decimal StudentTotalAmount => FeeHeadList.Sum(x => x.FeeHeadAmount);
    private decimal StudentTotalConcession => FeeHeadList.Sum(x => x.Concession);
    private decimal TotalWaiver => FeeHeadList.Sum(x => x.WaiveOff);
    private decimal TotalNetAmount => FeeHeadList.Sum(x => x.Payable);

    protected override async Task OnInitializedAsync()
    {
        await LoadInvoicePreview();
    }

    private async Task LoadInvoicePreview()
    {
        try
        {
            IsLoading = true;
            searchAny.GroupCode = GroupCode;
            searchAny.BranchCode = BranchCode;
            searchAny.RequestName = SelectedStudent.InvoiceId.ToString();
            ///searchAny.IsActive = true;
            var response = await httpService.Post<ApiResponse<List<InvoiceDetailsResponse>>>("StudentFeeInvoice/GetStudentInvoicePreview", searchAny);
            if (response != null && response.Success && response.Data != null && response.Data.Count != 0)
            {
                var invoice = response.Data.FirstOrDefault() ?? new();
                InvoiceMaster = invoice.InvoiceMaster?.FirstOrDefault() ?? new();
                FeeHeadList = invoice.FeeHeadList ?? new();
                await LoadFeeHeadMonths();
                SelectTemplate = SelectedStudent.TemplateName;
                StudentImagePreview = string.IsNullOrWhiteSpace(SelectedStudent.ImagePath) ?
                "https://demo.schooleye.in/Images/NoPhoto.gif" : SelectedStudent.ImagePath;
            }
            else
            {
                InvoiceMaster = new();
                FeeHeadList = new();
                SelectTemplate = string.Empty;
                StudentImagePreview = "https://demo.schooleye.in/Images/NoPhoto.gif";
            }
        }
        catch (Exception)
        {
            await Alert.ShowCustomAlert(@Localizer["Admin"]);
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // months of each fee head in this invoice, e.g. FeeHeadId 5 -> "Apr, May, Jun"
    private Dictionary<int, string> feeHeadMonths = new();

    // the preview rows are totals per fee head; the month-wise rows of the same invoice
    // (same API, Edit Invoice mode) give the months shown in brackets
    private async Task LoadFeeHeadMonths()
    {
        feeHeadMonths = new();
        try
        {
            var monthRequest = new SearchAnyRequestModel
            {
                GroupCode = GroupCode,
                BranchCode = BranchCode,
                RequestName = SelectedStudent.InvoiceId.ToString(),
                RequestName2 = "EditInvoice"
            };
            var response = await httpService.Post<ApiResponse<List<InvoiceDetailsResponse>>>("StudentFeeInvoice/GetStudentInvoicePreview", monthRequest);
            var monthRows = response?.Data?.FirstOrDefault()?.FeeHeadList ?? new();
            feeHeadMonths = monthRows
                .Where(x => x.MonthNo > 0 && !string.IsNullOrWhiteSpace(x.MonthName))
                .GroupBy(x => x.FeeHeadId)
                .ToDictionary(
                    g => g.Key,
                    g => string.Join(", ", g
                        .GroupBy(x => x.MonthNo)
                        .OrderBy(m => (m.Key - 4 + 12) % 12) // session order: April first
                        .Select(m => m.First().MonthName.Length > 3 ? m.First().MonthName[..3] : m.First().MonthName)));
        }
        catch (Exception)
        {
            // months are only extra text; the preview still shows without them
            feeHeadMonths = new();
        }
    }

    private string GetFeeHeadWithMonths(InvoiceFeeHeadModel feeHead)
    {
        var name = string.IsNullOrEmpty(feeHead.FeeHeadName) ? " " : feeHead.FeeHeadName;
        return feeHeadMonths.TryGetValue(feeHead.FeeHeadId, out var months) && !string.IsNullOrEmpty(months)
            ? $"{name} ({months})"
            : name;
    }

    private async Task CloseInvoicePreview()
    {
        searchAny = new();
        await OnClose.InvokeAsync();
    }
}
