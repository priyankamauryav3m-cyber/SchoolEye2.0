    protected override async Task OnInitializedAsync()
    {
        try
        {
            IsLoading = true;
            MonthList = await httpService.Get<List<MonthModel>>("Month/GetMonth") ?? new();
            transportFeelist = await httpService.Get<List<TransportFeeConfig>>("TransportFee/GetTransport") ?? new();
            ApplySessionMonthOrder();
            await GetInvoivetype();
            await LoadInvoiceForEdit();
        }
        finally
        {
            IsLoading = false;
        }
    }

    protected override void OnParametersSet()
    {
        // Sync only when the parent actually changes the flag, so a parent
        // re-render does not reopen the popup while an alert is showing.
        if (ShowEditInvoice != _lastShowEditInvoice)
        {
            _lastShowEditInvoice = ShowEditInvoice;
            IsEditInvoiceOpen = ShowEditInvoice;
        }
    }

    private void HideEditInvoicePopup()
    {
        IsEditInvoiceOpen = false;
        StateHasChanged();
    }

    private void ReopenEditInvoicePopup()
    {
        IsEditInvoiceOpen = ShowEditInvoice;
        StateHasChanged();
    }

    // CustomAlert OK alert: returns immediately, so the popup is reopened
    // from CustomAlert.OnAlertClosed when the user dismisses it.
    private async Task ShowInfoAlert(string message)
    {
        HideEditInvoicePopup();
        await customAlert.ShowCustomAlert(message, false);
    }

    // SweetAlert: the call completes only after the alert is dismissed.
    private async Task ShowSweetAlert(Func<Task> alert)
    {
        HideEditInvoicePopup();
        try
        {
            await alert();
        }
        finally
        {
            ReopenEditInvoicePopup();
        }
    }

    // Yes/No confirmation (CustomAlert or SweetAlert).
    private async Task<bool> ShowConfirmAlert(Func<Task<bool>> confirm)
    {
        HideEditInvoicePopup();
        try
        {
            return await confirm();
        }
        finally
        {
            ReopenEditInvoicePopup();
        }
    }

    // Reorders MonthList to follow the session's academic-year order (e.g. Apr-Mar)
    // instead of the calendar Jan-Dec order, same as the parent grid used to do.
    private void ApplySessionMonthOrder()
    {
        if (CurrentSessionInfo == null || MonthList.Count == 0)
            return;

        int startMonth = CurrentSessionInfo.StartDate.Month;
        int endMonth = CurrentSessionInfo.EndDate.Month;
        var orderedMonths = new List<MonthModel>();
        int current = startMonth;
        while (true)
        {
            orderedMonths.Add(MonthList.First(x => x.MonthNo == current));

            if (current == endMonth)
                break;
            current++;

            if (current > 12)
                current = 1;
        }
        MonthList = orderedMonths;
    }

