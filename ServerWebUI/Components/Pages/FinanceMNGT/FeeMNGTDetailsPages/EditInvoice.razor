    private async Task OnTransportChanged()
    {
        if (IsTransport == true)
        {
            // Read straight off the loaded invoice instead of the caller-supplied
            // SelectedStudent so this works regardless of which page opened the
            // popup (not every caller has a transport flag to pass in).
            if (InvoiceMaster.ISTRANSPORTREQUIRED)
            {
                var trans = transportFeelist.FirstOrDefault(x => x.DistanceId == InvoiceMaster.RouteDistance);
                if (trans != null)
                {
                    SelectedDistanceAmount = trans.Amount;
                }
                else
                {
                    SelectedDistanceAmount = 0;
                }
                foreach (var month in MonthList)
                {
                    month.IsDisabled = false;
                    month.IsSelected = false;
                }
                foreach (var item in transportSelectMonthlist)
                {
                    var month = MonthList.FirstOrDefault(x => x.MonthNo == item.MonthNo);
                    if (month != null)
                    {
                        month.IsSelected = true;
                        month.IsDisabled = true;
                    }
                }
                SelectedFeeHeadId = 0;
                SelectedFeeHeadAmount = 0;
            }
            else
            {
                await ShowInfoAlert("Please map the transport first before proceeding with the fee collection.");
                StateHasChanged();
                IsTransport = false;
                return;
            }

        }
        else
        {
            foreach (var month in MonthList)
            {
                month.IsDisabled = false;
                month.IsSelected = false;
            }

        }

        StateHasChanged();
    }

    private async Task OnFeeHeadChanged()
    {
        if (SelectedStudent.StudentId == 0)
        {
            await ShowSweetAlert(() => Alert.ShowWarning("Please select a student!"));
            StateHasChanged();
            return;
        }
        var feeHead = feeHeadDropdownlist.FirstOrDefault(x => x.FeeHeadId == SelectedFeeHeadId);
        SelectedFeeHeadAmount = feeHead?.Amount ?? 0;
        var request = new InvoiceFeeheadMonthNoRequest
        {
            BranchCode = BranchCode,
            GroupCode = GroupCode,
            StudentId = SelectedStudent.StudentId,
            SessionId = SessionId,
            FeeHeadId = SelectedFeeHeadId
        };
        var response = await httpService.Post<ApiResponse<List<InvoiceFeeheadMonthNoResponse>>>("StudentFeeInvoice/GetInvoiceFeeheadMonthNo", request);
        if (response.Success && response.Data != null)
        {
            monthNoResponseslist = response.Data ?? new();
        }
        foreach (var month in MonthList)
        {
            month.IsDisabled = false;
            month.IsSelected = false;
        }
        MaxNewMonths = null;
        var feeHeadItems = monthNoResponseslist.Where(x => x.FeeHeadId == SelectedFeeHeadId).ToList();
        if (feeHeadItems.Any())
        {
            foreach (var item in feeHeadItems)
            {
                var month = MonthList.FirstOrDefault(x => x.MonthNo == item.MonthNo);
                if (month != null)
                {
                    month.IsSelected = true;
                    month.IsDisabled = true;
                }
            }

        }

        var applicableType = feeHeadDropdownlist.FirstOrDefault(x => x.FeeHeadId == SelectedFeeHeadId)?.FeeApplicableType;
        if (string.Equals(applicableType, "Quarterly", StringComparison.OrdinalIgnoreCase))
        {
            ApplyQuarterlyMonthRules();
        }

        StateHasChanged();
    }

    // Quarterly: each selected month represents one quarter (3 months in session order).
    // Only the first month of each remaining future quarter stays enabled;
    // everything up to and including the last already-invoiced quarter is disabled.
    private void ApplyQuarterlyMonthRules()
    {
        const int quarterSize = 3;
        var existingIndexes = MonthList
            .Select((m, i) => new { m, i })
            .Where(x => x.m.IsSelected && x.m.IsDisabled)
            .Select(x => x.i)
            .ToList();

        int alignment = existingIndexes.Count > 0 ? existingIndexes[0] % quarterSize : 0;
        int lastExisting = existingIndexes.Count > 0 ? existingIndexes.Max() : -1;

        for (int i = 0; i < MonthList.Count; i++)
        {
            bool isQuarterStart = i % quarterSize == alignment;
            bool isFuture = i >= lastExisting + quarterSize;
            if (!(isQuarterStart && isFuture) && !MonthList[i].IsSelected)
            {
                MonthList[i].IsDisabled = true;
            }
        }
    }

    private async Task RemoveFeeHeadWithAmount()
    {
        try
        {
            IsLoading = true;

            var result = FeeHeadList.Where(x => x.IsSelected).ToList();
            if (result.Count == 0)
            {
                await ShowInfoAlert("Please select a record !");
                StateHasChanged();
                return;
            }
            else if (result.Count > 1)
            {
                await ShowInfoAlert("Please select a record !");
                StateHasChanged();
                return;
            }
            var submit = await ShowConfirmAlert(() => Alert.ShowConfirm("Are you sure,you want to remove selected fee head?"));
            if (!submit)
            {
                StateHasChanged();
                return;
            }
            var selecteddata = result.Select(x => new { x.FeeHeadId, x.InvoiceId, x.MonthNo }).FirstOrDefault();
            if (SelectedStudent.StudentId == 0)
            {
                await ShowInfoAlert("Please select student first !");
                return;
            }
            feeHeadToStudent.InvoiceId = selecteddata.InvoiceId;
            feeHeadToStudent.StudentId = SelectedStudent.StudentId;
            feeHeadToStudent.HeadId = selecteddata.FeeHeadId;
            feeHeadToStudent.CreatedBy = UserName;
            feeHeadToStudent.Narration1 = studentConcessionOnChallanRequest.Narration;
            feeHeadToStudent.SelectMonthNo = selecteddata.MonthNo;
            var response = await httpService.Post<ApiResponse<object>>("StudentFeeInvoice/RemoveFeeHeadToStudentChallan", feeHeadToStudent);
            if (response.Success && response.Code == 1)
            {
                await ShowSweetAlert(() => Alert.ShowSuccess("Fee head removed successfully."));
                studentConcessionOnChallanRequest.Narration = "";
                DataChanged = true;
                await LoadInvoiceForEdit();
                StateHasChanged();
                feeHeadToStudent = new();
            }
        }
        catch (Exception)
        {
            return;
        }
        finally
        {
            StateHasChanged();
            IsLoading = false;
        }
    }

    private async Task RemoveApplyConcessionEditInvoice()
    {
        try
        {
            if (SelectedStudent.InvoiceId == 0)
            {
                await ShowInfoAlert("Please select a student !");
                StateHasChanged();
                return;
            }

            bool submit = await ShowConfirmAlert(() => customAlert.ShowConfirmationAlert("Are you sure,you want to remove applied concession on selected invoice?"));
            if (!submit)
            {
                StateHasChanged();
                return;
            }
            removeStudentConcessionFromInvoice.GroupCode = GroupCode;
            removeStudentConcessionFromInvoice.BranchCode = BranchCode;
            removeStudentConcessionFromInvoice.CreatedBy = UserName;
            removeStudentConcessionFromInvoice.InvoiceId = SelectedStudent.InvoiceId;
            removeStudentConcessionFromInvoice.SessionId = SessionId;
            removeStudentConcessionFromInvoice.Narration = studentConcessionOnChallanRequest.Narration;

            var response = await httpService.Post<ApiResponse<object>>("StudentFeeInvoice/RemoveStudentConcessionFromInvoice", removeStudentConcessionFromInvoice);
            if (response == null)
            {
                await ShowInfoAlert("Unable to remove concession. Please try again.");
            }
            else if (response.Code == 2 && response.Success)
            {
                await ShowInfoAlert("Concession removed successfully.");
                removeStudentConcessionFromInvoice = new();
                DataChanged = true;
                await LoadInvoiceForEdit();
                StateHasChanged();
            }
            else if (response.Code == 1)
            {
                await ShowInfoAlert("This invoice has no concession to remove.");
            }
            else if (response.Code == -1)
            {
                await ShowInfoAlert("An error occurred while removing the concession.");
                StateHasChanged();
            }
            else
            {
                await ShowInfoAlert("No action was taken.");
                StateHasChanged();
            }
        }
        catch (Exception)
        {
            return;
        }
        finally
        {
            StateHasChanged();
            IsLoading = false;
        }
    }

    private async Task ApplyConcessionEditInvoice()
    {
        try
        {
            IsLoading = true;
            var SelectConcessionIds = MappedconcessionQueryable.SelectMany(x => x).Where(x => x.IsSelected).Select(x => x.ConcessionId).Distinct().ToList();
            if (SelectConcessionIds.Count == 0)
            {
                await ShowInfoAlert("Please select atleast one concession !");
                return;
            }
            if (SelectedStudent.StudentId == 0)
            {
                await ShowInfoAlert("Please select student first !");
                return;
            }
            if (SelectedStudent.InvoiceId <= 0)
            {
                await ShowInfoAlert("Invoice not found for the selected student !");
                return;
            }
            bool submit = await ShowConfirmAlert(() => customAlert.ShowConfirmationAlert("Are you sure,you want to apply concession on this Invoice?"));
            if (!submit)
            {
                return;
            }

            studentConcessionOnChallanRequest.GroupCode = GroupCode;
            studentConcessionOnChallanRequest.BranchCode = BranchCode;
            studentConcessionOnChallanRequest.SessionId = SessionId;
            studentConcessionOnChallanRequest.StudentId = SelectedStudent.StudentId;
            studentConcessionOnChallanRequest.InvoiceId = SelectedStudent.InvoiceId;
            studentConcessionOnChallanRequest.ConcessionId = string.Join(",", SelectConcessionIds);
            studentConcessionOnChallanRequest.CreatedBy = UserName;

            var response = await httpService.Post<ApiResponse<ApplyStudentConcessionOnChallanResponse>>("StudentFeeInvoice/ApplyStudentConcessionOnChallan", studentConcessionOnChallanRequest);
            if (response == null)
            {
                await ShowInfoAlert("Unable to apply concession. Please try again.");
            }
            else
            {
                var result = response.Data;

                // SP ka apna detailed message (Applied + Skipped dono) priority pe use karo
                var message = !string.IsNullOrWhiteSpace(result.ResultMessage)
                    ? result.ResultMessage
                    : result.ResultValue switch
                    {
                        1 => "Invoice not found.",
                        2 => "Invoice is not in an active status.",
                        5 => "A concession has already been applied to this invoice.",
                        6 => "No active concession mapping found for this student.",
                        7 => "Given StudentId does not match the invoice.",
                        8 => "Maximum 2 concessions can be applied at once.",
                        9 => "None of the given concessions are active for this student.",
                        -1 => "Concession could not be applied: received amount cannot go below 0.",
                        -11 => "Concession amount exceeds the fee head amount.",
                        10 => "Concession applied successfully.",
                        0 => "No concession was applicable on this invoice's fee months.",
                        _ => "Challan recalculation failed."
                    };

                if (result.ResultValue == 10)
                {
                    await ShowInfoAlert(message);
                    DataChanged = true;
                    await LoadInvoiceForEdit();
                }
                else
                {
                    await ShowInfoAlert(message);
                    StateHasChanged();
                }
            }
        }
        catch (Exception)
        {
            await ShowInfoAlert("Something went wrong while applying concession.");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnConcessionCheckChanged(StudentMappedConcessionDto item, ChangeEventArgs e)
    {
        bool isChecked = (bool)e.Value;

        if (!isChecked)
        {
            var selectedCount = MappedconcessionQueryable
                .SelectMany(x => x)
                .Count(x => x.IsSelected);

            if (selectedCount <= 1)
            {
                await ShowInfoAlert("At least 1 concession must be selected.");
                return;
            }
        }

        item.IsSelected = isChecked;
    }

