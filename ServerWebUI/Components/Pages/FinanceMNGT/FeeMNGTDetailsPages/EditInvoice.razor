            searchAny.BranchCode = BranchCode;
            searchAny.RequestName = SelectedStudent.InvoiceId.ToString();
            searchAny.IsActive = true;
            searchAny.RequestName2 = "EditInvoice";
            if (SelectInvtypeId != 0)
            {
                searchAny.RequestId = SelectInvtypeId;
            }
            var response = await httpService.Post<ApiResponse<List<InvoiceDetailsResponse>>>("StudentFeeInvoice/GetStudentInvoicePreview", searchAny);
            if (response.Data.Count != 0 && response.Success)
            {
                InvoiceList = response.Data ?? new();
                var invoice = response.Data.FirstOrDefault() ?? new();
                InvoiceMaster = invoice?.InvoiceMaster.FirstOrDefault() ?? new();
                FeeHeadList = invoice?.FeeHeadList ?? new();
                SelectTemplate = SelectedStudent.TemplateName;
                StudentImagePreview = string.IsNullOrWhiteSpace(SelectedStudent.ImagePath) ?
                "https://demo.schooleye.in/Images/NoPhoto.gif" : SelectedStudent.ImagePath;
                _lastLoadedInvoiceTypeId = SelectInvtypeId;
                StateHasChanged();
            }
            else
            {
                // Keep the previously loaded invoice data; only inform the user
                // and restore the dropdown to the invoice type that is still shown.
                if (InvoiceList.Count != 0)
                {
                    SelectInvtypeId = _lastLoadedInvoiceTypeId;
                }
                else
                {
                    InvoiceList = new();
                    InvoiceMaster = new();
                    FeeHeadList = new();
                    SelectTemplate = string.Empty;
                    StudentImagePreview = "https://demo.schooleye.in/Images/NoPhoto.gif";
                }
                await ShowInfoAlert("No invoice found for the selected invoice type.");
                StateHasChanged();
                return;
            }
        }
        catch (Exception)
        {
            await ShowSweetAlert(() => Alert.ShowCustomAlert(@Localizer["Admin"]));
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

