@using Microsoft.AspNetCore.Components.QuickGrid
@using MyApp.Common
@using ServerWebUI.Components.Pages.CommonPages
@inject Shared.IHttpService httpService
@inject SweetAlertService Alert
@inject IStringLocalizer<Resource> Localizer
<style>
        .profile-photo {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #e5e7eb;
        background: #fff;
    }
</style>
@if (IsEditInvoiceOpen)
{
<div class="custom-modal row m-0 align-items-center">
    <div class="col-12 col-sm-7 col-md-5 col-lg-4 col-xl-12">
        <div class="modal-content clearfix main-popup">
            <div class="head-btn">
                <h5 class="modal-title">Invoice Preview</h5>
                <button data-access="Close" type="button" @onclick="CloseEditInvoice" class="close"><span aria-hidden="true">×</span></button>
            </div>
            <div class="tab-pane tab-pane-form fade show active overflow-auto min-h-650" style="height: calc(112vh - 270px)" ;>

                <div class="modal-body">
                    <div class="tab-content form-tab-count">
                        <div class="row gap-10-0 form-row">
                            <div class="col-12 col-sm-12 col-md-12 col-lg-9 px-3 mt-2">
                                <div class="divider-box d-flex justify-content-between align-items-center gap-2">
                                    <p class="total-text-with-bg ">
                                        Invoice Preview
                                    </p>
                                    <hr class="m-0 w-webkit text-light-gray op-1">
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-4 col-lg-3 px-3 mt-2">
                                <div class="form-box-group static-label">
                                    <InputSelect class="floating-input" placeholder=" " @bind-Value="@SelectInvtypeId" >
                                        <option value="0" selected>--Select--</option>
                                        @foreach (var data in InvoiceTypelist)
                                        {
                                            <option value="@data.InvoiceTypeId"> @data.InvoiceTypeName </option>
                                        }
                                    </InputSelect>
                                    <label class="floating-label">Invoice Type</label>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-4 col-lg-3 border-column">

                                <div class="form-box">
                                    <label for="first-name" class="form-label">Invoice No. :</label>
                                    <label for="first-name" class="form-label">@InvoiceMaster.InvoiceNo</label>

                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-4 col-lg-3 border-column">

                                <div class="form-box">
                                    <label for="first-name" class="form-label">Fee Period :</label>
                                    <label for="first-name" class="form-label"> @InvoiceMaster.PeriodName</label>

                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-4 col-lg-3 border-column">

                                <div class="form-box">
                                    <label for="first-name" class="form-label">Invoice Date :</label>
                                    <label for="first-name" class="form-label">@InvoiceMaster.CreatedDate.ToString("dd-MM-yyyy")</label>

                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-4 col-lg-3 border-column border-0">

                                <div class="form-box">
                                    <label for="first-name" class="form-label">Due Date :</label>
                                    <label for="first-name" class="form-label">@InvoiceMaster.DueDate.ToString("dd-MM-yyyy")</label>

                                </div>
                            </div>
                            <div class="col-12">
                                <div class="card shadow-sm border-0 p-3">

                                    <div class="row align-items-center">
                                        <div class="col-md-2 text-center">

                                            <img src="@StudentImagePreview" class="profile-photo mb-2" />

                                        </div>
                                        <div class="col-md-10">
                                            <div class="row g-2">
                                                <div class="col-md-12 ">
                                                    <span class="fw-bold text-primary">@InvoiceMaster.StudentName</span>
                                                </div>
                                                <div class="col-md-4">
                                                    <span class="field-title">Student No.:</span>
                                                    <span class="field-value">@InvoiceMaster.ControlNo</span>
                                                </div>

                                                <div class="col-md-8">
                                                    <span class="field-title">Session Name:</span>
                                                    <span class="field-value">@InvoiceMaster.SessionName</span>
                                                </div>
                                                <div class="col-md-4">
                                                    <span class="field-title">Class / Section:</span>
                                                    <span class="field-value">@InvoiceMaster.ClassSection</span>
                                                </div>
                                                <div class="col-md-8">
                                                    <span class="field-title">Fee Structure:</span>
                                                    <span class="field-value">@SelectTemplate</span>
                                                </div>

                                            </div>
                                        </div>

                                    </div>

                                </div>
                            </div>
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-body table-card p-0">
                                        <div class="quick-main">
                                            <div class="grid-box scrollbar-thin" style="max-height: 250px; min-height:100px;">
                                                <QuickGrid Items="@FeeHeadList.AsQueryable()" Pagination="@studentfeeheadpagination" Class="table">
                                                    <TemplateColumn Title="" Align="Align.Center">
                                                        <ChildContent>
                                                            <div>
                                                                <input type="checkbox" @bind="context.IsSelected" @onclick:stopPropagation="true" />
                                                            </div>
                                                        </ChildContent>
                                                    </TemplateColumn>

                                                    <TemplateColumn Title="Fee Head" Align="Align.Left" Sortable="true" SortBy="GridSort<InvoiceFeeHeadModel>.ByAscending(x => x.FeeHeadName)">
                                                        <ChildContent>
                                                            @(string.IsNullOrEmpty(context.FeeHeadName) ? " " : context.FeeHeadName)
                                                        </ChildContent>
                                                    </TemplateColumn>
                                                    <TemplateColumn Title="Month" Align="Align.Left" Sortable="true" SortBy="GridSort<InvoiceFeeHeadModel>.ByAscending(x => x.MonthName)">

                                                        <ChildContent>
                                                            @(string.IsNullOrEmpty(context.MonthName) ? " " : context.MonthName)
                                                        </ChildContent>
                                                    </TemplateColumn>
                                                    <TemplateColumn Title="Amount (₹)" Sortable="true" Class="text-right" SortBy="GridSort<InvoiceFeeHeadModel>.ByAscending(x => x.FeeHeadAmount)" Align="Align.Right">
                                                        <ChildContent>
                                                            @(context.FeeHeadAmount)
                                                        </ChildContent>
                                                    </TemplateColumn>

                                                    <TemplateColumn Title="Concession (₹)" Class="text-right" Sortable="true" Align="Align.Right">
                                                        <ChildContent>
                                                            <div>
                                                                @(context.Concession)
                                                            </div>
                                                        </ChildContent>
                                                    </TemplateColumn>
                                                    <TemplateColumn Title="Waiver (₹)" Class="text-right" Sortable="true" Align="Align.Right">
                                                        <ChildContent>
                                                            <div>
                                                                @(context.WaiveOff)
                                                            </div>
                                                        </ChildContent>
                                                    </TemplateColumn>
                                                    <TemplateColumn Title="Received (₹)" Class="text-right" Align="Align.Right">
                                                        <span>@context.ReceivedAmt.ToString("N0")</span>
                                                    </TemplateColumn>
                                                </QuickGrid>
                                            </div>
                                            <div class="footer-pagination">
                                                <div class="d-flex align-items-center">
                                                    <div class="welcome-text w-100">
                                                        <Paginator State="@studentfeeheadpagination" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <div class="col-12 col-sm-6 col-md-4 col-lg-2 mt-2">
                                <div class="form-box-group">
                                    <input type="text"
                                           class="floating-input text-end"
                                           placeholder=" "
                                           value="@InvoiceMaster.ArrearAmount.ToString("N2")"
                                           readonly />
                                    <label class="floating-label">Previous Arrear</label>
                                </div>

                            </div>
                            <div class="col-12 col-sm-6 col-md-4 col-lg-2 mt-2">
                                <div class="form-box-group">
                                    <input type="text"
                                           class="floating-input form-control text-end"
                                           placeholder=" "
                                           value="@InvoiceMaster.TotalAmount.ToString("N2")"
                                           readonly />
                                    <label class="floating-label">Total Amount</label>
                                </div>
                            </div>

                            <div class="col-12 col-sm-6 col-md-4 col-lg-2 mt-2">
                                <div class="form-box-group">
                                    <input type="text"
                                           class="floating-input form-control text-end"
                                           placeholder=" "
                                           value="@InvoiceMaster.TotalConcession.ToString("N2")"
                                           readonly />
                                    <label class="floating-label">Total Concession</label>
                                </div>
                            </div>

                            <div class="col-12 col-sm-6 col-md-4 col-lg-2 mt-2">
                                <div class="form-box-group">
                                    <input type="text"
                                           class="floating-input form-control text-end"
                                           placeholder=" "
                                           value="@InvoiceMaster.ReceivedAmount.ToString("N2")"
                                           readonly />
                                    <label class="floating-label">Received</label>
                                </div>
                            </div>

                            <div class="col-12 col-sm-6 col-md-4 col-lg-2 mt-2">
                                <div class="form-box-group">
                                    <input type="text"
                                           class="floating-input form-control text-end fw-bold"
                                           placeholder=" "
                                           value="@InvoiceMaster.StudentLateFee.ToString("N2")"
                                           readonly />
                                    <label class="floating-label">Late Charges</label>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-4 col-lg-2 mt-2">
                                <div class="form-box-group">
                                    <input type="text"
                                           class="floating-input form-control text-end fw-bold text-primary"
                                           placeholder=" "
                                           value="@InvoiceMaster.TotalAmount.ToString("N2")"
                                           readonly />
                                    <label class="floating-label text-primary">Balance</label>
                                </div>
                            </div>

                            <div class="col-12 mt-2">
                                <div class="form-box-group">
                                    <InputTextArea class="floating-input sms-aria" @bind-Value="studentConcessionOnChallanRequest.Narration" placeholder=" "></InputTextArea>
                                    <label class="floating-label text-primary">Narration</label>
                                </div>
                            </div>


                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 p-1">
                <div class="page-heading d-flex align-items-center justify-content-end">
                    <div class="d-flex align-items-center gap-2">
                        <div class="form-box">
                            <button type="button" class="table-btn">
                                Create Instalment
                            </button>
                        </div>
                        <div class="form-box">
                            <button type="button" class="table-btn" @onclick="ModifyDueDate">
                                Modify Due Date
                            </button>
                        </div>

                        <div class="form-box">
                            <button type="button" class="table-btn" @onclick="AddNewFeeHeadWithAmout">
                                Add Fee Head
                            </button>
                        </div>

                        <div class="form-box">
                            <button type="button" class="table-btn" @onclick="RemoveFeeHeadWithAmount">
                                Remove Fee Head
                            </button>
                        </div>

                        <div class="form-box">
                            <button type="button" class="table-btn" @onclick="OpenApplyConcession">
                                Concession Apply
                            </button>
                        </div>

                        <div class="form-box">
                            <button type="button" class="table-btn" @onclick="RemoveApplyConcessionEditInvoice">
                                Remove Concession
                            </button>
                        </div>


                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
}
@if (ShowPopupUpdateDueDate)
{
    <div class="custom-modal row m-0 align-items-center">
        <div class="col-12 col-sm-7 col-md-5 col-lg-4 col-xl-3">
            <div class="modal-content clearfix main-popup">
                <div class="head-btn">
                    <h5 class="modal-title">Modify Due Date</h5>
                    <button data-access="Close" type="button" @onclick="CloseDueDatePopup" class="close"><span aria-hidden="true">×</span></button>
                </div>
                <EditForm Model="@challanDueDate" OnValidSubmit="UpdateDueDate">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="row gap-10-0">
                            <div class="col-12 mt-2 mb-2">
                                <div class="form-box-group">
                                    <InputDate class="floating-input" placeholder=" " @bind-Value="challanDueDate.DueDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" autocomplete="off" />
                                    <label class="floating-label">Due Date <span class="required">*</span></label>
                                    <ValidationMessage For="@(() => challanDueDate.DueDate)" />
                                </div>
                            </div>

                        </div>
                    </div>

                    <div class="modal-footer">
                        <div class="form-group btn-gr">
                            <SaveUpdateButton TextSave="Submit" OnClickCancel="CloseDueDatePopup" />
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}
@if (ShowPopupAddFeehead)
{
    <div class="custom-modal row m-0 align-items-center">
        <div class="col-12 col-sm-7 col-md-5 col-lg-4 col-xl-8">
            <div class="modal-content clearfix main-popup">
                <div class="head-btn">
                    <h5 class="modal-title">Select Fee Head</h5>
                    <button data-access="Close" type="button" @onclick="CloseFeeheadPopup" class="close"><span aria-hidden="true">×</span></button>
                </div>
                <EditForm Model="@InvoiceMaster" OnValidSubmit="OnSaveFeeHeadAmount">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="card px-1 py-2 mt-2">
                            <div class="row gap-10-0">
                                <div class="row m-1 gap-15-0">
                                    <div class="col-12 px-1">
                                        <div class="card-headline d-flex align-items-center justify-content-between pb-1 p-0 mb-0">
                                            <p class="m-0 headline-text">Add Fee Head With Amount</p>
                                            <div class="d-flex align-items-center gap-2">
                                                <InputCheckbox class="form-check-input" @bind-Value="@IsTransport" @bind-Value:after="OnTransportChanged" />
                                                <label for="" class="form-label mb-0">Is Transport Using</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                @if (IsTransport == true)
                                {
                                    <div class="col-12 col-sm-6 col-md-4 col-lg-6 px-3 mt-2 ">
                                        <div class="form-box-group">
                                            <input class="floating-input" placeholder=" " type="text" value="@InvoiceMaster.DistanceName" readonly disabled />
                                            <label class="floating-label">Distance Name</label>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6 col-md-4 col-lg-6 px-3 mt-2 ">
                                        <div class="form-box-group">
                                            <input class="floating-input" placeholder=" " type="text" value="@SelectedDistanceAmount" readonly disabled />
                                            <label class="floating-label">Amount</label>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6 col-md-4 col-lg-12 px-3">
                                        <div class="form-box">
                                            <div class="sef-month-grid">
                                                @foreach (var month in MonthList)
                                                {
                                                    <label class="sef-month-pill">
                                                        <input type="checkbox" @bind="month.IsSelected" />
                                                        <span>@month.MonthName</span>
                                                    </label>
                                                }
                                            </div>

                                            @{
                                                var selectedCount = MonthList.Count(m => m.IsSelected);
                                                var currentHeadName = IsTransport ? InvoiceMaster.DistanceName : feeHeadDropdownlist.FirstOrDefault(x => x.FeeHeadId == SelectedFeeHeadId)?.FeeHeadName;
                                                var perMonthAmount = IsTransport ? SelectedDistanceAmount : SelectedFeeHeadAmount;
                                                var totalPayable = selectedCount * perMonthAmount;
                                            }

                                            <div class="sef-selected-summary">
                                                <span class="sef-sel-text">
                                                    Selected: <b>@selectedCount month@(selectedCount == 1 ? "" : "s")</b>
                                                    @if (!string.IsNullOrWhiteSpace(currentHeadName))
                                                    {
                                                        @: · @currentHeadName
                                                    }
                                                </span>
                                                <span>
                                                    <span class="sef-total-label">Total Payable</span>
                                                    <span class="sef-total-value">₹ @totalPayable</span>
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                }
                                else
                                {
                                    <div class="col-12 col-sm-6 col-md-4 col-lg-6 px-3 mt-2 ">
                                        <div class="form-box-group static-label">
                                            <InputSelect class="floating-input" @bind-Value="SelectedFeeHeadId" @bind-Value:after="OnFeeHeadChanged">
                                                <option value="0" selected>--Select--</option>
                                                @foreach (var item in feeHeadDropdownlist.Where(x => x.FeeHeadName != "Transport"))
                                                {
                                                    <option value="@item.FeeHeadId">  @item.FeeHeadName </option>
                                                }

                                            </InputSelect>
                                            <label class="floating-label">Fee Head <span class="required">*</span></label>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6 col-md-4 col-lg-6 px-3 mt-2 ">
                                        <div class="form-box-group">
                                            <input class="floating-input" placeholder=" " type="text" value="@SelectedFeeHeadAmount" readonly disabled />
                                            <label class="floating-label">Fee Head Amount<span class="required">*</span></label>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6 col-md-4 col-lg-12 px-3">
                                        <div class="form-box">
                                            <div class="sef-month-grid">
                                                @foreach (var month in MonthList)
                                                {
                                                    <label class="sef-month-pill">
                                                        <input type="checkbox" @bind="month.IsSelected" disabled="@(month.IsDisabled || (!month.IsSelected && IsMonthLimitReached))" />
                                                        <span>@month.MonthName</span>
                                                    </label>
                                                }
                                            </div>

                                            @{
                                                var selectedCount = MonthList.Count(m => m.IsSelected);
                                                var currentHeadName = IsTransport ? InvoiceMaster.DistanceName : feeHeadDropdownlist.FirstOrDefault(x => x.FeeHeadId == SelectedFeeHeadId)?.FeeHeadName;
                                                var perMonthAmount = IsTransport ? SelectedDistanceAmount : SelectedFeeHeadAmount;
                                                var totalPayable = selectedCount * perMonthAmount;
                                            }

                                            <div class="sef-selected-summary">
                                                <span class="sef-sel-text">
                                                    Selected: <b>@selectedCount month@(selectedCount == 1 ? "" : "s")</b>
                                                    @if (!string.IsNullOrWhiteSpace(currentHeadName))
                                                    {
                                                        @: · @currentHeadName
                                                    }
                                                </span>
                                                <span>
                                                    <span class="sef-total-label">Total Payable</span>
                                                    <span class="sef-total-value">₹ @totalPayable</span>
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                }


                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <div class="form-group btn-gr">
                            <SaveUpdateButton TextSave="Submit" OnClickCancel="CloseFeeheadPopup" />
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (Showpopupapplyconcession)
{
    <div class="custom-modal row m-0 align-items-center">
        <div class="col-12 col-sm-10 col-md-9 col-lg-10">
            <div class="modal-content clearfix main-popup">
                <div class="head-btn">
                    <h5 class="modal-title">Concession Details</h5>
                    <button data-access="Close" type="button" @onclick="ClosePopupConcession" class="close"><span aria-hidden="true">×</span></button>
                </div>
                <div class="overflow-auto" style="height: calc(120vh - 280px); min-height: 400px; border-radius:10px;">
                    <div class="modal-body">


                        <div class="quick-main mt-3">
                            <div class="grid-box-with-btn">

                                <QuickGrid Items="@MappedconcessionQueryable" Class="table">
                                    <TemplateColumn Title="" class="text-center" Align="Align.Center">
                                        <ChildContent>
                                            @{
                                                var firstItem = context.FirstOrDefault();
                                            }
                                            <div>
                                                @if (firstItem != null)
                                                {
                                                    <input type="checkbox" checked="@firstItem.IsSelected" @onchange="e => OnConcessionCheckChanged(firstItem, e)" @onclick:stopPropagation="true" />
                                                }

                                            </div>
                                        </ChildContent>
                                    </TemplateColumn>
                                    <TemplateColumn Title="Concession" Align="Align.Left">
                                        <ChildContent>
                                            @{
                                                var firstItem = context.FirstOrDefault();
                                            }

                                            @if (firstItem != null)
                                            {
                                                @(string.IsNullOrWhiteSpace(firstItem.ConcessionName) ? " " : firstItem.ConcessionName)
                                            }
                                        </ChildContent>
                                    </TemplateColumn>
                                    <TemplateColumn Title="Fee Head" Align="Align.Left">
                                        <ChildContent>
                                            @foreach (var item in context)
                                            {
                                                <div class="m-0">
                                                    @(string.IsNullOrWhiteSpace(item.FeeHeadName) ? " " : item.FeeHeadName)
                                                </div>

                                                @if (item != context.Last())
                                                {
                                                    <hr class="my-1 row-tb" />
                                                }
                                            }
                                        </ChildContent>
                                    </TemplateColumn>
                                    <TemplateColumn Title="VALUE (% OR AMOUNT)" Class="text-right" Align="Align.Center">
                                        <ChildContent>
                                            @foreach (var item in context)
                                            {
                                                <div class="m-0 ">
                                                    @(item.ConcessionType == 0 ? $"{item.ConcessionValue:0}%" : $"{item.ConcessionValue}")
                                                </div>

                                                @if (item != context.Last())
                                                {
                                                    <hr class="my-1 row-tb" />
                                                }
                                            }
                                        </ChildContent>
                                    </TemplateColumn>
                                    <TemplateColumn Title="Approve Remarks" Align="Align.Left">
                                        <ChildContent>
                                            @foreach (var item in context)
                                            {
                                                <div class="m-0 ">
                                                    @(string.IsNullOrWhiteSpace(item.ApproveRemarks) ? " " : item.ApproveRemarks)
                                                </div>

                                                @if (item != context.Last())
                                                {
                                                    <hr class="my-1 row-tb" />
                                                }
                                            }
                                        </ChildContent>
                                    </TemplateColumn>
                                    <TemplateColumn Title="Status" Class="text-center" Align="Align.Center">
                                        <ChildContent>
                                            @{
                                                var firstItem = context.FirstOrDefault();
                                            }

                                            @if (firstItem != null)
                                            {
                                                @if (firstItem.Status == 0)
                                                {
                                                    <span class="badge rounded-pill bg-warning text-dark">Pending... </span>
                                                }
                                                else if (firstItem.Status == 1)
                                                {
                                                    <span class="badge rounded-pill bg-success"> Approved </span>
                                                }
                                                else if (firstItem.Status == 2)
                                                {
                                                    <span class="badge rounded-pill bg-danger"> Rejected</span>
                                                }
                                            }
                                        </ChildContent>
                                    </TemplateColumn>


                                </QuickGrid>

                            </div>

                        </div>



                    </div>
                    <div class="modal-footer">
                        <div class="form-group btn-gr">
                            <div class="form-box">
                                <button type="button" class="table-btn" @onclick="ApplyConcessionEditInvoice">
                                    Apply Concession
                                </button>
                            </div>
                            <SaveUpdateButton ShowSaveButton="false" OnClickCancel="ClosePopupConcession" />


                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (IsLoading)
{
    <div class="grid-loader-overlay">
        <div class="loader-card">
            <div class="loader-ring">
                <div class="loader-arc"></div>
                <div class="loader-core">
                    <img src="/images/v3m-favicon-m.png" alt="Loading" class="loader-logo" />
                </div>
            </div>
            <p class="loader-text">Loading<span class="dot d1">.</span><span class="dot d2">.</span><span class="dot d3">.</span></p>
        </div>
    </div>
}

<CustomAlert @ref="customAlert" Title="Alert" OnAlertClosed="ReopenEditInvoicePopup" />

@code {
    [Parameter] public SearchStudentBalanceDto SelectedStudent { get; set; } = new();
    [Parameter] public SessionModel? CurrentSessionInfo { get; set; }
    [Parameter] public long SessionId { get; set; }
    [Parameter] public string? BranchCode { get; set; }
