@page "/ViewFeeTaking"
@using DomainModel.Admin
@using DomainModel.FinanceMNGT
@using DomainModel.SchoolMaster
@using System.Net
@using System.Text.Json
@using Microsoft.AspNetCore.Mvc
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyApp.Common
@inject Shared.IHttpService httpService
@inject HttpClient Http
@inject IStringLocalizer<Resource> Localizer
@inject SweetAlertService Alert
@rendermode InteractiveServer
@using ServerWebUI.Components.Common
@using ServerWebUI.Components.Pages.CommonPages
@inject IJSRuntime JS
@inject ICommonMethod _commonmethod
@inject PermissionState PermissionState
@inject NavigationManager Nav

<style>
    .quickgrid thead th:nth-last-child(2) {
        min-width: 75px;
    }

    .quickgrid tbody tr.selectRow td {
        background-color: #e7f1ff !important;
    }

    .quickgrid thead th:last-child {
        min-width: 75px;
    }

    /* ===================== Professional grid styling ===================== */
    .ft-card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 18px;
        border-bottom: 1px solid #e5e9f0;
        background: #fbfcfe;
    }

    .ft-card-title {
        font-size: 15px;
        font-weight: 700;
        color: #172334;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .ft-card-title i {
        color: #1769aa;
        font-size: 16px;
    }

    .ft-legend {
        display: flex;
        align-items: center;
        gap: 14px;
        font-size: 11.5px;
        color: #68778a;
    }

    .ft-legend-chip {
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .ft-legend-dot {
        width: 9px;
        height: 9px;
        border-radius: 3px;
        display: inline-block;
    }

    .ft-legend-dot.open {
        background: #e9f8fa;
        border: 1px solid #9fd8e2;
    }

    .ft-legend-dot.locked {
        background: #f1f3f6;
        border: 1px solid #d6dbe3;
    }

    .grid-box-with-btn .quickgrid {
        border-collapse: separate;
        border-spacing: 0;
    }

    .grid-box-with-btn .quickgrid thead th {
        background: #f5f8fb;
        color: #44536b;
        font-size: 11.5px;
        text-transform: uppercase;
        letter-spacing: .4px;
        font-weight: 750;
        border-bottom: 1px solid #e5e9f0;
    }

    .grid-box-with-btn .quickgrid tbody td {
        vertical-align: middle;
        padding-top: 8px;
        padding-bottom: 8px;
    }

    .grid-box-with-btn .quickgrid tbody tr:hover td {
        background: #fbfdff;
    }

    .grid-input-group {
        display: flex;
        align-items: stretch;
        border: 1px solid #cfd8e3;
        border-radius: 8px;
        overflow: hidden;
        background: #fff;
        transition: border-color .15s ease, box-shadow .15s ease;
        min-width: 110px;
    }

    .grid-input-group:focus-within {
        border-color: #1769aa;
        box-shadow: 0 0 0 3px rgba(23, 105, 170, .12);
    }

    .grid-input-group.is-locked {
        background: #f6f7f9;
        border-color: #e4e8ee;
    }

    .grid-input-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        background: #f5f8fb;
        color: #5a6b7d;
        border-right: 1px solid #e4e8ee;
        flex-shrink: 0;
    }

    .grid-input-group.is-locked .grid-input-icon {
        color: #a3adbb;
    }

    .grid-input {
        border: 0;
        outline: none;
        width: 100%;
        padding: 6px 10px;
        font-weight: 650;
        font-size: 13.5px;
        text-align: right;
        background: transparent;
        color: #172334;
    }

    .grid-input:disabled {
        color: #a3adbb;
        cursor: not-allowed;
    }

    .grid-static-cell {
        font-weight: 650;
        color: #172334;
    }

    .fee-type-badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .3px;
    }

    .fee-type-badge.onetime {
        background: #fff1e0;
        color: #a0570c;
    }

    .fee-type-badge.annual {
        background: #eef2ff;
        color: #3949ab;
    }

    .fee-type-badge.quarterly {
        background: #e9f8fa;
        color: #0d7f91;
    }

    .fee-type-badge.monthly {
        background: #e9f8f0;
        color: #1b8a5a;
    }
</style>

<div class="main-container">
    <div class="row m-0 main-row">
        <div class="col-12 p-1" id="main-header">
            <PageHeading Tittle="Set Fee Taking Method">
                <div class="form-box">
                    <InputSelect @bind-Value="@CurrentSession" name="session" class="form-input">
                        <option value="0">-- Select Session --</option>
                        @foreach (var data in sessionlist.Where(x => x.IsValid == true))
                        {
                            <option value="@data.SessionId">@data.SessionName </option>
                        }
                    </InputSelect>
                </div>
                <div class="form-box">
                    <InputSelect @bind-Value="gridRequest.RequestId" class="form-input">
                        <option value="0" selected>Select-Template</option>
                        @foreach (var cs in feeTemplatelist.Where(x => x.IsValid == true))
                        {
                            <option value="@cs.FeeTemplateId">@cs.TemplateName</option>
                        }
                    </InputSelect>
                </div>

                <div class="form-box">
                    <button class="ui fade op-1 animated button form-btn" @onclick="SearchByTemplateName" tabindex="0">
                        <div class="visible content">Search</div>
                        <div class="hidden content">
                            <i class="bi bi-search"></i>
                        </div>
                    </button>
                </div>
            </PageHeading>
        </div>

        <div class="col-12 p-1">
            <div class="card">
                <div class="ft-card-head">
                    <h5 class="ft-card-title"><i class="bi bi-grid-3x3-gap"></i> Fee Taking Grid</h5>
                    <div class="ft-legend">
                        <span class="ft-legend-chip"><span class="ft-legend-dot open"></span> Open for entry</span>
                        <span class="ft-legend-chip"><span class="ft-legend-dot locked"></span> Locked (Quarterly cooldown)</span>
                    </div>
                </div>
                <div class="card-body table-card p-0">
                    <div class="quick-main">
                        <div class="grid-box-with-btn">
                            <QuickGrid Items="@moduleQuery" Pagination="@pagination" Class="table">

                                @foreach (var prop in columns)
                                {
                                    if (prop == "Id" || prop == "FeeHeadId")
                                    {
                                        continue;
                                    }
                                    <TemplateColumn Title="@prop" Align="Align.Center">
                                        <ChildContent>

                                            @{
                                                string feeHeadId = context.TryGetProperty("FeeHeadId", out var fId) ? fId.ToString() : "0";
                                                string key = $"{feeHeadId}_{prop}";
                                                string idKey = $"{feeHeadId}_Id";
                                                string feeType = context.TryGetProperty("FeeType", out var ft) ? ft.ToString() : "";
                                                var filledCount = inputValues.Where(x => x.Key.StartsWith($"{feeHeadId}_") && x.Key != idKey && int.TryParse(x.Value, out var v) && v > 0).Count();
                                                var currentValue = inputValues.TryGetValue(key, out var val) ? val : "0";
                                                int.TryParse(currentValue, out var currentNum);
                                                bool isDisabled = false;

                                                if (feeType == "OneTime" || feeType == "Annual")
                                                {
                                                    if (filledCount >= 1 && currentNum == 0)
                                                    {
                                                        isDisabled = true;
                                                    }
                                                }
                                                else if (feeType == "Quarterly")
                                                {
                                                    // Quarterly cooldown: after a month is filled, the NEXT 2 months
                                                    // (in chronological column order) are locked - this spaces
                                                    // entries 3 months apart instead of just capping the total at 4.
                                                    var monthIdx = monthColumns.IndexOf(prop);
                                                    if (monthIdx >= 0 && currentNum == 0)
                                                    {
                                                        for (int m = 0; m < monthColumns.Count; m++)
                                                        {
                                                            if (m == monthIdx) continue;

                                                            var mKey = $"{feeHeadId}_{monthColumns[m]}";
                                                            if (inputValues.TryGetValue(mKey, out var mVal) && int.TryParse(mVal, out var mNum) && mNum > 0)
                                                            {
                                                                var gap = monthIdx - m;
                                                                if (gap == 1 || gap == 2)
                                                                {
                                                                    isDisabled = true;
                                                                    break;
                                                                }
                                                            }
                                                        }
                                                    }
                                                }

                                                if (!inputValues.ContainsKey(idKey))
                                                {
                                                    if (context.TryGetProperty("Id", out var idVal))
                                                    {
                                                        inputValues[idKey] = idVal.ToString();
                                                    }
                                                    else
                                                    {
                                                        inputValues[idKey] = "0";
                                                    }
                                                }
                                                if (!inputValues.ContainsKey(key))
                                                {
                                                    if (context.TryGetProperty(prop, out var jsonValue))
                                                    {
                                                        inputValues[key] = jsonValue.ToString();
                                                    }
                                                    else
                                                    {
                                                        inputValues[key] = "";
                                                    }
                                                }

                                                if (prop == "FeeType")
                                                {
                                                    var badgeClass = feeType.ToLower() switch
                                                    {
                                                        "onetime" => "onetime",
                                                        "annual" => "annual",
                                                        "quarterly" => "quarterly",
                                                        "monthly" => "monthly",
                                                        _ => "monthly"
                                                    };
                                                    <span class="fee-type-badge @badgeClass">@inputValues[key]</span>
                                                }
                                                else if (prop == "Fee Head")
                                                {
                                                    <span class="grid-static-cell">@inputValues[key]</span>
                                                }
                                                else
                                                {
                                                    <div class="grid-input-group @(isDisabled ? "is-locked" : "")">
                                                        <span class="grid-input-icon">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-currency-rupee" viewBox="0 0 16 16">
                                                                <path d="M4 3.06h2.726c1.22 0 2.12.575 2.325 1.724H4v1.051h5.051C8.855 7.001 8 7.558 6.788 7.558H4v1.317L8.437 14h2.11L6.095 8.884h.855c2.316-.018 3.465-1.476 3.688-3.049H12V4.784h-1.345c-.08-.778-.357-1.335-.793-1.732H12V2H4z"></path>
                                                            </svg>
                                                        </span>
                                                        <InputText @bind-Value="inputValues[key]" class="grid-input" disabled="@isDisabled" autocomplete="off" oninput="this.value = this.value.replace(/[^0-9]/g, '')" onkeyup="if(parseInt(this.value) > 10000) this.value = 10000" onblur="if(this.value === '') this.value = '0'" placeholder="0" />
                                                    </div>
                                                }
                                            }

                                        </ChildContent>

                                    </TemplateColumn>
                                }

                            </QuickGrid>
                        </div>
                        <div class="footer-pagination">
                            <div class="d-flex align-items-center">
                                <div class="welcome-text w-100">
                                    <Paginator State="@pagination" />
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <div class="col-12 p-1">
            <div class="page-heading d-flex align-items-center justify-content-end">

                <div class="d-flex align-items-center gap-2">
                    <div class="form-box">
                        <button type="submit" @onclick="SaveOrUpdateTempalte" class="ui fade op-1 animated button form-btn">

                            <div class="visible content">Update</div>
                            <div class="hidden content">
                                <i class="bi bi-cloud-check"></i>
                            </div>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (IsLoading)
{
    <div class="grid-loader-overlay">
        <div class="loader-card">
            <div class="loader-ring">
                <div class="loader-arc"></div>
                <div class="loader-core">
                    <img src="/images/v3m-favicon-m.png" alt="Loading" class="loader-logo" />
                </div>
            </div>
            <p class="loader-text">Loading<span class="dot d1">.</span><span class="dot d2">.</span><span class="dot d3">.</span></p>
        </div>
    </div>
}
else
{

}
@code {
    // ---------------------------------------------------------------------
    // ASSUMPTIONS / FIXES (no binding or API logic changed otherwise):
    // - Fixed a broken attribute in the pasted source:
    //   @bind-Value=gridRequest.RequestId" (missing opening quote) ->
    //   @bind-Value="gridRequest.RequestId" - same bound property, just
    //   corrected malformed Razor syntax that wouldn't have compiled.
    // - Fixed <option Value="..."> -> <option value="..."> (lowercase) on
    //   the template dropdown, for the same reason.
    // - Quarterly logic changed as requested: instead of only capping the
    //   total filled months at 4, entering an amount in a month now locks
    //   the NEXT 2 months (in column/calendar order) for that fee head,
    //   forcing a 3-month gap between entries. This assumes `columns`
    //   (and therefore monthColumns) are already in chronological month
    //   order as returned by the API - if not, the lock will follow
    //   whatever order the API returns instead of calendar order.
    // - OneTime/Annual single-entry logic is unchanged.
    // - Fixed title typo "Set Fee Taking Methoud" -> "Set Fee Taking
    //   Method" as part of the design pass.
    // ---------------------------------------------------------------------

    bool isDisabled = false;
    private Dictionary<string, string> inputValues = new();
    private bool showModal { get; set; }
    private bool IsLoading = false;
    private bool ShowPopup = false;
    PaginationState pagination = new() { ItemsPerPage = 15 };
    private string? sessionvalue;
    private long CurrentSession;
    private string? branchcode;
    private string? groupcode;
    private string? nameFilter;
    private string? UserName;
    private List<SessionModel> sessionlist = new();
    private List<FeeHeadModel> feeHeadlist = new();
    private List<dynamic> feetakinglist = new();
    private SearchAnyRequestModel gridRequest = new();
    private FeeTakingMethod feeTaking = new();
    private List<FeeTemplateModel> feeTemplatelist = new();
    private IQueryable<JsonElement> moduleQuery;
    List<JsonElement> gridData;
    private List<JsonElement> originalGridData;
    List<string> columns = new();

    // Month-only columns (excludes Id/FeeHeadId/Fee Head/FeeType), used to
    // compute the Quarterly 2-month cooldown by chronological position.
    private List<string> monthColumns => columns
        .Where(c => c != "Id" && c != "FeeHeadId" && c != "Fee Head" && c != "FeeType")
        .ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadData();
            sessionvalue = await _commonmethod.SetCurrentSession();
            CurrentSession = await _commonmethod.SetCurrentSessionData();

            StateHasChanged();
        }
    }
    private async Task LoadData()
    {
        var branchResult = await sessionStorage.GetAsync<string>("BranchCode");
        branchcode = branchResult.Value;
        var groupResult = await sessionStorage.GetAsync<string>("GroupCode");
        groupcode = groupResult.Value;
        var username = await sessionStorage.GetAsync<string>("UserName");
        UserName = username.Value;
        string ApiUri1 = "Session/GetSession";
        sessionlist = await httpService.Get<List<SessionModel>>(ApiUri1) ?? new();
        string ApiUri = "FeeHead/GetFeeHeadList";
        feeHeadlist = await httpService.Get<List<FeeHeadModel>>(ApiUri) ?? new();
        string ApiUri2 = "FeeTemplate/GetFeeTemplate";
        feeTemplatelist = await httpService.Get<List<FeeTemplateModel>>(ApiUri2) ?? new();

        StateHasChanged();
    }

    private List<JsonElement> ConvertToJsonElementList(Dictionary<string, string> inputValues)
    {

        var result = inputValues.GroupBy(x => x.Key.Split('_')[0])
            .Select(g =>
            {
                var dict = new Dictionary<string, object>();

                dict["FeeHeadId"] = int.Parse(g.Key);

                foreach (var item in g)
                {
                    var parts = item.Key.Split('_');
                    string month = parts[1];

                    if (!string.IsNullOrWhiteSpace(item.Value))
                    {
                        dict[month] = item.Value;
                    }
                }

                return dict;
            })
            .ToList();
        var json = JsonSerializer.Serialize(result);
        return JsonSerializer.Deserialize<List<JsonElement>>(json);
    }
    Dictionary<string, object> NormalizeObject(JsonElement element)
    {
        var dict = new Dictionary<string, object>();

        foreach (var prop in element.EnumerateObject().OrderBy(p => p.Name))
        {
            dict[prop.Name] = prop.Value.ToString();
        }

        return dict;
    }
    private async Task SaveOrUpdateTempalte()
    {

        try
        {
            if (gridRequest.RequestId == 0)
            {
                await Alert.ShowWarning("Please select template!");
                return;
            }
            foreach (var key in inputValues.Keys.ToList())
            {
                if (string.IsNullOrWhiteSpace(inputValues[key]))
                {
                    inputValues[key] = "0";
                }
            }
            var newData = ConvertToJsonElementList(inputValues);

            var oldData = originalGridData ?? new List<JsonElement>();

            var normalizedOld = oldData.Select(x => NormalizeObject(x)).OrderBy(x => Convert.ToInt32(x["FeeHeadId"])).ToList();

            var normalizedNew = newData.Select(x => NormalizeObject(x)).OrderBy(x => Convert.ToInt32(x["FeeHeadId"])).ToList();

            var oldJson = JsonSerializer.Serialize(normalizedOld);
            var newJson = JsonSerializer.Serialize(normalizedNew);
            IsLoading = true;
            if (oldJson == newJson)
            {
                await Alert.ShowWarning("No Change Detected");
                IsLoading = false;
                StateHasChanged();
                return;
            }

            feeTaking.SessionId = CurrentSession;
            feeTaking.GroupCode = groupcode;
            feeTaking.BranchCode = branchcode;
            feeTaking.CreatedBy = UserName;
            feeTaking.FeeTemplateID = gridRequest.RequestId;
            feeTaking.IsValid = true;
            feeTaking.GridData = ConvertToJsonElementList(inputValues);
            string apiUrl = "SetFeeTakingMethod/SaveFeeTakingMethod";
            var apiResponse = await httpService.Post<ApiResponse<object>>(apiUrl, feeTaking);
            var responsecode = apiResponse.Code;
            if (responsecode == 1)
            {
                await Alert.ShowSuccess("Set Fee Taking" + @Localizer["Inserted"]);
                StateHasChanged();
                IsLoading = false;

            }
            else if (responsecode == -2)
            {
                await Alert.ShowWarning("Set Fee Taking" + @Localizer["Already"]);
                StateHasChanged();
                IsLoading = false;
            }
            else if (responsecode == 2)
            {
                await Alert.ShowUpdate("Set Fee Taking" + @Localizer["Updated"]);
                StateHasChanged();
                IsLoading = false;
            }
            else
            {
                await Alert.ShowCustomAlert(@Localizer["Admin"]);
                StateHasChanged();
                IsLoading = false;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            return;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }


    }
    private async Task Searchdata()
    {

        gridRequest.GroupCode = groupcode;
        gridRequest.BranchCode = branchcode;
        gridRequest.SessionId = CurrentSession;
        string ApiUri2 = "SetFeeTakingMethod/GetFeeHeadsOfTemplate";
        var apiResponse = await httpService.Post<ApiResponse<List<JsonElement>>>(ApiUri2, gridRequest) ?? new();
        if (apiResponse.Success && apiResponse.Data != null)
        {
            gridData = apiResponse.Data;
            var json = JsonSerializer.Serialize(gridData);
            originalGridData = JsonSerializer.Deserialize<List<JsonElement>>(json);
        }
        else
        {
            gridData = null;
        }
        if (gridData != null && gridData.Any())
        {
            columns = gridData.First().EnumerateObject().Select(p => p.Name).ToList();
        }
        else
        {
            columns = new List<string>();
        }
        moduleQuery = gridData.AsQueryable();
        StateHasChanged();
    }
    private async Task SearchByTemplateName()
    {
        try
        {
            if (gridRequest.RequestId == 0)
            {
                await Alert.ShowWarning("Please select template!");
                return;
            }
            IsLoading = true;
            await Searchdata();
            await Searchdata();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            IsLoading = false;

            StateHasChanged();
        }
    }

}
