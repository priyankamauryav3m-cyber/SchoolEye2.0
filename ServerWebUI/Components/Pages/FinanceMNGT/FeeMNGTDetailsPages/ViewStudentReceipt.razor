                                {
                                    <div class="validation-message">Please select cancel type.</div>
                                }
                            </div>
                        </div>
                        <div class="col-12 mb-4">
                            <div class="form-box-group static-label">
                                <InputDate class="@CancelDateInputClass" placeholder=" " @bind-Value="cancelRequest.CancelledDate" />
                                <label class="floating-label">Date <span class="required">*</span></label>
                                @if (CancelDateError)
                                {
                                    <div class="validation-message">Please select date.</div>
                                }
                            </div>
                        </div>
                        <div class="col-12 mb-4">
                            <div class="form-box-group">
                                <input class="floating-input @(CancelReasonError ? "is-required-empty" : "")"
                                       placeholder=" " maxlength="250" autocomplete="off"
                                       @bind="cancelRequest.Remark" @bind:event="oninput" />
                                <label class="floating-label">Cancel Reason <span class="required">*</span></label>
                                @if (CancelReasonError)
                                {
                                    <div class="validation-message">Cancel reason is required.</div>
                                }
                            </div>
                        </div>

                        @* Cancel Type = Other: the money received is kept as advance or refunded (cheque bounce = money never received) *@
                        @if (HasSettlement)
                        {
                            <div class="col-12 mb-2">
                                <div class="cancel-settle-title">Amount ₹ @((cancelReceipt.PaidAmount ?? 0).ToString("N2")) <span class="required">*</span></div>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <div class="cancel-settle-option @(settlementMode == 1 ? "active" : "")" @onclick="() => SelectSettlement(1)">
                                            <input type="radio" name="cancelSettle" checked="@(settlementMode == 1)" />
                                            <div><strong>Keep as Advance</strong><span>Dues come back, amount stays as student advance and is adjusted in the next fee.</span></div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="cancel-settle-option @(settlementMode == 2 ? "active" : "")" @onclick="() => SelectSettlement(2)">
                                            <input type="radio" name="cancelSettle" checked="@(settlementMode == 2)" />
                                            <div><strong>Refund to Parent</strong><span>Dues come back, amount is returned. OTP to the parent is required.</span></div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @if (settlementMode == 2)
