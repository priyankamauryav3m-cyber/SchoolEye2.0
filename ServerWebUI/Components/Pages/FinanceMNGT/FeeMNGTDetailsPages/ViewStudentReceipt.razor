                                <div class="col-12 mb-2">
                                    @if (refundContacts == null)
                                    {
                                        <div class="text-muted small">Loading parent contacts...</div>
                                    }
                                    else if (!refundContacts.HasEmail && !refundContacts.HasMobile)
