    // ---------------- Cancel Receipt popup ----------------
    // one selected active receipt; Cancel Type, Date (default today) and Cancel Reason are mandatory
    // searched with Cancel Type = Cheque Bounce -> StudentFeeReceipt/GenerateReceiptChqBounceChallan (V3M_FIN_GenerateReceiptChqBounceChallan),
    //                                              popup Cancel Type 1 = Cheque Bounce (charges), 2 = Other
    // otherwise (All / Other)                    -> StudentFeeReceipt/CancelStudentReceipt (V3M_FIN_CancelStudentReceipt)
    private bool ShowCancelPopup;
    private bool cancelSubmitted;
    private string searchedCancelType = "-1";
    private bool IsChequeBounceCancel => searchedCancelType == "Cheque Bounce";
    private bool CancelTypeError => cancelSubmitted && cancelRequest.CancelType != 1 && cancelRequest.CancelType != 2;
    private bool CancelDateError => cancelSubmitted && cancelRequest.CancelledDate == null;
    private bool CancelReasonError => cancelSubmitted && string.IsNullOrWhiteSpace(cancelRequest.Remark);
    private string CancelTypeInputClass => CancelTypeError ? "floating-input is-required-empty" : "floating-input";
    private string CancelDateInputClass => CancelDateError ? "floating-input is-required-empty" : "floating-input";
    private StudentFeeReceiptListResponse? cancelReceipt;
    private ReceiptChqBounceRequest cancelRequest = new();

    // Cancel Type = Other (normal cancel): 1 = Keep as Advance, 2 = Refund to Parent (OTP to the parent)
    // cheque bounce has no settlement: the money was never received
    private bool HasSettlement => !IsChequeBounceCancel && cancelRequest.CancelType == 2 && (cancelReceipt?.PaidAmount ?? 0) > 0;
    private byte settlementMode = 1;
    private ReceiptRefundContactsResponse? refundContacts;
    private string otpChannel = "Email";
    private string? otpSentTo;
    private string refundOtp = string.Empty;
    private bool OtpError => cancelSubmitted && HasSettlement && settlementMode == 2 && otpSentTo != null
                             && (refundOtp.Trim().Length != 6 || !refundOtp.Trim().All(char.IsDigit));

    private async Task SelectSettlement(byte mode)
    {
        settlementMode = mode;
        if (mode != 2 || refundContacts != null || cancelReceipt == null)
            return;

        try
        {
            var response = await httpService.Post<ApiResponse<ReceiptRefundContactsResponse>>("StudentFeeReceipt/GetReceiptRefundContacts",
                new StudentReceiptByIdRequest { GroupCode = groupcode, BranchCode = branchcode, ReceiptId = cancelReceipt.ReceiptId });
            refundContacts = response?.Data ?? new ReceiptRefundContactsResponse();
            // only the contacts the parent has are shown; email is used when it is there
            otpChannel = refundContacts.HasEmail ? "Email" : "Mobile";
        }
        catch (Exception ex)
        {
            refundContacts = new ReceiptRefundContactsResponse();
            await Alert.ShowError(string.IsNullOrWhiteSpace(ex.Message) ? "Unable to load parent contacts." : ex.Message);
        }
    }

    private async Task SendRefundOtp()
    {
        if (cancelReceipt == null)
            return;

        IsLoading = true;
        StateHasChanged();
        try
        {
            var response = await httpService.Post<ApiResponse<SendReceiptRefundOtpResponse>>("StudentFeeReceipt/SendReceiptRefundOtp",
                new SendReceiptRefundOtpRequest
                {
                    GroupCode = groupcode,
                    BranchCode = branchcode,
                    ReceiptId = cancelReceipt.ReceiptId,
                    Channel = otpChannel,
                    RequestedBy = UserName
                });
            IsLoading = false;
            StateHasChanged();

            if (response != null && response.Success)
            {
                otpSentTo = response.Data?.SentTo;
                refundOtp = string.Empty;
                await Alert.ShowSuccess(response.Message ?? "OTP sent successfully.");
            }
            else
            {
                await Alert.ShowWarning(response?.Message ?? "Unable to send OTP.");
            }
        }
        catch (Exception ex)
        {
            IsLoading = false;
            StateHasChanged();
            await Alert.ShowError(string.IsNullOrWhiteSpace(ex.Message) ? "Unable to send OTP." : ex.Message);
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task OpenCancelPopup()
    {
        if (selectedReceiptIds.Count != 1)
        {
            await Alert.ShowWarning("Please select one receipt to cancel.");
            return;
        }

        var row = receiptlist.FirstOrDefault(x => x.ReceiptId == selectedReceiptIds.First());
        if (row == null)
        {
            await Alert.ShowWarning("Receipt record was not found.");
            return;
        }
        if (row.Valid != true)
        {
            await Alert.ShowWarning("Receipt is already cancelled.");
            return;
        }

        cancelReceipt = row;
        cancelRequest = new ReceiptChqBounceRequest { CancelType = 0, CancelledDate = DateTime.Today, Remark = string.Empty };
        cancelSubmitted = false;
        ResetSettlement();
        ShowCancelPopup = true;
    }

    private void CloseCancelPopup()
    {
        ShowCancelPopup = false;
        cancelReceipt = null;
        cancelSubmitted = false;
        ResetSettlement();
    }

    private void ResetSettlement()
    {
        settlementMode = 1;
        refundContacts = null;
        otpChannel = "Email";
        otpSentTo = null;
        refundOtp = string.Empty;
    }

    private async Task SubmitCancelReceipt()
    {
        if (cancelReceipt == null)
            return;

        // missing values -> red message under the field (no alert); Submit works once all three are filled
        cancelSubmitted = true;
        if (CancelTypeError || CancelDateError || CancelReasonError)
            return;

        var settleMode = HasSettlement ? settlementMode : (byte)0;
        if (settleMode == 2)
        {
            if (refundContacts == null || (!refundContacts.HasEmail && !refundContacts.HasMobile))
            {
                await Alert.ShowWarning("No email or SMS mobile no. found for the parent. Refund cannot be verified.");
                return;
            }
            if (otpSentTo == null)
            {
                await Alert.ShowWarning("Please send the OTP to the parent first.");
                return;
            }
            if (OtpError)
                return;
        }

        var confirmText = settleMode switch
        {
            1 => $"Receipt {cancelReceipt.ReceiptNo} will be cancelled and ₹ {(cancelReceipt.PaidAmount ?? 0):N2} kept as student advance. Continue?",
            2 => $"Receipt {cancelReceipt.ReceiptNo} will be cancelled and ₹ {(cancelReceipt.PaidAmount ?? 0):N2} refunded to the parent. Continue?",
            _ => null
        };
        if (confirmText != null && !await Alert.ShowConfirm(confirmText))
            return;

        cancelRequest.GroupCode = groupcode;
        cancelRequest.BranchCode = branchcode;
        cancelRequest.ReceiptId = cancelReceipt.ReceiptId;
        cancelRequest.CancelledBy = UserName;
        cancelRequest.Remark = cancelRequest.Remark.Trim();

        IsLoading = true;
        StateHasChanged();
        try
        {
            var response = IsChequeBounceCancel
                ? await httpService.Post<ApiResponse<object>>("StudentFeeReceipt/GenerateReceiptChqBounceChallan", cancelRequest)
                : await httpService.Post<ApiResponse<object>>("StudentFeeReceipt/CancelStudentReceipt", new CancelStudentReceiptRequest
                {
                    GroupCode = cancelRequest.GroupCode,
                    BranchCode = cancelRequest.BranchCode,
                    ReceiptId = cancelRequest.ReceiptId,
                    CancelledBy = cancelRequest.CancelledBy,
                    CancelReason = cancelRequest.Remark,
                    SettlementMode = settleMode,
                    OtpCode = settleMode == 2 ? refundOtp.Trim() : null
                });
            IsLoading = false;
            StateHasChanged();

            if (response != null && response.Success)
            {
                CloseCancelPopup();
                await Alert.ShowSuccess(response.Message ?? "Receipt cancelled successfully.");
                await SearchReceipt();
            }
            else
            {
                await Alert.ShowWarning(response?.Message ?? "Unable to cancel the receipt.");
            }
        }
        catch (Exception ex)
        {
            IsLoading = false;
            StateHasChanged();
            await Alert.ShowError(string.IsNullOrWhiteSpace(ex.Message) ? "Unable to cancel the receipt." : ex.Message);
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

