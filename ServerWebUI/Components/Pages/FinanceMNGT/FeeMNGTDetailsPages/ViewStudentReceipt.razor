@page "/ViewStudentReceipt"
@using DomainModel.Admin
@using DomainModel.FinanceMNGT
@using DomainModel.SchoolMaster
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyApp.Common
@using ServerWebUI.Components.Pages.CommonPages
@inject Shared.IHttpService httpService
@inject SweetAlertService Alert
@inject ICommonMethod _commonmethod
@inject IJSRuntime JS
@rendermode InteractiveServer
<style>
    .border-box
    {
     height: 36px;
    }
        .quickgrid thead th:nth-last-child(2) {
    min-width: 75px;
}
.quickgrid thead th:last-child {
    min-width: 75px;
}
    /* receipt popups / cancel styles: StudentReceiptActions.razor */
    /* long Period / Remarks in the grid: short text, full text on hover + click */
    .vsr-more {
        cursor: pointer;
        color: #0d6efd;
        white-space: nowrap;
    }
    .vsr-more:hover {
        text-decoration: underline;
    }
    .vsr-full-text {
        white-space: pre-wrap;
        word-break: break-word;
        max-height: 60vh;
        overflow-y: auto;
        padding: 6px 4px;
    }
</style>

<div class="main-container">
    <div class="row m-0 main-row">

        <div class="col-12 p-1" id="main-header">
            <PageHeading Tittle="View Student Receipt">
                <LeadingContent><BackToFeeAccount /></LeadingContent>
                <ChildContent>
                @* Status: All = -1, Active = 1, Cancelled = 0 *@
                <div class="form-box">
                    <div class="border-box d-flex justify-content-center align-items-center gap-3">
                        <InputRadioGroup @bind-Value="request.Status">
                            <div class="d-flex align-items-center gap-1">
                                <InputRadio id="statusAll" Value="-1" />
                                <label for="statusAll" class="form-label">All</label>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <InputRadio id="statusActive" Value="1" />
                                <label for="statusActive" class="form-label">Active</label>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <InputRadio id="statusCancelled" Value="0" />
                                <label for="statusCancelled" class="form-label">Cancelled</label>
                            </div>
                        </InputRadioGroup>
                    </div>
                </div>
                <div class="form-box">
                    <InputSelect @bind-Value="request.SessionId" class="form-input">
                        <option value="0">All</option>
                        @foreach (var data in sessionlist.Where(x => x.IsValid == true))
                        {
                            <option value="@data.SessionId">@data.SessionName</option>
                        }
                    </InputSelect>
                </div>
                <div class="form-box">
                    <InputSelect @bind-Value="request.GroupClassCode" class="form-input">
                        <option value="">-- All Class Group --</option>
                        @foreach (var data in classGroupList)
                        {
                            <option value="@data">@data</option>
                        }
                    </InputSelect>
                </div>
                <div class="form-box">
                    <InputSelect @bind-Value="request.ClassCode" class="form-input">
                        <option value="">-- All Class --</option>
                        @foreach (var data in classlist)
                        {
                            <option value="@data.ClassCode">@data.ClassName</option>
                        }
                    </InputSelect>
                </div>
                <div class="form-box">
                    <button type="button" class="ui fade op-1 animated button form-btn" tabindex="0" @onclick="() => SearchReceipt()">
                        <div class="visible content justify-content-center">Search</div>
                        <div class="hidden content"><i class="bi bi-search"></i></div>
                    </button>
                </div>
                <button class="icon-btn icon-btn-white open-popup" @onclick="OpenSearch" data-id="popup" tabindex="0">
                    <i class="bi bi-sliders"></i>
                </button>
                </ChildContent>
            </PageHeading>
        </div>

        <div class="col-12 p-1">
            <div class="card">
                <div class="card-body table-card p-0">
                    <div class="quick-main">
                        <div class="grid-box-with-btn">
                            <QuickGrid Items="@receiptQuery" Pagination="@pagination" Class="table">
                                <TemplateColumn Title="" Align="Align.Center">
                                    <HeaderTemplate>
                                        <div class="d-flex align-items-center justify-content-center">
                                            <input type="checkbox" @bind="IsAllSelected" @bind:after="ToggleAll" @onclick:stopPropagation="true" />
                                        </div>
                                    </HeaderTemplate>
                                    <ChildContent>
                                        <div class="d-flex align-items-center justify-content-center">
                                            <input type="checkbox" checked="@selectedReceiptIds.Contains(context.ReceiptId)" @onchange="e => ToggleReceipt(context, e)" @onclick:stopPropagation="true" />
                                        </div>
                                    </ChildContent>
                                </TemplateColumn>
                                <TemplateColumn Title="Receipt No" Class="text-center" Align="Align.Center">
                                    <button type="button" class="btn btn-link p-0" title="Receipt Details" @onclick="() => OpenReceiptDetails(context)" @onclick:stopPropagation="true">
                                        @(string.IsNullOrWhiteSpace(context.ReceiptNo) ? " " : context.ReceiptNo)
                                    </button>
                                </TemplateColumn>
                                <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.StudentNo) ? " " : x.StudentNo)" Title="Student No" Class="text-center" Align="Align.Center" />
                                <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.StudentName) ? " " : x.StudentName)" Title="Student Name" Align="Align.Left" />
                                <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.ClassSection) ? (x.ClassName ?? " ") : x.ClassSection)" Title="Class" Align="Align.Left" />
                                <PropertyColumn Property="@(x => Money(RowTotal(x)))" Title="Total" Class="text-right" Align="Align.Right" />
                                <PropertyColumn Property="@(x => Money(x.PaidAmount))" Title="Paid" Class="text-right" Align="Align.Right" />
                                <PropertyColumn Property="@(x => Money(x.Concession))" Title="Concession" Class="text-right" Align="Align.Right" />
                                <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.ConcessionName) ? " " : x.ConcessionName)" Title="Concession Name" Align="Align.Left" />
                                <PropertyColumn Property="@(x => Money(x.Balance))" Title="Balance" Class="text-right" Align="Align.Right" />
                                <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.PaymentMode) ? " " : x.PaymentMode)" Title="Mode" Class="text-center" Align="Align.Center" />
                                @* long period / remark: short text + "...", full text on hover (tooltip) and on click (popup) *@
                                <TemplateColumn Title="Period" Align="Align.Left">
                                    @if (IsLongPeriod(context.PeriodName))
                                    {
                                        <span class="vsr-more" title="@context.PeriodName" @onclick='() => OpenFullText(context, context.PeriodName!, "Period")' @onclick:stopPropagation="true">@ShortPeriod(context.PeriodName!)</span>
                                    }
                                    else
                                    {
                                        @(string.IsNullOrWhiteSpace(context.PeriodName) ? " " : context.PeriodName)
                                    }
                                </TemplateColumn>
                                <TemplateColumn Title="Remarks" Align="Align.Left">
                                    @if (IsLongRemark(context.Remark))
                                    {
                                        <span class="vsr-more" title="@context.Remark" @onclick='() => OpenFullText(context, context.Remark!, "Remarks")' @onclick:stopPropagation="true">@ShortRemark(context.Remark!)</span>
                                    }
                                    else
                                    {
                                        @(string.IsNullOrWhiteSpace(context.Remark) ? " " : context.Remark)
                                    }
                                </TemplateColumn>
                                <PropertyColumn Property="@(x => x.ReceiptDate.HasValue ? x.ReceiptDate.Value.ToString("dd/MM/yyyy") : " ")" Title="Date" Class="text-center" Align="Align.Center" />
                                <TemplateColumn Title="Status" Class="text-center" Align="Align.Center">
                                    @* active receipt -> Done (green), cancelled -> Not Done (red) *@
                                    @if (context.Valid == true)
                                    {
                                        <span class="badge rounded-pill bg-success">  <i class="bi bi-check-circle-fill"></i> Done</span>
                                        @* <span class="d-inline-flex align-items-center justify-content-center gap-1 text-success fw-semibold text-nowrap">
                                           
                                        </span> *@
                                    }
                                    else
                                    {
                                         <span class="badge rounded-pill bg-danger"> <i class="bi bi-x-circle-fill"></i> Not Done</span>
                                        @* <span class="d-inline-flex align-items-center justify-content-center gap-1 text-danger fw-semibold text-nowrap">
                                           
                                        </span> *@
                                    }
                                </TemplateColumn>
                            </QuickGrid>
                        </div>
                        @* totals of the whole searched list, shown inside the grid above the pager *@
                        
                        <div class="footer-pagination">
                            <div class="d-flex align-items-center">
                                <div class="welcome-text w-100 d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center gap-3 px-2 py-1 fw-bold">
                                        <span>Receipt(s) : @receiptlist.Count</span>
                                        <span class="text-danger">Total : @Money(receiptlist.Sum(RowTotal))</span>
                                        <span class="text-success">Received : @Money(receiptlist.Sum(x => x.PaidAmount ?? 0))</span>
                                        <span class="text-info">Concession : @Money(receiptlist.Sum(x => x.Concession ?? 0))</span>
                                    </div>
                                    <Paginator State="@pagination" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 p-1">
            <div class="page-heading d-flex align-items-center justify-content-end flex-wrap gap-2">
                <StudentReceiptActions @ref="receiptActions"
                                       GroupCode="@groupcode" BranchCode="@branchcode" UserName="@UserName"
                                       Sessions="sessionlist" PaymentModes="paymentModeList" Banks="bankList"
                                       Receipts="receiptlist" SelectedReceiptIds="selectedReceiptIds"
                                       Filter="request" SearchedFromDate="searchedFromDate" SearchedToDate="searchedToDate"
                                       SearchedCancelType="@searchedCancelType"
                                       OnChanged="() => SearchReceipt()" />
            </div>
        </div>
    </div>
</div>

@* ---------------- Search popup (all filters) ---------------- *@
@if (ShowSearchPopup)
{
    <div class="custom-modal row m-0">
        <div class="col-12 col-sm-10 col-md-9 col-lg-8 col-xl-8">
            <div class="modal-content clearfix main-popup">
                <div class="head-btn">
                    <h5 class="modal-title">Search Receipt</h5>
                    <button data-access="Close" type="button" @onclick="ClosePopup" class="close"><span aria-hidden="true">×</span></button>
                </div>
                <div class="modal-body">
                    <div class="row m-0 form-row">
                        <div class="col-lg-4 col-md-6 col-12 mb-2">
                            <div class="form-box-group static-label">
                                <InputSelect class="floating-input" placeholder=" " @bind-Value="request.SessionId">
                                    <option value="0">All</option>
                                    @foreach (var data in sessionlist.Where(x => x.IsValid == true))
                                    {
                                        <option value="@data.SessionId">@data.SessionName</option>
                                    }
                                </InputSelect>
                                <label class="floating-label">Session</label>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 col-12 mb-2">
                            <div class="form-box-group static-label">
                                <InputSelect class="floating-input" placeholder=" " @bind-Value="request.GroupClassCode">
                                    <option value="">All</option>
                                    @foreach (var data in classGroupList)
                                    {
                                        <option value="@data">@data</option>
                                    }
                                </InputSelect>
                                <label class="floating-label">Class-Group</label>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 col-12 mb-2">
                            <div class="form-box-group static-label">
                                <InputSelect class="floating-input" placeholder=" " @bind-Value="request.ClassCode">
                                    <option value="">All</option>
                                    @foreach (var data in classlist)
                                    {
                                        <option value="@data.ClassCode">@data.ClassName</option>
                                    }
                                </InputSelect>
                                <label class="floating-label">Class</label>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 col-12 mb-2">
                            <div class="form-box-group static-label">
                                <InputSelect class="floating-input" placeholder=" " @bind-Value="request.ReceiptMode">
                                    <option value="-1">All</option>
                                    <option value="1">Admission Fee</option>
                                    <option value="0">Other</option>
                                </InputSelect>
                                <label class="floating-label">Receipt Type</label>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 col-12 mb-2">
                            <div class="form-box-group static-label">
                                <InputSelect class="floating-input" placeholder=" " @bind-Value="request.CancelType">
                                    <option value="-1">All</option>
                                    <option value="Cheque Bounce">Cheque Bounce</option>
                                    <option value="Other">Other</option>
                                </InputSelect>
                                <label class="floating-label">Cancel Type</label>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 col-12 mb-2">
                            <div class="form-box-group static-label">
                                <InputSelect class="floating-input" placeholder=" " @bind-Value="request.PaymentMode">
                                    <option value="">All</option>
                                    @foreach (var data in paymentModeList)
                                    {
                                        <option value="@data.ModeName">@data.ModeName</option>
                                    }
                                </InputSelect>
                                <label class="floating-label">Mode</label>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 col-12 mb-2">
                            <div class="form-box-group static-label">
                                <InputSelect class="floating-input" placeholder=" " @bind-Value="request.BankAccountId">
                                    <option value="0">All</option>
                                    @foreach (var data in bankList)
                                    {
                                        <option value="@data.BankId">@data.BankName</option>
                                    }
                                </InputSelect>
                                <label class="floating-label">Bank A/C</label>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 col-12 mb-2">
                            <div class="form-box-group">
                                <input class="floating-input" placeholder=" " maxlength="50" autocomplete="off" @bind="request.FeeReceivedBy" />
                                <label class="floating-label">Counter (Received By)</label>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 col-12 mb-2">
                            <div class="form-box-group">
                                <input class="floating-input" placeholder=" " maxlength="50" autocomplete="off" @bind="request.ChequeNo" />
                                <label class="floating-label">Cheque No.</label>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 col-12 mb-2">
                            <div class="form-box-group">
                                <input class="floating-input" placeholder=" " maxlength="50" autocomplete="off" @bind="request.ReceiptNo" />
                                <label class="floating-label">Receipt No.</label>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 col-12 mb-2">
                            <div class="form-box-group">
                                <input class="floating-input" placeholder=" " maxlength="100" autocomplete="off" @bind="request.FirstName" />
                                <label class="floating-label">Student Name</label>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 col-12 mb-2">
                            <div class="form-box-group">
                                <input class="floating-input" placeholder=" " maxlength="50" autocomplete="off" @bind="request.StudentNo" />
                                <label class="floating-label">Student No.</label>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 col-12 mb-2">
                            <div class="form-box-group static-label">
                                <InputDate class="floating-input" placeholder=" " @bind-Value="request.FromDate" />
                                <label class="floating-label">From Date <span class="required">*</span></label>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 col-12 mb-2">
                            <div class="form-box-group static-label">
                                <InputDate class="floating-input" placeholder=" " @bind-Value="request.ToDate" />
                                <label class="floating-label">To Date <span class="required">*</span></label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="form-group btn-gr">
                        <button type="button" class="ui fade op-1 animated button form-btn" @onclick="() => SearchReceipt(fromPopup: true)" tabindex="0">
                            <div class="visible content">Search</div>
                            <div class="hidden content"><i class="bi bi-search"></i></div>
                        </button>
                        <button type="button" class="table-btn" @onclick="ResetFilters">Reset</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* Receipt Details / Cheque Report / Cancel / Edit Receipt popups are in StudentReceiptActions *@

@* ---------------- Full Period / Remarks popup (grid cell click) ---------------- *@
@if (fullText != null)
{
    <div class="custom-modal row m-0">
        <div class="col-12 col-sm-8 col-md-6 col-lg-5 col-xl-4">
            <div class="modal-content clearfix main-popup">
                <div class="head-btn">
                    <h5 class="modal-title">@fullTextTitle - Receipt @fullTextReceiptNo</h5>
                    <button data-access="Close" type="button" @onclick="CloseFullText" class="close"><span aria-hidden="true">×</span></button>
                </div>
                <div class="modal-body">
                    <div class="vsr-full-text">@fullText</div>
                </div>
            </div>
        </div>
    </div>
}


@if (IsLoading)
{
    <div class="grid-loader-overlay above-popup">
        <div class="loader-card">
            <div class="loader-ring">
                <div class="loader-arc"></div>
                <div class="loader-core">
                    <img src="/images/v3m-favicon-m.png" alt="Loading" class="loader-logo" />
                </div>
            </div>
            <p class="loader-text">Loading<span class="dot d1">.</span><span class="dot d2">.</span><span class="dot d3">.</span></p>
        </div>
    </div>
}

@code {
    // ---------------------------------------------------------------------
    // Search -> StudentFeeReceipt/GetStudentFeeReceiptListData (V3M_FIN_GetStudentFeeReceiptList)
    // - Session defaults to All (0), the current session is NOT preselected.
    // - Receipt Type (static): All = -1, Admission Fee = 1, Other = 0.
    // - Cancel Type (static) : All = "-1", Cheque Bounce, Other.
    // - Status               : All = -1, Active = 1, Cancelled = 0.
    // - Payment mode from the master (PaymentMode/GetBankPaymentMode), bank from Finance/GetBank.
    // - Class-Group from StudentFeeReceipt/GetClassGroup (V3M_DetClassGroup by group + branch code), All = "".
    // - Bottom buttons are static for now.
    // ---------------------------------------------------------------------

    private bool IsLoading = false;
    private bool ShowSearchPopup = false;

    // ---------------- grid: long Period / Remarks ----------------
    // Period comes as "Apr,May,Jun,..." (V3M_FIN_GetStudentFeeReceiptList): first 3 months + "...".
    // Remarks longer than RemarkMaxLength are cut + "...". Hover = tooltip, click = popup with the full text.
    private const int PeriodMaxMonths = 3;
    private const int RemarkMaxLength = 25;
    private string? fullText;
    private string? fullTextTitle;
    private string? fullTextReceiptNo;

    private static string[] PeriodParts(string? period) =>
        string.IsNullOrWhiteSpace(period)
            ? Array.Empty<string>()
            : period.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private static bool IsLongPeriod(string? period) => PeriodParts(period).Length > PeriodMaxMonths;
    private static string ShortPeriod(string period) => string.Join(", ", PeriodParts(period).Take(PeriodMaxMonths)) + " ...";
    private static bool IsLongRemark(string? remark) => !string.IsNullOrWhiteSpace(remark) && remark.Trim().Length > RemarkMaxLength;
    private static string ShortRemark(string remark) => remark.Trim()[..RemarkMaxLength].TrimEnd() + " ...";

    private void OpenFullText(StudentFeeReceiptListResponse row, string text, string title)
    {
        fullTextTitle = title;
        fullTextReceiptNo = row.ReceiptNo;
        fullText = title == "Period" ? string.Join(", ", PeriodParts(text)) : text.Trim();
    }

    private void CloseFullText() => fullText = null;
    private string? branchcode;
    private string? groupcode;
      private string? UserName;
    private StudentFeeReceiptListRequest request = NewRequest();

    private List<SessionModel> sessionlist = new();
    private List<string> classGroupList = new();
    private List<BranchClassModel> classlist = new();
    private List<PaymentModel> paymentModeList = new();
    private List<BankModel> bankList = new();

    private List<StudentFeeReceiptListResponse> receiptlist = new();
    private IQueryable<StudentFeeReceiptListResponse> receiptQuery => receiptlist.AsQueryable();
    private PaginationState pagination = new() { ItemsPerPage = 20 };

    private HashSet<long> selectedReceiptIds = new();
    private bool IsAllSelected;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var branchResult = await sessionStorage.GetAsync<string>("BranchCode");
            branchcode = branchResult.Value;
            UserName = (await sessionStorage.GetAsync<string>("UserName")).Value;
            var groupResult = await sessionStorage.GetAsync<string>("GroupCode");
            groupcode = groupResult.Value;

            await LoadData();
            StateHasChanged();

            // opened from Student Fee Account (receipt no. click): search that student's receipts straight away
            if (!string.IsNullOrWhiteSpace(QueryStudentNo) || !string.IsNullOrWhiteSpace(QueryReceiptNo))
            {
                request.StudentNo = QueryStudentNo?.Trim() ?? string.Empty;
                request.ReceiptNo = QueryReceiptNo?.Trim() ?? string.Empty;
                if (QuerySessionId > 0)
                    request.SessionId = QuerySessionId;
                // receipt can be from an earlier year -> wide date range, the student / receipt no. narrows it
                request.FromDate = DateTime.Today.AddYears(-5);
                request.ToDate = DateTime.Today;
                await SearchReceipt();
            }
        }
    }

    // /ViewStudentReceipt?StudentNo=...&ReceiptNo=...&SessionId=... (Student Fee Account)
    [Parameter]
    [SupplyParameterFromQuery(Name = "StudentNo")]
    public string? QueryStudentNo { get; set; }
    [Parameter]
    [SupplyParameterFromQuery(Name = "ReceiptNo")]
    public string? QueryReceiptNo { get; set; }
    [Parameter]
    [SupplyParameterFromQuery(Name = "SessionId")]
    public long QuerySessionId { get; set; }

    // academic year starts in April -> From Date = 1 Apr of the running year, To Date = today
    private static StudentFeeReceiptListRequest NewRequest()
    {
        var today = DateTime.Today;
        return new StudentFeeReceiptListRequest
        {
            SessionId = 0,
            ReceiptMode = -1,
            Status = -1,
            CancelType = "-1",
            FromDate = new DateTime(today.Month >= 4 ? today.Year : today.Year - 1, 4, 1),
            ToDate = today
        };
    }

    private async Task LoadData()
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            var sessionTask = httpService.Get<List<SessionModel>>("Session/GetSession");
            var classTask = httpService.Get<List<BranchClassModel>>("BranchClass/GetClassCode");
            var paymentTask = httpService.Get<List<PaymentModel>>("PaymentMode/GetBankPaymentMode");
            var bankTask = httpService.Get<List<BankModel>>("Finance/GetBank");
            var classGroupTask = httpService.Post<ApiResponse<List<ClassGroupResponse>>>("StudentFeeReceipt/GetClassGroup",
                new ClassGroupRequest { GroupCode = groupcode, BranchCode = branchcode });

            sessionlist = await sessionTask ?? new();
            classlist = await classTask ?? new();
            paymentModeList = await paymentTask ?? new();
            bankList = await bankTask ?? new();

            var classGroupResponse = await classGroupTask;
            classGroupList = (classGroupResponse != null && classGroupResponse.Success && classGroupResponse.Data != null)
                ? classGroupResponse.Data.Where(x => !string.IsNullOrWhiteSpace(x.ClassCode)).Select(x => x.ClassCode!).ToList()
                : new();
        }
        catch
        {
            await Alert.ShowError("Unable to load data.");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void OpenSearch() => ShowSearchPopup = true;
    private void ClosePopup() => ShowSearchPopup = false;

    private void ResetFilters()
    {
        request = NewRequest();
    }

    private async Task SearchReceipt(bool fromPopup = false)
    {
        if (request.FromDate == default || request.ToDate == default)
        {
            await Alert.ShowWarning("Please select from date and to date.");
            return;
        }
        if (request.FromDate.Date > request.ToDate.Date)
        {
            await Alert.ShowWarning("From date cannot be greater than to date.");
            return;
        }

        IsLoading = true;
        StateHasChanged();
        try
        {
            request.GroupCode = groupcode;
            request.BranchCode = branchcode;
            request.GroupClassCode = request.GroupClassCode ?? string.Empty;
            request.ClassCode = request.ClassCode ?? string.Empty;
            request.PaymentMode = request.PaymentMode ?? string.Empty;
            request.ReceiptNo = request.ReceiptNo?.Trim() ?? string.Empty;
            request.StudentNo = request.StudentNo?.Trim() ?? string.Empty;
            request.FirstName = request.FirstName?.Trim() ?? string.Empty;
            request.ChequeNo = request.ChequeNo?.Trim() ?? string.Empty;
            request.FeeReceivedBy = request.FeeReceivedBy?.Trim() ?? string.Empty;
            request.CancelType = string.IsNullOrWhiteSpace(request.CancelType) ? "-1" : request.CancelType;

            var response = await httpService.Post<ApiResponse<List<StudentFeeReceiptListResponse>>>("StudentFeeReceipt/GetStudentFeeReceiptListData", request);

            receiptlist = (response != null && response.Success) ? (response.Data ?? new()) : new();
            // the list print shows the date range of the search that produced this list
            searchedFromDate = request.FromDate;
            searchedToDate = request.ToDate;
            // Cancel button: cheque bounce challan only when this list was searched with Cancel Type = Cheque Bounce
            searchedCancelType = request.CancelType;
            selectedReceiptIds = new();
            IsAllSelected = false;
            await pagination.SetCurrentPageIndexAsync(0);

            if (fromPopup)
                ShowSearchPopup = false;

            if (receiptlist.Count == 0)
            {
                IsLoading = false;
                StateHasChanged();
                await Alert.ShowWarning(response?.Message ?? "No records found.");
            }
        }
        catch (Exception ex)
        {
            receiptlist = new();
            IsLoading = false;
            StateHasChanged();
            await Alert.ShowError(string.IsNullOrWhiteSpace(ex.Message) ? "Unable to load receipts." : ex.Message);
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // ---------------- receipt actions (buttons + popups: StudentReceiptActions component) ----------------
    private StudentReceiptActions? receiptActions;
    private DateTime searchedFromDate;
    private DateTime searchedToDate;
    private string searchedCancelType = "-1";

    private async Task OpenReceiptDetails(StudentFeeReceiptListResponse row)
    {
        if (receiptActions != null)
            await receiptActions.OpenReceiptDetails(row);
    }

    // receipt total: the list SP leaves TotalAmount empty for some receipts (Total showed 0.00),
    // then it is what was due on the receipt = paid + concession + balance
    private static decimal RowTotal(StudentFeeReceiptListResponse x) =>
        (x.TotalAmount ?? 0) > 0 ? x.TotalAmount!.Value : (x.PaidAmount ?? 0) + (x.Concession ?? 0) + (x.Balance ?? 0);

    // amounts on this page in Indian currency format, e.g. ₹1,23,456.00 (same hi-IN currency format as Edit Invoice)
    private static readonly System.Globalization.CultureInfo IndianCurrency = new("hi-IN");
    private static string Money(decimal? amount) => (amount ?? 0).ToString("C2", IndianCurrency);

    // ---------------- grid selection ----------------
    private void ToggleAll()
    {
        selectedReceiptIds = IsAllSelected ? receiptlist.Select(x => x.ReceiptId).ToHashSet() : new();
    }

    private void ToggleReceipt(StudentFeeReceiptListResponse row, ChangeEventArgs e)
    {
        if (e.Value is bool isChecked && isChecked)
            selectedReceiptIds.Add(row.ReceiptId);
        else
            selectedReceiptIds.Remove(row.ReceiptId);

        IsAllSelected = receiptlist.Count > 0 && selectedReceiptIds.Count == receiptlist.Count;
    }
}
