                                        @if (refundContacts.HasMobile)
                                        {
                                            <label class="cancel-settle-contact">
                                                <input type="radio" name="otpChannel" checked="@(otpChannel == "Mobile")" @onchange='() => otpChannel = "Mobile"' />
                                                <i class="bi bi-phone"></i> SMS &nbsp;<b>@refundContacts.MaskedMobile</b>
                                            </label>
                                        }
                                        <div class="d-flex align-items-center gap-2 mt-1">
                                            <button type="button" class="table-btn" @onclick="SendRefundOtp" disabled="@IsLoading">
                                                <i class="bi bi-send"></i> @(otpSentTo == null ? "Send OTP" : "Resend OTP")
                                            </button>
                                            @if (otpSentTo != null)
                                            {
                                                <span class="small text-success">OTP sent to @otpSentTo</span>
                                            }
                                        </div>
                                    }
                                </div>

                            @if (otpSentTo != null)
                            {
                                <div class="col-12 mb-4 mt-2">
                                    <div class="form-box-group">
                                        <input class="floating-input @(OtpError ? "is-required-empty" : "")" placeholder=" " maxlength="6" inputmode="numeric" autocomplete="one-time-code"
                                               @bind="refundOtp" @bind:event="oninput" />
                                        <label class="floating-label">OTP <span class="required">*</span></label>
                                        @if (OtpError)
