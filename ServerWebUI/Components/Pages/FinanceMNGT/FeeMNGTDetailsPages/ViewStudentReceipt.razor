@page "/ViewStudentReceipt"
@using DomainModel.Admin
@using DomainModel.FinanceMNGT
@using DomainModel.SchoolMaster
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyApp.Common
@using ServerWebUI.Components.Pages.CommonPages
@inject Shared.IHttpService httpService
@inject SweetAlertService Alert
@inject ICommonMethod _commonmethod
@inject IJSRuntime JS
@rendermode InteractiveServer
<style>
        .quickgrid thead th:nth-last-child(2) {
    min-width: 75px;
}
.quickgrid thead th:last-child {
    min-width: 75px;
}
    .field-title {
        font-weight: 500;
        color: #1f2937;
    }

    .field-value {
        color: #6b7280;
        font-weight: 500;
    }

    /* small coloured amount cards next to the fee head grid (same as Edit Invoice) */
    .invoice-amount-tile {
        border-radius: 10px;
        padding: 10px 12px;
        border: 1px solid transparent;
        height: 100%;
    }

        .invoice-amount-tile span {
            display: block;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .3px;
            opacity: .85;
        }

        .invoice-amount-tile strong {
            display: block;
            text-align: right;
            font-size: 17px;
            margin-top: 4px;
        }

        .invoice-amount-tile.tile-blue {
            background: #eff6ff;
            border-color: #bfdbfe;
            color: #1d4ed8;
        }

        .invoice-amount-tile.tile-green {
            background: #f0fdf4;
            border-color: #bbf7d0;
            color: #15803d;
        }

        .invoice-amount-tile.tile-teal {
            background: #f0fdfa;
            border-color: #99f6e4;
            color: #0f766e;
        }

        .invoice-amount-tile.tile-amber {
            background: #fffbeb;
            border-color: #fde68a;
            color: #b45309;
        }

        .invoice-amount-tile.tile-navy {
            background: linear-gradient(135deg, #0b2948, #14577d);
            color: #fff;
        }

    /* loader must show over the Receipt Details popup (.custom-modal is z-index 999999999) */
    .grid-loader-overlay.above-popup {
        z-index: 1000000000;
    }
</style>

<div class="main-container">
    <div class="row m-0 main-row">

        <div class="col-12 p-1" id="main-header">
            <PageHeading Tittle="View Student Receipt">
                <div class="form-box">
                    <InputSelect @bind-Value="request.SessionId" class="form-input">
                        <option value="0">All</option>
                        @foreach (var data in sessionlist.Where(x => x.IsValid == true))
                        {
                            <option value="@data.SessionId">@data.SessionName</option>
                        }
                    </InputSelect>
                </div>
                <div class="form-box">
                    <InputSelect @bind-Value="request.GroupClassCode" class="form-input">
                        <option value="">-- All Class Group --</option>
                        @foreach (var data in classGroupList)
                        {
                            <option value="@data">@data</option>
                        }
                    </InputSelect>
                </div>
                <div class="form-box">
                    <InputSelect @bind-Value="request.ClassCode" class="form-input">
                        <option value="">-- All Class --</option>
                        @foreach (var data in classlist)
                        {
                            <option value="@data.ClassCode">@data.ClassName</option>
                        }
                    </InputSelect>
                </div>
                <div class="form-box">
                    <button type="button" class="ui fade op-1 animated button form-btn" tabindex="0" @onclick="() => SearchReceipt()">
                        <div class="visible content justify-content-center">Search</div>
                        <div class="hidden content"><i class="bi bi-search"></i></div>
                    </button>
                </div>
                <button class="icon-btn icon-btn-white open-popup" @onclick="OpenSearch" data-id="popup" tabindex="0">
                    <i class="bi bi-sliders"></i>
                </button>
            </PageHeading>
        </div>

        <div class="col-12 p-1">
            <div class="card">
                <div class="card-body table-card p-0">
                    <div class="quick-main">
                        <div class="grid-box-with-btn">
                            <QuickGrid Items="@receiptQuery" Pagination="@pagination" Class="table">
                                <TemplateColumn Title="" Align="Align.Center">
                                    <HeaderTemplate>
                                        <div class="d-flex align-items-center justify-content-center">
                                            <input type="checkbox" @bind="IsAllSelected" @bind:after="ToggleAll" @onclick:stopPropagation="true" />
                                        </div>
                                    </HeaderTemplate>
                                    <ChildContent>
                                        <div class="d-flex align-items-center justify-content-center">
                                            <input type="checkbox" checked="@selectedReceiptIds.Contains(context.ReceiptId)" @onchange="e => ToggleReceipt(context, e)" @onclick:stopPropagation="true" />
                                        </div>
                                    </ChildContent>
                                </TemplateColumn>
                                <TemplateColumn Title="Receipt No" Class="text-center" Align="Align.Center">
                                    <button type="button" class="btn btn-link p-0" title="Receipt Details" @onclick="() => OpenReceiptDetails(context)" @onclick:stopPropagation="true">
                                        @(string.IsNullOrWhiteSpace(context.ReceiptNo) ? " " : context.ReceiptNo)
                                    </button>
                                </TemplateColumn>
                                <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.StudentNo) ? " " : x.StudentNo)" Title="Student No" Class="text-center" Align="Align.Center" />
                                <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.StudentName) ? " " : x.StudentName)" Title="Student Name" Align="Align.Left" />
                                <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.ClassSection) ? (x.ClassName ?? " ") : x.ClassSection)" Title="Class" Align="Align.Left" />
                                <PropertyColumn Property="@(x => (x.TotalAmount ?? 0).ToString("N2"))" Title="Total" Class="text-right" Align="Align.Right" />
                                <PropertyColumn Property="@(x => (x.PaidAmount ?? 0).ToString("N2"))" Title="Paid" Class="text-right" Align="Align.Right" />
                                <PropertyColumn Property="@(x => (x.Concession ?? 0).ToString("N2"))" Title="Concession" Class="text-right" Align="Align.Right" />
                                <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.ConcessionName) ? " " : x.ConcessionName)" Title="Concession Name" Align="Align.Left" />
                                <PropertyColumn Property="@(x => (x.Balance ?? 0).ToString("N2"))" Title="Balance" Class="text-right" Align="Align.Right" />
                                <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.PaymentMode) ? " " : x.PaymentMode)" Title="Mode" Class="text-center" Align="Align.Center" />
                                <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.Remark) ? " " : x.Remark)" Title="Remarks" Align="Align.Left" />
                                <PropertyColumn Property="@(x => x.ReceiptDate.HasValue ? x.ReceiptDate.Value.ToString("dd/MM/yyyy") : " ")" Title="Date" Class="text-center" Align="Align.Center" />
                                <TemplateColumn Title="Status" Class="text-center" Align="Align.Center">
                                    @* active receipt -> Done (green), cancelled -> Not Done (red) *@
                                    @if (context.Valid == true)
                                    {
                                        <span class="d-inline-flex align-items-center justify-content-center gap-1 text-success fw-semibold text-nowrap">
                                            <i class="bi bi-check-circle-fill"></i> Done
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="d-inline-flex align-items-center justify-content-center gap-1 text-danger fw-semibold text-nowrap">
                                            <i class="bi bi-x-circle-fill"></i> Not Done
                                        </span>
                                    }
                                </TemplateColumn>
                            </QuickGrid>
                        </div>
                        <div class="footer-pagination">
                            <div class="d-flex align-items-center">
                                <div class="welcome-text w-100">
                                    <Paginator State="@pagination" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 p-1">
            <div class="page-heading d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div class="d-flex align-items-center gap-3 px-1 fw-bold">
                    <span>Receipt(s) : @receiptlist.Count</span>
                    <span class="text-danger">Total : @receiptlist.Sum(x => x.TotalAmount ?? 0).ToString("N2")</span>
                    <span class="text-success">Received : @receiptlist.Sum(x => x.PaidAmount ?? 0).ToString("N2")</span>
                    <span class="text-info">Concession : @receiptlist.Sum(x => x.Concession ?? 0).ToString("N2")</span>
                </div>
                @* buttons are static for now (no action wired yet) *@
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <div class="form-box"><button type="button" class="table-btn">Chq Report</button></div>
                    <div class="form-box"><button type="button" class="table-btn">Cancel</button></div>
                    <div class="form-box"><button type="button" class="table-btn" @onclick="OnPrintListClick">Print</button></div>
                    <div class="form-box"><button type="button" class="table-btn">Student Print</button></div>
                    <div class="form-box"><button type="button" class="table-btn" @onclick="GenerateStudentReceiptHeadWisePdf">Head Details</button></div>
                    <div class="form-box"><button type="button" class="table-btn">Edit</button></div>
                    <div class="form-box"><button type="button" class="table-btn">Collection Report</button></div>
                    <div class="form-box"><button type="button" class="table-btn">Print Multi Receipt</button></div>
                </div>
            </div>
        </div>
    </div>
</div>

@* ---------------- Search popup (all filters) ---------------- *@
@if (ShowSearchPopup)
{
    <div class="custom-modal row m-0">
        <div class="col-12 col-sm-10 col-md-9 col-lg-8 col-xl-8">
            <div class="modal-content clearfix main-popup">
                <div class="head-btn">
                    <h5 class="modal-title">Search Receipt</h5>
                    <button data-access="Close" type="button" @onclick="ClosePopup" class="close"><span aria-hidden="true">×</span></button>
                </div>
                <div class="modal-body">
                    <div class="row m-0 form-row">
                        <div class="col-lg-4 col-md-6 col-12 mb-2">
                            <div class="form-box-group static-label">
                                <InputSelect class="floating-input" placeholder=" " @bind-Value="request.SessionId">
                                    <option value="0">All</option>
                                    @foreach (var data in sessionlist.Where(x => x.IsValid == true))
                                    {
                                        <option value="@data.SessionId">@data.SessionName</option>
                                    }
                                </InputSelect>
                                <label class="floating-label">Session</label>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 col-12 mb-2">
                            <div class="form-box-group static-label">
                                <InputSelect class="floating-input" placeholder=" " @bind-Value="request.GroupClassCode">
                                    <option value="">All</option>
                                    @foreach (var data in classGroupList)
                                    {
                                        <option value="@data">@data</option>
                                    }
                                </InputSelect>
                                <label class="floating-label">Class-Group</label>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 col-12 mb-2">
                            <div class="form-box-group static-label">
                                <InputSelect class="floating-input" placeholder=" " @bind-Value="request.ClassCode">
                                    <option value="">All</option>
                                    @foreach (var data in classlist)
                                    {
                                        <option value="@data.ClassCode">@data.ClassName</option>
                                    }
                                </InputSelect>
                                <label class="floating-label">Class</label>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 col-12 mb-2">
                            <div class="form-box-group static-label">
                                <InputSelect class="floating-input" placeholder=" " @bind-Value="request.ReceiptMode">
                                    <option value="-1">All</option>
                                    <option value="1">Admission Fee</option>
                                    <option value="0">Other</option>
                                </InputSelect>
                                <label class="floating-label">Receipt Type</label>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 col-12 mb-2">
                            <div class="form-box-group static-label">
                                <InputSelect class="floating-input" placeholder=" " @bind-Value="request.CancelType">
                                    <option value="-1">All</option>
                                    <option value="Cheque Bounce">Cheque Bounce</option>
                                    <option value="Other">Other</option>
                                </InputSelect>
                                <label class="floating-label">Cancel Type</label>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 col-12 mb-2">
                            <div class="form-box-group static-label">
                                <InputSelect class="floating-input" placeholder=" " @bind-Value="request.PaymentMode">
                                    <option value="">All</option>
                                    @foreach (var data in paymentModeList)
                                    {
                                        <option value="@data.ModeName">@data.ModeName</option>
                                    }
                                </InputSelect>
                                <label class="floating-label">Mode</label>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 col-12 mb-2">
                            <div class="form-box-group static-label">
                                <InputSelect class="floating-input" placeholder=" " @bind-Value="request.BankAccountId">
                                    <option value="0">All</option>
                                    @foreach (var data in bankList)
                                    {
                                        <option value="@data.BankId">@data.BankName</option>
                                    }
                                </InputSelect>
                                <label class="floating-label">Bank A/C</label>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 col-12 mb-2">
                            <div class="form-box-group">
                                <input class="floating-input" placeholder=" " maxlength="50" autocomplete="off" @bind="request.FeeReceivedBy" />
                                <label class="floating-label">Counter (Received By)</label>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 col-12 mb-2">
                            <div class="form-box-group">
                                <input class="floating-input" placeholder=" " maxlength="50" autocomplete="off" @bind="request.ChequeNo" />
                                <label class="floating-label">Cheque No.</label>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 col-12 mb-2">
                            <div class="form-box-group">
                                <input class="floating-input" placeholder=" " maxlength="50" autocomplete="off" @bind="request.ReceiptNo" />
                                <label class="floating-label">Receipt No.</label>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 col-12 mb-2">
                            <div class="form-box-group">
                                <input class="floating-input" placeholder=" " maxlength="100" autocomplete="off" @bind="request.FirstName" />
                                <label class="floating-label">Student Name</label>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 col-12 mb-2">
                            <div class="form-box-group">
                                <input class="floating-input" placeholder=" " maxlength="50" autocomplete="off" @bind="request.StudentNo" />
                                <label class="floating-label">Student No.</label>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 col-12 mb-2">
                            <div class="form-box-group static-label">
                                <InputDate class="floating-input" placeholder=" " @bind-Value="request.FromDate" />
                                <label class="floating-label">From Date <span class="required">*</span></label>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 col-12 mb-2">
                            <div class="form-box-group static-label">
                                <InputDate class="floating-input" placeholder=" " @bind-Value="request.ToDate" />
                                <label class="floating-label">To Date <span class="required">*</span></label>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6 col-12 mb-2">
                            <div class="form-box-group static-label">
                                <InputSelect class="floating-input" placeholder=" " @bind-Value="request.Status">
                                    <option value="-1">All</option>
                                    <option value="1">Active</option>
                                    <option value="0">Cancelled</option>
                                </InputSelect>
                                <label class="floating-label">Status</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="form-group btn-gr">
                        <button type="button" class="ui fade op-1 animated button form-btn" @onclick="() => SearchReceipt(fromPopup: true)" tabindex="0">
                            <div class="visible content">Search</div>
                            <div class="hidden content"><i class="bi bi-search"></i></div>
                        </button>
                        <button type="button" class="table-btn" @onclick="ResetFilters">Reset</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* ---------------- Receipt Details popup (click on Receipt No) ---------------- *@
@if (ShowReceiptDetailsPopup && receiptHeader != null)
{
    <div class="custom-modal row m-0 align-items-center">
        <div class="col-12 col-xl-10">
            <div class="modal-content clearfix main-popup">
                <div class="head-btn">
                    <h5 class="modal-title">Receipt Details &nbsp;&middot;&nbsp; Session : @GetSessionName(receiptHeader.SessionId)</h5>
                    <button data-access="Close" type="button" @onclick="CloseReceiptDetails" class="close"><span aria-hidden="true">×</span></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2 form-row">
                        <div class="col-12">
                            <div class="card shadow-sm border-0 p-3">
                                <div class="row g-2">
                                    <div class="col-md-12">
                                        <span class="fw-bold text-primary">@receiptHeader.StudentName</span>
                                        @if (receiptHeader.Valid == false)
                                        {
                                            <span class="badge bg-danger ms-2">Cancelled</span>
                                        }
                                    </div>
                                    <div class="col-md-4">
                                        <span class="field-title">Receipt No.:</span>
                                        <span class="field-value">@receiptHeader.ReceiptNo</span>
                                    </div>
                                    <div class="col-md-4">
                                        <span class="field-title">Student No.:</span>
                                        <span class="field-value">@receiptHeader.StudentNo</span>
                                    </div>
                                    <div class="col-md-4">
                                        <span class="field-title">Class:</span>
                                        <span class="field-value">@(string.IsNullOrWhiteSpace(receiptHeader.ClassSection) ? receiptHeader.ClassName : receiptHeader.ClassSection)</span>
                                    </div>
                                    <div class="col-md-4">
                                        <span class="field-title">Receipt Date:</span>
                                        <span class="field-value">@(receiptHeader.CreatedDate?.ToString("dd/MM/yyyy"))</span>
                                    </div>
                                    <div class="col-md-4">
                                        <span class="field-title">Father Name:</span>
                                        <span class="field-value">@receiptHeader.FatherName</span>
                                    </div>
                                    <div class="col-md-4">
                                        <span class="field-title">Period:</span>
                                        <span class="field-value">@receiptHeader.PeriodName</span>
                                    </div>
                                    <div class="col-md-4">
                                        <span class="field-title">Payment:</span>
                                        <span class="field-value">@receiptHeader.PaymentMode</span>
                                    </div>
                                    <div class="col-md-4">
                                        <span class="field-title">Received By:</span>
                                        <span class="field-value">@receiptHeader.CreatedBy</span>
                                    </div>
                                    <div class="col-md-4">
                                        <span class="field-title">Remarks:</span>
                                        <span class="field-value">@receiptHeader.Remark</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(receiptHeader.ChequeNo))
                                    {
                                        <div class="col-md-4">
                                            <span class="field-title">Cheque / Txn No.:</span>
                                            <span class="field-value">@receiptHeader.ChequeNo</span>
                                        </div>
                                        <div class="col-md-4">
                                            <span class="field-title">Cheque / Txn Date:</span>
                                            <span class="field-value">@(receiptHeader.ChequeDate?.ToString("dd/MM/yyyy"))</span>
                                        </div>
                                        <div class="col-md-4">
                                            <span class="field-title">Bank:</span>
                                            <span class="field-value">@receiptHeader.ChequeBank</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6">
                            <div class="card h-100">
                                <div class="card-body table-card p-0">
                                    <div class="quick-main">
                                        <div class="grid-box scrollbar-thin" style="max-height: 300px; min-height:100px;">
                                            <QuickGrid Items="@receiptDetailQuery" Class="table">
                                                <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.HeadName) ? " " : x.HeadName)" Title="Fee Head" Align="Align.Left" />
                                                <PropertyColumn Property="@(x => (x.HeadAmount ?? 0).ToString("N2"))" Title="Head Amount" Class="text-right" Align="Align.Right" />
                                                <PropertyColumn Property="@(x => (x.TotalAmount ?? 0).ToString("N2"))" Title="Amount" Class="text-right" Align="Align.Right" />
                                                <PropertyColumn Property="@(x => (x.Concession ?? 0).ToString("N2"))" Title="Concession" Class="text-right" Align="Align.Right" />
                                                <PropertyColumn Property="@(x => (x.PaidAmount ?? 0).ToString("N2"))" Title="Paid Amount" Class="text-right" Align="Align.Right" />
                                            </QuickGrid>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* amounts as small coloured cards *@
                        <div class="col-12 col-lg-6">
                            <div class="card h-100">
                                <div class="card-body p-3">
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <div class="invoice-amount-tile tile-blue">
                                                <span>Prev. Balance</span>
                                                <strong>₹ @((receiptHeader.PreviousBalance ?? 0).ToString("N2"))</strong>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="invoice-amount-tile tile-blue">
                                                <span>Total Fee</span>
                                                <strong>₹ @((receiptHeader.TotalAmount ?? 0).ToString("N2"))</strong>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="invoice-amount-tile tile-green">
                                                <span>Concession</span>
                                                <strong>₹ @((receiptHeader.Concession ?? 0).ToString("N2"))</strong>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="invoice-amount-tile tile-amber">
                                                <span>Late Fee</span>
                                                <strong>₹ @((receiptHeader.LateFee ?? 0).ToString("N2"))</strong>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="invoice-amount-tile tile-teal">
                                                <span>Payable</span>
                                                <strong>₹ @((receiptHeader.PayableAmount ?? 0).ToString("N2"))</strong>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="invoice-amount-tile tile-green">
                                                <span>Total Paid</span>
                                                <strong>₹ @((receiptHeader.PaidAmount ?? 0).ToString("N2"))</strong>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="invoice-amount-tile tile-navy">
                                                <span>Curr. Balance</span>
                                                <strong>₹ @((receiptHeader.Balance ?? 0).ToString("N2"))</strong>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="form-group btn-gr">
                        @* both open the receipt PDF in a new tab *@
                        <button type="button" class="table-btn" @onclick="PrintParentFormat">Parent Format</button>
                        <button type="button" class="table-btn" @onclick="PrintReceipt">Print</button>
                        <button type="button" class="table-btn" @onclick="CloseReceiptDetails">Close</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (IsLoading)
{
    <div class="grid-loader-overlay above-popup">
        <div class="loader-card">
            <div class="loader-ring">
                <div class="loader-arc"></div>
                <div class="loader-core">
                    <img src="/images/v3m-favicon-m.png" alt="Loading" class="loader-logo" />
                </div>
            </div>
            <p class="loader-text">Loading<span class="dot d1">.</span><span class="dot d2">.</span><span class="dot d3">.</span></p>
        </div>
    </div>
}

@code {
    // ---------------------------------------------------------------------
    // Search -> StudentFeeReceipt/GetStudentFeeReceiptListData (V3M_FIN_GetStudentFeeReceiptList)
    // - Session defaults to All (0), the current session is NOT preselected.
    // - Receipt Type (static): All = -1, Admission Fee = 1, Other = 0.
    // - Cancel Type (static) : All = "-1", Cheque Bounce, Other.
    // - Status               : All = -1, Active = 1, Cancelled = 0.
    // - Payment mode from the master (PaymentMode/GetBankPaymentMode), bank from Finance/GetBank.
    // - Class-Group from StudentFeeReceipt/GetClassGroup (V3M_DetClassGroup by group + branch code), All = "".
    // - Bottom buttons are static for now.
    // ---------------------------------------------------------------------

    private bool IsLoading = false;
    private bool ShowSearchPopup = false;
    private string? branchcode;
    private string? groupcode;
      private string? UserName;
    private StudentFeeReceiptListRequest request = NewRequest();

    private List<SessionModel> sessionlist = new();
    private List<string> classGroupList = new();
    private List<BranchClassModel> classlist = new();
    private List<PaymentModel> paymentModeList = new();
    private List<BankModel> bankList = new();

    private List<StudentFeeReceiptListResponse> receiptlist = new();
    private IQueryable<StudentFeeReceiptListResponse> receiptQuery => receiptlist.AsQueryable();
    private PaginationState pagination = new() { ItemsPerPage = 20 };

    private HashSet<long> selectedReceiptIds = new();
    private bool IsAllSelected;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var branchResult = await sessionStorage.GetAsync<string>("BranchCode");
            branchcode = branchResult.Value;
            UserName = (await sessionStorage.GetAsync<string>("UserName")).Value;
            var groupResult = await sessionStorage.GetAsync<string>("GroupCode");
            groupcode = groupResult.Value;

            await LoadData();
            StateHasChanged();
        }
    }

    // academic year starts in April -> From Date = 1 Apr of the running year, To Date = today
    private static StudentFeeReceiptListRequest NewRequest()
    {
        var today = DateTime.Today;
        return new StudentFeeReceiptListRequest
        {
            SessionId = 0,
            ReceiptMode = -1,
            Status = -1,
            CancelType = "-1",
            FromDate = new DateTime(today.Month >= 4 ? today.Year : today.Year - 1, 4, 1),
            ToDate = today
        };
    }

    private async Task LoadData()
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            var sessionTask = httpService.Get<List<SessionModel>>("Session/GetSession");
            var classTask = httpService.Get<List<BranchClassModel>>("BranchClass/GetClassCode");
            var paymentTask = httpService.Get<List<PaymentModel>>("PaymentMode/GetBankPaymentMode");
            var bankTask = httpService.Get<List<BankModel>>("Finance/GetBank");
            var classGroupTask = httpService.Post<ApiResponse<List<ClassGroupResponse>>>("StudentFeeReceipt/GetClassGroup",
                new ClassGroupRequest { GroupCode = groupcode, BranchCode = branchcode });

            sessionlist = await sessionTask ?? new();
            classlist = await classTask ?? new();
            paymentModeList = await paymentTask ?? new();
            bankList = await bankTask ?? new();

            var classGroupResponse = await classGroupTask;
            classGroupList = (classGroupResponse != null && classGroupResponse.Success && classGroupResponse.Data != null)
                ? classGroupResponse.Data.Where(x => !string.IsNullOrWhiteSpace(x.ClassCode)).Select(x => x.ClassCode!).ToList()
                : new();
        }
        catch
        {
            await Alert.ShowError("Unable to load data.");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void OpenSearch() => ShowSearchPopup = true;
    private void ClosePopup() => ShowSearchPopup = false;

    private void ResetFilters()
    {
        request = NewRequest();
    }

    private async Task SearchReceipt(bool fromPopup = false)
    {
        if (request.FromDate == default || request.ToDate == default)
        {
            await Alert.ShowWarning("Please select from date and to date.");
            return;
        }
        if (request.FromDate.Date > request.ToDate.Date)
        {
            await Alert.ShowWarning("From date cannot be greater than to date.");
            return;
        }

        IsLoading = true;
        StateHasChanged();
        try
        {
            request.GroupCode = groupcode;
            request.BranchCode = branchcode;
            request.GroupClassCode = request.GroupClassCode ?? string.Empty;
            request.ClassCode = request.ClassCode ?? string.Empty;
            request.PaymentMode = request.PaymentMode ?? string.Empty;
            request.ReceiptNo = request.ReceiptNo?.Trim() ?? string.Empty;
            request.StudentNo = request.StudentNo?.Trim() ?? string.Empty;
            request.FirstName = request.FirstName?.Trim() ?? string.Empty;
            request.ChequeNo = request.ChequeNo?.Trim() ?? string.Empty;
            request.FeeReceivedBy = request.FeeReceivedBy?.Trim() ?? string.Empty;
            request.CancelType = string.IsNullOrWhiteSpace(request.CancelType) ? "-1" : request.CancelType;

            var response = await httpService.Post<ApiResponse<List<StudentFeeReceiptListResponse>>>("StudentFeeReceipt/GetStudentFeeReceiptListData", request);

            receiptlist = (response != null && response.Success) ? (response.Data ?? new()) : new();
            // the list print shows the date range of the search that produced this list
            searchedFromDate = request.FromDate;
            searchedToDate = request.ToDate;
            selectedReceiptIds = new();
            IsAllSelected = false;
            await pagination.SetCurrentPageIndexAsync(0);

            if (fromPopup)
                ShowSearchPopup = false;

            if (receiptlist.Count == 0)
            {
                IsLoading = false;
                StateHasChanged();
                await Alert.ShowWarning(response?.Message ?? "No records found.");
            }
        }
        catch (Exception ex)
        {
            receiptlist = new();
            IsLoading = false;
            StateHasChanged();
            await Alert.ShowError(string.IsNullOrWhiteSpace(ex.Message) ? "Unable to load receipts." : ex.Message);
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // ---------------- Receipt Details popup ----------------
    // header -> StudentFeeReceipt/GetStudentReceiptById (V3M_FIN_GetStudentReceiptById)
    // grid   -> StudentFeeReceipt/GetReceiptDetail     (USP_FIN_GetReceiptDetail)
    private bool ShowReceiptDetailsPopup;
    private StudentReceiptByIdResponse? receiptHeader;
    private List<ReceiptDetailResponse> receiptDetaillist = new();
    private IQueryable<ReceiptDetailResponse> receiptDetailQuery => receiptDetaillist.AsQueryable();

    private string GetSessionName(long? sessionId) =>
        sessionlist.FirstOrDefault(x => x.SessionId == (sessionId ?? 0))?.SessionName ?? string.Empty;

    private async Task OpenReceiptDetails(StudentFeeReceiptListResponse row)
    {
        if (row.ReceiptId <= 0)
        {
            await Alert.ShowWarning("Receipt record was not found.");
            return;
        }

        IsLoading = true;
        StateHasChanged();
        try
        {
            var detailRequest = new StudentReceiptByIdRequest { GroupCode = groupcode, BranchCode = branchcode, ReceiptId = row.ReceiptId };

            var headerTask = httpService.Post<ApiResponse<StudentReceiptByIdResponse>>("StudentFeeReceipt/GetStudentReceiptById", detailRequest);
            var detailTask = httpService.Post<ApiResponse<List<ReceiptDetailResponse>>>("StudentFeeReceipt/GetReceiptDetail", detailRequest);

            var headerResponse = await headerTask;
            var detailResponse = await detailTask;

            if (headerResponse == null || !headerResponse.Success || headerResponse.Data == null)
            {
                IsLoading = false;
                StateHasChanged();
                await Alert.ShowWarning(headerResponse?.Message ?? "Receipt record was not found.");
                return;
            }

            receiptHeader = headerResponse.Data;
            receiptDetaillist = (detailResponse != null && detailResponse.Success) ? (detailResponse.Data ?? new()) : new();
            ShowReceiptDetailsPopup = true;
        }
        catch (Exception ex)
        {
            IsLoading = false;
            StateHasChanged();
            await Alert.ShowError(string.IsNullOrWhiteSpace(ex.Message) ? "Unable to load receipt details." : ex.Message);
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // ---------------- Receipt list print (bottom Print button) ----------------
    // PDF opens in a new tab, Excel is downloaded; selected rows are printed, otherwise the whole searched list
    private DateTime searchedFromDate;
    private DateTime searchedToDate;

    private async Task OnPrintListClick()
    {
        if (receiptlist.Count == 0)
        {
            await Alert.ShowWarning("Please search receipts first.");
            return;
        }

        var result = await JS.InvokeAsync<System.Text.Json.JsonElement>("showPrintConfirm");
        var isPdf = result.TryGetProperty("isConfirmed", out var confirmed) && confirmed.GetBoolean();
        var isExcel = result.TryGetProperty("isDenied", out var denied) && denied.GetBoolean();
        if (!isPdf && !isExcel)
            return;

        var printRequest = new StudentReceiptListPrintRequest
        {
            FromDate = searchedFromDate,
            ToDate = searchedToDate,
            Receipts = selectedReceiptIds.Count > 0
                ? receiptlist.Where(x => selectedReceiptIds.Contains(x.ReceiptId)).ToList()
                : receiptlist
        };

        IsLoading = true;
        StateHasChanged();
        try
        {
            var apiUrl = isPdf ? "Export/GenerateStudentReceiptListPdf" : "Export/GenerateStudentReceiptListExcel";
            var response = await httpService.Post<ApiResponse<string>>(apiUrl, printRequest);
            IsLoading = false;
            StateHasChanged();

            if (response != null && response.Success && !string.IsNullOrEmpty(response.Data))
            {
                if (isPdf)
                    await JS.InvokeVoidAsync("viewPdf", response.Data);
                else
                    await JS.InvokeVoidAsync("downloadExcel", response.Data, "StudentReceipts.xlsx");
            }
            else
            {
                await Alert.ShowWarning(response?.Message ?? "Unable to generate the receipt list.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error printing receipt list: {ex.Message}");
            IsLoading = false;
            StateHasChanged();
            await Alert.ShowError("Unable to generate the receipt list.");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // ---------------- Receipt print (new tab) ----------------
    // Print         -> school copy + parent copy side by side (Export/GenerateAdmitChildReceiptPdf)
    // Parent Format -> single fee receipt with due / paid per head (Export/GenerateParentFormatReceiptPdf)
    private async Task PrintReceipt()
    {
        if (receiptHeader == null || receiptDetaillist.Count == 0)
        {
            await Alert.ShowWarning("Receipt details not found to print.");
            return;
        }

        var receipt = new AdmitChildReceiptPrintModel
        {
            ReceiptNo = receiptHeader.ReceiptNo,
            ReceiptDate = receiptHeader.CreatedDate ?? DateTime.Today,
            RegistrationNo = receiptHeader.RegistrationId,
            StudentNo = receiptHeader.StudentNo,
            StudentName = receiptHeader.StudentName,
            FatherName = receiptHeader.FatherName,
            ClassName = string.IsNullOrWhiteSpace(receiptHeader.ClassSection) ? receiptHeader.ClassName : receiptHeader.ClassSection,
            SessionName = GetSessionName(receiptHeader.SessionId),
            PeriodName = receiptHeader.PeriodName,
            PaymentMode = receiptHeader.PaymentMode,
            TotalAmount = receiptHeader.PayableAmount ?? 0,
            Concession = 0,
            PaidAmount = receiptHeader.PaidAmount ?? 0,
            Balance = receiptHeader.Balance ?? 0,
            AmountHeader = "Payable",
            ShowGeneratedFooter = true,
            FeeHeads = receiptDetaillist
                .Select(x => new AdmitChildReceiptPrintFeeHead { FeeHeadName = x.HeadName, Amount = x.TotalAmount ?? 0 })
                .ToList()
        };
        // late fee is not a fee head row, show it as its own line like Fee Collection does
        if ((receiptHeader.LateFee ?? 0) > 0)
            receipt.FeeHeads.Add(new AdmitChildReceiptPrintFeeHead { FeeHeadName = "Late Fee", Amount = receiptHeader.LateFee ?? 0 });

        await OpenPdf("Export/GenerateAdmitChildReceiptPdf", receipt);
    }

    private async Task PrintParentFormat()
    {
        if (receiptHeader == null || receiptDetaillist.Count == 0)
        {
            await Alert.ShowWarning("Receipt details not found to print.");
            return;
        }

        var receipt = new ParentFormatReceiptPrintModel
        {
            ReceiptNo = receiptHeader.ReceiptNo,
            ReceiptDate = receiptHeader.CreatedDate ?? DateTime.Today,
            AdmissionNo = receiptHeader.StudentNo,
            StudentName = receiptHeader.StudentName,
            FatherName = receiptHeader.FatherName,
            ClassSection = string.IsNullOrWhiteSpace(receiptHeader.ClassSection) ? receiptHeader.ClassName : receiptHeader.ClassSection,
            MobileNo = receiptHeader.NextToKinContactNo,
            SessionName = GetSessionName(receiptHeader.SessionId),
            Instalment = receiptHeader.PeriodName,
            PaymentMode = receiptHeader.PaymentMode,
            FeeHeads = receiptDetaillist
                .Select(x => new ParentFormatReceiptPrintFeeHead
                {
                    Description = string.IsNullOrWhiteSpace(x.OnlyHeadName) ? x.HeadName : x.OnlyHeadName,
                    DueAmount = x.TotalAmount ?? 0,
                    PaidAmount = x.PaidAmount ?? 0
                })
                .ToList()
        };
        if ((receiptHeader.LateFee ?? 0) > 0)
            receipt.FeeHeads.Add(new ParentFormatReceiptPrintFeeHead { Description = "Late Fee", DueAmount = receiptHeader.LateFee ?? 0, PaidAmount = receiptHeader.LateFee ?? 0 });

        await OpenPdf("Export/GenerateParentFormatReceiptPdf", receipt);
    }

    private async Task OpenPdf(string apiUrl, object receipt)
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            var response = await httpService.Post<ApiResponse<string>>(apiUrl, receipt);
            IsLoading = false;
            StateHasChanged();
            if (response != null && response.Success && !string.IsNullOrEmpty(response.Data))
                await JS.InvokeVoidAsync("viewPdf", response.Data);
            else
                await Alert.ShowWarning(response?.Message ?? "Receipt could not be generated.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error printing receipt: {ex.Message}");
            IsLoading = false;
            StateHasChanged();
            await Alert.ShowError("Receipt could not be generated.");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void CloseReceiptDetails()
    {
        ShowReceiptDetailsPopup = false;
        receiptHeader = null;
        receiptDetaillist = new();
    }

    // ---------------- grid selection ----------------
    private void ToggleAll()
    {
        selectedReceiptIds = IsAllSelected ? receiptlist.Select(x => x.ReceiptId).ToHashSet() : new();
    }

    private void ToggleReceipt(StudentFeeReceiptListResponse row, ChangeEventArgs e)
    {
        if (e.Value is bool isChecked && isChecked)
            selectedReceiptIds.Add(row.ReceiptId);
        else
            selectedReceiptIds.Remove(row.ReceiptId);

        IsAllSelected = receiptlist.Count > 0 && selectedReceiptIds.Count == receiptlist.Count;
    }
    
    private async Task GenerateStudentReceiptHeadWisePdf()
    {
        if (receiptlist.Count == 0)
        {
            await Alert.ShowWarning("Please search receipts first.");
            return;
        }

        var result = await JS.InvokeAsync<System.Text.Json.JsonElement>("showPrintConfirm");
        var isPdf = result.TryGetProperty("isConfirmed", out var confirmed) && confirmed.GetBoolean();
        var isExcel = result.TryGetProperty("isDenied", out var denied) && denied.GetBoolean();
        if (!isPdf && !isExcel)
            return;

        var printRequest = new StudentReceiptHeadWiseRequest
        {
            GroupCode=groupcode,
            BranchCode=branchcode,
            SessionId=request.SessionId,
            SocietyId=request.SocietyId,
            ClassCode=request.ClassCode,
            ReceiptNo=request.ReceiptNo,
            StudentNo=request.StudentNo,
            StudentName=request.FirstName,
            CancelType=request.CancelType,
            CreatedBy=UserName,
            BankAccountId=request.BankAccountId,
            PayMode=request.PaymentMode,
            ClassGroupCode=request.GroupClassCode,
            FromDate = request.FromDate,
            ToDate = request.ToDate,
         
        };

        IsLoading = true;
        StateHasChanged();
        try
        {
            var apiUrl = isPdf ? "StudentFeeReceipt/GenerateStudentReceiptHeadWisePdf" : "StudentFeeReceipt/GenerateStudentReceiptHeadWiseExcel";
            var response = await httpService.Post<ApiResponse<string>>(apiUrl, printRequest);
            IsLoading = false;
            StateHasChanged();

            if (response != null && response.Success && !string.IsNullOrEmpty(response.Data))
            {
                if (isPdf)
                    await JS.InvokeVoidAsync("viewPdf", response.Data);
                else
                    await JS.InvokeVoidAsync("downloadExcel", response.Data, "StudentReceipts.xlsx");
            }
            else
            {
                await Alert.ShowWarning(response?.Message ?? "Unable to generate the receipt list.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error printing receipt list: {ex.Message}");
            IsLoading = false;
            StateHasChanged();
            await Alert.ShowError("Unable to generate the receipt list.");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }
}
