    // statement, advance movements and refunds come from the ledger + receipts
    private void BuildDerivedRows()
    {
        statementRows = ledgerRows.Select(l => new StatementRow
        {
            Date = l.TransactionDate == default ? l.CreatedDate : l.TransactionDate,
            Reference = ReferenceOf(l),
            Title = EntryTitle(l),
            Detail = l.Narration,
            Charged = l.Amount > 0 ? l.Amount : 0,
            Credited = l.Amount < 0 ? -l.Amount : 0,
            Balance = l.RunningBalance
        }).ToList();

        // advance rows: ledger rows of type "Advance" or with "advance" in the narration; credit (negative) = advance up
        decimal running = 0;
        advanceRows = new();
        foreach (var l in ledgerRows.Where(IsAdvanceEntry))
        {
            var change = -l.Amount;
            running += change;
            advanceRows.Add(new AdvanceRow
            {
                Date = l.CreatedDate == default ? l.TransactionDate : l.CreatedDate,
                Title = change >= 0 ? "Added to advance" : "Advance used / taken back",
                Detail = l.Narration,
                Reference = ReferenceOf(l),
                Change = change,
                After = running,
                By = l.TransactionBy
            });
        }

        refundRows = receiptRows.Where(r => r.Valid == false).Select(r =>
        {
            var no = r.ReceiptNo ?? "";
            var kept = !string.IsNullOrWhiteSpace(no) && ledgerRows.Any(l =>
                (l.Narration ?? "").Contains(no, StringComparison.OrdinalIgnoreCase) &&
                (l.Narration ?? "").Contains("advance", StringComparison.OrdinalIgnoreCase) &&
                !(l.Narration ?? "").StartsWith("Reversal", StringComparison.OrdinalIgnoreCase));
            var remark = r.Remark ?? "";
            var idx = remark.IndexOf("Cancelled:", StringComparison.OrdinalIgnoreCase);
            return new RefundRow
            {
                Receipt = r,
                Date = r.ReceiptDate,
                Amount = r.PaidAmount ?? 0,
                KeptAsAdvance = kept,
                Reason = idx >= 0 ? remark[(idx + "Cancelled:".Length)..].Trim() : remark.Trim(' ', '|')
            };
        }).ToList();
    }

    private static bool IsAdvanceEntry(StudentLedgerResponse l) =>
        string.Equals(l.ReferenceType, "Advance", StringComparison.OrdinalIgnoreCase) ||
        ((l.Narration ?? "").Contains("advance", StringComparison.OrdinalIgnoreCase) &&
         !(l.Narration ?? "").StartsWith("Reversal", StringComparison.OrdinalIgnoreCase));

    private static readonly Regex DocNoRegex = new(@"\b(?=[A-Za-z0-9]*\d)(?=[A-Za-z0-9]*[A-Za-z])[A-Za-z0-9]{5,}\b", RegexOptions.Compiled);

    private static string ReferenceOf(StudentLedgerResponse l)
    {
        if (!string.IsNullOrWhiteSpace(l.ReferenceNo)) return l.ReferenceNo!;
        var m = DocNoRegex.Match(l.Narration ?? "");
        return m.Success ? m.Value : "";
    }

    private static string EntryTitle(StudentLedgerResponse l)
    {
        var n = l.Narration ?? "";
        bool Has(string s) => n.Contains(s, StringComparison.OrdinalIgnoreCase);
        if (Has("Reversal")) return "REVERSAL";
        if (Has("cancel")) return "RECEIPT CANCEL";
        if (Has("advance")) return "ADVANCE";
        if (Has("refund")) return "REFUND";
        if (Has("concession")) return "CONCESSION";
        if (Has("revision")) return "INVOICE REVISION";
        if (Has("receipt")) return "STUDENT RECEIPT";
        if (Has("challan") || Has("invoice")) return "INVOICE";
        if (!string.IsNullOrWhiteSpace(l.ReferenceType)) return l.ReferenceType!.ToUpperInvariant();
        return l.Amount >= 0 ? "CHARGE" : "PAYMENT";
    }

