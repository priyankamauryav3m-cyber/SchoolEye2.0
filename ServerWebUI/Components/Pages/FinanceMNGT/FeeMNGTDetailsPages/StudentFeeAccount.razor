    // ======================= helpers =======================

    // QuickGrid css hides any row that has an empty cell (tr:has(td:empty)), so a blank cell gets one space
    private const string Blank = " ";
    private static string Show(string? value) => string.IsNullOrWhiteSpace(value) ? Blank : value;
    private static decimal FeePaid(StudentFeeReceiptListResponse r) => Math.Max(0, (r.PaidAmount ?? 0) - (r.LateFee ?? 0));

    // academic session April -> March; month 0 (one-time heads) first
    private static int SessionMonthOrder(int monthNo) => monthNo == 0 ? -1 : (monthNo - 4 + 12) % 12;

    private static readonly NumberFormatInfo RupeeFormat = new()
    {
        NumberGroupSizes = new[] { 3, 2 },
        NumberGroupSeparator = ",",
        NumberDecimalSeparator = "."
    };

    // ₹1,00,000 / ₹34,970.50 / -₹50,000 (Indian grouping, decimals only when needed)
    private static string Money(decimal value)
    {
        var abs = Math.Abs(value);
        // always 2 decimals, same as View Student Ledger / View Fee Head Ledger (₹1,23,456.00)
        var text = abs.ToString("N2", RupeeFormat);
        return (value < 0 ? "-₹" : "₹") + text;
    }

    private static readonly string[] DateFormats = { "dd/MM/yyyy", "dd-MM-yyyy", "dd/MM/yyyy HH:mm:ss", "dd-MM-yyyy HH:mm:ss", "yyyy-MM-dd", "yyyy-MM-ddTHH:mm:ss", "dd MMM yyyy", "dd-MMM-yyyy", "MM/dd/yyyy", "MM/dd/yyyy HH:mm:ss", "MM/dd/yyyy hh:mm:ss tt" };

    private static DateTime? ParseDate(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        if (DateTime.TryParseExact(value.Trim(), DateFormats, CultureInfo.InvariantCulture, DateTimeStyles.None, out var d)) return d;
        if (DateTime.TryParse(value, CultureInfo.InvariantCulture, DateTimeStyles.None, out d)) return d;
        return null;
    }

