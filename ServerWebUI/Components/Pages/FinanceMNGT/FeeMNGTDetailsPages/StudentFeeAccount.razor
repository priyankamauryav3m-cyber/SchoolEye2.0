    // ======================= view models =======================

    private class InvoiceRow
    {
        public StudentChallanResponse Source { get; set; } = new();
        public long InvoiceId { get; set; }
        public string InvoiceNo { get; set; } = "";
        public string? PeriodName { get; set; }
        public string? TemplateName { get; set; }
        public DateTime? DueDate { get; set; }
        public decimal Total { get; set; }
        public decimal Concession { get; set; }
        public decimal WaiveOff { get; set; }
        public decimal Received { get; set; }
        public bool HasReceivedInfo { get; set; }
        public decimal Net => Total - Concession - WaiveOff;
        public decimal Outstanding => Math.Max(0, Net - Received);
        public int DaysLate => DueDate.HasValue && Outstanding > 0 && DueDate.Value.Date < DateTime.Today ? (DateTime.Today - DueDate.Value.Date).Days : 0;
        public string Status => !HasReceivedInfo ? "Generated"
                              : Outstanding <= 0 ? "Paid"
                              : DaysLate > 0 ? "Overdue"
                              : Received > 0 ? "Part paid"
                              : "Due";
        public string StatusCss => Status switch
        {
            "Paid" => "green",
            "Overdue" => "red",
            "Part paid" => "amber",
            _ => "grey"
        };
    }

    private class StatementRow
    {
        public DateTime Date { get; set; }
        public string Reference { get; set; } = "";
        public string Title { get; set; } = "";
        public string Detail { get; set; } = "";
        public decimal Charged { get; set; }
        public decimal Credited { get; set; }
        public decimal Balance { get; set; }
    }

    private class AdvanceRow
    {
        public DateTime Date { get; set; }
        public string Title { get; set; } = "";
        public string Detail { get; set; } = "";
        public string Reference { get; set; } = "";
        public decimal Change { get; set; }
        public decimal After { get; set; }
        public string By { get; set; } = "";
    }

    private class RefundRow
    {
        public StudentFeeReceiptListResponse Receipt { get; set; } = new();
        public DateTime? Date { get; set; }
        public decimal Amount { get; set; }
        public bool KeptAsAdvance { get; set; }
        public string Reason { get; set; } = "";
    }
