@page "/branch"
@using DomainModel.Admin
@using Microsoft.AspNetCore.Authorization
@using ServerWebUI.Components.Pages.CommonPages
@inject IHttpClientFactory ClientFactory
@using DomainModel.SchoolMaster
@using Microsoft.AspNetCore.Components.QuickGrid
@using System.Net
@using System.Text.Json
@inject ICommonMethod CommonMethod
@inject IStringLocalizer<Resource> Localizer
@using MyApp.Common
@inject IJSRuntime JS
@inject Shared.IHttpService httpService
@inject HttpClient Http
@inject SweetAlertService Alert
@inject IWebHostEnvironment Env
@rendermode InteractiveServer
<style>
    .quickgrid thead th:last-child {
        min-width: 75px;
    }

    .grid-thumb-img {
        width: 50px;
        height: 100%;
        object-fit: cover;
        border: 1px solid #d9d9d9;
        cursor: pointer;
    }
</style>
<div class="main-container">
    <div class="row m-0 main-row">
        <div class="col-12 p-1" id="main-header">

            <PageHeading Tittle="Branch">
                <div class="form-box">
                    <InputSelect @bind-Value="@searchAnyRequest.GroupCode" class="form-input" @bind-Value:after="GetBranchName">
                        <option value="0">-- Select Group --</option>
                        @foreach (var data in grouplist.Where(x => x.IsValid == true))
                        {
                            <option value="@data.GroupCode">@data.GroupName</option>
                        }
                    </InputSelect>
                </div>
                <ActionButtonGroup CurrentUrl="@currentUrl" Add="AddBranch" />
            </PageHeading>
        </div>
        <div class="col-12 p-1">
            <div class="card">
                <div class="card-body table-card p-0 scrollbar-thin">
                    <div class="quick-main">
                        <div class="grid-box">
                            <QuickGrid Items="@FilteredItems" Class="table" Pagination="@pagination">

                                <PropertyColumn Property="@(x => x.BranchName)" Title="Branch Name" Sortable="true" Align="Align.Left">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="BranchName ..." />
                                        </div>
                                    </ColumnOptions>

                                </PropertyColumn>

                                <PropertyColumn Property="@(x => x.BranchCode)" Title="Branch Code" class="text-center" Sortable="true" Align="Align.Left">
                                </PropertyColumn>

                                <TemplateColumn Title="Logo" Align="Align.Center">
                                    <ChildContent>
                                        <img src="@GetLogoUrl(context.LogoPath)" class="grid-thumb-img" @onclick="() => ViewImage(context.LogoPath)" alt="Logo" />
                                    </ChildContent>
                                </TemplateColumn>

                                <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.ContactPerson) ? " " : x.ContactPerson)" Title="Contact Person" Sortable="true" Align="Align.Left">
                                </PropertyColumn>

                                <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.ContactNo)? " ":x.ContactNo)" Title="Contact No" Sortable="true" Align="Align.Left">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="ContactNo ..." />
                                        </div>
                                    </ColumnOptions>
                                </PropertyColumn>

                                <TemplateColumn  Title="Head Office" Align="Align.Center">
                                    <ChildContent>
                                        <span class="@GetStatusClass(context.IsHO == true)">
                                            @(context.IsHO == true ? "Yes" : "No")
                                        </span>
                                    </ChildContent>
                                </TemplateColumn>

                                <TemplateColumn Title="Status" Align="Align.Center">
                                    <ColumnOptions>
                                        <div>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "2")" @onchange="() => FilterChangedAsync(2)" /> Both
                                            </label>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "1")" @onchange="() => FilterChangedAsync(1)" /> Active
                                            </label>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "0")" @onchange="() => FilterChangedAsync(0)" /> Inactive
                                            </label>
                                        </div>
                                    </ColumnOptions>
                                    <ChildContent>
                                        <span class="@GetStatusClass(context.IsValid == true)">

                                            @(context.IsValid == true ? "Active" : "Inactive")
                                        </span>
                                    </ChildContent>
                                </TemplateColumn>

                                <TemplateColumn Align="Align.Center" Title="Action">
                                    <ActionButtonGroup IsValid="context.IsValid" CurrentUrl="@currentUrl" OnEditClick="() => EditBranch(context)" OnStatusClick="() => ChangeBranchStatus(context.BranchId, context.IsValid)" />
                                </TemplateColumn>

                            </QuickGrid>


                        </div>
                        <div class="footer-pagination">
                            <div class="d-flex align-items-center">
                                <div class="welcome-text w-100">
                                    <Paginator State="@pagination" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
