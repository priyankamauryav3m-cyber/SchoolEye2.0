@code {
    // ---------------------------------------------------------------------
    // ASSUMPTIONS (adjust if different in your project):
    // - Same pattern as GroupMaster: the Logo file is saved directly into
    //   the Blazor Server (UI) project's own wwwroot via IWebHostEnvironment
    //   (folder "uploads/BranchLogo/MM/dd") - NOT the API's root. Only the
    //   resulting web path (branch.LogoPath) is sent to the API in the
    //   normal JSON body, same as every other field.
    // - Your pasted AddOrUpdateBranchMaster controller action is already
    //   correct for this - it takes [FromBody] BranchModel and does no
    //   file handling at all, so no controller changes were needed there.
    // - BranchModel.LogoPath already exists (used by AddUpdateBranchMaster
    //   in your repository code) - reused as-is, no new model property
    //   needed on the Branch side.
    // - Adjust the saved subfolder ("uploads/BranchLogo/MM/dd") to wherever
    //   your project actually serves branch logos from under wwwroot.
    // ---------------------------------------------------------------------
    private bool ShowImagePopup = false;
    private bool IsLoading = true;
    private BranchModel branch = new();
    private string oldcdataModel = "";
    private List<BranchModel> branchlist = new();
    private List<CountryModel> countrylist = new();
    private List<StateModel> statelist = new();
    private List<GroupMaster> grouplist = new();
    private List<DistrictModel> districtlist = new();
    private List<StateModel> filteredStateList = new();
    private List<DistrictModel> filteredDistrictList = new();
    private bool ShowPopup = false;
    private SearchAnyRequestModel searchAnyRequest = new();

    private string? logoPreviewUrl;
    private bool isLogoChanged = false;
    private const string NoLogoUrl = "https://demo.schooleye.in/Images/NoPhoto.gif";

    PaginationState pagination = new()
    {
        ItemsPerPage = 15
    };
    private string nameFilter = string.Empty;
    private string statusFilter = "1";
    private string username = "";
    HttpResponseMessage response;
    private EditContext editContext;

    private string? currentUrl;
    protected override void OnInitialized()
    {

        PermissionState.OnChange += StateHasChanged;
        currentUrl = Nav.Uri;
        StateHasChanged();

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var userResult = await sessionStorage.GetAsync<string>("UserName");
            username = userResult.Value;
            await LoadData();
            StateHasChanged();
        }
    }



    private void OnCountryChanged()
    {
        branch.StateId = 0;
        branch.DistrictId = 0;
        filteredStateList = statelist.Where(x => x.CountryId == branch.CountryId).ToList();
        filteredDistrictList = new();
        StateHasChanged();
    }

    private void OnStateChanged()
    {
        branch.DistrictId = 0;
        filteredDistrictList = districtlist.Where(x => x.StateId == branch.StateId).ToList();
        StateHasChanged();
    }

    private void OnStartTimeChanged(ChangeEventArgs e)
    {
        if (TimeSpan.TryParse(e.Value?.ToString(), out var ts))
            branch.StartTime = ts;
        else
            branch.StartTime = null;
    }

    private void OnEndTimeChanged(ChangeEventArgs e)
    {
        if (TimeSpan.TryParse(e.Value?.ToString(), out var ts))
            branch.EndTime = ts;
        else
            branch.EndTime = null;
    }

    private async Task OnLogoSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null)
            return;

        if (file.Size > 5 * 1024 * 1024)
        {
            await Alert.ShowWarning("Logo size must be less than 5 MB.");
            return;
        }

        var month = DateTime.Now.Month.ToString("D2");
        var day = DateTime.Now.Day.ToString("D2");

        var folderRelative = Path.Combine("uploads", "BranchLogo", month, day);
        var folderAbsolute = Path.Combine(Env.WebRootPath, folderRelative);

        if (!Directory.Exists(folderAbsolute))
            Directory.CreateDirectory(folderAbsolute);

        var extension = Path.GetExtension(file.Name);
        var fileName = $"{Guid.NewGuid()}{extension}";
        var filePathAbsolute = Path.Combine(folderAbsolute, fileName);

        await using (var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024))
        await using (var fs = new FileStream(filePathAbsolute, FileMode.Create))
        {
            await stream.CopyToAsync(fs);
        }

        branch.LogoPath = "/" + Path.Combine(folderRelative, fileName).Replace("\\", "/");
        logoPreviewUrl = branch.LogoPath;
        isLogoChanged = true;

        StateHasChanged();
    }

    private string GetLogoUrl(string? logoPath) => string.IsNullOrWhiteSpace(logoPath) ? NoLogoUrl : logoPath;

    private async Task LoadData()
    {
        IsLoading = true;
        grouplist = await httpService.Get<List<GroupMaster>>("GroupMaster/GroupMaster") ?? new();
        countrylist = await httpService.Get<List<CountryModel>>("Country/GetCountry") ?? new();
        statelist = await httpService.Get<List<StateModel>>("State/GetState") ?? new();
        districtlist = await httpService.Get<List<DistrictModel>>("District/GetDistrict") ?? new();
        IsLoading = false;

    }
    private async Task GetBranchName()
    {
        if (!string.IsNullOrEmpty(searchAnyRequest.GroupCode))
        {
            string ApiUri = "Branch/GetBranch";
            branchlist = await httpService.Post<List<BranchModel>>(ApiUri, searchAnyRequest) ?? new();
            StateHasChanged();
        }
        else
        {
            branchlist.Clear();
            StateHasChanged();
        }
    }
    protected IQueryable<BranchModel> FilteredItems
    {
        get
        {
            var result = branchlist.AsQueryable();
            if (!string.IsNullOrEmpty(nameFilter))
            {
                result = result.Where(x => (x.BranchName != null && x.BranchName.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)) ||
            (x.BranchCode != null && x.BranchCode.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)) ||
            (x.ContactNo != null && x.ContactNo.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)));

            }
            if (statusFilter == "1")
            {
                result = result.Where(s => s.IsValid);
            }
            else if (statusFilter == "0")
            {
                result = result.Where(s => !s.IsValid);
            }
            return result;
        }
    }
    private string GetStatusClass(bool isActive)
    {
        return isActive ? "activeClr" : "inactiveClr";
    }
    private void FilterChangedAsync(int filterValue)
    {
        statusFilter = filterValue.ToString();
        StateHasChanged();
    }
    private void AddBranch()
    {
        branch = new();
        logoPreviewUrl = null;
        isLogoChanged = false;
        filteredStateList = new();
        filteredDistrictList = new();
        ShowPopup = true;
    }

    private async Task OnSave()
    {

        try
        {

            if (branch.BranchId > 0)
            {
                ShowPopup = false;
                var isConfirmed = await JS.InvokeAsync<bool>("showUpdateConfirm");
                if (!isConfirmed)
                {
                    ShowPopup = true;
                    return;
                }
                bool isSame = CommonMethod.IsEdited(branch, oldcdataModel);
                if (!isSame && !isLogoChanged)
                {
                    await Alert.ShowWarning("No changes detected.");
                    ShowPopup = true;
                    return;
                }
            }
            ShowPopup = false;
            branch.IsValid = true;
            branch.CreatedBy = username;
            branch.CreatedDate = DateTime.Now;
            string apiUrl = "Branch/AddOrUpdateBranchMaster";
            var apiResponse = await httpService.Post<ApiResponse<object>>(apiUrl, branch);
            var responsecode = apiResponse.Code;
            if (responsecode == 0)
            {
                await Alert.ShowWarning("Branch" + @Localizer["Already"]);
                ShowPopup=true;
                StateHasChanged();
            }
            else if (responsecode == 1)
            {
                await Alert.ShowSuccess("Branch" + @Localizer["Inserted"]);
                branch = new BranchModel();
            }
            else if (responsecode == 2)
            {
                await Alert.ShowUpdate("Branch" + @Localizer["Updated"]);
                branch = new BranchModel();
            }
            else
            {
                await Alert.ShowCustomAlert(@Localizer["Admin"]);
            }

            logoPreviewUrl = null;
            isLogoChanged = false;

            await LoadData();
           
        }
        catch (Exception ex)
        {
            await Alert.ShowError($"{@Localizer["Error"]}: {ex.Message}");
        }
        finally
        {
           await GetBranchName();
            StateHasChanged();
        }
    }

    private void EditBranch(BranchModel item)
    {
        branch = new BranchModel
        {
            BranchId = item.BranchId,
            GroupCode = item.GroupCode,
            BranchCode = item.BranchCode,
            BranchName = item.BranchName,
            Remarks = item.Remarks,
            LogoPath = item.LogoPath,
            ContactPerson = item.ContactPerson,
            ContactNo = item.ContactNo,
            ContactEmailId = item.ContactEmailId,
            WebSite = item.WebSite,
            BranchEmailId = item.BranchEmailId,
            AffiliationDetails = item.AffiliationDetails,
            SchoolNo = item.SchoolNo,
            AddressLine1 = item.AddressLine1,
            AddressLine2 = item.AddressLine2,
            DistrictId = item.DistrictId,
            StateId = item.StateId,
            CountryId = item.CountryId,
            PinCode = item.PinCode,
            StartTime = item.StartTime,
            EndTime = item.EndTime,
            IsHO = item.IsHO,
            BranchCategory = item.BranchCategory,
            AffiliationUpto = item.AffiliationUpto,
            StatusOfSchool = item.StatusOfSchool,
            UDISENo = item.UDISENo
        };

        logoPreviewUrl = string.IsNullOrWhiteSpace(item.LogoPath) ? null : item.LogoPath;
        isLogoChanged = false;

        filteredStateList = statelist.Where(x => x.CountryId == branch.CountryId).ToList();
        filteredDistrictList = districtlist.Where(x => x.StateId == branch.StateId).ToList();

        oldcdataModel = CommonMethod.CreateSnapshot(branch);
        ShowPopup = true;
    }

    private void ClosePopup()
    {
        branch = new();
        logoPreviewUrl = null;
        isLogoChanged = false;
        ShowPopup = false;
    }

    private async Task ChangeBranchStatus(int id, bool isValid)
    {
        try
        {
            bool isActivate = !isValid;
            bool isConfirmed = await JS.InvokeAsync<bool>(isActivate ? "showActiveConfirm" : "showDeleteConfirm");
            if (!isConfirmed)
                return;

            string apiUrl = "Branch/DeleteBranchMaster";

            var apiResponse = await httpService.Post<ApiResponse<object>>(apiUrl, id);

            if (apiResponse.Success)
            {
                if (isActivate)
                    await Alert.ShowActive(Localizer["Activated"]);
                else
                    await Alert.ShowDeactive(Localizer["Deleted"]);

                await LoadData();
                StateHasChanged();
            }
            else
            {
                await Alert.ShowCustomAlert(@Localizer["Admin"]);
            }
        }
        catch (Exception ex)
        {
            await Alert.ShowError($"{Localizer["Error"]}: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
            await LoadData();
        }
    }

    private void CloseImagePopup()
    {
        ShowImagePopup = false;
        logoPreviewUrl = null;
    }
    private void ViewImage(string? imagePath)
    {
        if (string.IsNullOrWhiteSpace(imagePath))
            return;

        logoPreviewUrl = GetLogoUrl(imagePath);
        ShowImagePopup = true;
    }

