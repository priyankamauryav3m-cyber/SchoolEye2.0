@page "/document"
@using DomainModel.Admin
@using Microsoft.AspNetCore.Authorization
@using ServerWebUI.Components.Pages.CommonPages
@inject IHttpClientFactory ClientFactory
@using DomainModel.SchoolMaster
@using Microsoft.AspNetCore.Components.QuickGrid
@using System.Net
@using System.Text.Json
@inject ICommonMethod CommonMethod
@inject IStringLocalizer<Resource> Localizer
@using MyApp.Common
@inject IJSRuntime JS
@inject Shared.IHttpService httpService
@inject HttpClient Http
@inject SweetAlertService Alert
@rendermode InteractiveServer
<div class="main-container">
    <div class="row m-0 main-row">
        <div class="col-12 p-1" id="main-header">
            <div class="page-heading d-flex align-items-center justify-content-between">
                <p class="m-0 page-name px-1">Document </p>
                <div class="d-flex gap-2">
                    <ActionButtonGroup CurrentUrl="@currentUrl" Add="AddDocument" />

                </div>
            </div>
        </div>
        <div class="col-12 p-1">
            <div class="card">
                <div class="card-body table-card p-0 scrollbar-thin">
                    <div class="quick-main">
                        <div class="grid-box">
                            <QuickGrid Items="@FilteredItems" Class="table" Pagination="@pagination">

                                <PropertyColumn Property="@(x => x.DocumentName)" Title="Document Name" Sortable="true" Align="Align.Left">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="DocumentName ..." />
                                        </div>
                                    </ColumnOptions>

                                </PropertyColumn>

                                <PropertyColumn Property="@(x => x.DocumentType)" Title="Document Type" Sortable="true" Align="Align.Left">
                                </PropertyColumn>

                               @*  <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.Remarks) ? " " : x.Remarks)"
                                                Title="Remarks"
                                                Sortable="true"
                                                Align="Align.Left" /> *@
                                <TemplateColumn Title="Remarks" Sortable="true" Align="Align.Left">
                                    <span class="custom-tooltip" data-tooltip="@context.Remarks">
                                        @(string.IsNullOrWhiteSpace(context.Remarks)
                                            ? ""
                                            : (context.Remarks.Length > 30
                                                ? context.Remarks.Substring(0, 30) + "..."
                                                : context.Remarks))
                                    </span>
                                </TemplateColumn>
                                <PropertyColumn Property="@(x => x.DisplayOrder)" Title="Display Order" Class="text-center" Sortable="true" Align="Align.Center">
                                </PropertyColumn>

                                <TemplateColumn Title="Status" Align="Align.Center">
                                    <ColumnOptions>
                                        <div>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "2")" @onchange="() => FilterChangedAsync(2)" /> Both
                                            </label>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "1")" @onchange="() => FilterChangedAsync(1)" /> Active
                                            </label>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "0")" @onchange="() => FilterChangedAsync(0)" /> Inactive
                                            </label>
                                        </div>
                                    </ColumnOptions>
                                    <ChildContent>
                                        <span class="@GetStatusClass(context.IsValid == true)">

                                            @(context.IsValid == true ? "Active" : "Inactive")
                                        </span>
                                    </ChildContent>
                                </TemplateColumn>

                                <TemplateColumn Align="Align.Center" Title="Action">
                                    <ActionButtonGroup IsValid="context.IsValid" CurrentUrl="@currentUrl" OnEditClick="() => EditDocument(context)" OnStatusClick="() => ChangeDocumentStatus(context.DocId, context.IsValid)" />
                                </TemplateColumn>

                            </QuickGrid>


                        </div>
                        <div class="footer-pagination">
                            <div class="d-flex align-items-center">
                                <div class="welcome-text w-100">
                                    <Paginator State="@pagination" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @if (ShowPopup)
        {
            <div class="custom-modal row m-0 align-items-center">
                <div class="col-12 col-sm-7 col-md-5 col-lg-4 col-xl-4">
                    <div class="modal-content clearfix main-popup">
                        <div class="head-btn">
                            <h5 class="modal-title">Document</h5>
                            <button data-access="Close" type="button" @onclick="ClosePopup" class="close"><span aria-hidden="true">×</span></button>
                        </div>
                            <EditForm Model="@document" OnValidSubmit="@OnSave">
                                <DataAnnotationsValidator />
                                <div class="modal-body">
                                        <div class="row m-0 form-row">

                                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                                <div class="form-box-group">
                                                    <InputText class="floating-input"
                                                               placeholder=" "
                                                               @bind-Value="document.DocumentName" />
                                                    <label class="floating-label">
                                                        Document Name <span class="required">*</span>
                                                    </label>
                                                    <ValidationMessage For="@(() => document.DocumentName)" />
                                                </div>
                                            </div>

                                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                                <div class="form-box-group static-label">
                                                    <InputSelect class="floating-input" placeholder=" " @bind-Value="document.DocumentType">
                                                        <option value="" selected>--Select--</option>
                                                        <option value="Admission">Admission</option>
                                                        <option value="Student">Student</option>
                                                    </InputSelect>

                                                    <label class="floating-label">
                                                        Document Type <span class="required">*</span>
                                                    </label>
                                                    <ValidationMessage For="@(() => document.DocumentType)" />
                                                </div>
                                            </div>

                                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                                <div class="form-box-group">
                                                    <InputNumber class="floating-input"
                                                               placeholder=" "
                                                               @bind-Value="document.DisplayOrder" />
                                                    <label class="floating-label">
                                                        Display Order <span class="required">*</span>
                                                    </label>
                                                    <ValidationMessage For="@(() => document.DisplayOrder)" />
                                                </div>
                                            </div>

                                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                                <div class="form-box-group">
                                                    <InputText class="floating-input" placeholder=" " @bind-Value="document.Remarks" />
                                                    <label class="floating-label">Remarks</label>
                                                    <ValidationMessage For="@(() => document.Remarks)" />
                                                </div>
                                            </div>

                                        </div>
                                </div>
                                <div class="modal-footer">
                                    <div class="form-group btn-gr">
                                        <SaveUpdateButton TextSave="Submit" OnClickCancel="ClosePopup"></SaveUpdateButton>
                                    </div>
                                </div>
                            </EditForm>
                    </div>
                </div>
            </div>
        }

    </div>

</div>


@code {
    private bool IsLoading = true;
    private DocumentModel document = new();
    private string oldcdataModel = "";
    private List<DocumentModel> documentlist = new();
    private bool ShowPopup = false;
    PaginationState pagination = new()
    {
        ItemsPerPage = 15
    };
    private string nameFilter = string.Empty;
    private string statusFilter = "1";
    private string username = "";
    private string? branchcode;
    private string? groupcode;
    HttpResponseMessage response;
    private EditContext editContext;

    private string? currentUrl;
    protected override void OnInitialized()
    {

        PermissionState.OnChange += StateHasChanged;
        currentUrl = Nav.Uri;
        StateHasChanged();

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var userResult = await sessionStorage.GetAsync<string>("UserName");
            username = userResult.Value;
            var branchResult = await sessionStorage.GetAsync<string>("BranchCode");
            branchcode = branchResult.Value;
            var groupResult = await sessionStorage.GetAsync<string>("GroupCode");
            groupcode = groupResult.Value;

            await LoadData();
            StateHasChanged();
        }
    }
    private async Task LoadData()
    {
        IsLoading = true;
        string ApiUri = "Document/GetDocument";
        documentlist = await httpService.Get<List<DocumentModel>>(ApiUri) ?? new();
        IsLoading = false;


    }
    protected IQueryable<DocumentModel> FilteredItems
    {
        get
        {
            var result = documentlist.AsQueryable();
            if (!string.IsNullOrEmpty(nameFilter))
            {
                result = result.Where(x => (x.DocumentName != null && x.DocumentName.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)) ||
            (x.DocumentType != null && x.DocumentType.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)) ||
            (x.Remarks != null && x.Remarks.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)));

            }
            if (statusFilter == "1")
            {
                result = result.Where(s => s.IsValid);
            }
            else if (statusFilter == "0")
            {
                result = result.Where(s => !s.IsValid);
            }
            return result;
        }
    }
    private string GetStatusClass(bool isActive)
    {
        return isActive ? "activeClr" : "inactiveClr";
    }
    private void FilterChangedAsync(int filterValue)
    {
        statusFilter = filterValue.ToString();
        StateHasChanged();
    }
    private void AddDocument()
    {
        document = new();
        ShowPopup = true;
    }

    private async Task OnSave()
    {

        try
        {

            if (document.DocId > 0)
            {
                ShowPopup = false;
                var isConfirmed = await JS.InvokeAsync<bool>("showUpdateConfirm");
                if (!isConfirmed)
                {
                    ShowPopup = true;
                    return;
                }
                bool isSame = CommonMethod.IsEdited(document, oldcdataModel);
                if (!isSame)
                {
                    await Alert.ShowWarning("No changes detected.");
                    ShowPopup = true;
                    return;
                }
            }
            ShowPopup = false;
            document.IsValid = true;
            document.GroupCode = groupcode ?? string.Empty;
            document.BranchCode = branchcode ?? string.Empty;
            document.CreatedBy = username;
            document.CreatedDate = DateTime.Now;
            string apiUrl = "Document/AddOrUpdateDocument";
            var apiResponse = await httpService.Post<ApiResponse<object>>(apiUrl, document);
            var responsecode = apiResponse.Code;
            if (responsecode == 0)
            {
                await Alert.ShowWarning("Document" + @Localizer["Already"]);
            }
            else if (responsecode == 1)
            {
                await Alert.ShowSuccess("Document" + @Localizer["Inserted"]);
            }
            else if (responsecode == 2)
            {
                await Alert.ShowUpdate("Document" + @Localizer["Updated"]);
            }
            else
            {
                await Alert.ShowCustomAlert(@Localizer["Admin"]);
            }

            await LoadData();
            document = new DocumentModel();
        }
        catch (Exception ex)
        {
            await Alert.ShowError($"{@Localizer["Error"]}: {ex.Message}");
        }
        finally
        {

            StateHasChanged();
        }
    }

    private void EditDocument(DocumentModel item)
    {
        document = new DocumentModel
            {
                DocId = item.DocId,
                DocumentName = item.DocumentName,
                DocumentType = item.DocumentType,
                DisplayOrder = item.DisplayOrder,
                Remarks = item.Remarks,
                GroupCode = item.GroupCode,
                BranchCode = item.BranchCode
            };
        oldcdataModel = CommonMethod.CreateSnapshot(document);
        ShowPopup = true;
    }

    private void ClosePopup()
    {
        document = new();
        ShowPopup = false;
    }

    private async Task ChangeDocumentStatus(int id, bool isValid)
    {
        try
        {
            bool isActivate = !isValid;
            bool isConfirmed = await JS.InvokeAsync<bool>(isActivate ? "showActiveConfirm" : "showDeleteConfirm");
            if (!isConfirmed)
                return;

            string apiUrl = "Document/DeleteDocument";

            var apiResponse = await httpService.Post<ApiResponse<object>>(apiUrl, id);

            if (apiResponse.Success)
            {
                if (isActivate)
                    await Alert.ShowActive(Localizer["Activated"]);
                else
                    await Alert.ShowDeactive(Localizer["Deleted"]);

                await LoadData();
                StateHasChanged();
            }
            else
            {
                await Alert.ShowCustomAlert(@Localizer["Admin"]);
            }
        }
        catch (Exception ex)
        {
            await Alert.ShowError($"{Localizer["Error"]}: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
            await LoadData();
        }
    }
}
