@page "/userRight"
@* @attribute [Authorize] *@
@* @attribute [Authorize(AuthenticationSchemes = "LoginV3M")] *@
@using Microsoft.AspNetCore.Authorization
@inject IHttpClientFactory ClientFactory
@using DomainModel.SchoolMaster
@using Microsoft.AspNetCore.Components.QuickGrid
@using System.Net
@using System.Text.Json
@inject IStringLocalizer<Resource> Localizer
@using MyApp.Common
@using ServerWebUI.Components.Pages.CommonPages
@inject IJSRuntime JS
@inject Shared.IHttpService httpService
@inject HttpClient Http
@inject SweetAlertService Alert
@rendermode @(new InteractiveServerRenderMode(prerender: false))
<div class="main-container">
    <div class="row m-0 main-row">
        <div class="col-12 p-1" id="main-header">
            <div class="page-heading d-flex align-items-center justify-content-between">
                <p class="m-0 page-name px-1">User Rights </p>
                <div class="d-flex gap-2">
                    <ActionButtonGroup CurrentUrl="@currentUrl" Add="AddUserRight" />
              
                </div>
            </div>
        </div>
        <div class="col-12 p-1">
            <div class="card">
                <div class="card-body table-card p-0 scrollbar-thin">
                    <div class="quick-main">
                        <div class="grid-box">
                            <QuickGrid Items="@FilteredItems" Class="table" Pagination="@pagination">

                                <PropertyColumn Property="@(x => x.UserName)" Title="User Name" Sortable="true" Align="Align.Left">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="User Name..." />
                                        </div>
                                    </ColumnOptions>

                                </PropertyColumn>
                                <TemplateColumn Title="Status" Align="Align.Center">
                                    <ColumnOptions>
                                        <div>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "2")" @onchange="() => FilterChangedAsync(2)" /> Both
                                            </label>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "1")" @onchange="() => FilterChangedAsync(1)" /> Active
                                            </label>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "0")" @onchange="() => FilterChangedAsync(0)" /> Inactive
                                            </label>
                                        </div>
                                    </ColumnOptions>
                                    <ChildContent>
                                        <span class="@GetStatusClass(context.IsValid == true)">

                                            @(context.IsValid == true ? "Active" : "Inactive")
                                        </span>
                                    </ChildContent>
                                </TemplateColumn>
                                <TemplateColumn Align="Align.Center" Title="Action">
                                    <ActionButtonGroup IsValid="context.IsValid" CurrentUrl="@currentUrl" OnEditClick="() => EditUserRight(context)" OnStatusClick="() => ChangeUserRightStatus(context.URSID, context.IsValid)" />
                                </TemplateColumn>

                      
                            </QuickGrid>


                        </div>
                        <div class="footer-pagination">
                            <div class="d-flex align-items-center">
                                <div class="welcome-text w-100">
                                    <Paginator State="@pagination" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>

@if (ShowPopup)
{
    <div class="custom-modal row m-0 align-items-center">
        <div class="col-12 col-sm-7 col-md-5 col-lg-4 col-xl-4">
            <div class="modal-content clearfix main-popup ">
                <div class="head-btn">
                    <h5 class="modal-title">@((userRight.URSID == 0) ? "Add User Right" : "Edit User Right")</h5>
                    <button data-access="Close" type="button" @onclick="ClosePopup" class="close"><span aria-hidden="true">×</span></button>
                </div>
                <EditForm Model="@userRight" OnValidSubmit="OnSave">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="row m-0 form-row">
                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                <div class="form-box-group static-label">
                                    <InputSelect class="floating-input" placeholder=" " @bind-Value="userRight.RoleId">
                                        <option  value="" selected >--Select--</option>
                                        @foreach (var c in superAdminlist.Where(x => x.IsValid == true))
                                        {
                                            <option value="@c.RoleId">@c.RoleName</option>
                                        }
                                    </InputSelect>
                                    <label class="floating-label">
                                        Role <span class="required">*</span>
                                    </label>
                                    <ValidationMessage For="@(() => userRight.RoleId)" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                <div class="form-box-group">
                                    <InputText class="floating-input" placeholder=" " @bind-Value="userRight.UserName" onkeypress="return /^[a-zA-Z ]$/.test(event.key)" autocomplete="off" maxlength="50" />
                                    <label class="floating-label">
                                        User Name <span class="required">*</span>
                                    </label>
                                    <ValidationMessage For="@(() => userRight.UserName)" />
                                </div>
                            </div>

                        </div>
                    </div>

                    <div class="modal-footer">
                        <div class="form-group btn-gr">
                            <SaveUpdateButton Id="userRight.URSID" OnClickCancel="ClosePopup" />
                           
                          
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}


@if (IsLoading)
{
    <div class="grid-loader-overlay">
        <img src="images/loading.gif" alt="Loading..." />
    </div>
}
else
{
    @if (userRightlist.Count > 0)
    {
    }
}










