@page "/district"
@using DomainModel.SchoolMaster
@using Microsoft.AspNetCore.Components.QuickGrid
@using System.Net
@using System.Text.Json
@using MyApp.Common
@using ServerWebUI.Components.Pages.CommonPages
@inject Shared.IHttpService httpService
@inject IJSRuntime JS
@inject ICommonMethod CommonMethod
@inject IStringLocalizer<Resource> Localizer
@inject HttpClient Http
@inject SweetAlertService Alert
@rendermode InteractiveServer
<div class="main-container">
    <div class="row m-0 main-row">
        <div class="col-12 p-1" id="main-header">
            <div class="page-heading d-flex align-items-center justify-content-between">
                <p class="m-0 page-name px-1">District </p>
                <div class="d-flex gap-2">


                    <ActionButtonGroup CurrentUrl="@currentUrl" Add="AddDistrict" />
                </div>
            </div>
        </div>
        <div class="col-12 p-1">
            <div class="card">
                <div class="card-body table-card p-0 scrollbar-thin">
                    <div class="quick-main">
                        <div class="grid-box">
                            <QuickGrid Items="@FilteredItems" Class="table" Pagination="@pagination" Virtualize="false">

                                <PropertyColumn Property="@(x => x.DistrictName)" Title="District " Sortable="true">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="DistrictName ..." />
                                        </div>
                                    </ColumnOptions>

                                </PropertyColumn>
                                <TemplateColumn Title="Status" Align="Align.Center">
                                    <ColumnOptions>
                                        <div>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "2")" @onchange="() => FilterChangedAsync(2)" />  Both
                                            </label>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "1")" @onchange="() => FilterChangedAsync(1)" />Active
                                            </label>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "0")" @onchange="() => FilterChangedAsync(0)" /> Inactive
                                            </label>
                                        </div>
                                    </ColumnOptions>

                                    <ChildContent Context="row">
                                        <span class="@GetStatusClass(row.IsValid)">
                                            @(row.IsValid ? "Active" : "Inactive")
                                        </span>
                                    </ChildContent>
                                </TemplateColumn>

                                <TemplateColumn Align="Align.Center" Title="Action">
                                    <ActionButtonGroup IsValid="context.IsValid" CurrentUrl="@currentUrl" OnEditClick="() => EditDistrict(context)" OnStatusClick="() => ChangeDistrictStatus(context.DistrictId, context.IsValid)" />
                                </TemplateColumn>

                            </QuickGrid>
                        </div>
                        <div class="footer-pagination">
                            <Paginator State="pagination" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (ShowPopup)

        {
            <div class="custom-modal row m-0 align-items-center">
                <div class="col-12 col-sm-7 col-md-5 col-lg-4 col-xl-4">
                    <div class="modal-content clearfix main-popup ">
                        <div class="head-btn">
                            <h5 class="modal-title">@((district.StateId == 0) ? "Add district" : "Edit district")</h5>
                            <button data-access="Close" type="button" @onclick="ClosePopup" class="close"><span aria-hidden="true">×</span></button>
                        </div>
                        <EditForm Model="@district" OnValidSubmit="OnSave">
                            <DataAnnotationsValidator />
                            <div class="modal-body">
                                <div class="row m-0 form-row">

                                    <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                        <div class="form-box-group static-label">
                                            <InputSelect class="floating-input" placeholder=" " @bind-Value="district.StateId">
                                                <option value=""  selected>--Select--</option>
                                                @foreach (var c in statelist.Where(x => x.IsValid == true))
                                                {
                                                    <option value="@c.StateId">@c.StateName</option>
                                                }
                                            </InputSelect>

                                            <label class="floating-label">
                                                State Name <span class="required">*</span>
                                            </label>
                                            <ValidationMessage For="@(() => district.StateId)" />
                                        </div>
                                    </div>

                                    <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                        <div class="form-box-group">
                                            <InputText class="floating-input" placeholder=" " @bind-Value="district.DistrictName" maxlength="100" autocomplete="off" />
                                            <label class="floating-label">
                                                District Name <span class="required">*</span>
                                            </label>
                                            <ValidationMessage For="@(() => district.DistrictName)" />
                                        </div>
                                    </div>

                                </div>
                            </div>

                            <div class="modal-footer">
                                <div class="form-group btn-gr">
                                    <SaveUpdateButton Id="district.DistrictId" OnClickCancel="ClosePopup" />
                                </div>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        }
    </div>
</div>


@if (IsLoading)
{
    <div class="grid-loader-overlay">
        <img src="images/loading.gif" alt="Loading..." />
    </div>
}
else
{
    @if (districtlist.Count > 0)
    {
    }
}


@code{
    private DistrictModel district = new();
    private string oldcdataModel = "";
    private List<DistrictModel> districtlist = new();
    private List<StateModel> statelist = new();
    private List<CountryModel> countrylist = new();
    private bool ShowPopup = false;
    PaginationState pagination = new() { ItemsPerPage = 15 };
    private bool IsLoading = true;
    string nameFilter = string.Empty;
    private string statusFilter = "1";
    private string UserName;
    HttpResponseMessage response;

    private string? currentUrl;
    protected override void OnInitialized()
    {

        PermissionState.OnChange += StateHasChanged;
        currentUrl = Nav.Uri;
        StateHasChanged();

    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadData();
            var username = await sessionStorage.GetAsync<string>("UserName");
            UserName = username.Value;
            StateHasChanged();
        }
    }
    private async Task LoadData()
    {
        IsLoading = true;
        string ApiUri = "state/GetState";
        string ApiUri1 = "district/GetDistrict";
        string ApiUri2 = "Country/GetCountry";
        countrylist = await httpService.Get<List<CountryModel>>(ApiUri2) ?? new();
        districtlist = await httpService.Get<List<DistrictModel>>(ApiUri1) ?? new();
        statelist = await httpService.Get<List<StateModel>>(ApiUri) ?? new();

        IsLoading = false;


    }

    protected IQueryable<DistrictModel> FilteredItems
    {
        get
        {
            var result = districtlist.AsQueryable();
            if (!string.IsNullOrEmpty(nameFilter))
            {
                result = result.Where(x => (x.DistrictName != null && x.DistrictName.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)) ||
            (x.Remarks != null && x.Remarks.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)));

            }
            if (statusFilter == "1")
            {
                result = result.Where(s => s.IsValid);
            }
            else if (statusFilter == "0")
            {
                result = result.Where(s => !s.IsValid);
            }
            return result;
        }
    }
    private string GetStatusClass(bool isActive)
    {
        return isActive ? "activeClr" : "inactiveClr";
    }
    private void FilterChangedAsync(int filterValue)
    {
        statusFilter = filterValue.ToString();
        // pagination.PageIndex = 0;   // ✅ correct
        //StateHasChanged();
    }
    private void AddDistrict()
    {
        district = new();
        ShowPopup = true;
    }
    private async Task OnSave()
    {

        try
        {
            if (district.DistrictId > 0)
            {
                ShowPopup = false;
                var isConfirmed = await JS.InvokeAsync<bool>("showUpdateConfirm");
                if (!isConfirmed)
                {
                    ShowPopup = true;
                    return;
                }
                bool isSame = CommonMethod.IsEdited(district, oldcdataModel);
                if (!isSame)
                {
                    await Alert.ShowWarning("No changes detected.");
                    ShowPopup = true;
                    return;
                }
            }
            ShowPopup = false;
            district.IsValid = true;
            district.CreatedBy = UserName;
            district.CreatedDate = DateTime.Now;
            district.Remarks = "";

            var tokenResult = await sessionStorage.GetAsync<string>("authToken");
            string tokenValue = tokenResult.Value;
            Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", tokenValue);
            string apiUrl = "district/AddOrUpdateDistrict";
            var apiResponse = await httpService.Post<ApiResponse<object>>(apiUrl, district);
            if (district.DistrictId >= 0 && district.StateId > 0)
            {
                if (apiResponse.Success)
                {
                    var responsecode = apiResponse.Code;
                    if (responsecode == 0)
                    {
                        await Alert.ShowWarning("District" + @Localizer["Already"]);
                    }
                    else if (responsecode == 1)
                    {
                        await Alert.ShowSuccess("District" + @Localizer["Inserted"]);
                    }
                    else if (responsecode == 2)
                    {
                        await Alert.ShowSuccess("District" + @Localizer["Updated"]);
                    }
                    else
                    {
                        await Alert.ShowCustomAlert(@Localizer["Admin"]);
                    }
                    await LoadData();
                    district = new DistrictModel();
                }
            }
            else
            {
                await Alert.ShowCustomAlert(@Localizer["Admin"]);
                await LoadData();

            }

        }

        catch (Exception ex)
        {
            await Alert.ShowError($"{@Localizer["Error"]}: {ex.Message}");
        }
        finally
        {

            StateHasChanged();
        }
    }
    private void EditDistrict(DistrictModel item)
    {
        district = new DistrictModel
        {
            DistrictId = item.DistrictId,
            StateId = item.StateId,
            DistrictName = item.DistrictName

        };
        oldcdataModel = CommonMethod.CreateSnapshot(district);
        ShowPopup = true;
    }
    private void ClosePopup()
    {
        district = new DistrictModel();
        ShowPopup = false;
    }
    private async Task ChangeDistrictStatus(int id, bool isValid)
    {
        try
        {
            bool isActivate = !isValid;
            bool isConfirmed = await JS.InvokeAsync<bool>(isActivate ? "showActiveConfirm" : "showDeleteConfirm");
            if (!isConfirmed)
                return;

            string apiUrl = "District/DeleteDistrict";

            var apiResponse = await httpService.Post<ApiResponse<object>>(apiUrl, id);

            if (apiResponse.Success)
            {
                if (isActivate)
                    await Alert.ShowActive(Localizer["Activated"]);
                else
                    await Alert.ShowDeactive(Localizer["Deleted"]);

                await LoadData();
            }
            else
            {
                await Alert.ShowCustomAlert(@Localizer["Admin"]);
            }
        }
        catch (Exception ex)
        {
            await Alert.ShowError($"{Localizer["Error"]}: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
            await LoadData();
        }
    }

}



