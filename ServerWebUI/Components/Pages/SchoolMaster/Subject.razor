@page "/subject"
@* @attribute [Authorize] *@
@* @attribute [Authorize(AuthenticationSchemes = "LoginV3M")] *@
@using Microsoft.AspNetCore.Authorization
@inject IHttpClientFactory ClientFactory
@using DomainModel.SchoolMaster
@using Microsoft.AspNetCore.Components.QuickGrid
@using System.Net
@using System.Text.Json
@inject IStringLocalizer<Resource> Localizer
@using MyApp.Common
@using ServerWebUI.Components.Pages.CommonPages
@inject IJSRuntime JS
@inject Shared.IHttpService httpService
@inject HttpClient Http
@inject SweetAlertService Alert
@rendermode InteractiveServer
<div class="main-container">
    <div class="row m-0 main-row">
        <div class="col-12 p-1" id="main-header">
            <div class="page-heading d-flex align-items-center justify-content-between">
                <p class="m-0 page-name px-1">Subject </p>
                <div class="d-flex gap-2">
                    <ActionButtonGroup CurrentUrl="@currentUrl" Add="AddSubject" />
          
                </div>
            </div>
        </div>
        <div class="col-12 p-1">
            <div class="card">
                <div class="card-body table-card p-0 scrollbar-thin">
                    <div class="quick-main">
                        <div class="grid-box">
                            <QuickGrid Items="@FilteredItems" Class="table" Pagination="@pagination">

                                <PropertyColumn Property="@(x => x.SubjectName)" Title="Subject" Sortable="true">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="subject..." />
                                        </div>
                                    </ColumnOptions>

                                </PropertyColumn>
                                <PropertyColumn Property="@(x => x.DisplayOrder)" Title="DisplayOrder" Sortable="true" Class="text-center" Align="Align.Center">
                                

                                </PropertyColumn> 
                                <TemplateColumn Title="Status" Align="Align.Center">
                                    <ColumnOptions>
                                        <div>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "2")" @onchange="() => FilterChangedAsync(2)" /> Both
                                            </label>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "1")" @onchange="() => FilterChangedAsync(1)" /> Active
                                            </label>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "0")" @onchange="() => FilterChangedAsync(0)" /> Inactive
                                            </label>
                                        </div>
                                    </ColumnOptions>
                                    <ChildContent>
                                        <span class="@GetStatusClass(context.IsValid == true)">

                                            @(context.IsValid == true ? "Active" : "Inactive")
                                        </span>
                                    </ChildContent>
                                </TemplateColumn>

                                <TemplateColumn Align="Align.Center" Title="Action">
                                    <ActionButtonGroup IsValid="context.IsValid" CurrentUrl="@currentUrl" OnEditClick="() => EditSubject(context)" OnStatusClick="() => ChangeSubjectStatus(context.SubjectId, context.IsValid)" />
                                </TemplateColumn>
                            </QuickGrid>
                            <div class="footer-pagination">
                                <div class="d-flex align-items-center">
                                    <div class="welcome-text w-100">
                                        <Paginator State="@pagination" />
                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>

</div>

@if (ShowPopup)
{
    <div class="custom-modal row m-0 align-items-center">
        <div class="col-12 col-sm-7 col-md-5 col-lg-4 col-xl-5">
            <div class="modal-content clearfix main-popup ">
                <div class="head-btn">
                    <h5 class="modal-title">@((subjectModel.SubjectId == 0) ? "Add Subject" : "Edit Subject")</h5>
                    <button data-access="Close" type="button" @onclick="ClosePopup" class="close"><span aria-hidden="true">×</span></button>
                </div>
                <EditForm Model="subjectModel" OnValidSubmit="OnSave">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="row m-0 form-row">
                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                <div class="form-box-group static-label">
                                    <InputSelect class="floating-input" placeholder=" " @bind-Value="subjectModel.DepartmentId">
                                        <option  value="" selected>--Select--</option>
                                        @foreach (var c in departmentlist.Where(x => x.IsValid == true))
                                        {
                                            <option value="@c.DepartmentId">@c.DepartmentName</option>
                                        }
                                    </InputSelect>
                                    <label class="floating-label">
                                        Department Name <span class="required">*</span>
                                    </label>
                                    <ValidationMessage For="@(() => subjectModel.DepartmentId)" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                <div class="form-box-group">
                                    <InputText class="floating-input" placeholder=" " @bind-Value="subjectModel.SubjectCode" autocomplete="off" />
                                    <label class="floating-label">
                                        Subject Code <span class="required">*</span>
                                    </label>
                                    <ValidationMessage For="@(() => subjectModel.SubjectCode)" />
                                </div>
                            </div>

                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                <div class="form-box-group">
                                    <InputText class="floating-input" placeholder=" " @bind-Value="subjectModel.SubjectName" onkeypress="return /^[a-zA-Z ]$/.test(event.key)" autocomplete="off" />
                                    <label class="floating-label">
                                        Subject <span class="required">*</span>
                                    </label>
                                    <ValidationMessage For="@(() => subjectModel.SubjectName)" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                <div class="form-box-group">
                                    <InputText class="floating-input" placeholder=" " @bind-Value="subjectModel.Abbreviation" autocomplete="off" />
                                    <label class="floating-label">
                                        Abbreviation <span class="required">*</span>
                                    </label>
                                    <ValidationMessage For="@(() => subjectModel.Abbreviation)" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                <div class="form-box-group">
                                    <InputNumber class="floating-input" placeholder=" " @bind-Value="subjectModel.DisplayOrder" onkeypress="return /^[0-9]$/.test(event.key)" autocomplete="off" />
                                    <label class="floating-label">DisplayOrder</label>
                                </div>
                            </div>
                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                <div class="form-box-group">
                                    <InputText class="floating-input" placeholder=" " @bind-Value="subjectModel.Remarks" autocomplete="off" />
                                    <label class="floating-label">Remarks</label>
                                </div>
                            </div>

                        </div>
                    </div>

                    <div class="modal-footer">
                        <div class="form-group btn-gr">
                            <SaveUpdateButton Id="subjectModel.SubjectId" OnClickCancel="ClosePopup" />
                        </div>
                    </div>
                </EditForm>
              
            </div>
        </div>
    </div>
}


@if (IsLoading)
{
    <div class="grid-loader-overlay">
        <img src="images/loading.gif" alt="Loading..." />
    </div>
}
else
{
    @if (subjectlist.Count > 0)
    {
    }
}










