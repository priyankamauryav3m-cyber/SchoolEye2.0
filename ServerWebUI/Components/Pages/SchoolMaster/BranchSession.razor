@page "/session"
@using DomainModel.Admin
@using Microsoft.AspNetCore.Authorization
@using ServerWebUI.Components.Pages.CommonPages
@inject IHttpClientFactory ClientFactory
@using DomainModel.SchoolMaster
@using Microsoft.AspNetCore.Components.QuickGrid
@using System.Net
@using System.Text.Json
@inject ICommonMethod CommonMethod
@inject IStringLocalizer<Resource> Localizer
@using MyApp.Common
@inject IJSRuntime JS
@inject Shared.IHttpService httpService
@inject HttpClient Http
@inject SweetAlertService Alert
@rendermode InteractiveServer
<div class="main-container">
    <div class="row m-0 main-row">
        <div class="col-12 p-1">
            <div class="page-heading d-flex align-items-center justify-content-between">
                <p class="m-0 page-name px-1">Session </p>
                <div class="d-flex gap-2">
                    <ActionButtonGroup CurrentUrl="@currentUrl" Add="AddSession" />

                </div>
            </div>
        </div>
        <div class="col-12 p-1">
            <div class="card">
                <div class="card-body table-card p-0 scrollbar-thin">
                    <div class="quick-main">
                        <div class="grid-box">
                            <QuickGrid Items="@FilteredItems" Class="table" Pagination="@pagination">

                                <PropertyColumn Property="@(x => x.SessionName)" Title="Session Name" Sortable="true" Align="Align.Left">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="SessionName ..." />
                                        </div>
                                    </ColumnOptions>

                                </PropertyColumn>
                                <PropertyColumn Format="dd-MM-yyyy" Class="text-center" Sortable="true" Property="@(x => x.StartDate)" Title="Start Date" Align="Align.Center">

                                  
                                </PropertyColumn>
                                <PropertyColumn Format="dd-MM-yyyy" Class="text-center" Sortable="true" Property="@(x => x.EndDate)" Title="End date" Align="Align.Center">

                                </PropertyColumn>
                                <TemplateColumn Title="Status" Align="Align.Center">
                                    <ColumnOptions>
                                        <div>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "2")" @onchange="() => FilterChangedAsync(2)" /> Both
                                            </label>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "1")" @onchange="() => FilterChangedAsync(1)" /> Active
                                            </label>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "0")" @onchange="() => FilterChangedAsync(0)" /> Inactive
                                            </label>
                                        </div>
                                    </ColumnOptions>
                                    <ChildContent>
                                        <span class="@GetStatusClass(context.IsValid == true)">

                                            @(context.IsValid == true ? "Active" : "Inactive")
                                        </span>
                                    </ChildContent>
                                </TemplateColumn>

                                <TemplateColumn Align="Align.Center" Title="Action">
                                    <ActionButtonGroup IsValid="context.IsValid" CurrentUrl="@currentUrl" OnEditClick="() => EditSession(context)" OnStatusClick="() => ChangeSessionStatus(context.SessionId, context.IsValid)" />
                                </TemplateColumn>

                            </QuickGrid>

                        </div>
                        <div class="footer-pagination">
                            <div class="d-flex align-items-center">
                                <div class="welcome-text w-100">
                                    <Paginator State="@pagination" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@if (ShowPopup)
{
    <div class="custom-modal row m-0 align-items-center">
        <div class="col-12 col-sm-7 col-md-5 col-lg-4 col-xl-5">
            <div class="modal-content clearfix main-popup">
                <div class="head-btn">
                    <h5 class="modal-title">@((session.SessionId == 0) ? "Add Session" : "Edit Session")</h5>
                    <button data-access="Close" type="button" @onclick="ClosePopup" class="close"><span aria-hidden="true">×</span></button>
                </div>
                <EditForm Model="@session" OnValidSubmit="OnSave">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="row m-0 form-row">
                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                <div class="form-box-group">
                                    <InputText class="floating-input" placeholder=" " @bind-Value="session.Session" maxlength="20" autocomplete="off" />
                                    <label class="floating-label">
                                        Session Name <span class="required">*</span>
                                    </label>
                                    <ValidationMessage For="@(() => session.Session)" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                <div class="form-box-group">
                                    <InputDate class="floating-input" placeholder=" " @bind-Value="session.StartDate" autocomplete="off" />
                                    <label class="floating-label">
                                        Start Date <span class="required">*</span>
                                    </label>
                                    <ValidationMessage For="@(() => session.StartDate)" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                <div class="form-box-group">
                                    <InputDate class="floating-input" placeholder=" " @bind-Value="session.EndDate" autocomplete="off" />
                                    <label class="floating-label">
                                        End Date <span class="required">*</span>
                                    </label>
                                    <ValidationMessage For="@(() => session.EndDate)" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                <div class="form-box-group">
                                    <InputNumber class="floating-input" placeholder=" " @bind-Value="session.DisplayOrder" autocomplete="off" />
                                    <label class="floating-label">Display Order</label>
                                </div>
                            </div>
                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                <div class="form-box-group">
                                    <InputText class="floating-input" placeholder=" " @bind-Value="session.Remarks" autocomplete="off" />
                                    <label class="floating-label">Remarks</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <div class="form-group btn-gr">
                            <SaveUpdateButton Id="Convert.ToInt32(session.SessionId)" OnClickCancel="ClosePopup" />
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}


@if (IsLoading)
{
    <div class="grid-loader-overlay">
        <img src="images/loading.gif" alt="Loading..." />
    </div>
}
else
{
    @if (sessionlist.Count > 0)
    {
    }
}


@code {
    private bool IsLoading = true;
    private SessionModel session = new();
    private string oldcdataModel = "";
    private List<SessionModel> sessionlist = new();
    private bool ShowPopup = false;
    PaginationState pagination = new() { ItemsPerPage = 15 };
    private string nameFilter = string.Empty;
    private string statusFilter = "1";
    private string username = "";
    private string? branchcode;
    private string? groupcode;
    private string? currentUrl;
    protected override void OnInitialized()
    {

        PermissionState.OnChange += StateHasChanged;
        currentUrl = Nav.Uri;
        StateHasChanged();

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {

            await LoadData();
            StateHasChanged();
        }
    }

    private async Task LoadData()
    {
        IsLoading = true;
        var userResult = await sessionStorage.GetAsync<string>("UserName");
        username = userResult.Value;
        var branchResult = await sessionStorage.GetAsync<string>("BranchCode");
        branchcode = branchResult.Value;
        var groupResult = await sessionStorage.GetAsync<string>("GroupCode");
        groupcode = groupResult.Value;
        sessionlist = await httpService.Get<List<SessionModel>>("Session/GetSession") ?? new();

        IsLoading = false;


    }
    protected IQueryable<SessionModel> FilteredItems
    {
        get
        {
            var result = sessionlist.AsQueryable();
            if (!string.IsNullOrEmpty(nameFilter))
            {
                result = result.Where(x => (x.SessionName != null && x.SessionName.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)));

            }
            if (statusFilter == "1")
            {
                result = result.Where(s => s.IsValid);
            }
            else if (statusFilter == "0")
            {
                result = result.Where(s => !s.IsValid);
            }
            return result;
        }
    }
    private string GetStatusClass(bool isActive)
    {
        return isActive ? "activeClr" : "inactiveClr";
    }
    private void FilterChangedAsync(int filterValue)
    {
        statusFilter = filterValue.ToString();
        StateHasChanged();
    }
    private void AddSession()
    {
        session = new();
        ShowPopup = true;
    }

    private async Task OnSave()
    {

        try
        {

            if (session.SessionId > 0)
            {
                ShowPopup = false;
                var isConfirmed = await JS.InvokeAsync<bool>("showUpdateConfirm");
                if (!isConfirmed)
                {
                    ShowPopup = true;
                    return;
                }
                bool isSame = CommonMethod.IsEdited(session, oldcdataModel);
                if (!isSame)
                {
                    await Alert.ShowWarning("No changes detected.");
                    ShowPopup = true;
                    return;
                }
            }
            ShowPopup = false;
            session.IsValid = true;
            session.CreatedBy = username;
            session.GroupCode = groupcode;
            session.BranchCode = branchcode;
            session.CreatedDate = DateTime.Now;
            string apiUrl = "Session/AddOrUpdateSession";
            var apiResponse = await httpService.Post<ApiResponse<object>>(apiUrl, session);
            if (apiResponse.Success)
            {
                if (apiResponse.Code == 0)
                {
                    await Alert.ShowWarning("Session" + @Localizer["Already"]);
                }

                if (apiResponse.Code == 1)
                {
                    await Alert.ShowSuccess("Session" + @Localizer["Inserted"]);
                }
                else if (apiResponse.Code == 2)
                {
                    await Alert.ShowUpdate("Session" + @Localizer["Updated"]);
                }
                else
                {
                    await Alert.ShowCustomAlert(@Localizer["Admin"]);
                }
                await LoadData();
                session = new SessionModel();
            }
        }
        catch (Exception ex)
        {
            return;
        }
        finally
        {

            StateHasChanged();
        }
    }

    private void EditSession(SessionModel item)
    {
        session = new SessionModel
        {
            Session = item.SessionName,
            AdmissionSession = item.AdmissionSession,
            DisplayOrder = item.DisplayOrder,
            StartDate = item.StartDate,
            EndDate = item.EndDate,
            CurrentSession = item.CurrentSession,
            Remarks=item.Remarks,


        };

        oldcdataModel = CommonMethod.CreateSnapshot(session);
        ShowPopup = true;
    }

    private void ClosePopup()
    {
        session = new();
        ShowPopup = false;
    }

    private async Task ChangeSessionStatus(long id, bool isValid)
    {
        try
        {
            bool isActivate = !isValid;
            bool isConfirmed = await JS.InvokeAsync<bool>(isActivate ? "showActiveConfirm" : "showDeleteConfirm");
            if (!isConfirmed)
                return;

            string apiUrl = "Session/DeleteSession";

            var apiResponse = await httpService.Post<ApiResponse<object>>(apiUrl, id);

            if (apiResponse.Success)
            {
                if (isActivate)
                    await Alert.ShowActive(Localizer["Activated"]);
                else
                    await Alert.ShowDeactive(Localizer["Deleted"]);

                await LoadData();
                StateHasChanged();
            }
            else
            {
                await Alert.ShowCustomAlert(@Localizer["Admin"]);
            }
        }
        catch (Exception ex)
        {
            await Alert.ShowError($"{Localizer["Error"]}: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
            await LoadData();
        }
    }

}