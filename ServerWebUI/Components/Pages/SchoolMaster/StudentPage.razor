@page "/student"
@using System.ComponentModel.DataAnnotations
@using DomainModel.Admin
@using Microsoft.AspNetCore.Authorization
@using ServerWebUI.Components.Pages.CommonPages
@inject IHttpClientFactory ClientFactory
@using DomainModel.SchoolMaster
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.AspNetCore.Components.Forms
@using System.Net
@using System.Net.Http.Headers
@using System.Text.Json
@inject ICommonMethod CommonMethod
@inject IStringLocalizer<Resource> Localizer
@using MyApp.Common
@inject IJSRuntime JS
@inject Shared.IHttpService httpService
@inject HttpClient Http
@inject SweetAlertService Alert
@rendermode InteractiveServer
<div class="main-container">
    <div class="row m-0 main-row">
        <div class="col-12 p-1" id="main-header">
            <div class="page-heading d-flex align-items-center justify-content-between">
                <p class="m-0 page-name px-1">Student </p>
                <div class="d-flex gap-2">
                    <ActionButtonGroup CurrentUrl="@currentUrl" Add="AddStudent" />
                    <button class="ui fade op-1 animated button form-btn" @onclick="AddStudent">
                        <div class="visible content justify-content-center">Add</div>
                        <div class="hidden content"><i class="bi bi-plus-lg"></i></div>
                    </button>
                </div>
            </div>
        </div>
        <div class="col-12 p-1">
            <div class="card">
                <div class="card-body table-card p-0 scrollbar-thin">
                    <div class="quick-main">
                        <div class="grid-box">
                            <QuickGrid Items="@FilteredItems" Class="table" Pagination="@pagination">

                                <PropertyColumn Property="@(x => x.StudentName)" Title="Student Name" Sortable="true" Align="Align.Left">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="StudentName ..." />
                                        </div>
                                    </ColumnOptions>

                                </PropertyColumn>

                                <PropertyColumn Property="@(x => x.Gender)" Title="Gender" Sortable="true" Align="Align.Left">
                                </PropertyColumn>

                                <PropertyColumn Property="@(x => x.EmailAddress)" Title="Email Address" Sortable="true" Align="Align.Left">
                                </PropertyColumn>

                                <PropertyColumn Property="@(x => x.DateOfBirth)" Title="Date of Birth" Class="text-center" Sortable="true" Align="Align.Center">
                                </PropertyColumn>

                                <PropertyColumn Property="@(x => x.DisplayOrder)" Title="Display Order" Class="text-center" Sortable="true" Align="Align.Center">
                                </PropertyColumn>

                                <TemplateColumn Title="Status" Align="Align.Center">
                                    <ColumnOptions>
                                        <div>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "2")" @onchange="() => FilterChangedAsync(2)" /> Both
                                            </label>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "1")" @onchange="() => FilterChangedAsync(1)" /> Active
                                            </label>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "0")" @onchange="() => FilterChangedAsync(0)" /> Inactive
                                            </label>
                                        </div>
                                    </ColumnOptions>
                                    <ChildContent>
                                        <span class="@GetStatusClass(context.IsActive == true)">

                                            @(context.IsActive == true ? "Active" : "Inactive")
                                        </span>
                                    </ChildContent>
                                </TemplateColumn>

                                <TemplateColumn Align="Align.Center" Title="Action">
                                    <ActionButtonGroup IsValid="context.IsActive" CurrentUrl="@currentUrl" OnEditClick="() => EditStudent(context)" OnStatusClick="() => ChangeStudentStatus(context.StudentId, context.IsActive)" />
                                    <div class="action-btn-group">

                                        @if (context.IsActive)
                                        {
                                            <button class="btn-icon edit-btn custom-tooltip " data-tooltip="Edit" @onclick="() => EditStudent(context)">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>

                                            <button class="btn-icon inactive-btn custom-tooltip " data-tooltip="Delete" @onclick="() => ChangeStudentStatus(context.StudentId, context.IsActive)">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                           
                                        }
                                        else
                                        {
                                            <button disabled class="btn-icon edit-btn custom-tooltip " data-tooltip="Edit" @onclick="() => EditStudent(context)">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button class="btn-icon active-btn custom-tooltip " data-tooltip="Delete" @onclick="() => ChangeStudentStatus(context.StudentId, context.IsActive)">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                    
                                        }
                                    </div>

                                </TemplateColumn>

                            </QuickGrid>


                        </div>
                        <div class="footer-pagination">
                            <div class="d-flex align-items-center">
                                <div class="welcome-text w-100">
                                    <Paginator State="@pagination" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
