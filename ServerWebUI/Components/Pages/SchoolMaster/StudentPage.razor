@page "/student"
@using System.ComponentModel.DataAnnotations
@using DomainModel.Admin
@using Microsoft.AspNetCore.Authorization
@using ServerWebUI.Components.Pages.CommonPages
@inject IHttpClientFactory ClientFactory
@using DomainModel.SchoolMaster
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.AspNetCore.Components.Forms
@using System.Net
@using System.Net.Http.Headers
@using System.Text.Json
@inject ICommonMethod CommonMethod
@inject IStringLocalizer<Resource> Localizer
@using MyApp.Common
@inject IJSRuntime JS
@inject Shared.IHttpService httpService
@inject HttpClient Http
@inject SweetAlertService Alert
@rendermode InteractiveServer
<style>
 
    .main-container.not-found-page-wrap {
        display: flex;
        flex-direction: column;
        min-height: calc(100vh - 65px);
    }

    .not-found-page-wrap .main-row {
        flex: 1;
        display: flex;
    }

        .not-found-page-wrap .main-row > div {
            display: flex;
        }

    .not-found-page-wrap .card {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .not-found-page-wrap .card-body {
        flex: 1;
        display: flex;
    }

    .not-found-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 60px 20px;
        flex: 1;
        width: 100%;
    }

    .not-found-icon {
        width: 84px;
        height: 84px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: linear-gradient(135deg, #e8f2fb, #f4eefc);
        color: #1e8fd3;
        font-size: 34px;
        margin-bottom: 18px;
    }

    .not-found-code {
        font-size: 13px;
        font-weight: 700;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: #a855f7;
        margin-bottom: 6px;
    }

    .not-found-title {
        font-size: 20px;
        font-weight: 700;
        color: #1e293b;
        margin: 0 0 8px;
    }

    .not-found-desc {
        font-size: 13px;
        color: #66798c;
        max-width: 360px;
        margin: 0 auto;
        line-height: 1.6;
    }
</style>

<div class="main-container not-found-page-wrap">
    <div class="row m-0 main-row">
        <div class="col-12 p-1">
            <div class="card w-100">
                <div class="card-body table-card p-0 scrollbar-thin">
                    <div class="not-found-wrap">
                        <div class="not-found-icon">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </div>
                        <div class="not-found-code">404 · Not Found</div>
                        <h5 class="not-found-title">We couldn't find this page</h5>
                        <p class="not-found-desc">The page you're looking for doesn't exist or may have been moved. Please check the URL or go back.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>