    private bool IsLoading = true;
    private StudentModel student = new();
    private string oldcdataModel = "";
    private List<StudentModel> studentlist = new();
    private List<CountryModel> countrylist = new();
    private List<StateModel> statelist = new();
    private List<DistrictModel> citylist = new();
    private List<StateModel> filteredStateList = new();
    private List<DistrictModel> filteredCityList = new();
    private bool ShowPopup = false;
    private bool isUploadingPhoto = false;
    PaginationState pagination = new()
    {
        ItemsPerPage = 15
    };
    private string nameFilter = string.Empty;
    private string statusFilter = "1";
    private string username = "";
    HttpResponseMessage response;
    private EditContext editContext;
    bool isSaving = false;
    bool isUploading = false;
    string? uploadError;
    string? statusMessage;
    bool statusIsError = false;
    private string? currentUrl;
    protected override void OnInitialized()
    {

        PermissionState.OnChange += StateHasChanged;
        currentUrl = Nav.Uri;
        StateHasChanged();

    }
    private async Task HandlePhotoSelected(InputFileChangeEventArgs e)
    {
        uploadError = null;
        var file = e.File;

        if (file.Size > 2 * 1024 * 1024)
        {
            uploadError = "File size must not exceed 2MB.";
            return;
        }

        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        if (ext != ".jpg" && ext != ".jpeg" && ext != ".png")
        {
            uploadError = "Only JPG or PNG files are allowed.";
            return;
        }

        try
        {
            isUploading = true;
            using var content = new MultipartFormDataContent();
            var stream = file.OpenReadStream(2 * 1024 * 1024);
            var streamContent = new StreamContent(stream);
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(streamContent, "file", file.Name);

            var response = await httpService.Post<ApiResponse<string>>("Student/UploadPhoto", content);
            if (response != null && response.Success)
            {
                student.PhotoPath = response.Data;
            }
            else
            {
                uploadError = response?.Message ?? "Upload failed.";
            }
        }
        catch
        {
            uploadError = "An error occurred while uploading the photo.";
        }
        finally
        {
            isUploading = false;
        }
    }
    async Task SaveStudent()
    {
        isSaving = true;
        statusMessage = null;

        try
        {
            var response = await httpService.Post<ApiResponse<object>>("Student/AddOrUpdateStudent", student);

            if (response != null && response.Success)
            {
                statusIsError = response.Code == 0;
                statusMessage = response.Message;

                if (response.Code == 1 || response.Code == 2)
                {
                    student = new();
                    filteredStateList = new();
                    filteredCityList = new();
                }
            }
            else
            {
                statusIsError = true;
                statusMessage = response?.Message ?? "Unexpected error occurred";
            }
        }
        catch
        {
            statusIsError = true;
            statusMessage = "An error occurred while saving the record.";
        }
        finally
        {
            isSaving = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var userResult = await sessionStorage.GetAsync<string>("UserName");
            username = userResult.Value;
            await LoadLookups();
            await LoadData();
            StateHasChanged();
        }
    }

    private async Task LoadLookups()
    {
        countrylist = await httpService.Get<List<CountryModel>>("Country/GetCountry") ?? new();
        statelist = await httpService.Get<List<StateModel>>("State/GetState") ?? new();
        citylist = await httpService.Get<List<DistrictModel>>("District/GetDistrict") ?? new();
    }

    private void OnCountryChanged()
    {
        student.StateId = 0;
        student.CityId = 0;
        filteredStateList = statelist.Where(x => x.CountryId == student.CountryId).ToList();
        filteredCityList = new();
        StateHasChanged();
    }

    private void OnStateChanged()
    {
        student.CityId = 0;
        filteredCityList = citylist.Where(x => x.StateId == student.StateId).ToList();
        StateHasChanged();
    }

    private void OnStudentNameChanged(string value)
    {
        student.StudentName =
            System.Text.RegularExpressions.Regex
            .Replace(value ?? "", "[^a-zA-Z ]", "");
        StateHasChanged();
    }

    private async Task OnPhotoSelected(InputFileChangeEventArgs e)
    {
        try
        {
            isUploadingPhoto = true;
            StateHasChanged();

            var file = e.File;
            if (file == null) return;

            const long maxSize = 2 * 1024 * 1024; // 2 MB
            using var stream = file.OpenReadStream(maxSize);
            using var content = new MultipartFormDataContent();
            using var fileContent = new StreamContent(stream);
            fileContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);
            content.Add(fileContent, "file", file.Name);

            var response = await Http.PostAsync("api/Student/UploadStudentPhoto", content);
            if (response.IsSuccessStatusCode)
            {
                var savedPath = await response.Content.ReadAsStringAsync();
                student.PhotoPath = savedPath.Trim('"');
            }
            else
            {
                await Alert.ShowWarning("Photo upload failed. Please try again.");
            }
        }
        catch (Exception ex)
        {
            await Alert.ShowError($"{@Localizer["Error"]}: {ex.Message}");
        }
        finally
        {
            isUploadingPhoto = false;
            StateHasChanged();
        }
    }

    private async Task LoadData()
    {
        IsLoading = true;
        string apiUri = $"Student/GetStudent?studentId={0}";
        var response = await httpService.Get<ApiResponse<List<StudentModel>>>(apiUri) ?? new();
        if (response.Success == true)
        {
            studentlist = response.Data ?? new();
        }
        IsLoading = false;


    }
    protected IQueryable<StudentModel> FilteredItems
    {
        get
        {
            var result = studentlist.AsQueryable();
            if (!string.IsNullOrEmpty(nameFilter))
            {
                result = result.Where(x => (x.StudentName != null && x.StudentName.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)) ||
            (x.EmailAddress != null && x.EmailAddress.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)));

            }
            if (statusFilter == "1")
            {
                result = result.Where(s => s.IsActive);
            }
            else if (statusFilter == "0")
            {
                result = result.Where(s => !s.IsActive);
            }
            return result;
        }
    }
    private string GetStatusClass(bool isActive)
    {
        return isActive ? "activeClr" : "inactiveClr";
    }
    private void FilterChangedAsync(int filterValue)
    {
        statusFilter = filterValue.ToString();
        StateHasChanged();
    }
    private void AddStudent()
    {
        student = new();
        filteredStateList = new();
        filteredCityList = new();
        ShowPopup = true;
    }

    private async Task OnSave()
    {

        try
        {

            if (student.StudentId > 0)
            {
                ShowPopup = false;
                var isConfirmed = await JS.InvokeAsync<bool>("showUpdateConfirm");
                if (!isConfirmed)
                {
                    ShowPopup = true;
                    return;
                }
                bool isSame = CommonMethod.IsEdited(student, oldcdataModel);
                if (!isSame)
                {
                    await Alert.ShowWarning("No changes detected.");
                    ShowPopup = true;
                    return;
                }
            }
            ShowPopup = false;
            student.IsActive = true;
            student.CreatedBy = username;
            student.CreatedDate = DateTime.Now;
            // IBrowserFile is a client-only handle and cannot be JSON-serialized -
            // the photo is already uploaded separately and PhotoPath holds the saved path.
            student.StudentPhoto = null;
            string apiUrl = "Student/AddOrUpdateStudent";
            var apiResponse = await httpService.Post<ApiResponse<object>>(apiUrl, student);
            var responsecode = apiResponse.Code;
            if (responsecode == 0)
            {
                await Alert.ShowWarning("Student" + @Localizer["Already"]);
            }
            else if (responsecode == 1)
            {
                await Alert.ShowSuccess("Student" + @Localizer["Inserted"]);
            }
            else if (responsecode == 2)
            {
                await Alert.ShowUpdate("Student" + @Localizer["Updated"]);
            }
            else
            {
                await Alert.ShowCustomAlert(@Localizer["Admin"]);
            }

            await LoadData();
            student = new StudentModel();
        }
        catch (Exception ex)
        {
            await Alert.ShowError($"{@Localizer["Error"]}: {ex.Message}");
        }
        finally
        {

            StateHasChanged();
        }
    }

    private void EditStudent(StudentModel item)
    {
        student = new StudentModel
        {
            StudentId = item.StudentId,
            StudentName = item.StudentName,
            Gender = item.Gender,
            EmailAddress = item.EmailAddress,
            DateOfBirth = item.DateOfBirth,
            DisplayOrder = item.DisplayOrder,
            CountryId = item.CountryId,
            StateId = item.StateId,
            CityId = item.CityId,
            PhotoPath = item.PhotoPath
        };

        filteredStateList = statelist.Where(x => x.CountryId == student.CountryId).ToList();
        filteredCityList = citylist.Where(x => x.StateId == student.StateId).ToList();

        oldcdataModel = CommonMethod.CreateSnapshot(student);
        ShowPopup = true;
    }

    private void ClosePopup()
    {
        student = new();
        ShowPopup = false;
    }

    private async Task ChangeStudentStatus(int id, bool isValid)
    {
        try
        {
            bool isActivate = !isValid;
            bool isConfirmed = await JS.InvokeAsync<bool>(isActivate ? "showActiveConfirm" : "showDeleteConfirm");
            if (!isConfirmed)
                return;

            string apiUrl = "Student/DeleteStudent";
            var apiResponse = await httpService.Post<ApiResponse<object>>(apiUrl, id);

            if (apiResponse.Success)
            {
                if (isActivate)
                    await Alert.ShowActive(Localizer["Activated"]);
                else
                    await Alert.ShowDeactive(Localizer["Deleted"]);

                await LoadData();
                StateHasChanged();
            }
            else
            {
                await Alert.ShowCustomAlert(@Localizer["Admin"]);
            }
        }
        catch (Exception ex)
        {
            await Alert.ShowError($"{Localizer["Error"]}: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
            await LoadData();
        }
    }
