@page "/classsubject"
@using DomainModel.SchoolMaster
@using Microsoft.AspNetCore.Components.QuickGrid
@using System.Net
@using System.Text.Json
@using Microsoft.AspNetCore.Mvc
@using MyApp.Common
@using ServerWebUI.Components.Pages.CommonPages
@inject Shared.IHttpService httpService
@inject IJSRuntime JS
@inject ICommonMethod CommonMethod
@inject HttpClient Http
@inject IStringLocalizer<Resource> Localizer
@inject SweetAlertService Alert
@rendermode InteractiveServer


<div class="main-container">
    <div class="row m-0 main-row">
        <div class="col-12 p-1" id="main-header">
            <div class="page-heading d-flex align-items-center justify-content-between">
                <p class="m-0 page-name px-1">Class Subject </p>
                <div class="d-flex gap-2">
                    <ActionButtonGroup CurrentUrl="@currentUrl" Add="AddClassSubject"/>
                    @* <button class="ui fade op-1 animated button form-btn" @onclick="AddClassSubject" tabindex="0">
                        <div class="visible content">Add</div>
                        <div class="hidden content"><i class="bi bi-plus-lg"></i></div>
                    </button> *@
                </div>
            </div>
        </div>
        <div class="col-12 p-1">
            <div class="card">
                <div class="card-body table-card p-0 scrollbar-thin">
                    <div class="quick-main">
                        <div class="grid-box">
                            <QuickGrid Items="@FilteredItems" Class="table" Pagination="@pagination">
                                <PropertyColumn Property="@(x => x.ClassCode)" Title="Class Code " Sortable="true" Align="Align.Left">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="ClassCode ..." />
                                        </div>
                                    </ColumnOptions>

                                </PropertyColumn>
                                <PropertyColumn Property="@(x => x.SubjectCode)" Title="Subject Code " Sortable="true" Align="Align.Left">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="SubjectCode ..." />
                                        </div>
                                    </ColumnOptions>

                                </PropertyColumn>
                                <PropertyColumn Property="@(x => x.DisplayOrder)" Class="text-center" Sortable="true" Title="Display Order" Align="Align.Center">

                               

                                </PropertyColumn>
                                <TemplateColumn Title="Status" Align="Align.Center">
                                    <ColumnOptions>
                                        <div>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "2")" @onchange="() => FilterChangedAsync(2)" /> Both
                                            </label>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "1")" @onchange="() => FilterChangedAsync(1)" /> Active
                                            </label>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "0")" @onchange="() => FilterChangedAsync(0)" /> Inactive
                                            </label>
                                        </div>
                                    </ColumnOptions>
                                    <ChildContent>
                                        <span class="@GetStatusClass(context.IsValid == true)">

                                            @(context.IsValid == true ? "Active" : "Inactive")
                                        </span>
                                    </ChildContent>
                                </TemplateColumn>

                                <TemplateColumn Align="Align.Center" Title="Action">
                                    <ActionButtonGroup IsValid="context.IsValid" CurrentUrl="@currentUrl" OnEditClick="() => EditClassSubject(context)" OnStatusClick="() => ChangeClassSubjectStatus(context.MapId, context.IsValid)" />
                                </TemplateColumn>
                          
                            </QuickGrid>


                        </div>
                        <div class="footer-pagination">
                            <div class="d-flex align-items-center">
                                <div class="welcome-text w-100">
                                    <Paginator State="@pagination" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>

@if (ShowPopup)
{
    <div class="custom-modal row m-0 align-items-center">
        <div class="col-12 col-sm-7 col-md-5 col-lg-4 col-xl-4">
            <div class="modal-content clearfix main-popup ">
                <div class="head-btn">
                    <h5 class="modal-title">@((classSubject.MapId == 0) ? "Add Class Subject" : "Edit  class Subject")</h5>
                    <button data-access="Close" type="button" @onclick="ClosePopup" class="close"><span aria-hidden="true">×</span></button>
                </div>
                <EditForm Model="@classSubject" OnValidSubmit="OnSave">
                    <DataAnnotationsValidator />

                    <div class="modal-body">
                        <div class="row m-0 form-row">
                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                <div class="form-box-group static-label">
                                    <InputSelect class="floating-input" placeholder=" " @bind-Value="classSubject.ClassCode" autocomplete="off">
                                        <option  value="" selected >--Select--</option>
                                        @foreach (var data in classcodelist)
                                        {
                                            <option value="@data.ClassCode">@data.ClassCode</option>
                                        }
                                    </InputSelect>
                                    <label class="floating-label">
                                        Class Code <span class="required">*</span>
                                    </label>
                                    <ValidationMessage For="@(() => classSubject.ClassCode)" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                <div class="form-box-group">
                                    <InputText class="floating-input" placeholder=" " @bind-Value="classSubject.SubjectCode" autocomplete="off" />
                                    <label class="floating-label">
                                        Subject Code <span class="required">*</span>
                                    </label>
                                    <ValidationMessage For="@(() => classSubject.SubjectCode)" />
                                </div>
                            </div>

                            <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                <div class="form-box-group">
                                    <InputNumber class="floating-input" placeholder=" " @bind-Value="classSubject.DisplayOrder" onkeypress="return /^[0-9]$/.test(event.key)" autocomplete="off" required />
                                    <label class="floating-label">DisplayOrder</label>
                                    <ValidationMessage For="@(() => classSubject.DisplayOrder)" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <div class="form-group btn-gr">
                            <SaveUpdateButton Id="classSubject.MapId" OnClickCancel="ClosePopup" />
                           
                  
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}


@if (IsLoading)
{
    <div class="grid-loader-overlay">
        <img src="images/loading.gif" alt="Loading..." />
    </div>
}
else
{
    @if (classSubjectlist.Count > 0)
    {
    }
}



