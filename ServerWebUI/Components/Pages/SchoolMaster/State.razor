@page "/state"
@using DomainModel.SchoolMaster
@using Microsoft.AspNetCore.Components.QuickGrid
@using System.Net
@using System.Text.Json
@using MyApp.Common
@using ServerWebUI.Components.Pages.CommonPages
@inject Shared.IHttpService httpService
@inject IJSRuntime JS
@inject HttpClient Http
@inject SweetAlertService Alert
@inject IStringLocalizer<Resource> Localizer
@rendermode InteractiveServer
<div class="main-container">
    <div class="row m-0 main-row">
        <div class="col-12 p-1" id="main-header">
            <div class="page-heading d-flex align-items-center justify-content-between">
                <p class="m-0 page-name px-1">State </p>
                <div class="d-flex gap-2">
                    <ActionButtonGroup CurrentUrl="@currentUrl" Add="AddState" />

                </div>
            </div>
        </div>
        <div class="col-12 p-1">
            <div class="card">
                <div class="card-body table-card p-0 scrollbar-thin">
                    <div class="quick-main">
                        <div class="grid-box">
                            <QuickGrid Items="@FilteredItems" Class="table" Pagination="@pagination">
                                <PropertyColumn Property="@(x => x.StateName)" Title="State" Sortable="true" Align="Align.Left">
                                    <ColumnOptions>
                                        <div class="search-box">
                                            <input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="State..." />
                                        </div>
                                    </ColumnOptions>
                                </PropertyColumn>
                                <TemplateColumn Title="Status" Align="Align.Center">
                                    <ColumnOptions>
                                        <div>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "2")" @onchange="() => FilterChangedAsync(2)" /> Both
                                            </label>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "1")" @onchange="() => FilterChangedAsync(1)" /> Active
                                            </label>
                                            <label>
                                                <input type="radio" name="status" checked="@(statusFilter == "0")" @onchange="() => FilterChangedAsync(0)" /> Inactive
                                            </label>
                                        </div>
                                    </ColumnOptions>
                                    <ChildContent>
                                        <span class="@GetStatusClass(context.IsValid == true)">
                                            @(context.IsValid == true ? "Active" : "Inactive")
                                        </span>
                                    </ChildContent>
                                </TemplateColumn>
                                <TemplateColumn Align="Align.Center" Title="Action">
                                    <ActionButtonGroup IsValid="context.IsValid" CurrentUrl="@currentUrl" OnEditClick="() => EditState(context)" OnStatusClick="() => ChangeStateStatus(context.StateId, context.IsValid)" />
                                </TemplateColumn>
                            </QuickGrid>
                        </div>
                        <div class="footer-pagination">
                            <div class="d-flex align-items-center">
                                <div class="welcome-text w-100">
                                    <Paginator State="@pagination" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (ShowPopup)
        {
            <div class="custom-modal row m-0 align-items-center">
                <div class="col-12 col-sm-7 col-md-5 col-lg-4 col-xl-4">
                    <div class="modal-content clearfix main-popup">
                        <div class="head-btn">
                            <h5 class="modal-title">State</h5>
                            <button data-access="Close" type="button" @onclick="ClosePopup" class="close"><span aria-hidden="true">×</span></button>
                        </div>
                        <EditForm Model="@state" OnValidSubmit="@OnSave">
                            <DataAnnotationsValidator />
                            <div class="modal-body">
                                <div class="row m-0 form-row">

                                    <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                        <div class="form-box-group static-label">
                                            <InputSelect class="floating-input" placeholder=" " @bind-Value="state.CountryId">
                                                <option  value="" selected>--Select--</option>
                                                @foreach (var c in countrylist.Where(x => x.IsValid == true))
                                                {
                                                    <option value="@c.CountryId">@c.CountryName</option>
                                                }
                                            </InputSelect>
                                         
                                            <label class="floating-label">
                                                State Name <span class="required">*</span>
                                            </label>
                                            <ValidationMessage For="@(() => state.StateName)" />
                                        </div>
                                    </div>

                                    <div class="col-12 col-sm-12 col-md-12 col-lg-12 px-2">
                                        <div class="form-box-group">
                                            <InputText class="floating-input" placeholder=" " @bind-Value="state.Remarks" />
                                            <label class="floating-label">Remarks</label>
                                        </div>
                                    </div>

                                </div>
                            </div>
                            <div class="modal-footer">
                                <div class="form-group btn-gr">
                                    <SaveUpdateButton TextSave="Submit" OnClickCancel="ClosePopup"></SaveUpdateButton>
                                </div>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        }

    </div>

</div>

@if (IsLoading)
{
    <div class="grid-loader-overlay">
        <img src="images/loading.gif" alt="Loading..." />
    </div>
}
else
{
    @if (statelist.Count > 0)
    {
    }
}



@code{
    private StateModel state = new();
    private string oldcdataModel = "";
    private List<StateModel> statelist = new();
    private List<CountryModel> countrylist = new();
    private bool IsLoading = true;
    private bool ShowPopup = false;
    PaginationState pagination = new PaginationState() { ItemsPerPage = 15 };
    string nameFilter = string.Empty;
    private string statusFilter = "1";
    private string UserName = "1";
    HttpResponseMessage response;
    private string? currentUrl;
    protected override void OnInitialized()
    {

        PermissionState.OnChange += StateHasChanged;
        currentUrl = Nav.Uri;
        StateHasChanged();

    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadData();
            var username = await sessionStorage.GetAsync<string>("UserName");
            UserName = username.Value;
            StateHasChanged();
        }
    }
    private async Task LoadData()
    {
        IsLoading = true;
        string ApiUri = "state/GetState";
        string ApiUri1 = "Country/GetCountry";
        statelist = await httpService.Get<List<StateModel>>(ApiUri) ?? new();
        countrylist = await httpService.Get<List<CountryModel>>(ApiUri1) ?? new();

        IsLoading = false;


    }

    protected IQueryable<StateModel> FilteredItems
    {
        get
        {
            var result = statelist.AsQueryable();
            if (!string.IsNullOrEmpty(nameFilter))
            {
                result = result.Where(x => (x.StateName != null && x.StateName.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)) ||
            (x.Remarks != null && x.Remarks.Contains(nameFilter, StringComparison.CurrentCultureIgnoreCase)));

            }
            if (statusFilter == "1")
            {
                result = result.Where(s => s.IsValid == true || s.IsValid == true);
            }
            else if (statusFilter == "0")
            {
                result = result.Where(s => s.IsValid == false || s.IsValid == false);
            }
            return result;
        }
    }
    private string GetStatusClass(bool isActive)
    {
        return isActive ? "activeClr" : "inactiveClr";
    }
    private void FilterChangedAsync(int filterValue)
    {
        statusFilter = filterValue.ToString();
        StateHasChanged();
    }
    private void AddState()
    {
        state = new();
        ShowPopup = true;
    }

      

    private async Task OnSave()
    {

        try
        {


            if (state.CountryId > 0)
            {
                ShowPopup = false;
                var isConfirmed = await JS.InvokeAsync<bool>("showUpdateConfirm");
                if (!isConfirmed)
                {
                    ShowPopup = true;
                    return;
                }
                bool isSame = CommonMethod.IsEdited(state, oldcdataModel);
                if (!isSame)
                {
                    await Alert.ShowWarning("No changes detected.");
                    ShowPopup = true;
                    return;
                }
            }
            ShowPopup = false;
            state.IsValid = true;
            state.CreatedBy = UserName;
            state.CreatedDate = DateTime.Now;
            state.Remarks = "";
            string apiUrl = "State/AddOrUpdateState";
            var apiResponse = await httpService.Post<ApiResponse<object>>(apiUrl, state);
            if (state.StateId >= 0 && state.CountryId > 0)
            {
                if (apiResponse.Success)
                {
                    var responsecode = apiResponse.Code;
                    if (responsecode == 0)
                    {
                        await Alert.ShowWarning("State" + @Localizer["Already"]);
                    }
                    else if (responsecode == 1)
                    {
                        await Alert.ShowSuccess("State" + @Localizer["Inserted"]);
                    }
                    else if (responsecode == 2)
                    {
                        await Alert.ShowSuccess("State" + @Localizer["Updated"]);
                    }
                    else
                    {
                        await Alert.ShowCustomAlert(@Localizer["Admin"]);
                    }
                    await LoadData();
                    state = new StateModel();
                }
            }
            else
            {
                await Alert.ShowCustomAlert(@Localizer["Admin"]);
                await LoadData();
            }

               
        }
        catch (Exception ex)
        {
            await Alert.ShowError($"{@Localizer["Error"]}: {ex.Message}");
        }
        finally
        {

            StateHasChanged();
        }
    }


    private void EditState(StateModel item)
    {
        state = new StateModel
        {
            StateId = item.StateId,
            CountryId = item.CountryId,
            StateName = item.StateName


        };
        oldcdataModel = CommonMethod.CreateSnapshot(state);
        ShowPopup = true;
    }

    private void ClosePopup()
    {
        ShowPopup = false;
        state = new StateModel();
        StateHasChanged();
    }
    private async Task ChangeStateStatus(int id, bool isValid)
    {
        try
        {
            bool isActivate = !isValid;
            bool isConfirmed = await JS.InvokeAsync<bool>(isActivate ? "showActiveConfirm" : "showDeleteConfirm");
            if (!isConfirmed)
                return;

            string apiUrl = "state/DeleteState";

            var apiResponse = await httpService.Post<ApiResponse<object>>(apiUrl, id);

            if (apiResponse.Success)
            {
                if (isActivate)
                    await Alert.ShowActive(Localizer["Activated"]);
                else
                    await Alert.ShowDeactive(Localizer["Deleted"]);

                await LoadData();
            }
            else
            {
                await Alert.ShowCustomAlert(@Localizer["Admin"]);
            }
        }
        catch (Exception ex)
        {
            await Alert.ShowError($"{Localizer["Error"]}: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
            await LoadData();
        }
    }

}

