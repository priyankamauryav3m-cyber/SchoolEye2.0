        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Country/AddOrUpdateCountry": {
      "post": {
        "tags": [
          "Country"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CountryModel"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CountryModel"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CountryModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
