  "components": {
    "schemas": {
      "CountryModel": {
        "required": [
          "countryName"
        ],
        "type": "object",
        "properties": {
          "isValid": {
            "type": "boolean"
          },
          "createdDate": {
            "type": "string",
            "format": "date-time"
          },
          "createdBy": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "remarks": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "groupCode": {
            "pattern": "^[A-Z0-9]+$",
            "type": "string",
            "nullable": true
          },
          "branchCode": {
            "pattern": "^[A-Z0-9]+$",
            "type": "string",
            "nullable": true
          },
          "sessionName": {
            "type": "string",
            "nullable": true
          },
          "countryId": {
            "type": "integer",
            "format": "int32"
          },
          "countryCode": {
            "type": "integer",
            "format": "int32"
          },
          "countryName": {
            "minLength": 1,
            "pattern": "^[a-zA-Z\\s]+$",
            "type": "string"
          },
          "language": {
            "type": "string",
            "nullable": true
          },
          "nationality": {
            "type": "string",
            "nullable": true
          },
          "isDefaultCountry": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "UserModels": {
        "required": [
          "password",
          "username"
        ],
        "type": "object",
        "properties": {
          "username": {
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          },
          "capchaCode": {
            "type": "string",
            "nullable": true
          },
          "result": {
            "type": "string",
            "nullable": true
          },
          "userId": {
            "type": "integer",
            "format": "int32"
          },
          "loginName": {
            "type": "string",
            "nullable": true
          },
          "groupCode": {
            "type": "string",
            "nullable": true
          },
          "branchCode": {
            "type": "string",
            "nullable": true
          },
          "userType": {
            "type": "integer",
            "format": "int32"
          },
          "mobileNo": {
            "type": "string",
            "nullable": true
          },
          "isSecondLevel": {
            "type": "boolean"
          },
          "roleId": {
            "type": "string",
            "nullable": true
          },
          "roleName": {
            "type": "string",
            "nullable": true
          },
          "userCode": {
            "type": "string",
            "nullable": true
          },
          "displayName": {
            "type": "string",
            "nullable": true
          },
          "token": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}