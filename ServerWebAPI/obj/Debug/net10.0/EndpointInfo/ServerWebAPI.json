        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserModels"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UserModels"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UserModels"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
