  "components": {
    "schemas": {
      "AccountNoModel": {
        "required": [
          "accountDescription",
          "accountNo"
        ],
        "type": "object",
        "properties": {
          "groupCode": {
            "type": "string",
            "nullable": true
          },
          "branchCode": {
            "type": "string",
            "nullable": true
          },
          "isValid": {
            "type": "boolean"
          },
          "createdBy": {
            "type": "string",
            "nullable": true
          },
          "createdDate": {
            "type": "string",
            "format": "date-time"
          },
          "accountId": {
            "type": "integer",
            "format": "int32"
          },
          "accountNo": {
            "minLength": 1,
            "pattern": "^[0-9]{9,18}$",
            "type": "string"
          },
          "accountDescription": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "updatedDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "updatedBy": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
